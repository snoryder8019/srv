<%
  const cols = ['2','3','4'].includes(String(columns)) ? String(columns) : '3';
  const minw = { '2':'360px', '3':'260px', '4':'200px' }[cols];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= heading %> — <%= brand?.name || 'Shop' %></title>
  <meta name="description" content="<%= (sub || ('Products and services from ' + (brand?.name || 'our team') + '.')).replace(/"/g,'&quot;') %>">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --primary: <%= design.color_primary || '#1C2B4A' %>;
      --accent: <%= design.color_accent || '#C9A848' %>;
      --bg: <%= design.color_bg || '#F5F3EF' %>;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'Jost',system-ui,sans-serif;background:var(--bg);color:#1a1a1a;line-height:1.6;}
    .wrap{max-width:1120px;margin:0 auto;padding:64px 24px;}
    h1{font-family:'Cormorant Garamond',serif;font-size:2.6rem;color:var(--primary);margin-bottom:8px;}
    .sub{opacity:.7;margin-bottom:40px;}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(<%= minw %>,1fr));gap:20px;}
    .card{display:flex;flex-direction:column;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;transition:box-shadow .15s,transform .15s;}
    .card:hover{box-shadow:0 8px 28px rgba(0,0,0,.1);transform:translateY(-2px);}
    .thumb{aspect-ratio:4/3;background:var(--bg);overflow:hidden;position:relative;}
    .thumb img{width:100%;height:100%;object-fit:cover;display:block;}
    .thumb .ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2rem;opacity:.35;}
    .feat{position:absolute;top:10px;left:10px;background:var(--accent);color:#fff;font-size:.6rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:20px;}
    .body{padding:16px 18px;display:flex;flex-direction:column;gap:6px;flex:1;}
    .cat{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:600;}
    .card h2{font-family:'Cormorant Garamond',serif;font-size:1.35rem;color:var(--primary);line-height:1.2;}
    .summary{font-size:.85rem;opacity:.72;flex:1;}
    .price{font-weight:600;color:var(--primary);margin-top:4px;}
    .empty{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:48px;text-align:center;opacity:.75;}
    .home{display:inline-block;margin-top:40px;color:var(--primary);text-decoration:none;opacity:.7;}
    .home:hover{opacity:1;}
  </style>
</head>
<body>
  <div class="wrap">
    <h1><%= heading %></h1>
    <p class="sub"><%= sub || ('Products & services from ' + (brand?.name || 'our team') + '.') %></p>

    <% if (!items || items.length === 0) { %>
      <div class="empty">Nothing listed just yet — check back soon.</div>
    <% } else { %>
      <div class="grid">
        <% items.forEach(function(it){ %>
        <a class="card" href="/marketplace/<%= it.slug %>">
          <div class="thumb">
            <% if (it.image) { %><img src="<%= it.image %>" alt="<%= it.title %>" loading="lazy"><% } else { %><div class="ph">&#128722;</div><% } %>
            <% if (it.featured) { %><span class="feat">Featured</span><% } %>
          </div>
          <div class="body">
            <% if (it.category) { %><span class="cat"><%= it.category %></span><% } %>
            <h2><%= it.title %></h2>
            <% if (it.summary) { %><p class="summary"><%= it.summary %></p><% } %>
            <% if (showPrice && it.price) { %><div class="price"><%= it.price %></div><% } %>
          </div>
        </a>
        <% }) %>
      </div>
    <% } %>

    <a class="home" href="/">&larr; Back to <%= brand?.name || 'home' %></a>
  </div>
</body>
</html>
