<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= listing.title %> — <%= brand?.name || 'Marketplace' %></title>
  <meta name="description" content="<%= (listing.summary || '').replace(/"/g,'&quot;').slice(0,180) %>">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --primary: <%= design.color_primary || '#1C2B4A' %>;
      --accent: <%= design.color_accent || '#C9A848' %>;
      --bg: <%= design.color_bg || '#F5F3EF' %>;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'Jost',system-ui,sans-serif;background:var(--bg);color:#1a1a1a;line-height:1.7;}
    .wrap{max-width:960px;margin:0 auto;padding:56px 24px;}
    .back{display:inline-block;margin-bottom:28px;color:var(--primary);text-decoration:none;opacity:.7;font-size:.9rem;}
    .back:hover{opacity:1;}
    .layout{display:grid;grid-template-columns:1.1fr 1fr;gap:36px;align-items:start;}
    @media(max-width:760px){.layout{grid-template-columns:1fr;}}
    .media{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:14px;overflow:hidden;}
    .media img{width:100%;display:block;}
    .media .ph{aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:3rem;opacity:.3;}
    .cat{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:8px;}
    h1{font-family:'Cormorant Garamond',serif;font-size:2.4rem;color:var(--primary);line-height:1.1;margin-bottom:12px;}
    .price{font-size:1.5rem;font-weight:600;color:var(--primary);margin-bottom:8px;}
    .meta{font-size:.85rem;opacity:.7;margin-bottom:20px;}
    .meta span::before{content:'•';margin:0 10px;opacity:.5;}
    .meta span:first-child::before{content:'';margin:0;}
    .desc{white-space:pre-wrap;font-size:1rem;margin-bottom:28px;}
    .tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;}
    .tag{font-size:.72rem;background:rgba(0,0,0,.05);border-radius:20px;padding:4px 12px;opacity:.8;}
    .cta{display:inline-block;background:var(--accent);color:#fff;font-weight:600;letter-spacing:.04em;padding:14px 30px;border-radius:10px;text-decoration:none;transition:filter .15s;}
    .cta:hover{filter:brightness(1.07);}
    .sold{display:inline-block;background:rgba(0,0,0,.06);color:#555;font-weight:600;padding:14px 30px;border-radius:10px;}
  </style>
</head>
<body>
  <div class="wrap">
    <a class="back" href="/marketplace">&larr; All listings</a>
    <div class="layout">
      <div class="media">
        <% if (listing.imageUrl) { %>
          <img src="<%= listing.imageUrl %>" alt="<%= listing.title %>">
        <% } else { %>
          <div class="ph">&#128722;</div>
        <% } %>
      </div>
      <div class="info">
        <% if (listing.category) { %><div class="cat"><%= listing.category %></div><% } %>
        <h1><%= listing.title %></h1>
        <% if (typeof showPrice === 'undefined' || showPrice) { %><div class="price"><%= listing.priceLabel %></div><% } %>
        <div class="meta">
          <span style="text-transform:capitalize;"><%= listing.kind || 'product' %></span>
          <% if (listing.location) { %><span><%= listing.location %></span><% } %>
        </div>
        <% if (listing.description) { %><div class="desc"><%= listing.description %></div><% } %>
        <% if (listing.tags && listing.tags.length) { %>
        <div class="tags">
          <% listing.tags.forEach(function(t){ %><span class="tag"><%= t %></span><% }) %>
        </div>
        <% } %>
        <% if (listing.contactUrl) { %>
          <a class="cta" href="<%= listing.contactUrl %>"<%= /^https?:/i.test(listing.contactUrl) ? ' target="_blank" rel="noopener"' : '' %>><%= listing.contactLabel || (listing.kind === 'service' ? 'Inquire' : 'Buy Now') %></a>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
