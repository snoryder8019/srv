<% const _t = (typeof t === 'function') ? t : (k => k); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= _t('receipt.receipt') %> <%= receiptNumber %> — <%= brand?.name || 'Home' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    :root { --navy:<%= design.color_primary %>; --gold:<%= design.color_accent %>; --ivory:<%= design.color_bg %>; --slate:#6B7380; --dark:<%= design.color_primary_deep %>; --white:#FDFCFA; --border:#E6E1D6; --green:#15803D; }
    body { font-family:'<%= design.font_body || 'Jost' %>',sans-serif; background:var(--ivory); color:var(--dark); min-height:100vh; display:flex; align-items:flex-start; justify-content:center; padding:24px; }
    .receipt-card { background:var(--white); max-width:640px; width:100%; border-radius:6px; overflow:hidden; box-shadow:0 2px 20px rgba(0,0,0,.07); }
    .rc-header { background:var(--navy); padding:28px 32px; display:flex; justify-content:space-between; align-items:center; }
    .rc-brand { font-family:'<%= design.font_heading || 'Cormorant Garamond' %>',serif; font-size:22px; color:var(--white); font-weight:300; }
    .rc-label { font-size:11px; color:var(--gold); text-transform:uppercase; letter-spacing:2px; text-align:right; }
    .gold-bar { height:3px; background:var(--gold); }
    .rc-body { padding:32px; }
    .paid-stamp { display:inline-block; background:var(--green); color:#fff; font-size:12px; font-weight:600; padding:6px 18px; border-radius:3px; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:20px; }
    .rc-meta { display:flex; gap:32px; flex-wrap:wrap; margin-bottom:24px; }
    .rc-meta-label { font-size:11px; color:var(--slate); text-transform:uppercase; letter-spacing:1.5px; margin-bottom:2px; }
    .rc-meta-value { font-size:15px; color:var(--dark); font-weight:500; }
    table { width:100%; border-collapse:collapse; margin-bottom:20px; }
    thead th { text-align:left; font-size:11px; color:var(--slate); text-transform:uppercase; letter-spacing:1px; padding:10px 12px; border-bottom:2px solid var(--border); background:var(--ivory); }
    thead th:last-child, thead th:nth-child(3) { text-align:right; }
    thead th:nth-child(2) { text-align:center; }
    tbody td { padding:10px 12px; border-bottom:1px solid var(--border); font-size:14px; }
    tbody td:last-child, tbody td:nth-child(3) { text-align:right; }
    tbody td:nth-child(2) { text-align:center; color:var(--slate); }
    .total-row { display:flex; justify-content:flex-end; margin-bottom:24px; }
    .total-box { background:var(--navy); border-radius:4px; padding:16px 24px; text-align:right; min-width:200px; }
    .total-label { font-size:11px; color:var(--gold); text-transform:uppercase; letter-spacing:1.5px; margin-bottom:4px; }
    .total-amount { font-family:'<%= design.font_heading || 'Cormorant Garamond' %>',serif; font-size:32px; color:var(--white); }
    .pay-info { border-top:1px solid var(--border); padding-top:16px; font-size:13px; color:var(--slate); line-height:1.8; }
    .pay-info strong { color:var(--dark); font-weight:500; }
    .actions { display:flex; gap:12px; justify-content:center; margin-top:24px; }
    .btn-print { padding:13px 28px; background:var(--gold); color:var(--navy); border:none; font-family:'Jost',sans-serif; font-size:14px; font-weight:600; border-radius:3px; cursor:pointer; letter-spacing:.5px; text-decoration:none; display:inline-block; }
    .btn-print:hover { opacity:.9; }
    .rc-footer { background:var(--ivory); padding:16px 32px; text-align:center; font-size:12px; color:var(--slate); }
    @media print {
      body { background:#fff; padding:0; }
      .receipt-card { box-shadow:none; max-width:100%; }
      .actions { display:none !important; }
    }
    @media(max-width:480px) { .rc-body { padding:20px; } .rc-meta { gap:16px; } }
  </style>
</head>
<body>
<div class="receipt-card">
  <div class="rc-header">
    <div class="rc-brand"><%- brand?.name || '' %></div>
    <div class="rc-label"><%= _t('receipt.receipt') %><br><%= receiptNumber %></div>
  </div>
  <div class="gold-bar"></div>

  <div class="rc-body">
    <div class="paid-stamp"><%= _t('receipt.paid') %></div>

    <div class="rc-meta">
      <div>
        <div class="rc-meta-label"><%= _t('receipt.receipt_number') %></div>
        <div class="rc-meta-value"><%= receiptNumber %></div>
      </div>
      <div>
        <div class="rc-meta-label"><%= _t('receipt.invoice_number') %></div>
        <div class="rc-meta-value"><%= inv.invoiceNumber || '—' %></div>
      </div>
      <div>
        <div class="rc-meta-label"><%= _t('receipt.billed_to') %></div>
        <div class="rc-meta-value"><%= cl?.company || cl?.businessName || cl?.name || _t('receipt.client') %></div>
      </div>
      <div>
        <div class="rc-meta-label"><%= _t('receipt.date_paid') %></div>
        <div class="rc-meta-value"><%= paidOn %></div>
      </div>
    </div>

    <!-- Line items -->
    <table>
      <thead><tr><th><%= _t('receipt.description') %></th><th><%= _t('receipt.qty') %></th><th><%= _t('receipt.rate') %></th><th><%= _t('receipt.amount') %></th></tr></thead>
      <tbody>
        <% if (inv.lineItems?.length) { %>
          <% for (const li of inv.lineItems) { %>
          <tr>
            <td><%= li.description %></td>
            <td><%= li.quantity %></td>
            <td>$<%= parseFloat(li.unitPrice).toFixed(2) %></td>
            <td style="font-weight:500;">$<%= (li.quantity * li.unitPrice).toFixed(2) %></td>
          </tr>
          <% } %>
        <% } else { %>
          <tr>
            <td colspan="3"><%= inv.title %></td>
            <td style="font-weight:500;">$<%= inv.amount.toFixed(2) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <div class="total-row">
      <div class="total-box">
        <div class="total-label"><%= _t('receipt.amount_paid') %></div>
        <div class="total-amount">$<%= amountPaid.toFixed(2) %></div>
      </div>
    </div>

    <div class="pay-info">
      <div><strong><%= _t('receipt.payment_method') %></strong> <%= methodLabel %></div>
      <% if (transactionId) { %><div><strong><%= _t('receipt.transaction_id') %></strong> <%= transactionId %></div><% } %>
      <div><strong><%= _t('receipt.status_label') %></strong> <%= _t('receipt.paid_in_full') %></div>
    </div>

    <div class="actions">
      <a href="#" class="btn-print" onclick="window.print();return false;"><%= _t('receipt.print_save_pdf') %></a>
    </div>
  </div>

  <div class="rc-footer"><%= brand?.name || '' %> &middot; <%= brand?.location || '' %></div>
</div>
</body>
</html>
