<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delegate Panel — sLab</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <%- include('partials/theme') %>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; transition:background .2s, color .2s; }
    .topbar { background:var(--card); border-bottom:1px solid var(--border); padding:14px 24px; display:flex; align-items:center; justify-content:space-between; }
    .topbar-left { display:flex; align-items:center; gap:16px; }
    .logo { font-size:20px; font-weight:600; color:var(--heading); } .logo span { color:var(--gold); }
    .badge { font-size:10px; text-transform:uppercase; letter-spacing:1.2px; color:var(--gold); background:var(--border); padding:3px 8px; border-radius:4px; }
    .topbar-right { display:flex; align-items:center; gap:16px; font-size:13px; color:var(--mute); }
    .topbar-right a { color:var(--dim); text-decoration:none; font-size:12px; } .topbar-right a:hover { color:var(--gold); }
    .container { max-width:900px; margin:0 auto; padding:24px; }
    .stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:16px; margin-bottom:28px; }
    .stat { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:20px; }
    .stat-label { font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--mute); margin-bottom:6px; }
    .stat-value { font-size:28px; font-weight:700; color:var(--heading); }
    .stat-value.gold { color:var(--gold); }
    .stat-value.green { color:#4ade80; }
    h2 { font-size:16px; font-weight:500; margin-bottom:16px; color:var(--heading); }
    .section { margin-bottom:32px; }
    table { width:100%; border-collapse:collapse; background:var(--card); border-radius:8px; overflow:hidden; border:1px solid var(--border); }
    th { text-align:left; padding:10px 14px; font-size:11px; text-transform:uppercase; letter-spacing:0.8px; color:var(--mute); background:var(--elev); border-bottom:1px solid var(--border); }
    td { padding:10px 14px; font-size:13px; border-bottom:1px solid var(--border-soft); }
    tr:last-child td { border-bottom:0; }
    .status { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:500; }
    .status-active { background:#14532d; color:#86efac; }
    .status-pending { background:#422006; color:#fdba74; }
    .status-suspended { background:#451a1a; color:#fca5a5; }
    .empty { color:var(--faint); font-size:13px; padding:20px; text-align:center; }
    .ref-code { font-family:monospace; font-size:14px; color:var(--gold); background:var(--elev); padding:6px 12px; border-radius:4px; display:inline-block; }
    .share-btn { padding:8px 14px; background:transparent; color:var(--gold); border:1px solid var(--gold); border-radius:6px; font-family:'Inter',sans-serif; font-size:12px; font-weight:600; cursor:pointer; white-space:nowrap; transition:all .15s; }
    .share-btn:hover { background:var(--gold); color:var(--on-gold); }
    #celebrate { position:fixed; inset:0; pointer-events:none; z-index:2000; }
    .commission-info { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:16px; margin-bottom:20px; }
    .commission-info h3 { font-size:12px; color:var(--gold); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:8px; }
    .commission-row { display:flex; justify-content:space-between; padding:3px 0; font-size:13px; }
    .commission-row .label { color:var(--dim); } .commission-row .value { color:var(--heading); font-weight:600; }
    .tax-warning { background:rgba(251,191,36,0.1); border:1px solid rgba(251,191,36,0.2); color:#c08a00; padding:12px 16px; border-radius:6px; font-size:13px; margin-bottom:20px; line-height:1.6; }
    @media (max-width:600px) { .stats { grid-template-columns:1fr 1fr; } .container { padding:16px; } }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-left">
      <div class="logo"><span>s</span>Lab</div>
      <span class="badge">Delegate</span>
    </div>
    <div class="topbar-right">
      <span><%= delegate.firstName %> <%= delegate.lastName %></span>
      <a href="/delegates/panel/sales-sheets">Sales Sheets</a>
      <a href="/delegates/panel/tax-info">Tax Info</a>
      <a href="/delegates/panel/settings">Settings</a>
      <a href="/delegates/logout">Logout</a>
      <button id="themeToggle" onclick="slabToggleTheme()" title="Toggle light / dark">☀️</button>
    </div>
  </div>

  <div class="container">
    <% if (!delegate.taxInfoProvided) { %>
    <div class="tax-warning">
      <strong>Tax info required:</strong> You must provide valid tax information (W-9) before receiving your first payout. <a href="/delegates/panel/tax-info" style="color:#c9a848;font-weight:600;">Upload your tax info now</a>.
    </div>
    <% } %>

    <% if (typeof taxComplete !== 'undefined' && (!taxComplete || heldTotal > 0)) { %>
    <a href="/delegates/panel/tax-info" style="display:block;text-decoration:none;background:linear-gradient(135deg,#2a1a1a,#1a1414);border:1px solid #f87171;border-radius:8px;padding:14px 18px;margin-bottom:20px;">
      <div style="color:#f87171;font-weight:600;font-size:14px;margin-bottom:4px;">&#9888; Complete your W-9 / W-8BEN to get paid</div>
      <div style="color:#a3a3a3;font-size:13px;line-height:1.5;">
        <% if (heldTotal > 0) { %><strong style="color:#fdba74;">$<%= heldTotal.toFixed(2) %></strong> in commission is being held until your tax form is on file. <% } %>
        Commissions still accrue, but can't be released for payout until your tax information is complete. Tap to finish &rarr;
      </div>
    </a>
    <% } %>

    <div class="stats">
      <div class="stat">
        <div class="stat-label">Status</div>
        <div class="stat-value"><span class="status status-<%= delegate.status %>"><%= delegate.status %></span></div>
      </div>
      <div class="stat">
        <div class="stat-label">Referrals</div>
        <div class="stat-value"><%= delegate.tenants?.length || 0 %></div>
      </div>
      <div class="stat">
        <div class="stat-label">Total Earned</div>
        <div class="stat-value gold">$<%= (delegate.totalEarned || 0).toFixed(2) %></div>
      </div>
      <% if (typeof heldTotal !== 'undefined' && heldTotal > 0) { %>
      <div class="stat">
        <div class="stat-label">Held (tax)</div>
        <div class="stat-value" style="color:#f87171;">$<%= heldTotal.toFixed(2) %></div>
      </div>
      <% } %>
      <div class="stat">
        <div class="stat-label">Total Paid</div>
        <div class="stat-value green">$<%= (delegate.totalPaid || 0).toFixed(2) %></div>
      </div>
    </div>

    <div class="section">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <h2>Your Share Codes</h2>
      </div>
      <% const shareUrl = (typeof domain !== 'undefined' ? domain : '') + '/start?ref=' + delegate.refCode; %>
      <div style="margin-bottom:14px;">
        <div style="font-size:11px;color:#737373;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;">Personal Referral Code</div>
        <div class="ref-code"><%= delegate.refCode %></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px;">
          <code id="shareUrl" style="color:#c9a848;font-family:monospace;font-size:13px;background:var(--chip,#1a1a1a);padding:8px 12px;border-radius:6px;word-break:break-all;flex:1;min-width:200px;"><%= shareUrl %></code>
          <button type="button" class="share-btn" onclick="copyShare(this)">Copy link</button>
          <button type="button" class="share-btn" onclick="toggleQR()">QR code</button>
          <button type="button" class="share-btn" onclick="nativeShare()">Share…</button>
        </div>
        <div id="qrWrap" style="display:none;margin-top:14px;text-align:center;">
          <img src="/delegates/panel/qr.png" alt="Your referral QR code" width="220" height="220" style="background:#0a0a0a;border-radius:10px;padding:8px;">
          <div style="margin-top:8px;"><a href="/delegates/panel/qr.png" download="my-slab-referral-qr.png" class="share-btn" style="text-decoration:none;">Download QR</a></div>
          <div style="font-size:11px;color:#737373;margin-top:6px;">Add this to flyers, posts, or business cards — it links straight to your referral signup.</div>
        </div>
      </div>

      <% if (typeof promoCodes !== 'undefined' && promoCodes.length) { %>
      <div style="font-size:11px;color:#737373;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;">Campaign Promo Codes</div>
      <table>
        <thead><tr><th>Code</th><th>Label</th><th>Free Days</th><th>Expires</th><th>Uses</th></tr></thead>
        <tbody>
          <% for (const p of promoCodes) { %>
          <tr>
            <td style="font-family:monospace;color:#c9a848;font-weight:600;"><%= p.code %></td>
            <td style="color:#a3a3a3;"><%= p.label || '—' %></td>
            <td><%= p.freeDays %></td>
            <td style="color:#a3a3a3;"><%= p.expiresAt ? new Date(p.expiresAt).toLocaleDateString() : 'No expiry' %></td>
            <td><%= p.usageCount || 0 %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <div style="font-size:11px;color:#525252;margin-top:8px;">Share format: <code style="color:#c9a848;">/start?ref=YOURCODE</code></div>
      <% } %>
    </div>

    <div class="commission-info">
      <h3>Commission Schedule</h3>
      <div class="commission-row"><span class="label">Year 1</span><span class="value">40% of net</span></div>
      <div class="commission-row"><span class="label">Year 2</span><span class="value">20% of net</span></div>
      <div class="commission-row"><span class="label">Year 3+ (ongoing royalty)</span><span class="value">10% of net</span></div>
      <% if (typeof commissionExamples !== 'undefined' && commissionExamples && commissionExamples.length) { %>
      <div style="margin-top:14px;overflow-x:auto;">
        <div style="font-size:11px;color:#737373;margin-bottom:6px;">Monthly payout per active subscription, at today's Slab prices:</div>
        <table style="width:100%;border-collapse:collapse;font-size:12px;">
          <thead>
            <tr style="color:#737373;text-align:right;">
              <th style="text-align:left;padding:6px 8px;font-weight:600;">Tier</th>
              <th style="padding:6px 8px;font-weight:600;">Net/mo</th>
              <% for (const p of commissionExamples[0].payouts) { %><th style="padding:6px 8px;font-weight:600;"><%= p.label %> (<%= (p.rate*100).toFixed(0) %>%)</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% for (const ex of commissionExamples) { %>
            <tr style="border-top:1px solid #262626;text-align:right;">
              <td style="text-align:left;padding:6px 8px;color:#e5e5e5;"><%= ex.tier %> <span style="color:#737373;">$<%= ex.gross.toFixed(2) %></span></td>
              <td style="padding:6px 8px;color:#a3a3a3;">$<%= ex.net.toFixed(2) %></td>
              <% for (const p of ex.payouts) { %><td style="padding:6px 8px;color:#c9a848;font-weight:600;">$<%= p.amount.toFixed(2) %></td><% } %>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
      <div style="margin-top:10px;padding-top:10px;border-top:1px solid #262626;font-size:11px;color:#737373;line-height:1.6;">
        Net = the account's monthly subscription revenue minus the platform's blended tax obligation (currently <%= (ownerTaxRate * 100).toFixed(0) %>%). Royalty continues for the life of the account.<br>
        Payouts are issued via <strong>PayPal</strong>.
      </div>
    </div>

    <div class="section">
      <h2>Slab Referrals</h2>
      <% if (tenantDetails.length) { %>
      <table>
        <thead><tr><th>Customer</th><th>Signed Up</th><th>Plan</th><th>Yr</th><th>Rate</th><th>Est. Monthly Commission</th></tr></thead>
        <tbody>
          <% for (const t of tenantDetails) { %>
          <% const rate = Number(t.rate || 0), comm = Number(t.commission || 0); %>
          <tr>
            <td><%= t.brandName %></td>
            <td><%= t.attachedAt ? new Date(t.attachedAt).toLocaleDateString() : '—' %></td>
            <td style="text-transform:capitalize;"><%= t.plan || '—' %></td>
            <td>Yr <%= t.year || '—' %></td>
            <td><%= (rate * 100).toFixed(0) %>%</td>
            <td style="color:<%= t.inTrial ? '#fdba74' : '#c9a848' %>;font-weight:600;">
              $<%= comm.toFixed(2) %><% if (t.inTrial) { %> <span style="font-size:10px;color:#fdba74;">trial</span><% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } else { %>
        <div class="empty">No referrals yet. Subscriptions that sign up with your referral code will appear here.</div>
      <% } %>
    </div>

    <div class="section">
      <h2>Payout History</h2>
      <% if (payouts.length) { %>
      <table>
        <thead><tr><th>Date</th><th>Period</th><th>Amount</th><th>Method</th><th>Note</th></tr></thead>
        <tbody>
          <% for (const p of payouts) { %>
          <tr>
            <td><%= new Date(p.createdAt).toLocaleDateString() %></td>
            <td><%= p.period %></td>
            <td style="color:#4ade80;font-weight:600;">$<%= p.amount.toFixed(2) %></td>
            <td><%= p.method %></td>
            <td style="color:#737373;"><%= p.note || '—' %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } else { %>
        <div class="empty">No payouts yet.</div>
      <% } %>
    </div>
  </div>

  <canvas id="celebrate"></canvas>
  <script>
    // ── Share: copy link, toggle QR, native share ──────────────────────────
    function copyShare(btn) {
      var t = document.getElementById('shareUrl').textContent.trim();
      navigator.clipboard.writeText(t).then(function () {
        var o = btn.textContent; btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = o; }, 1800);
      });
    }
    function toggleQR() {
      var w = document.getElementById('qrWrap');
      w.style.display = (w.style.display === 'none' || !w.style.display) ? 'block' : 'none';
    }
    function nativeShare() {
      var url = document.getElementById('shareUrl').textContent.trim();
      if (navigator.share) {
        navigator.share({ title: 'Build your site on Slab', text: 'Start your Slab site with my referral link:', url: url }).catch(function () {});
      } else {
        navigator.clipboard.writeText(url).then(function () { alert('Link copied — paste it into your campaign.'); });
      }
    }

    // ── Confetti / fireworks (self-contained canvas, no external libs) ──────
    (function () {
      var canvas = document.getElementById('celebrate');
      var ctx = canvas.getContext('2d');
      function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
      resize(); window.addEventListener('resize', resize);
      var parts = [], raf = null;
      var COLORS = ['#c9a848', '#4ade80', '#fdba74', '#f87171', '#60a5fa', '#ffffff'];
      function rnd(a, b) { return a + Math.random() * (b - a); }
      function burst(x, y, n) {
        for (var i = 0; i < n; i++) {
          var ang = rnd(0, Math.PI * 2), sp = rnd(2, 7);
          parts.push({ x: x, y: y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - rnd(0, 2),
            g: 0.12, life: rnd(60, 110), age: 0, c: COLORS[(Math.random() * COLORS.length) | 0], s: rnd(2, 5), rot: rnd(0, 6.28), vr: rnd(-0.2, 0.2) });
        }
        if (!raf) loop();
      }
      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (var i = parts.length - 1; i >= 0; i--) {
          var p = parts[i]; p.age++; p.vy += p.g; p.x += p.vx; p.y += p.vy; p.rot += p.vr;
          var a = Math.max(0, 1 - p.age / p.life);
          ctx.save(); ctx.globalAlpha = a; ctx.translate(p.x, p.y); ctx.rotate(p.rot);
          ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 1.6); ctx.restore();
          if (p.age >= p.life) parts.splice(i, 1);
        }
        if (parts.length) { raf = requestAnimationFrame(loop); } else { raf = null; ctx.clearRect(0, 0, canvas.width, canvas.height); }
      }
      window.slabCelebrate = function (fireworks) {
        if (fireworks) {
          for (var k = 0; k < 6; k++) {
            (function (kk) { setTimeout(function () { burst(rnd(innerWidth * 0.2, innerWidth * 0.8), rnd(innerHeight * 0.2, innerHeight * 0.5), 60); }, kk * 300); })(k);
          }
        }
        burst(window.innerWidth / 2, window.innerHeight * 0.35, 120);
      };

      // Earnings discovery: celebrate when the payable balance grows since last visit.
      var payable = <%= (typeof payableTotal !== 'undefined' ? payableTotal : 0) %>;
      try {
        var seen = parseFloat(localStorage.getItem('slab_deleg_earn') || '0');
        if (payable > seen + 0.001) {
          localStorage.setItem('slab_deleg_earn', String(payable));
          if (payable > 0) setTimeout(function () { window.slabCelebrate(true); }, 400);
        }
      } catch (e) {}
    })();
  </script>
</body>
</html>
