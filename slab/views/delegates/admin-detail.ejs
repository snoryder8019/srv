<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delegate Detail — Superadmin — sLab</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',sans-serif; background:#0a0a0a; color:#e5e5e5; min-height:100vh; }
    .topbar { background:#141414; border-bottom:1px solid #262626; padding:14px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; }
    .topbar-left { display:flex; align-items:center; gap:16px; }
    .logo { font-size:20px; font-weight:600; color:#fff; } .logo span { color:#c9a848; }
    .badge { font-size:10px; text-transform:uppercase; letter-spacing:1.2px; color:#c9a848; background:#262626; padding:3px 8px; border-radius:4px; }
    .topbar-right { display:flex; align-items:center; gap:16px; font-size:13px; }
    .topbar-right a { color:#a3a3a3; text-decoration:none; font-size:12px; } .topbar-right a:hover { color:#c9a848; }
    .container { max-width:900px; margin:0 auto; padding:24px; }
    .back { display:inline-block; color:#a3a3a3; text-decoration:none; font-size:12px; margin-bottom:16px; } .back:hover { color:#c9a848; }
    h1 { font-size:22px; font-weight:600; color:#fff; margin-bottom:4px; }
    .meta-line { font-size:13px; color:#737373; margin-bottom:20px; }
    .meta-line a { color:#c9a848; text-decoration:none; }
    .status { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:500; }
    .status-active { background:#14532d; color:#86efac; }
    .status-pending { background:#422006; color:#fdba74; }
    .status-suspended { background:#451a1a; color:#fca5a5; }
    .card { background:#141414; border:1px solid #262626; border-radius:8px; padding:24px; margin-bottom:20px; }
    .card-title { font-size:14px; font-weight:600; color:#fff; margin-bottom:16px; padding-bottom:10px; border-bottom:1px solid #262626; }
    .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .info-item label { font-size:10px; text-transform:uppercase; letter-spacing:0.8px; color:#525252; display:block; margin-bottom:2px; }
    .info-item span { font-size:13px; color:#e5e5e5; }
    .actions-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
    .btn { padding:8px 16px; border-radius:4px; font-family:'Inter',sans-serif; font-size:12px; font-weight:600; cursor:pointer; border:none; }
    .btn-green { background:#14532d; color:#86efac; } .btn-green:hover { background:#166534; }
    .btn-amber { background:#422006; color:#fdba74; } .btn-amber:hover { background:#4a2506; }
    .btn-red { background:#451a1a; color:#fca5a5; } .btn-red:hover { background:#502020; }
    .btn-gold { background:#c9a848; color:#0a0a0a; } .btn-gold:hover { background:#d4b85c; }
    .btn-sm { padding:5px 12px; font-size:11px; border-radius:4px; border:1px solid #333; background:transparent; color:#a3a3a3; cursor:pointer; }
    .btn-sm:hover { border-color:#c9a848; color:#c9a848; }
    h2 { font-size:16px; font-weight:500; margin-bottom:16px; }
    .section { margin-bottom:28px; }
    table { width:100%; border-collapse:collapse; background:#141414; border-radius:8px; overflow:hidden; border:1px solid #262626; }
    th { text-align:left; padding:10px 14px; font-size:11px; text-transform:uppercase; letter-spacing:0.8px; color:#737373; background:#1a1a1a; border-bottom:1px solid #262626; }
    td { padding:10px 14px; font-size:13px; border-bottom:1px solid #1f1f1f; }
    tr:last-child td { border-bottom:0; }
    .empty { color:#525252; font-size:13px; padding:16px; text-align:center; }
    .attach-form { display:flex; gap:8px; align-items:center; margin-bottom:16px; flex-wrap:wrap; }
    .attach-form select { background:#1a1a1a; border:1px solid #333; color:#e5e5e5; padding:8px 10px; border-radius:4px; font-family:'Inter',sans-serif; font-size:13px; min-width:250px; }
    .payout-form { display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap; }
    .payout-form .form-group { display:flex; flex-direction:column; gap:4px; }
    .payout-form label { font-size:10px; text-transform:uppercase; letter-spacing:0.8px; color:#525252; }
    .payout-form input, .payout-form select { background:#1a1a1a; border:1px solid #333; color:#e5e5e5; padding:8px 10px; border-radius:4px; font-family:'Inter',sans-serif; font-size:13px; }
    .payout-form input:focus, .payout-form select:focus { border-color:#c9a848; outline:none; }
    @media (max-width:600px) { .info-grid { grid-template-columns:1fr; } .container { padding:16px; } .payout-form { flex-direction:column; align-items:stretch; } }
  </style>
</head>
<body>
  <%- include('../superadmin/partials/nav', { active: 'delegates', user: (typeof user !== 'undefined' ? user : null), subtitle: 'Delegates' }) %>

  <div class="container">
    <a href="/delegates/admin" class="back">&larr; Back to Delegates</a>

    <h1><%= delegate.firstName %> <%= delegate.lastName %></h1>
    <div class="meta-line">
      <a href="mailto:<%= delegate.email %>"><%= delegate.email %></a>
      &nbsp;&middot;&nbsp; <span class="status status-<%= delegate.status %>"><%= delegate.status %></span>
      &nbsp;&middot;&nbsp; Ref: <span style="color:#c9a848;font-family:monospace;"><%= delegate.refCode %></span>
      &nbsp;&middot;&nbsp; Joined <%= new Date(delegate.createdAt).toLocaleDateString() %>
    </div>

    <% if (typeof msg !== 'undefined' && msg) { %>
    <div style="background:#14532d;border:1px solid #166534;color:#86efac;padding:10px 14px;border-radius:6px;margin-bottom:14px;font-size:13px;"><%= msg %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
    <div style="background:#451a1a;border:1px solid #602020;color:#fca5a5;padding:10px 14px;border-radius:6px;margin-bottom:14px;font-size:13px;"><%= error %></div>
    <% } %>
    <% if (typeof tmppw !== 'undefined' && tmppw) { %>
    <div style="background:#0e1f14;border:1px solid #166534;padding:12px 16px;border-radius:8px;margin-bottom:14px;">
      <div style="color:#86efac;font-weight:600;font-size:14px;margin-bottom:6px;">Temporary password set</div>
      <div style="font-size:12px;color:#a3a3a3;margin-bottom:10px;">Share with <strong style="color:#e5e5e5;"><%= delegate.email %></strong> over a secure channel — it won't be shown again. They can change it under Settings after logging in.</div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <code id="tmppw" style="font-size:18px;font-weight:700;letter-spacing:1px;color:#c9a848;background:#0a0a0a;border:1px solid #262626;padding:8px 14px;border-radius:6px;"><%= tmppw %></code>
        <button type="button" class="btn" onclick="navigator.clipboard.writeText(document.getElementById('tmppw').textContent).then(()=>{this.textContent='Copied';})">Copy</button>
      </div>
    </div>
    <% } %>

    <!-- Status actions -->
    <div class="actions-row">
      <% if (delegate.status !== 'active') { %>
        <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/status"><input type="hidden" name="status" value="active"><button class="btn btn-green">Activate</button></form>
      <% } %>
      <% if (delegate.status !== 'pending') { %>
        <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/status"><input type="hidden" name="status" value="pending"><button class="btn btn-amber">Set Pending</button></form>
      <% } %>
      <% if (delegate.status !== 'suspended') { %>
        <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/status"><input type="hidden" name="status" value="suspended"><button class="btn btn-red" onclick="return confirm('Suspend this delegate?')">Suspend</button></form>
      <% } %>
      <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/reset-password" style="margin-left:auto;">
        <button type="submit" class="btn" onclick="return confirm('Reset password for <%= delegate.email %>? A temporary password will be generated and shown once.')">Reset Password</button>
      </form>
      <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/send-reminder">
        <button type="submit" class="btn btn-gold" onclick="return confirm('Email <%= delegate.email %> a login reminder with their share code?')">Send Login Reminder</button>
      </form>
    </div>

    <!-- Delegate info card -->
    <div class="card">
      <div class="card-title">Contact Info</div>
      <div class="info-grid">
        <div class="info-item"><label>Phone</label><span><%= delegate.phone || '—' %></span></div>
        <div class="info-item"><label>Address</label><span><%= delegate.address || '—' %></span></div>
        <div class="info-item"><label>City / State</label><span><%= delegate.city || '—' %>, <%= delegate.state || '—' %> <%= delegate.zip || '' %></span></div>
        <div class="info-item"><label>Tax Form</label><span style="color:<%= taxComplete ? '#4ade80' : '#f87171' %>;"><%= delegate.taxInfo?.formType || 'W-9' %> — <%= taxComplete ? 'complete' : 'incomplete' %><% if (delegate.taxInfo?.w9_enc) { %> &middot; <a href="/delegates/admin/<%= delegate._id %>/w9" target="_blank" style="color:#c9a848;font-size:12px;">View doc</a><% } %></span></div>
        <% if (delegate.taxInfo) { %>
        <div class="info-item"><label>Legal Name</label><span><%= delegate.taxInfo.legalName || '—' %></span></div>
        <div class="info-item"><label>Business Type</label><span><%= (delegate.taxInfo.entityType || '—').replace(/_/g, ' ') %></span></div>
        <% } %>
        <div class="info-item"><label>Payable Balance</label><span style="color:#c9a848;">$<%= payable.toFixed(2) %></span></div>
        <% if (heldTotal > 0) { %>
        <div class="info-item"><label>Held (tax incomplete)</label><span style="color:#f87171;">$<%= heldTotal.toFixed(2) %></span></div>
        <% } %>
        <div class="info-item"><label>Total Earned</label><span style="color:#a3a3a3;">$<%= (delegate.totalEarned || 0).toFixed(2) %></span></div>
        <div class="info-item"><label>Total Paid</label><span style="color:#4ade80;">$<%= (delegate.totalPaid || 0).toFixed(2) %></span></div>
      </div>
    </div>

    <!-- Slab referrals -->
    <div class="section">
      <h2>Slab Referrals</h2>
      <div style="font-size:12px;color:#737373;margin-bottom:12px;line-height:1.6;">
        Slab subscriptions (<span style="font-family:monospace;color:#c9a848;">slab.madladslab.com</span>) this delegate sold.
        Signups link automatically via <span style="font-family:monospace;color:#c9a848;">/start?ref=<%= delegate.refCode %></span> —
        add one manually below (customer name + tier).
      </div>
      <form method="POST" action="/delegates/admin/<%= delegate._id %>/attach" class="attach-form" data-guard data-guard-label="Adding..." style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <input type="text" name="customerName" required placeholder="Customer name" style="flex:1;min-width:160px;">
        <select name="plan" required>
          <% for (const tier of tiers) { %>
          <option value="<%= tier %>" style="text-transform:capitalize;"><%= tier.charAt(0).toUpperCase() + tier.slice(1) %></option>
          <% } %>
        </select>
        <input type="date" name="signedUpAt" title="Signed up (defaults to today)">
        <button type="submit" class="btn btn-gold">Add Referral</button>
      </form>

      <% if (tenantDetails.length) { %>
      <table>
        <thead><tr><th>Customer</th><th>Signed Up</th><th>Plan</th><th>Yr</th><th>Rate</th><th>Gross/mo</th><th>Net/mo</th><th>Commission</th><th></th></tr></thead>
        <tbody>
          <% for (const t of tenantDetails) { %>
          <% const gross = Number(t.grossMonthly || 0), net = Number(t.netMonthly || 0), comm = Number(t.commission || 0), rate = Number(t.rate || 0); %>
          <tr>
            <td><%= t.brandName %></td>
            <td style="color:#a3a3a3;white-space:nowrap;"><%= t.attachedAt ? new Date(t.attachedAt).toLocaleDateString() : '—' %></td>
            <td style="text-transform:capitalize;"><%= t.plan || '—' %></td>
            <td><%= t.year || '—' %></td>
            <td><%= (rate * 100).toFixed(0) %>%</td>
            <td style="color:#737373;">$<%= gross.toFixed(2) %></td>
            <td style="color:#a3a3a3;">$<%= net.toFixed(2) %></td>
            <td style="color:<%= t.inTrial ? '#fdba74' : '#c9a848' %>;font-weight:600;" title="<%= t.inTrial ? 'In free trial until ' + new Date(t.trialEndsAt).toLocaleDateString() : '' %>">
              $<%= comm.toFixed(2) %><% if (t.inTrial) { %> <span style="font-size:10px;color:#fdba74;">(trial)</span><% } %>
            </td>
            <td>
              <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/detach" style="display:inline;">
                <input type="hidden" name="key" value="<%= t.key %>">
                <button type="submit" class="btn-sm" onclick="return confirm('Unlink this referral?')">Unlink</button>
              </form>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <div style="margin-top:10px;font-size:11px;color:#525252;">
        Net = gross &times; (1 &minus; <%= (ownerTaxRate * 100).toFixed(0) %>% owner tax). Commission = net &times; rate.
      </div>
      <% } else { %>
        <div class="empty">No referrals yet.</div>
      <% } %>
    </div>

    <!-- Promo codes -->
    <div class="section">
      <h2>Promo Codes</h2>
      <div style="font-size:12px;color:#737373;margin-bottom:12px;line-height:1.6;">
        Promo codes give a tenant a free trial when used at <code style="color:#c9a848;">/start?ref=CODE</code>.
        During the trial period, the delegate's commission is also $0 — commission begins after the trial ends.<br>
        Each delegate also has their personal referral code <code style="color:#c9a848;"><%= delegate.refCode %></code> for signup attribution.
      </div>

      <form method="POST" action="/delegates/admin/<%= delegate._id %>/promo-codes" class="payout-form" style="margin-bottom:18px;" data-guard data-guard-label="Creating...">
        <div class="form-group">
          <label>Code (optional)</label>
          <input type="text" name="code" placeholder="auto-generated if blank" style="width:200px;text-transform:uppercase;">
        </div>
        <div class="form-group">
          <label>Label</label>
          <input type="text" name="label" placeholder="e.g. Instagram Launch" style="width:200px;">
        </div>
        <div class="form-group">
          <label>Free Days</label>
          <input type="number" name="freeDays" value="30" min="1" max="365" style="width:90px;">
        </div>
        <div class="form-group">
          <label>Expires</label>
          <input type="date" name="expiresAt" style="width:150px;">
        </div>
        <button type="submit" class="btn btn-gold">Create Promo Code</button>
      </form>

      <% if (promoCodes && promoCodes.length) { %>
      <table>
        <thead><tr><th>Code</th><th>Label</th><th>Free Days</th><th>Expires</th><th>Status</th><th>Uses</th><th>Share URL</th><th></th></tr></thead>
        <tbody>
          <% for (const p of promoCodes) { %>
          <% const expired = p.expiresAt && new Date(p.expiresAt) < new Date(); %>
          <% const live = p.active && !expired; %>
          <tr>
            <td style="font-family:monospace;color:#c9a848;font-weight:600;"><%= p.code %></td>
            <td style="color:#a3a3a3;"><%= p.label || '—' %></td>
            <td><%= p.freeDays %></td>
            <td style="color:<%= expired ? '#f87171' : '#a3a3a3' %>;"><%= p.expiresAt ? new Date(p.expiresAt).toLocaleDateString() : 'No expiry' %></td>
            <td>
              <% if (!p.active) { %><span class="status status-suspended">disabled</span>
              <% } else if (expired) { %><span class="status status-suspended">expired</span>
              <% } else { %><span class="status status-active">active</span><% } %>
            </td>
            <td><%= p.usageCount || 0 %></td>
            <td style="font-family:monospace;font-size:11px;color:#737373;"><%= (domain || 'https://slab.madladslab.com') %>/start?ref=<%= p.code %></td>
            <td>
              <% if (live) { %>
              <form data-guard="button" method="POST" action="/delegates/admin/<%= delegate._id %>/promo-codes/<%= p._id %>/disable" style="display:inline;">
                <button type="submit" class="btn-sm" onclick="return confirm('Disable this promo code?')">Disable</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } else { %>
        <div class="empty">No promo codes yet. The delegate can still share their personal code <code style="color:#c9a848;"><%= delegate.refCode %></code>.</div>
      <% } %>
    </div>

    <!-- Log payout -->
    <div class="section">
      <h2>Log PayPal Payout</h2>
      <% if (!taxComplete) { %>
      <div style="font-size:13px;color:#fca5a5;background:#451a1a;border:1px solid #602020;padding:10px 14px;border-radius:6px;margin-bottom:10px;">
        &#9888; Payouts are blocked — this delegate has no complete W-9 / W-8BEN on file. $<%= heldTotal.toFixed(2) %> is being held.
      </div>
      <% } else { %>
      <div style="font-size:12px;color:#737373;margin-bottom:10px;">
        Payable balance: <strong style="color:#c9a848;">$<%= payable.toFixed(2) %></strong>.
        <% if (typeof payoutsLive !== 'undefined' && payoutsLive && payable > 0) { %>
        Send it instantly via the live PayPal Payouts API, or record a manual payment below.
        <% } else { %>
        Send via PayPal, then record the transaction below.
        <% } %>
      </div>
      <% if (typeof payoutsLive !== 'undefined' && payoutsLive && payable > 0) { %>
      <form method="POST" action="/delegates/admin/<%= delegate._id %>/paypal-payout" data-guard="button" style="margin-bottom:14px;">
        <input type="hidden" name="idemKey" value="<%= payoutIdem %>">
        <button type="submit" class="btn btn-gold" onclick="return confirm('Send a LIVE PayPal payout of $<%= payable.toFixed(2) %> to <%= delegate.taxInfo ? delegate.email : delegate.email %> now? This moves real money and cannot be undone.')">💸 Send $<%= payable.toFixed(2) %> via PayPal now</button>
        <span style="font-size:11px;color:#737373;margin-left:8px;">→ <%= delegate.payoutEmail || delegate.email %></span>
      </form>
      <% } %>
      <% } %>
      <form method="POST" action="/delegates/admin/<%= delegate._id %>/payout" class="payout-form" data-guard data-guard-label="Logging payout...">
        <input type="hidden" name="method" value="paypal">
        <div class="form-group">
          <label>Amount ($)</label>
          <input type="number" name="amount" step="0.01" min="0.01" max="<%= payable.toFixed(2) %>" required placeholder="0.00" style="width:120px;" <%= taxComplete ? '' : 'disabled' %>>
        </div>
        <div class="form-group">
          <label>PayPal Transaction ID</label>
          <input type="text" name="paypalTxn" placeholder="e.g. 7XW12345AB678901C" style="width:220px;" <%= taxComplete ? '' : 'disabled' %>>
        </div>
        <div class="form-group">
          <label>Note (optional)</label>
          <input type="text" name="note" placeholder="e.g. March 2026 commission" style="width:240px;" <%= taxComplete ? '' : 'disabled' %>>
        </div>
        <button type="submit" class="btn btn-gold" <%= taxComplete ? '' : 'disabled style=\"opacity:0.5;cursor:not-allowed;\"' %>>Log Payout</button>
      </form>
    </div>

    <!-- Payout history -->
    <div class="section">
      <h2>Payout History</h2>
      <% if (payouts.length) { %>
      <table>
        <thead><tr><th>Date</th><th>Period</th><th>Amount</th><th>Method</th><th>PayPal Txn</th><th>Note</th><th>By</th></tr></thead>
        <tbody>
          <% for (const p of payouts) { %>
          <tr>
            <td><%= new Date(p.createdAt).toLocaleDateString() %></td>
            <td><%= p.period %></td>
            <td style="color:#4ade80;font-weight:600;">$<%= p.amount.toFixed(2) %></td>
            <td><%= p.method %></td>
            <td style="font-family:monospace;font-size:11px;color:#a3a3a3;"><%= p.paypalTxn || '—' %></td>
            <td style="color:#737373;"><%= p.note || '—' %></td>
            <td style="color:#737373;"><%= p.createdBy %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } else { %>
        <div class="empty">No payouts recorded yet.</div>
      <% } %>
    </div>
  </div>
<script src="/js/loadingWheel.js" defer></script>
</body>
</html>
