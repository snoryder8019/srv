<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sales Sheets — Delegate Panel — sLab</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <%- include('partials/theme') %>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; }
    .topbar { background:var(--card); border-bottom:1px solid var(--border); padding:14px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; }
    .topbar-left { display:flex; align-items:center; gap:16px; }
    .logo { font-size:20px; font-weight:600; color:var(--heading); } .logo span { color:var(--gold); }
    .badge { font-size:10px; text-transform:uppercase; letter-spacing:1.2px; color:var(--gold); background:var(--border); padding:3px 8px; border-radius:4px; }
    .topbar-right { display:flex; align-items:center; gap:16px; font-size:13px; color:var(--mute); }
    .topbar-right a { color:var(--dim); text-decoration:none; font-size:12px; } .topbar-right a:hover { color:var(--gold); }
    .container { max-width:960px; margin:0 auto; padding:24px; }
    h1 { font-size:22px; font-weight:600; color:var(--heading); margin-bottom:4px; }
    .subtitle { font-size:13px; color:var(--mute); margin-bottom:24px; }
    .promo-banner { background:linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border:1px solid var(--gold); border-radius:8px; padding:20px 24px; margin-bottom:28px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
    .promo-icon { font-size:28px; }
    .promo-text h3 { font-size:14px; font-weight:600; color:var(--gold); margin-bottom:4px; }
    .promo-text p { font-size:13px; color:var(--dim); line-height:1.5; }
    .ref-box { background:var(--bg); border:1px solid #333; border-radius:6px; padding:10px 16px; margin-left:auto; text-align:center; }
    .ref-box label { font-size:10px; text-transform:uppercase; letter-spacing:0.8px; color:var(--faint); display:block; margin-bottom:4px; }
    .ref-box code { font-size:16px; font-weight:700; color:var(--gold); }
    .ref-url { font-size:11px; color:var(--faint); margin-top:6px; word-break:break-all; }
    .ref-url a { color:var(--mute); }
    .brands-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:16px; margin-bottom:28px; }
    .brand-card { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:24px; transition:border-color 0.2s; cursor:pointer; text-decoration:none; color:inherit; display:block; }
    .brand-card:hover { border-color:var(--gold); }
    .brand-name { font-size:18px; font-weight:600; color:var(--heading); margin-bottom:4px; }
    .brand-domain { font-size:12px; color:var(--mute); margin-bottom:12px; }
    .brand-tagline { font-size:13px; color:var(--dim); line-height:1.5; margin-bottom:16px; min-height:40px; }
    .brand-stats { display:flex; gap:16px; padding-top:12px; border-top:1px solid var(--border); }
    .brand-stat { text-align:center; flex:1; }
    .brand-stat-value { font-size:20px; font-weight:700; color:var(--heading); }
    .brand-stat-value.gold { color:var(--gold); }
    .brand-stat-value.green { color:#4ade80; }
    .brand-stat-label { font-size:10px; text-transform:uppercase; letter-spacing:0.8px; color:var(--faint); margin-top:2px; }
    .empty-state { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:40px; text-align:center; }
    .empty-state h3 { font-size:16px; color:var(--heading); margin-bottom:8px; }
    .empty-state p { font-size:13px; color:var(--mute); line-height:1.6; }
    .pitch-section { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:24px; margin-bottom:20px; }
    .pitch-section h2 { font-size:16px; font-weight:600; color:var(--heading); margin-bottom:16px; padding-bottom:10px; border-bottom:1px solid var(--border); }
    .pitch-points { list-style:none; }
    .pitch-points li { padding:8px 0; font-size:13px; color:var(--dim); line-height:1.5; border-bottom:1px solid var(--border-soft); display:flex; gap:8px; }
    .pitch-points li:last-child { border-bottom:0; }
    .pitch-points .bullet { color:var(--gold); font-weight:700; flex-shrink:0; }
    @media (max-width:600px) { .brands-grid { grid-template-columns:1fr; } .container { padding:16px; } .promo-banner { flex-direction:column; } .ref-box { margin-left:0; } }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-left">
      <div class="logo"><span>s</span>Lab</div>
      <span class="badge">Delegate</span>
    </div>
    <div class="topbar-right">
      <span><%= delegate.firstName %> <%= delegate.lastName %></span>
      <a href="/delegates/panel">Dashboard</a>
      <a href="/delegates/panel/sales-sheets">Sales Sheets</a>
      <a href="/delegates/panel/settings">Settings</a>
      <a href="/delegates/logout">Logout</a>
      <button id="themeToggle" onclick="slabToggleTheme()" title="Toggle light / dark">☀️</button>
    </div>
  </div>

  <div class="container">
    <h1>Sales Sheets</h1>
    <div class="subtitle">Sell Slab subscriptions &middot; assigned brands and lead tracking</div>

    <!-- Promo Banner -->
    <div class="promo-banner">
      <div class="promo-text">
        <h3><%= promo.type %></h3>
        <p><%= promo.description %></p>
      </div>
      <div class="ref-box">
        <label>Your Referral Code</label>
        <code><%= delegate.refCode %></code>
        <div class="ref-url">Share: <a href="/start?ref=<%= delegate.refCode %>">/start?ref=<%= delegate.refCode %></a></div>
      </div>
    </div>

    <!-- Active Promo Codes (disabled/expired codes are excluded server-side) -->
    <% if (promoCodes && promoCodes.length) { %>
    <div style="background:#141414;border:1px solid #262626;border-radius:8px;padding:16px 20px;margin-bottom:28px;">
      <div style="font-size:12px;font-weight:600;color:#c9a848;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:12px;">Your Active Promo Codes</div>
      <% for (const pc of promoCodes) { %>
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:8px 0;border-top:1px solid #1f1f1f;">
        <code style="font-size:15px;font-weight:700;color:#c9a848;font-family:monospace;"><%= pc.code %></code>
        <span style="font-size:12px;color:#a3a3a3;"><%= pc.freeDays %>-day free trial<% if (pc.label && pc.label !== pc.code) { %> &middot; <%= pc.label %><% } %><% if (pc.expiresAt) { %> &middot; expires <%= new Date(pc.expiresAt).toLocaleDateString() %><% } %></span>
        <a style="font-size:12px;color:#c9a848;margin-left:auto;" href="/start?ref=<%= pc.code %>">/start?ref=<%= pc.code %></a>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Pitch Quick-Reference: 25 selling points & facts about Slab -->
    <div class="pitch-section">
      <h2>25 Reasons to Sell Slab</h2>

      <div style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#c9a848;margin:14px 0 8px;">The Platform</div>
      <ul class="pitch-points">
        <li><span class="bullet">1.</span> Slab is a complete white-label web platform — your subscriber gets a full branded website, not a rented template.</li>
        <li><span class="bullet">2.</span> One dashboard runs everything: site content, blog, pages, design, CRM, email, social, and AI tools.</li>
        <li><span class="bullet">3.</span> Full custom branding — their logo, colors, fonts, and voice. It's their brand end to end.</li>
        <li><span class="bullet">4.</span> Live in minutes: claim a subdomain, brand it, publish — connect a custom domain anytime.</li>
        <li><span class="bullet">5.</span> Block-based page builder — assemble any page from reusable content blocks, no code required.</li>
        <li><span class="bullet">6.</span> In-preview visual editor — edit the live site directly, exactly as visitors will see it.</li>
      </ul>

      <div style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#c9a848;margin:16px 0 8px;">Marketing &amp; Content</div>
      <ul class="pitch-points">
        <li><span class="bullet">7.</span> Built-in blog with per-page SEO controls to win organic traffic.</li>
        <li><span class="bullet">8.</span> Email marketing included — capture subscribers and send campaigns without a separate tool.</li>
        <li><span class="bullet">9.</span> Full social suite: compose, schedule, and auto-post to Instagram, LinkedIn, and Threads.</li>
        <li><span class="bullet">10.</span> Social insights — reach and engagement tracked right in the dashboard.</li>
        <li><span class="bullet">11.</span> Instagram 9-grid mural planner — design cohesive multi-post grids on an automated schedule.</li>
        <li><span class="bullet">12.</span> AI copy &amp; design tools generate posts, page copy, and brand assets on demand.</li>
        <li><span class="bullet">13.</span> SEO tooling to tune titles, meta, and structured content page by page.</li>
      </ul>

      <div style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#c9a848;margin:16px 0 8px;">Business Tools</div>
      <ul class="pitch-points">
        <li><span class="bullet">14.</span> Built-in CRM captures and tracks leads from every form on the site.</li>
        <li><span class="bullet">15.</span> Meetings &amp; booking module — clients schedule time, with QR check-in and notes.</li>
        <li><span class="bullet">16.</span> Print Studio for branded print and marketing collateral.</li>
        <li><span class="bullet">17.</span> Careers module with private, encrypted résumé handling.</li>
        <li><span class="bullet">18.</span> Analytics dashboard: traffic, endpoint usage, and conversion signals.</li>
        <li><span class="bullet">19.</span> Network hub — opt in to cross-promote content across the Slab network.</li>
        <li><span class="bullet">20.</span> Shareable links with auto-generated QR codes for any campaign.</li>
      </ul>

      <div style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#c9a848;margin:16px 0 8px;">Trust &amp; Commercials</div>
      <ul class="pitch-points">
        <li><span class="bullet">21.</span> Payments built in — PayPal and Stripe both supported out of the box.</li>
        <li><span class="bullet">22.</span> Secure by design: encrypted key vault for API keys and private storage for sensitive files.</li>
        <li><span class="bullet">23.</span> Every subscriber's data is isolated to their own tenant.</li>
        <li><span class="bullet">24.</span> Simple pricing: $39.95/mo, 8% off quarterly, 10% off annual — no setup fees.</li>
        <li><span class="bullet">25.</span> You earn recurring commission on every subscriber — 40% of net year 1, 20% year 2, 10% ongoing.</li>
      </ul>
    </div>

    <!-- Brand Cards -->
    <% if (brands.length) { %>
    <div class="brands-grid">
      <% for (const b of brands) { %>
      <a href="/delegates/panel/sales-sheets/<%= b.tenantId %>" class="brand-card">
        <div class="brand-name"><%= b.brandName %></div>
        <div class="brand-domain"><%= b.domain %></div>
        <div class="brand-tagline"><%= b.tagline || b.description || 'No description set' %></div>
        <div class="brand-stats">
          <div class="brand-stat">
            <div class="brand-stat-value"><%= b.leadCount %></div>
            <div class="brand-stat-label">Leads</div>
          </div>
          <div class="brand-stat">
            <div class="brand-stat-value green"><%= b.convertedCount %></div>
            <div class="brand-stat-label">Converted</div>
          </div>
          <div class="brand-stat">
            <div class="brand-stat-value gold"><%= b.leadCount ? Math.round((b.convertedCount / b.leadCount) * 100) : 0 %>%</div>
            <div class="brand-stat-label">Conv. Rate</div>
          </div>
        </div>
      </a>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <h3>No brands assigned yet</h3>
      <p>Your admin will attach brands to your account. Once assigned, you'll see sales sheets with brand details, pricing info, and lead tracking tools here.</p>
    </div>
    <% } %>
  </div>
</body>
</html>
