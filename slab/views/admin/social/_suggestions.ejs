<style>
  .ss-bar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; }
  .ss-bar .ss-hint { font-size:0.78rem; color:var(--slate); }
  .ss-tools { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .ss-toggle { display:flex; align-items:center; gap:8px; font-size:0.78rem; color:var(--on-surface); background:var(--surface); border:1px solid var(--border); border-radius:6px; padding:7px 12px; }
  .ss-switch { position:relative; width:38px; height:21px; } .ss-switch input { display:none; }
  .ss-slide { position:absolute; inset:0; background:#cbd5e1; border-radius:21px; transition:.2s; }
  .ss-slide::before { content:''; position:absolute; width:15px; height:15px; left:3px; top:3px; background:#fff; border-radius:50%; transition:.2s; }
  .ss-switch input:checked + .ss-slide { background:#15803D; }
  .ss-switch input:checked + .ss-slide::before { transform:translateX(17px); }
  .ss-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(270px,1fr)); gap:16px; }
  .ss-card { border:1px solid var(--border); border-radius:8px; background:var(--surface); overflow:hidden; display:flex; flex-direction:column; }
  .ss-img { width:100%; aspect-ratio:1/1; object-fit:cover; background:var(--ivory); display:block; }
  .ss-body { padding:12px; display:flex; flex-direction:column; gap:9px; flex:1; }
  .ss-badges { display:flex; gap:6px; flex-wrap:wrap; }
  .ss-badge { font-size:0.6rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; padding:2px 7px; border-radius:3px; background:rgba(28,43,74,.08); color:var(--navy); }
  .ss-badge.dim { background:rgba(201,168,72,.18); color:#8a6d1e; }
  .ss-cap { width:100%; border:1px solid var(--border); border-radius:5px; padding:8px; font-size:0.78rem; color:var(--on-surface); background:var(--ivory); resize:vertical; min-height:72px; font-family:inherit; }
  .ss-actions { display:flex; gap:6px; flex-wrap:wrap; margin-top:auto; }
  .ss-b { border:1px solid var(--border); background:var(--surface); color:var(--on-surface); padding:7px 11px; border-radius:6px; font-size:0.74rem; font-weight:500; cursor:pointer; }
  .ss-b:hover { border-color:var(--navy-mid); } .ss-b.primary { background:var(--navy); color:#fff; border-color:var(--navy); }
  .ss-b.gold { background:var(--gold,#C9A848); color:#0F1B30; border-color:var(--gold,#C9A848); font-weight:600; } .ss-b.danger { color:var(--danger,#b91c1c); }
  .ss-modal { position:fixed; inset:0; background:rgba(15,27,48,.6); z-index:1000; display:none; align-items:center; justify-content:center; padding:20px; }
  .ss-modal.open { display:flex; }
  .ss-mbox { background:var(--surface); border-radius:10px; width:min(900px,100%); max-height:90vh; overflow:auto; padding:20px; display:grid; grid-template-columns:1fr 280px; gap:18px; }
  .ss-mbox h3 { grid-column:1/-1; margin:0; font-family:var(--font-heading); color:var(--on-surface); }
  .ss-cwrap { display:flex; justify-content:center; background:var(--ivory); border-radius:8px; padding:10px; }
  #ssCanvas { max-width:100%; height:auto; border:1px solid var(--border); border-radius:4px; }
  .ss-ctrls { display:flex; flex-direction:column; gap:10px; font-size:0.74rem; }
  .ss-grp { border:1px solid var(--border); border-radius:6px; padding:10px; }
  .ss-grp label { display:block; font-weight:600; color:var(--slate); margin-bottom:4px; font-size:0.64rem; text-transform:uppercase; }
  .ss-grp input[type=text] { width:100%; border:1px solid var(--border); border-radius:4px; padding:6px; font-size:0.76rem; margin-bottom:6px; }
  .ss-r { display:flex; gap:6px; } .ss-r > * { flex:1; min-width:0; }
  .ss-mact { grid-column:1/-1; display:flex; justify-content:flex-end; gap:8px; border-top:1px solid var(--border); padding-top:14px; }

  /* ── Suggestions (partial) mobile ───────────────────────────────────── */
  @media (max-width: 820px) {
    /* Toolbar: wrap all controls */
    .ss-bar { flex-direction: column; align-items: flex-start; }
    .ss-tools { flex-wrap: wrap; width: 100%; }
    .ss-toggle { flex: 1 1 auto; }

    /* Cards grid: 2 columns on tablet */
    .ss-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }

    /* Layer editor modal: stack canvas + controls */
    .ss-mbox { grid-template-columns: 1fr; }
    .ss-mbox h3 { grid-column: 1; }
    .ss-mact { grid-column: 1; }
    #ssCanvas { max-width: 100%; }

    /* Spotlight modal: comfortable width */
    .ss-mbox[style*="max-width:520px"] { padding: 14px; }
  }

  @media (max-width: 520px) {
    /* Cards: single column */
    .ss-grid { grid-template-columns: 1fr; }

    /* Card actions: stack */
    .ss-actions { flex-direction: column; }
    .ss-b, a.ss-b { width: 100%; text-align: center; box-sizing: border-box; }

    /* Toolbar toggles + count + generate: full width */
    .ss-tools { flex-direction: column; align-items: stretch; }
    .ss-toggle { width: 100%; }
    #ssCount { width: 100%; }
    #ssGenerate, #ssSpotlightBtn { width: 100%; }

    /* Modal: near full screen */
    .ss-modal { padding: 6px; }
    .ss-mbox { padding: 12px; border-radius: 8px; max-height: 88dvh; overflow-y: auto; }
    .ss-mact { justify-content: stretch; }
    .ss-mact .ss-b { flex: 1; text-align: center; }
  }
</style>

<div class="ss-bar">
  <div class="ss-hint">AI-drafted posts, one per connected platform at its required size. Edit the layers &amp; copy, then <strong>Approve &amp; Post</strong> — nothing goes live until you do.</div>
  <div class="ss-tools">
    <label class="ss-toggle" title="When on, the daily cron drops fresh suggestions here automatically">
      <span class="ss-switch"><input type="checkbox" id="ssCron" <%= (autoSocial && autoSocial.enabled) ? 'checked' : '' %>><span class="ss-slide"></span></span> Auto-cron
    </label>
    <label class="ss-toggle" title="When on, the cron posts these live automatically and skips manual review">
      <span class="ss-switch"><input type="checkbox" id="ssAutoPub" <%= (autoSocial && autoSocial.autoPublish) ? 'checked' : '' %>><span class="ss-slide"></span></span> Auto-publish
    </label>
    <input type="number" id="ssCount" value="<%= (autoSocial && autoSocial.count) || 5 %>" min="1" max="10" style="width:54px;padding:8px;border:1px solid var(--border);border-radius:6px;">
    <%# DISABLED FOR RELEASE: Listening trends toggle (hidden; JS ref stays null-safe) %>
    <label class="ss-toggle" style="display:none;" title="Fold recent keyword/trend findings (Listening tab) into this batch">
      <span class="ss-switch"><input type="checkbox" id="ssTrends"><span class="ss-slide"></span></span> Use trends
    </label>
    <button class="ss-b" id="ssSpotlightBtn" title="Build a post around a quote — owner spotlight, mission, or customer">★ Spotlight</button>
    <button class="ss-b gold" id="ssGenerate">✦ Generate fresh</button>
  </div>
</div>

<div class="ss-grid" id="ssGrid">
  <% if (!suggestions || !suggestions.length) { %>
    <div class="card empty" style="grid-column:1/-1;"><div class="empty-icon">✦</div><p>No suggestions yet. Hit <strong>Generate fresh</strong> to draft a batch sized for your connected platforms.</p></div>
  <% } %>
  <% (suggestions||[]).forEach(function(s){ %>
    <div class="ss-card" data-id="<%= s._id %>">
      <img class="ss-img" src="<%= (s.mediaUrls&&s.mediaUrls[0])||'' %>" alt="" loading="lazy">
      <div class="ss-body">
        <div class="ss-badges"><span class="ss-badge"><%= (s.platforms&&s.platforms[0])||'social' %></span><span class="ss-badge dim"><%= s.dims || '' %></span><% if (s.kind) { %><span class="ss-badge kind"><%= String(s.kind).indexOf('spotlight')===0 ? '★ '+String(s.kind).replace('spotlight-','') : s.kind %></span><% } %></div>
        <textarea class="ss-cap" data-id="<%= s._id %>"><%= s.body || '' %></textarea>
        <div class="ss-actions">
          <button class="ss-b" onclick="ssEdit('<%= s._id %>')">✎ Quick</button>
          <a class="ss-b" href="/admin/assets/social?suggestion=<%= s._id %>" style="text-decoration:none;text-align:center;" title="Open in the full Asset Generator">🎨 Studio</a>
          <button class="ss-b primary" onclick="ssApprove('<%= s._id %>', this)">Approve &amp; Post</button>
          <button class="ss-b danger" onclick="ssDismiss('<%= s._id %>', this)">Dismiss</button>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<div class="ss-modal" id="ssModal"><div class="ss-mbox">
  <h3>Edit layers</h3>
  <div class="ss-cwrap"><canvas id="ssCanvas"></canvas></div>
  <div class="ss-ctrls" id="ssCtrls"></div>
  <div class="ss-mact"><button class="ss-b" onclick="ssCloseModal()">Cancel</button><button class="ss-b primary" id="ssSaveBtn" onclick="ssSave()">Save changes</button></div>
</div></div>


<div class="ss-modal" id="ssSpotModal"><div class="ss-mbox" style="grid-template-columns:1fr;max-width:520px;">
  <h3>Quote / Spotlight</h3>
  <div class="ss-ctrls" style="grid-column:1/-1;">
    <div class="ss-grp">
      <label>Type</label>
      <select id="spotKind" style="width:100%;border:1px solid var(--border);border-radius:4px;padding:7px;font-size:0.8rem;">
        <option value="owner">Owner spotlight</option>
        <option value="mission">Mission</option>
        <option value="customer">Customer quote</option>
      </select>
    </div>
    <div class="ss-grp">
      <label>Who / what (name or title)</label>
      <input type="text" id="spotSubject" placeholder="e.g. Scott Wallace">
      <label style="margin-top:6px;">Role (optional)</label>
      <input type="text" id="spotRole" placeholder="e.g. Founder">
    </div>
    <div class="ss-grp">
      <label>Quote (used exactly as written — never invented)</label>
      <textarea id="spotQuote" class="ss-cap" placeholder="Paste the quote here…" style="min-height:90px;"></textarea>
    </div>
  </div>
  <div class="ss-mact"><button class="ss-b" onclick="ssSpotClose()">Cancel</button><button class="ss-b primary" id="ssSpotGo" onclick="ssSpotGo()">Create spotlight</button></div>
</div></div>

<script>
const SUGG = <%- JSON.stringify(suggestions || []) %>;
const byId = {}; SUGG.forEach(s => byId[String(s._id)] = s);
let EDIT = null;
const SP = { 'ig-post':[1080,1080],'ig-story':[1080,1920],'fb-post':[1200,630],'fb-cover':[1640,624],'twitter':[1600,900],'pinterest':[1000,1500],'yt-thumb':[1280,720],'linkedin':[1200,627],'ig-portrait':[1080,1350] };
function ssDrawLayers(ctx, design, w, h) {
  (design.layers||[]).forEach(L => { ctx.save(); ctx.globalAlpha = L.opacity ?? 1;
    if (L.type==='rect' && L.fill) { ctx.fillStyle=L.fill; ctx.fillRect(L.x,L.y,L.w,L.h); }
    else if (L.type==='text' && L.text) { const fs=L.fontSize||48, fam=L.fontFamily==='serif'?'serif':'sans-serif'; ctx.font=(L.bold?'bold ':'')+fs+'px '+fam; ctx.fillStyle=L.color||'#fff'; ctx.textAlign=L.align||'center'; ctx.textBaseline='top';
      const maxW=L.w||w-40, words=String(L.text).split(' '); let line='', lines=[]; words.forEach(word=>{const t=line?line+' '+word:word; if(ctx.measureText(t).width>maxW&&line){lines.push(line);line=word;}else line=t;}); if(line)lines.push(line);
      let dx=L.x||0; if(ctx.textAlign==='center')dx+=maxW/2; else if(ctx.textAlign==='right')dx+=maxW; lines.forEach((ln,i)=>ctx.fillText(ln,dx,(L.y||0)+i*fs*1.3)); }
    ctx.restore(); });
}
function ssRender(design) {
  const c=document.getElementById('ssCanvas'); const [w,h]=SP[design.size]||SP['ig-post']; c.width=w; c.height=h; const ctx=c.getContext('2d');
  const base=()=>{ctx.fillStyle=design.bgColor||'#0D0D14';ctx.fillRect(0,0,w,h);};
  if (design.sdBgUrl) { const img=new Image(); img.onload=()=>{base();ctx.drawImage(img,0,0,w,h);ssDrawLayers(ctx,design,w,h);}; img.onerror=()=>{base();ssDrawLayers(ctx,design,w,h);}; img.src=design.sdBgUrl; }
  else { base(); ssDrawLayers(ctx,design,w,h); }
}
function ssCtrls(design) {
  const wrap=document.getElementById('ssCtrls'); wrap.innerHTML='';
  (design.layers||[]).forEach((L,i)=>{ if(L.type!=='text')return; const g=document.createElement('div'); g.className='ss-grp';
    g.innerHTML='<label>Text layer '+(i+1)+'</label><input type="text" value="'+(L.text||'').replace(/"/g,'&quot;')+'" oninput="ssUpd('+i+',\'text\',this.value)">'+
    '<div class="ss-r"><input type="number" title="size" value="'+(L.fontSize||48)+'" oninput="ssUpd('+i+',\'fontSize\',+this.value)"><input type="color" title="color" value="'+(L.color||'#ffffff')+'" oninput="ssUpd('+i+',\'color\',this.value)"></div>'+
    '<div class="ss-r"><input type="number" title="x" value="'+(L.x||0)+'" oninput="ssUpd('+i+',\'x\',+this.value)"><input type="number" title="y" value="'+(L.y||0)+'" oninput="ssUpd('+i+',\'y\',+this.value)"></div>';
    wrap.appendChild(g); });
}
function ssUpd(i,k,v){ EDIT.design.layers[i][k]=v; ssRender(EDIT.design); }
function ssEdit(id){ const s=byId[id]; if(!s||!s.design){alert('No editable design stored.');return;} EDIT={id,design:JSON.parse(JSON.stringify(s.design))}; ssRender(EDIT.design); ssCtrls(EDIT.design); document.getElementById('ssModal').classList.add('open'); }
function ssCloseModal(){ document.getElementById('ssModal').classList.remove('open'); EDIT=null; }
async function ssSave(){ if(!EDIT)return; const b=document.getElementById('ssSaveBtn'); b.disabled=true; b.textContent='Rendering…'; const cap=document.querySelector('.ss-cap[data-id="'+EDIT.id+'"]');
  try{ const r=await fetch('/admin/social/suggestions/'+EDIT.id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({body:cap?cap.value:undefined,design:EDIT.design})}); const d=await r.json();
    if(d.ok){ if(d.mediaUrl){const img=document.querySelector('.ss-card[data-id="'+EDIT.id+'"] .ss-img'); if(img)img.src=d.mediaUrl+'?t='+Date.now(); byId[EDIT.id].mediaUrls=[d.mediaUrl];} byId[EDIT.id].design=EDIT.design; ssCloseModal(); } else alert(d.error||'Save failed'); }
  catch(e){ alert('Save failed'); } b.disabled=false; b.textContent='Save changes'; }
async function ssApprove(id,btn){ btn.disabled=true; btn.textContent='Posting…'; const cap=document.querySelector('.ss-cap[data-id="'+id+'"]');
  try{ if(cap) await fetch('/admin/social/suggestions/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({body:cap.value})}); const r=await fetch('/admin/social/suggestions/'+id+'/approve',{method:'POST'}); const d=await r.json();
    if(d.ok){const card=document.querySelector('.ss-card[data-id="'+id+'"]'); if(card){card.style.opacity=.5; card.querySelector('.ss-actions').innerHTML='<span style="color:var(--success);font-size:0.75rem;font-weight:600;">✓ Posted</span>';}} else {btn.disabled=false;btn.textContent='Approve & Post';alert(d.error||'Publish failed');} }
  catch(e){ btn.disabled=false; btn.textContent='Approve & Post'; alert('Publish failed'); } }
async function ssDismiss(id,btn){ if(!confirm('Dismiss this suggestion? Its draft + image will be removed.'))return; btn.disabled=true;
  try{ const r=await fetch('/admin/social/suggestions/'+id+'/dismiss',{method:'POST'}); const d=await r.json(); if(d.ok){const c=document.querySelector('.ss-card[data-id="'+id+'"]'); if(c)c.remove();} else {btn.disabled=false;alert(d.error||'Failed');} }
  catch(e){ btn.disabled=false; alert('Failed'); } }
document.getElementById('ssGenerate').addEventListener('click', async function(){ const btn=this; const count=+document.getElementById('ssCount').value||5; btn.disabled=true; btn.textContent='Generating…';
  try{ const r=await fetch('/admin/social/suggestions/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({count, useTrends: document.getElementById('ssTrends')?.checked || false})}); const d=await r.json(); if(d.ok) location.href='?tab=suggestions'; else {btn.disabled=false;btn.textContent='✦ Generate fresh';alert(d.error||'Generation failed');} }
  catch(e){ btn.disabled=false; btn.textContent='✦ Generate fresh'; alert('Generation failed'); } });
async function ssSaveToggles(){ const enabled=document.getElementById('ssCron').checked; const autoPublish=document.getElementById('ssAutoPub').checked; const count=+document.getElementById('ssCount').value||5;
  try{ await fetch('/admin/social/auto-toggle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled,autoPublish,count})}); } catch(e){ alert('Could not update cron setting'); } }
document.getElementById('ssCron').addEventListener('change', ssSaveToggles);
document.getElementById('ssAutoPub').addEventListener('change', ssSaveToggles);
document.getElementById('ssCount').addEventListener('change', ssSaveToggles);

function ssSpotOpen(){ document.getElementById('ssSpotModal').classList.add('open'); }
function ssSpotClose(){ document.getElementById('ssSpotModal').classList.remove('open'); }
document.getElementById('ssSpotlightBtn').addEventListener('click', ssSpotOpen);
async function ssSpotGo(){
  const btn=document.getElementById('ssSpotGo');
  const quote=(document.getElementById('spotQuote').value||'').trim();
  if(!quote){ document.getElementById('spotQuote').focus(); return; }
  btn.disabled=true; btn.textContent='Creating…';
  try{
    const r=await fetch('/admin/social/suggestions/spotlight',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ kind:document.getElementById('spotKind').value, subject:document.getElementById('spotSubject').value, role:document.getElementById('spotRole').value, quote })});
    const d=await r.json();
    if(d.ok) location.href='?tab=suggestions'; else { btn.disabled=false; btn.textContent='Create spotlight'; alert(d.error||'Failed'); }
  }catch(e){ btn.disabled=false; btn.textContent='Create spotlight'; alert('Failed'); }
}
</script>
