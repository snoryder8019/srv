async function agSaveAuto() {
  const msg = document.getElementById('apMsg'); msg.textContent = 'Saving…';
  const channels = Array.from(document.querySelectorAll('.ap-ch:checked')).map(c => c.value);
  const promote = Array.from(document.querySelectorAll('.ap-promote:checked')).map(c => c.value);
  const body = {
    enabled: document.getElementById('apEnabled').checked,
    cadence: document.getElementById('apCadence').value,
    count: parseInt(document.getElementById('apCount').value, 10) || 3,
    standingPrompt: document.getElementById('apPrompt').value,
    channels,
    promote,
    leadGen: document.getElementById('apLeadGen').checked,
    assetTags: document.getElementById('apAssetTags') ? document.getElementById('apAssetTags').value : '',
    useTrends: document.getElementById('apTrends').checked,
    critic: document.getElementById('apCritic').checked,
    autoSlot: document.getElementById('apAutoSlot') ? document.getElementById('apAutoSlot').checked : false,
    autoPublish: document.getElementById('apPublish').checked,
  };
  try {
    const j = await agJson('/admin/social/auto-toggle', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    msg.textContent = j.ok ? '✓ Saved' : ('⚠ ' + (j.error || 'Failed'));
    return j;
  } catch (e) { msg.textContent = '⚠ ' + e.message; return { ok: false }; }
}
// Start/Stop the campaign (toggles Enabled + a sane cadence, saves, reloads status).
async function agAutoToggleRun() {
  const cb = document.getElementById('apEnabled');
  cb.checked = !cb.checked;
  if (cb.checked && document.getElementById('apCadence').value === 'off') document.getElementById('apCadence').value = 'daily';
  const j = await agSaveAuto();
  if (j && j.ok) location.reload();
}
// Delete the campaign: stop it and clear the settings.
async function agAutoDelete() {
  if (!confirm('Delete this autopilot campaign? It stops running and clears its settings.')) return;
  document.getElementById('apEnabled').checked = false;
  document.getElementById('apCadence').value = 'off';
  document.getElementById('apPrompt').value = '';
  const at = document.getElementById('apAssetTags'); if (at) at.value = '';
  document.querySelectorAll('.ap-ch:checked, .ap-promote:checked').forEach(c => c.checked = false);
  ['apLeadGen', 'apAutoSlot', 'apPublish'].forEach(id => { const e = document.getElementById(id); if (e) e.checked = false; });
  const j = await agSaveAuto();
  if (j && j.ok) location.reload();
}
</script>
