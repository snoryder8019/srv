<%
  // Agent Studio tab — Voice Profile (Brand DNA), async batch launcher with live
  // progress + review queue, and opt-in autopilot. Self-contained style + script.
  const v = (typeof voice !== 'undefined' && voice) ? voice : {};
  const vi = v.interview || {};
  const as = (typeof autoSocial !== 'undefined' && autoSocial) ? autoSocial : { enabled:false, count:3 };
  const cadence = as.cadence || 'off';
  const channels = Array.isArray(as.channels) ? as.channels : [];
  const conn = (typeof connectedKeys !== 'undefined' && connectedKeys) ? connectedKeys : [];
  const liveDefs = (typeof platforms !== 'undefined' ? platforms : []).filter(p => conn.includes(p.key));
  const qval = (q) => (vi[q.key] !== undefined ? vi[q.key] : (Array.isArray(v[q.key]) ? v[q.key].join(', ') : (v[q.key] || '')));
%>
<style>
  .ag-wrap { display:grid; grid-template-columns:1fr; gap:18px; }
  .ag-h { display:flex; align-items:center; gap:8px; margin:0 0 4px; font-family:var(--font-heading); color:var(--on-surface); font-size:1.05rem; }
  .ag-sub { font-size:0.78rem; color:var(--slate); margin:0 0 14px; }
  .ag-grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:12px; }
  .ag-field { display:flex; flex-direction:column; gap:4px; margin-bottom:10px; }
  .ag-field label { font-size:0.66rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--slate); }
  .ag-field input[type=text], .ag-field textarea, .ag-field select { width:100%; border:1px solid var(--border); border-radius:6px; padding:8px 10px; font-size:0.82rem; font-family:inherit; background:var(--surface); color:var(--on-surface); }
  .ag-field textarea { resize:vertical; min-height:54px; }
  .ag-row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .ag-chk { display:inline-flex; align-items:center; gap:7px; font-size:0.78rem; color:var(--on-surface); border:1px solid var(--border); border-radius:6px; padding:7px 11px; cursor:pointer; background:var(--surface); }
  .ag-chk input { accent-color:var(--navy); }
  .ag-block { width:100%; border:1px solid var(--border); border-radius:6px; padding:10px; font-size:0.78rem; font-family:ui-monospace,Menlo,monospace; background:var(--ivory); color:var(--on-surface); min-height:150px; resize:vertical; white-space:pre; }
  .ag-prog { border:1px solid var(--border); border-radius:8px; padding:14px; background:var(--ivory); display:none; }
  .ag-prog.show { display:block; }
  .ag-track { height:10px; background:rgba(28,43,74,.12); border-radius:6px; overflow:hidden; margin:8px 0; }
  .ag-fill { height:100%; width:0%; background:var(--navy); transition:width .4s; }
  .ag-stage { font-size:0.76rem; color:var(--slate); }
  .ag-jobs { display:flex; flex-direction:column; gap:6px; }
  .ag-job { display:flex; justify-content:space-between; gap:10px; font-size:0.74rem; padding:7px 10px; border:1px solid var(--border); border-radius:6px; background:var(--surface); }
  .ag-pill { font-size:0.6rem; font-weight:700; text-transform:uppercase; padding:2px 7px; border-radius:3px; }
  .ag-pill.done { background:rgba(21,128,61,.14); color:#15803D; } .ag-pill.failed { background:rgba(185,28,28,.12); color:#b91c1c; }
  .ag-pill.running, .ag-pill.queued { background:rgba(201,168,72,.18); color:#8a6d1e; }
  .ag-corrections { font-size:0.74rem; color:var(--slate); }
  .ag-corrections .pair { border-left:2px solid var(--gold,#C9A848); padding:4px 0 4px 9px; margin:6px 0; }
  .ag-rev-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:14px; margin-top:14px; }
  .ag-rev { border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--surface); display:flex; flex-direction:column; }
  .ag-rev img { width:100%; aspect-ratio:1/1; object-fit:cover; background:var(--ivory); }
  .ag-rev .b { padding:10px; display:flex; flex-direction:column; gap:8px; flex:1; }
  .ag-rev textarea { width:100%; border:1px solid var(--border); border-radius:5px; padding:7px; font-size:0.76rem; min-height:64px; resize:vertical; font-family:inherit; background:var(--ivory); color:var(--on-surface); }
  .ag-rev .acts { display:flex; gap:6px; flex-wrap:wrap; margin-top:auto; }
  .ag-metarow { display:flex; align-items:center; gap:4px; }
  .ag-thumb { border:1px solid var(--border); background:var(--surface); border-radius:6px; padding:2px 7px; font-size:0.8rem; cursor:pointer; line-height:1.2; }
  .ag-thumb:hover { border-color:var(--navy-mid); }
  .ag-thumb.on-up { background:rgba(21,128,61,.16); border-color:#15803D; }
  .ag-thumb.on-down { background:rgba(185,28,28,.14); border-color:#b91c1c; }
  .ag-mem { font-size:0.74rem; color:var(--slate); }
  .ag-mem-list { display:flex; flex-direction:column; gap:5px; margin-top:10px; max-height:280px; overflow:auto; }
  .ag-mem-row { display:flex; align-items:center; gap:8px; font-size:0.72rem; border:1px solid var(--border); border-radius:6px; padding:6px 9px; background:var(--surface); }
  .ag-mem-row img { width:34px; height:34px; object-fit:cover; border-radius:4px; flex-shrink:0; background:var(--ivory); }
  .ag-mem-v { font-weight:700; } .ag-mem-v.up { color:#15803D; } .ag-mem-v.down { color:#b91c1c; }
  .ag-sched-row { margin-top:6px; align-items:center; }
  .ag-sched { flex:1; min-width:140px; font-size:0.72rem; padding:5px 7px; border:1px solid var(--border); border-radius:6px; background:var(--ivory); color:var(--on-surface); font-family:inherit; }
  .ag-b { border:1px solid var(--border); background:var(--surface); color:var(--on-surface); padding:7px 11px; border-radius:6px; font-size:0.74rem; font-weight:500; cursor:pointer; }
  .ag-b:hover { border-color:var(--navy-mid); } .ag-b.primary { background:var(--navy); color:#fff; border-color:var(--navy); }
  .ag-b.gold { background:var(--gold,#C9A848); color:#0F1B30; border-color:var(--gold,#C9A848); font-weight:600; } .ag-b.danger { color:#b91c1c; }
  .ag-note { font-size:0.72rem; color:var(--slate); }

  /* ── Agent Studio mobile ────────────────────────────────────────────── */
  @media (max-width: 820px) {
    /* Voice profile two-col interview grid collapses to 1 */
    .ag-grid2 { grid-template-columns: 1fr; }

    /* Agent review queue cards — single column */
    .ag-rev-grid { grid-template-columns: 1fr; }

    /* Launcher options row: wrap comfortably */
    .ag-row { flex-wrap: wrap; }

    /* Batch options: keep count + style dropdowns on same row */
    .ag-field[style*="max-width:120px"], .ag-field[style*="max-width:200px"] {
      max-width: none !important;
      flex: 1 1 120px;
    }

    /* Autopilot cadence / posts row: wrap */
    .ag-field[style*="max-width:160px"] { max-width: none !important; flex: 1 1 140px; }

    /* Progress bar row: stack title + pill */
    .ag-prog .ag-row[style*="justify-content:space-between"] { flex-direction: column; gap: 4px; align-items: flex-start; }

    /* Design memory list: allow long text to wrap */
    .ag-mem-row { flex-wrap: wrap; }
    .ag-mem-row span[style*="flex:1"] { min-width: 0; white-space: normal; }

    /* Job history rows */
    .ag-job { flex-direction: column; gap: 4px; }
  }

  @media (max-width: 520px) {
    /* Review card action rows: stack buttons */
    .ag-rev .acts { flex-direction: column; }
    .ag-rev .acts .ag-b, .ag-rev .acts a.ag-b { width: 100%; text-align: center; box-sizing: border-box; }

    /* Schedule row inside card: also stack */
    .ag-rev .acts.ag-sched-row { flex-direction: column; }
    .ag-rev .acts.ag-sched-row .ag-sched { width: 100%; }
    .ag-rev .acts.ag-sched-row .ag-b { width: 100%; text-align: center; }

    /* Platform checkboxes wrap */
    #agPlatforms, #apChannels { flex-wrap: wrap; gap: 6px; }

    /* Auto-slot batch button — full width */
    .ag-h button.ag-b[style*="margin-left:auto"] { margin-left: 0 !important; width: 100%; }

    /* Autopilot checkboxes row */
    .ag-row .ag-chk { flex: 1 1 auto; }
  }
</style>

<div class="ag-wrap">

  <!-- ── 1. VOICE PROFILE (Brand DNA) ───────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🎙️ Voice Profile <span class="ag-pill <%= v.voiceBlock ? 'done' : 'queued' %>"><%= v.voiceBlock ? 'configured' : 'not set' %></span></div>
    <p class="ag-sub">Teach the agent how <em>you</em> sound. Answer the prompts, let AI distill a profile, tweak it, and save. Every generator (Studio, Suggestions, Spotlight, compose helper, reply drafts) writes in this voice. Your edits to drafts keep refining it.</p>

    <div class="ag-grid2">
      <% voiceQuestions.forEach(function(q){ %>
        <div class="ag-field">
          <label><%= q.label %></label>
          <input type="text" id="vq_<%= q.key %>" placeholder="<%= q.placeholder || '' %>" value="<%= qval(q) %>">
        </div>
      <% }); %>
    </div>

    <div class="ag-row" style="margin:6px 0 14px;">
      <button class="ag-b primary" id="vSynth" onclick="agSynth()">✨ Synthesize with AI</button>
      <span class="ag-note" id="vSynthMsg"></span>
    </div>

    <div class="ag-field">
      <label>Voice block (injected into every prompt — edit freely)</label>
      <textarea class="ag-block" id="vBlock"><%= v.voiceBlock || '' %></textarea>
    </div>

    <div class="ag-row">
      <button class="ag-b gold" onclick="agSaveVoice()">💾 Save Voice Profile</button>
      <span class="ag-note" id="vSaveMsg"></span>
    </div>

    <% if (Array.isArray(v.fewShot) && v.fewShot.length) { %>
      <div class="ag-corrections" style="margin-top:14px;">
        <strong><%= v.fewShot.length %></strong> learned correction<%= v.fewShot.length === 1 ? '' : 's' %> from your edits:
        <% v.fewShot.slice(-3).reverse().forEach(function(p){ %>
          <div class="pair">→ <%= (p.after || '').slice(0,140) %></div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- ── 2. AGENT STUDIO LAUNCHER ───────────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🚀 Lead a Batch</div>
    <p class="ag-sub">Give the agent direction. It researches, drafts on-voice copy, generates an SD background per platform, optionally self-critiques, then drops everything into the review queue below — <strong>nothing posts automatically</strong>.</p>

    <div class="ag-field">
      <label>What should this batch be about?</label>
      <textarea id="agDir" placeholder="e.g. push our new print-studio service, lean into the 'we ship in days not months' angle, tie one post to the upcoming weekend"></textarea>
    </div>

    <div class="ag-row" style="margin-bottom:10px;">
      <div class="ag-field" style="max-width:120px;margin:0;">
        <label>Posts</label>
        <input type="text" id="agCount" value="3" style="text-align:center;">
      </div>
      <div class="ag-field" style="max-width:200px;margin:0;">
        <label>Background style</label>
        <select id="agStyle">
          <option value="solid" selected>🎨 Solid color + type</option>
          <option value="photo">🖼️ AI photo background</option>
          <option value="auto">🔀 Mix both</option>
        </select>
      </div>
      <%# DISABLED FOR RELEASE: Listening trends — input kept hidden so JS refs stay valid %>
      <label class="ag-chk" style="display:none;"><input type="checkbox" id="agTrends"> Use listening trends</label>
      <label class="ag-chk"><input type="checkbox" id="agCritic" checked> Run critic pass</label>
    </div>

    <div class="ag-field">
      <label>Platforms <span class="ag-note">(blank = all connected, one sized post each)</span></label>
      <div class="ag-row" id="agPlatforms">
        <% liveDefs.forEach(function(p){ %>
          <label class="ag-chk"><input type="checkbox" class="ag-pf" value="<%= p.key %>"> <%= p.icon || '' %> <%= p.name %></label>
        <% }); %>
        <% if (!liveDefs.length) { %><span class="ag-note">No platforms connected — add some under Connections.</span><% } %>
      </div>
    </div>

    <div class="ag-row">
      <button class="ag-b primary" id="agLaunch" onclick="agLaunch()">▶ Launch batch</button>
      <span class="ag-note" id="agLaunchMsg"></span>
    </div>

    <!-- live progress + review queue -->
    <div class="ag-prog" id="agProg" style="margin-top:16px;">
      <div class="ag-row" style="justify-content:space-between;">
        <strong id="agProgTitle">Working…</strong>
        <span class="ag-pill running" id="agProgPill">running</span>
      </div>
      <div class="ag-track"><div class="ag-fill" id="agFill"></div></div>
      <div class="ag-stage" id="agStage">starting…</div>
    </div>
  </div>

  <!-- ── REVIEW QUEUE (replaces the old Suggestions tab) ─────────────────────── -->
  <div class="card">
    <div class="ag-h">📥 Review queue <span class="ag-pill <%= (suggestions && suggestions.length) ? 'queued' : 'done' %>" id="agQueueCount"><%= (suggestions && suggestions.length) || 0 %></span>
      <button class="ag-b" style="margin-left:auto;" onclick="agAutoSlotAll(this)" title="Spread every pending draft across the calendar at sensible times">⚡ Auto-schedule batch</button>
    </div>
    <p class="ag-sub">Pending AI drafts. Edit the copy right here, then <strong>Keep &amp; Post</strong>, <strong>Schedule</strong>, or <strong>Discard</strong> — nothing goes live until you keep it. <strong>⚡ Auto-slot</strong> lets the agent pick the next open calendar time. Your edits also teach the Voice Profile.</p>
    <div class="ag-rev-grid" id="agReviewQueue">
      <% (typeof suggestions !== 'undefined' ? suggestions : []).forEach(function(p){ %>
        <div class="ag-rev" data-id="<%= p._id %>">
          <% if (p.mediaUrls && p.mediaUrls[0]) { %><img src="<%= p.mediaUrls[0] %>" alt=""><% } %>
          <div class="b">
            <div class="ag-metarow">
              <span class="ag-note" style="flex:1;"><%= (p.platforms || []).join(', ') %><%= p.kind ? ' · ' + p.kind : '' %><%= p.dims ? ' · ' + p.dims : '' %></span>
              <button class="ag-thumb" title="Good design — remember this layout" onclick="agDesignVote(this,'up')">👍</button>
              <button class="ag-thumb" title="Bad design — avoid this layout" onclick="agDesignVote(this,'down')">👎</button>
            </div>
            <textarea><%= p.body || '' %></textarea>
            <div class="acts">
              <a class="ag-b primary" href="/admin/assets/social?suggestion=<%= p._id %>" onclick="return agRevEdit(this, event)" title="Open in the Asset Generator — edits return here">🎨 Edit</a>
              <button class="ag-b" onclick="agRevSave(this)">Save text</button>
              <button class="ag-b gold" onclick="agRevApprove(this)">Keep &amp; Post</button>
              <button class="ag-b danger" onclick="agRevDismiss(this)">Discard</button>
            </div>
            <div class="acts ag-sched-row">
              <input type="datetime-local" class="ag-sched" title="Schedule this post">
              <button class="ag-b" onclick="agRevSchedule(this)">📅 Schedule</button>
              <button class="ag-b" onclick="agRevAutoSlot(this)" title="Let the agent pick the next open calendar slot">⚡ Auto-slot</button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <span class="ag-note" id="agQueueEmpty" style="<%= (suggestions && suggestions.length) ? 'display:none' : '' %>">No pending drafts yet — launch a batch above.</span>
  </div>

  <!-- ── DESIGN MEMORY (layout taste from 👍/👎) ──────────────────────────────── -->
  <% const dprefs = (typeof designPrefs !== 'undefined' && designPrefs) ? designPrefs : null;
     const dfeed = (typeof designFeedback !== 'undefined' && designFeedback) ? designFeedback : []; %>
  <div class="card">
    <div class="ag-h">🎨 Design Memory <span class="ag-pill <%= (dprefs && (dprefs.sampleUp || dprefs.sampleDown)) ? 'done' : 'queued' %>" id="agMemPill"><%= dprefs ? (dprefs.sampleUp||0) + '👍 ' + (dprefs.sampleDown||0) + '👎' : '0' %></span></div>
    <p class="ag-sub">Thumb the drafts above 👍/👎 and the agent learns your layout taste — preferred typeface (serif vs sans), headline size, and alignment — then applies it to new posts for a consistent look. Remove a bad call to un-teach it.</p>
    <div class="ag-mem" id="agMemSummary"><%= (typeof designSummary !== 'undefined' ? designSummary : '') %></div>
    <div class="ag-mem-list" id="agMemList">
      <% dfeed.forEach(function(f){ const s = f.signature || {}; %>
        <div class="ag-mem-row" data-id="<%= f._id %>">
          <% if (f.thumb) { %><img src="<%= f.thumb %>" alt=""><% } %>
          <span class="ag-mem-v <%= f.verdict %>"><%= f.verdict === 'up' ? '👍' : '👎' %></span>
          <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= (f.headline || '(untitled)') %> <span class="ag-note">· <%= s.aspect || '' %> · <%= s.fontKind || '' %> · <%= s.align || '' %></span></span>
          <button class="ag-b danger" onclick="agMemDelete(this)" title="Forget this">✕</button>
        </div>
      <% }); %>
    </div>
    <span class="ag-note" id="agMemEmpty" style="<%= dfeed.length ? 'display:none' : '' %>">No design feedback yet — thumb a few drafts to start.</span>
  </div>

  <!-- ── 3. AUTOPILOT (opt-in) ──────────────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🛩️ Autopilot</div>
    <p class="ag-sub">Let the agent run on a cadence. Default is <strong>review-first</strong> (drafts land in Suggestions). Flip “Auto-publish” only when you trust it to post live on its own.</p>

    <div class="ag-row" style="margin-bottom:10px;">
      <label class="ag-chk"><input type="checkbox" id="apEnabled" <%= as.enabled ? 'checked' : '' %>> Enabled</label>
      <div class="ag-field" style="max-width:160px;margin:0;">
        <label>Cadence</label>
        <select id="apCadence">
          <option value="off" <%= cadence==='off'?'selected':'' %>>Off</option>
          <option value="daily" <%= cadence==='daily'?'selected':'' %>>Daily</option>
          <option value="3x_week" <%= cadence==='3x_week'?'selected':'' %>>3× / week</option>
          <option value="weekly" <%= cadence==='weekly'?'selected':'' %>>Weekly</option>
        </select>
      </div>
      <div class="ag-field" style="max-width:120px;margin:0;">
        <label>Posts / run</label>
        <input type="text" id="apCount" value="<%= as.count || 3 %>" style="text-align:center;">
      </div>
    </div>

    <div class="ag-field">
      <label>Standing direction (what autopilot should keep posting about)</label>
      <textarea id="apPrompt" placeholder="e.g. mix value tips, a service highlight, and a local angle; keep it warm and concrete"><%= as.standingPrompt || '' %></textarea>
    </div>

    <div class="ag-field">
      <label>Channels <span class="ag-note">(blank = all connected)</span></label>
      <div class="ag-row" id="apChannels">
        <% liveDefs.forEach(function(p){ %>
          <label class="ag-chk"><input type="checkbox" class="ap-ch" value="<%= p.key %>" <%= channels.includes(p.key)?'checked':'' %>> <%= p.icon || '' %> <%= p.name %></label>
        <% }); %>
      </div>
    </div>

    <div class="ag-row" style="margin-bottom:10px;">
      <%# DISABLED FOR RELEASE: Listening trends — input kept hidden so JS refs stay valid %>
      <label class="ag-chk" style="display:none;"><input type="checkbox" id="apTrends" <%= as.useTrends !== false ? 'checked' : '' %>> Use trends</label>
      <label class="ag-chk"><input type="checkbox" id="apCritic" <%= as.critic !== false ? 'checked' : '' %>> Critic pass</label>
      <label class="ag-chk" style="border-color:var(--gold,#C9A848);"><input type="checkbox" id="apPublish" <%= as.autoPublish ? 'checked' : '' %>> ⚠️ Auto-publish live</label>
    </div>

    <div class="ag-row">
      <button class="ag-b gold" onclick="agSaveAuto()">💾 Save autopilot</button>
      <span class="ag-note" id="apMsg"></span>
    </div>
  </div>

  <!-- ── 4. JOB HISTORY ─────────────────────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🗂️ Recent batches</div>
    <div class="ag-jobs" id="agHistory">
      <% if (!jobs || !jobs.length) { %>
        <span class="ag-note">No batches yet.</span>
      <% } else { jobs.forEach(function(j){ %>
        <div class="ag-job">
          <span><%= (j.direction || '(no direction)').slice(0,70) %></span>
          <span><span class="ag-pill <%= j.status %>"><%= j.status %></span> &nbsp;<%= (j.summary && j.summary.created) || (j.postIds ? j.postIds.length : 0) %> drafts</span>
        </div>
      <% }); } %>
    </div>
  </div>

</div>

<script>
const AG_QKEYS = <%- JSON.stringify(voiceQuestions.map(q => q.key)) %>;
let AG_SEED_FEWSHOT = <%- JSON.stringify((voice && voice.fewShot && voice.fewShot.length) ? 'has' : null) %>;
let AG_POLL = null;

// Single source of truth for AJAX → JSON. An expired admin session makes the
// auth middleware answer 401 (not a 302 to an HTML login page), so this turns a
// cryptic "Unexpected token '<'" into a clear "session expired" message and keeps
// saves honest (a silently-failed save no longer looks like it worked).
async function agJson(url, opts) {
  const r = await fetch(url, opts);
  if (r.status === 401) { const e = new Error('Your session expired — refresh the page and sign in again, then retry.'); e.authRequired = true; throw e; }
  let j;
  try { j = await r.json(); }
  catch { throw new Error(r.ok ? 'Unexpected response from server.' : ('Request failed (' + r.status + ').')); }
  return j;
}

function agAnswers() {
  const a = {};
  AG_QKEYS.forEach(k => { const el = document.getElementById('vq_' + k); if (el) a[k] = el.value; });
  return a;
}

async function agSynth() {
  const btn = document.getElementById('vSynth'); const msg = document.getElementById('vSynthMsg');
  btn.disabled = true; msg.textContent = 'Thinking…';
  try {
    const r = await fetch('/admin/social/voice/synthesize', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ answers: agAnswers() }) });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Failed');
    document.getElementById('vBlock').value = j.voiceBlock || '';
    if (j.profile) {
      const set = (k, val) => { const el = document.getElementById('vq_' + k); if (el && val) el.value = Array.isArray(val) ? val.join(', ') : val; };
      ['persona','audience','tone','signaturePhrases','avoid','emojiPolicy','hashtagPolicy','lengthPref'].forEach(k => set(k, j.profile[k]));
    }
    if (!AG_SEED_FEWSHOT && Array.isArray(j.seedFewShot)) AG_SEED_FEWSHOT = j.seedFewShot;
    msg.textContent = 'Drafted — review & save.';
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
  btn.disabled = false;
}

async function agSaveVoice() {
  const msg = document.getElementById('vSaveMsg'); msg.textContent = 'Saving…';
  const a = agAnswers();
  const payload = {
    persona: a.persona, audience: a.audience, tone: a.tone, signaturePhrases: a.signaturePhrases,
    avoid: a.avoid, emojiPolicy: a.emojiPolicy, hashtagPolicy: a.hashtagPolicy, lengthPref: a.lengthPref,
    interview: a, voiceBlock: document.getElementById('vBlock').value,
  };
  if (Array.isArray(AG_SEED_FEWSHOT)) payload.seedFewShot = AG_SEED_FEWSHOT;
  try {
    const j = await agJson('/admin/social/voice', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    msg.textContent = j.ok ? '✓ Saved' : ('⚠ ' + (j.error || 'Failed'));
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
}

async function agLaunch() {
  const btn = document.getElementById('agLaunch'); const msg = document.getElementById('agLaunchMsg');
  const platforms = Array.from(document.querySelectorAll('.ag-pf:checked')).map(c => c.value);
  const body = {
    direction: document.getElementById('agDir').value,
    count: parseInt(document.getElementById('agCount').value, 10) || 3,
    platforms,
    style: document.getElementById('agStyle') ? document.getElementById('agStyle').value : 'solid',
    useTrends: document.getElementById('agTrends').checked,
    critic: document.getElementById('agCritic').checked,
  };
  btn.disabled = true; msg.textContent = 'Launching…';
  try {
    const r = await fetch('/admin/social/agent-studio/run', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Failed');
    msg.textContent = 'Generating in the background…';
    agStartPolling(j.jobId);
  } catch (e) { msg.textContent = '⚠ ' + e.message; btn.disabled = false; }
}

function agStartPolling(jobId) {
  const prog = document.getElementById('agProg'); prog.classList.add('show');
  if (AG_POLL) clearInterval(AG_POLL);
  const tick = async () => {
    try {
      const r = await fetch('/admin/social/agent-studio/jobs/' + jobId);
      const j = await r.json();
      if (!j.ok) return;
      agRenderProgress(j.job);
      if (j.job.status === 'done') { clearInterval(AG_POLL); AG_POLL = null; agRenderReview(j.posts || []); document.getElementById('agLaunch').disabled = false; }
      if (j.job.status === 'failed') { clearInterval(AG_POLL); AG_POLL = null; document.getElementById('agLaunch').disabled = false; }
    } catch (e) { /* keep polling */ }
  };
  tick(); AG_POLL = setInterval(tick, 2500);
}

function agRenderProgress(job) {
  const p = job.progress || { done:0, total:0, stage:'' };
  const pct = p.total ? Math.round((p.done / p.total) * 100) : (job.status === 'done' ? 100 : 8);
  document.getElementById('agFill').style.width = Math.max(pct, 5) + '%';
  document.getElementById('agStage').textContent = (p.stage || job.status) + (p.total ? '  (' + p.done + '/' + p.total + ')' : '');
  const pill = document.getElementById('agProgPill'); pill.className = 'ag-pill ' + job.status; pill.textContent = job.status;
  document.getElementById('agProgTitle').textContent = job.status === 'done' ? '✓ Drafts ready — review below' : job.status === 'failed' ? ('✗ ' + (job.error || 'Failed')) : 'Working…';
}

function agEsc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function agCardHtml(p) {
  const img = (p.mediaUrls && p.mediaUrls[0]) || '';
  const meta = (p.platforms || []).join(', ') + (p.kind ? ' · ' + p.kind : '') + (p.dims ? ' · ' + p.dims : '');
  return '<div class="ag-rev" data-id="' + p._id + '">' +
    (img ? '<img src="' + agEsc(img) + '" alt="">' : '') +
    '<div class="b">' +
      '<div class="ag-metarow"><span class="ag-note" style="flex:1;">' + agEsc(meta) + '</span>' +
        '<button class="ag-thumb" title="Good design — remember this layout" onclick="agDesignVote(this,\'up\')">👍</button>' +
        '<button class="ag-thumb" title="Bad design — avoid this layout" onclick="agDesignVote(this,\'down\')">👎</button></div>' +
      '<textarea>' + agEsc(p.body || '') + '</textarea>' +
      '<div class="acts">' +
        '<a class="ag-b primary" href="/admin/assets/social?suggestion=' + p._id + '" onclick="return agRevEdit(this, event)" title="Open in the Asset Generator — edits return here">🎨 Edit</a>' +
        '<button class="ag-b" onclick="agRevSave(this)">Save text</button>' +
        '<button class="ag-b gold" onclick="agRevApprove(this)">Keep &amp; Post</button>' +
        '<button class="ag-b danger" onclick="agRevDismiss(this)">Discard</button>' +
      '</div>' +
      '<div class="acts ag-sched-row"><input type="datetime-local" class="ag-sched" title="Schedule this post"><button class="ag-b" onclick="agRevSchedule(this)">📅 Schedule</button><button class="ag-b" onclick="agRevAutoSlot(this)" title="Let the agent pick the next open calendar slot">⚡ Auto-slot</button></div>' +
    '</div></div>';
}
// Newly generated drafts join the persistent review queue (newest first).
function agRenderReview(posts) {
  if (!posts.length) return;
  const grid = document.getElementById('agReviewQueue');
  const empty = document.getElementById('agQueueEmpty'); if (empty) empty.style.display = 'none';
  grid.insertAdjacentHTML('afterbegin', posts.map(agCardHtml).join(''));
  agUpdateCount();
}
function agUpdateCount() {
  const n = document.querySelectorAll('#agReviewQueue .ag-rev').length;
  const c = document.getElementById('agQueueCount'); if (c) c.textContent = n;
  const empty = document.getElementById('agQueueEmpty'); if (empty) empty.style.display = n ? 'none' : '';
}

function agRevCard(btn) { return btn.closest('.ag-rev'); }
// Save the edited copy first, then open the full Asset Generator. Without this,
// text typed in the card was lost the moment you clicked 🎨 Edit (it navigated
// away unsaved), then the editor reloaded the OLD copy from the DB — the
// "inconsistent saves" you saw around the edit round-trip.
async function agRevEdit(a, ev) {
  ev.preventDefault();
  const card = a.closest('.ag-rev'); const id = card.dataset.id;
  const body = card.querySelector('textarea').value;
  const href = a.getAttribute('href');
  const label = a.textContent; a.textContent = 'Saving…';
  try {
    await agJson('/admin/social/suggestions/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
  } catch (e) {
    a.textContent = label;
    if (e.authRequired) { alert(e.message); return false; }   // don't bounce into a login redirect
    // Non-auth hiccup: warn but still let them edit the image.
  }
  location.href = href;
  return false;
}
async function agRevSave(btn) {
  const card = agRevCard(btn); const id = card.dataset.id; const body = card.querySelector('textarea').value;
  btn.textContent = 'Saving…';
  try {
    const j = await agJson('/admin/social/suggestions/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
    btn.textContent = j.ok ? '✓ Saved' : '⚠';
    if (!j.ok && j.error) alert(j.error);
  } catch (e) { btn.textContent = '⚠'; alert(e.message); }
  setTimeout(() => { btn.textContent = 'Save text'; }, 2500);
}
async function agRevApprove(btn) {
  const card = agRevCard(btn); const id = card.dataset.id; const body = card.querySelector('textarea').value;
  btn.disabled = true; btn.textContent = 'Posting…';
  try {
    await agJson('/admin/social/suggestions/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
    const j = await agJson('/admin/social/suggestions/' + id + '/approve', { method:'POST' });
    if (j.ok) {
      // Published → no longer a pending draft, so retire the card from the queue
      // (with a brief "Posted" beat + link) instead of leaving it dimmed and dead.
      btn.textContent = '✓ Posted';
      if (j.url) { const a = card.querySelector('.ag-note'); if (a) a.innerHTML = '✓ Posted · <a href="' + j.url + '" target="_blank" rel="noopener">view</a>'; }
      card.style.transition = 'opacity .5s'; card.style.opacity = '.35';
      setTimeout(() => { card.remove(); agUpdateCount(); }, 900);
    }
    else { btn.disabled = false; btn.textContent = 'Retry'; alert(j.error || 'Publish failed'); }
  } catch (e) { btn.disabled = false; btn.textContent = 'Retry'; alert(e.message); }
}
// Thumb a draft's design 👍/👎 — teaches the Design Memory which layouts to favor.
async function agDesignVote(btn, verdict) {
  const card = agRevCard(btn); const id = card.dataset.id;
  const row = btn.closest('.ag-metarow');
  try {
    const j = await agJson('/admin/social/design/feedback', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId: id, verdict }) });
    if (!j.ok) { alert(j.error || 'Could not save feedback'); return; }
    if (row) row.querySelectorAll('.ag-thumb').forEach(b => b.classList.remove('on-up','on-down'));
    btn.classList.add(verdict === 'up' ? 'on-up' : 'on-down');
    const sum = document.getElementById('agMemSummary'); if (sum && j.summary) sum.textContent = j.summary;
    const pill = document.getElementById('agMemPill');
    const mm = j.summary && j.summary.match(/(\d+)👍\s*\/\s*(\d+)👎/);
    if (pill && mm) pill.textContent = mm[1] + '👍 ' + mm[2] + '👎';
  } catch (e) { alert(e.message); }
}
async function agMemDelete(btn) {
  const row = btn.closest('.ag-mem-row'); const id = row.dataset.id;
  try { const j = await agJson('/admin/social/design/memory/' + id + '/delete', { method:'POST' }); if (j.ok) { row.remove(); const list = document.getElementById('agMemList'); const empty = document.getElementById('agMemEmpty'); if (empty && (!list || !list.querySelector('.ag-mem-row'))) empty.style.display = ''; } else alert(j.error || 'Could not remove'); }
  catch (e) { alert(e.message); }
}
// Agent picks the next open calendar slot for this one draft.
async function agRevAutoSlot(btn) {
  const card = agRevCard(btn); const id = card.dataset.id;
  const body = card.querySelector('textarea').value;
  btn.disabled = true; btn.textContent = 'Finding slot…';
  try {
    const j = await agJson('/admin/social/suggestions/' + id + '/auto-slot', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
    if (j.ok) {
      const d = new Date(j.scheduledAt);
      btn.textContent = '✓ ' + d.toLocaleString('en-US', { month:'short', day:'numeric', hour:'numeric' });
      card.style.transition = 'opacity .5s'; card.style.opacity = '.35';
      setTimeout(() => { card.remove(); agUpdateCount(); }, 1100);
    } else { btn.disabled = false; btn.textContent = '⚡ Auto-slot'; alert(j.error || 'No open slot'); }
  } catch (e) { btn.disabled = false; btn.textContent = '⚡ Auto-slot'; alert(e.message); }
}
// Spread the whole pending batch across the calendar.
async function agAutoSlotAll(btn) {
  if (!confirm('Auto-schedule all pending drafts across the calendar at sensible times?')) return;
  const old = btn.textContent; btn.disabled = true; btn.textContent = 'Scheduling…';
  try {
    const j = await agJson('/admin/social/suggestions/auto-slot-all', { method:'POST', headers:{'Content-Type':'application/json'}, body: '{}' });
    if (j.ok) {
      (j.items || []).forEach(it => { const c = document.querySelector('.ag-rev[data-id="' + it.id + '"]'); if (c) c.remove(); });
      agUpdateCount();
      btn.textContent = '✓ Scheduled ' + j.scheduled;
      setTimeout(() => { btn.disabled = false; btn.textContent = old; }, 2600);
    } else { btn.disabled = false; btn.textContent = old; alert(j.error || 'Failed'); }
  } catch (e) { btn.disabled = false; btn.textContent = old; alert(e.message); }
}
async function agRevSchedule(btn) {
  const card = agRevCard(btn); const id = card.dataset.id;
  const body = card.querySelector('textarea').value;
  const when = card.querySelector('.ag-sched') ? card.querySelector('.ag-sched').value : '';
  if (!when) { alert('Pick a date & time first.'); return; }
  btn.disabled = true; btn.textContent = 'Scheduling…';
  try {
    const j = await agJson('/admin/social/suggestions/' + id + '/schedule', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body, scheduledAt: when }) });
    if (j.ok) {
      btn.textContent = '✓ Scheduled';
      card.style.transition = 'opacity .5s'; card.style.opacity = '.35';
      setTimeout(() => { card.remove(); agUpdateCount(); }, 900);
    } else { btn.disabled = false; btn.textContent = '📅 Schedule'; alert(j.error || 'Could not schedule'); }
  } catch (e) { btn.disabled = false; btn.textContent = '📅 Schedule'; alert(e.message); }
}
async function agRevDismiss(btn) {
  if (!confirm('Discard this draft?')) return;
  const card = agRevCard(btn); const id = card.dataset.id;
  try { const j = await agJson('/admin/social/suggestions/' + id + '/dismiss', { method:'POST' }); if (j.ok) { card.remove(); agUpdateCount(); } else alert(j.error || 'Could not discard'); }
  catch (e) { alert(e.message); }
}

async function agSaveAuto() {
  const msg = document.getElementById('apMsg'); msg.textContent = 'Saving…';
  const channels = Array.from(document.querySelectorAll('.ap-ch:checked')).map(c => c.value);
  const body = {
    enabled: document.getElementById('apEnabled').checked,
    cadence: document.getElementById('apCadence').value,
    count: parseInt(document.getElementById('apCount').value, 10) || 3,
    standingPrompt: document.getElementById('apPrompt').value,
    channels,
    useTrends: document.getElementById('apTrends').checked,
    critic: document.getElementById('apCritic').checked,
    autoPublish: document.getElementById('apPublish').checked,
  };
  try {
    const j = await agJson('/admin/social/auto-toggle', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    msg.textContent = j.ok ? '✓ Saved' : ('⚠ ' + (j.error || 'Failed'));
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
}
</script>
