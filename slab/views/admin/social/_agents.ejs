  try {
    const j = await agJson('/admin/social/suggestions/' + id + '/schedule', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body, scheduledAt: when, platforms }) });
    if (j.ok) {
      btn.textContent = '✓ Scheduled';
      card.style.transition = 'opacity .5s'; card.style.opacity = '.35';
      setTimeout(() => { card.remove(); agUpdateCount(); }, 900);
    } else { btn.disabled = false; btn.textContent = '📅 Schedule'; SlabFlash.error(j.error || 'Could not schedule'); }
  } catch (e) { btn.disabled = false; btn.textContent = '📅 Schedule'; SlabFlash.error(e.message); }
}
async function agRevDismiss(btn) {
  if (!confirm('Discard this draft?')) return;
  const card = agRevCard(btn); const id = card.dataset.id;
  try { const j = await agJson('/admin/social/suggestions/' + id + '/dismiss', { method:'POST' }); if (j.ok) { card.remove(); agUpdateCount(); } else SlabFlash.error(j.error || 'Could not discard'); }
