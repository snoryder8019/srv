function agRenderPrompts(containerId, textareaId, key) {
  const el = document.getElementById(containerId); if (!el) return;
  const pool = AG_PROMPT_POOLS[key] || []; if (!pool.length) return;
  let idx = 0;
  const render = () => {
    el.innerHTML = '';
    for (let i = 0; i < 4; i++) {
      const s = pool[(idx + i) % pool.length];
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'ag-prompt'; b.textContent = s.l; b.title = s.p;
      b.onclick = () => { const t = document.getElementById(textareaId); if (t) { t.value = s.p; t.focus(); } };
      el.appendChild(b);
    }
    const cyc = document.createElement('button');
    cyc.type = 'button'; cyc.className = 'ag-prompt cyc'; cyc.textContent = '♻'; cyc.title = 'More ideas';
    cyc.onclick = () => { idx = (idx + 4) % pool.length; render(); };
    el.appendChild(cyc);
  };
  render();
}
document.addEventListener('DOMContentLoaded', function () {
  agRenderPrompts('agBatchPrompts', 'agDir', 'batch');
  agRenderPrompts('agStoryPrompts', 'agStoryDir', 'story');
  agRenderPrompts('agCarPrompts', 'agCarDir', 'carousel');
});

// Seamless carousel: upload a wide background, then AI-write + render N sliced
// panorama tiles into a carousel draft for the review queue.
let AG_CAR_BG = '';
function agCarDimsUpdate() {
  const n = Math.max(2, Math.min(10, parseInt(document.getElementById('agCarCount').value, 10) || 4));
  const el = document.getElementById('agCarDims'); if (el) el.textContent = (1080 * n) + '×1350';
}
async function agCarUpload(input) {
  const file = input.files && input.files[0]; if (!file) return;
  const msg = document.getElementById('agCarBgMsg');
  msg.textContent = 'Uploading ' + file.name + '…';
  try {
    const fd = new FormData(); fd.append('file', file);
    const r = await fetch('/admin/social/upload', { method:'POST', body: fd });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'Upload failed');
    AG_CAR_BG = d.url;
    // Show the uploaded image so it's obvious it'll be used (and confirms the URL loads).
    const pv = document.getElementById('agCarPreview'); const wrap = document.getElementById('agCarPreviewWrap');
    if (pv && wrap) { pv.onload = () => { wrap.style.display = ''; }; pv.onerror = () => { msg.textContent = '⚠ Uploaded but the image URL did not load — check storage.'; }; pv.src = d.url + '?t=' + Date.now(); }
    // Uncheck "AI bg" — an uploaded background takes precedence.
    const sd = document.getElementById('agCarSd'); if (sd) sd.checked = false;
    msg.textContent = '✓ Background ready — spans all slides.';
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
  finally { input.value = ''; }
}
async function agBuildCarousel() {
  const btn = document.getElementById('agCarBtn'); const msg = document.getElementById('agCarMsg');
  const direction = document.getElementById('agCarDir').value;
  const count = Math.max(2, Math.min(10, parseInt(document.getElementById('agCarCount').value, 10) || 4));
  const useSd = document.getElementById('agCarSd').checked;
  const noText = document.getElementById('agCarNoText').checked;
  btn.disabled = true; msg.textContent = noText ? ('Rendering the ' + count + '-slide panorama (background only)…') : ('Writing copy & rendering the ' + count + '-slide panorama… this can take a minute.');
  try {
    const j = await agJson('/admin/social/agent-studio/carousel', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ direction, count, bgUrl: AG_CAR_BG, useSd, noText }) });
    if (!j.ok) throw new Error(j.error || 'Failed');
    msg.textContent = '✓ Carousel ready — review & tweak the copy below.';
    agRenderReview([j.post]);
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
  btn.disabled = false;
}

// Carousel editor for a card: replace/AI the wide BACKGROUND + edit per-slide copy,
// then re-render the (still-unsliced) preview. Slicing happens when you post.
function agSlidesEditor(p) {
  if (p.format !== 'carousel' || !Array.isArray(p.slides) || !p.slides.length) return '';
  const rows = p.slides.map((s, i) =>
    '<div class="ag-slide"><div class="ag-slide-n">' + (i + 1) + '</div><div class="ag-slide-f">' +
      '<input class="ag-slide-h" placeholder="Headline" value="' + agEsc(s.headline || '') + '">' +
      '<input class="ag-slide-s" placeholder="Subtitle (optional)" value="' + agEsc(s.subtitle || '') + '"></div></div>'
  ).join('');
  return '<details class="ag-slides"><summary>✏️ Edit carousel (' + p.slides.length + ' slides)</summary>' +
    '<div class="ag-acct-lbl">Background</div>' +
    '<div class="ag-row" style="gap:6px;">' +
      '<button type="button" class="ag-b" onclick="agCarBgPick(this)">⬆ Replace</button>' +
      '<label class="ag-chk"><input type="checkbox" class="ag-car-sd"> 🎨 AI background</label>' +
      '<input type="file" class="ag-car-file" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="agCarBgUpload(this)">' +
      '<input type="hidden" class="ag-car-bg" value="">' +
      '<span class="ag-note ag-car-bgmsg"></span>' +
    '</div>' +
    '<div class="ag-acct-lbl">Slide copy</div>' +
    '<div class="ag-slides-list">' + rows + '</div>' +
    '<button class="ag-b gold" onclick="agCarSave(this)">↻ Update preview</button>' +
    '<span class="ag-note ag-car-msg"></span></details>';
}
function agCarBgPick(btn) { btn.parentElement.querySelector('.ag-car-file').click(); }
async function agCarBgUpload(input) {
  const card = input.closest('.ag-rev'); const file = input.files && input.files[0]; if (!file) return;
  const msg = card.querySelector('.ag-car-bgmsg'); msg.textContent = 'Uploading…';
  try {
    const fd = new FormData(); fd.append('file', file);
    const r = await fetch('/admin/social/upload', { method:'POST', body: fd }); const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'Upload failed');
    card.querySelector('.ag-car-bg').value = d.url; msg.textContent = '✓ New background — hit Update.';
  } catch (e) { msg.textContent = '⚠ ' + e.message; } finally { input.value = ''; }
}
async function agCarSave(btn) {
  const card = btn.closest('.ag-rev'); const id = card.dataset.id;
  const slides = Array.from(card.querySelectorAll('.ag-slide')).map(r => ({
    headline: r.querySelector('.ag-slide-h').value, subtitle: r.querySelector('.ag-slide-s').value,
  }));
  const bgEl = card.querySelector('.ag-car-bg'); const sdEl = card.querySelector('.ag-car-sd');
  const msg = card.querySelector('.ag-car-msg');
  btn.disabled = true; msg.textContent = ' Re-rendering…';
  try {
    const j = await agJson('/admin/social/agent-studio/carousel/' + id + '/update', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ slides, bgUrl: bgEl ? bgEl.value : '', useSd: sdEl ? sdEl.checked : false }) });
    if (!j.ok) throw new Error(j.error || 'Failed');
    const img = card.querySelector('img');
    if (img && j.previewUrl) img.src = j.previewUrl + '?t=' + Date.now();
    msg.textContent = ' ✓ Updated';
  } catch (e) { msg.textContent = ' ⚠ ' + e.message; }
  btn.disabled = false;
}

function agStartPolling(jobId) {
  const prog = document.getElementById('agProg'); prog.classList.add('show');
  if (AG_POLL) clearInterval(AG_POLL);
  const tick = async () => {
    try {
      const r = await fetch('/admin/social/agent-studio/jobs/' + jobId);
      const j = await r.json();
      if (!j.ok) return;
      agRenderProgress(j.job);
      if (j.job.status === 'done') { clearInterval(AG_POLL); AG_POLL = null; agRenderReview(j.posts || []); document.getElementById('agLaunch').disabled = false; }
      if (j.job.status === 'failed') { clearInterval(AG_POLL); AG_POLL = null; document.getElementById('agLaunch').disabled = false; }
    } catch (e) { /* keep polling */ }
  };
  tick(); AG_POLL = setInterval(tick, 2500);
}

function agRenderProgress(job) {
  const p = job.progress || { done:0, total:0, stage:'' };
  const pct = p.total ? Math.round((p.done / p.total) * 100) : (job.status === 'done' ? 100 : 8);
  document.getElementById('agFill').style.width = Math.max(pct, 5) + '%';
  document.getElementById('agStage').textContent = (p.stage || job.status) + (p.total ? '  (' + p.done + '/' + p.total + ')' : '');
  const pill = document.getElementById('agProgPill'); pill.className = 'ag-pill ' + job.status; pill.textContent = job.status;
  document.getElementById('agProgTitle').textContent = job.status === 'done' ? '✓ Drafts ready — review below' : job.status === 'failed' ? ('✗ ' + (job.error || 'Failed')) : 'Working…';
}

function agEsc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function agCardHtml(p) {
  const img = (p.mediaUrls && p.mediaUrls[0]) || '';
  const isStory = ['story','carousel'].includes(p.format) || ['story','carousel'].includes(p.kind);
  const meta = (p.platforms || []).join(', ') + (p.kind ? ' · ' + p.kind : '') + (p.dims ? ' · ' + p.dims : '');
  // Stories are multi-frame; the single-design Asset Generator can't edit them, so
  // its Edit button is omitted for story cards.
  // Carousel → open the WHOLE wide canvas in the editor (bg, text, images, video).
  // Stories can't be layer-edited. Everything else uses the normal single-design Edit.
  const editBtn = (p.format === 'carousel')
    ? '<a class="ag-b primary" href="/admin/assets/social?suggestion=' + p._id + '" title="Open the full wide canvas in the editor — background, text, images, video">🎨 Edit in canvas</a>'
    : (isStory ? '' : '<a class="ag-b primary" href="/admin/assets/social?suggestion=' + p._id + '" onclick="return agRevEdit(this, event)" title="Open in the Asset Generator — edits return here">🎨 Edit</a>');
  // Seamless carousel shows the WIDE panorama preview — contain it so the whole strip is visible.
  const imgAttr = (p.format === 'carousel') ? ' style="aspect-ratio:auto;max-height:190px;object-fit:contain;background:var(--ivory)"' : '';
  return '<div class="ag-rev" data-id="' + p._id + '">' +
    (img ? '<img' + imgAttr + ' src="' + agEsc(img) + '" alt="">' : '') +
    '<div class="b">' +
      '<div class="ag-metarow"><span class="ag-note" style="flex:1;">' + agEsc(meta) + '</span>' +
        '<button class="ag-thumb" title="Good design — remember this layout" onclick="agDesignVote(this,\'up\')">👍</button>' +
        '<button class="ag-thumb" title="Bad design — avoid this layout" onclick="agDesignVote(this,\'down\')">👎</button></div>' +
      '<textarea>' + agEsc(p.body || '') + '</textarea>' +
      agSlidesEditor(p) +
      agAcctChips(p.format || (isStory ? 'story' : 'single'), p.platforms || []) +
      '<div class="acts">' +
        editBtn +
        '<button class="ag-b" onclick="agRevSave(this)">Save text</button>' +
        '<button class="ag-b gold" onclick="agRevApprove(this)">Keep &amp; Post</button>' +
        '<button class="ag-b danger" onclick="agRevDismiss(this)">Discard</button>' +
      '</div>' +
      '<div class="acts ag-sched-row"><input type="datetime-local" class="ag-sched" title="Schedule this post"><button class="ag-b" onclick="agRevSchedule(this)">📅 Schedule</button><button class="ag-b" onclick="agRevAutoSlot(this)" title="Let the agent pick the next open calendar slot">⚡ Auto-slot</button></div>' +
    '</div></div>';
}
// Newly generated drafts join the persistent review queue (newest first).
function agRenderReview(posts) {
  if (!posts.length) return;
  const grid = document.getElementById('agReviewQueue');
  const empty = document.getElementById('agQueueEmpty'); if (empty) empty.style.display = 'none';
  grid.insertAdjacentHTML('afterbegin', posts.map(agCardHtml).join(''));
  agUpdateCount();
}
function agUpdateCount() {
  const n = document.querySelectorAll('#agReviewQueue .ag-rev').length;
  const c = document.getElementById('agQueueCount'); if (c) c.textContent = n;
  const empty = document.getElementById('agQueueEmpty'); if (empty) empty.style.display = n ? 'none' : '';
}

function agRevCard(btn) { return btn.closest('.ag-rev'); }
// Save the edited copy first, then open the full Asset Generator. Without this,
// text typed in the card was lost the moment you clicked 🎨 Edit (it navigated
// away unsaved), then the editor reloaded the OLD copy from the DB — the
// "inconsistent saves" you saw around the edit round-trip.
async function agRevEdit(a, ev) {
  ev.preventDefault();
  const card = a.closest('.ag-rev'); const id = card.dataset.id;
  const body = card.querySelector('textarea').value;
  const href = a.getAttribute('href');
  const label = a.textContent; a.textContent = 'Saving…';
  try {
    await agJson('/admin/social/suggestions/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
  } catch (e) {
    a.textContent = label;
    if (e.authRequired) { SlabFlash.error(e.message); return false; }   // don't bounce into a login redirect
    // Non-auth hiccup: warn but still let them edit the image.
  }
  location.href = href;
  return false;
}
async function agRevSave(btn) {
  const card = agRevCard(btn); const id = card.dataset.id; const body = card.querySelector('textarea').value;
  btn.textContent = 'Saving…';
  try {
    const j = await agJson('/admin/social/suggestions/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
    btn.textContent = j.ok ? '✓ Saved' : '⚠';
    if (!j.ok && j.error) SlabFlash.error(j.error);
  } catch (e) { btn.textContent = '⚠'; SlabFlash.error(e.message); }
  setTimeout(() => { btn.textContent = 'Save text'; }, 2500);
}
async function agRevApprove(btn) {
  const card = agRevCard(btn); const id = card.dataset.id; const body = card.querySelector('textarea').value;
  const platforms = agCardPlatforms(card);
  if (AG_CONNECTED.length && !platforms.length) { SlabFlash.warn('Pick at least one account to post to.'); return; }
  btn.disabled = true; btn.textContent = 'Posting…';
  try {
    await agJson('/admin/social/suggestions/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ body }) });
    const j = await agJson('/admin/social/suggestions/' + id + '/approve', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ platforms }) });
    if (j.ok) {
      // Published → no longer a pending draft, so retire the card from the queue
      // (with a brief "Posted" beat + link) instead of leaving it dimmed and dead.
      btn.textContent = '✓ Posted' + (j.total > 1 ? ' ' + j.published + '/' + j.total : '');
      SlabFlash.success('Posted — it went live.');
      if (j.url) { const a = card.querySelector('.ag-note'); if (a) a.innerHTML = '✓ Posted' + (j.total > 1 ? ' to ' + j.published + '/' + j.total + ' accounts' : '') + ' · <a href="' + j.url + '" target="_blank" rel="noopener">view</a>'; }
      card.style.transition = 'opacity .5s'; card.style.opacity = '.35';
      setTimeout(() => { card.remove(); agUpdateCount(); }, 900);
    }
    else { btn.disabled = false; btn.textContent = 'Retry'; SlabFlash.error(j.error || 'Publish failed'); }
  } catch (e) { btn.disabled = false; btn.textContent = 'Retry'; SlabFlash.error(e.message); }
}
// Thumb a draft's design 👍/👎 — teaches the Design Memory which layouts to favor.
async function agDesignVote(btn, verdict) {
  const card = agRevCard(btn); const id = card.dataset.id;
  const row = btn.closest('.ag-metarow');
  try {
    const j = await agJson('/admin/social/design/feedback', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId: id, verdict }) });
    if (!j.ok) { SlabFlash.error(j.error || 'Could not save feedback'); return; }
    if (row) row.querySelectorAll('.ag-thumb').forEach(b => b.classList.remove('on-up','on-down'));
    btn.classList.add(verdict === 'up' ? 'on-up' : 'on-down');
    const sum = document.getElementById('agMemSummary'); if (sum && j.summary) sum.textContent = j.summary;
    const pill = document.getElementById('agMemPill');
    const mm = j.summary && j.summary.match(/(\d+)👍\s*\/\s*(\d+)👎/);
    if (pill && mm) pill.textContent = mm[1] + '👍 ' + mm[2] + '👎';
  } catch (e) { SlabFlash.error(e.message); }
}
async function agMemDelete(btn) {
  const row = btn.closest('.ag-mem-row'); const id = row.dataset.id;
  try { const j = await agJson('/admin/social/design/memory/' + id + '/delete', { method:'POST' }); if (j.ok) { row.remove(); const list = document.getElementById('agMemList'); const empty = document.getElementById('agMemEmpty'); if (empty && (!list || !list.querySelector('.ag-mem-row'))) empty.style.display = ''; } else SlabFlash.error(j.error || 'Could not remove'); }
  catch (e) { SlabFlash.error(e.message); }
}
// Score live posts now → refresh the reliability meter + winning signals.
async function agScoreNow(btn) {
  const old = btn.textContent; btn.disabled = true; btn.textContent = 'Scoring…';
  try {
    const j = await agJson('/admin/social/score/run', { method:'POST' });
    if (!j.ok) throw new Error(j.error || 'Failed');
    const r = j.reliability || {}; const pct = r.reliability || 0;
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('relPct', pct + '%'); set('relScored', r.scored || 0);
    const bar = document.getElementById('relBar'); if (bar) { bar.style.width = pct + '%'; bar.style.background = pct >= 80 ? '#15803D' : 'var(--gold,#C9A848)'; }
    set('relMsg', pct >= 80 ? 'Enough data to trust design decisions.' : 'Gathering data — decisions firm up as more posts go live.');
    const sig = document.getElementById('relSignals');
    if (sig) sig.innerHTML = (r.signals || []).slice(0, 6).map(s => '<span class="ag-pill ' + (s.lift >= 0 ? 'done' : 'failed') + '" style="text-transform:none;letter-spacing:0;font-weight:500;" title="avg ' + s.avg + ' · ' + s.n + ' posts">' + agEsc(s.key) + ' ' + (s.lift >= 0 ? '+' : '') + s.lift + '%</span>').join('');
    btn.textContent = j.scored ? ('✓ Scored ' + j.scored) : '✓ Up to date';
  } catch (e) { btn.textContent = '⚠ ' + e.message; }
  setTimeout(() => { btn.disabled = false; btn.textContent = old; }, 2800);
}
// Agent picks the next open calendar slot for this one draft.
async function agRevAutoSlot(btn) {
  const card = agRevCard(btn); const id = card.dataset.id;
  const body = card.querySelector('textarea').value;
  const platforms = agCardPlatforms(card);
  if (AG_CONNECTED.length && !platforms.length) { SlabFlash.warn('Pick at least one account first.'); return; }
