<%
  // Agent Studio tab — Voice Profile (Brand DNA), async batch launcher with live
  // progress + review queue, and opt-in autopilot. Self-contained style + script.
  const v = (typeof voice !== 'undefined' && voice) ? voice : {};
  const vi = v.interview || {};
  const as = (typeof autoSocial !== 'undefined' && autoSocial) ? autoSocial : { enabled:false, count:3 };
  const cadence = as.cadence || 'off';
  const channels = Array.isArray(as.channels) ? as.channels : [];
  const conn = (typeof connectedKeys !== 'undefined' && connectedKeys) ? connectedKeys : [];
  const liveDefs = (typeof platforms !== 'undefined' ? platforms : []).filter(p => conn.includes(p.key));
  const qval = (q) => (vi[q.key] !== undefined ? vi[q.key] : (Array.isArray(v[q.key]) ? v[q.key].join(', ') : (v[q.key] || '')));
%>
<style>
  .ag-wrap { display:grid; grid-template-columns:1fr; gap:18px; }
  .ag-h { display:flex; align-items:center; gap:8px; margin:0 0 4px; font-family:var(--font-heading); color:var(--on-surface); font-size:1.05rem; }
  .ag-sub { font-size:0.78rem; color:var(--slate); margin:0 0 14px; }
  .ag-grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:12px; }
  .ag-field { display:flex; flex-direction:column; gap:4px; margin-bottom:10px; }
  .ag-field label { font-size:0.66rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--slate); }
  .ag-field input[type=text], .ag-field textarea, .ag-field select { width:100%; border:1px solid var(--border); border-radius:6px; padding:8px 10px; font-size:0.82rem; font-family:inherit; background:var(--surface); color:var(--on-surface); }
  .ag-field textarea { resize:vertical; min-height:54px; }
  .ag-row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .ag-chk { display:inline-flex; align-items:center; gap:7px; font-size:0.78rem; color:var(--on-surface); border:1px solid var(--border); border-radius:6px; padding:7px 11px; cursor:pointer; background:var(--surface); }
  .ag-chk input { accent-color:var(--navy); }
  .ag-block { width:100%; border:1px solid var(--border); border-radius:6px; padding:10px; font-size:0.78rem; font-family:ui-monospace,Menlo,monospace; background:var(--ivory); color:var(--on-surface); min-height:150px; resize:vertical; white-space:pre; }
  .ag-prog { border:1px solid var(--border); border-radius:8px; padding:14px; background:var(--ivory); display:none; }
  .ag-prog.show { display:block; }
  .ag-track { height:10px; background:rgba(28,43,74,.12); border-radius:6px; overflow:hidden; margin:8px 0; }
  .ag-fill { height:100%; width:0%; background:var(--navy); transition:width .4s; }
  .ag-stage { font-size:0.76rem; color:var(--slate); }
  .ag-jobs { display:flex; flex-direction:column; gap:6px; }
  .ag-job { display:flex; justify-content:space-between; gap:10px; font-size:0.74rem; padding:7px 10px; border:1px solid var(--border); border-radius:6px; background:var(--surface); }
  .ag-pill { font-size:0.6rem; font-weight:700; text-transform:uppercase; padding:2px 7px; border-radius:3px; }
  .ag-pill.done { background:rgba(21,128,61,.14); color:#15803D; } .ag-pill.failed { background:rgba(185,28,28,.12); color:#b91c1c; }
  .ag-pill.running, .ag-pill.queued { background:rgba(201,168,72,.18); color:#8a6d1e; }
  .ag-corrections { font-size:0.74rem; color:var(--slate); }
  .ag-corrections .pair { border-left:2px solid var(--gold,#C9A848); padding:4px 0 4px 9px; margin:6px 0; }
  .ag-rev-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:14px; margin-top:14px; }
  .ag-rev { border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--surface); display:flex; flex-direction:column; }
  .ag-rev img { width:100%; aspect-ratio:1/1; object-fit:cover; background:var(--ivory); }
  .ag-rev .b { padding:10px; display:flex; flex-direction:column; gap:8px; flex:1; }
  .ag-rev textarea { width:100%; border:1px solid var(--border); border-radius:5px; padding:7px; font-size:0.76rem; min-height:64px; resize:vertical; font-family:inherit; background:var(--ivory); color:var(--on-surface); }
  .ag-rev .acts { display:flex; gap:6px; flex-wrap:wrap; margin-top:auto; }
  .ag-metarow { display:flex; align-items:center; gap:4px; }
  .ag-thumb { border:1px solid var(--border); background:var(--surface); border-radius:6px; padding:2px 7px; font-size:0.8rem; cursor:pointer; line-height:1.2; }
  .ag-thumb:hover { border-color:var(--navy-mid); }
  .ag-thumb.on-up { background:rgba(21,128,61,.16); border-color:#15803D; }
  .ag-thumb.on-down { background:rgba(185,28,28,.14); border-color:#b91c1c; }
  .ag-mem { font-size:0.74rem; color:var(--slate); }
  .ag-mem-list { display:flex; flex-direction:column; gap:5px; margin-top:10px; max-height:280px; overflow:auto; }
  .ag-mem-row { display:flex; align-items:center; gap:8px; font-size:0.72rem; border:1px solid var(--border); border-radius:6px; padding:6px 9px; background:var(--surface); }
  .ag-mem-row img { width:34px; height:34px; object-fit:cover; border-radius:4px; flex-shrink:0; background:var(--ivory); }
  .ag-mem-v { font-weight:700; } .ag-mem-v.up { color:#15803D; } .ag-mem-v.down { color:#b91c1c; }
  .ag-sched-row { margin-top:6px; align-items:center; }
  .ag-sched { flex:1; min-width:140px; font-size:0.72rem; padding:5px 7px; border:1px solid var(--border); border-radius:6px; background:var(--ivory); color:var(--on-surface); font-family:inherit; }
  .ag-b { border:1px solid var(--border); background:var(--surface); color:var(--on-surface); padding:7px 11px; border-radius:6px; font-size:0.74rem; font-weight:500; cursor:pointer; }
  .ag-b:hover { border-color:var(--navy-mid); } .ag-b.primary { background:var(--navy); color:#fff; border-color:var(--navy); }
  .ag-b.gold { background:var(--gold,#C9A848); color:#0F1B30; border-color:var(--gold,#C9A848); font-weight:600; } .ag-b.danger { color:#b91c1c; }
  .ag-note { font-size:0.72rem; color:var(--slate); }
  .ag-acct-row { display:flex; flex-wrap:wrap; gap:5px; margin:2px 0 2px; }
  .ag-acct { display:inline-flex; align-items:center; gap:4px; font-size:0.68rem; border:1px solid var(--border); border-radius:5px; padding:3px 7px; cursor:pointer; background:var(--ivory); color:var(--slate); user-select:none; }
  .ag-acct input { display:none; }
  .ag-acct.on { background:rgba(28,43,74,.10); border-color:var(--navy-mid); color:var(--on-surface); font-weight:600; }
  .ag-acct-lbl { font-size:0.62rem; color:var(--slate); text-transform:uppercase; letter-spacing:.04em; margin-top:4px; }
  .ag-slides { margin:8px 0; font-size:0.74rem; }
  .ag-slides summary { cursor:pointer; color:var(--navy); font-weight:600; padding:2px 0; }
  .ag-slides-list { display:flex; flex-direction:column; gap:7px; margin:8px 0; }
  .ag-slide { display:flex; gap:8px; align-items:flex-start; }
  .ag-slide-n { width:20px; height:20px; flex-shrink:0; border-radius:50%; background:var(--ivory); border:1px solid var(--border); font-size:0.62rem; font-weight:700; display:flex; align-items:center; justify-content:center; margin-top:6px; color:var(--slate); }
  .ag-slide-f { flex:1; display:flex; flex-direction:column; gap:4px; min-width:0; }
  .ag-slide-f input { width:100%; box-sizing:border-box; border:1px solid var(--border); border-radius:5px; padding:6px 8px; font-size:0.76rem; font-family:inherit; background:var(--ivory); color:var(--on-surface); }
  @media (max-width:520px){ .ag-slide-f input { font-size:16px; } }  /* 16px stops iOS zoom-on-focus */
  /* Tighter "Create" card: tabbed builders + collapsible config */
  .ag-create-tabs { display:flex; gap:4px; margin-bottom:12px; border-bottom:1px solid var(--border); }
  .ag-ct { flex:1; background:none; border:none; border-bottom:2px solid transparent; padding:8px 6px; font-size:0.8rem; font-weight:600; color:var(--slate); cursor:pointer; }
  .ag-ct:hover { color:var(--on-surface); }
  .ag-ct.active { color:var(--on-surface); border-bottom-color:var(--gold,#C9A848); }
  .ag-ct-panel[hidden] { display:none; }
  .ag-prompts { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:6px; align-items:center; }
  .ag-prompt { font-size:0.68rem; padding:3px 9px; border:1px solid var(--border); border-radius:12px; background:var(--surface); color:var(--slate); cursor:pointer; white-space:nowrap; }
  .ag-prompt:hover { border-color:var(--navy-mid); color:var(--on-surface); }
  .ag-prompt.cyc { opacity:0.55; padding:3px 7px; }
  .ag-collapse > summary { cursor:pointer; list-style:none; }
  .ag-collapse > summary::-webkit-details-marker { display:none; }
  .ag-collapse > summary::before { content:'▸ '; color:var(--slate); }
  .ag-collapse[open] > summary::before { content:'▾ '; }
  /* Trim the wall of prose */
  .ag-sub { line-height:1.4; }

  /* ── Agent Studio mobile ────────────────────────────────────────────── */
  @media (max-width: 820px) {
    /* Voice profile two-col interview grid collapses to 1 */
    .ag-grid2 { grid-template-columns: 1fr; }

    /* Agent review queue cards — single column */
    .ag-rev-grid { grid-template-columns: 1fr; }

    /* Launcher options row: wrap comfortably */
    .ag-row { flex-wrap: wrap; }

    /* Batch options: keep count + style dropdowns on same row */
    .ag-field[style*="max-width:120px"], .ag-field[style*="max-width:200px"] {
      max-width: none !important;
      flex: 1 1 120px;
    }

    /* Autopilot cadence / posts row: wrap */
    .ag-field[style*="max-width:160px"] { max-width: none !important; flex: 1 1 140px; }

    /* Progress bar row: stack title + pill */
    .ag-prog .ag-row[style*="justify-content:space-between"] { flex-direction: column; gap: 4px; align-items: flex-start; }

    /* Design memory list: allow long text to wrap */
    .ag-mem-row { flex-wrap: wrap; }
    .ag-mem-row span[style*="flex:1"] { min-width: 0; white-space: normal; }

    /* Job history rows */
    .ag-job { flex-direction: column; gap: 4px; }
  }

  @media (max-width: 520px) {
    /* Review card actions → an even 2-column control pad with comfortable taps */
    .ag-rev .acts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .ag-rev .acts .ag-b, .ag-rev .acts a.ag-b {
      width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center;
      text-align: center; box-sizing: border-box;
    }

    /* Schedule row inside card: date picker full-width above its two buttons */
    .ag-rev .acts.ag-sched-row { grid-template-columns: 1fr 1fr; }
    .ag-rev .acts.ag-sched-row .ag-sched { grid-column: 1 / -1; width: 100%; min-height: 44px; }
    .ag-rev .acts.ag-sched-row .ag-b { width: 100%; text-align: center; }

    /* Platform checkboxes wrap */
    #agPlatforms, #apChannels { flex-wrap: wrap; gap: 6px; }

    /* Auto-slot batch button — full width */
    .ag-h button.ag-b[style*="margin-left:auto"] { margin-left: 0 !important; width: 100%; }

    /* Autopilot checkboxes row */
    .ag-row .ag-chk { flex: 1 1 auto; }

    /* Primary launcher/save buttons get a comfortable tap height */
    .ag-row > .ag-b { min-height: 44px; padding: 10px 14px; }
    #vSynth, #agLaunch, #agStoryBtn { flex: 1 1 auto; justify-content: center; }
  }
</style>

<div class="ag-wrap">

  <!-- ── 1. VOICE PROFILE (Brand DNA) ───────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🎙️ Voice Profile <span class="ag-pill <%= v.voiceBlock ? 'done' : 'queued' %>"><%= v.voiceBlock ? 'configured' : 'not set' %></span></div>
    <p class="ag-sub">Teach the agent how <em>you</em> sound — every generator writes in this voice, and your draft edits keep refining it.</p>

    <div class="ag-grid2">
      <% voiceQuestions.forEach(function(q){ %>
        <div class="ag-field">
          <label><%= q.label %></label>
          <input type="text" id="vq_<%= q.key %>" placeholder="<%= q.placeholder || '' %>" value="<%= qval(q) %>">
        </div>
      <% }); %>
    </div>

    <div class="ag-row" style="margin:6px 0 14px;">
      <button class="ag-b primary" id="vSynth" onclick="agSynth()">✨ Synthesize with AI</button>
      <span class="ag-note" id="vSynthMsg"></span>
    </div>

    <div class="ag-field">
      <label>Voice block (injected into every prompt — edit freely)</label>
      <textarea class="ag-block" id="vBlock"><%= v.voiceBlock || '' %></textarea>
    </div>

    <div class="ag-row">
      <button class="ag-b gold" onclick="agSaveVoice()">💾 Save Voice Profile</button>
      <span class="ag-note" id="vSaveMsg"></span>
    </div>

    <!-- Learned corrections — harvested from your draft edits, taught back to the agent -->
    <div class="ag-fewshot" style="margin-top:16px;border-top:1px solid var(--border);padding-top:12px;">
      <div class="ag-row" style="justify-content:space-between;align-items:center;">
        <div class="ag-h" style="font-size:0.92rem;margin:0;">✏️ Learned corrections <span class="ag-pill <%= (v.fewShot && v.fewShot.length) ? 'queued' : 'done' %>" id="fsCount"><%= (v.fewShot && v.fewShot.length) || 0 %></span></div>
        <label class="ag-chk" title="When off, your edits are still remembered but NOT fed into the agent's prompts"><input type="checkbox" id="fsEnabled" <%= v.fewShotEnabled === false ? '' : 'checked' %> onchange="agFsToggle(this)"> Apply to new posts</label>
      </div>
      <p class="ag-sub" style="margin:6px 0;">Harvested from your draft edits; the latest <strong>5</strong> steer every generation. Remove one-offs — or toggle off above.</p>
      <div id="fsList" class="ag-mem-list">
        <% (v.fewShot || []).slice().reverse().forEach(function(p){ %>
          <div class="ag-mem-row" data-after="<%= encodeURIComponent(p.after || '') %>" style="align-items:flex-start;">
            <span style="flex:1;min-width:0;">
              <% if (p.before) { %><span class="ag-note" style="display:block;white-space:normal;">was: <%= (p.before || '').slice(0,120) %></span><% } %>
              <span style="display:block;white-space:normal;"><%= (p.after || '').slice(0,180) %></span>
              <span class="ag-note"><%= p.source || 'edit' %></span>
            </span>
            <button class="ag-b danger" onclick="agFsDelete(this)" title="Forget this correction">✕</button>
          </div>
        <% }); %>
      </div>
      <span class="ag-note" id="fsEmpty" style="<%= (v.fewShot && v.fewShot.length) ? 'display:none' : '' %>">No learned corrections yet — they appear here as you edit drafts.</span>
      <div class="ag-row" style="margin-top:8px;<%= (v.fewShot && v.fewShot.length) ? '' : 'display:none' %>" id="fsClearRow"><button class="ag-b danger" onclick="agFsClear()">Clear all corrections</button></div>
    </div>
  </div>

  <!-- ── CREATE (batch / story / carousel — one card, tabbed) ───────────────── -->
  <div class="card">
    <div class="ag-create-tabs" id="agCreateTabs">
      <button type="button" class="ag-ct active" data-ct="batch" onclick="agCreateTab('batch')">🚀 Batch</button>
      <button type="button" class="ag-ct" data-ct="story" onclick="agCreateTab('story')">🎬 Story</button>
      <button type="button" class="ag-ct" data-ct="carousel" onclick="agCreateTab('carousel')">↔ Carousel</button>
    </div>

    <!-- BATCH -->
    <div class="ag-ct-panel" data-panel="batch">
      <div class="ag-field" style="margin-bottom:8px;">
        <div class="ag-prompts" id="agBatchPrompts"></div>
        <textarea id="agDir" placeholder="What should this batch be about? e.g. push the new print-studio service, 'ship in days not months' angle"></textarea>
      </div>
      <div class="ag-row" style="margin-bottom:8px;">
        <div class="ag-field" style="max-width:84px;margin:0;"><label>Posts</label><input type="text" id="agCount" value="3" style="text-align:center;"></div>
        <div class="ag-field" style="max-width:180px;margin:0;"><label>Background</label>
          <select id="agStyle"><option value="solid" selected>🎨 Solid + type</option><option value="photo">🖼️ AI photo</option><option value="auto">🔀 Mix</option></select>
        </div>
        <label class="ag-chk" style="display:none;"><input type="checkbox" id="agTrends"> Use listening trends</label>
        <label class="ag-chk" style="align-self:flex-end;"><input type="checkbox" id="agCritic" checked> Critic</label>
      </div>
      <details class="ag-collapse" style="margin-bottom:10px;"><summary class="ag-note">Platforms — blank = all connected</summary>
        <div class="ag-row" id="agPlatforms" style="margin-top:6px;">
          <% liveDefs.forEach(function(p){ %><label class="ag-chk"><input type="checkbox" class="ag-pf" value="<%= p.key %>"> <%= p.icon || '' %> <%= p.name %></label><% }); %>
          <% if (!liveDefs.length) { %><span class="ag-note">None connected.</span><% } %>
        </div>
      </details>
      <div class="ag-row" style="margin-bottom:8px;gap:6px;flex-wrap:wrap;">
        <span class="ag-note" style="align-self:center;">Follow site:</span>
        <label class="ag-chk"><input type="checkbox" class="ab-promote" value="blog"> 📝 Blog</label>
        <label class="ag-chk"><input type="checkbox" class="ab-promote" value="portfolio"> 🖼️ Portfolio</label>
        <label class="ag-chk"><input type="checkbox" class="ab-promote" value="careers"> 💼 Careers</label>
        <label class="ag-chk"><input type="checkbox" id="abLeadGen"> 🎯 Lead capture</label>
      </div>
      <div class="ag-row"><button class="ag-b primary" id="agLaunch" onclick="agLaunch()">▶ Launch batch</button><span class="ag-note" id="agLaunchMsg"></span></div>
    </div>

    <!-- STORY -->
    <div class="ag-ct-panel" data-panel="story" hidden>
      <div class="ag-field" style="margin-bottom:8px;">
        <div class="ag-prompts" id="agStoryPrompts"></div>
        <textarea id="agStoryDir" placeholder="What's the story about? e.g. tease the weekend sale — hook, two examples, 'DM to book' CTA"></textarea>
      </div>
      <div class="ag-row" style="margin-bottom:8px;align-items:flex-end;">
        <div class="ag-field" style="max-width:84px;margin:0;"><label>Frames</label><input type="text" id="agStoryCount" value="4" style="text-align:center;"></div>
        <span class="ag-note" style="align-self:center;">Instagram · 1080×1920</span>
      </div>
      <div class="ag-row" style="margin-bottom:8px;gap:6px;flex-wrap:wrap;">
        <span class="ag-note" style="align-self:center;">Follow site:</span>
        <label class="ag-chk"><input type="checkbox" class="as-promote" value="blog"> 📝 Blog</label>
        <label class="ag-chk"><input type="checkbox" class="as-promote" value="portfolio"> 🖼️ Portfolio</label>
        <label class="ag-chk"><input type="checkbox" class="as-promote" value="careers"> 💼 Careers</label>
        <label class="ag-chk"><input type="checkbox" id="asLeadGen"> 🎯 Lead capture</label>
      </div>
      <div class="ag-row"><button class="ag-b primary" id="agStoryBtn" onclick="agBuildStory()">🎬 Build story</button><span class="ag-note" id="agStoryMsg"></span></div>
    </div>

    <!-- CAROUSEL -->
    <div class="ag-ct-panel" data-panel="carousel" hidden>
      <div class="ag-field" style="margin-bottom:8px;">
        <div class="ag-prompts" id="agCarPrompts"></div>
        <textarea id="agCarDir" placeholder="What's the carousel about? e.g. a 5-part onboarding guide — one step per slide, 'book a call' CTA"></textarea>
      </div>
      <div class="ag-row" style="margin-bottom:8px;align-items:flex-end;">
        <div class="ag-field" style="max-width:84px;margin:0;"><label>Slides</label><input type="text" id="agCarCount" value="4" style="text-align:center;" oninput="agCarDimsUpdate()"></div>
        <button type="button" class="ag-b" onclick="document.getElementById('agCarFile').click()">⬆ Background</button>
        <label class="ag-chk"><input type="checkbox" id="agCarSd"> 🎨 AI bg</label>
        <label class="ag-chk" title="Skip AI headers — slice your background exactly as-is (for designs you finished in the canvas editor)"><input type="checkbox" id="agCarNoText"> No text</label>
        <input type="file" id="agCarFile" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="agCarUpload(this)">
      </div>
      <div class="ag-note" style="margin-bottom:8px;">Instagram · Threads · <span id="agCarDims">4320×1350</span> — no bg = brand gradient. <span id="agCarBgMsg"></span></div>
      <div id="agCarPreviewWrap" style="display:none;margin-bottom:8px;">
        <div class="ag-acct-lbl">Uploaded background</div>
        <img id="agCarPreview" alt="" style="width:100%;max-height:90px;object-fit:cover;border:1px solid var(--border);border-radius:6px;background:var(--ivory);display:block;">
      </div>
      <div class="ag-row"><button class="ag-b primary" id="agCarBtn" onclick="agBuildCarousel()">🖼️ Build carousel</button><span class="ag-note" id="agCarMsg"></span></div>
    </div>

    <!-- shared live progress -->
    <div class="ag-prog" id="agProg" style="margin-top:14px;">
      <div class="ag-row" style="justify-content:space-between;"><strong id="agProgTitle">Working…</strong><span class="ag-pill running" id="agProgPill">running</span></div>
      <div class="ag-track"><div class="ag-fill" id="agFill"></div></div>
      <div class="ag-stage" id="agStage">starting…</div>
    </div>
  </div>

  <!-- ── REVIEW QUEUE (replaces the old Suggestions tab) ─────────────────────── -->
  <div class="card">
    <div class="ag-h">📥 Review queue <span class="ag-pill <%= (suggestions && suggestions.length) ? 'queued' : 'done' %>" id="agQueueCount"><%= (suggestions && suggestions.length) || 0 %></span>
      <button class="ag-b" style="margin-left:auto;" onclick="agAutoSlotAll(this)" title="Spread every pending draft across the calendar at sensible times">⚡ Auto-schedule batch</button>
    </div>
    <p class="ag-sub">Edit here, then <strong>Keep &amp; Post</strong>, <strong>Schedule</strong>, or <strong>Discard</strong> — nothing goes live until you keep it.</p>
    <div class="ag-rev-grid" id="agReviewQueue">
      <% (typeof suggestions !== 'undefined' ? suggestions : []).forEach(function(p){ %>
        <div class="ag-rev" data-id="<%= p._id %>">
          <% if (p.mediaUrls && p.mediaUrls[0]) { %><img<%= p.format === 'carousel' ? ' style="aspect-ratio:auto;max-height:190px;object-fit:contain;background:var(--ivory)"' : '' %> src="<%= p.mediaUrls[0] %>" alt=""><% } %>
          <div class="b">
            <div class="ag-metarow">
              <span class="ag-note" style="flex:1;"><%= (p.platforms || []).join(', ') %><%= p.kind ? ' · ' + p.kind : '' %><%= p.dims ? ' · ' + p.dims : '' %></span>
              <button class="ag-thumb" title="Good design — remember this layout" onclick="agDesignVote(this,'up')">👍</button>
              <button class="ag-thumb" title="Bad design — avoid this layout" onclick="agDesignVote(this,'down')">👎</button>
            </div>
            <textarea><%= p.body || '' %></textarea>
            <% if (p.format === 'carousel' && Array.isArray(p.slides) && p.slides.length) { %>
            <details class="ag-slides">
              <summary>✏️ Edit carousel (<%= p.slides.length %> slides)</summary>
              <div class="ag-acct-lbl">Background</div>
              <div class="ag-row" style="gap:6px;">
                <button type="button" class="ag-b" onclick="agCarBgPick(this)">⬆ Replace</button>
                <label class="ag-chk"><input type="checkbox" class="ag-car-sd"> 🎨 AI background</label>
                <input type="file" class="ag-car-file" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="agCarBgUpload(this)">
                <input type="hidden" class="ag-car-bg" value="">
                <span class="ag-note ag-car-bgmsg"></span>
              </div>
              <div class="ag-acct-lbl">Slide copy</div>
              <div class="ag-slides-list">
                <% p.slides.forEach(function(s, i){ %>
                  <div class="ag-slide"><div class="ag-slide-n"><%= i + 1 %></div><div class="ag-slide-f">
                    <input class="ag-slide-h" placeholder="Headline" value="<%= s.headline || '' %>">
                    <input class="ag-slide-s" placeholder="Subtitle (optional)" value="<%= s.subtitle || '' %>">
                  </div></div>
                <% }); %>
              </div>
              <button class="ag-b gold" onclick="agCarSave(this)">↻ Update preview</button>
              <span class="ag-note ag-car-msg"></span>
            </details>
            <% } %>
            <% const _pfmt = p.format || 'single'; const _psel = (p.platforms || []);
               const _usable = liveDefs.filter(d => _pfmt === 'carousel' ? (d.caps && d.caps.carousel) : _pfmt === 'story' ? (d.caps && d.caps.story) : true); %>
            <% if (_usable.length) { %>
            <div class="ag-acct-lbl">Post to</div>
            <div class="ag-acct-row">
              <% _usable.forEach(function(d){ const on = _psel.includes(d.key); %>
                <label class="ag-acct <%= on ? 'on' : '' %>"><input type="checkbox" value="<%= d.key %>" <%= on ? 'checked' : '' %> onchange="this.closest('.ag-acct').classList.toggle('on',this.checked)"> <%= d.icon || '' %> <%= d.name %></label>
              <% }); %>
            </div>
            <% } %>
            <div class="acts">
              <% const _multi = ['story','carousel'].includes(p.format) || ['story','carousel'].includes(p.kind); %>
              <% if (p.format === 'carousel') { %><a class="ag-b primary" href="/admin/assets/social?suggestion=<%= p._id %>" title="Open the full wide canvas in the editor — background, text, images, video">🎨 Edit in canvas</a><% } else if (!_multi) { %><a class="ag-b primary" href="/admin/assets/social?suggestion=<%= p._id %>" onclick="return agRevEdit(this, event)" title="Open in the Asset Generator — edits return here">🎨 Edit</a><% } %>
              <button class="ag-b" onclick="agRevSave(this)">Save text</button>
              <button class="ag-b gold" onclick="agRevApprove(this)">Keep &amp; Post</button>
              <button class="ag-b danger" onclick="agRevDismiss(this)">Discard</button>
            </div>
            <div class="acts ag-sched-row">
              <input type="datetime-local" class="ag-sched" title="Schedule this post">
              <button class="ag-b" onclick="agRevSchedule(this)">📅 Schedule</button>
              <button class="ag-b" onclick="agRevAutoSlot(this)" title="Let the agent pick the next open calendar slot">⚡ Auto-slot</button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <span class="ag-note" id="agQueueEmpty" style="<%= (suggestions && suggestions.length) ? 'display:none' : '' %>">No pending drafts yet — launch a batch above.</span>
  </div>

  <!-- ── LEARNING (design taste from 👍/👎 + performance signals) ──────────────── -->
  <% const dprefs = (typeof designPrefs !== 'undefined' && designPrefs) ? designPrefs : null;
     const dfeed = (typeof designFeedback !== 'undefined' && designFeedback) ? designFeedback : []; %>
  <div class="card">
    <div class="ag-h">🧠 Learning <span class="ag-pill <%= (dprefs && (dprefs.sampleUp || dprefs.sampleDown)) ? 'done' : 'queued' %>" id="agMemPill"><%= dprefs ? (dprefs.sampleUp||0) + '👍 ' + (dprefs.sampleDown||0) + '👎' : '0' %></span></div>
    <p class="ag-sub">The agent learns what works and applies it to new posts — auto-tuning <strong>typeface, size, alignment</strong> from your 👍/👎, keeping text legible with <strong>contrast-checked brand colors</strong>, and fitting copy to the pixel space. It also <strong>scores live posts by real engagement</strong> to see what's actually winning.</p>

    <!-- Reliability: statistical confidence from scored live posts -->
    <% const _rel = (typeof reliability !== 'undefined' && reliability) ? reliability : { scored:0, reliability:0, avg:0, target:30, signals:[] }; %>
    <div class="ag-fewshot" style="border-top:1px solid var(--border);padding-top:12px;margin-bottom:12px;">
      <div class="ag-row" style="justify-content:space-between;align-items:center;">
        <div class="ag-h" style="font-size:0.92rem;margin:0;">📊 Decision reliability <span class="ag-pill <%= _rel.reliability >= 80 ? 'done' : 'queued' %>" id="relPct"><%= _rel.reliability %>%</span></div>
        <button class="ag-b" onclick="agScoreNow(this)" title="Fetch live engagement for recently-published posts and score them now">↻ Score live posts</button>
      </div>
      <div class="ag-track" style="margin:8px 0;"><div class="ag-fill" id="relBar" style="width:<%= _rel.reliability %>%;background:<%= _rel.reliability >= 80 ? '#15803D' : 'var(--gold,#C9A848)' %>;"></div></div>
      <p class="ag-sub" style="margin:4px 0;"><strong id="relScored"><%= _rel.scored %></strong> live posts scored of ~<%= _rel.target %> needed for high confidence. <span id="relMsg"><%= _rel.reliability >= 80 ? 'Enough data to trust design decisions.' : 'Gathering data — decisions firm up as more posts go live.' %></span></p>
      <div id="relSignals" class="ag-row" style="gap:5px;">
        <% (_rel.signals || []).slice(0,6).forEach(function(s){ %><span class="ag-pill <%= s.lift >= 0 ? 'done' : 'failed' %>" style="text-transform:none;letter-spacing:0;font-weight:500;" title="avg score <%= s.avg %> · <%= s.n %> posts"><%= s.key %> <%= s.lift >= 0 ? '+' : '' %><%= s.lift %>%</span><% }); %>
      </div>
    </div>
    <div class="ag-mem" id="agMemSummary"><%= (typeof designSummary !== 'undefined' ? designSummary : '') %></div>
    <div class="ag-mem-list" id="agMemList">
      <% dfeed.forEach(function(f){ const s = f.signature || {}; %>
        <div class="ag-mem-row" data-id="<%= f._id %>">
          <% if (f.thumb) { %><img src="<%= f.thumb %>" alt=""><% } %>
          <span class="ag-mem-v <%= f.verdict %>"><%= f.verdict === 'up' ? '👍' : '👎' %></span>
          <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= (f.headline || '(untitled)') %> <span class="ag-note">· <%= s.aspect || '' %> · <%= s.fontKind || '' %> · <%= s.align || '' %></span></span>
          <button class="ag-b danger" onclick="agMemDelete(this)" title="Forget this">✕</button>
        </div>
      <% }); %>
    </div>
    <span class="ag-note" id="agMemEmpty" style="<%= dfeed.length ? 'display:none' : '' %>">No design feedback yet — thumb a few drafts to start.</span>
  </div>

  <!-- ── 3. AUTOPILOT (opt-in) ──────────────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🛩️ Autopilot</div>

    <!-- Running-campaign status + quick controls -->
    <% const _running = as.enabled && as.cadence && as.cadence !== 'off';
       const _last = as.lastRunAt ? new Date(as.lastRunAt) : null;
       const _mode = as.autoPublish ? '⚠️ publishes live' : as.autoSlot ? '📅 auto-slots to calendar' : 'review-first'; %>
    <div class="ag-row" style="justify-content:space-between;align-items:center;border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:12px;background:var(--surface);">
      <div style="min-width:0;">
        <span class="ag-pill <%= _running ? 'done' : 'queued' %>" id="apStatusPill"><%= _running ? '🟢 Running' : '⚪ Off' %></span>
        <% if (_running) { %><span class="ag-note" style="margin-left:6px;"><%= as.cadence.replace('_',' ') %> · <%= as.count||3 %>/run · <%= _mode %><%= _last ? ' · last ' + _last.toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '' %></span><% } else { %><span class="ag-note" style="margin-left:6px;">Not running — set a cadence and Start.</span><% } %>
      </div>
      <div class="ag-row" style="gap:6px;flex-wrap:nowrap;">
        <button class="ag-b <%= _running ? '' : 'primary' %>" id="apToggleBtn" onclick="agAutoToggleRun()"><%= _running ? '⏸ Stop' : '▶ Start' %></button>
        <button class="ag-b danger" onclick="agAutoDelete()" title="Stop it and clear the settings">🗑</button>
      </div>
    </div>

    <p class="ag-sub">Runs on a cadence. Default is <strong>review-first</strong> (drafts land in the review queue). Use <strong>📅 Auto-slot</strong> to see the pipeline on the calendar, or <strong>Auto-publish</strong> to go live — only when you trust it.</p>

    <div class="ag-row" style="margin-bottom:10px;">
      <label class="ag-chk"><input type="checkbox" id="apEnabled" <%= as.enabled ? 'checked' : '' %>> Enabled</label>
      <div class="ag-field" style="max-width:160px;margin:0;">
        <label>Cadence</label>
        <select id="apCadence">
          <option value="off" <%= cadence==='off'?'selected':'' %>>Off</option>
          <option value="daily" <%= cadence==='daily'?'selected':'' %>>Daily</option>
          <option value="3x_week" <%= cadence==='3x_week'?'selected':'' %>>3× / week</option>
          <option value="weekly" <%= cadence==='weekly'?'selected':'' %>>Weekly</option>
        </select>
      </div>
      <div class="ag-field" style="max-width:120px;margin:0;">
        <label>Posts / run</label>
        <input type="text" id="apCount" value="<%= as.count || 3 %>" style="text-align:center;">
      </div>
    </div>

    <div class="ag-field">
      <label>Standing direction (what autopilot should keep posting about)</label>
      <textarea id="apPrompt" placeholder="e.g. mix value tips, a service highlight, and a local angle; keep it warm and concrete"><%= as.standingPrompt || '' %></textarea>
    </div>

    <!-- Follow the rest of the platform: promote real site content with links back -->
    <% const _promo = Array.isArray(as.promote) ? as.promote : []; %>
    <div class="ag-field">
      <label>Follow your site <span class="ag-note">— promote fresh content with links back</span></label>
      <div class="ag-row">
        <label class="ag-chk"><input type="checkbox" class="ap-promote" value="blog" <%= _promo.includes('blog')?'checked':'' %>> 📝 Blog</label>
        <label class="ag-chk"><input type="checkbox" class="ap-promote" value="portfolio" <%= _promo.includes('portfolio')?'checked':'' %>> 🖼️ Portfolio</label>
        <label class="ag-chk"><input type="checkbox" class="ap-promote" value="careers" <%= _promo.includes('careers')?'checked':'' %>> 💼 New careers</label>
        <label class="ag-chk" style="border-color:var(--gold,#C9A848);" title="Some posts push newsletter signups with a link back to your site — capturing leads."><input type="checkbox" id="apLeadGen" <%= as.leadGen ? 'checked' : '' %>> 🎯 Lead capture</label>
      </div>
    </div>

    <!-- Use your own tagged assets as post backgrounds -->
    <div class="ag-field">
      <label>Asset tags <span class="ag-note">— use your library images (matching these tags) as backgrounds instead of AI</span></label>
      <input type="text" id="apAssetTags" placeholder="e.g. brand, product-shots, storefront" value="<%= (Array.isArray(as.assetTags) ? as.assetTags.join(', ') : '') %>">
    </div>

    <!-- Marketing calendar: upcoming holidays/moments autopilot can lean into -->
    <% if (typeof observances !== 'undefined' && observances && observances.length) { %>
    <div class="ag-field">
      <label>📅 Marketing calendar <span class="ag-note">— autopilot weaves these in automatically</span></label>
      <div class="ag-row" style="gap:5px;">
        <% observances.slice(0,8).forEach(function(o){ %><span class="ag-pill queued" style="text-transform:none;letter-spacing:0;font-weight:500;"><%= o %></span><% }); %>
      </div>
    </div>
    <% } %>

    <div class="ag-field">
      <label>Channels <span class="ag-note">(blank = all connected)</span></label>
      <div class="ag-row" id="apChannels">
        <% liveDefs.forEach(function(p){ %>
          <label class="ag-chk"><input type="checkbox" class="ap-ch" value="<%= p.key %>" <%= channels.includes(p.key)?'checked':'' %>> <%= p.icon || '' %> <%= p.name %></label>
        <% }); %>
      </div>
    </div>

    <p class="ag-note" style="margin:2px 0 8px;">✅ Uses only 👍-approved backgrounds and your Voice Profile — on-brand and safe by default.</p>

    <div class="ag-row" style="margin-bottom:10px;">
      <%# DISABLED FOR RELEASE: Listening trends — input kept hidden so JS refs stay valid %>
      <label class="ag-chk" style="display:none;"><input type="checkbox" id="apTrends" <%= as.useTrends !== false ? 'checked' : '' %>> Use trends</label>
      <label class="ag-chk"><input type="checkbox" id="apCritic" <%= as.critic !== false ? 'checked' : '' %>> Critic pass</label>
      <label class="ag-chk" title="Schedule each run's drafts onto the calendar at open slots — so you can see the pipeline ahead and cancel any before they go out"><input type="checkbox" id="apAutoSlot" <%= as.autoSlot ? 'checked' : '' %>> 📅 Auto-slot to calendar</label>
      <label class="ag-chk" style="border-color:var(--gold,#C9A848);"><input type="checkbox" id="apPublish" <%= as.autoPublish ? 'checked' : '' %>> ⚠️ Auto-publish live</label>
    </div>

    <div class="ag-row">
      <button class="ag-b gold" onclick="agSaveAuto()">💾 Save autopilot</button>
      <span class="ag-note" id="apMsg"></span>
    </div>
  </div>

  <!-- ── 4. JOB HISTORY ─────────────────────────────────────────────────────── -->
  <div class="card">
    <div class="ag-h">🗂️ Recent batches</div>
    <div class="ag-jobs" id="agHistory">
      <% if (!jobs || !jobs.length) { %>
        <span class="ag-note">No batches yet.</span>
      <% } else { jobs.forEach(function(j){ %>
        <div class="ag-job">
          <span><%= (j.direction || '(no direction)').slice(0,70) %></span>
          <span><span class="ag-pill <%= j.status %>"><%= j.status %></span> &nbsp;<%= (j.summary && j.summary.created) || (j.postIds ? j.postIds.length : 0) %> drafts</span>
        </div>
      <% }); } %>
    </div>
  </div>

</div>

<script>
const AG_QKEYS = <%- JSON.stringify(voiceQuestions.map(q => q.key)) %>;
// Connected accounts (for the review-card "cross-post to my accounts" chips).
const AG_CONNECTED = <%- JSON.stringify(liveDefs.map(p => ({ key: p.key, name: p.name, icon: p.icon || '', carousel: !!(p.caps && p.caps.carousel), story: !!(p.caps && p.caps.story) }))) %>;
// Build the account-chip row for a card. `fmt` filters to format-capable accounts;
// `selected` are the chips checked by default (the post's current platforms).
function agAcctChips(fmt, selected) {
  const sel = new Set(selected || []);
  const usable = AG_CONNECTED.filter(a => fmt === 'carousel' ? a.carousel : fmt === 'story' ? a.story : true);
  if (!usable.length) return '';
  return '<div class="ag-acct-lbl">Post to</div><div class="ag-acct-row">' + usable.map(a =>
    '<label class="ag-acct' + (sel.has(a.key) ? ' on' : '') + '"><input type="checkbox" value="' + a.key + '"' + (sel.has(a.key) ? ' checked' : '') + ' onchange="this.closest(\'.ag-acct\').classList.toggle(\'on\',this.checked)"> ' + agEsc(a.icon) + ' ' + agEsc(a.name) + '</label>'
  ).join('') + '</div>';
}
// Checked account keys on a card (falls back to nothing → server uses post's own).
function agCardPlatforms(card) {
  return Array.from(card.querySelectorAll('.ag-acct input:checked')).map(c => c.value);
}
let AG_SEED_FEWSHOT = <%- JSON.stringify((voice && voice.fewShot && voice.fewShot.length) ? 'has' : null) %>;
let AG_POLL = null;

// Single source of truth for AJAX → JSON. An expired admin session makes the
// auth middleware answer 401 (not a 302 to an HTML login page), so this turns a
// cryptic "Unexpected token '<'" into a clear "session expired" message and keeps
// saves honest (a silently-failed save no longer looks like it worked).
async function agJson(url, opts) {
  const r = await fetch(url, opts);
  if (r.status === 401) { const e = new Error('Your session expired — refresh the page and sign in again, then retry.'); e.authRequired = true; throw e; }
  let j;
  try { j = await r.json(); }
  catch { throw new Error(r.ok ? 'Unexpected response from server.' : ('Request failed (' + r.status + ').')); }
  return j;
}

function agAnswers() {
  const a = {};
  AG_QKEYS.forEach(k => { const el = document.getElementById('vq_' + k); if (el) a[k] = el.value; });
  return a;
}

async function agSynth() {
  const btn = document.getElementById('vSynth'); const msg = document.getElementById('vSynthMsg');
  btn.disabled = true; msg.textContent = 'Thinking…';
  try {
    const r = await fetch('/admin/social/voice/synthesize', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ answers: agAnswers() }) });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Failed');
    document.getElementById('vBlock').value = j.voiceBlock || '';
    if (j.profile) {
      const set = (k, val) => { const el = document.getElementById('vq_' + k); if (el && val) el.value = Array.isArray(val) ? val.join(', ') : val; };
      ['persona','audience','tone','signaturePhrases','avoid','emojiPolicy','hashtagPolicy','lengthPref'].forEach(k => set(k, j.profile[k]));
    }
    if (!AG_SEED_FEWSHOT && Array.isArray(j.seedFewShot)) AG_SEED_FEWSHOT = j.seedFewShot;
    msg.textContent = 'Drafted — review & save.';
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
  btn.disabled = false;
}

async function agSaveVoice() {
  const msg = document.getElementById('vSaveMsg'); msg.textContent = 'Saving…';
  const a = agAnswers();
  const payload = {
    persona: a.persona, audience: a.audience, tone: a.tone, signaturePhrases: a.signaturePhrases,
    avoid: a.avoid, emojiPolicy: a.emojiPolicy, hashtagPolicy: a.hashtagPolicy, lengthPref: a.lengthPref,
    interview: a, voiceBlock: document.getElementById('vBlock').value,
  };
  if (Array.isArray(AG_SEED_FEWSHOT)) payload.seedFewShot = AG_SEED_FEWSHOT;
  try {
    const j = await agJson('/admin/social/voice', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    msg.textContent = j.ok ? '✓ Saved' : ('⚠ ' + (j.error || 'Failed'));
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
}

// ── Learned corrections (few-shot) management ────────────────────────────────
function agFsRecount() {
  const n = document.querySelectorAll('#fsList .ag-mem-row').length;
  const c = document.getElementById('fsCount'); if (c) c.textContent = n;
  const e = document.getElementById('fsEmpty'); if (e) e.style.display = n ? 'none' : '';
  const r = document.getElementById('fsClearRow'); if (r) r.style.display = n ? '' : 'none';
}
async function agFsToggle(cb) {
  try { await agJson('/admin/social/voice/corrections/toggle', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ enabled: cb.checked }) }); }
  catch (e) { SlabFlash.error(e.message); cb.checked = !cb.checked; }
}
async function agFsDelete(btn) {
  const row = btn.closest('.ag-mem-row'); const after = decodeURIComponent(row.dataset.after || '');
  try {
    const j = await agJson('/admin/social/voice/corrections/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ after }) });
    if (j.ok) { row.remove(); agFsRecount(); } else SlabFlash.error(j.error || 'Could not remove');
  } catch (e) { SlabFlash.error(e.message); }
}
async function agFsClear() {
  if (!confirm('Forget ALL learned corrections? The agent will stop mimicking your past edits.')) return;
  try {
    const j = await agJson('/admin/social/voice/corrections/clear', { method:'POST' });
    if (j.ok) { document.getElementById('fsList').innerHTML = ''; agFsRecount(); } else SlabFlash.error(j.error || 'Failed');
  } catch (e) { SlabFlash.error(e.message); }
}

async function agLaunch() {
  const btn = document.getElementById('agLaunch'); const msg = document.getElementById('agLaunchMsg');
  const platforms = Array.from(document.querySelectorAll('.ag-pf:checked')).map(c => c.value);
  const body = {
    direction: document.getElementById('agDir').value,
    count: parseInt(document.getElementById('agCount').value, 10) || 3,
    platforms,
    style: document.getElementById('agStyle') ? document.getElementById('agStyle').value : 'solid',
    useTrends: document.getElementById('agTrends').checked,
    critic: document.getElementById('agCritic').checked,
    promote: Array.from(document.querySelectorAll('.ab-promote:checked')).map(c => c.value),
    leadGen: document.getElementById('abLeadGen') ? document.getElementById('abLeadGen').checked : false,
  };
  btn.disabled = true; msg.textContent = 'Launching…';
  try {
    const r = await fetch('/admin/social/agent-studio/run', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Failed');
    msg.textContent = 'Generating in the background…';
    agStartPolling(j.jobId);
  } catch (e) { msg.textContent = '⚠ ' + e.message; btn.disabled = false; }
}

// Story Studio: script + render an IG story sequence → a story draft that joins
// the review queue below (published in order by "Keep & Post").
async function agBuildStory() {
  const btn = document.getElementById('agStoryBtn'); const msg = document.getElementById('agStoryMsg');
  const direction = document.getElementById('agStoryDir').value;
  const count = Math.max(2, Math.min(8, parseInt(document.getElementById('agStoryCount').value, 10) || 4));
  btn.disabled = true; msg.textContent = 'Scripting & rendering ' + count + ' frames… this can take a minute.';
  try {
    const promote = Array.from(document.querySelectorAll('.as-promote:checked')).map(c => c.value);
    const leadGen = document.getElementById('asLeadGen') ? document.getElementById('asLeadGen').checked : false;
    const j = await agJson('/admin/social/agent-studio/story', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ direction, count, promote, leadGen }) });
    if (!j.ok) throw new Error(j.error || 'Failed');
    msg.textContent = '✓ Story ready — review below.';
    agRenderReview([j.post]);
  } catch (e) { msg.textContent = '⚠ ' + e.message; }
  btn.disabled = false;
}

// Create card — switch between the Batch / Story / Carousel builders (one visible).
function agCreateTab(name) {
  document.querySelectorAll('#agCreateTabs .ag-ct').forEach(b => b.classList.toggle('active', b.dataset.ct === name));
  document.querySelectorAll('.ag-ct-panel').forEach(p => { p.hidden = p.dataset.panel !== name; });
}

// Quick-prompt chips + ♻ recycle for each builder (fills its direction box).
const AG_PROMPT_POOLS = {
  batch: [
    { l: 'New service', p: 'Promote our newest service — lead with the outcome, a distinct angle per post.' },
    { l: 'Behind the scenes', p: 'A behind-the-scenes look at how we work — human, warm, real.' },
    { l: 'Customer win', p: 'Spotlight a recent customer result — the problem, what we did, the outcome.' },
