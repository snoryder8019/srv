<%- include('../partials/head', { title: 'Social Media' }) %>
<%- include('../partials/sidebar', { page: 'social', user: user }) %>

<style>
  .sm-platform-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .sm-pill { display:flex; align-items:center; gap:8px; padding:10px 12px; border:1px solid var(--border); border-radius:6px; cursor:pointer; transition:all 0.15s; background:var(--surface); user-select:none; }
  .sm-pill:hover { border-color: var(--navy-mid); }
  .sm-pill input { display:none; }
  .sm-pill.disabled { opacity:0.5; cursor:not-allowed; }
  .sm-pill .sm-ic { font-size:1.2rem; width:24px; text-align:center; flex-shrink:0; }
  .sm-pill .sm-nm { font-size:0.82rem; font-weight:500; color:var(--on-surface); }
  .sm-pill .sm-sub { font-size:0.62rem; color:var(--slate); }
  .sm-pill.sel { border-color: var(--navy); background: rgba(28,43,74,0.05); box-shadow: inset 0 0 0 1px var(--navy); }
  .sm-conn-card { border:1px solid var(--border); border-radius:6px; padding:16px; background:var(--surface); }
  .sm-conn-head { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
  .sm-conn-head .sm-ic { font-size:1.5rem; }
  .sm-conn-name { font-size:1rem; font-weight:600; color:var(--on-surface); }
  .sm-status-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .sm-status-dot.ok { background:#15803D; } .sm-status-dot.off { background:#cbd5e1; }
  .sm-setup { font-size:0.72rem; color:var(--slate); line-height:1.55; background:var(--ivory); border-radius:4px; padding:10px 12px; margin:10px 0; }
  .sm-soon { font-size:0.6rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--badge-accent); background:rgba(201,168,72,0.15); padding:2px 7px; border-radius:3px; }
  .sm-res { display:inline-flex; align-items:center; gap:4px; font-size:0.66rem; padding:2px 7px; border-radius:3px; margin:2px 3px 0 0; }
  .sm-res.ok { background:rgba(21,128,61,0.12); color:var(--success); }
  .sm-res.fail { background:rgba(185,28,28,0.1); color:var(--danger); }
  .sm-counter { font-size:0.68rem; color:var(--slate); }
  .sm-counter.over { color:var(--danger); font-weight:600; }
  /* Asset picker */
  .sm-modal { position:fixed; inset:0; background:rgba(15,27,48,0.55); z-index:1000; display:flex; align-items:center; justify-content:center; padding:24px; }
  .sm-modal-box { background:var(--surface); border-radius:8px; width:min(780px,100%); max-height:84vh; display:flex; flex-direction:column; padding:18px; }
  .sm-modal-head { display:flex; align-items:center; justify-content:space-between; font-weight:600; color:var(--on-surface); font-family:var(--font-heading); font-size:1.05rem; }
  .sm-asset-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(110px,1fr)); gap:10px; overflow-y:auto; flex:1 1 auto; min-height:240px; max-height:64vh; align-content:start; }
  .sm-asset { border:2px solid var(--border); border-radius:6px; overflow:hidden; cursor:pointer; background:var(--ivory); transition:border-color 0.12s; }
  .sm-asset:hover { border-color:var(--navy-mid); }
  .sm-asset.sel { border-color:var(--navy); box-shadow:inset 0 0 0 2px var(--navy); }
  .sm-asset img { width:100%; aspect-ratio:1/1; object-fit:cover; display:block; }
  .sm-asset .nm { font-size:0.6rem; color:var(--slate); padding:3px 5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .sm-thumb { position:relative; width:64px; height:64px; border-radius:4px; overflow:hidden; border:1px solid var(--border); }
  .sm-thumb img, .sm-thumb video { width:100%; height:100%; object-fit:cover; }
  .sm-thumb button { position:absolute; top:2px; right:2px; background:rgba(0,0,0,0.6); color:#fff; border:none; border-radius:50%; width:17px; height:17px; font-size:11px; line-height:1; cursor:pointer; padding:0; }
  /* Engage */
  .sm-eng-card { border:1px solid var(--border); border-radius:8px; padding:16px; background:var(--surface); }
  .sm-eng-post { display:flex; gap:12px; padding:14px 0; border-top:1px solid var(--border); }
  .sm-eng-post:first-child { border-top:none; }
  .sm-eng-thumb { width:72px; height:72px; border-radius:6px; object-fit:cover; flex-shrink:0; border:1px solid var(--border); background:var(--ivory); }
  .sm-eng-body { flex:1; min-width:0; }
  .sm-eng-text { font-size:0.84rem; color:var(--on-surface); line-height:1.45; margin-bottom:6px; white-space:pre-wrap; word-break:break-word; }
  .sm-eng-meta { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-bottom:8px; }
  .sm-eng-metric { font-size:0.68rem; background:var(--ivory); border:1px solid var(--border); border-radius:12px; padding:2px 9px; color:var(--slate); }
  .sm-eng-metric b { color:var(--on-surface); }
  .sm-eng-date { font-size:0.66rem; color:var(--slate); }
  .sm-eng-link { font-size:0.66rem; color:var(--gold); text-decoration:none; }
  .sm-eng-comments { margin-top:8px; border-left:2px solid var(--border); padding-left:10px; }
  .sm-eng-comment { font-size:0.76rem; margin-bottom:8px; }
  .sm-eng-comment .who { font-weight:600; color:var(--on-surface); }
  .sm-eng-comment .when { color:var(--slate); font-size:0.62rem; margin-left:5px; }
  .sm-eng-replybar { display:flex; gap:6px; margin-top:4px; }
  .sm-eng-replybar input { flex:1; font-size:0.74rem; padding:5px 8px; border:1px solid var(--border); border-radius:4px; }
  .sm-eng-replybar button { font-size:0.66rem; white-space:nowrap; }
  .sm-eng-empty { font-size:0.78rem; color:var(--slate); padding:10px 0; }
  .sm-eng-err { font-size:0.78rem; color:var(--danger); padding:10px 12px; background:rgba(185,28,28,0.07); border-radius:4px; }

  /* ── Mobile responsive additions ──────────────────────────────────────── */
  @media (max-width: 820px) {
    /* Compose — platform pills grid: 2 columns max */
    .sm-platform-grid { grid-template-columns: repeat(2, 1fr); }

    /* Compose — image controls row wraps vertically */
    .sm-platform-grid ~ * { flex-wrap: wrap; }

    /* Connections — card grid drops to 1 col */
    div[style*="grid-template-columns:repeat(auto-fill,minmax(340px"] {
      grid-template-columns: 1fr !important;
    }

    /* Engage — post thumbnail shrinks on tablet */
    .sm-eng-thumb { width: 56px; height: 56px; }

    /* Engage — reply bar allows input to be narrower so button fits */
    .sm-eng-replybar { flex-wrap: wrap; }
    .sm-eng-replybar input { min-width: 0; }

    /* Calendar: tighten to fit 7 cols ≈820px (thumb+meta chip; see tab-scoped rules) */
    .cal-cell { min-height: 100px; padding: 4px; }
    .cal-dow { font-size: 0.55rem; padding: 3px 0; }
    .cal-daynum { font-size: 0.62rem; }
    .cal-chip { font-size: 0.58rem; }
    .cal-meta { padding: 3px 4px 4px; }
    .cal-chip .t { font-size: 0.58rem; }

    /* Asset modal — comfortable padding on tablet */
    .sm-modal { padding: 16px; }
    .sm-modal-box { padding: 14px; }
    .sm-asset-grid { grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); min-height: 160px; max-height: 55dvh; }

    /* Scheduled subtabs toolbar wraps */
    .sm-subtabs { flex-wrap: wrap; }

    /* Compliance URL rows — stack label + code */
    div[style*="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap"] code {
      width: 100%;
      font-size: 0.68rem;
      word-break: break-all;
    }
  }

  @media (max-width: 520px) {
    /* Compose — platform pills: single column on small phones */
    .sm-platform-grid { grid-template-columns: 1fr; }

    /* Compose — action buttons become a 2×2 control pad (thumb-friendly) */
    .form-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .form-actions .btn { width: 100%; min-height: 46px; justify-content: center; text-align: center; padding: 10px 8px; }

    /* Compose — topbar export buttons: hide text, keep accessible */
    .topbar-actions .btn-ghost { font-size: 0.68rem; padding: 6px 8px; }

    /* Engage — stack thumb above text body on small phones */
    .sm-eng-post { flex-direction: column; gap: 8px; }
    .sm-eng-thumb { width: 100%; height: auto; aspect-ratio: 4/3; border-radius: 6px; }

    /* Engage — metrics chips wrap (already flex-wrap but reinforce) */
    .sm-eng-meta { gap: 4px; }

    /* Calendar — allow horizontal scroll as fallback, don't blow viewport */
    .cal-grid { overflow-x: auto; min-width: 0; }
    .cal-grid > * { min-width: 42px; }
    .cal-cell { min-height: 52px; padding: 3px 2px; gap: 2px; }
    .cal-chip { display: none; } /* hide event chips; tap target stays safe */
    .cal-chip:first-of-type { display: flex; } /* show first chip only */
    .cal-daynum { font-size: 0.6rem; }

    /* Asset modal: full-width, tighter on 360px */
    .sm-modal { padding: 8px; }
    .sm-modal-box { padding: 10px; border-radius: 6px; max-height: 85dvh; }
    .sm-asset-grid { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 7px; max-height: 52dvh; }
    .sm-modal-head { font-size: 0.9rem; }

    /* Connection cards: stack status badge inline, no overflow */
    .sm-conn-head { flex-wrap: wrap; gap: 6px; }
    .sm-conn-name { font-size: 0.92rem; }

    /* Scheduled sub-tabs: each button full-width */
    .sm-subtabs { flex-direction: column; }
    .sm-subtabs .btn { width: 100%; text-align: center; }

    /* Reply bars in engage: stack vertically */
    .sm-eng-replybar { flex-direction: column; }
    .sm-eng-replybar button { width: 100%; }

    /* ── HARD OVERFLOW GUARD — nothing in the social content may exceed the
       viewport width on a phone (this is what made the page feel "not
       responsive": a few inline flex rows + wide inputs were forcing
       horizontal scroll). ── */
    .content, .content .card, .content form { max-width: 100%; }
    .content input[type=text], .content input[type=url], .content input[type=datetime-local],
    .content textarea, .content select { width: 100%; max-width: 100%; min-width: 0; }
    /* Any inline flex row in a form field wraps: input takes its own row,
       the action buttons share the row below it */
    .sm-inline-row { flex-wrap: wrap; }
    .sm-inline-row > input { flex: 1 1 100%; }
    .sm-inline-row > .btn { flex: 1 1 auto; justify-content: center; }
  }

  /* ── Posts / Scheduled table → stacked cards on phones ──────────────────────
     A horizontally-scrolling data table is unusable on a phone. Below 640px the
     table reflows into one card per post, with the action buttons laid out as an
     even control pad so every tap target is comfortable. ── */
  @media (max-width: 640px) {
    .sm-posts-table { overflow-x: visible; border: none; background: transparent; }
    .sm-posts-table table { min-width: 0; width: 100%; }
    .sm-posts-table thead { display: none; }
    .sm-posts-table tbody, .sm-posts-table tr, .sm-posts-table td { display: block; width: 100%; }
    .sm-posts-table tr {
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
      padding: 12px 14px; margin-bottom: 12px;
    }
    .sm-posts-table tr:hover { background: var(--surface); }
    .sm-posts-table td { border: none; padding: 3px 0; }
    /* Status badge + platform icons share the header row of the card */
    .sm-posts-table td:first-child,
    .sm-posts-table td:nth-child(2) { display: inline-block; width: auto; vertical-align: middle; margin-right: 8px; }
    .sm-posts-table td:nth-child(3) { color: var(--slate); font-size: 0.74rem; margin-top: 2px; }
    .sm-posts-table td[style*="max-width:280px"],
    .sm-posts-table td[style*="max-width:200px"] { max-width: 100% !important; }
    /* Action cell becomes a 2-column control pad */
    .sm-posts-table td:last-child {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border);
    }
    .sm-posts-table td:last-child form { display: block; margin: 0; }
    .sm-posts-table td:last-child .btn,
    .sm-posts-table td:last-child form button {
      width: 100%; min-height: 42px; justify-content: center; font-size: 0.72rem !important;
    }
  }

  /* Tab bar: clean scroll on mobile (no scrollbar chrome), tighter tap targets */
  @media (max-width: 820px) {
    .tabs { scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x proximity; }
    .tabs::-webkit-scrollbar { display: none; }
    .tab-link { padding: 12px 14px; font-size: 0.72rem; scroll-snap-align: start; }
  }
</style>

<div class="topbar">
  <div class="topbar-title">Social Media</div>
  <div class="topbar-actions">
    <a href="/admin/social/export?format=csv" class="btn btn-ghost btn-sm">Export CSV</a>
    <a href="/admin/social/export?format=json" class="btn btn-ghost btn-sm">Export JSON</a>
  </div>
</div>

<div class="content">

  <!-- Stats -->
  <div class="stat-grid" style="margin-bottom:24px;">
    <div class="stat-card"><div class="stat-label">Connected</div><div class="stat-value"><%= stats.connected %></div></div>
    <div class="stat-card"><div class="stat-label">Scheduled</div><div class="stat-value gold"><%= stats.scheduled %></div></div>
    <div class="stat-card"><div class="stat-label">Published</div><div class="stat-value"><%= stats.published %></div></div>
    <div class="stat-card"><div class="stat-label">Drafts</div><div class="stat-value"><%= stats.drafts %></div></div>
  </div>

  <div class="tabs">
    <a href="?tab=compose" class="tab-link <%= tab === 'compose' ? 'active' : '' %>">Compose</a>
    <a href="?tab=agents" class="tab-link <%= tab === 'agents' ? 'active' : '' %>">🤖 Agent Studio</a>
    <a href="?tab=calendar" class="tab-link <%= tab === 'calendar' ? 'active' : '' %>">📅 Calendar<% if (stats.scheduled) { %> (<%= stats.scheduled %>)<% } %></a>
    <a href="?tab=scheduled" class="tab-link <%= tab === 'scheduled' ? 'active' : '' %>">Posts (<%= posts.filter(p=>p.status!=='scheduled').length %>)</a>
    <a href="?tab=analytics" class="tab-link <%= tab === 'analytics' ? 'active' : '' %>">📊 Analytics</a>
    <a href="/admin/social/live" class="tab-link" style="color:#c0182f;">🔴 Live Studio</a>
    <%# DISABLED FOR RELEASE: Activity + Listening tabs (set to true to restore) %>
    <% if (false) { %>
    <a href="?tab=activity" class="tab-link <%= tab === 'activity' ? 'active' : '' %>">Activity<% if (typeof activity !== 'undefined' && activity.filter(a=>!a.handled).length) { %> (<%= activity.filter(a=>!a.handled).length %>)<% } %></a>
    <a href="?tab=listening" class="tab-link <%= tab === 'listening' ? 'active' : '' %>">Listening<% if (typeof keywords !== 'undefined' && keywords.length) { %> (<%= keywords.length %>)<% } %></a>
    <% } %>
  </div>

  <!-- Post feedback surfaces as an obvious flash toast (SlabFlash) — the house
       standard for success/failure messaging across all admin actions. -->
  <script>document.addEventListener('DOMContentLoaded',function(){try{window.SlabFlash&&SlabFlash.fromUrl();}catch(e){}});</script>

  <!-- ═══════════ COMPOSE ═══════════ -->
  <% if (tab === 'compose') { const ep = (typeof editPost !== 'undefined' && editPost) ? editPost : null;
       function dtLocal(d){ const x=new Date(d); return new Date(x - x.getTimezoneOffset()*60000).toISOString().slice(0,16); } %>
    <% if (!connectedKeys.length) { %>
    <div class="alert alert-error" style="background:rgba(201,168,72,0.08);border-color:rgba(201,168,72,0.3);color:var(--badge-accent);">
      No platforms connected yet. Add your accounts under <a href="/admin/settings#socialSettings" style="color:inherit;text-decoration:underline;">Connections</a> first.
    </div>
    <% } %>
    <form method="POST" action="/admin/social/posts" class="card" data-guard data-guard-label="Sending…">
      <% if (ep) { %><input type="hidden" name="editId" value="<%= ep._id %>"><% } %>
      <div class="card-title" style="display:flex;align-items:center;gap:10px;"><%= ep ? '✏️ Edit Post' : 'Compose Post' %><% if (ep) { %><a href="?tab=compose" class="btn btn-ghost btn-sm" style="font-size:0.64rem;margin-left:auto;">Cancel edit</a><% } %></div>

      <div class="form-field" style="margin-bottom:16px;">
        <label>Post Text</label>
        <textarea name="body" id="smBody" placeholder="What's happening?" maxlength="5000" oninput="smCount()"><%= ep ? ep.body : '' %></textarea>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px;">
          <span class="sm-counter" id="smCounter">0 chars</span>
          <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.66rem;" onclick="smAI(this)">✦ Write with AI</button>
        </div>
      </div>

      <div class="form-field" style="margin-bottom:14px;">
        <label>Link (optional)</label>
        <input type="url" name="link" placeholder="https://..." value="<%= ep && ep.link ? ep.link : '' %>">
      </div>

      <div class="form-field" style="margin-bottom:18px;">
        <label>Media <span style="text-transform:none;font-weight:400;color:var(--slate);">— images or video; required for Instagram / Pinterest</span></label>
        <div class="sm-inline-row" style="display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;">
          <input type="text" name="media" id="smMedia" placeholder="paste image/video URL(s), comma separated" oninput="smRenderMedia()" style="flex:1;min-width:0;" value="<%= ep && ep.mediaUrls ? ep.mediaUrls.join(', ') : '' %>">
          <button type="button" class="btn btn-ghost btn-sm" style="white-space:nowrap;" onclick="document.getElementById('smUploadInput').click()">⬆ Upload</button>
          <button type="button" class="btn btn-ghost btn-sm" style="white-space:nowrap;" onclick="smOpenAssets()">📁 From Assets</button>
          <a href="/admin/assets/social" target="_blank" class="btn btn-ghost btn-sm" style="white-space:nowrap;" title="Open the social graphic generator — saved images appear in 'From Assets'">✨ Generate</a>
        </div>
        <input type="file" id="smUploadInput" accept="image/png,image/jpeg,image/gif,image/webp,video/mp4,video/quicktime,video/webm" style="display:none;" onchange="smUploadFile(this)">
        <div id="smUploadStatus" style="font-size:0.72rem;color:var(--slate);margin-top:6px;display:none;"></div>
        <div id="smMediaPreview" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;"></div>
      </div>

      <div class="form-field" style="margin-bottom:18px;">
        <label>Format</label>
        <div class="sm-fmt-row" style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap;">
          <% const _fmt = (ep && ep.format) ? ep.format : 'single'; %>
          <label class="sm-pill sm-fmt <%= _fmt==='single'?'sel':'' %>" onclick="smFormat('single')"><input type="radio" name="format" value="single" <%= _fmt==='single'?'checked':'' %>><span class="sm-nm">Single post</span></label>
          <label class="sm-pill sm-fmt <%= _fmt==='carousel'?'sel':'' %>" onclick="smFormat('carousel')"><input type="radio" name="format" value="carousel" <%= _fmt==='carousel'?'checked':'' %>><span class="sm-nm">Carousel</span></label>
          <label class="sm-pill sm-fmt <%= _fmt==='story'?'sel':'' %>" onclick="smFormat('story')"><input type="radio" name="format" value="story" <%= _fmt==='story'?'checked':'' %>><span class="sm-nm">Story</span></label>
        </div>
        <div id="smFmtHint" style="font-size:0.72rem;color:var(--slate);margin-top:6px;"></div>
      </div>

      <div class="form-field" style="margin-bottom:18px;">
        <label>Post To</label>
        <div class="sm-platform-grid" style="margin-top:6px;">
          <% livePlatforms.forEach(p => { const acc = accountMap[p.key]; const ready = connectedKeys.includes(p.key); const sel = ep && (ep.platforms||[]).includes(p.key); const caps = p.caps||{}; %>
          <label class="sm-pill <%= ready ? '' : 'disabled' %> <%= sel ? 'sel' : '' %>" data-key="<%= p.key %>" data-carousel="<%= caps.carousel?1:0 %>" data-story="<%= caps.story?1:0 %>" onclick="<%= ready ? 'smToggle(this)' : '' %>">
            <input type="checkbox" name="platforms" value="<%= p.key %>" <%= ready ? '' : 'disabled' %> <%= sel ? 'checked' : '' %>>
            <span class="sm-ic"><%= p.icon %></span>
            <span>
              <span class="sm-nm"><%= p.name %></span><br>
              <span class="sm-sub"><%= ready ? 'Connected' : 'Not connected' %></span>
            </span>
          </label>
          <% }) %>
        </div>
      </div>

      <div class="form-grid" style="margin-bottom:18px;">
        <div class="form-field">
          <label>Schedule For (optional)</label>
          <input type="datetime-local" name="scheduledAt" id="smSchedAt" value="<%= ep && ep.scheduledAt ? dtLocal(ep.scheduledAt) : '' %>">
        </div>
      </div>

      <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
        <button type="submit" name="action" value="publish" class="btn btn-gold">Publish Now</button>
        <button type="submit" name="action" value="autoslot" class="btn btn-navy" title="Schedule at open calendar slots — with multiple accounts, each network is staggered to its own time so they don't all post at once">⚡ Auto-slot</button>
        <button type="submit" name="action" value="schedule" class="btn btn-navy">Schedule</button>
        <button type="submit" name="action" value="draft" class="btn btn-ghost"><%= ep ? 'Save Changes' : 'Save Draft' %></button>
      </div>
    </form>
    <% if (ep) { %><script>document.addEventListener('DOMContentLoaded',function(){try{smCount();}catch(e){}try{smRenderMedia();}catch(e){}});</script><% } %>
  <% } %>

  <!-- ═══════════ CALENDAR ═══════════ -->
  <% if (tab === 'calendar') { const cal = (typeof calendar !== 'undefined' && calendar) ? calendar : null; %>
    <style>
      .cal-head { display:flex; align-items:center; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
      .cal-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:8px; }
      .cal-dow { font-size:0.62rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--slate); text-align:center; padding:4px 0; }
      .cal-cell { min-height:122px; border:1px solid var(--border); border-radius:8px; padding:6px; background:var(--surface); display:flex; flex-direction:column; gap:5px; min-width:0; }
      .cal-cell.empty { background:transparent; border:none; }
      .cal-cell.today { border-color:var(--gold,#C9A848); box-shadow:0 0 0 1px var(--gold,#C9A848) inset; }
      .cal-daynum { font-size:0.72rem; color:var(--slate); font-weight:700; padding-left:1px; }
      /* Chip: SQUARE thumb on the LEFT (shows the real 1:1 preview) + meta on the
         right; actions revealed on hover so the cell stays readable at 7 columns. */
      .cal-chip { position:relative; display:flex; align-items:stretch; font-size:0.64rem; border:1px solid var(--border); border-radius:6px; overflow:hidden; background:var(--ivory); color:var(--on-surface); }
      .cal-thumb { width:48px; height:48px; flex-shrink:0; object-fit:cover; display:block; background:var(--surface); }
      .cal-meta { flex:1; padding:4px 6px 5px; display:flex; flex-direction:column; justify-content:center; gap:2px; min-width:0; }
      .cal-chip .t { color:var(--navy); font-weight:700; display:flex; align-items:center; gap:3px; flex-wrap:wrap; line-height:1.25; }
      .cal-body { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--slate); }
      .cal-chip .x { position:absolute; top:3px; right:3px; display:flex; gap:2px; opacity:0; transform:translateY(-2px); transition:opacity .14s, transform .14s; }
      .cal-chip:hover .x, .cal-chip:focus-within .x { opacity:1; transform:none; }
      .cal-chip form { display:inline; margin:0; }
      .cal-chip .x button { font-size:0.62rem; padding:1px 5px; border:1px solid var(--border); border-radius:4px; background:rgba(255,255,255,0.94); cursor:pointer; color:var(--on-surface); line-height:1.3; box-shadow:0 1px 2px rgba(0,0,0,0.12); }
      .cal-chip .x button:hover { border-color:var(--navy-mid); }
      .cal-chip .x a { line-height:0; }
      .cal-chip.no-thumb .x { position:static; opacity:1; transform:none; justify-content:flex-end; padding:0 6px 5px; }
      .cal-chip.no-thumb .x button { box-shadow:none; background:var(--surface); }
      /* Cal — wrap nav row on small screens */
      @media (max-width:820px) {
        .cal-head { gap:8px; }
        .cal-head > span[style*="margin-left:auto"] { margin-left:0 !important; width:100%; }
        .cal-cell { min-height:104px; }
        .cal-thumb { width:40px; height:40px; }
      }
      /* Phone: reflow the 7-col grid into a vertical agenda showing ONLY the days
         that have scheduled posts — far more usable than a cramped mini-grid.
         Uses :has() to hide empty days (widely supported on modern mobile). */
      @media (max-width:680px) {
        .cal-grid { display:block; grid-template-columns:none; overflow:visible; width:100%; }
        .cal-dow { display:none; }
        .cal-cell { min-width:0; min-height:0; margin-bottom:10px; padding:10px 12px; }
        .cal-cell.empty { display:none; }
        .cal-cell:not(:has(.cal-chip)) { display:none; }
        .cal-cell.today { box-shadow:0 0 0 2px var(--gold,#C9A848) inset; }
        .cal-daynum { font-size:0.9rem; color:var(--navy); font-weight:700; margin-bottom:2px; }
        /* Phone chip: image 1fr | description 1fr (square image, text fills its half) */
        .cal-chip { display:grid; grid-template-columns:1fr 1fr; align-items:stretch; font-size:0.86rem; margin-top:6px; }
        .cal-chip.no-thumb { grid-template-columns:1fr; }
        .cal-meta { padding:10px 12px; gap:5px; justify-content:center; }
        .cal-chip .t { font-size:0.86rem; }
        .cal-body { white-space:normal; }
        .cal-thumb { width:100%; height:100%; aspect-ratio:1/1; }
        /* Actions become an always-visible, evenly-split control pad below the post. */
        .cal-chip .x, .cal-chip.no-thumb .x {
          position:static; opacity:1; transform:none; display:flex; gap:8px;
          padding:0 10px 11px; margin-top:2px;
        }
        .cal-chip .x > a, .cal-chip .x form { flex:1; margin:0; }
        .cal-chip .x button {
          width:100%; min-height:44px; font-size:1rem; padding:8px 0; box-shadow:none;
          background:var(--surface); display:flex; align-items:center; justify-content:center;
        }
      }
    </style>
    <div class="cal-head">
      <a href="?tab=calendar&month=<%= cal ? cal.prev : '' %>" class="btn btn-ghost btn-sm">← Prev</a>
      <strong style="font-size:1rem;"><%= cal ? cal.label : '' %></strong>
      <a href="?tab=calendar&month=<%= cal ? cal.next : '' %>" class="btn btn-ghost btn-sm">Next →</a>
      <span style="margin-left:auto;font-size:0.74rem;color:var(--slate);"><%= cal ? cal.count : 0 %> scheduled this month</span>
    </div>

    <% if (cal && cal.gridLock && cal.gridLock.active) { %>
      <div id="gridLockBanner" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px;padding:10px 14px;border:1px solid var(--gold,#C9A848);border-radius:8px;background:rgba(201,168,72,0.10);">
        <span style="font-size:1.1rem;">🧩</span>
        <div style="flex:1;min-width:200px;font-size:0.75rem;line-height:1.45;color:var(--on-surface);">
          <strong>Grid-lock ON</strong> — protecting your mural's alignment. Instagram feed posts are held and released in rows of <%= cal.gridLock.rowSize %>.
          <% if (cal.gridLock.held > 0) { %>
            <br><b><%= cal.gridLock.held %></b> post<%= cal.gridLock.held === 1 ? '' : 's' %> sandbagged
            <% if (cal.gridLock.needed > 0) { %>— <b><%= cal.gridLock.needed %> more</b> to complete the next row.<% } else { %>— a full row is ready and will publish next cycle.<% } %>
          <% } else { %>
            <br>No posts held yet. Instagram singles will wait here until 3 are ready.
          <% } %>
        </div>
        <button type="button" id="gridLockOffBtn" class="btn btn-ghost btn-sm" title="Stop protecting the mural — releases any held posts to publish normally">Turn off protection</button>
      </div>
      <script>
        document.getElementById('gridLockOffBtn')?.addEventListener('click', async (e) => {
          if (!confirm('Turn off grid-lock? Any sandbagged posts will publish on their next cycle, which may shift your mural out of alignment.')) return;
          e.currentTarget.disabled = true;
          try {
            const r = await fetch('/admin/social/grid-lock', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ active:false }) });
            const d = await r.json();
            if (d.ok) location.reload(); else { alert(d.error||'Failed'); e.currentTarget.disabled = false; }
          } catch (err) { alert(err.message); e.currentTarget.disabled = false; }
        });
      </script>
    <% } %>

    <div class="cal-grid">
      <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function(d){ %><div class="cal-dow"><%= d %></div><% }); %>
      <% (cal ? cal.weeks : []).forEach(function(week){ week.forEach(function(cell){ %>
        <% if (!cell) { %><div class="cal-cell empty"></div><% } else { %>
          <div class="cal-cell <%= cal.todayDay === cell.day ? 'today' : '' %>">
            <span class="cal-daynum"><%= cell.day %></span>
            <% cell.posts.forEach(function(p){ const t = new Date(p.scheduledAt).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}); const thumb = (p.mediaUrls||[]).find(function(u){ return /\.(png|jpe?g|gif|webp)(\?|#|$)/i.test(u); }); %>
              <% if (p.isMuralGroup) { %>
                <div class="cal-chip <%= thumb ? '' : 'no-thumb' %>" style="border-color:var(--gold,#C9A848);" title="9-grid mural — <%= p.muralPublished %>/<%= p.muralTotal %> tiles published">
                  <% if (thumb) { %><img class="cal-thumb" src="<%= thumb %>" alt="" loading="lazy"><% } %>
                  <div class="cal-meta">
                    <span class="t">🧩 Mural <span style="font-weight:600;color:var(--slate);">(<%= p.muralTotal %> tiles)</span></span>
                    <span class="cal-body"><%= p.muralPublished %>/<%= p.muralTotal %> published · from <%= t %></span>
                  </div>
                  <span class="x">
                    <form data-guard="button" method="POST" action="/admin/social/mural/<%= p.muralId %>/archive" onsubmit="return confirm('Cancel this whole mural? Scheduled tiles won’t publish (already-live tiles stay up).')"><button title="Cancel mural">🗄</button></form>
                  </span>
                </div>
              <% } else { %>
                <div class="cal-chip <%= thumb ? '' : 'no-thumb' %>" title="<%= t %> — <%= (p.body||'(media)').replace(/"/g,'&quot;') %>">
                  <% if (thumb) { %><img class="cal-thumb" src="<%= thumb %>" alt="" loading="lazy"><% } %>
                  <div class="cal-meta">
                    <span class="t"><%= t %> <% (p.platforms||[]).forEach(function(k){ const d=platforms.find(x=>x.key===k); %><%= d?d.icon:k %><% }); %></span>
                    <span class="cal-body"><%= (p.body||'(media)').slice(0,40) %></span>
                  </div>
                  <span class="x">
                    <a href="?tab=compose&edit=<%= p._id %>" title="Edit" style="text-decoration:none;"><button type="button" title="Edit">✏️</button></a>
                    <form data-guard="button" method="POST" action="/admin/social/posts/<%= p._id %>/publish" onsubmit="return confirm('Publish this now instead of waiting?')"><button title="Publish now">▶</button></form>
                    <form data-guard="button" method="POST" action="/admin/social/posts/<%= p._id %>/delete" onsubmit="return confirm('Archive this scheduled post? It will not publish.')"><button title="Archive">🗄</button></form>
                  </span>
                </div>
              <% } %>
            <% }); %>
          </div>
        <% } %>
      <% }); }); %>
    </div>
    <% if (cal && !cal.count) { %><div style="margin-top:12px;font-size:0.8rem;color:var(--slate);">Nothing scheduled this month. Schedule posts from <a href="?tab=agents">Agent Studio</a> or <a href="?tab=compose">Compose</a>.</div><% } %>
  <% } %>

  <!-- ═══════════ SCHEDULED / POSTS ═══════════ -->
  <% if (tab === 'scheduled') {
       const archivedView = (typeof postsView !== 'undefined' && postsView === 'archived');
       const rows = archivedView ? (archivedPosts || []) : posts.filter(p => p.status !== 'scheduled');
       const archN = (typeof archivedCount !== 'undefined' ? archivedCount : 0);
  %>
    <div class="sm-subtabs" style="display:flex;gap:6px;margin-bottom:14px;">
      <a href="?tab=scheduled" class="btn btn-sm <%= archivedView ? 'btn-ghost' : 'btn-navy' %>" style="font-size:0.72rem;">Active (<%= posts.length %>)</a>
      <a href="?tab=scheduled&view=archived" class="btn btn-sm <%= archivedView ? 'btn-navy' : 'btn-ghost' %>" style="font-size:0.72rem;">🗄️ Archived (<%= archN %>)</a>
    </div>
    <% if (!rows.length) { %>
    <div class="card empty"><div class="empty-icon"><%= archivedView ? '🗄️' : '📣' %></div><p><% if (archivedView) { %>No archived posts. Archiving a post from the Active list keeps it here for the record without deleting it.<% } else { %>No posts yet. Head to <a href="?tab=compose">Compose</a> to create one.<% } %></p></div>
    <% } else { %>
    <div class="table-wrap sm-posts-table">
      <table>
        <thead><tr><th>Status</th><th>Platforms</th><th>When</th><th>Content</th><th>Results</th><th></th></tr></thead>
        <tbody>
        <% rows.forEach(p => {
            const badge = { draft:'badge-draft', scheduled:'badge-prospect', published:'badge-active', failed:'badge-inactive', partial:'badge-featured', publishing:'badge-prospect' }[p.status] || 'badge-draft';
            const when = p.status === 'scheduled' ? p.scheduledAt : (p.publishedAt || p.createdAt);
        %>
          <% if (p.isMuralGroup) { const mthumb = (p.mediaUrls||[]).find(u=>/\.(png|jpe?g|gif|webp)(\?|#|$)/i.test(u)); %>
          <tr style="background:rgba(201,168,72,0.06);">
            <td><span class="badge <%= badge %>"><%= p.status %></span></td>
            <td><span title="Instagram" style="font-size:1.1rem;">📸</span></td>
            <td style="font-size:0.78rem;white-space:nowrap;"><%= when ? new Date(when).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %></td>
            <td style="max-width:280px;">
              <div style="display:flex;align-items:center;gap:8px;">
                <% if (mthumb) { %><img src="<%= mthumb %>" alt="" style="width:34px;height:34px;border-radius:5px;object-fit:cover;flex-shrink:0;"><% } %>
                <div style="font-size:0.82rem;font-weight:700;">🧩 9-Grid Mural</div>
              </div>
            </td>
            <td style="max-width:200px;font-size:0.76rem;color:var(--slate);"><b style="color:var(--on-surface);"><%= p.muralPublished %>/<%= p.muralTotal %></b> tiles published</td>
            <td style="white-space:nowrap;">
              <% if (p.status !== 'published') { %>
                <form data-guard="button" method="POST" action="/admin/social/mural/<%= p.muralId %>/archive" style="display:inline;" onsubmit="return confirm('Cancel this whole mural? Scheduled tiles won’t publish (already-live tiles stay up).')"><button class="btn btn-ghost btn-sm" style="font-size:0.66rem;">Cancel mural</button></form>
              <% } else { %><span style="font-size:0.7rem;color:var(--slate);">live on grid</span><% } %>
            </td>
          </tr>
          <% } else { %>
          <tr<%= archivedView ? ' style="opacity:.72;"' : '' %>>
            <td><span class="badge <%= badge %>"><%= p.status %></span></td>
            <td><% (p.platforms||[]).forEach(k => { const d = platforms.find(x=>x.key===k); %><span title="<%= d?d.name:k %>" style="font-size:1.1rem;margin-right:3px;"><%= d?d.icon:k %></span><% }) %></td>
            <td style="font-size:0.78rem;white-space:nowrap;"><%= when ? new Date(when).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %></td>
            <td style="max-width:280px;"><div style="font-size:0.82rem;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;"><%= p.body || '(media only)' %></div><% if (p.link) { %><div style="font-size:0.68rem;color:var(--gold);">🔗 <%= p.link %></div><% } %></td>
            <td style="max-width:200px;">
              <% (p.results||[]).forEach(r => { const d = platforms.find(x=>x.key===r.platform); %>
                <% if (r.ok) { %><% if (r.url) { %><a class="sm-res ok" href="<%= r.url %>" target="_blank" rel="noopener noreferrer" title="Open on <%= d?d.name:r.platform %>" style="text-decoration:none;">✓ <%= d?d.name:r.platform %> ↗</a><% } else { %><span class="sm-res ok">✓ <%= d?d.name:r.platform %></span><% } %><% } else { %>
                  <div class="sm-res fail" style="display:block;margin-bottom:4px;">✕ <%= d?d.name:r.platform %></div>
                  <% if (r.error) { %><div style="font-size:0.66rem;color:#c0392b;line-height:1.3;word-break:break-word;white-space:normal;"><%= r.error %></div><% } %>
                <% } %>
              <% }) %>
            </td>
            <td style="white-space:nowrap;">
              <% const firstUrl = (p.results||[]).find(r => r.ok && r.url); %>
              <% if (firstUrl) { %><a href="<%= firstUrl.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-navy btn-sm" style="font-size:0.66rem;">View ↗</a><% } %>
              <% if (archivedView) { %>
                <form data-guard="button" method="POST" action="/admin/social/posts/<%= p._id %>/unarchive" style="display:inline;"><button class="btn btn-gold btn-sm" style="font-size:0.66rem;">↩ Restore</button></form>
                <form data-guard="button" method="POST" action="/admin/social/posts/<%= p._id %>/destroy" style="display:inline;" onsubmit="return confirm('Permanently delete this post? This cannot be undone.')"><button class="btn btn-danger btn-sm" style="font-size:0.66rem;">Delete forever</button></form>
              <% } else { %>
                <a href="?tab=compose&edit=<%= p._id %>" class="btn btn-ghost btn-sm" style="font-size:0.66rem;">✏️ Edit</a>
                <% if (p.status !== 'published') { %>
                <form data-guard="button" method="POST" action="/admin/social/posts/<%= p._id %>/publish" style="display:inline;"><button class="btn btn-gold btn-sm" style="font-size:0.66rem;">Publish</button></form>
                <% } %>
                <form data-guard="button" method="POST" action="/admin/social/posts/<%= p._id %>/delete" style="display:inline;" onsubmit="return confirm('Archive this post? It stays in Archived for the record — not deleted.')"><button class="btn btn-ghost btn-sm" style="font-size:0.66rem;">Archive</button></form>
              <% } %>
            </td>
          </tr>
          <% } %>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } %>

  <!-- ═══════════ ENGAGE ═══════════ -->
  <!-- ═══════════ ANALYTICS ═══════════ -->
  <% if (tab === 'analytics') { %>
    <%- include('_analytics') %>
  <% } %>

  <!-- ═══════════ CONNECTIONS ═══════════ -->
  <!-- ═══════════ AGENT STUDIO ═══════════ -->
  <% if (tab === 'agents') { %>
    <%- include('_agents') %>
  <% } %>


  <!-- ═══════════ ACTIVITY (DISABLED FOR RELEASE) ═══════════ -->
  <% if (false && tab === 'activity') { %>
    <%- include('_activity') %>
  <% } %>

  <!-- ═══════════ LISTENING (DISABLED FOR RELEASE) ═══════════ -->
  <% if (false && tab === 'listening') { %>
    <%- include('_listening') %>
  <% } %>
</div></div>

<!-- Asset picker modal -->
<div id="smAssetModal" class="sm-modal" style="display:none;">
  <div class="sm-modal-box">
    <div class="sm-modal-head">
      <span>Select Images from Assets</span>
      <button type="button" class="btn btn-navy btn-sm" onclick="smCloseAssets()">Done</button>
    </div>
    <input type="text" id="smAssetSearch" placeholder="Search assets…" oninput="smFilterAssets()" style="margin:10px 0;width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:4px;">
    <div id="smAssetGrid" class="sm-asset-grid"></div>
  </div>
</div>

<script>
// ── Media / asset picker ──────────────────────────────────────────────────────
function smMediaUrls() {
  const el = document.getElementById('smMedia');
  return el ? el.value.split(/[\n,]+/).map(s => s.trim()).filter(Boolean) : [];
}
function smSetMedia(urls) {
  document.getElementById('smMedia').value = urls.join(', ');
  smRenderMedia();
}
function smRenderMedia() {
  const wrap = document.getElementById('smMediaPreview');
  if (!wrap) return;
  const urls = smMediaUrls();
  wrap.innerHTML = '';
  urls.forEach(u => {
    const d = document.createElement('div'); d.className = 'sm-thumb';
    const isVid = /\.(mp4|mov|webm|m4v)(\?|$)/i.test(u);
    const media = isVid ? `<video src="${u}" muted playsinline></video>` : `<img src="${u}" alt="">`;
    d.innerHTML = `${media}<button type="button" title="remove">×</button>`;
    d.querySelector('button').onclick = () => smSetMedia(smMediaUrls().filter(x => x !== u));
    wrap.appendChild(d);
  });
  document.querySelectorAll('.sm-asset').forEach(c => c.classList.toggle('sel', urls.includes(c.dataset.url)));
}
async function smUploadFile(input) {
  const file = input.files && input.files[0];
  if (!file) return;
  const status = document.getElementById('smUploadStatus');
  status.style.display = 'block';
  status.style.color = 'var(--slate)';
  status.textContent = `Uploading ${file.name} (${(file.size / 1048576).toFixed(1)} MB)…`;
  try {
    const fd = new FormData();
    fd.append('file', file);
    const r = await fetch('/admin/social/upload', { method: 'POST', body: fd });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'Upload failed');
    smSetMedia([...smMediaUrls(), d.url]);
    status.textContent = `✓ ${d.type === 'video' ? 'Video' : 'Image'} uploaded`;
    status.style.color = 'var(--gold)';
  } catch (e) {
    status.textContent = '⚠ ' + e.message;
    status.style.color = 'var(--danger)';
  } finally {
    input.value = '';
  }
}
let _smAssets = [];
async function smOpenAssets() {
  document.getElementById('smAssetModal').style.display = 'flex';
  const grid = document.getElementById('smAssetGrid');
  grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--slate);padding:20px;">Loading…</div>';
  try {
    const r = await fetch('/admin/assets/list?limit=200');
    const d = await r.json();
    _smAssets = (d.assets || []).filter(a => {
      const u = a.publicUrl || a.url; if (!u) return false;
      const t = (a.fileType || a.mimeType || '') + ' ' + u;
      return /image|\.(png|jpe?g|gif|webp|svg)(\?|$)/i.test(t);
    });
    smRenderAssets(_smAssets);
  } catch (e) {
    grid.innerHTML = '<div style="grid-column:1/-1;color:var(--danger);padding:20px;">Failed to load assets.</div>';
  }
}
function smRenderAssets(list) {
  const grid = document.getElementById('smAssetGrid');
  const sel = smMediaUrls();
  if (!list.length) { grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--slate);padding:20px;">No image assets found. Upload some in <a href="/admin/assets">Assets</a>.</div>'; return; }
  grid.innerHTML = '';
  list.forEach(a => {
    const u = a.publicUrl || a.url;
    const c = document.createElement('div');
    c.className = 'sm-asset' + (sel.includes(u) ? ' sel' : '');
    c.dataset.url = u;
    c.innerHTML = `<img src="${u}" alt="" loading="lazy"><div class="nm">${a.title || a.originalName || ''}</div>`;
    c.onclick = () => {
      const cur = smMediaUrls();
      smSetMedia(cur.includes(u) ? cur.filter(x => x !== u) : [...cur, u]);
    };
    grid.appendChild(c);
  });
}
function smFilterAssets() {
  const q = document.getElementById('smAssetSearch').value.toLowerCase();
  smRenderAssets(_smAssets.filter(a => ((a.title || a.originalName || '') + '').toLowerCase().includes(q)));
}
function smCloseAssets() { document.getElementById('smAssetModal').style.display = 'none'; }
document.getElementById('smAssetModal')?.addEventListener('click', function (e) { if (e.target === this) smCloseAssets(); });
document.addEventListener('DOMContentLoaded', smRenderMedia);

function smCount() {
  const b = document.getElementById('smBody');
  const c = document.getElementById('smCounter');
  const n = b.value.length;
  c.textContent = n + ' chars' + (n > 280 ? ' — over X limit (280)' : '');
  c.classList.toggle('over', n > 280);
}
function smToggle(el) {
  const cb = el.querySelector('input');
  // checkbox toggles natively via label; sync the selected style next tick
  setTimeout(() => el.classList.toggle('sel', cb.checked), 0);
}
// Switch post format: single | carousel | story. Carousel/story are only offered
// to platforms whose caps allow them — ineligible pills are disabled + deselected.
function smFormat(fmt) {
  document.querySelectorAll('.sm-fmt').forEach(l => {
    const on = l.querySelector('input').value === fmt;
    l.classList.toggle('sel', on);
    l.querySelector('input').checked = on;
  });
  const hints = {
    single: '',
    carousel: 'Carousel: 2–10 images/videos in order. Instagram & Threads only.',
    story: 'Story: each media item posts as a 24h story frame, in order. Instagram only.',
  };
  const h = document.getElementById('smFmtHint'); if (h) h.textContent = hints[fmt] || '';
  document.querySelectorAll('.sm-pill[data-key]').forEach(pill => {
    const eligible = fmt === 'single' || pill.dataset[fmt] === '1';
    // Remember the original connected state once, so toggling format back restores it.
    if (pill.dataset.connReady === undefined) pill.dataset.connReady = pill.classList.contains('disabled') ? '0' : '1';
    const cb = pill.querySelector('input');
    if (!eligible) {
      cb.checked = false; pill.classList.remove('sel');
      pill.classList.add('disabled'); pill.style.opacity = '0.35'; pill.style.pointerEvents = 'none';
    } else if (pill.dataset.connReady === '1') {
      pill.classList.remove('disabled'); pill.style.opacity = ''; pill.style.pointerEvents = '';
    }
  });
}
document.addEventListener('DOMContentLoaded', function () {
  const f = document.querySelector('input[name="format"]:checked');
  if (f) smFormat(f.value);
});
async function smAI(btn) {
  const body = document.getElementById('smBody');
  const platforms = [...document.querySelectorAll('input[name="platforms"]:checked')].map(c => c.value);
  const prompt = window.prompt('What should this post be about?', body.value || '');
  if (prompt === null) return;
  if (btn) SlabLoader.button(btn, true, 'Writing…');
  body.value = '…writing…';
  try {
    const r = await fetch('/admin/social/agent', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt, platforms }),
    });
    const d = await r.json();
    if (d.fill) {
      body.value = d.fill.body || '';
      const linkIn = document.querySelector('input[name="link"]');
      if (d.fill.link && linkIn && !linkIn.value) linkIn.value = d.fill.link;
      smCount();
    } else { body.value = ''; SlabFlash.error(d.error || 'AI could not write a post'); }
  } catch (e) { body.value = ''; SlabFlash.error('AI request failed'); }
  finally { if (btn) SlabLoader.button(btn, false); }
}
async function smTest(key, btn) {
  const out = document.getElementById('smtest-' + key);
  btn.disabled = true; btn.textContent = 'Testing…';
  try {
    const r = await fetch('/admin/social/connections/' + key + '/test', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const d = await r.json();
    if (out) { out.textContent = d.ok ? '✓ ' + (d.note || 'OK') : '✕ ' + (d.error || 'Failed'); out.style.color = d.ok ? 'var(--success)' : 'var(--danger)'; }
  } catch (e) { if (out) { out.textContent = '✕ Request failed'; out.style.color = 'var(--danger)'; } }
  btn.disabled = false; btn.textContent = 'Test';
}

// ── Meta: link Instagram from the connected Facebook Page ─────────────────────
async function smLinkInstagram(btn) {
  const msg = btn.parentElement.querySelector('.sm-iglink-msg');
  const setMsg = (t, ok) => { if (msg) { msg.textContent = t; msg.style.color = ok ? 'var(--success)' : 'var(--danger)'; } };
  btn.disabled = true; const label = btn.textContent; btn.textContent = 'Linking…';
  try {
    const r = await fetch('/admin/social/connections/meta/link-instagram', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const d = await r.json();
    if (d.ok) {
      setMsg('✓ Linked' + (d.username ? ' @' + d.username : '') + (d.seededToken ? ' (token from Page)' : ''), true);
      setTimeout(() => location.reload(), 900);
    } else { setMsg('✕ ' + (d.error || 'Failed'), false); }
  } catch (e) { setMsg('✕ Request failed', false); }
  btn.disabled = false; btn.textContent = label;
}

// ── LinkedIn Author URN builder ──────────────────────────────────────────────
// Works in both the Social portal (name=) and admin Settings (data-field=).
function liCard(btn) { return btn.closest('.sm-conn-card') || btn.closest('.social-item'); }
function liField(card, key) { return card.querySelector('[name="' + key + '"], [data-field="' + key + '"]'); }
function liBuildUrn(btn) {
  const card = liCard(btn), msg = card.querySelector('.li-urn-msg');
  const type = card.querySelector('.li-type').value;
  const id = card.querySelector('.li-id').value.trim().replace(/^urn:li:[a-z]+:/i, '');
  if (!id) { msg.textContent = 'Enter the numeric id first.'; msg.style.color = 'var(--danger)'; return; }
  const urn = 'urn:li:' + type + ':' + id;
  const f = liField(card, 'authorUrn'); if (f) f.value = urn;
  msg.innerHTML = 'Built <code>' + urn + '</code> — filled the Author URN field. Save to persist.';
  msg.style.color = 'var(--success)';
}
async function liFetchUrn(btn) {
  const card = liCard(btn), msg = card.querySelector('.li-urn-msg');
  const tf = liField(card, 'accessToken');
  const token = (tf && tf.value && !tf.value.startsWith('••••')) ? tf.value.trim() : '';
  btn.disabled = true; msg.textContent = 'Fetching from token…'; msg.style.color = 'var(--slate)';
  try {
    const r = await fetch('/admin/social/linkedin/urn', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accessToken: token }) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = '✕ ' + (j.error || 'Failed'); msg.style.color = 'var(--danger)'; }
    else {
      const f = liField(card, 'authorUrn'); if (f) f.value = j.urn;
      card.querySelector('.li-type').value = 'person';
      card.querySelector('.li-id').value = j.sub || '';
      msg.innerHTML = '✓ ' + (j.name ? 'Signed in as <b>' + j.name + '</b> — ' : '') + 'filled <code>' + j.urn + '</code>. Save to persist.';
      msg.style.color = 'var(--success)';
    }
  } catch (e) { msg.textContent = '✕ Request failed'; msg.style.color = 'var(--danger)'; }
  btn.disabled = false;
}
async function liIntrospect(btn) {
  const card = liCard(btn), msg = card.querySelector('.li-urn-msg');
  const tok = liField(card, 'accessToken'), cid = liField(card, 'clientId'), csec = liField(card, 'clientSecret');
  const payload = {
    accessToken: (tok && tok.value && !tok.value.startsWith('••••')) ? tok.value.trim() : '',
    clientId: cid ? cid.value.trim() : '',
    clientSecret: (csec && csec.value && !csec.value.startsWith('••••')) ? csec.value.trim() : '',
  };
  btn.disabled = true; msg.textContent = 'Reading token scopes…'; msg.style.color = 'var(--slate)';
  try {
    const r = await fetch('/admin/social/linkedin/introspect', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = '✕ ' + (j.error || 'Failed'); msg.style.color = 'var(--danger)'; }
    else {
      const list = (j.scope || '').split(/[ ,]+/).filter(Boolean);
      const hasProfile = list.includes('openid') && list.includes('profile');
      msg.innerHTML = (j.active ? '✓' : '✕') + ' status <b>' + j.status + '</b> · scopes: <code>' + (j.scope || '(none)') + '</code><br>'
        + (hasProfile ? '<b>openid + profile present</b> — Fetch from token will work.' : '<b>Missing openid/profile</b> — this token can\'t read your id. Regenerate with those scopes ticked.');
      msg.style.color = j.active ? 'var(--success)' : 'var(--danger)';
    }
  } catch (e) { msg.textContent = '✕ Request failed'; msg.style.color = 'var(--danger)'; }
  btn.disabled = false;
}

// ── Engage tab ───────────────────────────────────────────────────────────────
function smEngEsc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
function smEngDate(s) { if (!s) return ''; const t = new Date(s); return isNaN(t) ? '' : t.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }

function smEngReplyBar(platform, targetId, kind) {
  return '<div class="sm-eng-replybar">'
    + '<input type="text" placeholder="Write a reply…" data-target="' + smEngEsc(targetId) + '" data-kind="' + kind + '">'
    + '<button type="button" class="btn btn-navy btn-sm" onclick="smEngReply(this,\'' + platform + '\')">Reply</button>'
    + '</div>';
}

function smEngRenderPost(platform, card, p) {
  const canReplyComment = card.dataset.replyComment === '1';
  const canReplyPost = card.dataset.replyPost === '1';
  let html = '<div class="sm-eng-post">';
  if (p.thumb) html += '<img class="sm-eng-thumb" src="' + smEngEsc(p.thumb) + '" alt="" loading="lazy">';
  html += '<div class="sm-eng-body">';
  if (p.text) html += '<div class="sm-eng-text">' + smEngEsc(p.text) + '</div>';
  html += '<div class="sm-eng-meta">';
  (p.metrics || []).forEach(m => { html += '<span class="sm-eng-metric"><b>' + smEngEsc(m.value) + '</b> ' + smEngEsc(m.label) + '</span>'; });
  if (p.createdAt) html += '<span class="sm-eng-date">' + smEngDate(p.createdAt) + '</span>';
  if (p.url) html += '<a class="sm-eng-link" href="' + smEngEsc(p.url) + '" target="_blank" rel="noopener">View ↗</a>';
  html += '</div>';
  if (canReplyPost) html += smEngReplyBar(platform, p.id, 'post');
  const comments = p.comments || [];
  if (comments.length) {
    html += '<div class="sm-eng-comments">';
    comments.forEach(c => {
      html += '<div class="sm-eng-comment">'
        + '<span class="who">' + smEngEsc(c.from) + '</span>'
        + (c.createdAt ? '<span class="when">' + smEngDate(c.createdAt) + '</span>' : '')
        + '<div>' + smEngEsc(c.text) + '</div>'
        + (canReplyComment ? smEngReplyBar(platform, c.id, 'comment') : '')
        + '</div>';
    });
    html += '</div>';
  }
  html += '</div></div>';
  return html;
}

async function smEngLoad(platform) {
  const card = document.querySelector('.sm-eng-card[data-platform="' + platform + '"]');
  if (!card) return;
  const feed = document.getElementById('smEngFeed-' + platform);
  feed.innerHTML = '<div class="sm-eng-loading" style="font-size:0.8rem;color:var(--slate);padding:12px;">Loading recent posts…</div>';
  try {
    const r = await fetch('/admin/social/engage/' + platform + '?json=1');
    const d = await r.json();
    if (!d.ok) { feed.innerHTML = '<div class="sm-eng-err">✕ ' + smEngEsc(d.error || 'Could not load feed') + '</div>'; return; }
    if (!d.posts || !d.posts.length) { feed.innerHTML = '<div class="sm-eng-empty">No recent posts found.</div>'; return; }
    feed.innerHTML = d.posts.map(p => smEngRenderPost(platform, card, p)).join('');
  } catch (e) {
    feed.innerHTML = '<div class="sm-eng-err">✕ Request failed</div>';
  }
}

async function smEngReply(btn, platform) {
  const input = btn.previousElementSibling;
  const text = (input.value || '').trim();
  if (!text) { input.focus(); return; }
  btn.disabled = true; btn.textContent = '…';
  try {
    const r = await fetch('/admin/social/engage/' + platform + '/reply', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ targetId: input.dataset.target, kind: input.dataset.kind, text }),
    });
    const d = await r.json();
    if (d.ok) {
      const bar = btn.parentElement;
      bar.innerHTML = '<span style="font-size:0.72rem;color:var(--success);">✓ Reply posted</span>';
    } else {
      btn.disabled = false; btn.textContent = 'Reply';
      alert(d.error || 'Reply failed');
    }
  } catch (e) {
    btn.disabled = false; btn.textContent = 'Reply';
    alert('Reply request failed');
  }
}

// Auto-load every engage card when the tab is shown.
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.sm-eng-card[data-platform]').forEach(c => smEngLoad(c.dataset.platform));
});

// Prefill the composer when arriving from a Share-modal "Cross-post" deep link
// (/admin/social?tab=compose&prefillBody=…&prefillLink=…).
document.addEventListener('DOMContentLoaded', function () {
  var qp = new URLSearchParams(window.location.search);
  var body = qp.get('prefillBody'); var link = qp.get('prefillLink'); var media = qp.get('prefillMedia');
  if (!body && !link && !media) return;
  var bodyEl = document.getElementById('smBody');
  var linkEl = document.querySelector('input[name="link"]');
  var mediaEl = document.getElementById('smMedia');
  if (body && bodyEl && !bodyEl.value) { bodyEl.value = body; if (typeof smCount === 'function') smCount(); }
  if (link && linkEl && !linkEl.value) { linkEl.value = link; }
  if (media && mediaEl && !mediaEl.value) { mediaEl.value = media; if (typeof smRenderMedia === 'function') smRenderMedia(); }
  if (bodyEl) { bodyEl.focus(); }
});
</script>
</body>
</html>
