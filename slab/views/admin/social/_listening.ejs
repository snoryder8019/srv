<style>
  .lst-grid { display:grid; grid-template-columns: 320px 1fr; gap:18px; align-items:start; }
  @media (max-width:820px){
    .lst-grid { grid-template-columns:1fr; }
    /* Digest header row wraps */
    div[style*="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap"] { flex-wrap:wrap; }
    /* "Go to Suggestions" link drops to its own row */
    .lst-grid + div a.btn-ghost { margin-left:0 !important; }
    /* Digest note header: stack add-note input and button */
    .lst-card div[style*="display:flex;gap:6px"] { flex-wrap:wrap; }
    .lst-card div[style*="display:flex;gap:6px"] > div { width:100%; }
  }
  @media (max-width:520px){
    /* Listening panel: tighter padding */
    .lst-card { padding:10px; }
    /* Keyword row: name + src + delete on single row, truncate name */
    .lst-kw .kw-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    /* Source checkboxes row: wrap if needed */
    .lst-srcrow { flex-wrap:wrap; gap:6px; }
    /* Add listener button: full width */
    .lst-card .btn[onclick*="lstAddKeyword"] { width:100%; }
    /* Digest top row: keyword badge + date/delete wrap */
    .dg-top { flex-wrap:wrap; gap:4px; }
    .dg-when { margin-left:0; }
    /* Digest title link: break long URLs */
    .dg-title a { word-break:break-all; }
  }
  .lst-card { border:1px solid var(--border); border-radius:8px; padding:14px; background:var(--surface); }
  .lst-kw { display:flex; align-items:center; gap:8px; padding:7px 10px; border:1px solid var(--border); border-radius:6px; margin-bottom:6px; font-size:0.82rem; }
  .lst-kw .kw-name { flex:1; font-weight:600; color:var(--on-surface); }
  .lst-kw .kw-src { font-size:0.58rem; color:var(--slate); text-transform:uppercase; letter-spacing:0.06em; }
  .lst-kw .kw-del { color:var(--slate); cursor:pointer; }
  .lst-kw .kw-del:hover { color:#c0392b; }
  .dg-item { border:1px solid var(--border); border-radius:6px; padding:10px 12px; margin-bottom:8px; background:var(--surface); }
  .dg-top { display:flex; align-items:center; gap:8px; margin-bottom:3px; flex-wrap:wrap; }
  .dg-src { font-size:0.55rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; padding:2px 7px; border-radius:10px; }
  .dg-web { background:#e7f0fb; color:#1c4f8a; } .dg-reddit { background:#fde8e1; color:#a8431b; } .dg-note { background:#eee9f7; color:#5b3a9c; }
  .dg-kw { font-size:0.6rem; color:var(--slate); }
  .dg-when { font-size:0.58rem; color:var(--slate); margin-left:auto; }
  .dg-title { font-size:0.84rem; font-weight:600; color:var(--on-surface); }
  .dg-title a { color:var(--navy); text-decoration:none; } .dg-title a:hover { text-decoration:underline; }
  .dg-snip { font-size:0.74rem; color:var(--slate); line-height:1.4; margin-top:2px; }
  .dg-meta { font-size:0.58rem; color:var(--slate); margin-top:3px; }
  .lst-input { width:100%; padding:7px 9px; border:1.5px solid var(--border); border-radius:5px; font-family:'Jost',sans-serif; font-size:0.82rem; }
  .lst-srcrow { display:flex; gap:10px; margin:6px 0; font-size:0.72rem; color:var(--on-surface); }
</style>

<div class="lst-grid">
  <div>
    <div class="lst-card" style="margin-bottom:14px;">
      <h3 style="margin:0 0 8px;font-family:'Cormorant Garamond',serif;font-size:1.25rem;">Keyword Listeners</h3>
      <p style="font-size:0.72rem;color:var(--slate);margin:0 0 10px;">Watch topics across the web and Reddit. Findings collect in the digest your suggestion agent can pull from.</p>
      <input type="text" class="lst-input" id="kwInput" placeholder="e.g. AI infrastructure, local SEO, sovereign AI">
      <div class="lst-srcrow">
        <label><input type="checkbox" id="srcWeb" checked> Web</label>
        <label><input type="checkbox" id="srcReddit" checked> Reddit</label>
      </div>
      <button class="btn btn-navy btn-sm" style="width:100%;" onclick="lstAddKeyword(this)">+ Add listener</button>
    </div>
    <div class="lst-card">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
        <strong style="font-size:0.74rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--slate);">Watching</strong>
        <button class="btn btn-gold btn-sm" style="margin-left:auto;" onclick="lstRunAll(this)">&#8635; Refresh all</button>
      </div>
      <% if (!keywords || !keywords.length) { %>
        <div style="font-size:0.72rem;color:var(--slate);">No listeners yet. Add a keyword above.</div>
      <% } else { %>
        <% keywords.forEach(k => { %>
          <div class="lst-kw" id="kw-<%= k._id %>">
            <span class="kw-name"><%= k.keyword %></span>
            <span class="kw-src"><%= (k.sources||['web','reddit']).join(' · ') %></span>
            <span class="kw-del" title="Remove" onclick="lstDelKeyword('<%= k._id %>')">&times;</span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
      <h3 style="margin:0;font-family:'Cormorant Garamond',serif;font-size:1.4rem;">Trend Digest</h3>
      <span style="font-size:0.72rem;color:var(--slate);">Recent findings &mdash; your agent works these into suggestions.</span>
      <a href="?tab=suggestions" class="btn btn-ghost btn-sm" style="margin-left:auto;">Go to Suggestions &rarr;</a>
    </div>

    <div class="lst-card" style="margin-bottom:12px;">
      <div style="display:flex;gap:6px;align-items:flex-end;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <input type="text" class="lst-input" id="noteTitle" placeholder="Add your own note to the digest&hellip;">
        </div>
        <button class="btn btn-ghost btn-sm" onclick="lstAddNote(this)">+ Add note</button>
      </div>
    </div>

    <div id="digestList">
      <% if (!digest || !digest.length) { %>
        <div style="text-align:center;padding:34px 20px;color:var(--slate);">
          <div style="font-size:1.5rem;margin-bottom:6px;">&#128225;</div>
          Nothing yet. Add a keyword and hit <em>Refresh all</em> to pull in trends.
        </div>
      <% } else { %>
        <% digest.forEach(d => { %>
          <div class="dg-item" id="dg-<%= d._id %>">
            <div class="dg-top">
              <span class="dg-src dg-<%= d.source || 'note' %>"><%= d.source || 'note' %></span>
              <% if (d.keyword) { %><span class="dg-kw">#<%= d.keyword %></span><% } %>
              <span class="dg-when"><%= new Date(d.fetchedAt || d.updatedAt).toLocaleDateString() %> <span class="kw-del" style="cursor:pointer;margin-left:6px;" onclick="lstDelDigest('<%= d._id %>')">&times;</span></span>
            </div>
            <div class="dg-title">
              <% if (d.url && /^https?:/.test(d.url)) { %><a href="<%= d.url %>" target="_blank" rel="noopener"><%= d.title %></a><% } else { %><%= d.title %><% } %>
            </div>
            <% if (d.snippet) { %><div class="dg-snip"><%= d.snippet %></div><% } %>
            <% if (d.meta) { %><div class="dg-meta"><%= d.meta %></div><% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<script>
async function lstPost(url, body) {
  const r = await fetch(url, { method:'POST', headers: body ? {'Content-Type':'application/json'} : {}, body: body ? JSON.stringify(body) : undefined });
  return r.json();
}
async function lstAddKeyword(btn) {
  const inp = document.getElementById('kwInput');
  const kw = (inp.value||'').trim(); if (!kw) { inp.focus(); return; }
  const sources = []; if (document.getElementById('srcWeb').checked) sources.push('web'); if (document.getElementById('srcReddit').checked) sources.push('reddit');
  btn.disabled = true; btn.textContent = 'Adding...';
  const d = await lstPost('/admin/social/listen/keywords', { keyword: kw, sources });
  if (d.ok) location.reload(); else { btn.disabled=false; btn.textContent='+ Add listener'; alert(d.error||'Failed'); }
}
async function lstDelKeyword(id) {
  if (!confirm('Remove this listener?')) return;
  const d = await lstPost('/admin/social/listen/keywords/'+id+'/delete');
  if (d.ok) document.getElementById('kw-'+id) && document.getElementById('kw-'+id).remove();
}
async function lstRunAll(btn) {
  btn.disabled = true; const o = btn.textContent; btn.textContent = 'Fetching trends...';
  const d = await lstPost('/admin/social/listen/run');
  if (d.ok) location.reload(); else { btn.disabled=false; btn.textContent=o; alert(d.error||'Failed'); }
}
async function lstAddNote(btn) {
  const inp = document.getElementById('noteTitle');
  const title = (inp.value||'').trim(); if (!title) { inp.focus(); return; }
  btn.disabled = true;
  const d = await lstPost('/admin/social/digest/add', { source:'note', title });
  if (d.ok) location.reload(); else { btn.disabled=false; alert(d.error||'Failed'); }
}
async function lstDelDigest(id) {
  const d = await lstPost('/admin/social/digest/'+id+'/delete');
  if (d.ok) document.getElementById('dg-'+id) && document.getElementById('dg-'+id).remove();
}
</script>
