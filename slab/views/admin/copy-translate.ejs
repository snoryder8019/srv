<%- include('partials/head', { title: 'Translate Copy' }) %>
<%- include('partials/sidebar', { page: page, user: user }) %>

<style>
  .tr-wrap { max-width: 920px; margin: 0 auto; padding: 32px 40px 96px; }
  .tr-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:8px; }
  .tr-wrap h1 { font-family: var(--font-heading); font-size: 1.8rem; font-weight: 400; color: var(--on-surface); }
  .tr-sub { font-size: 0.82rem; color: var(--slate); line-height:1.6; margin: 8px 0 24px; max-width: 640px; }
  .tr-flash { padding:10px 14px; border-radius:4px; font-size:0.8rem; margin-bottom:18px; }
  .tr-flash.ok { background: rgba(21,128,61,0.1); color:#15803d; border:1px solid rgba(21,128,61,0.25); }
  .tr-flash.err { background: rgba(139,28,28,0.1); color:#8b1c1c; border:1px solid rgba(139,28,28,0.25); }
  .tr-note { background: var(--surface); border:1px solid var(--border); border-radius:4px; padding:14px 16px; font-size:0.78rem; color:var(--slate); margin-bottom:24px; line-height:1.6; }
  .tr-section { margin-bottom:30px; }
  .tr-section h2 { font-size:0.72rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--navy); margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--border); }
  .tr-row { display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:16px; align-items:start; }
  .tr-field label { display:block; font-size:0.7rem; font-weight:600; letter-spacing:0.03em; color:var(--slate); margin-bottom:5px; }
  .tr-key { font-size:0.6rem; color:var(--slate); opacity:0.7; font-family: ui-monospace, monospace; margin-bottom:8px; }
  .tr-en { font-size:0.85rem; color:var(--on-surface); background:var(--bg); border:1px solid var(--border); border-radius:4px; padding:9px 11px; line-height:1.5; white-space:pre-wrap; word-break:break-word; }
  .tr-in { width:100%; font-size:0.85rem; color:var(--on-surface); background:var(--surface); border:1px solid var(--border); border-radius:4px; padding:9px 11px; font-family:inherit; line-height:1.5; }
  .tr-in:focus { outline:none; border-color:var(--gold); }
  textarea.tr-in { min-height:64px; resize:vertical; }
  .tr-bar { position:sticky; bottom:0; background:var(--surface); border-top:1px solid var(--border); padding:14px 40px; margin:0 -40px; display:flex; gap:14px; align-items:center; justify-content:flex-end; }
  .tr-save { padding:10px 26px; background:var(--gold); color:var(--on-surface); border:none; border-radius:3px; font-family:'Jost',sans-serif; font-size:0.82rem; font-weight:600; letter-spacing:0.04em; cursor:pointer; }
  .tr-empty { padding:40px; text-align:center; color:var(--slate); font-size:0.85rem; }
  @media (max-width:720px){ .tr-row{ grid-template-columns:1fr; } }
</style>

<div class="tr-wrap">
  <div class="tr-head">
    <div>
      <h1>Translate Site Copy</h1>
    </div>
    <a href="/admin/design" style="font-size:0.78rem;color:var(--slate);text-decoration:none;align-self:center;">← Back to Design</a>
  </div>
  <p class="tr-sub">Add Spanish versions of your written site copy. English stays the source of truth — any Spanish field you leave blank automatically falls back to English on the live site.</p>

  <% if (typeof saved !== 'undefined' && saved) { %><div class="tr-flash ok">Translations saved.</div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="tr-flash err">Something went wrong saving. Please try again.</div><% } %>

  <% if (typeof multilangOn !== 'undefined' && !multilangOn) { %>
    <div class="tr-note">Heads up: the public language switcher is currently <strong>off</strong>. Visitors won't be able to choose Spanish until you enable it in <a href="/admin/settings">Settings → Language</a>. You can still author translations here now.</div>
  <% } %>

  <% if (!groups || !groups.length) { %>
    <div class="tr-empty">No written copy to translate yet. Add your site copy in <a href="/admin/design">Design</a> first, then come back here.</div>
  <% } else { %>
  <form method="POST" action="/admin/copy/translate" data-guard data-guard-label="Saving">
    <% groups.forEach(function(g){ %>
      <div class="tr-section">
        <h2><%= g.section %></h2>
        <% g.fields.forEach(function(f){ %>
          <div class="tr-row">
            <div class="tr-field">
              <label>English (source)</label>
              <div class="tr-key"><%= f.key %></div>
              <div class="tr-en"><%= f.en %></div>
            </div>
            <div class="tr-field">
              <label>Español</label>
              <div class="tr-key">&nbsp;</div>
              <% var esVal = f.translations.es || ''; %>
              <% if (f.isLong) { %>
                <textarea class="tr-in" name="<%= f.key %>__es" rows="3" placeholder="Traducción en español…"><%= esVal %></textarea>
              <% } else { %>
                <input class="tr-in" type="text" name="<%= f.key %>__es" value="<%= esVal %>" placeholder="Traducción en español…">
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% }); %>
    <div class="tr-bar">
      <span style="font-size:0.75rem;color:var(--slate);">Blank Spanish = shows English</span>
      <button type="submit" class="tr-save">Save Translations</button>
    </div>
  </form>
  <% } %>
</div>
