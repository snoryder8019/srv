<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { user, page }) %>

<div class="topbar">
  <div class="topbar-title">Writer</div>
  <div class="topbar-actions">
    <% var _newType = (typeof activeType !== 'undefined' && activeType && activeType !== 'all') ? ('?type=' + activeType) : ''; %>
    <% var _draftCount = (posts || []).filter(function(p){ return p.status === 'draft' && p.title && p.content; }).length; %>
    <% if (_draftCount > 0) { %>
      <%# Auto-slot: drop every ready draft onto the calendar at the next open
          reading hours — the content mirror of social's ⚡ Auto-slot. %>
      <button type="button" id="autoSlotBtn" class="btn btn-ghost" title="Schedule ready drafts onto the calendar at the next open slots">⚡ Auto-slot <%= _draftCount %></button>
    <% } %>
    <a href="/admin/calendar?src=blog" class="btn btn-ghost" title="See scheduled content on the platform calendar">📅 Calendar</a>
    <a href="/admin/blog/new<%= _newType %>" class="btn btn-navy">+ New Content</a>
  </div>
</div>
<div class="content">

  <%
    var _types = (typeof contentTypes !== 'undefined' && contentTypes) ? contentTypes : [];
    var _active = (typeof activeType !== 'undefined') ? activeType : 'all';
    var _counts = (typeof counts !== 'undefined' && counts) ? counts : {};
    var _typeMeta = {}; _types.forEach(function(t){ _typeMeta[t.key] = t; });
  %>
  <div class="writer-tabs" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px;">
    <a href="/admin/blog" class="btn btn-sm <%= _active === 'all' ? 'btn-navy' : 'btn-ghost' %>">All <span style="opacity:0.6;">(<%= _counts.all || 0 %>)</span></a>
    <% _types.forEach(function(t) { %>
      <a href="/admin/blog?type=<%= t.key %>" class="btn btn-sm <%= _active === t.key ? 'btn-navy' : 'btn-ghost' %>"><%= (t.icon ? t.icon + ' ' : '') + t.label %> <span style="opacity:0.6;">(<%= _counts[t.key] || 0 %>)</span></a>
    <% }); %>
  </div>

  <% if (msg === 'created') { %><div class="alert alert-success">Post created successfully.</div><% } %>
  <% if (msg === 'updated') { %><div class="alert alert-success">Post updated successfully.</div><% } %>
  <% if (msg === 'deleted') { %><div class="alert alert-success">Post deleted.</div><% } %>
  <% if (msg === 'published') { %><div class="alert alert-success">Post published.</div><% } %>
  <% if (msg === 'scheduled') { %><div class="alert alert-success">Scheduled — it'll go live automatically. See it on the <a href="/admin/calendar?src=blog">calendar</a>.</div><% } %>
  <% if (msg === 'unscheduled') { %><div class="alert alert-success">Pulled off the calendar, back to draft.</div><% } %>
  <% if (msg && msg.indexOf('Scheduled ') === 0) { %><div class="alert alert-success"><%= msg %> onto the calendar. <a href="/admin/calendar?src=blog">View</a>.</div><% } %>
  <% if (err) { %><div class="alert alert-error">Something went wrong. Please try again.</div><% } %>

  <% if (!posts || posts.length === 0) { %>
    <div class="empty">
      <div class="empty-icon">✍</div>
      <p>No content yet. Create your first piece to get started.</p>
      <div style="margin-top:20px;"><a href="/admin/blog/new<%= _newType %>" class="btn btn-navy">Create Content</a></div>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Category</th>
            <th>Status</th>
            <th>Published</th>
            <th>Updated</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(post => { %>
            <% var _t = _typeMeta[post.contentType] || { label: 'Blog Post', icon: '✍', publicBase: '/blog' }; %>
            <tr>
              <td>
                <div style="font-weight:500;"><%= post.title %></div>
                <% if (_t.publicBase) { %>
                  <div style="font-size:0.75rem;color:var(--slate);margin-top:2px;"><%= _t.publicBase %>/<%= post.slug %></div>
                <% } else { %>
                  <div style="font-size:0.75rem;color:var(--slate);margin-top:2px;">
                    <%= post.tags && post.tags.length ? ('tags: ' + (Array.isArray(post.tags) ? post.tags.join(', ') : post.tags)) : 'no tags — add tags to place by feed' %>
                  </div>
                <% } %>
              </td>
              <td><span class="badge"><%= (_t.icon ? _t.icon + ' ' : '') + _t.label %></span></td>
              <td><%= post.category || '—' %></td>
              <td>
                <span class="badge <%= post.status === 'published' ? 'badge-active' : (post.status === 'scheduled' ? 'badge-prospect' : 'badge-draft') %>"><%= post.status %></span>
              </td>
              <td style="font-size:0.82rem;color:var(--slate);">
                <% if (post.status === 'scheduled' && post.scheduledAt) { %>
                  <span title="Scheduled to go live">🕑 <%= new Date(post.scheduledAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>, <%= new Date(post.scheduledAt).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %></span>
                <% } else { %>
                  <%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—' %>
                <% } %>
              </td>
              <td style="font-size:0.82rem;color:var(--slate);">
                <%= new Date(post.updatedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
              </td>
              <td style="text-align:right;white-space:nowrap;">
                <% if (post.status === 'published' && _t.publicBase) { %>
                  <button type="button" class="btn btn-ghost btn-sm" style="margin-right:6px;" title="Share"
                    onclick="shareAdminContent('blog', '<%= post._id %>', { title: <%= JSON.stringify(post.title) %>, crossPost: true })">⤴ Share</button>
                  <a href="<%= _t.publicBase %>/<%= post.slug %>" target="_blank" class="btn btn-ghost btn-sm" style="margin-right:6px;">View</a>
                <% } else if (post.status === 'scheduled') { %>
                  <form method="POST" action="/admin/blog/<%= post._id %>/unschedule" style="display:inline;" title="Pull off the calendar, back to draft">
                    <button type="submit" class="btn btn-ghost btn-sm" style="margin-right:6px;">Unschedule</button>
                  </form>
                  <form method="POST" action="/admin/blog/<%= post._id %>/publish" style="display:inline;">
                    <button type="submit" class="btn btn-navy btn-sm" style="margin-right:6px;">Publish now</button>
                  </form>
                <% } else if (post.status !== 'published') { %>
                  <form method="POST" action="/admin/blog/<%= post._id %>/publish" style="display:inline;">
                    <button type="submit" class="btn btn-navy btn-sm" style="margin-right:6px;">Publish</button>
                  </form>
                <% } %>
                <a href="/admin/blog/<%= post._id %>/edit" class="btn btn-ghost btn-sm" style="margin-right:6px;">Edit</a>
                <form method="POST" action="/admin/blog/<%= post._id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this post?')">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>
<%- include('../../partials/_share-modal') %>
<script>
// ⚡ Auto-slot — schedule every ready draft onto the calendar at the next open
// reading hours, then reload so the new dates show. Mirrors social's auto-slot.
(function() {
  var btn = document.getElementById('autoSlotBtn');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var n = btn.textContent.replace(/\D/g, '');
    if (!confirm('Schedule ' + n + ' ready draft(s) onto the calendar at the next open slots?')) return;
    btn.disabled = true; btn.textContent = 'Scheduling…';
    fetch('/admin/blog/auto-slot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({}),
    }).then(function(r){ return r.json(); }).then(function(d){
      if (d.ok) {
        window.location = '/admin/blog?msg=' + encodeURIComponent('Scheduled ' + d.scheduled.length + ' post(s)');
      } else {
        btn.disabled = false; btn.textContent = '⚡ Auto-slot';
        alert('Could not auto-slot: ' + (d.error || 'unknown error'));
      }
    }).catch(function(){
      btn.disabled = false; btn.textContent = '⚡ Auto-slot';
      alert('Could not reach the server. Try again.');
    });
  });
})();
</script>
<script src="/js/tours/blog.js"></script>
</div></body></html>
