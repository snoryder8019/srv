<%- include('../partials/head', { title: c.name }) %>
<%- include('../partials/sidebar', { page: 'clients', user: user }) %>

<div class="topbar">
  <div class="topbar-title"><%= c.name %></div>
  <div class="topbar-actions">
    <button class="btn btn-navy btn-sm" id="startMeetingBtn" title="Create meeting & email invite to client">Start Meeting</button>
    <button class="btn btn-ghost btn-sm" id="openAgentBtn" style="border-color:var(--navy);" title="AI-research this client">Research Client</button>
    <a href="/admin/clients/<%= c._id %>/edit" class="btn btn-ghost btn-sm">Edit</a>
    <form method="POST" action="/admin/clients/<%= c._id %>/delete" data-guard="button" style="display:inline" onsubmit="return confirm('Delete this client?')">
      <button class="btn btn-danger btn-sm">Delete</button>
    </form>
  </div>
</div>

<div class="content">
  <%- include('../partials/advisory', { needs: 'zoho' }) %>
  <%- include('../partials/advisory', { needs: 'ai' }) %>
  <!-- Client header card -->
  <div class="card" style="margin-bottom:24px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;">
      <div>
        <div style="font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:300;color:var(--on-surface);"><%= c.name %></div>
        <div style="font-size:0.8rem;color:var(--slate);margin-top:2px;"><%= c.company || '' %><%= c.company && c.email ? ' · ' : '' %><%= c.email || '' %></div>
      </div>
      <select id="detailStatusToggle" style="padding:5px 10px;font-size:0.75rem;border:1px solid var(--border);border-radius:2px;background:var(--surface);font-family:'Jost',sans-serif;cursor:pointer;margin-top:4px;">
        <option value="prospect" <%= c.status === 'prospect' ? 'selected' : '' %>>Prospect</option>
        <option value="active" <%= c.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= c.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>
    <div style="display:flex;gap:24px;flex-wrap:wrap;margin-top:16px;">
      <% if (c.phone) { %><div class="text-slate" style="font-size:0.82rem;"><strong style="font-weight:600;letter-spacing:.06em;">Phone</strong> · <%= c.phone %></div><% } %>
      <% if (c.website) { %><div class="text-slate" style="font-size:0.82rem;"><a href="<%= c.website %>" target="_blank" style="color:var(--navy);"><%= c.website %></a></div><% } %>
      <% if (c.address) { %><div class="text-slate" style="font-size:0.82rem;"><%= c.address %></div><% } %>
    </div>
  </div>

  <!-- Tags -->
  <style>
    .tag-bar { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:16px; }
    .tag-toggle { padding:4px 14px; border-radius:14px; font-size:11px; font-weight:600; border:1px solid var(--border); cursor:pointer; font-family:'Jost',sans-serif; transition:all 0.15s; background:var(--surface); color:var(--slate); }
    .tag-toggle:hover { opacity:0.85; }
    .tag-toggle.on { border-color:transparent; }
    .cfg-bar { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:20px; align-items:center; }
    .cfg-chip { display:inline-flex; align-items:center; gap:4px; padding:4px 12px; border-radius:2px; font-size:11px; font-weight:600; border:1px solid var(--border); background:var(--surface); }
    .cfg-chip.cfg-yes { color:#059669; background:rgba(16,185,129,0.06); border-color:rgba(16,185,129,0.2); }
    .cfg-chip.cfg-no { color:#bbb; }
  </style>
  <div class="tag-bar">
    <% const activeTags = c.tags || []; %>
    <% for (const [slug, def] of Object.entries(tagDefs)) { %>
      <% const isOn = activeTags.includes(slug); %>
      <form method="POST" action="/admin/clients/<%= c._id %>/tags" data-guard="button" style="display:inline;">
        <input type="hidden" name="tag" value="<%= slug %>">
        <input type="hidden" name="action" value="<%= isOn ? 'remove' : 'add' %>">
        <button type="submit" class="tag-toggle<%= isOn ? ' on' : '' %>"
          style="<%= isOn ? 'color:' + def.color + ';background:' + def.bg + ';' : '' %>">
          <%= isOn ? '✓ ' : '' %><%= def.label %>
        </button>
      </form>
    <% } %>
  </div>

  <!-- Profile Completeness -->
  <div class="cfg-bar">
    <% for (const [key, check] of Object.entries(configChecks)) { %>
    <span class="cfg-chip <%= configStatus[key] ? 'cfg-yes' : 'cfg-no' %>"><%= check.icon %> <%= check.label %></span>
    <% } %>
    <span style="font-size:10px;color:var(--slate);font-weight:600;margin-left:4px;"><%= configStatus._count %>/<%= configStatus._total %></span>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <a href="?tab=overview" class="tab-link <%= tab === 'overview' ? 'active' : '' %>">Overview</a>
    <a href="?tab=notes" class="tab-link <%= tab === 'notes' ? 'active' : '' %>">Notes (<%= counts.notes %>)</a>
    <a href="?tab=invoices" class="tab-link <%= tab === 'invoices' ? 'active' : '' %>">Invoices (<%= counts.invoices %>)</a>
    <a href="?tab=engagements" class="tab-link <%= tab === 'engagements' ? 'active' : '' %>">Engagements (<%= counts.engagements %>)</a>
    <a href="?tab=assets" class="tab-link <%= tab === 'assets' ? 'active' : '' %>">Assets (<%= counts.assets %>)</a>
    <a href="?tab=files" class="tab-link <%= tab === 'files' ? 'active' : '' %>">Files (<%= counts.files %>)</a>
    <a href="?tab=emails" class="tab-link <%= tab === 'emails' ? 'active' : '' %>">Emails (<%= counts.emails %>)</a>
    <a href="?tab=onboarding" class="tab-link <%= tab === 'onboarding' ? 'active' : '' %>">Onboarding</a>
  </div>

  <!-- OVERVIEW TAB -->
  <% if (tab === 'overview') { %>
    <div class="card">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
        <span>Notes</span>
        <a href="?tab=notes" style="font-size:0.7rem;font-weight:600;letter-spacing:.06em;color:var(--navy);text-decoration:none;">Manage →</a>
      </div>
      <% if (typeof c.notes === 'string' && c.notes.trim()) { %>
        <p style="font-size:0.9rem;font-weight:300;color:var(--slate);line-height:1.7;white-space:pre-wrap;"><%= c.notes %></p>
      <% } else if (counts.notes) { %>
        <p style="font-size:0.9rem;font-weight:300;color:var(--slate);line-height:1.7;">
          <%= counts.notes %> note<%= counts.notes === 1 ? '' : 's' %> on file — <a href="?tab=notes" style="color:var(--navy);">open the Notes tab</a>.
        </p>
      <% } else { %>
        <p style="font-size:0.9rem;font-weight:300;color:var(--slate);line-height:1.7;">No notes yet.</p>
      <% } %>
    </div>
    <div class="card mt-24">
      <div class="card-title">Summary</div>
      <table>
        <tbody>
          <tr><td class="text-slate" style="font-size:0.72rem;letter-spacing:.1em;text-transform:uppercase;width:140px;">Added</td><td><%= new Date(c.createdAt).toLocaleDateString('en-US', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %></td></tr>
          <tr><td class="text-slate" style="font-size:0.72rem;letter-spacing:.1em;text-transform:uppercase;">Invoices</td><td><%= counts.invoices %> total</td></tr>
          <tr><td class="text-slate" style="font-size:0.72rem;letter-spacing:.1em;text-transform:uppercase;">Assets</td><td><%= counts.assets %> attached</td></tr>
          <tr><td class="text-slate" style="font-size:0.72rem;letter-spacing:.1em;text-transform:uppercase;">Files</td><td><%= counts.files %> shared</td></tr>
          <tr><td class="text-slate" style="font-size:0.72rem;letter-spacing:.1em;text-transform:uppercase;">Onboarding</td><td><%= c.onboarding?.complete ? 'Complete' : `In progress (step ${c.onboarding?.step || 0})` %></td></tr>
        </tbody>
      </table>
    </div>

    <% if (c.agentReport) { %>
    <div class="card mt-24">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
        <span>Agent Research Report</span>
        <span style="font-size:0.65rem;color:var(--slate);font-weight:400;">Generated <%= new Date(c.agentReport.generatedAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></span>
      </div>

      <!-- Type / Industry row -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div>
          <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Business Type</div>
          <div style="font-size:0.88rem;color:var(--on-surface);"><%= c.agentReport.businessType || '—' %></div>
        </div>
        <div>
          <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Industry</div>
          <div style="font-size:0.88rem;color:var(--on-surface);"><%= c.agentReport.industry || '—' %></div>
        </div>
      </div>

      <!-- Summary — own block -->
      <div style="margin-top:16px;padding:14px 16px;background:var(--ivory);border-radius:3px;">
        <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Summary</div>
        <p style="font-size:0.85rem;color:var(--on-surface);line-height:1.7;font-weight:300;margin:0;"><%= c.agentReport.summary || '—' %></p>
      </div>

      <!-- Strengths / Opportunities -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
        <div>
          <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:6px;">Strengths</div>
          <% if (Array.isArray(c.agentReport.strengths)) { %>
            <% for (const s of c.agentReport.strengths) { %><div style="font-size:0.82rem;color:var(--on-surface);padding:3px 0;">+ <%= s %></div><% } %>
          <% } else { %><div class="text-slate" style="font-size:0.82rem;">—</div><% } %>
        </div>
        <div>
          <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:6px;">Opportunities</div>
          <% if (Array.isArray(c.agentReport.opportunities)) { %>
            <% for (const o of c.agentReport.opportunities) { %><div style="font-size:0.82rem;color:var(--on-surface);padding:3px 0;">* <%= o %></div><% } %>
          <% } else { %><div class="text-slate" style="font-size:0.82rem;">—</div><% } %>
        </div>
      </div>

      <!-- Suggested Services — wrapping chips, own block -->
      <div style="margin-top:16px;padding:14px 16px;border:1px solid var(--border);border-radius:3px;">
        <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Suggested Services</div>
        <% if (Array.isArray(c.agentReport.suggestedServices) && c.agentReport.suggestedServices.length) { %>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <% for (const sv of c.agentReport.suggestedServices) { %>
          <span style="display:inline-block;font-size:0.75rem;padding:4px 12px;background:rgba(28,43,74,0.06);border-radius:2px;color:var(--navy);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;"><%= sv %></span>
          <% } %>
        </div>
        <% } else { %><div class="text-slate" style="font-size:0.82rem;">—</div><% } %>
      </div>

      <!-- Competitors — own block -->
      <div style="margin-top:16px;padding:14px 16px;border:1px solid var(--border);border-radius:3px;">
        <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Competitors</div>
        <% if (Array.isArray(c.agentReport.competitors) && c.agentReport.competitors.length) { %>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <% for (const comp of c.agentReport.competitors) { %>
          <span style="display:inline-block;font-size:0.75rem;padding:4px 12px;background:rgba(100,100,100,0.06);border-radius:2px;color:var(--on-surface);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;"><%= comp %></span>
          <% } %>
        </div>
        <% } else { %><div class="text-slate" style="font-size:0.82rem;">—</div><% } %>
      </div>

      <% if (c.agentReport.websiteNotes) { %>
      <div style="margin-top:16px;">
        <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Website Analysis</div>
        <p style="font-size:0.82rem;color:var(--on-surface);line-height:1.6;font-weight:300;"><%= c.agentReport.websiteNotes %></p>
      </div>
      <% } %>
      <% if (c.agentReport.onboardingNotes) { %>
      <div style="margin-top:16px;">
        <div style="font-size:0.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Onboarding Notes</div>
        <p style="font-size:0.82rem;color:var(--on-surface);line-height:1.6;font-weight:300;"><%= c.agentReport.onboardingNotes %></p>
      </div>
      <% } %>
    </div>
    <% } %>
  <% } %>

  <!-- NOTES TAB -->
  <% if (tab === 'notes') { %>
    <style>
      .note-item { border:1px solid var(--border); border-radius:4px; padding:14px 16px; margin-bottom:10px; background:var(--surface); }
      .note-src { display:inline-block; font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:2px 8px; border-radius:10px; }
      .note-src.authored { color:var(--navy); background:rgba(28,43,74,0.08); }
      .note-src.pushed   { color:#0369a1; background:rgba(14,165,233,0.10); }
      .note-src.legacy   { color:var(--slate); background:rgba(120,120,120,0.10); }
      .note-meta { font-size:0.72rem; color:var(--slate); }
      .note-body { font-size:0.9rem; font-weight:300; color:var(--on-surface); line-height:1.7; white-space:pre-wrap; margin:8px 0 0; }
    </style>

    <!-- New note — authored straight into the notes engine, bound to this client -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-title">New Note</div>
      <p class="text-slate" style="font-size:0.78rem;margin:-4px 0 12px;">
        Saved to the Notes engine and attached to <strong><%= c.name %></strong> — auto-classified, TL;DR-able, and distributable to blog · email · campaign · web · ticket from the <a href="/admin/notes?client=<%= c._id %>" style="color:var(--navy);">Notes tool</a>.
      </p>
      <div class="form-field" style="margin-bottom:10px;">
        <label>Title <span class="text-slate" style="font-weight:400;">(optional)</span></label>
        <input type="text" id="cnTitle" placeholder="Untitled Note">
      </div>
      <div class="form-field" style="margin-bottom:10px;">
        <label>Note</label>
        <textarea id="cnBody" rows="4" placeholder="Type the note… anything over 60 words is stored as a full rant, shorter notes stay inline."></textarea>
      </div>
      <div class="form-field" style="margin-bottom:12px;">
        <label>Tags <span class="text-slate" style="font-weight:400;">(comma-separated, optional)</span></label>
        <input type="text" id="cnTags" placeholder="business, follow-up">
      </div>
      <button type="button" id="cnAddBtn" class="btn btn-navy btn-sm">Add Note</button>
    </div>

    <!-- Notes log -->
    <% if (!clientNotes.length) { %>
      <div class="empty"><div class="empty-icon">📝</div><p>No notes yet. Add one above, or push a note to this client from the Notes tool.</p></div>
    <% } else { %>
      <% for (const n of clientNotes) { %>
      <div class="note-item">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
          <div style="min-width:0;">
            <span class="note-src <%= n.source %>"><%= n.source === 'authored' ? 'Note' : (n.source === 'pushed' ? 'Pushed' : 'Legacy') %></span>
            <% if (n.title) { %><strong style="font-size:0.9rem;margin-left:6px;"><%= n.title %></strong><% } %>
          </div>
          <div style="display:flex;gap:8px;white-space:nowrap;">
            <% if (n.engineId) { %>
              <a href="/admin/notes?client=<%= c._id %>" class="btn btn-ghost btn-sm" style="font-size:0.7rem;">Open</a>
            <% } %>
            <% if (n.entryId) { %>
              <%# Embedded copy (pushed/legacy) → detach from this client only; source note in the Notes tool is untouched. Pushed copies pull by noteId so dupes clear together. %>
              <button type="button" class="btn btn-ghost btn-sm cn-detach" data-note="<%= n.engineId || '' %>" data-entry="<%= n.entryId %>" style="font-size:0.7rem;color:var(--danger);">Remove</button>
            <% } else if (n.engineId) { %>
              <%# Authored engine note bound to this client → delete from the engine. %>
              <button type="button" class="btn btn-ghost btn-sm cn-del-engine" data-id="<%= n.engineId %>" style="font-size:0.7rem;color:var(--danger);">Delete</button>
            <% } %>
          </div>
        </div>
        <% if (n.content) { %><p class="note-body"><%= n.content %></p><% } %>
        <% if (n.tags && n.tags.length) { %>
          <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:4px;">
            <% for (const t of n.tags) { %><span style="font-size:10px;padding:2px 8px;border-radius:10px;background:var(--ivory);color:var(--slate);">#<%= t %></span><% } %>
          </div>
        <% } %>
        <div class="note-meta" style="margin-top:8px;">
          <% if (n.createdBy) { %><%= n.createdBy %> · <% } %><%= n.createdAt ? new Date(n.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : '' %>
        </div>
      </div>
      <% } %>
    <% } %>

    <script>
      (function () {
        var addBtn = document.getElementById('cnAddBtn');
        if (addBtn) addBtn.addEventListener('click', function () {
          var body = document.getElementById('cnBody').value.trim();
          if (!body) { SlabFlash.error('Write a note first.'); return; }
          SlabLoader.post(addBtn, '/admin/notes', {
            loadingLabel: 'Saving',
            body: {
              title:    document.getElementById('cnTitle').value.trim(),
              body:     body,
              tags:     document.getElementById('cnTags').value.trim(),
              clientId: '<%= c._id %>',
            },
            successMessage: 'Note added.',
            onSuccess: function () { setTimeout(function () { location.href = '?tab=notes'; }, 400); },
          });
        });

        document.querySelectorAll('.cn-del-engine').forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (!confirm('Delete this note? It is removed from the Notes tool too.')) return;
            SlabLoader.post(btn, '/admin/notes/' + btn.dataset.id, {
              method: 'DELETE',
              successMessage: 'Note deleted.',
              onSuccess: function () { setTimeout(function () { location.href = '?tab=notes'; }, 300); },
            });
          });
        });

        document.querySelectorAll('.cn-detach').forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (!confirm('Remove this note from the client? The original note stays in the Notes tool.')) return;
            // Pushed copies detach by noteId (clears any duplicate pushes); a
            // legacy string-note with no backlink detaches by its entry id.
            var payload = btn.dataset.note ? { noteId: btn.dataset.note } : { entryId: btn.dataset.entry };
            SlabLoader.post(btn, '/admin/clients/<%= c._id %>/notes/remove', {
              body: payload,
              successMessage: 'Note removed from client.',
              onSuccess: function () { setTimeout(function () { location.href = '?tab=notes'; }, 300); },
            });
          });
        });
      })();
    </script>
  <% } %>

  <!-- INVOICES TAB -->
  <% if (tab === 'invoices') { %>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-title">New Invoice</div>
      <form method="POST" action="/admin/clients/<%= c._id %>/invoices" id="invoiceForm" data-guard data-guard-label="Creating">
        <div class="form-grid cols-3">
          <div class="form-field">
            <label>Invoice Title</label>
            <input type="text" name="title" placeholder="Social Media - March" required>
          </div>
          <div class="form-field">
            <label>Status</label>
            <select name="status">
              <option value="draft">Draft</option>
              <option value="unpaid" selected>Unpaid</option>
              <option value="sent">Sent</option>
            </select>
          </div>
          <div class="form-field">
            <label>Due Date</label>
            <input type="date" name="dueDate">
          </div>
        </div>

        <!-- Line Items -->
        <div style="margin-top:20px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
            <label style="font-size:0.82rem;font-weight:500;color:var(--on-surface);">Line Items</label>
            <button type="button" onclick="addLineItem()" class="btn btn-ghost btn-sm" style="font-size:0.75rem;">+ Add Item</button>
          </div>
          <div id="lineItems">
            <div class="li-row" style="display:flex;gap:8px;margin-bottom:6px;align-items:center;">
              <input type="text" name="description[]" placeholder="Description" style="flex:3;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.85rem;">
              <input type="number" name="quantity[]" value="1" min="1" step="1" style="flex:0.7;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.85rem;" oninput="calcTotal()">
              <input type="number" name="unitPrice[]" placeholder="0.00" step="0.01" min="0" style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.85rem;" oninput="calcTotal()">
              <button type="button" onclick="this.closest('.li-row').remove();calcTotal()" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:1.1rem;padding:0 4px;">&times;</button>
            </div>
          </div>
          <div style="text-align:right;margin-top:8px;font-size:0.9rem;color:var(--on-surface);">Total: <strong id="lineTotal">$0.00</strong></div>
          <input type="hidden" name="amount" id="totalAmount" value="0">
        </div>

        <!-- Recurring -->
        <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
          <label style="font-size:0.82rem;display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" name="recurringEnabled" id="recurToggle" onchange="document.getElementById('recurOpts').style.display=this.checked?'flex':'none'">
            <span style="font-weight:500;color:var(--on-surface);">Recurring Invoice</span>
          </label>
          <div id="recurOpts" style="display:none;gap:12px;margin-top:10px;flex-wrap:wrap;">
            <div class="form-field" style="flex:1;min-width:140px;">
              <label>Frequency</label>
              <select name="recurringFrequency" style="padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.85rem;width:100%;">
                <option value="weekly">Weekly</option>
                <option value="biweekly">Biweekly</option>
                <option value="monthly" selected>Monthly</option>
                <option value="quarterly">Quarterly</option>
                <option value="yearly">Yearly</option>
              </select>
            </div>
            <label style="display:flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--slate);cursor:pointer;margin-top:8px;">
              <input type="checkbox" name="recurringAutoSend"> Auto-send email
            </label>
          </div>
        </div>

        <div class="form-field span-2" style="margin-top:12px;">
          <label>Notes</label>
          <input type="text" name="notes" placeholder="Optional notes">
        </div>

        <div style="margin-top:16px;"><button type="submit" class="btn btn-navy btn-sm">Create Invoice</button></div>
      </form>
    </div>

    <% if (!invoices.length) { %>
      <div class="empty"><div class="empty-icon">$</div><p>No invoices yet.</p></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Invoice #</th><th>Title</th><th>Amount</th><th>Status</th><th>Due</th><th>Sent</th><th></th></tr></thead>
        <tbody>
          <% for (const inv of invoices) { %>
          <tr>
            <td style="font-size:0.78rem;font-weight:500;color:var(--navy);white-space:nowrap;"><%= inv.invoiceNumber || '—' %><% if (inv.recurring?.enabled) { %> <span title="Recurring" style="color:var(--gold);">&#x21bb;</span><% } %></td>
            <td style="font-weight:500;"><%= inv.title %></td>
            <td>$<%= inv.amount.toFixed(2) %></td>
            <td>
              <form method="POST" action="/admin/clients/<%= c._id %>/invoices/<%= inv._id %>/status" data-guard="button" style="display:inline;">
                <select name="status" onchange="this.form.submit()" style="padding:4px 8px;font-size:0.75rem;border:1px solid var(--border);border-radius:2px;background:var(--surface);font-family:'Jost',sans-serif;appearance:auto;">
                  <option value="draft" <%= inv.status === 'draft' ? 'selected' : '' %>>Draft</option>
                  <option value="unpaid" <%= inv.status === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
                  <option value="sent" <%= inv.status === 'sent' ? 'selected' : '' %>>Sent</option>
                  <option value="paid" <%= inv.status === 'paid' ? 'selected' : '' %>>Paid</option>
                  <option value="overdue" <%= inv.status === 'overdue' ? 'selected' : '' %>>Overdue</option>
                  <option value="void" <%= inv.status === 'void' ? 'selected' : '' %>>Void</option>
                </select>
              </form>
            </td>
            <td class="text-slate" style="font-size:0.82rem;"><%= inv.dueDate ? new Date(inv.dueDate).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : '—' %></td>
            <td class="text-slate" style="font-size:0.78rem;"><%= inv.emailSentAt ? new Date(inv.emailSentAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) : '—' %></td>
            <td style="white-space:nowrap;">
              <div style="display:flex;gap:4px;align-items:center;">
                <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.72rem;" title="Preview invoice email" onclick="openEmailPreview({ endpoint: '/admin/clients/<%= c._id %>/invoices/<%= inv._id %>/preview', title: 'Invoice preview' })">Preview</button>
                <% if (inv.status !== 'paid' && inv.status !== 'void') { %>
                <form method="POST" action="/admin/clients/<%= c._id %>/invoices/<%= inv._id %>/send" data-guard="button" style="display:inline;" onsubmit="return confirm('Send invoice email to <%= c.email || 'client' %>?')">
                  <button class="btn btn-ghost btn-sm" style="font-size:0.72rem;" title="Send via email">Email</button>
                </form>
                <% } %>
                <% if (inv.paymentToken) { %>
                <button class="btn btn-ghost btn-sm" style="font-size:0.72rem;" title="Copy payment link" onclick="navigator.clipboard.writeText(window.location.origin+'/pay/<%= inv.paymentToken %>');this.textContent='Copied!';setTimeout(()=>this.textContent='Link',1500)">Link</button>
                <% } %>
                <form method="POST" action="/admin/clients/<%= c._id %>/invoices/<%= inv._id %>/delete" data-guard="button" onsubmit="return confirm('Delete invoice?')" style="display:inline;">
                  <button class="btn btn-danger btn-sm" style="font-size:0.72rem;">Del</button>
                </form>
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>

    <script>
    function addLineItem() {
      const row = document.createElement('div');
      row.className = 'li-row';
      row.style.cssText = 'display:flex;gap:8px;margin-bottom:6px;align-items:center;';
      row.innerHTML = '<input type="text" name="description[]" placeholder="Description" style="flex:3;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:\'Jost\',sans-serif;font-size:0.85rem;">'
        + '<input type="number" name="quantity[]" value="1" min="1" step="1" style="flex:0.7;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:\'Jost\',sans-serif;font-size:0.85rem;" oninput="calcTotal()">'
        + '<input type="number" name="unitPrice[]" placeholder="0.00" step="0.01" min="0" style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:\'Jost\',sans-serif;font-size:0.85rem;" oninput="calcTotal()">'
        + '<button type="button" onclick="this.closest(\'.li-row\').remove();calcTotal()" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:1.1rem;padding:0 4px;">&times;</button>';
      document.getElementById('lineItems').appendChild(row);
    }
    function calcTotal() {
      let total = 0;
      document.querySelectorAll('.li-row').forEach(row => {
        const q = parseFloat(row.querySelector('[name="quantity[]"]')?.value) || 0;
        const p = parseFloat(row.querySelector('[name="unitPrice[]"]')?.value) || 0;
        total += q * p;
      });
      document.getElementById('lineTotal').textContent = '$' + total.toFixed(2);
      document.getElementById('totalAmount').value = total.toFixed(2);
    }
    </script>
  <% } %>

  <!-- ASSETS TAB -->
  <% if (tab === 'assets') { %>
    <style>
      .ca-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
      .ca-card {
        background: var(--surface); border: 2px solid transparent; border-radius: 2px;
        overflow: hidden; transition: all 0.12s; cursor: pointer;
      }
      .ca-card:hover { border-color: var(--border); box-shadow: 0 2px 8px rgba(15,27,48,0.08); }
      .ca-thumb {
        aspect-ratio: 16/10; background: var(--ivory); overflow: hidden;
        display: flex; align-items: center; justify-content: center;
      }
      .ca-thumb img, .ca-thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .ca-info { padding: 8px 10px; }
      .ca-title { font-size: 0.78rem; font-weight: 500; color: var(--on-surface); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .ca-meta { font-size: 0.65rem; color: var(--slate); margin-top: 2px; display: flex; gap: 6px; align-items: center; }
      .ca-badge { font-size: 0.55rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 1px 5px; border-radius: 1px; }
      .ca-badge-image { background: rgba(28,43,74,0.08); color: var(--navy); }
      .ca-badge-video { background: rgba(201,168,72,0.15); color: #92660F; }
      .ca-actions { display: flex; gap: 6px; padding: 0 10px 8px; }
      .ca-empty { text-align: center; padding: 40px; color: var(--slate); font-size: 0.85rem; }
    </style>

    <div class="card" style="margin-bottom:20px;">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
        <span>Attached Assets</span>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-ghost btn-sm" id="pickAssetBtn" style="font-size:0.75rem;">+ From Library</button>
          <a href="/admin/assets" class="btn btn-ghost btn-sm" style="font-size:0.75rem;">Manage All</a>
        </div>
      </div>

      <% if (!assets.length) { %>
        <div class="ca-empty">No assets attached to this client.<br><small>Click "From Library" to attach existing assets, or upload in the Asset Center with this client selected.</small></div>
      <% } else { %>
        <div class="ca-grid">
          <% for (const a of assets) { %>
          <div class="ca-card" data-id="<%= a._id %>">
            <div class="ca-thumb">
              <% if (a.fileType === 'image') { %>
                <img src="<%= a.publicUrl %>" alt="<%= a.altText || a.title || '' %>" loading="lazy">
              <% } else if (a.fileType === 'video') { %>
                <video src="<%= a.publicUrl %>" muted preload="metadata"></video>
              <% } else { %>
                <span style="font-size:2rem;color:var(--slate);">◻</span>
              <% } %>
            </div>
            <div class="ca-info">
              <div class="ca-title"><%= a.title || a.originalName %></div>
              <div class="ca-meta">
                <span class="ca-badge ca-badge-<%= a.fileType %>"><%= a.fileType %></span>
                <span><%= a.folder %></span>
                <span><%= a.size ? (a.size > 1024*1024 ? (a.size/1024/1024).toFixed(1)+' MB' : (a.size/1024).toFixed(0)+' KB') : '' %></span>
              </div>
            </div>
            <div class="ca-actions">
              <button class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="navigator.clipboard.writeText('<%= a.publicUrl %>');this.textContent='Copied!';setTimeout(()=>this.textContent='Copy URL',1500)">Copy URL</button>
              <button class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="window.open('<%= a.publicUrl %>','_blank')">Open</button>
              <button class="btn btn-danger btn-sm ca-detach-btn" style="font-size:0.68rem;" data-id="<%= a._id %>">Detach</button>
            </div>
          </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <script src="/js/assetPicker.js?v=<%= Date.now() %>"></script>
    <script>
    // "From Library" — open asset picker to attach existing asset
    document.getElementById('pickAssetBtn')?.addEventListener('click', () => {
      openAssetPicker({
        folder: 'all',
        type: 'all',
        onSelect: async (asset) => {
          try {
            const r = await fetch('/admin/assets/' + asset._id, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ clientId: '<%= c._id %>' }),
            });
            const data = await r.json();
            if (data.success) window.location.reload();
          } catch (err) { SlabFlash.error('Error attaching asset: ' + err.message); }
        }
      });
    });

    // Detach buttons — remove clientId from asset
    document.querySelectorAll('.ca-detach-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('Detach this asset from the client? (The asset will remain in the library.)')) return;
        try {
          const r = await fetch('/admin/assets/' + btn.dataset.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: '' }),
          });
          const data = await r.json();
          if (data.success) window.location.reload();
        } catch (err) { SlabFlash.error('Error: ' + err.message); }
      });
    });
    </script>
  <% } %>

  <!-- FILES TAB -->
  <% if (tab === 'files') { %>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-title">Upload File</div>
      <form method="POST" action="/admin/clients/<%= c._id %>/files" enctype="multipart/form-data" data-guard data-guard-label="Uploading">
        <div class="form-grid">
          <div class="form-field">
            <label>File</label>
            <input type="file" name="file" required>
          </div>
          <div class="form-field">
            <label>Label (optional)</label>
            <input type="text" name="label" placeholder="e.g. Brand Guide v1">
          </div>
        </div>
        <div style="margin-top:16px;"><button type="submit" class="btn btn-navy btn-sm">Upload File</button></div>
      </form>
    </div>

    <% if (!files.length) { %>
      <div class="empty"><div class="empty-icon">📁</div><p>No files shared yet.</p></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Label</th><th>Type</th><th>Size</th><th>Uploaded</th><th></th></tr></thead>
        <tbody>
          <% for (const f of files) { %>
          <tr>
            <td><% if (f.url) { %><a href="<%= f.url %>" target="_blank" style="color:var(--navy);"><%= f.name %></a><% } else { %><span class="text-slate"><%= f.name %></span><% } %></td>
            <td><%= f.label || '—' %></td>
            <td class="text-slate" style="font-size:0.8rem;"><%= f.type || '—' %></td>
            <td class="text-slate" style="font-size:0.8rem;"><%= f.size ? (f.size / 1024).toFixed(0) + ' KB' : '—' %></td>
            <td class="text-slate"><%= new Date(f.uploadedAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></td>
            <td>
              <form method="POST" action="/admin/clients/<%= c._id %>/files/<%= f._id %>/delete" data-guard="button" onsubmit="return confirm('Delete file?')">
                <button class="btn btn-danger btn-sm">Del</button>
              </form>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } %>

  <!-- ENGAGEMENTS TAB -->
  <% if (tab === 'engagements') { %>
    <style>
      .eng-st { font-size:0.55rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; padding:2px 8px; border-radius:9px; white-space:nowrap; }
      .eng-st-draft { background:rgba(107,115,128,.12); color:var(--slate); }
      .eng-st-sent, .eng-st-viewed { background:rgba(14,165,233,.1); color:#0ea5e9; }
      .eng-st-revision_requested { background:rgba(249,115,22,.12); color:#f97316; }
      .eng-st-signed { background:rgba(234,179,8,.14); color:#ca8a04; }
      .eng-st-acknowledged { background:rgba(16,185,129,.12); color:#10b981; }
      .eng-st-declined, .eng-st-void { background:rgba(239,68,68,.1); color:#ef4444; }
      .eng-st-expired { background:rgba(245,158,11,.14); color:#b45309; }
    </style>

    <% const engAttention = engagements.filter(en => en.status === 'signed' || en.status === 'revision_requested' || (en.w9?.requestedAt && !en.w9?.releasedAt)); %>
    <% if (engAttention.length) { %>
      <div class="card" style="margin-bottom:20px; border-left:3px solid #f97316;">
        <div class="card-title">Waiting on you</div>
        <% for (const en of engAttention) { %>
          <div style="font-size:0.85rem; padding:4px 0;">
            <a href="/admin/clients/<%= c._id %>/engagements/<%= en._id %>" style="color:var(--navy); font-weight:600;"><%= en.engagementNumber %></a>
            —
            <% if (en.status === 'signed') { %>signed by <%= en.signature?.typedName %> · needs <strong>Confirm Receipt &amp; Engage Services</strong><% } %>
            <% if (en.status === 'revision_requested') { %>revision requested · needs an answer<% } %>
            <% if (en.w9?.requestedAt && !en.w9?.releasedAt) { %><%= en.status === 'signed' || en.status === 'revision_requested' ? ' · ' : '' %>W-9 requested · needs release<% } %>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="card" style="margin-bottom:20px;">
      <div class="card-title">New Letter of Engagement</div>
      <form method="POST" action="/admin/clients/<%= c._id %>/engagements" data-guard data-guard-label="Creating">
        <div class="form-grid">
          <div class="form-field">
            <label>Title</label>
            <input type="text" name="title" value="Letter of Engagement" required>
          </div>
        </div>
        <div style="margin-top:16px;"><button type="submit" class="btn btn-navy btn-sm">Create Draft</button></div>
      </form>
    </div>

    <% if (!engagements.length) { %>
      <div class="empty"><div class="empty-icon">✍️</div><p>No engagement letters yet. Create a draft above — build it from your <a href="/admin/engagements" style="color:var(--navy);">services catalog</a>.</p></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Reference</th><th>Title</th><th>Status</th><th>Sent</th><th>Signed by</th><th>W-9</th></tr></thead>
        <tbody>
          <% for (const en of engagements) { %>
          <tr>
            <td><a href="/admin/clients/<%= c._id %>/engagements/<%= en._id %>" style="color:var(--navy); font-weight:600;"><%= en.engagementNumber %></a></td>
            <td><%= en.title %></td>
            <td><span class="eng-st eng-st-<%= en.status %>"><%= en.status.replace('_', ' ') %></span></td>
            <td class="text-slate"><%= en.sentAt ? new Date(en.sentAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : '—' %></td>
            <td class="text-slate"><%= en.signature?.typedName || '—' %></td>
            <td class="text-slate" style="font-size:0.8rem;">
              <% if (en.w9?.releasedAt) { %>✓ <%= en.w9.revision %><% } else if (en.w9?.requestedAt) { %>⚠ requested<% } else { %>—<% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } %>

  <!-- ONBOARDING TAB -->
  <% if (tab === 'onboarding') { %>

    <% if (typeof onboardingForms !== 'undefined' && onboardingForms.length) { %>
      <!-- Dynamic custom forms -->
      <% onboardingForms.forEach(function(obForm) {
        const existingResponse = (typeof onboardingResponses !== 'undefined' ? onboardingResponses : [])
          .find(r => r.formId.toString() === obForm._id.toString());
        const savedData = existingResponse?.data || {};
      %>
      <div class="card" style="margin-bottom:20px;">
        <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
          <%= obForm.name %>
          <% if (existingResponse) { %>
            <span style="font-size:0.72rem;color:var(--slate);">Last submitted: <%= new Date(existingResponse.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span>
          <% } %>
        </div>
        <% if (obForm.description) { %><p style="color:var(--slate);font-size:0.85rem;margin-bottom:16px;"><%= obForm.description %></p><% } %>
        <form class="ob-dynamic-form form-grid" data-form-id="<%= obForm._id %>" style="gap:12px 16px;">
          <% (obForm.fields || []).forEach(function(f) { %>
            <% if (f.type === 'heading') { %>
              <div style="grid-column:span 2;margin-top:8px;padding-bottom:4px;border-bottom:1px solid var(--border);">
                <strong style="font-size:0.82rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--slate);"><%= f.label %></strong>
              </div>
            <% } else { %>
              <div class="form-field" style="<%= f.width === 'half' ? '' : 'grid-column:span 2;' %>"
                   <% if (f.conditional?.fieldKey) { %>data-cond-field="<%= f.conditional.fieldKey %>" data-cond-op="<%= f.conditional.operator %>" data-cond-val="<%= f.conditional.value %>"<% } %>>
                <label><%= f.label %><% if (f.required) { %> <span style="color:var(--danger);">*</span><% } %>
                  <% if (f.pipeFrom?.formSlug) { %><span style="font-size:0.65rem;background:var(--gold-light);color:var(--navy);padding:1px 5px;border-radius:3px;margin-left:4px;">piped</span><% } %>
                </label>
                <% if (f.helpText) { %><div style="font-size:0.72rem;color:var(--slate);margin-bottom:4px;"><%= f.helpText %></div><% } %>
                <% if (f.type === 'textarea') { %>
                  <textarea name="<%= f.key %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>><%= savedData[f.key] || '' %></textarea>
                <% } else if (f.type === 'select') { %>
                  <select name="<%= f.key %>" <%= f.required ? 'required' : '' %>>
                    <option value="">Select...</option>
                    <% (f.options || []).forEach(function(o) { %>
                      <option value="<%= o.value %>" <%= savedData[f.key] === o.value ? 'selected' : '' %>><%= o.label %></option>
                    <% }) %>
                  </select>
                <% } else if (f.type === 'radio') { %>
                  <% (f.options || []).forEach(function(o) { %>
                    <label style="display:flex;align-items:center;gap:6px;font-size:0.85rem;font-weight:400;margin-bottom:4px;">
                      <input type="radio" name="<%= f.key %>" value="<%= o.value %>" <%= savedData[f.key] === o.value ? 'checked' : '' %>> <%= o.label %>
                    </label>
                  <% }) %>
                <% } else if (f.type === 'checkbox') { %>
                  <% const checkedVals = Array.isArray(savedData[f.key]) ? savedData[f.key] : (savedData[f.key] ? [savedData[f.key]] : []); %>
                  <% (f.options || []).forEach(function(o) { %>
                    <label style="display:flex;align-items:center;gap:6px;font-size:0.85rem;font-weight:400;margin-bottom:4px;">
                      <input type="checkbox" name="<%= f.key %>" value="<%= o.value %>" <%= checkedVals.includes(o.value) ? 'checked' : '' %>> <%= o.label %>
                    </label>
                  <% }) %>
                <% } else { %>
                  <input type="<%= f.type === 'number' ? 'number' : f.type === 'email' ? 'email' : f.type === 'url' ? 'url' : f.type === 'date' ? 'date' : f.type === 'color' ? 'color' : 'text' %>"
                         name="<%= f.key %>" placeholder="<%= f.placeholder || '' %>" value="<%= savedData[f.key] || '' %>" <%= f.required ? 'required' : '' %>>
                <% } %>
              </div>
            <% } %>
          <% }) %>
          <div style="grid-column:span 2;margin-top:12px;">
            <button type="submit" class="btn btn-navy ob-submit-btn">Save Response</button>
          </div>
        </form>
      </div>
      <% }) %>

      <script>
      (function() {
        document.querySelectorAll('.ob-dynamic-form').forEach(function(form) {
          // Conditionals
          function evalConds() {
            form.querySelectorAll('[data-cond-field]').forEach(function(el) {
              var fk = el.dataset.condField, op = el.dataset.condOp, val = el.dataset.condVal;
              var inp = form.querySelector('[name="' + fk + '"]');
              var actual = inp ? inp.value : '';
              var show = op === 'eq' ? actual === val : op === 'neq' ? actual !== val : actual.toLowerCase().indexOf(val.toLowerCase()) >= 0;
              el.style.display = show ? '' : 'none';
            });
          }
          form.addEventListener('input', evalConds);
          form.addEventListener('change', evalConds);
          evalConds();

          // Submit
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            var data = {};
            new FormData(form).forEach(function(v, k) {
              if (data[k]) { if (!Array.isArray(data[k])) data[k] = [data[k]]; data[k].push(v); }
              else data[k] = v;
            });
            var btn = form.querySelector('.ob-submit-btn');
            btn.disabled = true; btn.textContent = 'Saving...';
            fetch('/admin/onboarding/' + form.dataset.formId + '/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ data: data, clientId: '<%= c._id %>' }),
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
              btn.disabled = false;
              if (res.ok) { btn.textContent = 'Saved!'; SlabFlash.success('Response saved.'); setTimeout(function() { btn.textContent = 'Save Response'; }, 1500); }
              else { btn.textContent = 'Save Response'; SlabFlash.error(res.error || 'Save failed'); }
            })
            .catch(function() { btn.disabled = false; btn.textContent = 'Save Response'; SlabFlash.error('Save failed'); });
          });
        });
      })();
      </script>

      <div style="margin-top:8px;text-align:right;">
        <a href="/admin/onboarding" style="font-size:0.78rem;color:var(--slate);">Manage onboarding forms &rarr;</a>
      </div>

    <% } else { %>
      <!-- Fallback: original hardcoded onboarding form -->
      <div class="card">
        <div class="card-title">Client Onboarding
          <a href="/admin/onboarding" style="font-size:0.72rem;font-weight:400;color:var(--gold);margin-left:12px;">Create custom forms &rarr;</a>
        </div>
        <form method="POST" action="/admin/clients/<%= c._id %>/onboarding" data-guard data-guard-label="Saving">
          <div class="form-grid">
            <div class="form-field">
              <label>Business Type</label>
              <input type="text" name="businessType" value="<%= c.onboarding?.data?.businessType || '' %>" placeholder="e.g. Restaurant, Retail, Salon">
            </div>
            <div class="form-field">
              <label>Budget Range</label>
              <select name="budget">
                <option value="" <%= !c.onboarding?.data?.budget ? 'selected' : '' %>>Select...</option>
                <option value="under500" <%= c.onboarding?.data?.budget === 'under500' ? 'selected' : '' %>>Under $500/mo</option>
                <option value="500-1000" <%= c.onboarding?.data?.budget === '500-1000' ? 'selected' : '' %>>$500–$1,000/mo</option>
                <option value="1000-2500" <%= c.onboarding?.data?.budget === '1000-2500' ? 'selected' : '' %>>$1,000–$2,500/mo</option>
                <option value="2500+" <%= c.onboarding?.data?.budget === '2500+' ? 'selected' : '' %>>$2,500+/mo</option>
              </select>
            </div>
            <div class="form-field">
              <label>Timeline</label>
              <select name="timeline">
                <option value="" <%= !c.onboarding?.data?.timeline ? 'selected' : '' %>>Select...</option>
                <option value="asap" <%= c.onboarding?.data?.timeline === 'asap' ? 'selected' : '' %>>ASAP</option>
                <option value="1month" <%= c.onboarding?.data?.timeline === '1month' ? 'selected' : '' %>>Within 1 month</option>
                <option value="3months" <%= c.onboarding?.data?.timeline === '3months' ? 'selected' : '' %>>1–3 months</option>
                <option value="flexible" <%= c.onboarding?.data?.timeline === 'flexible' ? 'selected' : '' %>>Flexible</option>
              </select>
            </div>
            <div class="form-field">
              <label>Social Platforms</label>
              <input type="text" name="socialPlatforms" value="<%= c.onboarding?.data?.socialPlatforms || '' %>" placeholder="Instagram, Facebook, TikTok">
            </div>
            <div class="form-field">
              <label>Current Website</label>
              <input type="url" name="currentWebsite" value="<%= c.onboarding?.data?.currentWebsite || '' %>" placeholder="https://...">
            </div>
            <div class="form-field">
              <label>Progress Step</label>
              <select name="step">
                <option value="0" <%= !c.onboarding?.step ? 'selected' : '' %>>Not started</option>
                <option value="1" <%= c.onboarding?.step === 1 ? 'selected' : '' %>>Step 1 — Initial call</option>
                <option value="2" <%= c.onboarding?.step === 2 ? 'selected' : '' %>>Step 2 — Proposal sent</option>
                <option value="3" <%= c.onboarding?.step === 3 ? 'selected' : '' %>>Step 3 — Contract signed</option>
                <option value="done" <%= c.onboarding?.complete ? 'selected' : '' %>>Complete</option>
              </select>
            </div>
            <div class="form-field span-2">
              <label>Goals</label>
              <textarea name="goals" placeholder="What does the client want to achieve?"><%= c.onboarding?.data?.goals || '' %></textarea>
            </div>
            <div class="form-field span-2">
              <label>Brand Notes</label>
              <textarea name="brandNotes" placeholder="Brand voice, colors, style preferences..."><%= c.onboarding?.data?.brandNotes || '' %></textarea>
            </div>
            <div class="form-field span-2">
              <label>Brand Colors <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(hex codes, comma separated — used in Social Generator)</span></label>
              <input type="text" name="brandColors" value="<%= (c.brandColors || []).join(', ') %>" placeholder="#1C2B4A, #C9A848, #F5F3EF">
              <% if (c.brandColors?.length) { %>
              <div style="display:flex;gap:4px;margin-top:6px;">
                <% for (const clr of c.brandColors) { %>
                <div style="width:28px;height:28px;border-radius:2px;background:<%= clr %>;border:1px solid var(--border);" title="<%= clr %>"></div>
                <% } %>
              </div>
              <% } %>
            </div>
            <div class="form-field">
              <label>Brand Font — Heading</label>
              <select name="brandFontHeading">
                <option value="">— Use tenant default —</option>
                <% const hFonts = ['Cormorant Garamond','Playfair Display','Lora','Merriweather','Libre Baskerville','Jost','Inter','Poppins','Raleway','Nunito','DM Sans']; %>
                <% for (const f of hFonts) { %>
                <option value="<%= f %>" <%= c.brandFonts?.heading === f ? 'selected' : '' %>><%= f %></option>
                <% } %>
              </select>
            </div>
            <div class="form-field">
              <label>Brand Font — Body</label>
              <select name="brandFontBody">
                <option value="">— Use tenant default —</option>
                <% const bFonts = ['Jost','Inter','Poppins','Raleway','Nunito','DM Sans','Cormorant Garamond','Playfair Display','Lora','Merriweather','Libre Baskerville']; %>
                <% for (const f of bFonts) { %>
                <option value="<%= f %>" <%= c.brandFonts?.body === f ? 'selected' : '' %>><%= f %></option>
                <% } %>
              </select>
            </div>
          </div>
          <div style="margin-top:24px;"><button type="submit" class="btn btn-navy">Save Onboarding Data</button></div>
        </form>
      </div>
    <% } %>

  <% } %>

  <!-- EMAILS TAB -->
  <% if (tab === 'emails') { %>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
    <style>
      /* ── EMAIL RICH EDITOR ── */
      .preview-toggle{font-size:0.68rem;padding:4px 10px;border:1px solid var(--border);background:var(--surface);color:var(--slate);cursor:pointer;border-radius:2px;font-family:'Jost',sans-serif;font-weight:500;transition:all 0.15s;}
      .preview-toggle.active{background:var(--navy);color:var(--on-navy);border-color:var(--navy);}
      #emailQuill{background:var(--surface);border:1px solid var(--border);border-top:none;border-radius:0 0 3px 3px;min-height:300px;font-family:var(--font-body);font-size:0.92rem;line-height:1.7;color:var(--on-surface);}
      #emailQuill .ql-editor{min-height:280px;padding:16px 18px;}
      #emailQuill .ql-editor p{margin-bottom:10px;}
      #emailQuill .ql-editor h3{font-family:var(--font-body);font-size:1.1rem;font-weight:600;margin:14px 0 6px;}
      #emailQuill .ql-editor blockquote{border-left:3px solid var(--gold);padding-left:14px;color:var(--slate);font-style:italic;margin:12px 0;}
      #emailQuill .ql-editor a{color:var(--gold);}
      #emailQuill .ql-editor ul,#emailQuill .ql-editor ol{padding-left:22px;margin-bottom:10px;}
      .ql-toolbar.ql-snow{border:1px solid var(--border);border-radius:3px 3px 0 0;background:var(--surface);}
      /* ── EMAIL AGENT CHAT ── */
      .eap-msg{display:flex;flex-direction:column;gap:4px;margin-bottom:12px;}
      .eap-msg.user{align-items:flex-end;}
      .eap-bubble{max-width:90%;padding:9px 13px;border-radius:4px;font-size:0.82rem;line-height:1.5;}
      .eap-msg.user .eap-bubble{background:var(--navy);color:var(--on-navy);border-radius:4px 4px 1px 4px;}
      .eap-msg.assistant .eap-bubble{background:var(--ivory);color:var(--on-surface);border:1px solid var(--border);border-radius:4px 4px 4px 1px;}
      .eap-fill{font-size:0.66rem;color:var(--success,#15803D);font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin-top:2px;}
      .thread{border:1px solid var(--border);border-radius:3px;margin-bottom:12px;overflow:hidden;}
      .thread-head{padding:12px 16px;background:var(--ivory);cursor:pointer;display:flex;gap:10px;align-items:center;flex-wrap:wrap;transition:background .12s;}
      .thread-head:hover{background:var(--border);}
      .thread-subject{font-size:0.88rem;font-weight:500;color:var(--on-surface);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
      .thread-meta{font-size:0.68rem;color:var(--slate);white-space:nowrap;}
      .thread-count{font-size:0.6rem;padding:2px 7px;border-radius:10px;background:var(--navy);color:var(--surface);font-weight:600;}
      .thread-body{display:none;}
      .thread.open .thread-body{display:block;}
      .thread.open .thread-head{border-bottom:1px solid var(--border);}
      .msg{padding:14px 16px;border-bottom:1px solid var(--ivory);}
      .msg:last-child{border-bottom:none;}
      .msg-bar{display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap;}
      .msg-badge{font-size:0.58rem;padding:2px 7px;border-radius:2px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;}
      .msg-badge-out{background:rgba(28,43,74,0.08);color:var(--navy);}
      .msg-badge-in{background:rgba(201,168,72,0.15);color:#92660F;}
      .msg-from{font-size:0.72rem;color:var(--slate);}
      .msg-time{font-size:0.68rem;color:var(--slate);margin-left:auto;}
      .msg-content{font-size:0.84rem;color:var(--on-surface);line-height:1.6;max-height:180px;overflow-y:auto;}
      .badge-source{font-size:0.55rem;padding:1px 5px;border-radius:2px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;}
      /* Open / click tracking */
      .trk{font-size:0.66rem;padding:1px 6px;border-radius:2px;font-weight:500;white-space:nowrap;cursor:help;}
      .trk-open{background:rgba(21,128,61,0.12);color:#15803d;}
      .trk-click{background:rgba(99,91,255,0.12);color:#635bff;}
      .trk-none{background:rgba(107,115,128,0.10);color:var(--slate);}
      .trk-links{margin-top:8px;padding-top:8px;border-top:1px dashed var(--border);font-size:0.7rem;color:var(--slate);line-height:1.7;}
      .trk-links a{color:#635bff;word-break:break-all;}
    </style>

    <!-- Flash -->
    <% if (qs?.success) { %>
    <div style="background:rgba(21,128,61,0.08);border:1px solid rgba(21,128,61,0.2);border-radius:3px;padding:10px 16px;margin-bottom:16px;font-size:0.82rem;color:var(--success);"><%= qs.success %></div>
    <% } %>
    <% if (qs?.error) { %>
    <div style="background:rgba(185,28,28,0.08);border:1px solid rgba(185,28,28,0.2);border-radius:3px;padding:10px 16px;margin-bottom:16px;font-size:0.82rem;color:var(--danger);"><%= qs.error %></div>
    <% } %>

    <!-- Compose -->
    <div class="card" style="margin-bottom:20px;">
      <div style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;" onclick="document.getElementById('composeForm').style.display=document.getElementById('composeForm').style.display==='none'?'block':'none';this.querySelector('.chevron').textContent=document.getElementById('composeForm').style.display==='none'?'+':'-'">
        <div class="card-title" style="margin:0;border:none;padding-bottom:0;">Compose Email</div>
        <span class="chevron" style="font-size:1.2rem;color:var(--slate);font-weight:300;">+</span>
      </div>
      <form method="POST" action="/admin/clients/<%= c._id %>/emails/send" id="composeForm" enctype="multipart/form-data" data-guard data-guard-label="Sending" style="display:none;margin-top:16px;">
        <div class="form-grid" style="grid-template-columns:1fr 1fr;">
          <div class="form-field">
            <label>To</label>
            <input type="email" name="to" value="<%= c.email || '' %>" required placeholder="client@example.com">
          </div>
          <div class="form-field">
            <label>CC <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(comma separated)</span></label>
            <input type="text" name="cc" placeholder="other@example.com, <%= brand?.email || '' %>">
          </div>
        </div>
        <!-- Quick-start presets -->
        <div class="form-field" style="margin-top:12px;">
          <label>Presets <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(fills subject &amp; body — edit before sending)</span></label>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="applyEmailPreset('update')">Project update</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="applyEmailPreset('checkin')">Check-in</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="applyEmailPreset('thanks')">Thank you</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="applyEmailPreset('meeting')">Schedule a call</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="applyEmailPreset('deliverable')">Deliverable ready</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;color:var(--slate);" onclick="applyEmailPreset('blank')">Clear</button>
          </div>
        </div>
        <div class="form-field" style="margin-top:12px;">
          <label>Subject *</label>
          <input type="text" name="subject" id="clientSubject" required placeholder="e.g. Quick update on your project">
        </div>
        <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:12px;">
          <div class="form-field" style="flex:1 1 320px;min-width:280px;margin:0;">
            <label style="display:flex;align-items:center;gap:8px;">
              Body *
              <button type="button" class="btn btn-ghost btn-sm" id="emailAgentBtn" style="font-size:0.68rem;margin-left:auto;color:var(--navy);">✦ AI Draft</button>
              <button type="button" class="preview-toggle" id="emailHtmlToggle" style="font-size:0.68rem;">HTML</button>
            </label>
            <div style="display:flex;gap:6px;margin-bottom:6px;flex-wrap:wrap;" id="emailExtraTools">
              <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="openClientImgPicker()">Brand Image</button>
            </div>
            <!-- Hidden source: synced from Quill (or raw HTML mode); submitted + previewed -->
            <textarea name="body" id="clientBody" style="display:none;"></textarea>
            <div id="emailQuill"></div>
            <textarea id="emailHtmlEditor" rows="14" placeholder="Raw email-safe HTML…"
              style="display:none;font-family:monospace;font-size:0.82rem;line-height:1.6;width:100%;padding:12px;border:1px solid var(--border);border-radius:0 0 3px 3px;background:var(--ivory);color:var(--on-surface);resize:vertical;outline:none;min-height:300px;box-sizing:border-box;"></textarea>
          </div>
          <div style="flex:1 1 340px;min-width:300px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
              <label style="margin:0;">Live preview</label>
              <span id="previewStatus" style="font-size:0.65rem;color:var(--slate);"></span>
            </div>
            <div style="border:1px solid var(--border);border-radius:4px;overflow:hidden;background:#fff;">
              <iframe id="emailPreviewFrame" title="Email preview" sandbox="allow-same-origin" style="width:100%;height:520px;border:0;display:block;background:#fff;"></iframe>
            </div>
            <div style="font-size:0.65rem;color:var(--slate);margin-top:5px;">Your logo &amp; brand colors come from <a href="/admin/design#brand-images" style="color:var(--navy);">Design</a>.</div>
          </div>
        </div>
        <div class="form-field" style="margin-top:12px;">
          <label>Attachments <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(optional — uploaded &amp; saved to the Files tab)</span></label>
          <input type="file" name="attachments" id="emailAttachments" multiple style="font-size:0.8rem;color:var(--on-surface);">
        </div>
        <div style="margin-top:12px;">
          <button type="submit" class="btn btn-navy btn-sm" id="emailSendBtn" onclick="return confirm('Send to <%= c.email || 'client' %>?')">Send</button>
        </div>
      </form>
    </div>

    <!-- Archive toggle -->
    <div style="display:flex;gap:8px;align-items:center;margin-bottom:14px;">
      <% if (!showArchived) { %>
        <span style="font-size:0.78rem;font-weight:500;color:var(--on-surface);">Inbox</span>
        <% if (archivedCount) { %>
        <a href="?tab=emails&showArchived=1" class="btn btn-ghost btn-sm" style="font-size:0.65rem;">Archived (<%= archivedCount %>)</a>
        <% } %>
      <% } else { %>
        <a href="?tab=emails" class="btn btn-ghost btn-sm" style="font-size:0.65rem;">Back to Inbox</a>
        <span style="font-size:0.78rem;font-weight:500;color:var(--slate);">Archived (<%= archivedCount %>)</span>
      <% } %>
    </div>

    <%
      // ── Open / click state for one outbound message. null = nothing to show
      // (inbound mail, or an email sent before tracking existed / with no
      // tenant domain to host the pixel).
      const TRK_HINT = 'Opens are counted by a tracking pixel — mail apps that block images (and Apple Mail Privacy Protection, which pre-loads them) can under- or over-count. Clicks are exact.';
      function trkStamp(d) {
        return d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
      }
      function emailTrack(m) {
        if (!m || m.direction !== 'outbound' || !m.tracked) return null;
        const opens = m.openCount || 0;
        const clicks = m.clickCount || 0;
        const at = m.lastOpenAt || m.lastClickAt || null;
        const t = { opens, clicks, opened: opens > 0 || clicks > 0, at, clickList: m.clicks || [] };
        if (clicks) {
          t.cls = 'trk-click';
          t.label = `Clicked ${clicks}×` + (opens ? ` · opened ${opens}×` : '') + (at ? ` · ${trkStamp(at)}` : '');
        } else if (opens) {
          t.cls = 'trk-open';
          t.label = `Opened ${opens}×` + (at ? ` · ${trkStamp(at)}` : '');
        } else {
          t.cls = 'trk-none';
          t.label = 'Not opened yet';
        }
        return t;
      }
    %>

    <!-- Conversations -->
    <% if (!threads.length && !unthreaded.length) { %>
      <div class="card"><div style="text-align:center;padding:24px;color:var(--slate);font-size:0.85rem;"><%= showArchived ? 'No archived emails.' : 'No emails yet.' %></div></div>
    <% } else { %>

      <!-- Threaded conversations -->
      <% for (const t of threads) { %>
      <div class="thread" id="thread-<%= t.root._id %>">
        <div class="thread-head" onclick="if(!event.target.closest('.arch-btn'))this.parentElement.classList.toggle('open')">
          <% const hasReply = t.messages.some(m => m.direction === 'inbound'); %>
          <% if (hasReply) { %><span class="msg-badge msg-badge-in" style="flex-shrink:0;">Has Reply</span><% } %>
          <%
            const tTrack = t.messages.map(emailTrack).filter(Boolean);
            const tClicks = tTrack.reduce((n, x) => n + x.clicks, 0);
            const tOpened = tTrack.filter(x => x.opened);
          %>
          <% if (tClicks) { %>
            <span class="trk trk-click" title="<%= TRK_HINT %>" style="flex-shrink:0;">Clicked <%= tClicks %>&times;</span>
          <% } else if (tOpened.length) { %>
            <span class="trk trk-open" title="<%= TRK_HINT %>" style="flex-shrink:0;">Opened</span>
          <% } else if (tTrack.length) { %>
            <span class="trk trk-none" title="<%= TRK_HINT %>" style="flex-shrink:0;">Unopened</span>
          <% } %>
          <% if (t.root.source === 'invoice') { %><span class="badge-source" style="background:rgba(21,128,61,0.1);color:#15803d;">Invoice</span><% } %>
          <% if (t.root.source === 'campaign') { %><span class="badge-source" style="background:rgba(99,91,255,0.1);color:#635bff;">Campaign</span><% } %>
          <div class="thread-subject"><%= t.root.subject %></div>
          <% if (t.messages.length > 1) { %><span class="thread-count"><%= t.messages.length %></span><% } %>
          <span class="thread-meta"><%= new Date(t.lastAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %></span>
          <form method="POST" action="/admin/clients/<%= c._id %>/emails/<%= showArchived ? 'unarchive' : 'archive' %>" data-guard="button" class="arch-btn" style="margin:0;" onclick="event.stopPropagation()">
            <% for (const aid of t.allIds) { %><input type="hidden" name="emailIds" value="<%= aid %>"><% } %>
            <button type="submit" class="btn btn-ghost btn-sm" style="font-size:0.6rem;padding:2px 8px;color:var(--slate);" title="<%= showArchived ? 'Unarchive' : 'Archive' %> thread"><%= showArchived ? 'Restore' : 'Archive' %></button>
          </form>
        </div>
        <div class="thread-body">
          <% for (const msg of t.messages) { %>
          <% const mt = emailTrack(msg); %>
          <div class="msg">
            <div class="msg-bar">
              <% if (msg.direction === 'inbound') { %>
                <span class="msg-badge msg-badge-in">Reply</span>
                <span class="msg-from"><%= msg.from %></span>
              <% } else { %>
                <span class="msg-badge msg-badge-out">Sent</span>
                <span class="msg-from">to <%= msg.to %><% if (msg.cc?.length) { %> &middot; cc: <%= msg.cc.join(', ') %><% } %></span>
              <% } %>
              <%- include('../partials/_email-track-badge', { mt, TRK_HINT }) %>
              <span class="msg-time"><%= new Date(msg.sentAt).toLocaleDateString('en-US', {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'}) %></span>
            </div>
            <div class="msg-content"><%- msg.body %></div>
            <%- include('../partials/_email-track-links', { mt, trkStamp }) %>
          </div>
          <% } %>
          <!-- Inline reply bar -->
          <% if (!showArchived) { %>
          <div class="msg" style="background:var(--ivory);padding:10px 16px;">
            <form method="POST" action="/admin/clients/<%= c._id %>/emails/reply" data-guard="button" style="display:flex;gap:8px;align-items:flex-start;">
              <input type="hidden" name="threadId" value="<%= t.root.threadId || t.root._id %>">
              <input type="hidden" name="subject" value="Re: <%= t.root.subject.replace(/^Re:\s*/i, '') %>">
              <input type="hidden" name="to" value="<%= c.email %>">
              <textarea name="body" rows="2" required placeholder="Reply..." style="flex:1;padding:8px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.82rem;resize:vertical;min-height:38px;"></textarea>
              <button type="submit" class="btn btn-navy btn-sm" style="font-size:0.68rem;white-space:nowrap;margin-top:1px;">Send</button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Unthreaded (standalone emails) -->
      <% for (const em of unthreaded) { %>
      <% const mt = emailTrack(em); %>
      <div class="thread">
        <div class="thread-head" onclick="if(!event.target.closest('.arch-btn'))this.parentElement.classList.toggle('open')">
          <% if (em.direction === 'inbound') { %>
            <span class="msg-badge msg-badge-in" style="flex-shrink:0;">Received</span>
          <% } else { %>
            <span class="msg-badge msg-badge-out" style="flex-shrink:0;">Sent</span>
          <% } %>
          <% if (mt) { %><span class="trk <%= mt.cls %>" title="<%= TRK_HINT %>" style="flex-shrink:0;"><%= mt.clicks ? 'Clicked ' + mt.clicks + '×' : (mt.opened ? 'Opened' : 'Unopened') %></span><% } %>
          <% if (em.source === 'invoice') { %><span class="badge-source" style="background:rgba(21,128,61,0.1);color:#15803d;">Invoice</span><% } %>
          <% if (em.source === 'campaign') { %><span class="badge-source" style="background:rgba(99,91,255,0.1);color:#635bff;">Campaign</span><% } %>
          <div class="thread-subject"><%= em.subject %></div>
          <span class="thread-meta"><%= new Date(em.sentAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %></span>
          <form method="POST" action="/admin/clients/<%= c._id %>/emails/<%= showArchived ? 'unarchive' : 'archive' %>" data-guard="button" class="arch-btn" style="margin:0;" onclick="event.stopPropagation()">
            <input type="hidden" name="emailIds" value="<%= em._id %>">
            <button type="submit" class="btn btn-ghost btn-sm" style="font-size:0.6rem;padding:2px 8px;color:var(--slate);"><%= showArchived ? 'Restore' : 'Archive' %></button>
          </form>
        </div>
        <div class="thread-body">
          <div class="msg">
            <div class="msg-bar">
              <% if (em.direction === 'inbound') { %>
                <span class="msg-badge msg-badge-in">Received</span>
                <span class="msg-from"><%= em.from %></span>
              <% } else { %>
                <span class="msg-badge msg-badge-out">Sent</span>
                <span class="msg-from">to <%= em.to %><% if (em.cc?.length) { %> &middot; cc: <%= em.cc.join(', ') %><% } %></span>
              <% } %>
              <%- include('../partials/_email-track-badge', { mt, TRK_HINT }) %>
              <span class="msg-time"><%= new Date(em.sentAt).toLocaleDateString('en-US', {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'}) %></span>
            </div>
            <div class="msg-content"><%- em.body %></div>
            <%- include('../partials/_email-track-links', { mt, trkStamp }) %>
          </div>
          <!-- Reply bar for unthreaded emails -->
          <% if (!showArchived) { %>
          <div class="msg" style="background:var(--ivory);padding:10px 16px;">
            <form method="POST" action="/admin/clients/<%= c._id %>/emails/reply" data-guard="button" style="display:flex;gap:8px;align-items:flex-start;">
              <input type="hidden" name="threadId" value="<%= em.threadId || em._id %>">
              <input type="hidden" name="subject" value="Re: <%= (em.subject || '').replace(/^Re:\s*/i, '') %>">
              <input type="hidden" name="to" value="<%= em.direction === 'inbound' ? em.from : (c.email || em.to) %>">
              <textarea name="body" rows="2" required placeholder="Reply..." style="flex:1;padding:8px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.82rem;resize:vertical;min-height:38px;"></textarea>
              <button type="submit" class="btn btn-navy btn-sm" style="font-size:0.68rem;white-space:nowrap;margin-top:1px;">Send</button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

    <% } %>

    <!-- Image Picker Modal -->
    <div id="clientImgModal" style="display:none;position:fixed;inset:0;background:rgba(15,27,48,0.5);z-index:500;align-items:center;justify-content:center;">
      <div style="background:var(--surface);border-radius:6px;padding:28px;max-width:560px;width:90%;max-height:70vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,0.15);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <div style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;">Insert Image</div>
          <button type="button" onclick="document.getElementById('clientImgModal').style.display='none'" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:var(--slate);">&times;</button>
        </div>
        <div id="clientImgGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;"></div>
        <div style="margin-top:12px;display:flex;gap:6px;">
          <input type="url" id="clientExtUrl" placeholder="Or paste image URL" style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-size:0.82rem;">
          <button type="button" class="btn btn-navy btn-sm" style="font-size:0.68rem;" onclick="const u=document.getElementById('clientExtUrl').value.trim();if(u){insertEmailImage(u,'');document.getElementById('clientImgModal').style.display='none';}">Insert</button>
        </div>
      </div>
    </div>

    <script>
    const clientBody = document.getElementById('clientBody');
    function insertAt(ta, text) {
      if (!ta) return;
      const s = ta.selectionStart, e = ta.selectionEnd;
      ta.value = ta.value.substring(0, s) + text + ta.value.substring(e);
      ta.selectionStart = ta.selectionEnd = s + text.length;
      ta.focus();
    }
    function openClientImgPicker() {
      const modal = document.getElementById('clientImgModal');
      modal.style.display = 'flex';
      const grid = document.getElementById('clientImgGrid');
      grid.innerHTML = '<div style="color:var(--slate);font-size:0.8rem;grid-column:1/-1;text-align:center;padding:16px;">Loading...</div>';
      fetch('/admin/design/images/api').then(r => r.json()).then(data => {
        if (!data.images?.length) { grid.innerHTML = '<div style="color:var(--slate);font-size:0.8rem;grid-column:1/-1;text-align:center;padding:16px;">No images. <a href="/admin/design#brand-images" style="color:var(--navy);">Upload in Design</a></div>'; return; }
        grid.innerHTML = '';
        for (const img of data.images) {
          const d = document.createElement('div');
          d.style.cssText = 'border:1px solid var(--border);border-radius:2px;overflow:hidden;cursor:pointer;';
          d.innerHTML = '<div style="aspect-ratio:1;background:var(--ivory);display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="'+img.url+'" style="max-width:100%;max-height:100%;object-fit:cover;"></div><div style="padding:4px 6px;font-size:0.6rem;color:var(--slate);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">'+( img.label||img.slot)+'</div>';
          d.onclick = () => { insertEmailImage(img.url, img.label||''); document.getElementById('clientImgModal').style.display='none'; };
          grid.appendChild(d);
        }
      }).catch(() => { grid.innerHTML = '<div style="color:var(--danger);font-size:0.8rem;grid-column:1/-1;text-align:center;">Failed to load</div>'; });
    }
    document.getElementById('clientImgModal')?.addEventListener('click', function(e) { if (e.target === this) this.style.display = 'none'; });

    /* ── Quill rich editor + HTML toggle + presets + live preview + AI agent ── */
    var emailQuill = null, emailHtmlMode = false;
    var subjectEl = document.getElementById('clientSubject');

    // schedulePreview is defined by the preview IIFE below and assigned here.
    var schedulePreview = function(){};

    function syncFromEditor(){
      if (emailHtmlMode) { clientBody.value = document.getElementById('emailHtmlEditor').value; return; }
      if (emailQuill) {
        var html = emailQuill.root.innerHTML;
        if (html === '<p><br></p>') html = '';
        clientBody.value = html;
      }
    }

    // Set the full body (HTML) into both editors + hidden field.
    function setEmailBodyHtml(html){
      clientBody.value = html || '';
      document.getElementById('emailHtmlEditor').value = html || '';
      if (emailQuill) emailQuill.root.innerHTML = html || '';
      schedulePreview();
    }
    // Plain text → simple email-safe paragraphs.
    function setEmailBodyText(text){
      var html = (text || '').split(/\n{2,}/).map(function(p){
        return '<p>' + p.trim().replace(/\n/g, '<br>') + '</p>';
      }).join('');
      setEmailBodyHtml(html);
    }
    // Insert HTML at the cursor (rich mode) or at the textarea caret (HTML mode).
    function insertEmailHtml(html){
      if (emailHtmlMode) { insertAt(document.getElementById('emailHtmlEditor'), html); syncFromEditor(); schedulePreview(); return; }
      if (emailQuill) {
        var range = emailQuill.getSelection(true);
        emailQuill.clipboard.dangerouslyPasteHTML(range ? range.index : emailQuill.getLength(), html);
        syncFromEditor(); schedulePreview();
      }
    }
    function insertEmailImage(url, label){
      insertEmailHtml('<img src="' + url + '" alt="' + (label || '') + '" style="max-width:100%;height:auto;display:block;margin:12px 0;">');
    }
    function insertEmailImageFromInput(){
      var u = document.getElementById('clientExtUrl').value.trim();
      if (u) insertEmailImage(u, '');
    }

    // Load Quill from CDN, then initialize the constrained, email-safe toolbar.
    (function(){
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js';
      s.onload = function(){
        emailQuill = new Quill('#emailQuill', {
          theme: 'snow',
          placeholder: <%- JSON.stringify('Hi ' + (c.name ? c.name.split(' ')[0] : '') + ',') %>,
          modules: { toolbar: [
            [{ header: [3, false] }],
            ['bold', 'italic', 'underline'],
            [{ list: 'ordered' }, { list: 'bullet' }],
            ['blockquote', 'link'],
            ['clean']
          ] }
        });
        if (clientBody.value) emailQuill.root.innerHTML = clientBody.value;
        emailQuill.on('text-change', function(){ syncFromEditor(); schedulePreview(); });
      };
      document.head.appendChild(s);
    })();

    // HTML ↔ rich toggle
    document.getElementById('emailHtmlToggle').addEventListener('click', function(){
      emailHtmlMode = !emailHtmlMode;
      this.classList.toggle('active', emailHtmlMode);
      var htmlEditor = document.getElementById('emailHtmlEditor');
      var toolbar = document.querySelector('#emailQuill').previousElementSibling; // .ql-toolbar
      if (emailHtmlMode) {
        syncFromEditor();
        htmlEditor.value = clientBody.value;
        document.getElementById('emailQuill').style.display = 'none';
        if (toolbar && toolbar.classList.contains('ql-toolbar')) toolbar.style.display = 'none';
        htmlEditor.style.display = 'block';
      } else {
        clientBody.value = htmlEditor.value;
        if (emailQuill) emailQuill.root.innerHTML = htmlEditor.value;
        htmlEditor.style.display = 'none';
        document.getElementById('emailQuill').style.display = '';
        if (toolbar && toolbar.classList.contains('ql-toolbar')) toolbar.style.display = '';
      }
    });
    document.getElementById('emailHtmlEditor').addEventListener('input', function(){
      clientBody.value = this.value; schedulePreview();
    });

    // Final sync on submit so the freshest editor content is posted.
    document.getElementById('composeForm').addEventListener('submit', function(e){
      syncFromEditor();
      if (!clientBody.value.trim()) { e.preventDefault(); alert('Email body is required.'); return; }
      // Guard attachments up front — the server caps at 20 files, and mail
      // providers reject oversized messages. Catch both here so the send
      // doesn't bounce after upload.
      var files = (document.getElementById('emailAttachments') || {}).files || [];
      if (files.length > 20) { e.preventDefault(); alert('Too many attachments — 20 max per email.'); return; }
      var total = 0; for (var i = 0; i < files.length; i++) total += files[i].size;
      if (total > 20 * 1024 * 1024) {
        e.preventDefault();
        alert('Attachments total ' + (total/1048576).toFixed(1) + ' MB. Most mail providers reject messages over ~20 MB — remove or shrink some files, or share a link instead.');
      }
    });

    /* ── Presets + live preview ── */
    (function(){
      var frame = document.getElementById('emailPreviewFrame');
      var status = document.getElementById('previewStatus');
      if (!clientBody || !frame) return;

      var FIRST = <%- JSON.stringify(c.name ? c.name.split(' ')[0] : 'there') %>;
      var BRAND = <%- JSON.stringify(brand && brand.name ? brand.name : 'us') %>;

      var PRESETS = {
        blank:       { subject: '', body: '' },
        update:      { subject: 'Project update',
          body: 'Hi ' + FIRST + ',\n\nQuick update on where things stand:\n\n• \n• \n\nLet me know if you have any questions — happy to hop on a call if that\'s easier.' },
        checkin:     { subject: 'Checking in',
          body: 'Hi ' + FIRST + ',\n\nJust checking in to see how everything\'s going on your end. Is there anything you need from us right now, or anything we can help move forward?\n\nLooking forward to hearing from you.' },
        thanks:      { subject: 'Thank you',
          body: 'Hi ' + FIRST + ',\n\nThank you so much for your trust in ' + BRAND + ' — we genuinely appreciate working with you.\n\nIf there\'s ever anything we can do better, just say the word.' },
        meeting:     { subject: 'Let\'s find a time to talk',
          body: 'Hi ' + FIRST + ',\n\nI\'d love to grab some time to talk through the next steps. Do any of these work for you?\n\n• \n• \n\nIf none of those fit, send a couple windows that suit you and I\'ll make it work.' },
        deliverable: { subject: 'Your deliverable is ready',
          body: 'Hi ' + FIRST + ',\n\nGood news — the latest deliverable is ready for your review. Take a look when you get a chance and let me know your thoughts.\n\nHappy to walk through any of it together if helpful.' }
      };

      window.applyEmailPreset = function(key){
        var p = PRESETS[key]; if (!p) return;
        if (subjectEl) subjectEl.value = p.subject;
        setEmailBodyText(p.body);
      };

      var timer = null;
      schedulePreview = function(){ clearTimeout(timer); timer = setTimeout(renderPreview, 450); };

      function renderPreview(){
        if (status) status.textContent = 'Updating…';
        fetch('/admin/clients/<%= c._id %>/email-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subject: subjectEl ? subjectEl.value : '', body: clientBody.value })
        })
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (d.html) { frame.srcdoc = d.html; if (status) status.textContent = ''; }
          else if (status) status.textContent = d.error || 'Preview unavailable';
        })
        .catch(function(){ if (status) status.textContent = 'Preview unavailable'; });
      }

      if (subjectEl) subjectEl.addEventListener('input', schedulePreview);
      renderPreview();
    })();

    /* ── Email AI agent (chat) ── */
    (function(){
      var panel = document.getElementById('emailAgentPanel');
      var msgsEl = document.getElementById('eapMsgs');
      var input = document.getElementById('eapInput');
      var sendBtn = document.getElementById('eapSend');
      var btn = document.getElementById('emailAgentBtn');
      if (!panel || !btn) return;

      var history = [];

      btn.addEventListener('click', function(){ panel.style.right = '0'; input.focus(); });
      document.getElementById('eapClose').addEventListener('click', function(){ panel.style.right = '-440px'; });

      function append(role, text, extra){
        var el = document.createElement('div');
        el.className = 'eap-msg ' + role;
        el.innerHTML = '<div class="eap-bubble">' + text.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</div>' + (extra || '');
        msgsEl.appendChild(el);
        msgsEl.scrollTop = msgsEl.scrollHeight;
      }
      function typing(on){
        var ex = document.getElementById('eapTyping');
        if (on && !ex){ var d=document.createElement('div'); d.id='eapTyping'; d.className='eap-msg assistant'; d.innerHTML='<div class="eap-bubble" style="opacity:.6;">Drafting…</div>'; msgsEl.appendChild(d); msgsEl.scrollTop=msgsEl.scrollHeight; }
        else if (!on && ex) ex.remove();
      }

      window.setEmailAgentPrompt = function(t){ input.value = t; input.focus(); };

      async function send(){
        var text = input.value.trim();
        if (!text) return;
        input.value = '';
        sendBtn.disabled = true;
        history.push({ role: 'user', content: text });
        append('user', text);
        typing(true);
        try {
          var res = await fetch('/admin/clients/<%= c._id %>/email-agent', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages: history, currentDraft: { subject: subjectEl ? subjectEl.value : '', body: clientBody.value } })
          });
          var data = await res.json();
          typing(false);
          if (data.error) { append('assistant', 'Error: ' + data.error); }
          else {
            var filled = [];
            if (data.fill && data.fill.subject && subjectEl) { subjectEl.value = data.fill.subject; filled.push('subject'); }
            if (data.fill && data.fill.body) { setEmailBodyHtml(data.fill.body); filled.push('body'); }
            history.push({ role: 'assistant', content: data.message || '' });
            var notice = filled.length ? '<div class="eap-fill">✓ ' + filled.join(' + ') + ' updated</div>' : '';
            append('assistant', data.message || 'Done.', notice);
          }
        } catch(e){ typing(false); append('assistant', 'Connection error. Please try again.'); }
        finally { sendBtn.disabled = false; input.focus(); }
      }
      sendBtn.addEventListener('click', send);
      input.addEventListener('keydown', function(e){ if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } });
    })();
    </script>

    <!-- Email AI Agent panel -->
    <div id="emailAgentPanel" style="position:fixed;top:0;right:-440px;width:min(440px,100vw);height:100vh;background:var(--surface);box-shadow:-4px 0 24px color-mix(in srgb, var(--navy-deep) 12%, transparent);z-index:420;transition:right 0.25s ease;display:flex;flex-direction:column;">
      <div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,var(--navy-deep),var(--navy));">
        <div style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;color:var(--on-navy-deep,#F5F3EF);">✦ Email Assistant</div>
        <button id="eapClose" style="background:none;border:none;font-size:1.4rem;cursor:pointer;color:color-mix(in srgb,var(--on-navy-deep,#fff) 60%,transparent);line-height:1;">&times;</button>
      </div>
      <div style="padding:7px 22px;font-size:0.68rem;color:var(--slate);background:color-mix(in srgb,var(--gold) 7%,transparent);border-bottom:1px solid var(--border);">
        Drafts from onboarding · invoices · meetings · account status — fills Subject &amp; Body.
      </div>
      <div id="eapMsgs" style="flex:1;overflow-y:auto;padding:16px 22px;">
        <div class="eap-msg assistant"><div class="eap-bubble">
          Hi! Tell me what to write to <strong><%= c.name?.split(' ')[0] || 'your client' %></strong> and I'll draft it using their history.<br><br>
          Try a quick prompt below, or type your own.
        </div></div>
      </div>
      <div style="padding:12px 22px;border-top:1px solid var(--border);">
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;">
          <button type="button" class="ai-suggest-btn" style="font-size:0.66rem;" onclick="setEmailAgentPrompt('Write a warm check-in on how the project is going')">Check-in</button>
          <button type="button" class="ai-suggest-btn" style="font-size:0.66rem;" onclick="setEmailAgentPrompt('Write a friendly reminder about any outstanding invoice')">Invoice reminder</button>
          <button type="button" class="ai-suggest-btn" style="font-size:0.66rem;" onclick="setEmailAgentPrompt('Write a follow-up recapping our last meeting and next steps')">Meeting follow-up</button>
          <button type="button" class="ai-suggest-btn" style="font-size:0.66rem;" onclick="setEmailAgentPrompt('Write a welcome / onboarding next-steps email based on their goals')">Onboarding</button>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;">
          <textarea id="eapInput" rows="2" placeholder="e.g. Nudge them about the overdue invoice, keep it friendly…" style="flex:1;padding:9px 11px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.82rem;resize:none;background:var(--surface);color:var(--on-surface);"></textarea>
          <button id="eapSend" class="btn btn-navy btn-sm" style="flex-shrink:0;">↑</button>
        </div>
      </div>
    </div>
  <% } %>

</div>

<%- include('../partials/_email-preview-modal') %>

<!-- Agent Panel (slide-out) -->
<div id="agentPanel" style="position:fixed;top:0;right:-420px;width:min(420px,100vw);height:100vh;background:var(--surface);box-shadow:-4px 0 24px color-mix(in srgb, var(--navy-deep) 12%, transparent);z-index:400;transition:right 0.25s ease;display:flex;flex-direction:column;">
  <div style="padding:20px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
    <div style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;color:var(--navy);">Client Research Agent</div>
    <button onclick="document.getElementById('agentPanel').style.right='-420px'" style="background:none;border:none;font-size:1.4rem;cursor:pointer;color:var(--slate);line-height:1;">&times;</button>
  </div>
  <div style="padding:20px 24px;flex:1;overflow-y:auto;" id="agentContent">
    <div style="font-size:0.82rem;color:var(--slate);line-height:1.6;margin-bottom:16px;">
      Researches <strong><%= c.name %></strong><%= c.company ? ` (${c.company})` : '' %> across the web, analyzes their website, and generates an onboarding knowledge base.
    </div>

    <!-- Quick suggestions — wrapping -->
    <div style="margin-bottom:16px;">
      <div style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Quick Prompts</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        <button type="button" class="ai-suggest-btn" onclick="setAgentPrompt('Full research — website, competitors, and services')">Full Research</button>
        <button type="button" class="ai-suggest-btn" onclick="setAgentPrompt('Analyze their website for UX and SEO issues')">Website Audit</button>
        <button type="button" class="ai-suggest-btn" onclick="setAgentPrompt('Identify competitors and market positioning')">Competitors</button>
        <button type="button" class="ai-suggest-btn" onclick="setAgentPrompt('Suggest services based on their business type')">Service Fit</button>
        <button type="button" class="ai-suggest-btn" onclick="setAgentPrompt('Generate onboarding checklist and notes')">Onboarding Plan</button>
      </div>
    </div>

    <!-- Text input — own block -->
    <div style="margin-bottom:16px;padding:12px 14px;background:var(--ivory);border-radius:3px;">
      <label style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);display:block;margin-bottom:6px;">Custom Prompt</label>
      <textarea id="agentPromptInput" rows="2" placeholder="e.g. Research their social media presence and suggest a content strategy..." style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.82rem;resize:vertical;background:var(--surface);color:var(--on-surface);"></textarea>
    </div>

    <div id="agentStatus" style="display:none;padding:12px 16px;background:var(--ivory);border-radius:3px;margin-bottom:16px;">
      <div style="font-size:0.78rem;color:var(--navy);font-weight:500;" id="agentStatusText">Researching...</div>
      <div style="margin-top:8px;height:3px;background:var(--border);border-radius:2px;overflow:hidden;">
        <div id="agentProgress" style="height:100%;background:var(--navy);width:0%;transition:width 0.5s;"></div>
      </div>
    </div>
    <div id="agentResult" style="display:none;overflow:hidden;"></div>
  </div>
  <div style="padding:16px 24px;border-top:1px solid var(--border);">
    <button id="runAgentBtn" class="btn btn-navy" style="width:100%;" onclick="runClientAgent()">Research Client</button>
    <span id="ai-status" style="display:block;margin-top:8px;text-align:center;font-size:0.75rem;color:var(--slate);"></span>
  </div>
</div>

<style>
  .ai-suggest-btn {
    padding:5px 12px;font-size:0.72rem;font-weight:500;font-family:'Jost',sans-serif;
    border:1px solid var(--border);border-radius:2px;background:var(--surface);
    color:var(--navy);cursor:pointer;transition:all 0.15s;white-space:nowrap;
  }
  .ai-suggest-btn:hover { background:rgba(28,43,74,0.06);border-color:var(--navy); }
</style>
<script>
function setAgentPrompt(text) {
  const ta = document.getElementById('agentPromptInput');
  if (ta) { ta.value = text; ta.focus(); }
}
// ── Start Meeting ──
document.getElementById('startMeetingBtn')?.addEventListener('click', async function() {
  if (!confirm('Start a meeting with <%= c.name %>?<%= c.email ? " An invite email will be sent to " + c.email + "." : " No email on file — meeting will be created without an invite." %>')) return;
  this.disabled = true;
  this.textContent = 'Creating...';
  try {
    const r = await fetch('/admin/clients/<%= c._id %>/start-meeting', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
    });
    const data = await r.json();
    if (data.success) {
      window.open(data.meetingUrl, '_blank');
      SlabFlash.success('Meeting started.');
      this.textContent = 'Meeting Started';
      this.style.background = 'var(--success)';
      setTimeout(() => { this.textContent = 'Start Meeting'; this.style.background = ''; this.disabled = false; }, 3000);
    } else {
      SlabFlash.error('Error: ' + (data.error || 'Failed'));
      this.textContent = 'Start Meeting';
      this.disabled = false;
    }
  } catch (err) {
    SlabFlash.error('Error: ' + err.message);
    this.textContent = 'Start Meeting';
    this.disabled = false;
  }
});

// ── Agent Panel ──
document.getElementById('openAgentBtn')?.addEventListener('click', () => {
  document.getElementById('agentPanel').style.right = '0';
});

async function runClientAgent() {
  const btn = document.getElementById('runAgentBtn');
  const status = document.getElementById('agentStatus');
  const statusText = document.getElementById('agentStatusText');
  const progress = document.getElementById('agentProgress');
  const result = document.getElementById('agentResult');

  btn.disabled = true;
  btn.textContent = 'Researching...';
  status.style.display = 'block';
  result.style.display = 'none';
  statusText.textContent = 'Searching the web...';
  progress.style.width = '20%';

  const steps = [
    { text: 'Analyzing search results...', pct: '40%', delay: 3000 },
    { text: 'Reviewing website...', pct: '60%', delay: 5000 },
    { text: 'Generating knowledge base...', pct: '80%', delay: 8000 },
  ];
  const timers = steps.map(s => setTimeout(() => { statusText.textContent = s.text; progress.style.width = s.pct; }, s.delay));

  try {
    const promptVal = document.getElementById('agentPromptInput')?.value?.trim() || '';
    const r = await fetch('/admin/clients/<%= c._id %>/agent', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: promptVal }),
    });
    const data = await r.json();
    timers.forEach(clearTimeout);
    progress.style.width = '100%';

    if (data.success && data.report) {
      statusText.textContent = 'Done!';
      const rpt = data.report;
      result.style.display = 'block';
      result.innerHTML = `
        <div style="font-size:0.82rem;color:var(--navy);font-weight:500;margin-bottom:12px;">${data.message || 'Research complete.'}</div>
        ${rpt.summary ? `<div style="font-size:0.82rem;color:var(--on-surface);line-height:1.6;margin-bottom:14px;">${rpt.summary}</div>` : ''}
        ${rpt.businessType ? `<div style="margin-bottom:10px;"><span style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);">Type:</span> <span style="font-size:0.82rem;color:var(--on-surface);">${rpt.businessType}${rpt.industry ? ' / ' + rpt.industry : ''}</span></div>` : ''}
        ${Array.isArray(rpt.suggestedServices) ? `<div style="margin-bottom:10px;"><div style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);margin-bottom:6px;">Suggested Services</div><div style="display:flex;flex-wrap:wrap;gap:6px;">${rpt.suggestedServices.map(s => `<span style="display:inline-block;font-size:0.75rem;padding:4px 10px;background:rgba(28,43,74,0.06);border-radius:2px;color:var(--navy);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;">${s}</span>`).join('')}</div></div>` : ''}
        ${Array.isArray(rpt.strengths) ? `<div style="margin-bottom:10px;"><div style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Strengths</div>${rpt.strengths.map(s => `<div style="font-size:0.8rem;color:var(--on-surface);padding:2px 0;">+ ${s}</div>`).join('')}</div>` : ''}
        ${Array.isArray(rpt.opportunities) ? `<div style="margin-bottom:10px;"><div style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Opportunities</div>${rpt.opportunities.map(o => `<div style="font-size:0.8rem;color:var(--on-surface);padding:2px 0;">* ${o}</div>`).join('')}</div>` : ''}
        ${rpt.websiteNotes ? `<div style="margin-bottom:10px;"><div style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);margin-bottom:4px;">Website Analysis</div><div style="font-size:0.8rem;color:var(--on-surface);line-height:1.5;">${rpt.websiteNotes}</div></div>` : ''}
        ${rpt.onboardingNotes ? `<div style="margin-bottom:10px;padding:10px 14px;background:var(--ivory);border-radius:3px;"><div style="font-size:0.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--navy);margin-bottom:4px;">Onboarding Notes</div><div style="font-size:0.8rem;color:var(--on-surface);line-height:1.5;">${rpt.onboardingNotes}</div></div>` : ''}
        <div style="margin-top:14px;text-align:center;">
          <button class="btn btn-ghost btn-sm" style="font-size:0.72rem;" onclick="window.location.reload()">Refresh Page to See Report</button>
        </div>`;
      btn.textContent = 'Re-run Research';
    } else {
      statusText.textContent = 'Failed';
      result.style.display = 'block';
      result.innerHTML = `<div style="color:var(--danger);font-size:0.82rem;">${data.error || 'Agent returned no results.'}</div>`;
      btn.textContent = 'Retry';
    }
  } catch (err) {
    timers.forEach(clearTimeout);
    statusText.textContent = 'Error';
    result.style.display = 'block';
    result.innerHTML = `<div style="color:var(--danger);font-size:0.82rem;">${err.message}</div>`;
    btn.textContent = 'Retry';
  }
  btn.disabled = false;
}

// ── Status Toggle ──
document.getElementById('detailStatusToggle')?.addEventListener('change', async function() {
  const status = this.value;
  try {
    const r = await fetch('/admin/clients/<%= c._id %>/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status }),
    });
    const data = await r.json();
    if (data.success) {
      this.style.borderColor = 'var(--gold)';
      SlabFlash.success('Status updated.');
      setTimeout(() => { this.style.borderColor = ''; }, 1500);
    } else {
      SlabFlash.error('Error: ' + (data.error || 'Failed'));
    }
  } catch (err) { SlabFlash.error('Error: ' + err.message); }
});
</script>
<script src="/js/agentHealth.js"></script>
<script src="/js/tours/clients.js"></script>
</div></div>
</body>
</html>
