<%- include('../partials/head', { title: 'Chat Control' }) %>
<%- include('../partials/sidebar', { page: 'chat', user: user }) %>

<style>
  .cm-badge { display:inline-flex; align-items:center; padding:2px 8px; border-radius:2px; font-size:0.6rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; background:var(--navy); color:var(--on-navy); }
  .cm-badge.locked { background:rgba(180,83,9,0.15); color:var(--warn); }
  .cm-badge.archived { background:rgba(107,115,128,0.15); color:var(--slate); }
  .cm-matrix-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
  .cm-flow { border:1px solid var(--border); border-radius:4px; padding:14px; background:var(--surface); }
  .cm-flow h4 { font-family:var(--font-heading); font-weight:400; font-size:1.05rem; margin-bottom:10px; text-transform:capitalize; }
  .cm-flow .row { display:flex; flex-direction:column; gap:5px; margin-bottom:10px; }
  .cm-flow input[type=text], .cm-flow select { width:100%; }

  .cm-overlay { display:none; position:fixed; inset:0; z-index:9000; background:rgba(15,27,48,0.55); backdrop-filter:blur(3px); align-items:flex-end; justify-content:center; }
  .cm-overlay.open { display:flex; }
  .cm-modal { background:var(--surface); width:min(560px,100%); height:min(80vh,720px); border-radius:10px 10px 0 0; display:flex; flex-direction:column; box-shadow:0 -8px 48px rgba(0,0,0,0.35); }
  @media(min-width:640px){ .cm-overlay{ align-items:center; } .cm-modal{ border-radius:10px; height:min(78vh,720px); } }
  .cm-head { display:flex; align-items:center; gap:10px; padding:14px 18px; border-bottom:1px solid var(--border); }
  .cm-head .star { color:var(--gold); font-size:1.1rem; }
  .cm-head .title { font-family:var(--font-heading); font-weight:400; font-size:1.15rem; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .cm-head .x { background:none; border:none; font-size:1.1rem; color:var(--slate); cursor:pointer; padding:4px 8px; }
  .cm-msgs { flex:1; overflow-y:auto; padding:16px 18px; display:flex; flex-direction:column; gap:10px; }
  .cm-row { display:flex; }
  .cm-row.user { justify-content:flex-end; }
  .cm-bubble { max-width:82%; padding:9px 13px; border-radius:8px; font-size:0.88rem; line-height:1.5; word-break:break-word; }
  .cm-row.user .cm-bubble { background:var(--navy); color:var(--on-navy); }
  .cm-row.agent .cm-bubble, .cm-row.system .cm-bubble { background:var(--ivory); color:var(--on-surface); }
  .cm-meta { font-size:0.6rem; letter-spacing:0.08em; text-transform:uppercase; color:var(--slate); margin-bottom:3px; }
  .cm-apply { margin-top:8px; }
  .cm-form { display:flex; flex-direction:column; gap:6px; margin-top:8px; min-width:220px; }
  .cm-form input { padding:8px 10px; border:1px solid var(--border); border-radius:3px; font-family:inherit; font-size:0.85rem; }
  .cm-form-done { margin-top:8px; font-size:0.78rem; color:var(--success); font-weight:600; }
  .cm-status { font-size:0.72rem; color:var(--slate); font-style:italic; padding:0 18px 4px; min-height:18px; }
  .cm-input { display:flex; gap:8px; padding:12px 18px; border-top:1px solid var(--border); }
  .cm-input input { flex:1; }
  .cm-empty { text-align:center; color:var(--slate); font-size:0.85rem; padding:32px 0; }
</style>

<div class="topbar">
  <div class="topbar-title">Chat Control</div>
  <div class="topbar-actions">
    <button class="btn btn-gold btn-sm" onclick="cmNewChat()">&#10022; New Chat</button>
  </div>
</div>

<div class="content">
  <% if (saved) { %><div class="alert alert-success">Saved.</div><% } %>
  <% if (error) { %><div class="alert alert-error">Something went wrong.</div><% } %>

  <div class="card" style="margin-bottom:16px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <div>
        <div style="font-weight:600;font-size:0.9rem;color:var(--on-surface);">Agent replies <span class="cm-badge" style="background:rgba(201,168,72,0.18);color:var(--badge-accent);">experimental</span></div>
        <div style="font-size:0.75rem;color:var(--slate);margin-top:3px;">When on, an enabled thread's agent will reply in chat. Transport (send/receive/persist) works either way.</div>
      </div>
      <form method="POST" action="/admin/settings">
        <input type="hidden" name="chatbotEnabled" value="<%= chatbotEnabled ? 'false' : 'on' %>">
        <button class="btn <%= chatbotEnabled ? 'btn-ghost' : 'btn-navy' %> btn-sm" type="submit">
          <%= chatbotEnabled ? 'Turn OFF' : 'Turn ON' %>
        </button>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;">
      <span>Threads</span>
      <span style="font-size:0.7rem;font-weight:400;">
        <% ['active','locked','archived'].forEach(s => { %>
          <a href="/admin/chat?status=<%= s %>" style="margin-left:10px;text-decoration:none;color:<%= status===s ? 'var(--navy)' : 'var(--slate)' %>;<%= status===s ? 'font-weight:600;' : '' %>"><%= s %></a>
        <% }) %>
      </span>
    </div>
    <% if (!threads.length) { %>
      <div class="cm-empty">No <%= status %> threads. Click <strong>&#10022; New Chat</strong> to start one.</div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Title</th><th>Kind</th><th>Members</th><th>Updated</th><th></th></tr></thead>
        <tbody>
        <% threads.forEach(t => { %>
          <tr>
            <td><%= t.title || '(untitled)' %><% if (t.lastMessagePreview) { %><div style="font-size:0.72rem;color:var(--slate);">&ldquo;<%= t.lastMessagePreview.slice(0,60) %>&rdquo;</div><% } %></td>
            <td><span class="cm-badge"><%= t.kind %></span></td>
            <td><%= (t.members || []).length %></td>
            <td style="font-size:0.75rem;color:var(--slate);"><%= t.lastMessageAt ? new Date(t.lastMessageAt).toLocaleString() : '' %></td>
            <td style="text-align:right;white-space:nowrap;">
              <button class="btn btn-gold btn-sm" onclick="cmOpen('<%= t._id %>', <%= JSON.stringify(t.title || 'Chat') %>)">Open</button>
              <% if (t.status !== 'archived') { %>
                <button class="btn btn-ghost btn-sm" onclick="cmSetStatus('<%= t._id %>','archived')">Archive</button>
              <% } else { %>
                <button class="btn btn-ghost btn-sm" onclick="cmSetStatus('<%= t._id %>','active')">Restore</button>
              <% } %>
              <button class="btn btn-danger btn-sm" onclick="cmDelete('<%= t._id %>')">Delete</button>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="card mt-24" id="matrix">
    <div class="card-title">Chatflow Matrix</div>
    <p style="font-size:0.8rem;color:var(--slate);margin-bottom:14px;">Per thread kind: which agent answers, on which engine. Engines marked coming-soon fall back to House.</p>
    <div class="cm-matrix-grid">
      <% kinds.forEach(kind => { const cfg = Object.assign({}, defaultAgent, matrix[kind] || {}); %>
      <form class="cm-flow" method="POST" action="/admin/chat/flow/<%= kind %>">
        <h4><%= kind %></h4>
        <div class="form-check" style="margin-bottom:10px;">
          <input type="checkbox" id="en-<%= kind %>" name="enabled" value="true" <%= cfg.enabled ? 'checked' : '' %>>
          <label for="en-<%= kind %>">Agent enabled</label>
        </div>
        <div class="form-check" style="margin-bottom:10px;">
          <input type="checkbox" id="cc-<%= kind %>" name="captureContact" value="true" <%= cfg.captureContact ? 'checked' : '' %>>
          <label for="cc-<%= kind %>">Capture contact (name / phone / email)</label>
        </div>
        <div class="row"><label>Agent name</label><input type="text" name="agentKey" value="<%= cfg.agentKey || '' %>"></div>
        <div class="row"><label>Mode</label>
          <select name="mode">
            <option value="chat" <%= cfg.mode!=='router' ? 'selected' : '' %>>Converse</option>
            <option value="router" <%= cfg.mode==='router' ? 'selected' : '' %>>Act (route + propose changes)</option>
          </select>
        </div>
        <div class="row"><label>Engine</label>
          <select name="engine">
            <% engines.forEach(e => { %>
              <option value="<%= e.key %>" <%= cfg.engine===e.key ? 'selected' : '' %>><%= e.label %><%= e.ready ? '' : ' (soon)' %></option>
            <% }) %>
          </select>
        </div>
        <div class="row"><label>Greeting / persona note</label><input type="text" name="greeting" value="<%= cfg.greeting || '' %>"></div>
        <button class="btn btn-navy btn-sm" type="submit">Save</button>
      </form>
      <% }) %>
    </div>
  </div>
</div>

</div><!-- .main -->
</div><!-- .layout -->

<div class="cm-overlay" id="cmOverlay">
  <div class="cm-modal">
    <div class="cm-head">
      <span class="star">&#10022;</span>
      <span class="title" id="cmTitle">Chat</span>
      <button class="x" onclick="cmClose()" title="Close">&times;</button>
    </div>
    <div class="cm-msgs" id="cmMsgs"></div>
    <div class="cm-status" id="cmStatus"></div>
    <div class="cm-input">
      <input type="text" id="cmInput" placeholder="Type a message…" autocomplete="off" disabled>
      <button class="btn btn-navy btn-sm" id="cmSend" onclick="cmSend()" disabled>Send</button>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const TENANT_DB = <%- JSON.stringify(tenantDb || '') %>;
let cmSocket = null, cmThread = null, cmTyping = null;

function cmEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function cmConnect(){
  if (cmSocket) return cmSocket;
  cmSocket = io('/chat', { path: '/socket.io', withCredentials: true });
  cmSocket.on('connect', () => { cmStatusMsg(''); if (cmThread) cmSocket.emit('chat:join', { threadId: cmThread, db: TENANT_DB }); });
  cmSocket.on('connect_error', e => cmStatusMsg('Reconnecting… (' + (e.message||e) + ')'));
  cmSocket.on('chat:error', d => cmStatusMsg(d.message || 'Error'));
  cmSocket.on('chat:joined', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    document.getElementById('cmMsgs').innerHTML = '';
    (d.messages||[]).forEach(cmRender);
    const inp = document.getElementById('cmInput'), snd = document.getElementById('cmSend');
    inp.disabled = !d.canWrite; snd.disabled = !d.canWrite;
    cmStatusMsg(d.canWrite ? '' : 'This thread is ' + d.status + '.');
    inp.focus(); cmScroll();
  });
  cmSocket.on('chat:message', m => { if (String(m.threadId)===String(cmThread)) { cmRender(m); cmScroll(); } });
  cmSocket.on('chat:agent-status', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    cmStatusMsg(d.state==='thinking' ? 'Agent is thinking…' : '');
  });
  cmSocket.on('chat:contact-saved', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    document.querySelectorAll('.cm-form').forEach(w => { w.innerHTML = '<div class="cm-form-done">Contact received \u2713</div>'; });
    window._cmPendingFormBtn = null;
  });
  cmSocket.on('chat:error', () => {
    const b = window._cmPendingFormBtn;
    if (b) { b.disabled = false; b.textContent = 'Send contact info'; window._cmPendingFormBtn = null; }
  });
  cmSocket.on('chat:typing', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    cmStatusMsg(d.state==='start' ? (d.name||'Someone') + ' is typing…' : '');
  });
  return cmSocket;
}

function cmStatusMsg(t){ document.getElementById('cmStatus').textContent = t || ''; }
function cmScroll(){ const b=document.getElementById('cmMsgs'); b.scrollTop=b.scrollHeight; }

function cmRender(m){
  const box = document.getElementById('cmMsgs');
  const role = m.authorType==='user' ? 'user' : (m.authorType==='system' ? 'system' : 'agent');
  const row = document.createElement('div'); row.className = 'cm-row ' + role;
  let inner = '<div class="cm-bubble">';
  if (role!=='user') inner += '<div class="cm-meta">'+cmEsc(m.authorName||'Agent')+'</div>';
  inner += cmEsc(m.body).replace(/\n/g,'<br>');
  const fill = m.meta && m.meta.fill;
  if (fill && Object.keys(fill).length && m.meta.department) {
    inner += '<div class="cm-apply"><button class="btn btn-gold btn-sm" onclick=\'cmApply('+JSON.stringify(m.meta.department)+','+JSON.stringify(fill)+', this)\'>Apply to '+cmEsc(m.meta.department)+'</button></div>';
  }
  const form = m.meta && m.meta.form;
  if (form && form.id === 'contact') {
    if (form.done) {
      inner += '<div class="cm-form-done">Contact received \u2713</div>';
    } else {
      inner += '<div class="cm-form" data-mid="'+cmEsc(m._id||'')+'">';
      (form.fields||[]).forEach(f => {
        inner += '<input data-key="'+cmEsc(f.key)+'" type="'+cmEsc(f.type||'text')+'" placeholder="'+cmEsc(f.label)+(f.required?' *':'')+'" autocomplete="off">';
      });
      inner += '<button class="btn btn-gold btn-sm" onclick="cmFormSubmit(this)">Send contact info</button></div>';
    }
  }
  if (m.meta && m.meta.navigate) {
    inner += '<div class="cm-apply"><a class="btn btn-ghost btn-sm" href="'+cmEsc(m.meta.navigate)+'">Go</a></div>';
  }
  inner += '</div>';
  row.innerHTML = inner;
  box.appendChild(row);
}

async function cmApply(department, fill, btn){
  btn.disabled = true; btn.textContent = 'Applying…';
  try {
    const r = await fetch('/admin/master-agent/execute', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ department, fill, label: fill.heading || fill.title })
    });
    const d = await r.json();
    btn.textContent = d.ok ? 'Applied \u2713' : 'Failed';
    if (d.ok && d.editUrl) { const a=document.createElement('a'); a.href=d.editUrl; a.textContent=' View \u2192'; a.style.color='var(--gold)'; btn.after(a); }
  } catch(e){ btn.textContent='Failed'; btn.disabled=false; }
}

function cmFormSubmit(btn){
  const wrap = btn.closest('.cm-form');
  if (!wrap || !cmThread) return;
  const values = {};
  wrap.querySelectorAll('input[data-key]').forEach(i => values[i.dataset.key] = i.value);
  btn.disabled = true; btn.textContent = 'Sending\u2026';
  window._cmPendingFormBtn = btn;
  cmConnect().emit('chat:form-submit', { threadId: cmThread, values, formMessageId: wrap.dataset.mid || null });
}

function cmOpen(threadId, title){
  cmThread = threadId;
  document.getElementById('cmTitle').textContent = title || 'Chat';
  document.getElementById('cmMsgs').innerHTML = '<div class="cm-empty">Loading\u2026</div>';
  document.getElementById('cmOverlay').classList.add('open');
  cmConnect().emit('chat:join', { threadId, db: TENANT_DB });
}

function cmClose(){
  document.getElementById('cmOverlay').classList.remove('open');
  if (cmSocket && cmThread) cmSocket.emit('chat:leave', { threadId: cmThread });
  cmThread = null;
}

function cmSend(){
  const inp = document.getElementById('cmInput');
  const body = inp.value.trim();
  if (!body || !cmThread) return;
  cmConnect().emit('chat:message', { threadId: cmThread, body });
  inp.value = '';
}

async function cmNewChat(){
  const title = prompt('Name this chat (e.g. "Design help"):', 'Agent chat');
  if (title === null) return;
  try {
    const r = await fetch('/admin/chat/threads', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ kind:'agent', title: title || 'Agent chat' })
    });
    const d = await r.json();
    if (d.ok && d.thread) cmOpen(d.thread._id, d.thread.title);
    else alert('Could not create thread: ' + (d.error||'unknown'));
  } catch(e){ alert('Create failed.'); }
}

async function cmSetStatus(id, status){
  await fetch('/admin/chat/threads/'+id+'/status', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ status }) });
  location.reload();
}
async function cmDelete(id){
  if (!confirm('Delete this thread and all its messages? This cannot be undone.')) return;
  await fetch('/admin/chat/threads/'+id+'/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({}) });
  location.reload();
}

(function(){
  const inp = document.getElementById('cmInput');
  inp.addEventListener('keydown', e => { if (e.key==='Enter'){ e.preventDefault(); cmSend(); } });
  inp.addEventListener('input', () => {
    if (!cmSocket || !cmThread) return;
    cmSocket.emit('chat:typing', { threadId: cmThread, state:'start' });
    clearTimeout(cmTyping);
    cmTyping = setTimeout(() => cmSocket.emit('chat:typing', { threadId: cmThread, state:'stop' }), 1200);
  });
  document.getElementById('cmOverlay').addEventListener('click', e => { if (e.target.id==='cmOverlay') cmClose(); });
})();
</script>
</body>
</html>
