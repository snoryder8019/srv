<%- include('../partials/head', { title: 'Chat Control' }) %>
<%- include('../partials/sidebar', { page: 'chat', user: user }) %>

<style>
  .cm-badge { display:inline-flex; align-items:center; padding:2px 8px; border-radius:2px; font-size:0.6rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; background:var(--navy); color:var(--on-navy); }
  .cm-badge.locked { background:rgba(180,83,9,0.15); color:var(--warn); }
  .cm-badge.archived { background:rgba(107,115,128,0.15); color:var(--slate); }
  .cm-matrix-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px; }
  .ag-cat { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--slate); font-weight:600; margin:16px 0 8px; }
  .ag-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:10px; margin-bottom:6px; }
  .ag-card { border:1px solid var(--border); border-radius:4px; padding:10px 12px; background:var(--surface); }
  .ag-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:5px; }
  .ag-name { font-weight:600; font-size:0.9rem; color:var(--on-surface); }
  .ag-desc { font-size:0.74rem; color:var(--slate); line-height:1.4; margin-bottom:6px; }
  .ag-tool { font-size:0.66rem; color:var(--placeholder); }
  .ag-tool span { text-transform:uppercase; letter-spacing:0.07em; margin-right:4px; }
  .ag-tool code { font-size:0.68rem; color:var(--navy); background:rgba(0,0,0,0.04); padding:1px 5px; border-radius:3px; }
  .ag-cfg { display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-top:8px; padding-top:8px; border-top:1px solid var(--border); }
  .ag-cfg .ag-on { display:inline-flex; align-items:center; gap:4px; font-size:0.7rem; color:var(--slate); text-transform:uppercase; letter-spacing:0.05em; }
  .ag-cfg select { flex:1 1 auto; min-width:96px; font-size:0.7rem; padding:3px 5px; }
  .ag-cfg .btn { flex:0 0 auto; }
  .ag-default { display:flex; flex-wrap:wrap; align-items:flex-end; gap:12px; margin:10px 0 16px; padding:14px; border:1px solid var(--badge-accent,var(--border)); border-radius:6px; background:rgba(201,168,72,0.07); }
  .ag-default-label { flex:1 1 100%; font-size:0.78rem; color:var(--on-surface); line-height:1.45; }
  .ag-default label { display:inline-flex; flex-direction:column; gap:3px; font-size:0.6rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--slate); font-weight:600; }
  .ag-default select { font-size:0.78rem; padding:4px 7px; min-width:200px; }
  .ag-default .btn { align-self:flex-end; }
  .cm-flow { border:1px solid var(--border); border-radius:4px; padding:14px; background:var(--surface); }
  .cm-flow h4 { font-family:var(--font-heading); font-weight:400; font-size:1.05rem; margin-bottom:10px; text-transform:capitalize; }
  .cm-flow .row { display:flex; flex-direction:column; gap:5px; margin-bottom:10px; }
  .cm-flow input[type=text], .cm-flow select { width:100%; }
  .cm-head { margin-bottom:14px; padding-bottom:12px; border-bottom:1px solid var(--border); }
  .cm-head-top { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:7px; }
  .cm-flow .cm-head-top h4 { margin:0; font-size:1.08rem; text-transform:none; line-height:1.2; }
  .cm-badge.cm-public, .cm-badge.cm-private { flex:0 0 auto; font-size:0.56rem; font-weight:600; letter-spacing:0.1em; padding:2px 8px; border-radius:10px; }
  .cm-badge.cm-public { background:rgba(185,28,28,0.14); color:var(--danger,#b91c1c); }
  .cm-badge.cm-private { background:rgba(201,168,72,0.16); color:var(--badge-accent,#8a6d1f); }
  .cm-desc { font-size:0.78rem; color:var(--slate); line-height:1.5; margin:0; }

  /* Mobile-first: the chat is a full-screen surface (not a cramped bottom-sheet),
     so there's room to read and the input sits right above the keyboard. On
     tablet/desktop it becomes a centered card. */
  .cm-overlay { display:none; position:fixed; inset:0; z-index:9000; background:rgba(15,27,48,0.55); backdrop-filter:blur(3px); align-items:flex-end; justify-content:center; }
  .cm-overlay.open { display:flex; }
  /* Mobile: a comfortable bottom SHEET — not edge-to-edge. Leaves a dimmed gap at
     the top and rounds the corners so it reads as a panel, not a broken page. */
  .cm-modal { background:var(--surface); width:100%; height:82vh; height:82dvh; max-height:82dvh; border-radius:18px 18px 0 0; display:flex; flex-direction:column; box-shadow:0 -8px 48px rgba(0,0,0,0.35); }
  @media(min-width:640px){
    .cm-overlay{ align-items:center; }
    .cm-modal{ width:min(560px,100%); height:min(78vh,720px); max-height:88vh; border-radius:10px; }
  }
  /* Phone tuning: tighter chrome, tap-friendly input, iOS safe-area at the bottom. */
  @media(max-width:639px){
    .cm-head{ padding:12px 14px; }
    .cm-head .title{ font-size:1.05rem; }
    .cm-head .x{ font-size:1.4rem; padding:6px 10px; }
    .cm-controls{ padding:7px 12px !important; flex-wrap:wrap; }
    .cm-msgs{ padding:12px 14px; gap:8px; }
    .cm-status{ padding:0 14px 4px; }
    .cm-input{ padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px)); }
    .cm-input input{ min-height:44px; font-size:16px; }  /* 16px stops iOS zoom-on-focus */
    .cm-input .btn{ min-height:44px; }
    .cm-bubble{ max-width:88%; }
  }
  .cm-head { display:flex; align-items:center; gap:10px; padding:14px 18px; border-bottom:1px solid var(--border); }
  .cm-head .star { color:var(--gold); font-size:1.1rem; }
  .cm-head .title { font-family:var(--font-heading); font-weight:400; font-size:1.15rem; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .cm-head .x { background:none; border:none; font-size:1.1rem; color:var(--slate); cursor:pointer; padding:4px 8px; }
  .cm-msgs { flex:1; overflow-y:auto; padding:16px 18px; display:flex; flex-direction:column; gap:10px; }
  .cm-row { display:flex; }
  .cm-row.user { justify-content:flex-end; }
  .cm-bubble { max-width:82%; padding:9px 13px; border-radius:8px; font-size:0.88rem; line-height:1.5; word-break:break-word; }
  .cm-row.user .cm-bubble { background:var(--navy); color:var(--on-navy); }
  .cm-row.agent .cm-bubble, .cm-row.system .cm-bubble { background:var(--ivory); color:var(--on-surface); }
  .cm-meta { font-size:0.6rem; letter-spacing:0.08em; text-transform:uppercase; color:var(--slate); margin-bottom:3px; }
  /* Support threads — see at a glance who's talking: the VISITOR (left, navy),
     the AI (left, muted), and YOU / a live human (right, yellow — same accent the
     public bubble uses for a live human). */
  .cm-row.guest { justify-content:flex-start; }
  .cm-row.guest .cm-bubble { background:var(--navy); color:var(--on-navy); }
  .cm-row.sai { justify-content:flex-start; }
  .cm-row.sai .cm-bubble { background:var(--ivory); color:var(--on-surface); border:1px solid var(--border,#e6e6e8); }
  .cm-row.staff { justify-content:flex-end; }
  .cm-row.staff .cm-bubble { background:var(--gold,#C9A848); color:var(--on-accent,#1a1a1a); }
  .cm-row.staff .cm-meta { text-align:right; color:var(--gold,#C9A848); }
  .cm-row.notice { justify-content:center; }
  .cm-row.notice .cm-bubble { background:#e7f6ec; color:#1b7a3d; border:1px solid #b6e0c2; font-size:0.76rem; text-align:center; }
  .cm-apply { margin-top:8px; }
  .cm-form { display:flex; flex-direction:column; gap:6px; margin-top:8px; min-width:220px; }
  .cm-form input { padding:8px 10px; border:1px solid var(--border); border-radius:3px; font-family:inherit; font-size:0.85rem; }
  .cm-form-done { margin-top:8px; font-size:0.78rem; color:var(--success); font-weight:600; }
  .cm-status { font-size:0.72rem; color:var(--slate); font-style:italic; padding:0 18px 4px; min-height:18px; }
  .cm-input { display:flex; gap:8px; padding:12px 18px; border-top:1px solid var(--border); }
  .cm-input input { flex:1; }
  .cm-empty { text-align:center; color:var(--slate); font-size:0.85rem; padding:32px 0; }
</style>

<div class="topbar">
  <div class="topbar-title">Chat Control</div>
  <div class="topbar-actions">
    <button class="btn btn-gold btn-sm" onclick="cmNewChat()">&#10022; New Chat</button>
  </div>
</div>

<div class="content">
  <% if (saved) { %><div class="alert alert-success">Saved.</div><% } %>
  <% if (error) { %><div class="alert alert-error">Something went wrong.</div><% } %>

  <div class="card" style="margin-bottom:16px;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <div>
        <div style="font-weight:600;font-size:0.9rem;color:var(--on-surface);">Agent replies <span class="cm-badge" style="background:rgba(201,168,72,0.18);color:var(--badge-accent);">experimental</span></div>
        <div style="font-size:0.75rem;color:var(--slate);margin-top:3px;">When on, an enabled thread's agent will reply in chat. Transport (send/receive/persist) works either way.</div>
      </div>
      <form method="POST" action="/admin/settings" data-guard="button">
        <input type="hidden" name="chatbotEnabled" value="<%= chatbotEnabled ? 'false' : 'on' %>">
        <button class="btn <%= chatbotEnabled ? 'btn-ghost' : 'btn-navy' %> btn-sm" type="submit">
          <%= chatbotEnabled ? 'Turn OFF' : 'Turn ON' %>
        </button>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;">
      <span>Threads</span>
      <span style="font-size:0.7rem;font-weight:400;">
        <% ['active','locked','archived'].forEach(s => { %>
          <a href="/admin/chat?status=<%= s %>" style="margin-left:10px;text-decoration:none;color:<%= status===s ? 'var(--navy)' : 'var(--slate)' %>;<%= status===s ? 'font-weight:600;' : '' %>"><%= s %></a>
        <% }) %>
      </span>
    </div>
    <% if (!threads.length) { %>
      <div class="cm-empty">No <%= status %> threads. Click <strong>&#10022; New Chat</strong> to start one.</div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Title</th><th>Kind</th><th>Members</th><th>Updated</th><th></th></tr></thead>
        <tbody>
        <% threads.forEach(t => { %>
          <tr>
            <td><%= t.title || '(untitled)' %><% if (t.lastMessagePreview) { %><div style="font-size:0.72rem;color:var(--slate);">&ldquo;<%= t.lastMessagePreview.slice(0,60) %>&rdquo;</div><% } %></td>
            <td><span class="cm-badge"><%= t.kind %></span></td>
            <td><%= (t.members || []).length %></td>
            <td style="font-size:0.75rem;color:var(--slate);"><%= t.lastMessageAt ? new Date(t.lastMessageAt).toLocaleString() : '' %></td>
            <td style="text-align:right;white-space:nowrap;">
              <button class="btn btn-gold btn-sm" onclick="cmOpen('<%= t._id %>', <%= JSON.stringify(t.title || 'Chat') %>)">Open</button>
              <% if (t.status !== 'archived') { %>
                <button class="btn btn-ghost btn-sm" onclick="cmSetStatus('<%= t._id %>','archived')">Archive</button>
              <% } else { %>
                <button class="btn btn-ghost btn-sm" onclick="cmSetStatus('<%= t._id %>','active')">Restore</button>
              <% } %>
              <button class="btn btn-danger btn-sm" onclick="cmDelete('<%= t._id %>')">Delete</button>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="card mt-24" id="agents">
    <div class="card-title">Assigned Agents</div>
    <p style="font-size:0.8rem;color:var(--slate);margin-bottom:6px;">Every agent in the system — each runs its MCP tool when routed. <strong>Public</strong> = visitor-facing (guardrailed to Support only); <strong>Private</strong> = staff/admin. Inheritance: <strong>agent override → tenant default → platform</strong>.</p>
    <form class="ag-default" method="POST" action="/admin/chat/tenant-default" data-guard data-guard-label="Saving">
      <div class="ag-default-label"><strong>Tenant default</strong> — every agent below inherits this unless it sets its own. <strong>Engine is the master switch:</strong> House = free Ollama (no Claude spend); Anthropic = Claude agentic loop. Model is the default generation model.</div>
      <label>Default engine
        <select name="engine">
          <option value="" <%= !tenantDefault.engine ? 'selected':'' %>>Platform (key → Claude, else House)</option>
          <option value="house" <%= tenantDefault.engine==='house'?'selected':'' %>>House (Ollama) — free</option>
          <option value="anthropic" <%= tenantDefault.engine==='anthropic'?'selected':'' %>>Anthropic (Claude)</option>
        </select>
      </label>
      <label>Default model
        <select name="model">
          <option value="" <%= !tenantDefault.model ? 'selected':'' %>>Platform default (Opus 4.8)</option>
          <% models.forEach(function(m){ %><option value="<%= m.key %>" <%= tenantDefault.model===m.key?'selected':'' %>><%= m.label %></option><% }) %>
        </select>
      </label>
      <button class="btn btn-navy btn-sm" type="submit">Save default</button>
    </form>
    <% agentGroups.forEach(function(g){ %>
      <div class="ag-cat"><%= g.category %> <span style="color:var(--placeholder);font-weight:400;">· <%= g.agents.length %></span></div>
      <div class="ag-grid">
        <% g.agents.forEach(function(a){ %>
          <% var acfg = agentConfig[a.key] || { enabled:true, engine:'', model:'' }; %>
          <div class="ag-card">
            <div class="ag-head">
              <span class="ag-name"><%= a.label %></span>
              <span class="cm-badge cm-<%= a.scope %>"><%= a.scope==='public'?'PUBLIC':'PRIVATE' %></span>
            </div>
            <div class="ag-desc"><%= a.desc %></div>
            <div class="ag-tool"><span>tool</span> <code><%= a.tool %></code></div>
            <form class="ag-cfg" method="POST" action="/admin/chat/agent-config/<%= a.key %>" data-guard data-guard-label="Saving">
              <label class="ag-on"><input type="checkbox" name="enabled" value="true" <%= acfg.enabled!==false ? 'checked':'' %>> on</label>
              <select name="engine" title="Engine for this agent">
                <option value="" <%= !acfg.engine ? 'selected':'' %>>Engine: inherit</option>
                <option value="house" <%= acfg.engine==='house'?'selected':'' %>>House</option>
                <option value="anthropic" <%= acfg.engine==='anthropic'?'selected':'' %>>Anthropic</option>
              </select>
              <select name="model" title="Model (when Anthropic)">
                <option value="" <%= !acfg.model ? 'selected':'' %>>Model: default</option>
                <% models.forEach(function(m){ %><option value="<%= m.key %>" <%= acfg.model===m.key?'selected':'' %>><%= m.label %></option><% }) %>
              </select>
              <button class="btn btn-navy btn-sm" type="submit">Save</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>

  <div class="card mt-24" id="matrix">
    <div class="card-title">Chatflow Matrix</div>
    <p style="font-size:0.8rem;color:var(--slate);margin-bottom:14px;"><strong>This governs GUEST CHAT THREADS</strong> (the live-guest support bubble) — <em>not</em> your admin ✦ agents, which use the Tenant Default + per-agent config above. Each <strong>kind</strong> is a distinct thread surface; configure who answers, on which engine/model, and its MCP tools. <strong>Public</strong> kinds face the outside world — scope them tightly; <strong>Private</strong> kinds are staff/admin. The two never share tools.</p>
    <div class="cm-matrix-grid">
      <% kinds.forEach(kind => { const cfg = Object.assign({}, defaultAgent, matrix[kind] || {}); const km = kindMeta[kind] || { label: kind, scope: 'private', who: '', where: '', desc: '' }; %>
      <form class="cm-flow" method="POST" action="/admin/chat/flow/<%= kind %>" data-guard data-guard-label="Saving">
        <div class="cm-head" title="Who: <%= km.who %>&#10;Where: <%= km.where %>">
          <div class="cm-head-top">
            <h4><%= km.label %></h4>
            <span class="cm-badge cm-<%= km.scope %>"><%= km.scope === 'public' ? 'PUBLIC' : 'PRIVATE' %></span>
          </div>
          <% if (km.desc) { %><p class="cm-desc"><%= km.desc %></p><% } %>
        </div>
        <div class="form-check" style="margin-bottom:10px;">
          <input type="checkbox" id="en-<%= kind %>" name="enabled" value="true" <%= cfg.enabled ? 'checked' : '' %>>
          <label for="en-<%= kind %>">Agent enabled</label>
        </div>
        <div class="form-check" style="margin-bottom:10px;">
          <input type="checkbox" id="cc-<%= kind %>" name="captureContact" value="true" <%= cfg.captureContact ? 'checked' : '' %>>
          <label for="cc-<%= kind %>">Capture contact (name / phone / email)</label>
        </div>
        <div class="row"><label>Agent name</label><input type="text" name="agentKey" value="<%= cfg.agentKey || '' %>"></div>
        <div class="row"><label>Mode</label>
          <select name="mode">
            <option value="chat" <%= cfg.mode!=='router' ? 'selected' : '' %>>Converse</option>
            <option value="router" <%= cfg.mode==='router' ? 'selected' : '' %>>Act (route + propose changes)</option>
          </select>
        </div>
        <div class="row"><label>Engine</label>
          <select name="engine">
            <% engines.forEach(e => { %>
              <option value="<%= e.key %>" <%= cfg.engine===e.key ? 'selected' : '' %>><%= e.label %><%= e.ready ? '' : ' (soon)' %></option>
            <% }) %>
          </select>
        </div>
        <div class="row"><label>Model <span style="text-transform:none;letter-spacing:0;color:var(--slate);font-weight:400;">(when engine = Anthropic)</span></label>
          <select name="model">
            <option value="" <%= !cfg.model ? 'selected' : '' %>>Default (Opus 4.8)</option>
            <% models.forEach(m => { %>
              <option value="<%= m.key %>" <%= cfg.model===m.key ? 'selected' : '' %>><%= m.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="row"><label>MCP tool scope <span style="text-transform:none;letter-spacing:0;color:var(--slate);font-weight:400;">(router mode; empty = all this agent's audience allows)</span></label>
          <div style="max-height:132px;overflow:auto;border:1px solid var(--border);border-radius:4px;padding:8px;display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;">
            <% tools.forEach(t => { %>
              <label style="display:flex;gap:6px;align-items:center;font-size:0.78rem;text-transform:none;letter-spacing:0;font-weight:400;color:var(--on-surface);" title="<%= t.description %>">
                <input type="checkbox" name="tools" value="<%= t.name %>" <%= (cfg.tools||[]).includes(t.name) ? 'checked' : '' %>>
                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= t.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
        <div class="row"><label>Greeting / persona note</label><input type="text" name="greeting" value="<%= cfg.greeting || '' %>"></div>
        <button class="btn btn-navy btn-sm" type="submit">Save</button>
      </form>
      <% }) %>
    </div>
  </div>
</div>

</div><!-- .main -->
</div><!-- .layout -->

<div class="cm-overlay" id="cmOverlay">
  <div class="cm-modal">
    <div class="cm-head">
      <span class="star">&#10022;</span>
      <span class="title" id="cmTitle">Chat</span>
      <button class="x" onclick="cmClose()" title="Close">&times;</button>
    </div>
    <div class="cm-controls" id="cmControls" style="display:none;gap:6px;padding:8px 12px;border-bottom:1px solid var(--border,#e6e6e8);align-items:center;">
      <button class="btn btn-sm btn-gold" id="cmTakeover" onclick="cmToggleTakeover()" type="button">Take over</button>
      <button class="btn btn-sm btn-ghost" id="cmHoneypot" onclick="cmToggleHoneypot()" type="button" title="Flag a suspected bot / scanner — silences the assistant and stops lead alerts">Honeypot</button>
      <span id="cmModeTag" style="font-size:.72rem;color:var(--muted,#8a8a8a);margin-left:auto;"></span>
    </div>
    <div class="cm-msgs" id="cmMsgs"></div>
    <div class="cm-status" id="cmStatus"></div>
    <div class="cm-input">
      <input type="text" id="cmInput" placeholder="Type a message…" autocomplete="off" disabled>
      <button class="btn btn-navy btn-sm" id="cmSend" onclick="cmSend()" disabled>Send</button>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const TENANT_DB = <%- JSON.stringify(tenantDb || '') %>;
let cmSocket = null, cmThread = null, cmTyping = null;
let cmTakeoverOn = false, cmHoneypotOn = false, cmKind = '';

function cmEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function cmConnect(){
  if (cmSocket) return cmSocket;
  cmSocket = io('/chat', { path: '/socket.io', withCredentials: true });
  cmSocket.on('connect', () => { cmStatusMsg(''); if (cmThread) cmSocket.emit('chat:join', { threadId: cmThread, db: TENANT_DB }); });
  cmSocket.on('connect_error', e => cmStatusMsg('Reconnecting… (' + (e.message||e) + ')'));
  cmSocket.on('chat:error', d => cmStatusMsg(d.message || 'Error'));
  cmSocket.on('chat:joined', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    cmKind = d.kind || '';               // set BEFORE rendering so sources classify
    cmTakeoverOn = !!d.takeover; cmHoneypotOn = !!d.honeypot;
    document.getElementById('cmMsgs').innerHTML = '';
    (d.messages||[]).forEach(cmRender);
    const inp = document.getElementById('cmInput'), snd = document.getElementById('cmSend');
    inp.disabled = !d.canWrite; snd.disabled = !d.canWrite;
    cmStatusMsg(d.canWrite ? '' : 'This thread is ' + d.status + '.');
    document.getElementById('cmControls').style.display = (cmKind === 'support') ? 'flex' : 'none';
    cmSyncMode();
    inp.focus(); cmScroll();
  });
  cmSocket.on('chat:takeover', d => { if (String(d.threadId)!==String(cmThread)) return; cmTakeoverOn = !!d.active; cmSyncMode(); });
  cmSocket.on('chat:honeypot', d => { if (String(d.threadId)!==String(cmThread)) return; cmHoneypotOn = !!d.on; cmSyncMode(); });
  cmSocket.on('chat:message', m => { if (String(m.threadId)===String(cmThread)) { cmRender(m); cmScroll(); } });
  cmSocket.on('chat:agent-status', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    cmStatusMsg(d.state==='thinking' ? 'Agent is thinking…' : '');
  });
  cmSocket.on('chat:contact-saved', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    document.querySelectorAll('.cm-form').forEach(w => { w.innerHTML = '<div class="cm-form-done">Contact received \u2713</div>'; });
    window._cmPendingFormBtn = null;
  });
  cmSocket.on('chat:error', () => {
    const b = window._cmPendingFormBtn;
    if (b) { b.disabled = false; b.textContent = 'Send contact info'; window._cmPendingFormBtn = null; }
  });
  cmSocket.on('chat:typing', d => {
    if (String(d.threadId)!==String(cmThread)) return;
    cmStatusMsg(d.state==='start' ? (d.name||'Someone') + ' is typing…' : '');
  });
  return cmSocket;
}

function cmStatusMsg(t){ document.getElementById('cmStatus').textContent = t || ''; }
function cmScroll(){ const b=document.getElementById('cmMsgs'); b.scrollTop=b.scrollHeight; }

function cmRender(m){
  const box = document.getElementById('cmMsgs');
  // On a SUPPORT thread, split by source so you can see where you're replying:
  //   guest  = the visitor (left, navy)
  //   sai    = the AI concierge (left, muted)
  //   staff  = you / a live human (right, yellow)
  //   notice = green join/leave line
  // Other thread kinds keep the original user/agent/system layout.
  let role;
  const evt = m.meta && m.meta.event;
  if (cmKind === 'support') {
    if (m.authorType === 'agent') role = 'sai';
    else if (m.authorType === 'system') role = (evt === 'admin-join' || evt === 'admin-leave') ? 'notice' : 'system';
    else role = (m.authorId || (m.meta && m.meta.staff)) ? 'staff' : 'guest';
  } else {
    role = m.authorType==='user' ? 'user' : (m.authorType==='system' ? 'system' : 'agent');
  }
  const row = document.createElement('div'); row.className = 'cm-row ' + role;
  let inner = '<div class="cm-bubble">';
  const showMeta = role !== 'user' && role !== 'notice';
  if (showMeta) inner += '<div class="cm-meta">'+cmEsc(role==='sai' ? ('AI · '+(m.authorName||'Support')) : (m.authorName||'Agent'))+'</div>';
  inner += cmEsc(m.body).replace(/\n/g,'<br>');
  const fill = m.meta && m.meta.fill;
  if (fill && Object.keys(fill).length && m.meta.department) {
    inner += '<div class="cm-apply"><button class="btn btn-gold btn-sm" onclick=\'cmApply('+JSON.stringify(m.meta.department)+','+JSON.stringify(fill)+', this)\'>Apply to '+cmEsc(m.meta.department)+'</button></div>';
  }
  const form = m.meta && m.meta.form;
  if (form && form.id === 'contact') {
    if (form.done) {
      inner += '<div class="cm-form-done">Contact received \u2713</div>';
    } else {
      inner += '<div class="cm-form" data-mid="'+cmEsc(m._id||'')+'">';
      (form.fields||[]).forEach(f => {
        inner += '<input data-key="'+cmEsc(f.key)+'" type="'+cmEsc(f.type||'text')+'" placeholder="'+cmEsc(f.label)+(f.required?' *':'')+'" autocomplete="off">';
      });
      inner += '<button class="btn btn-gold btn-sm" onclick="cmFormSubmit(this)">Send contact info</button></div>';
    }
  }
  if (m.meta && m.meta.navigate) {
    inner += '<div class="cm-apply"><a class="btn btn-ghost btn-sm" href="'+cmEsc(m.meta.navigate)+'">Go</a></div>';
  }
  inner += '</div>';
  row.innerHTML = inner;
  box.appendChild(row);
}

async function cmApply(department, fill, btn){
  btn.disabled = true; btn.textContent = 'Applying…';
  try {
    const r = await fetch('/admin/master-agent/execute', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ department, fill, label: fill.heading || fill.title })
    });
    const d = await r.json();
    btn.textContent = d.ok ? 'Applied \u2713' : 'Failed';
    if (d.ok) { window.SlabFlash && SlabFlash.success('Applied.'); }
    else { window.SlabFlash && SlabFlash.error(d.error || 'Apply failed.'); }
    if (d.ok && d.editUrl) { const a=document.createElement('a'); a.href=d.editUrl; a.textContent=' View \u2192'; a.style.color='var(--gold)'; btn.after(a); }
  } catch(e){ btn.textContent='Failed'; btn.disabled=false; window.SlabFlash && SlabFlash.error('Apply failed \u2014 network error.'); }
}

function cmFormSubmit(btn){
  const wrap = btn.closest('.cm-form');
  if (!wrap || !cmThread) return;
  const values = {};
  wrap.querySelectorAll('input[data-key]').forEach(i => values[i.dataset.key] = i.value);
  btn.disabled = true; btn.textContent = 'Sending\u2026';
  window._cmPendingFormBtn = btn;
  cmConnect().emit('chat:form-submit', { threadId: cmThread, values, formMessageId: wrap.dataset.mid || null });
}

function cmOpen(threadId, title){
  cmThread = threadId;
  document.getElementById('cmTitle').textContent = title || 'Chat';
  document.getElementById('cmMsgs').innerHTML = '<div class="cm-empty">Loading\u2026</div>';
  document.getElementById('cmOverlay').classList.add('open');
  cmConnect().emit('chat:join', { threadId, db: TENANT_DB });
}

function cmClose(){
  document.getElementById('cmOverlay').classList.remove('open');
  if (cmSocket && cmThread) cmSocket.emit('chat:leave', { threadId: cmThread });
  cmThread = null;
  document.getElementById('cmControls').style.display = 'none';
}

// Takeover / honeypot controls (support threads). The server flips the state,
// broadcasts it, and posts the guest-facing notice; we just reflect the result.
function cmSyncMode(){
  const tb = document.getElementById('cmTakeover'), hb = document.getElementById('cmHoneypot'), tag = document.getElementById('cmModeTag');
  if (!tb) return;
  tb.textContent = cmTakeoverOn ? 'Hand back to AI' : 'Take over';
  tb.classList.toggle('btn-gold', !cmTakeoverOn);
  tb.classList.toggle('btn-navy', cmTakeoverOn);
  hb.textContent = cmHoneypotOn ? 'Clear honeypot' : 'Honeypot';
  hb.classList.toggle('btn-danger', cmHoneypotOn);
  tag.textContent = cmHoneypotOn ? 'Honeypot — assistant silenced'
    : (cmTakeoverOn ? 'You have the chat — AI paused' : 'AI is answering');
}
function cmToggleTakeover(){ if (!cmThread) return; cmConnect().emit('chat:takeover', { threadId: cmThread, on: !cmTakeoverOn }); }
function cmToggleHoneypot(){ if (!cmThread) return; cmConnect().emit('chat:honeypot', { threadId: cmThread, on: !cmHoneypotOn }); }

function cmSend(){
  const inp = document.getElementById('cmInput');
  const body = inp.value.trim();
  if (!body || !cmThread) return;
  cmConnect().emit('chat:message', { threadId: cmThread, body });
  inp.value = '';
}

async function cmNewChat(){
  const title = prompt('Name this chat (e.g. "Design help"):', 'Agent chat');
  if (title === null) return;
  try {
    const r = await fetch('/admin/chat/threads', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ kind:'agent', title: title || 'Agent chat' })
    });
    const d = await r.json();
    if (d.ok && d.thread) cmOpen(d.thread._id, d.thread.title);
    else (window.SlabFlash ? SlabFlash.error('Could not create thread: ' + (d.error||'unknown')) : alert('Could not create thread: ' + (d.error||'unknown')));
  } catch(e){ (window.SlabFlash ? SlabFlash.error('Create failed.') : alert('Create failed.')); }
}

async function cmSetStatus(id, status){
  await fetch('/admin/chat/threads/'+id+'/status', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ status }) });
  location.reload();
}
async function cmDelete(id){
  if (!confirm('Delete this thread and all its messages? This cannot be undone.')) return;
  await fetch('/admin/chat/threads/'+id+'/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({}) });
  location.reload();
}

(function(){
  const inp = document.getElementById('cmInput');
  inp.addEventListener('keydown', e => { if (e.key==='Enter'){ e.preventDefault(); cmSend(); } });
  inp.addEventListener('input', () => {
    if (!cmSocket || !cmThread) return;
    cmSocket.emit('chat:typing', { threadId: cmThread, state:'start' });
    clearTimeout(cmTyping);
    cmTyping = setTimeout(() => cmSocket.emit('chat:typing', { threadId: cmThread, state:'stop' }), 1200);
  });
  document.getElementById('cmOverlay').addEventListener('click', e => { if (e.target.id==='cmOverlay') cmClose(); });
})();
</script>
</body>
</html>
