<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { user, page }) %>

<div class="topbar">
  <div class="topbar-title">Careers — Connectors</div>
  <div class="topbar-actions">
    <a href="/admin/careers" class="btn btn-ghost">← Postings</a>
  </div>
</div>
<div class="content">

  <p style="opacity:.75;max-width:680px;margin-bottom:8px;">
    Job boards syndicate your openings by <strong>polling a feed URL</strong> — you don't need a separate API key per board.
    Paste the URLs below into each board's feed settings and your <strong><%= openCount %></strong> open posting<%= openCount === 1 ? '' : 's' %> flow out automatically.
  </p>
  <p style="opacity:.6;font-size:.85em;margin-bottom:24px;">Feeds always reflect <em>open</em> postings only; closing a posting removes it on the board's next poll.</p>

  <div class="card" style="padding:0;overflow:hidden;margin-bottom:26px;">
    <table style="margin:0;">
      <thead><tr><th>Board</th><th>How to connect</th><th>Feed URL</th></tr></thead>
      <tbody>
        <% boards.forEach(function(b){ %>
          <tr>
            <td><strong><%= b.name %></strong><br><span class="badge" style="font-size:.7em;"><%= b.badge %></span></td>
            <td style="opacity:.8;font-size:.9em;max-width:320px;"><%= b.how %></td>
            <td>
              <div style="display:flex;gap:6px;align-items:center;">
                <input type="text" readonly value="<%= b.url %>" onclick="this.select()" style="min-width:240px;font-family:monospace;font-size:.82em;padding:6px 8px;">
                <button type="button" class="btn btn-sm btn-ghost" onclick="copyText(this,'<%= b.url %>')">Copy</button>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <h3 style="margin-bottom:10px;">All feed endpoints</h3>
  <div class="table-wrap">
    <table>
      <tbody>
        <tr><td><strong>XML job feed</strong></td><td><code><%= feeds.xml %></code></td><td style="text-align:right;"><a href="<%= feeds.xml %>" target="_blank" rel="noopener" class="btn btn-sm btn-ghost">Preview</a></td></tr>
        <tr><td><strong>RSS 2.0</strong></td><td><code><%= feeds.rss %></code></td><td style="text-align:right;"><a href="<%= feeds.rss %>" target="_blank" rel="noopener" class="btn btn-sm btn-ghost">Preview</a></td></tr>
        <tr><td><strong>Atom 1.0</strong></td><td><code><%= feeds.atom %></code></td><td style="text-align:right;"><a href="<%= feeds.atom %>" target="_blank" rel="noopener" class="btn btn-sm btn-ghost">Preview</a></td></tr>
        <tr><td><strong>Public careers page</strong></td><td><code><%= feeds.careers %></code></td><td style="text-align:right;"><a href="<%= feeds.careers %>" target="_blank" rel="noopener" class="btn btn-sm btn-ghost">Open</a></td></tr>
      </tbody>
    </table>
  </div>

  <p style="opacity:.6;font-size:.85em;margin-top:20px;">
    <strong>Google Jobs:</strong> each posting page emits <code>JobPosting</code> structured data, so Google can index roles directly —
    submit <code><%= feeds.careers %></code> in Google Search Console to speed discovery.
  </p>
  <p style="opacity:.6;font-size:.85em;margin-top:10px;">
    Applications are collected on your own site (the apply form on each posting) and land in your <a href="/admin/careers/applications">inbox</a> with résumés stored privately.
  </p>

  <hr style="margin:30px 0;border:none;border-top:1px solid var(--border,#e5e2dc);">

  <h3 style="margin-bottom:6px;">Share to LinkedIn &amp; social</h3>
  <p style="opacity:.75;max-width:680px;margin-bottom:14px;">
    Use the <strong>⤴ Share</strong> button on any open posting to cross-post it to LinkedIn (and your other channels) via your
    connected accounts — it opens the composer prefilled with the job link. Or turn on auto-announce below to post to LinkedIn automatically the first time a role goes live.
  </p>

  <% if (msg === 'announce') { %><div class="alert alert-success">Saved.</div><% } %>

  <div class="card" style="padding:18px;max-width:600px;">
    <form data-guard action="/admin/careers/connectors/announce" method="post">
      <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
        <input type="checkbox" name="enabled" value="on" <%= announce.enabled ? 'checked' : '' %> onchange="this.form.submit()" style="width:auto;">
        <span><strong>Auto-announce new openings to LinkedIn</strong></span>
      </label>
      <noscript><button type="submit" class="btn btn-sm btn-navy" style="margin-top:10px;">Save</button></noscript>
    </form>
    <p style="opacity:.65;font-size:.84em;margin-top:12px;">
      Posts once per role the first time it's marked Open (re-opening won't repost). Manual Share always works regardless.
      <% if (!announce.linkedinConnected) { %>
        <br><strong style="color:var(--danger,#8B1C1C);">No LinkedIn account connected</strong> — connect one under <a href="/admin/social">Social Media</a> for this to send.
      <% } %>
    </p>
  </div>
</div>

<script>
function copyText(btn, text){
  navigator.clipboard.writeText(text).then(function(){
    var old = btn.textContent; btn.textContent = 'Copied'; setTimeout(function(){ btn.textContent = old; }, 1200);
  });
}
</script>
