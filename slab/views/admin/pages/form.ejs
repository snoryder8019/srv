<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { user, page }) %>

<style>
/* ── Builder layout (mirrors templates/form.ejs) ── */
.builder-wrap { display:flex;height:calc(100vh - 60px);overflow:hidden; }
.builder-palette { width:200px;min-width:200px;border-right:1px solid var(--border);background:var(--surface);overflow-y:auto;padding:16px 12px;flex-shrink:0; }
.builder-center { flex:1;display:flex;flex-direction:column;overflow:hidden; }
.builder-blocks { flex:1;overflow-y:auto;padding:20px;background:color-mix(in srgb, var(--ivory) 50%, white); }
.builder-right { width:380px;min-width:380px;border-left:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;background:var(--surface); }
.builder-right-tabs { display:flex;border-bottom:1px solid var(--border); }
.builder-right-tab { flex:1;padding:10px;text-align:center;font-size:0.68rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--slate);cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s; }
.builder-right-tab.active { color:var(--navy);border-bottom-color:var(--navy); }
.builder-right-panel { flex:1;overflow-y:auto;display:none;padding:20px; }
.builder-right-panel.active { display:block; }

/* ── Block palette ── */
.palette-title { font-size:0.62rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--slate);margin-bottom:12px; }
.palette-item { display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border);border-radius:4px;margin-bottom:8px;cursor:pointer;transition:all 0.15s;background:var(--surface); }
.palette-item:hover { border-color:var(--navy-mid);background:color-mix(in srgb, var(--navy) 3%, white); }
.palette-icon { font-size:1.1rem;width:24px;text-align:center;color:var(--navy); }
.palette-label { font-size:0.78rem;font-weight:600;color:var(--on-surface); }
.palette-divider { border-top:1px solid var(--border);margin:14px 0 10px;padding-top:10px; }
.palette-mode-row { display:flex;flex-direction:column;gap:6px; }
.palette-mode-btn { display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--border);border-radius:4px;background:transparent;cursor:pointer;font-size:0.74rem;color:var(--slate);font-family:inherit;text-align:left; }
.palette-mode-btn.active { border-color:var(--navy);background:color-mix(in srgb, var(--navy) 5%, white);color:var(--navy);font-weight:600; }
.palette-mode-btn .pm-icon { font-size:0.95rem; }

/* ── Block cards ── */
.block-card { border:1px solid var(--border);border-radius:4px;margin-bottom:10px;overflow:hidden;background:var(--surface); }
.block-card-header { display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--ivory);cursor:pointer;user-select:none; }
.block-drag-handle { color:var(--slate);font-size:0.9rem;cursor:grab; }
.block-type-badge { font-size:0.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;background:var(--navy);color:#fff;padding:2px 7px;border-radius:2px; }
.block-title-text { flex:1;font-size:0.85rem;font-weight:500;color:var(--on-surface); }
.block-actions { display:flex;gap:4px;margin-left:auto; }
.block-body { padding:14px;display:flex;flex-direction:column;gap:12px; }
.block-body.collapsed { display:none; }
.block-field { display:flex;flex-direction:column;gap:5px; }
.block-field label { font-size:0.62rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--slate); }
.block-field input, .block-field textarea { width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:2px;font-family:var(--font-body);font-size:0.88rem;color:var(--on-surface);box-sizing:border-box; }
.block-field textarea { min-height:80px;resize:vertical; }
.block-empty { text-align:center;padding:60px 20px;color:var(--slate);font-size:0.9rem; }
.block-empty-icon { font-size:2rem;margin-bottom:12px;opacity:0.3; }

/* ── Form fields (right panel) ── */
.form-group { margin-bottom:16px; }
.form-label { display:block;font-size:0.62rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--slate);margin-bottom:6px; }
.form-input { width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:2px;font-family:var(--font-body);font-size:0.88rem;box-sizing:border-box;background:var(--surface);color:var(--on-surface); }
.form-input:focus { outline:none;border-color:var(--navy); }
.form-textarea { min-height:80px;resize:vertical; }
.form-select { width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:2px;font-family:var(--font-body);font-size:0.88rem;background:var(--surface); }
.form-hint { font-size:0.72rem;color:var(--slate);margin-top:4px; }
.slug-row { display:flex;align-items:center;background:var(--ivory);border:1px solid var(--border);border-radius:2px;overflow:hidden; }
.slug-row span { padding:9px 10px;font-size:0.78rem;color:var(--slate);white-space:nowrap;border-right:1px solid var(--border); }
.slug-row input { border:none;flex:1;padding:9px 10px;font-size:0.88rem;background:var(--surface); }
.slug-row input:focus { outline:none; }

/* ── HTML editor (for content-type pages) ── */
.html-editor { padding:20px;background:color-mix(in srgb, var(--ivory) 50%, white);flex:1;overflow-y:auto; }
.html-editor .tag-row { display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px; }
.html-editor textarea { width:100%;min-height:480px;padding:14px;border:1px solid var(--border);border-radius:4px;font-family:monospace;font-size:0.86rem;line-height:1.6;background:var(--surface);box-sizing:border-box; }

/* ── Agent panel ── */
.agent-btn { display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border-radius:2px;background:linear-gradient(135deg,var(--navy),var(--navy-mid));color:var(--gold-light);border:1px solid color-mix(in srgb, var(--gold) 30%, transparent);font-family:var(--font-body);font-size:0.72rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;transition:all 0.2s; }
.agent-btn:hover { border-color:color-mix(in srgb, var(--gold) 65%, transparent); }
#agentPanel { position:fixed;top:0;right:-440px;width:420px;height:100vh;background:var(--surface);border-left:1px solid var(--border);box-shadow:-8px 0 40px color-mix(in srgb, var(--navy-deep) 12%, transparent);z-index:500;display:flex;flex-direction:column;transition:right 0.3s cubic-bezier(0.4,0,0.2,1); }
#agentPanel.open { right:0; }
.ap-header { padding:18px 20px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,var(--navy-deep),var(--navy));display:flex;align-items:center;justify-content:space-between;flex-shrink:0; }
.ap-title { font-family:var(--font-heading);font-size:1.1rem;font-weight:300;color:var(--on-navy-deep);letter-spacing:0.04em; }
.ap-close { background:none;border:none;color:color-mix(in srgb, var(--on-navy-deep) 45%, transparent);font-size:1.1rem;cursor:pointer;padding:4px 8px; }
.ap-close:hover { color:var(--on-navy-deep); }
.ap-messages { flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px; }
.ap-msg { display:flex; }
.ap-msg-user { justify-content:flex-end; }
.ap-msg-agent { justify-content:flex-start; }
.ap-bubble { max-width:82%;padding:10px 14px;border-radius:6px;font-size:0.85rem;line-height:1.55;word-break:break-word; }
.ap-msg-agent .ap-bubble { background:var(--ivory);color:var(--on-surface); }
.ap-msg-user  .ap-bubble { background:var(--navy);color:var(--on-navy); }
.ap-quick { padding:0 16px 12px;display:flex;flex-wrap:wrap;gap:7px; }
.ap-footer { padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px;flex-shrink:0; }
.ap-input { flex:1;padding:9px 12px;border:1px solid var(--border);border-radius:4px;font-family:var(--font-body);font-size:0.88rem; }
.ap-input:focus { outline:none;border-color:var(--navy); }
.ap-send { padding:9px 16px;background:var(--navy);color:var(--on-navy);border:none;border-radius:4px;font-size:0.78rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer; }
.ap-send:disabled { opacity:0.5; }
.ai-filled { background:rgba(21,128,61,0.05)!important;border-color:rgba(21,128,61,0.4)!important; }

@media (max-width: 1200px) { .builder-right { width:320px;min-width:320px; } }
@media (max-width: 960px) {
  .builder-wrap { flex-direction:column;height:auto; }
  .builder-palette { width:100%;min-width:0;border-right:none;border-bottom:1px solid var(--border);display:flex;flex-wrap:wrap;gap:8px;padding:12px; }
  .palette-title { width:100%;margin-bottom:4px; }
  .palette-item { flex:1;min-width:140px; }
  .builder-center { min-height:400px; }
  .builder-right { width:100%;min-width:0;border-left:none;border-top:1px solid var(--border);max-height:600px; }
  #agentPanel { width:100%;right:-100%; }
}
</style>

<div class="topbar" style="position:sticky;top:0;z-index:10;">
  <div class="topbar-title"><%= pg && pg._id ? 'Edit Page' : 'New Page' %></div>
  <div class="topbar-actions">
    <button type="button" class="agent-btn" onclick="document.getElementById('agentPanel').classList.add('open')">✦ Page Agent</button>
    <a href="/admin/pages" class="btn btn-ghost btn-sm">← Pages</a>
    <button type="submit" form="page-form" class="btn btn-navy btn-sm"><%= pg && pg._id ? 'Save Changes' : 'Create Page' %></button>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-error" style="margin:12px 20px;"><%= error %></div>
<% } %>

<form method="POST" action="<%= pg && pg._id ? '/admin/pages/' + pg._id : '/admin/pages' %>" id="page-form">
  <input type="hidden" name="blocksJson" id="blocks-json" value="<%= pg && pg.blocks ? JSON.stringify(pg.blocks) : '[]' %>">
  <input type="hidden" name="pageType" id="pageType-field" value="<%= pg && pg.pageType ? pg.pageType : 'landing' %>">

  <div class="builder-wrap">
    <!-- ── Left: Block Palette + Mode Switcher ── -->
    <div class="builder-palette">
      <div id="palette-blocks">
        <div class="palette-title">Add Block</div>
        <%
          const paletteMeta = {
            hero:         { icon: '◆', label: 'Hero Banner' },
            text:         { icon: '¶', label: 'Text Section' },
            split:        { icon: '◫', label: 'Split Layout' },
            cta:          { icon: '▶', label: 'Call to Action' },
            cards:        { icon: '▦', label: 'Feature Cards' },
            faq:          { icon: '?', label: 'FAQ Accordion' },
            pricing:      { icon: '$', label: 'Pricing Table' },
            testimonials: { icon: '❝', label: 'Testimonials' },
            stats:        { icon: '#', label: 'Stats Row' },
            ticker:       { icon: '»', label: 'Ticker / Marquee' },
          };
          VALID_BLOCK_TYPES.forEach(type => {
            const m = paletteMeta[type] || { icon: '□', label: type };
        %>
          <div class="palette-item" onclick="addBlock('<%= type %>')" title="Add <%= m.label %>">
            <span class="palette-icon"><%= m.icon %></span>
            <span class="palette-label"><%= m.label %></span>
          </div>
        <% }) %>
      </div>

      <div class="palette-divider">
        <div class="palette-title">Page Mode</div>
        <div class="palette-mode-row">
          <button type="button" class="palette-mode-btn" id="mode-landing"  onclick="setPageType('landing')"><span class="pm-icon">◈</span> Block Builder</button>
          <button type="button" class="palette-mode-btn" id="mode-content"  onclick="setPageType('content')"><span class="pm-icon">✎</span> HTML Content</button>
          <button type="button" class="palette-mode-btn" id="mode-data-list" onclick="setPageType('data-list')"><span class="pm-icon">⊞</span> Data List</button>
        </div>
      </div>
    </div>

    <!-- ── Center: Block Stack / HTML Editor / Data-List Config ── -->
    <div class="builder-center">
      <!-- Block builder (landing) -->
      <div class="builder-blocks" id="section-landing">
        <div id="block-empty" class="block-empty" style="display:none;">
          <div class="block-empty-icon">+</div>
          <p>Click a block on the left to start building your page,<br>or open the Page Agent to generate a full layout.</p>
        </div>
        <div id="block-list"></div>
      </div>

      <!-- HTML content editor -->
      <div class="html-editor" id="section-content" style="display:none;">
        <div class="tag-row">
          <% const tags = [
            ['<p>','</p>','Paragraph'],
            ['<h2>','</h2>','Heading 2'],
            ['<h3>','</h3>','Heading 3'],
            ['<strong>','</strong>','Bold'],
            ['<em>','</em>','Italic'],
            ['<ul>\n  <li></li>\n</ul>','','List'],
            ['<a href="">','</a>','Link'],
            ['<img src="" alt="">','','Image'],
            ['<blockquote>','</blockquote>','Quote'],
          ]; %>
          <% tags.forEach(function(t) { %>
            <button type="button" class="btn btn-ghost btn-sm tag-btn"
              data-open="<%= encodeURIComponent(t[0]) %>"
              data-close="<%= encodeURIComponent(t[1]) %>"
              style="font-size:0.7rem;"><%- t[2] %></button>
          <% }); %>
        </div>
        <textarea name="content" id="field-content" rows="22" placeholder="Write page content here. HTML tags supported."><%= pg ? pg.content || '' : '' %></textarea>
      </div>

      <!-- Data list configuration -->
      <div class="html-editor" id="section-data-list" style="display:none;">
        <div style="max-width:520px;">
          <div class="form-group">
            <label class="form-label">Data Source</label>
            <select name="dataCollection" id="field-dataCollection" class="form-select">
              <option value="blog"      <%= !pg || pg.dataCollection === 'blog'      ? 'selected' : '' %>>Blog Posts</option>
              <option value="portfolio" <%= pg && pg.dataCollection === 'portfolio'   ? 'selected' : '' %>>Portfolio Items</option>
            </select>
            <div class="form-hint">Shows published items only, sorted newest first.</div>
          </div>
          <div class="form-group">
            <label class="form-label">Items Per Page</label>
            <input type="number" name="dataPageSize" id="field-dataPageSize" min="1" max="100" class="form-input" value="<%= pg && pg.dataPageSize ? pg.dataPageSize : 9 %>">
          </div>
          <div class="form-group" id="field-dataGroup-wrap" style="<%= pg && pg.dataCollection === 'portfolio' ? '' : 'display:none;' %>">
            <label class="form-label">Portfolio Group</label>
            <input type="text" name="dataGroup" id="field-dataGroup" class="form-input" value="<%= pg?.dataGroup || '' %>" placeholder="Leave blank for all groups">
            <div class="form-hint">Only show portfolio items in this group.</div>
          </div>
          <div style="margin-top:16px;padding:14px;background:var(--ivory);border-radius:4px;font-size:0.82rem;color:var(--slate);">
            <strong style="color:var(--on-surface);">How it works:</strong> This page auto-fetches and paginates your selected collection. Visitors use <code>?p=2</code>, <code>?p=3</code> to navigate. No content to write — the cards are auto-generated.
          </div>
        </div>
      </div>
    </div>

    <!-- ── Right: Details / SEO tabs ── -->
    <div class="builder-right">
      <div class="builder-right-tabs">
        <div class="builder-right-tab active" data-panel="details" onclick="switchRightPanel('details')">Details</div>
        <div class="builder-right-tab" data-panel="seo" onclick="switchRightPanel('seo')">SEO</div>
      </div>

      <!-- Details panel -->
      <div class="builder-right-panel active" id="panel-details">
        <div class="form-group">
          <label class="form-label">Page Title <span style="color:var(--danger);">*</span></label>
          <input type="text" name="title" id="field-title" class="form-input" required value="<%= pg ? pg.title || '' : '' %>" placeholder="e.g. About Us, Services, Our Work…" oninput="autoSlug(this.value)">
        </div>
        <div class="form-group">
          <label class="form-label">URL Slug</label>
          <div class="slug-row">
            <span>yoursite.com/</span>
            <input type="text" name="slug" id="slug-field" value="<%= pg ? pg.slug || '' : '' %>" placeholder="url-slug">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="draft"     <%= !pg || pg.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="published" <%= pg && pg.status === 'published' ? 'selected' : '' %>>Published</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-check" style="display:flex;align-items:center;gap:8px;font-size:0.85rem;color:var(--on-surface);text-transform:none;letter-spacing:0;">
            <input type="checkbox" name="showInNav" id="showInNav" <%= pg && pg.showInNav ? 'checked' : '' %>>
            Show in site navigation
          </label>
        </div>

        <% if (pg && pg._id) { %>
          <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:16px;display:flex;gap:8px;flex-wrap:wrap;">
            <% if (pg.status === 'published') { %>
              <a href="/<%= pg.slug %>" target="_blank" class="btn btn-ghost btn-sm">View Live →</a>
            <% } %>
            <form method="POST" action="/admin/pages/<%= pg._id %>/delete" onsubmit="return confirm('Delete this page?')" style="display:inline;">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- SEO panel -->
      <div class="builder-right-panel" id="panel-seo">
        <div class="form-group">
          <label class="form-label">Meta Title</label>
          <input type="text" name="metaTitle" id="field-metaTitle" class="form-input" value="<%= pg ? pg.metaTitle || pg.title || '' : '' %>" placeholder="Defaults to page title">
        </div>
        <div class="form-group">
          <label class="form-label">Meta Description <span style="font-weight:300;text-transform:none;letter-spacing:0;">(max 160)</span></label>
          <input type="text" name="metaDescription" id="field-metaDescription" class="form-input" value="<%= pg ? pg.metaDescription || '' : '' %>" maxlength="160" placeholder="Brief description for search engines…">
        </div>
        <div class="form-group">
          <label class="form-label">OG / Share Image URL</label>
          <input type="url" name="ogImage" class="form-input" value="<%= pg ? pg.ogImage || '' : '' %>" placeholder="https://…">
        </div>
        <div class="form-group">
          <label class="form-label">Canonical URL <span style="font-weight:300;text-transform:none;letter-spacing:0;">(override)</span></label>
          <input type="url" name="canonicalUrl" class="form-input" value="<%= pg ? pg.canonicalUrl || '' : '' %>" placeholder="Leave blank for default">
        </div>
        <div class="form-group">
          <label class="form-label">Robots Meta</label>
          <select name="robotsMeta" class="form-select">
            <% const rm = pg ? pg.robotsMeta || 'index,follow' : 'index,follow'; %>
            <option value="index,follow"     <%= rm === 'index,follow' ? 'selected' : '' %>>index, follow (default)</option>
            <option value="noindex,follow"   <%= rm === 'noindex,follow' ? 'selected' : '' %>>noindex, follow</option>
            <option value="index,nofollow"   <%= rm === 'index,nofollow' ? 'selected' : '' %>>index, nofollow</option>
            <option value="noindex,nofollow" <%= rm === 'noindex,nofollow' ? 'selected' : '' %>>noindex, nofollow</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Sitemap Priority</label>
          <input type="number" name="sitemapPriority" class="form-input" min="0" max="1" step="0.1" value="<%= pg && pg.sitemapPriority != null ? pg.sitemapPriority : 0.5 %>">
          <div class="form-hint">0.0 (low) → 1.0 (high). Default: 0.5</div>
        </div>
        <div class="form-group">
          <label class="form-label">Change Frequency</label>
          <select name="sitemapChangefreq" class="form-select">
            <% const cf = pg ? pg.sitemapChangefreq || 'monthly' : 'monthly'; %>
            <% ['always','hourly','daily','weekly','monthly','yearly','never'].forEach(function(v) { %>
              <option value="<%= v %>" <%= cf === v ? 'selected' : '' %>><%= v.charAt(0).toUpperCase() + v.slice(1) %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>
  </div>
</form>

<!-- ── Agent Panel ── -->
<div id="agentPanel">
  <div class="ap-header">
    <span class="ap-title">✦ Page Agent</span>
    <button class="ap-close" onclick="document.getElementById('agentPanel').classList.remove('open')">✕</button>
  </div>
  <div class="ap-messages" id="ap-messages">
    <div class="ap-msg ap-msg-agent">
      <div class="ap-bubble">Tell me what this page is for — I'll write the content, suggest a block layout, or help with SEO.</div>
    </div>
  </div>
  <div class="ap-quick" id="ap-quick"></div>
  <script>
  (function(){
    const brand = <%- JSON.stringify({ name: brand?.name||'', location: brand?.location||'', businessType: brand?.businessType||'', services: brand?.services||[], serviceArea: brand?.serviceArea||'' }) %>;
    const biz = brand.name || 'the business';
    const bizType = brand.businessType || 'business';
    const svcList = brand.services.length ? brand.services.join(', ') : 'your main services';
    const loc = brand.location || '';
    const area = brand.serviceArea || '';
    const pool = [
      { label: 'About Us', prompt: `Write an About Us page for ${biz}` },
      { label: 'Services', prompt: `Write a Services page listing ${svcList}` },
      { label: 'Privacy Policy', prompt: `Write a Privacy Policy page for a ${bizType} website` },
      { label: 'Landing Page', prompt: `Build a landing page for ${biz} with hero, feature cards, and a CTA` },
      { label: 'Contact', prompt: `Write a Contact page with${loc ? ' our '+loc+' location and' : ''} ${area||'service area'} information` },
      { label: 'FAQ', prompt: `Write an FAQ page answering common questions about ${svcList}` },
      { label: 'Testimonials', prompt: `Write a Testimonials/Reviews page layout for ${biz}` },
      { label: 'Careers', prompt: `Write a Careers/Join Our Team page for ${biz}` },
    ];
    for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}
    const el=document.getElementById('ap-quick');
    let idx=0;
    function render(){
      el.innerHTML='';
      const batch=pool.slice(idx,idx+5);
      if(batch.length<5) batch.push(...pool.slice(0,5-batch.length));
      batch.forEach(s=>{
        const b=document.createElement('button');b.type='button';b.className='btn btn-ghost btn-sm ap-quick-btn';b.dataset.prompt=s.prompt;b.textContent=s.label;
        b.onclick=()=>{document.getElementById('ap-input').value=s.prompt;apSend();};
        el.appendChild(b);
      });
      const cyc=document.createElement('button');cyc.type='button';cyc.className='btn btn-ghost btn-sm';cyc.style.cssText='opacity:0.5;font-size:0.7rem;';cyc.textContent='♻';cyc.title='More suggestions';
      cyc.onclick=(e)=>{e.stopPropagation();idx=(idx+3)%pool.length;render();};
      el.appendChild(cyc);
    }
    render();
  })();
  </script>
  <div class="ap-footer">
    <input class="ap-input" id="ap-input" placeholder="Describe the page…" autocomplete="off">
    <button type="button" class="ap-send" id="ap-send" onclick="apSend()">Send</button>
  </div>
</div>

<script>
// ── Block catalog from server ─────────────────────────────────────────────────
const BLOCK_FIELDS = <%- BLOCK_FIELDS %>;
const BLOCK_DEFAULTS = <%- BLOCK_DEFAULTS %>;
const BLOCK_META = <%- BLOCK_META %>;

function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// ── Slug auto-gen ─────────────────────────────────────────────────────────────
let slugEdited = <%= pg && pg.slug ? 'true' : 'false' %>;
function toSlug(s) { return s.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,''); }
function autoSlug(v) { if (!slugEdited) document.getElementById('slug-field').value = toSlug(v); }
document.getElementById('slug-field').addEventListener('input', () => { slugEdited = true; });

// ── Page mode (landing / content / data-list) ────────────────────────────────
function setPageType(type) {
  document.getElementById('pageType-field').value = type;
  ['landing','content','data-list'].forEach(t => {
    const btn = document.getElementById('mode-' + t);
    if (btn) btn.classList.toggle('active', t === type);
    const sec = document.getElementById('section-' + t);
    if (sec) sec.style.display = t === type ? '' : 'none';
  });
  // Show the block palette only in landing mode
  const palette = document.getElementById('palette-blocks');
  if (palette) palette.style.display = type === 'landing' ? '' : 'none';
}
setPageType('<%= pg && pg.pageType ? pg.pageType : "landing" %>');

document.getElementById('field-dataCollection').addEventListener('change', function() {
  document.getElementById('field-dataGroup-wrap').style.display = this.value === 'portfolio' ? '' : 'none';
});

// ── Right panel tabs ─────────────────────────────────────────────────────────
function switchRightPanel(panel) {
  document.querySelectorAll('.builder-right-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === panel));
  document.querySelectorAll('.builder-right-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + panel));
}

// ── HTML tag buttons ─────────────────────────────────────────────────────────
document.querySelectorAll('.tag-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const ta = document.getElementById('field-content');
    const open  = decodeURIComponent(btn.dataset.open);
    const close = decodeURIComponent(btn.dataset.close);
    const s = ta.selectionStart, e = ta.selectionEnd;
    const selected = ta.value.substring(s, e);
    ta.value = ta.value.substring(0, s) + open + selected + close + ta.value.substring(e);
    ta.selectionStart = s + open.length;
    ta.selectionEnd   = s + open.length + selected.length;
    ta.focus();
  });
});

// ── Block builder ────────────────────────────────────────────────────────────
// Which image slots each block type supports. Stored on block.images.{slotKey}.
const BLOCK_IMAGE_SLOTS = {
  hero:         [['background', 'Background Image']],
  text:         [['background', 'Background Image']],
  split:        [['main_image',  'Main Image']],
  cta:          [['background', 'Background Image']],
  cards:        [['background', 'Background Image'],
                 ['card1_image', 'Card 1 Image'], ['card2_image', 'Card 2 Image'],
                 ['card3_image', 'Card 3 Image'], ['card4_image', 'Card 4 Image']],
  faq:          [['background', 'Background Image']],
  pricing:      [['background', 'Background Image']],
  testimonials: [['background', 'Background Image'],
                 ['t1_avatar', 'Avatar 1'], ['t2_avatar', 'Avatar 2'], ['t3_avatar', 'Avatar 3']],
  stats:        [['background', 'Background Image']],
  ticker:       [],
};

let pageBlocks = [];
try { pageBlocks = JSON.parse(document.getElementById('blocks-json').value) || []; } catch {}
pageBlocks = pageBlocks.map(b => ({ id: b.id || Math.random().toString(36).slice(2), ...b, images: b.images || {} }));

let dragSrc = null;

function renderBlockImages(block) {
  const slots = BLOCK_IMAGE_SLOTS[block.type] || [];
  if (!slots.length) return '';
  const rows = slots.map(([slotKey, label]) => {
    const url = (block.images && block.images[slotKey]) || '';
    const thumb = url
      ? `<img src="${escapeHtml(url)}" alt="" style="width:56px;height:42px;object-fit:cover;border-radius:2px;border:1px solid var(--border);flex-shrink:0;">`
      : `<div style="width:56px;height:42px;background:var(--ivory);border:1px dashed var(--border);border-radius:2px;display:flex;align-items:center;justify-content:center;color:var(--slate);font-size:0.7rem;flex-shrink:0;">—</div>`;
    return `<div class="block-field">
      <label>${escapeHtml(label)}</label>
      <div style="display:flex;gap:8px;align-items:center;">
        ${thumb}
        <input type="text" style="flex:1;" placeholder="Paste image URL or use buttons →"
          value="${escapeHtml(url)}"
          oninput="updateBlockImage('${block.id}','${slotKey}',this.value)">
      </div>
      <div style="display:flex;gap:6px;margin-top:4px;flex-wrap:wrap;">
        <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.7rem;"
          onclick="pickBlockImage('${block.id}','${slotKey}')">◈ Pick from Assets</button>
        <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.7rem;"
          onclick="generateBlockImage('${block.id}','${slotKey}')">✦ Generate (SD)</button>
        ${url ? `<button type="button" class="btn btn-ghost btn-sm" style="font-size:0.7rem;color:var(--danger);"
          onclick="updateBlockImage('${block.id}','${slotKey}','',true)">Clear</button>` : ''}
      </div>
    </div>`;
  }).join('');
  return `<div style="border-bottom:1px dashed var(--border);padding-bottom:12px;margin-bottom:4px;">
    <div style="font-size:0.62rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Images</div>
    ${rows}
  </div>`;
}

function updateBlockImage(blockId, slotKey, url, rerender) {
  const block = pageBlocks.find(b => b.id === blockId);
  if (!block) return;
  if (!block.images) block.images = {};
  if (url) block.images[slotKey] = url; else delete block.images[slotKey];
  serializeBlocks();
  if (rerender) {
    renderBlocks();
    const body = document.getElementById('block-body-' + blockId);
    if (body) body.classList.remove('collapsed');
  } else {
    // Refresh just the thumbnail for this slot
    const card = document.querySelector(`.block-card[data-id="${blockId}"]`);
    if (card) {
      const inputs = card.querySelectorAll(`input[oninput*="${slotKey}"]`);
      inputs.forEach(i => { if (i.value !== url) i.value = url; });
    }
  }
}

function pickBlockImage(blockId, slotKey) {
  if (typeof window.openAssetPicker !== 'function') {
    alert('Asset picker not loaded.');
    return;
  }
  window.openAssetPicker({
    folder: 'pages',
    type: 'image',
    onSelect: (asset) => {
      const url = asset.publicUrl || asset.url || '';
      if (url) updateBlockImage(blockId, slotKey, url, true);
    },
  });
}

async function generateBlockImage(blockId, slotKey) {
  const block = pageBlocks.find(b => b.id === blockId);
  if (!block) return;
  const seedFromBlock = block.fields?.heading || block.fields?.subheading || block.type;
  const promptDefault = `${seedFromBlock} — background atmosphere`;
  const userPrompt = window.prompt('Describe the image (textures, mood, palette — no text/logos):', promptDefault);
  if (!userPrompt) return;
  const sizePreset = (block.type === 'hero' || block.type === 'cta') ? 'fb-cover'
    : (slotKey.endsWith('_avatar')) ? 'ig-post'
    : 'fb-post';

  const cardEl = document.querySelector(`.block-card[data-id="${blockId}"]`);
  const buttons = cardEl ? cardEl.querySelectorAll('button') : [];
  buttons.forEach(b => b.disabled = true);
  if (cardEl) cardEl.style.opacity = '0.65';

  try {
    const r = await fetch('/admin/assets/generate-bg', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: userPrompt, sizePreset, enrich: true }),
    });
    const data = await r.json();
    if (!r.ok || !data.url) throw new Error(data.error || 'Generation failed');
    updateBlockImage(blockId, slotKey, data.url, true);
  } catch (e) {
    alert('Image generation failed: ' + e.message);
  } finally {
    buttons.forEach(b => b.disabled = false);
    if (cardEl) cardEl.style.opacity = '';
  }
}

function renderBlocks() {
  const list = document.getElementById('block-list');
  const empty = document.getElementById('block-empty');
  empty.style.display = pageBlocks.length ? 'none' : '';
  list.innerHTML = '';
  pageBlocks.forEach((block, i) => {
    const card = document.createElement('div');
    card.className = 'block-card';
    card.draggable = true;
    card.dataset.id = block.id;
    card.addEventListener('dragstart', e => { dragSrc = i; e.dataTransfer.effectAllowed = 'move'; });
    card.addEventListener('dragover',  e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; card.style.outline = '2px solid var(--gold)'; });
    card.addEventListener('dragleave', () => { card.style.outline = ''; });
    card.addEventListener('drop', e => {
      e.preventDefault(); card.style.outline = '';
      if (dragSrc === null || dragSrc === i) return;
      const moved = pageBlocks.splice(dragSrc, 1)[0];
      pageBlocks.splice(i, 0, moved);
      dragSrc = null; renderBlocks();
    });

    const fields = BLOCK_FIELDS[block.type] || [];
    const previewText = block.fields?.heading || block.fields?.q1 || block.type;
    const meta = BLOCK_META[block.type] || { icon: '?', label: block.type };

    card.innerHTML = `
      <div class="block-card-header" onclick="toggleBlock('${block.id}')">
        <span class="block-drag-handle" title="Drag to reorder">⠇</span>
        <span class="block-type-badge">${meta.icon} ${block.type}</span>
        <span class="block-title-text">${(previewText || '(empty)').toString().slice(0, 48)}</span>
        <div class="block-actions">
          ${i > 0 ? `<button type="button" class="btn btn-ghost btn-sm" style="padding:4px 8px;" onclick="event.stopPropagation();moveBlock(${i},-1)">↑</button>` : ''}
          ${i < pageBlocks.length - 1 ? `<button type="button" class="btn btn-ghost btn-sm" style="padding:4px 8px;" onclick="event.stopPropagation();moveBlock(${i},1)">↓</button>` : ''}
          <button type="button" class="btn btn-ghost btn-sm" style="padding:4px 8px;" onclick="event.stopPropagation();duplicateBlock('${block.id}')" title="Duplicate">⎘</button>
          <button type="button" class="btn btn-danger btn-sm" style="padding:4px 8px;" onclick="event.stopPropagation();removeBlock('${block.id}')">✕</button>
        </div>
      </div>
      <div class="block-body collapsed" id="block-body-${block.id}">
        ${renderBlockImages(block)}
        ${fields.map(([key, label, type]) => {
          const val = block.fields?.[key] ?? '';
          return `<div class="block-field">
            <label>${label}</label>
            ${type === 'textarea'
              ? `<textarea data-bid="${block.id}" data-key="${key}" oninput="updateBlockField('${block.id}','${key}',this.value)">${escapeHtml(val)}</textarea>`
              : `<input type="text" data-bid="${block.id}" data-key="${key}" value="${escapeHtml(val)}" oninput="updateBlockField('${block.id}','${key}',this.value)">`}
          </div>`;
        }).join('')}
      </div>`;
    list.appendChild(card);
  });
  serializeBlocks();
}

function toggleBlock(id) {
  const body = document.getElementById('block-body-' + id);
  if (body) body.classList.toggle('collapsed');
}

function addBlock(type) {
  const defaults = BLOCK_DEFAULTS[type] || {};
  pageBlocks.push({ id: Math.random().toString(36).slice(2), type, fields: { ...defaults }, images: {} });
  renderBlocks();
  const last = pageBlocks[pageBlocks.length - 1];
  const body = document.getElementById('block-body-' + last.id);
  if (body) body.classList.remove('collapsed');
}

function removeBlock(id) {
  pageBlocks = pageBlocks.filter(b => b.id !== id);
  renderBlocks();
}

function duplicateBlock(id) {
  const source = pageBlocks.find(b => b.id === id);
  if (!source) return;
  const idx = pageBlocks.indexOf(source);
  const clone = JSON.parse(JSON.stringify(source));
  clone.id = Math.random().toString(36).slice(2);
  pageBlocks.splice(idx + 1, 0, clone);
  renderBlocks();
}

function moveBlock(i, dir) {
  const j = i + dir;
  if (j < 0 || j >= pageBlocks.length) return;
  [pageBlocks[i], pageBlocks[j]] = [pageBlocks[j], pageBlocks[i]];
  renderBlocks();
}

function updateBlockField(id, key, value) {
  const block = pageBlocks.find(b => b.id === id);
  if (block) { if (!block.fields) block.fields = {}; block.fields[key] = value; }
  serializeBlocks();
}

function serializeBlocks() {
  document.getElementById('blocks-json').value = JSON.stringify(pageBlocks);
}

document.getElementById('page-form').addEventListener('submit', serializeBlocks);
renderBlocks();

// ── Agent panel ──────────────────────────────────────────────────────────────
const apMessages = document.getElementById('ap-messages');
let apHistory = [];

function apAddMsg(role, text) {
  const row = document.createElement('div');
  row.className = `ap-msg ap-msg-${role}`;
  const bub = document.createElement('div');
  bub.className = 'ap-bubble';
  bub.textContent = text;
  row.appendChild(bub);
  apMessages.appendChild(row);
  apMessages.scrollTop = apMessages.scrollHeight;
  return bub;
}

// Map of agent fill keys -> DOM ids / input selectors. Lets the agent touch
// every page-level field (not just title/meta), and includes pageType / mode
// so it can change the active section.
function fillField(key, aiValue) {
  if (key === 'pageType' || key === 'mode' || key === 'page_type') {
    if (['landing','content','data-list'].includes(aiValue)) setPageType(aiValue);
    return;
  }
  if (key === 'slug') {
    const el = document.getElementById('slug-field');
    if (el) { el.value = String(aiValue); el.classList.add('ai-filled'); slugEdited = true; }
    return;
  }
  if (key === 'status' || key === 'showInNav' || key === 'robotsMeta' || key === 'sitemapChangefreq') {
    const el = document.querySelector(`[name="${key}"]`);
    if (el) {
      if (el.type === 'checkbox') el.checked = !!aiValue;
      else el.value = String(aiValue);
      el.classList.add('ai-filled');
    }
    return;
  }
  // Direct id matches: title, content, metaTitle, metaDescription, dataCollection, dataPageSize, dataGroup
  const el = document.getElementById('field-' + key);
  if (el) {
    el.value = String(aiValue);
    el.classList.add('ai-filled');
    if (key === 'title' && !slugEdited) autoSlug(String(aiValue));
    if (key === 'dataCollection') {
      document.getElementById('field-dataGroup-wrap').style.display = aiValue === 'portfolio' ? '' : 'none';
    }
    return;
  }
  // Fallback: try a name-based lookup (covers ogImage / canonicalUrl / sitemapPriority)
  const byName = document.querySelector(`[name="${key}"]`);
  if (byName) { byName.value = String(aiValue); byName.classList.add('ai-filled'); }
}

async function apSend() {
  const input = document.getElementById('ap-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  document.getElementById('ap-quick').style.display = 'none';
  apHistory.push({ role: 'user', content: text });
  apAddMsg('user', text);
  const btn = document.getElementById('ap-send');
  btn.disabled = true; btn.textContent = '…';
  const typingBub = apAddMsg('agent', '…');
  typingBub.style.opacity = '0.5';

  try {
    const pageType = document.getElementById('pageType-field').value;
    const r = await fetch('/admin/pages/agent', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messages: apHistory,
        pageType,
        currentPage: { title: document.getElementById('field-title')?.value || '', pageType },
      }),
    });
    const data = await r.json();
    typingBub.closest('.ap-msg').remove();
    if (data.error) { apHistory.pop(); apAddMsg('agent', 'Error: ' + data.error); return; }
    apHistory.push({ role: 'assistant', content: data.message });
    apAddMsg('agent', data.message);

    if (data.fill) {
      Object.entries(data.fill).forEach(([k, v]) => { if (v) fillField(k, String(v)); });
    }

    if (Array.isArray(data.suggestedBlocks) && data.suggestedBlocks.length) {
      const validTypes = Object.keys(BLOCK_FIELDS);
      const newBlocks = data.suggestedBlocks
        .filter(b => b && validTypes.includes(b.type))
        .map(b => ({
          id: Math.random().toString(36).slice(2),
          type: b.type,
          fields: { ...(BLOCK_DEFAULTS[b.type] || {}), ...(b.fields || {}) },
          images: b.images || {},
        }));
      if (newBlocks.length) {
        pageBlocks = newBlocks;
        renderBlocks();
        const imageCount = newBlocks.reduce((n, b) => n + Object.keys(b.images || {}).length, 0);
        apAddMsg('agent', `Added ${newBlocks.length} block${newBlocks.length > 1 ? 's' : ''}${imageCount ? ` with ${imageCount} generated image${imageCount > 1 ? 's' : ''}` : ''}. Expand each block to edit, or click "Pick from Assets" / "Generate (SD)" on any image slot.`);
        if (document.getElementById('pageType-field').value !== 'landing') setPageType('landing');
      }
    }
  } catch (e) {
    typingBub.closest('.ap-msg').remove();
    apHistory.pop();
    apAddMsg('agent', 'Connection error — please try again.');
  } finally {
    btn.disabled = false; btn.textContent = 'Send';
  }
}

document.getElementById('ap-input').addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); apSend(); }
});

// Pre-fill from dashboard master agent
(function() {
  try {
    const raw = sessionStorage.getItem('slab_agent_fill');
    if (!raw) return;
    const data = JSON.parse(raw);
    if (data.department !== 'page' || !data.fill) return;
    sessionStorage.removeItem('slab_agent_fill');
    Object.entries(data.fill).forEach(([k, v]) => { if (v) fillField(k, String(v)); });
    if (data.page_type) setPageType(data.page_type);
    if (Array.isArray(data.suggestedBlocks) && data.suggestedBlocks.length) {
      pageBlocks = [];
      data.suggestedBlocks.forEach(b => {
        const id = 'b' + Math.random().toString(36).slice(2);
        const type = b.type || 'text';
        const defaults = BLOCK_DEFAULTS[type] || {};
        pageBlocks.push({ id, type, fields: { ...defaults, ...(b.fields || {}) }, images: b.images || {} });
      });
      renderBlocks();
      serializeBlocks();
    }
  } catch {}
})();
</script>
<script src="/js/assetPicker.js?v=<%= Date.now() %>"></script>
<script src="/js/agentHealth.js"></script>
<script src="/js/tours/pages.js"></script>

</div></body></html>
