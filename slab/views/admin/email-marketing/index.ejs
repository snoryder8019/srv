<%- include('../partials/head', { title: 'Email Marketing' }) %>
<%- include('../partials/sidebar', { page: 'email-marketing', user: user }) %>

<style>
  .agent-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 16px; border-radius: 2px;
    background: linear-gradient(135deg, var(--navy), var(--navy-mid));
    color: var(--gold-light); border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent);
    font-family: var(--font-body); font-size: 0.72rem;
    font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer; transition: all 0.2s;
  }
  .agent-btn:hover { border-color: color-mix(in srgb, var(--gold) 65%, transparent); }

  #agentPanel {
    position: fixed; top: 0; right: -440px; width: 420px;
    height: 100vh; height: 100dvh;
    background: var(--surface); border-left: 1px solid var(--border);
    box-shadow: -8px 0 40px color-mix(in srgb, var(--navy-deep) 12%, transparent);
    z-index: 500; display: flex; flex-direction: column;
    transition: right 0.3s cubic-bezier(0.4,0,0.2,1);
  }
  #agentPanel.open { right: 0; }

  .ap-header {
    padding: 18px 20px; border-bottom: 1px solid var(--border);
    background: linear-gradient(135deg, var(--navy-deep), var(--navy));
    display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
  }
  .ap-title {
    font-family: var(--font-heading); font-size: 1.2rem;
    font-weight: 400; color: var(--on-navy-deep); display: flex; align-items: center; gap: 10px;
  }
  .ap-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ADE80; animation: apPulse 2s infinite; }
  @keyframes apPulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }
  .ap-close { background: none; border: none; color: color-mix(in srgb, var(--on-navy-deep) 50%, transparent); font-size: 1.3rem; cursor: pointer; padding: 4px; transition: color 0.15s; }
  .ap-close:hover { color: var(--on-navy-deep); }

  .ap-sub {
    padding: 8px 20px; background: color-mix(in srgb, var(--gold) 7%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 15%, transparent); flex-shrink: 0;
    font-size: 0.7rem; color: #92660F; letter-spacing: 0.04em;
    display: flex; align-items: center; gap: 6px;
  }
  .ap-sub-dot { width: 5px; height: 5px; border-radius: 50%; background: #4ADE80; }

  .ap-msgs { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; }

  .ap-msg { display: flex; flex-direction: column; gap: 4px; }
  .ap-msg.user { align-items: flex-end; }
  .ap-msg.assistant { align-items: flex-start; }
  .ap-bubble {
    max-width: 88%; padding: 10px 14px; border-radius: 4px;
    font-size: 0.84rem; line-height: 1.5; font-weight: 300;
  }
  .ap-msg.user .ap-bubble { background: var(--navy); color: var(--on-navy); border-radius: 4px 4px 1px 4px; }
  .ap-msg.assistant .ap-bubble { background: var(--ivory); color: var(--on-surface); border: 1px solid var(--border); border-radius: 4px 4px 4px 1px; }
  .ap-fill-notice { font-size: 0.68rem; color: var(--success,#15803D); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }

  .ap-footer {
    padding: 14px 20px;
    padding-bottom: max(14px, env(safe-area-inset-bottom, 14px));
    border-top: 1px solid var(--border); flex-shrink: 0;
  }
  .ap-quick {
    display: flex; gap: 6px; margin-bottom: 10px;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; flex-wrap: nowrap; padding-bottom: 2px;
  }
  .ap-quick::-webkit-scrollbar { display: none; }
  .ap-quick-btn {
    font-size: 0.67rem; padding: 5px 10px; border-radius: 2px;
    border: 1px solid var(--border); background: var(--surface);
    color: var(--slate); cursor: pointer; font-family: 'Jost', sans-serif;
    font-weight: 500; letter-spacing: 0.04em; transition: all 0.15s; white-space: nowrap;
    flex-shrink: 0;
  }
  .ap-quick-btn:hover { border-color: var(--navy-mid); color: var(--navy); }
  .ap-input-row { display: flex; gap: 8px; }
  .ap-input {
    flex: 1; padding: 10px 14px; border: 1px solid var(--border);
    border-radius: 2px; font-family: 'Jost', sans-serif; font-size: 0.88rem;
    font-weight: 300; color: var(--on-surface); outline: none; resize: none;
    transition: border-color 0.15s; min-height: 42px; max-height: 120px;
  }
  .ap-input:focus { border-color: var(--navy); }
  .ap-send {
    padding: 10px 16px; background: var(--navy); color: var(--on-navy);
    border: none; border-radius: 2px; cursor: pointer; font-size: 0.9rem;
    transition: background 0.15s; flex-shrink: 0; align-self: flex-end;
  }
  .ap-send:hover { background: var(--navy-deep); }
  .ap-send:disabled { opacity: 0.4; cursor: not-allowed; }

  .ap-typing { display: flex; gap: 4px; padding: 10px 14px; background: var(--ivory); border: 1px solid var(--border); border-radius: 4px 4px 4px 1px; align-self: flex-start; }
  .ap-typing-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--slate); animation: apBounce 1.2s infinite; }
  .ap-typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .ap-typing-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes apBounce { 0%,60%,100%{transform:translateY(0);opacity:0.4;} 30%{transform:translateY(-5px);opacity:1;} }

  #agentOverlay { display: none; position: fixed; inset: 0; background: color-mix(in srgb, var(--navy-deep) 15%, transparent); z-index: 499; }
  #agentOverlay.active { display: block; }

  .ai-filled { background: rgba(21,128,61,0.07) !important; border-color: rgba(21,128,61,0.45) !important; transition: background 0.4s, border-color 0.4s; }
</style>

<div class="topbar">
  <div class="topbar-title">Email Marketing</div>
  <% if (tab === 'campaigns') { %>
  <div class="topbar-actions">
    <button class="agent-btn" id="agentToggle"><span style="font-size:1rem;">✦</span> Marketing Agent</button>
  </div>
  <% } %>
</div>

<div class="content">
  <%- include('../partials/advisory', { needs: 'zoho' }) %>
  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin-bottom:24px;">
    <div class="card" style="text-align:center;padding:18px;">
      <div style="font-size:0.6rem;text-transform:uppercase;letter-spacing:.12em;color:var(--slate);margin-bottom:4px;">Contacts</div>
      <div style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;color:var(--navy);"><%= stats.totalContacts %></div>
      <div style="font-size:0.7rem;color:var(--success);"><%= stats.subscribedContacts %> subscribed<% if (stats.pendingContacts) { %> <span style="color:var(--warn);">&middot; <%= stats.pendingContacts %> pending</span><% } %></div>
    </div>
    <div class="card" style="text-align:center;padding:18px;">
      <div style="font-size:0.6rem;text-transform:uppercase;letter-spacing:.12em;color:var(--slate);margin-bottom:4px;">Campaigns</div>
      <div style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;color:var(--navy);"><%= stats.totalCampaigns %></div>
      <div style="font-size:0.7rem;color:var(--slate);"><%= stats.sentCampaigns %> sent</div>
    </div>
    <div class="card" style="text-align:center;padding:18px;">
      <div style="font-size:0.6rem;text-transform:uppercase;letter-spacing:.12em;color:var(--slate);margin-bottom:4px;">Funnel</div>
      <div style="display:flex;gap:6px;justify-content:center;margin-top:6px;flex-wrap:wrap;">
        <span style="font-size:0.65rem;padding:2px 6px;border-radius:2px;background:rgba(201,168,72,0.12);color:#92660F;" title="Leads"><%= funnelCounts.lead %> leads</span>
        <span style="font-size:0.65rem;padding:2px 6px;border-radius:2px;background:rgba(28,43,74,0.08);color:var(--navy);" title="Prospects"><%= funnelCounts.prospect %> prospects</span>
        <span style="font-size:0.65rem;padding:2px 6px;border-radius:2px;background:rgba(21,128,61,0.1);color:var(--success);" title="Customers"><%= funnelCounts.customer %> customers</span>
      </div>
    </div>
  </div>

  <!-- ═══════════ VISUAL OVERVIEW ═══════════ -->
  <%
    const _sg = charts.signupSeries;
    const _maxV = Math.max(1, ..._sg.map(p => p.count));
    const _W = 600, _H = 110, _n = _sg.length;
    const _step = _n > 1 ? _W / (_n - 1) : _W;
    const _pts = _sg.map((p, i) => [i * _step, _H - (p.count / _maxV) * (_H - 12) - 6]);
    const _line = _pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ');
    const _area = `${_line} L${_W},${_H} L0,${_H} Z`;

    const _sc = charts.statusCounts;
    const _stotal = Math.max(1, _sc.subscribed + _sc.pending + _sc.unsubscribed + _sc.bounced);
    const _segs = [
      { label: 'Subscribed', val: _sc.subscribed, color: '#15803D' },
      { label: 'Pending', val: _sc.pending, color: '#C9A848' },
      { label: 'Unsubscribed', val: _sc.unsubscribed, color: '#6B7380' },
      { label: 'Bounced', val: _sc.bounced, color: '#8B1C1C' },
    ];
    const _C = 2 * Math.PI * 42; let _off = 0;

    const _fc = funnelCounts;
    const _ftotal = Math.max(1, _fc.lead + _fc.prospect + _fc.customer + _fc.churned);
    const _funnelSegs = [
      { label: 'Leads', val: _fc.lead, color: '#C9A848' },
      { label: 'Prospects', val: _fc.prospect, color: '#2E4270' },
      { label: 'Customers', val: _fc.customer, color: '#15803D' },
      { label: 'Churned', val: _fc.churned, color: '#8B1C1C' },
    ];
    const _eng = charts.engagement;
    const _maxSrc = Math.max(1, ...charts.sourceBreakdown.map(s => s.count));
  %>
  <style>
    .em-charts { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:14px; margin-bottom:24px; }
    .em-panel { background:var(--surface); border:1px solid var(--border); border-radius:4px; padding:16px 18px; }
    .em-panel-title { font-size:0.62rem; text-transform:uppercase; letter-spacing:.12em; color:var(--slate); margin-bottom:10px; display:flex; align-items:center; justify-content:space-between; }
    .em-panel-title b { font-family:'Cormorant Garamond',serif; font-size:1.5rem; color:var(--navy); font-weight:400; letter-spacing:0; }
    .em-grow { grid-column:span 2; }
    @media (max-width:720px){ .em-grow { grid-column:span 1; } }
    .em-legend { display:flex; flex-wrap:wrap; gap:8px 14px; margin-top:10px; }
    .em-legend span { display:inline-flex; align-items:center; gap:5px; font-size:0.7rem; color:var(--slate); }
    .em-dot { width:9px; height:9px; border-radius:2px; flex-shrink:0; }
    .em-gauge-row { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
    .em-gauge-label { font-size:0.72rem; color:var(--slate); width:74px; flex-shrink:0; }
    .em-gauge-track { flex:1; height:8px; background:var(--border); border-radius:4px; overflow:hidden; }
    .em-gauge-fill { height:100%; border-radius:4px; transition:width .6s cubic-bezier(.4,0,.2,1); }
    .em-gauge-val { font-size:0.78rem; font-weight:600; color:var(--navy); width:38px; text-align:right; flex-shrink:0; }
  </style>
  <div class="em-charts">

    <!-- List growth area chart -->
    <div class="em-panel em-grow">
      <div class="em-panel-title"><span>List Growth &middot; Last 30 Days</span><b>+<%= charts.signups30 %></b></div>
      <svg viewBox="0 0 <%= _W %> <%= _H %>" preserveAspectRatio="none" style="width:100%;height:110px;display:block;">
        <defs><linearGradient id="emGrowthGrad" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#C9A848" stop-opacity="0.32"/><stop offset="100%" stop-color="#C9A848" stop-opacity="0"/>
        </linearGradient></defs>
        <% if (charts.signups30 > 0) { %>
          <path d="<%= _area %>" fill="url(#emGrowthGrad)"/>
          <path d="<%= _line %>" fill="none" stroke="#C9A848" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>
        <% } else { %>
          <line x1="0" y1="<%= _H-6 %>" x2="<%= _W %>" y2="<%= _H-6 %>" stroke="var(--border)" stroke-width="1" vector-effect="non-scaling-stroke"/>
        <% } %>
      </svg>
      <div style="display:flex;justify-content:space-between;font-size:0.62rem;color:var(--slate);margin-top:4px;">
        <span><%= new Date(_sg[0].date+'T00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
        <span><%= charts.signups30 === 0 ? 'No new signups yet — your footer form & capture forms feed this' : 'New contacts per day' %></span>
        <span>Today</span>
      </div>
    </div>

    <!-- Audience donut + funnel -->
    <div class="em-panel">
      <div class="em-panel-title"><span>Audience</span><b><%= stats.totalContacts %></b></div>
      <div style="display:flex;align-items:center;gap:14px;">
        <svg viewBox="0 0 110 110" style="width:104px;height:104px;flex-shrink:0;">
          <circle cx="55" cy="55" r="42" fill="none" stroke="var(--border)" stroke-width="13"/>
          <% _segs.forEach(function(s){ if(!s.val) return; const len = s.val/_stotal*_C; %>
            <circle cx="55" cy="55" r="42" fill="none" stroke="<%= s.color %>" stroke-width="13"
              stroke-dasharray="<%= len.toFixed(2) %> <%= (_C-len).toFixed(2) %>" stroke-dashoffset="<%= (-_off).toFixed(2) %>"
              stroke-linecap="butt" transform="rotate(-90 55 55)"/>
            <% _off += len; }) %>
          <text x="55" y="52" text-anchor="middle" style="font-size:16px;font-weight:600;fill:var(--navy);font-family:Jost,sans-serif;"><%= _sc.subscribed %></text>
          <text x="55" y="65" text-anchor="middle" style="font-size:6.5px;fill:var(--slate);letter-spacing:1.5px;font-family:Jost,sans-serif;">SUBSCRIBED</text>
        </svg>
        <div class="em-legend" style="flex-direction:column;gap:7px;margin-top:0;">
          <% _segs.forEach(function(s){ %>
          <span><span class="em-dot" style="background:<%= s.color %>;"></span><%= s.label %> <strong style="color:var(--navy);margin-left:2px;"><%= s.val %></strong></span>
          <% }) %>
        </div>
      </div>
      <!-- Funnel segmented bar -->
      <div style="margin-top:14px;">
        <div style="font-size:0.62rem;text-transform:uppercase;letter-spacing:.1em;color:var(--slate);margin-bottom:5px;">Funnel</div>
        <div style="display:flex;height:14px;border-radius:3px;overflow:hidden;background:var(--border);">
          <% _funnelSegs.forEach(function(s){ if(!s.val) return; %>
          <div title="<%= s.label %>: <%= s.val %>" style="width:<%= (s.val/_ftotal*100).toFixed(1) %>%;background:<%= s.color %>;"></div>
          <% }) %>
        </div>
        <div class="em-legend">
          <% _funnelSegs.forEach(function(s){ %><span><span class="em-dot" style="background:<%= s.color %>;"></span><%= s.label %> <%= s.val %></span><% }) %>
        </div>
      </div>
    </div>

    <!-- Campaign engagement -->
    <div class="em-panel">
      <div class="em-panel-title"><span>Campaign Engagement</span><b><%= stats.sentCampaigns %></b></div>
      <div class="em-gauge-row">
        <span class="em-gauge-label">Avg open</span>
        <div class="em-gauge-track"><div class="em-gauge-fill" style="width:<%= _eng.avgOpenRate %>%;background:#15803D;"></div></div>
        <span class="em-gauge-val"><%= _eng.avgOpenRate %>%</span>
      </div>
      <div class="em-gauge-row">
        <span class="em-gauge-label">Avg click</span>
        <div class="em-gauge-track"><div class="em-gauge-fill" style="width:<%= _eng.avgClickRate %>%;background:#C9A848;"></div></div>
        <span class="em-gauge-val"><%= _eng.avgClickRate %>%</span>
      </div>
      <div style="border-top:1px solid var(--border);margin-top:8px;padding-top:10px;">
        <% if (_eng.campSeries.length) { %>
          <div style="font-size:0.62rem;text-transform:uppercase;letter-spacing:.1em;color:var(--slate);margin-bottom:8px;">Recent sends — open rate</div>
          <% _eng.campSeries.forEach(function(c){ %>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
            <span style="font-size:0.68rem;color:var(--navy);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= c.subject %></span>
            <div class="em-gauge-track" style="flex:1;"><div class="em-gauge-fill" style="width:<%= c.openRate %>%;background:linear-gradient(90deg,#2E4270,#15803D);"></div></div>
            <span style="font-size:0.66rem;color:var(--slate);width:30px;text-align:right;"><%= c.openRate %>%</span>
          </div>
          <% }) %>
        <% } else { %>
          <div style="font-size:0.72rem;color:var(--slate);text-align:center;padding:8px 0;">No campaigns sent yet. Engagement appears here after your first send.</div>
        <% } %>
      </div>
    </div>

    <!-- Sources -->
    <div class="em-panel">
      <div class="em-panel-title"><span>Where Contacts Come From</span></div>
      <% if (charts.sourceBreakdown.length) { %>
        <% charts.sourceBreakdown.forEach(function(s){ %>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-size:0.7rem;color:var(--navy);width:90px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= s.source %>"><%= s.source %></span>
          <div class="em-gauge-track" style="flex:1;"><div class="em-gauge-fill" style="width:<%= (s.count/_maxSrc*100).toFixed(0) %>%;background:#2E4270;"></div></div>
          <span style="font-size:0.7rem;color:var(--slate);width:30px;text-align:right;"><%= s.count %></span>
        </div>
        <% }) %>
      <% } else { %>
        <div style="font-size:0.72rem;color:var(--slate);text-align:center;padding:16px 0;">No contacts yet.</div>
      <% } %>
    </div>

  </div>

  <!-- Tabs -->
  <div class="tabs" style="margin-bottom:20px;">
    <a href="?tab=contacts" class="tab-link <%= tab === 'contacts' ? 'active' : '' %>">Contacts (<%= contacts.length %>)</a>
    <a href="?tab=forms" class="tab-link <%= tab === 'forms' ? 'active' : '' %>">Capture Forms (<%= forms.length %>)</a>
    <a href="?tab=campaigns" class="tab-link <%= tab === 'campaigns' ? 'active' : '' %>">Campaigns (<%= campaigns.length %>)</a>
  </div>

  <!-- Flash messages -->
  <% if (qs.success) { %>
  <div style="background:rgba(21,128,61,0.08);border:1px solid rgba(21,128,61,0.2);border-radius:3px;padding:10px 16px;margin-bottom:16px;font-size:0.82rem;color:var(--success);"><%= qs.success %></div>
  <% } %>
  <% if (qs.error) { %>
  <div style="background:rgba(185,28,28,0.08);border:1px solid rgba(185,28,28,0.2);border-radius:3px;padding:10px 16px;margin-bottom:16px;font-size:0.82rem;color:var(--danger);"><%= qs.error %></div>
  <% } %>

  <!-- ═══════════ CONTACTS TAB ═══════════ -->
  <% if (tab === 'contacts') { %>

    <!-- Actions row -->
    <div class="card" style="margin-bottom:16px;padding:16px 20px;">
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <button class="btn btn-navy btn-sm" onclick="document.getElementById('addContactCard').style.display=document.getElementById('addContactCard').style.display==='none'?'block':'none'">+ Add Contact</button>
        <button class="btn btn-ghost btn-sm" onclick="document.getElementById('csvUploadCard').style.display=document.getElementById('csvUploadCard').style.display==='none'?'block':'none'">Upload CSV</button>
        <form method="POST" action="/admin/email-marketing/contacts/import-clients" style="display:inline;" onsubmit="return confirm('Import all clients with emails as contacts?')">
          <button class="btn btn-ghost btn-sm">Import Clients</button>
        </form>
        <div style="margin-left:auto;font-size:0.75rem;color:var(--slate);">
          <%= contacts.filter(c=>c.status==='subscribed').length %> / <%= contacts.length %> subscribed
        </div>
      </div>
    </div>

    <!-- Add contact form (hidden by default) -->
    <div id="addContactCard" class="card" style="margin-bottom:16px;display:none;">
      <div class="card-title">Add Contact</div>
      <form method="POST" action="/admin/email-marketing/contacts">
        <div class="form-grid" style="grid-template-columns:1fr 1fr 1fr 1fr;">
          <div class="form-field">
            <label>Email *</label>
            <input type="email" name="email" required placeholder="name@example.com">
          </div>
          <div class="form-field">
            <label>Name</label>
            <input type="text" name="name" placeholder="Full name">
          </div>
          <div class="form-field">
            <label>Funnel Stage</label>
            <select name="funnel">
              <option value="lead">Lead</option>
              <option value="prospect">Prospect</option>
              <option value="customer">Customer</option>
            </select>
          </div>
          <div class="form-field">
            <label>Tags</label>
            <input type="text" name="tags" placeholder="newsletter, promo (comma sep)">
          </div>
        </div>
        <div style="margin-top:12px;"><button type="submit" class="btn btn-navy btn-sm">Add Contact</button></div>
      </form>
    </div>

    <!-- CSV upload form (hidden by default) -->
    <div id="csvUploadCard" class="card" style="margin-bottom:16px;display:none;">
      <div class="card-title">Upload CSV</div>
      <p style="font-size:0.78rem;color:var(--slate);margin-bottom:12px;">CSV must have an <strong>email</strong> column. Optional columns: <strong>name</strong>, <strong>tags</strong> (semicolon-separated within cell).</p>
      <form method="POST" action="/admin/email-marketing/contacts/upload" enctype="multipart/form-data">
        <div class="form-grid" style="grid-template-columns:1fr 1fr 1fr;">
          <div class="form-field">
            <label>CSV File *</label>
            <input type="file" name="csv" accept=".csv" required>
          </div>
          <div class="form-field">
            <label>Assign Funnel Stage</label>
            <select name="funnel">
              <option value="lead" selected>Lead</option>
              <option value="prospect">Prospect</option>
              <option value="customer">Customer</option>
            </select>
          </div>
          <div class="form-field">
            <label>Source Label</label>
            <input type="text" name="source" placeholder="e.g. tradeshow-2026" value="csv-upload">
          </div>
        </div>
        <div style="margin-top:12px;"><button type="submit" class="btn btn-navy btn-sm">Upload & Import</button></div>
      </form>
    </div>

    <!-- Contacts table -->
    <% if (!contacts.length) { %>
      <div class="empty"><div class="empty-icon">@</div><p>No contacts yet. Add one, upload a CSV, or import your clients.</p></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Funnel</th>
            <th>Status</th>
            <th>Source</th>
            <th>Tags</th>
            <th>Added</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const ct of contacts) { %>
          <tr>
            <td style="font-size:0.82rem;font-weight:500;color:var(--navy);"><%= ct.email %></td>
            <td style="font-size:0.82rem;"><%= ct.name || '---' %></td>
            <td>
              <form method="POST" action="/admin/email-marketing/contacts/<%= ct._id %>/update" style="display:inline;">
                <%
                  const funnelColors = { lead:'background:rgba(201,168,72,0.12);color:#92660F;', prospect:'background:rgba(28,43,74,0.08);color:var(--navy);', customer:'background:rgba(21,128,61,0.1);color:var(--success);', churned:'background:rgba(185,28,28,0.08);color:var(--danger);' };
                %>
                <select name="funnel" onchange="this.form.submit()" style="padding:2px 6px;font-size:0.7rem;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;cursor:pointer;">
                  <option value="lead" <%= ct.funnel === 'lead' ? 'selected' : '' %>>Lead</option>
                  <option value="prospect" <%= ct.funnel === 'prospect' ? 'selected' : '' %>>Prospect</option>
                  <option value="customer" <%= ct.funnel === 'customer' ? 'selected' : '' %>>Customer</option>
                  <option value="churned" <%= ct.funnel === 'churned' ? 'selected' : '' %>>Churned</option>
                </select>
              </form>
            </td>
            <td>
              <form method="POST" action="/admin/email-marketing/contacts/<%= ct._id %>/update" style="display:inline;">
                <select name="status" onchange="this.form.submit()" style="padding:2px 6px;font-size:0.7rem;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;cursor:pointer;">
                  <option value="subscribed" <%= ct.status === 'subscribed' ? 'selected' : '' %>>Subscribed</option>
                  <option value="unsubscribed" <%= ct.status === 'unsubscribed' ? 'selected' : '' %>>Unsubscribed</option>
                  <option value="bounced" <%= ct.status === 'bounced' ? 'selected' : '' %>>Bounced</option>
                </select>
              </form>
            </td>
            <td style="font-size:0.72rem;color:var(--slate);"><%= ct.source || '---' %></td>
            <td style="font-size:0.72rem;">
              <% if (ct.tags?.length) { %>
                <% for (const t of ct.tags) { %>
                <span style="display:inline-block;padding:1px 5px;border-radius:2px;font-size:0.6rem;font-weight:600;letter-spacing:.04em;background:rgba(28,43,74,0.06);color:var(--slate);margin:1px 2px;"><%= t %></span>
                <% } %>
              <% } else { %>---<% } %>
            </td>
            <td style="font-size:0.72rem;color:var(--slate);"><%= new Date(ct.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %></td>
            <td>
              <form method="POST" action="/admin/email-marketing/contacts/<%= ct._id %>/delete" onsubmit="return confirm('Remove this contact?')" style="display:inline;">
                <button class="btn btn-danger btn-sm" style="font-size:0.65rem;">Del</button>
              </form>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>

  <% } %>

  <!-- ═══════════ CAMPAIGNS TAB ═══════════ -->
  <% if (tab === 'campaigns') { %>

    <!-- New campaign form -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-title">New Campaign</div>
      <form method="POST" action="/admin/email-marketing/campaigns">
        <div class="form-grid">
          <div class="form-field">
            <label>Subject Line *</label>
            <input type="text" name="subject" id="campSubject" required placeholder="e.g. Spring Marketing Deals">
          </div>
          <div class="form-field">
            <label>Preheader <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(preview text)</span></label>
            <input type="text" name="preheader" id="campPreheader" placeholder="Short preview shown in inbox">
          </div>
        </div>
        <div class="form-grid" style="margin-top:12px;">
          <div class="form-field">
            <label>Target Funnel Stage</label>
            <select name="targetFunnel" id="campTargetFunnel">
              <option value="all">All Subscribed</option>
              <option value="lead">Leads Only</option>
              <option value="prospect">Prospects Only</option>
              <option value="customer">Customers Only</option>
            </select>
          </div>
          <div class="form-field">
            <label>Target Tags <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(comma sep, optional)</span></label>
            <input type="text" name="targetTags" placeholder="e.g. newsletter, promo">
          </div>
        </div>
        <div class="form-field" style="margin-top:12px;">
          <label>Email Body * <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(HTML supported &mdash; use {name} to personalize)</span></label>
          <!-- Toolbar -->
          <div style="display:flex;gap:6px;margin-bottom:6px;flex-wrap:wrap;align-items:center;">
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="openImagePicker()">Insert Image</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="insertAtCursor(campBody, '&lt;h2&gt;Heading&lt;/h2&gt;')">H2</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="insertAtCursor(campBody, '&lt;strong&gt;&lt;/strong&gt;')">Bold</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="insertAtCursor(campBody, '&lt;a href=&quot;<%= brand?.domain ? 'https://' + (typeof tenant !== 'undefined' ? tenant.domain : '' ) : '#' %>&quot; style=&quot;display:inline-block;padding:12px 28px;background:#C9A848;color:#1C2B4A;text-decoration:none;font-weight:600;border-radius:3px;&quot;&gt;Button Text&lt;/a&gt;')">CTA Button</button>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="insertAtCursor(campBody, '&lt;hr style=&quot;border:none;border-top:1px solid #E6E1D6;margin:20px 0;&quot;&gt;')">Divider</button>
            <span style="font-size:0.65rem;color:var(--slate);margin-left:auto;">Vars: {name}, {email}</span>
          </div>
          <textarea name="body" id="campBody" rows="12" required placeholder="Write your email content here. HTML tags are supported.&#10;&#10;Use the toolbar above to insert images from your brand library." style="font-family:'Jost',sans-serif;font-size:0.85rem;line-height:1.6;"></textarea>
        </div>
        <div style="margin-top:16px;display:flex;gap:8px;">
          <button type="submit" class="btn btn-navy btn-sm">Save as Draft</button>
          <button type="button" class="btn btn-ghost btn-sm" onclick="previewCampaign()">Preview</button>
        </div>
      </form>
    </div>

    <!-- Campaigns list -->
    <% if (!campaigns.length) { %>
      <div class="empty"><div class="empty-icon">@</div><p>No campaigns yet. Create one above.</p></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Subject</th>
            <th>Target</th>
            <th>Status</th>
            <th>Sent</th>
            <th>Opens</th>
            <th>Clicks</th>
            <th>Date</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const camp of campaigns) { %>
          <tr>
            <td style="font-weight:500;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <a href="/admin/email-marketing/campaigns/<%= camp._id %>" style="color:var(--navy);text-decoration:none;"><%= camp.subject %></a>
              <% if (camp.parentSegment) { %>
              <div style="font-size:0.6rem;color:var(--warn);margin-top:2px;">follow-up: <%= camp.parentSegment %></div>
              <% } %>
            </td>
            <td style="font-size:0.78rem;color:var(--slate);">
              <%= camp.targetFunnel === 'all' ? 'All' : camp.targetFunnel %>
              <% if (camp.targetTags?.length) { %>
                <% for (const t of camp.targetTags) { %>
                <span style="display:inline-block;padding:1px 4px;border-radius:2px;font-size:0.6rem;background:rgba(28,43,74,0.06);color:var(--slate);margin-left:2px;"><%= t %></span>
                <% } %>
              <% } %>
            </td>
            <td>
              <%
                const campStatusColors = { draft:'var(--slate)', sent:'var(--success)', sending:'var(--warn)' };
                const csc = campStatusColors[camp.status] || 'var(--slate)';
              %>
              <span style="display:inline-block;padding:2px 8px;border-radius:2px;font-size:0.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;background:color-mix(in srgb, <%= csc %> 10%, transparent);color:<%= csc %>;"><%= camp.status %></span>
            </td>
            <td style="font-size:0.82rem;">
              <% if (camp.status === 'sent') { %>
                <%= camp.sentCount %><% if (camp.failedCount) { %> <span style="color:var(--danger);font-size:0.72rem;">(<%= camp.failedCount %> failed)</span><% } %>
              <% } else { %>
                ---
              <% } %>
            </td>
            <%
              const ca = analyticsMap[camp._id.toString()] || {};
              const opens = ca.open || { total: 0, unique: 0 };
              const clicks = ca.click || { total: 0, unique: 0 };
              const openRate = camp.sentCount ? Math.round(opens.unique / camp.sentCount * 100) : 0;
              const clickRate = camp.sentCount ? Math.round(clicks.unique / camp.sentCount * 100) : 0;
            %>
            <td style="font-size:0.78rem;">
              <% if (camp.status === 'sent') { %>
                <strong><%= opens.unique %></strong>
                <span style="color:var(--slate);font-size:0.65rem;">(<%= openRate %>%)</span>
                <% if (opens.total > opens.unique) { %>
                <div style="font-size:0.6rem;color:var(--slate);"><%= opens.total %> total</div>
                <% } %>
              <% } else { %>---<% } %>
            </td>
            <td style="font-size:0.78rem;">
              <% if (camp.status === 'sent') { %>
                <strong><%= clicks.unique %></strong>
                <span style="color:var(--slate);font-size:0.65rem;">(<%= clickRate %>%)</span>
                <% if (clicks.total > clicks.unique) { %>
                <div style="font-size:0.6rem;color:var(--slate);"><%= clicks.total %> total</div>
                <% } %>
              <% } else { %>---<% } %>
            </td>
            <td style="font-size:0.78rem;color:var(--slate);">
              <%= camp.sentAt ? new Date(camp.sentAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : new Date(camp.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %>
            </td>
            <td style="white-space:nowrap;">
              <div style="display:flex;gap:4px;align-items:center;">
                <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="openEmailPreview({ endpoint: '/admin/email-marketing/campaigns/<%= camp._id %>/preview', title: 'Campaign preview' })">Preview</button>
                <% if (camp.status === 'draft') { %>
                <form method="POST" action="/admin/email-marketing/campaigns/<%= camp._id %>/send" style="display:inline;" onsubmit="return confirm('Send this campaign to all matching contacts? This cannot be undone.')">
                  <button class="btn btn-gold btn-sm" style="font-size:0.68rem;">Send</button>
                </form>
                <% } %>
                <form method="POST" action="/admin/email-marketing/campaigns/<%= camp._id %>/delete" onsubmit="return confirm('Delete this campaign?')" style="display:inline;">
                  <button class="btn btn-danger btn-sm" style="font-size:0.68rem;">Del</button>
                </form>
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>

  <% } %>

  <!-- ═══════════ CAPTURE FORMS TAB ═══════════ -->
  <% if (tab === 'forms') { %>

    <div class="card" style="margin-bottom:16px;padding:14px 18px;background:linear-gradient(135deg,rgba(201,168,72,0.06),transparent);">
      <div style="font-size:0.82rem;color:var(--slate);line-height:1.55;">
        Capture forms grow your list. A <strong>newsletter signup is already live in your site footer</strong> (toggle it in
        <a href="/admin/design#footer" style="color:var(--navy);">Design</a>). Build extra forms below for landing pages, lead magnets, or to
        <strong>embed on any external site</strong>. New emails confirm via double opt-in, then receive the form's welcome email automatically.
      </div>
    </div>

    <!-- New form -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;">
        <span>New Capture Form</span>
        <button type="button" class="agent-btn" id="formAgentBtn" style="font-size:0.66rem;padding:6px 12px;"><span style="font-size:0.9rem;">✦</span> Write with AI</button>
      </div>
      <form method="POST" action="/admin/email-marketing/forms">
        <div class="form-grid" style="grid-template-columns:1fr 1fr;">
          <div class="form-field">
            <label>Form Name * <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(internal)</span></label>
            <input type="text" name="name" id="fName" required placeholder="e.g. Spring Lead Magnet">
          </div>
          <div class="form-field">
            <label>Headline</label>
            <input type="text" name="headline" id="fHeadline" placeholder="Join our newsletter">
          </div>
        </div>
        <div class="form-field" style="margin-top:12px;">
          <label>Sub-headline <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(value proposition)</span></label>
          <input type="text" name="subhead" id="fSubhead" placeholder="Get updates and offers straight to your inbox.">
        </div>
        <div class="form-grid" style="grid-template-columns:1fr 1fr 1fr 1fr;margin-top:12px;">
          <div class="form-field">
            <label>Button Text</label>
            <input type="text" name="buttonText" id="fButton" placeholder="Subscribe">
          </div>
          <div class="form-field">
            <label>Funnel Stage</label>
            <select name="funnel">
              <option value="lead">Lead</option>
              <option value="prospect">Prospect</option>
              <option value="customer">Customer</option>
            </select>
          </div>
          <div class="form-field">
            <label>Confirmation</label>
            <select name="optIn">
              <option value="double">Double opt-in (recommended)</option>
              <option value="single">Single opt-in</option>
            </select>
          </div>
          <div class="form-field">
            <label>Collect Name?</label>
            <select name="collectName">
              <option value="false">Email only</option>
              <option value="true">Name + email</option>
            </select>
          </div>
        </div>
        <div class="form-grid" style="grid-template-columns:1fr 1fr;margin-top:12px;">
          <div class="form-field">
            <label>Tags <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(comma sep)</span></label>
            <input type="text" name="tags" placeholder="newsletter, lead-magnet">
          </div>
          <div class="form-field">
            <label>Success Message</label>
            <input type="text" name="successMessage" id="fSuccess" placeholder="Check your inbox to confirm!">
          </div>
        </div>
        <div class="form-field" style="margin-top:12px;">
          <label>Welcome Email <span style="font-weight:400;color:var(--slate);font-size:0.75rem;">(sent after they confirm — optional, HTML, use {name})</span></label>
          <input type="text" name="welcomeSubject" id="fWelcomeSubject" placeholder="Welcome email subject (leave blank to skip)" style="margin-bottom:8px;">
          <textarea name="welcomeBody" id="fWelcomeBody" rows="5" placeholder="Optional HTML welcome email body." style="font-family:'Jost',sans-serif;font-size:0.85rem;line-height:1.6;"></textarea>
        </div>
        <div style="margin-top:14px;"><button type="submit" class="btn btn-navy btn-sm">Create Form</button></div>
      </form>
    </div>

    <!-- Forms list -->
    <% if (!forms.length) { %>
      <div class="empty"><div class="empty-icon">⬚</div><p>No custom forms yet. The footer signup is already capturing — build a form above for landing pages or external embeds.</p></div>
    <% } else { %>
      <% for (const f of forms) { %>
      <% const hostedUrl = (tenantDomain || '') + '/t/f/' + f.token; %>
      <% const embedSnippet = '<script async src="' + (tenantDomain || 'https://yourdomain.com') + '/t/f/' + f.token + '/embed.js"></scr' + 'ipt>'; %>
      <div class="card" style="margin-bottom:14px;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
          <div style="flex:1;min-width:240px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;color:var(--navy);"><%= f.name %></span>
              <span style="font-size:0.6rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:2px;background:<%= f.enabled !== false ? 'rgba(21,128,61,0.1)' : 'rgba(107,115,128,0.12)' %>;color:<%= f.enabled !== false ? 'var(--success)' : 'var(--slate)' %>;"><%= f.enabled !== false ? 'Live' : 'Off' %></span>
              <span style="font-size:0.6rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:2px;background:rgba(28,43,74,0.07);color:var(--navy);"><%= f.optIn === 'single' ? 'Single' : 'Double' %> opt-in</span>
            </div>
            <div style="font-size:0.8rem;color:var(--slate);margin-top:4px;">"<%= f.headline %>"<% if (f.subhead) { %> — <%= f.subhead %><% } %></div>
          </div>
          <div style="text-align:right;">
            <div style="font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:var(--navy);"><%= f.signupCount || 0 %></div>
            <div style="font-size:0.62rem;text-transform:uppercase;letter-spacing:.1em;color:var(--slate);">signups<% if (f.confirmedCount) { %> &middot; <%= f.confirmedCount %> confirmed<% } %></div>
          </div>
        </div>

        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;font-size:0.75rem;align-items:center;">
          <span style="color:var(--slate);">Funnel: <strong style="color:var(--navy);"><%= f.funnel %></strong></span>
          <% if (f.tags?.length) { %><span style="color:var(--slate);">Tags: <%= f.tags.join(', ') %></span><% } %>
          <span style="color:var(--slate);">Welcome email: <strong style="color:<%= f.welcomeBody ? 'var(--success)' : 'var(--slate)' %>;"><%= f.welcomeBody ? 'on' : 'none' %></strong></span>
          <% const _conv = f.signupCount ? Math.round((f.confirmedCount || 0) / f.signupCount * 100) : 0; %>
          <% if (f.signupCount) { %>
          <span style="display:flex;align-items:center;gap:6px;color:var(--slate);">Confirm rate
            <span style="display:inline-block;width:70px;height:7px;background:var(--border);border-radius:4px;overflow:hidden;"><span style="display:block;height:100%;width:<%= _conv %>%;background:#15803D;border-radius:4px;"></span></span>
            <strong style="color:var(--navy);"><%= _conv %>%</strong>
          </span>
          <% } %>
        </div>

        <!-- Share + embed -->
        <div style="margin-top:12px;border-top:1px solid var(--border);padding-top:12px;">
          <div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--slate);margin-bottom:6px;">Hosted form link</div>
          <div style="display:flex;gap:6px;margin-bottom:10px;">
            <input type="text" readonly value="<%= hostedUrl %>" onclick="this.select()" style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-size:0.74rem;font-family:monospace;color:var(--navy);">
            <a href="<%= hostedUrl %>" target="_blank" class="btn btn-ghost btn-sm" style="font-size:0.66rem;">Open</a>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.66rem;" onclick="copyText(this, '<%= hostedUrl %>')">Copy</button>
          </div>
          <div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--slate);margin-bottom:6px;">Embed on any website</div>
          <div style="display:flex;gap:6px;">
            <input type="text" readonly value='<%= embedSnippet %>' onclick="this.select()" style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-size:0.72rem;font-family:monospace;color:var(--slate);">
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.66rem;" onclick="copyText(this, this.previousElementSibling.value)">Copy</button>
          </div>
        </div>

        <div style="margin-top:12px;display:flex;gap:6px;">
          <form method="POST" action="/admin/email-marketing/forms/<%= f._id %>/toggle" style="display:inline;">
            <button class="btn btn-ghost btn-sm" style="font-size:0.68rem;"><%= f.enabled !== false ? 'Pause' : 'Activate' %></button>
          </form>
          <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.68rem;" onclick="document.getElementById('editForm<%= f._id %>').style.display=document.getElementById('editForm<%= f._id %>').style.display==='none'?'block':'none'">Edit</button>
          <form method="POST" action="/admin/email-marketing/forms/<%= f._id %>/delete" onsubmit="return confirm('Delete this form? Signups already captured are kept.')" style="display:inline;">
            <button class="btn btn-danger btn-sm" style="font-size:0.68rem;">Delete</button>
          </form>
        </div>

        <!-- Edit (hidden) -->
        <div id="editForm<%= f._id %>" style="display:none;margin-top:14px;border-top:1px solid var(--border);padding-top:14px;">
          <form method="POST" action="/admin/email-marketing/forms/<%= f._id %>/update">
            <div class="form-grid" style="grid-template-columns:1fr 1fr;">
              <div class="form-field"><label>Name</label><input type="text" name="name" value="<%= f.name %>"></div>
              <div class="form-field"><label>Headline</label><input type="text" name="headline" value="<%= f.headline %>"></div>
            </div>
            <div class="form-field" style="margin-top:10px;"><label>Sub-headline</label><input type="text" name="subhead" value="<%= f.subhead || '' %>"></div>
            <div class="form-grid" style="grid-template-columns:1fr 1fr 1fr 1fr;margin-top:10px;">
              <div class="form-field"><label>Button</label><input type="text" name="buttonText" value="<%= f.buttonText || 'Subscribe' %>"></div>
              <div class="form-field"><label>Funnel</label><select name="funnel"><option value="lead" <%= f.funnel==='lead'?'selected':'' %>>Lead</option><option value="prospect" <%= f.funnel==='prospect'?'selected':'' %>>Prospect</option><option value="customer" <%= f.funnel==='customer'?'selected':'' %>>Customer</option></select></div>
              <div class="form-field"><label>Opt-in</label><select name="optIn"><option value="double" <%= f.optIn!=='single'?'selected':'' %>>Double</option><option value="single" <%= f.optIn==='single'?'selected':'' %>>Single</option></select></div>
              <div class="form-field"><label>Collect Name</label><select name="collectName"><option value="false" <%= !f.collectName?'selected':'' %>>Email only</option><option value="true" <%= f.collectName?'selected':'' %>>Name + email</option></select></div>
            </div>
            <div class="form-grid" style="grid-template-columns:1fr 1fr;margin-top:10px;">
              <div class="form-field"><label>Tags</label><input type="text" name="tags" value="<%= (f.tags||[]).join(', ') %>"></div>
              <div class="form-field"><label>Success Message</label><input type="text" name="successMessage" value="<%= f.successMessage || '' %>"></div>
            </div>
            <div class="form-field" style="margin-top:10px;"><label>Welcome Email Subject</label><input type="text" name="welcomeSubject" value="<%= f.welcomeSubject || '' %>"></div>
            <div class="form-field" style="margin-top:10px;"><label>Welcome Email Body (HTML)</label><textarea name="welcomeBody" rows="5" style="font-family:'Jost',sans-serif;font-size:0.85rem;"><%= f.welcomeBody || '' %></textarea></div>
            <div style="margin-top:12px;"><button type="submit" class="btn btn-navy btn-sm">Save Changes</button></div>
          </form>
        </div>
      </div>
      <% } %>
    <% } %>

  <% } %>
</div>

<!-- Image Picker Modal -->
<div id="imgPickerModal" style="display:none;position:fixed;inset:0;background:rgba(15,27,48,0.5);z-index:500;align-items:center;justify-content:center;">
  <div style="background:var(--surface);border-radius:6px;padding:28px;max-width:640px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,0.15);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;">Insert Image</div>
      <button type="button" onclick="closeImgPicker()" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:var(--slate);">&times;</button>
    </div>
    <div id="imgPickerGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;">
      <div style="text-align:center;color:var(--slate);font-size:0.82rem;grid-column:1/-1;padding:20px;">Loading images...</div>
    </div>
    <div style="margin-top:16px;border-top:1px solid var(--border);padding-top:12px;">
      <div style="font-size:0.72rem;color:var(--slate);margin-bottom:6px;">Or paste an external image URL:</div>
      <div style="display:flex;gap:6px;">
        <input type="url" id="extImgUrl" placeholder="https://..." style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:2px;font-family:'Jost',sans-serif;font-size:0.82rem;">
        <button type="button" class="btn btn-navy btn-sm" style="font-size:0.68rem;" onclick="insertExtImage()">Insert</button>
      </div>
    </div>
  </div>
</div>

<script>
const campBody = document.getElementById('campBody');

function insertAtCursor(textarea, text) {
  if (!textarea) return;
  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  textarea.value = textarea.value.substring(0, start) + text + textarea.value.substring(end);
  textarea.selectionStart = textarea.selectionEnd = start + text.length;
  textarea.focus();
}

function openImagePicker() {
  const modal = document.getElementById('imgPickerModal');
  modal.style.display = 'flex';
  const grid = document.getElementById('imgPickerGrid');
  grid.innerHTML = '<div style="text-align:center;color:var(--slate);font-size:0.82rem;grid-column:1/-1;padding:20px;">Loading...</div>';

  fetch('/admin/design/images/api')
    .then(r => r.json())
    .then(data => {
      if (!data.images?.length) {
        grid.innerHTML = '<div style="text-align:center;color:var(--slate);font-size:0.82rem;grid-column:1/-1;padding:20px;">No brand images uploaded yet.<br><a href="/admin/design#brand-images" style="color:var(--navy);">Upload in Design & Settings</a></div>';
        return;
      }
      grid.innerHTML = '';
      for (const img of data.images) {
        const card = document.createElement('div');
        card.style.cssText = 'border:1px solid var(--border);border-radius:2px;overflow:hidden;cursor:pointer;transition:border-color 0.15s;';
        card.onmouseover = () => card.style.borderColor = 'var(--gold)';
        card.onmouseout = () => card.style.borderColor = 'var(--border)';
        card.innerHTML = `
          <div style="aspect-ratio:1/1;background:var(--ivory);display:flex;align-items:center;justify-content:center;overflow:hidden;">
            <img src="${img.url}" alt="${img.label}" style="max-width:100%;max-height:100%;object-fit:cover;">
          </div>
          <div style="padding:6px 8px;font-size:0.65rem;color:var(--slate);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${img.label || img.slot}</div>
        `;
        card.onclick = () => {
          const tag = `<img src="${img.url}" alt="${img.label || ''}" style="max-width:100%;height:auto;display:block;margin:16px 0;">`;
          insertAtCursor(campBody, tag);
          closeImgPicker();
        };
        grid.appendChild(card);
      }
    })
    .catch(() => {
      grid.innerHTML = '<div style="text-align:center;color:var(--danger);font-size:0.82rem;grid-column:1/-1;padding:20px;">Failed to load images.</div>';
    });
}

function closeImgPicker() {
  document.getElementById('imgPickerModal').style.display = 'none';
}

function insertExtImage() {
  const url = document.getElementById('extImgUrl').value.trim();
  if (!url) return;
  const tag = `<img src="${url}" alt="" style="max-width:100%;height:auto;display:block;margin:16px 0;">`;
  insertAtCursor(campBody, tag);
  closeImgPicker();
}

document.getElementById('imgPickerModal')?.addEventListener('click', function(e) {
  if (e.target === this) closeImgPicker();
});

// Copy-to-clipboard helper (hosted link + embed snippet)
function copyText(btn, text) {
  const done = () => { const o = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = o, 1400); };
  if (navigator.clipboard) { navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done)); }
  else fallbackCopy(text, done);
}
function fallbackCopy(text, cb) {
  const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); } catch (e) {}
  document.body.removeChild(ta); if (cb) cb();
}

// Form copy AI generator — fills the New Form fields from a one-line brief.
(function() {
  const btn = document.getElementById('formAgentBtn');
  if (!btn) return;
  btn.addEventListener('click', async function() {
    const brief = prompt('What is this form for? (e.g. "free SEO checklist lead magnet" or "VIP early-access list")');
    if (brief === null) return;
    const orig = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = 'Writing…';
    try {
      const res = await fetch('/admin/email-marketing/forms/agent', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt: brief || 'a general newsletter signup form' }),
      });
      const data = await res.json();
      if (data.error) { alert('Agent error: ' + data.error); return; }
      const fill = data.fill || {};
      const map = { headline: 'fHeadline', subhead: 'fSubhead', buttonText: 'fButton', successMessage: 'fSuccess', welcomeSubject: 'fWelcomeSubject', welcomeBody: 'fWelcomeBody' };
      for (const [k, id] of Object.entries(map)) {
        if (fill[k]) { const el = document.getElementById(id); if (el) { el.value = fill[k]; el.classList.add('ai-filled'); } }
      }
      if (fill.headline && !document.getElementById('fName').value) document.getElementById('fName').value = brief.slice(0, 40) || fill.headline;
    } catch (e) {
      alert('Could not reach the writing assistant. Please try again.');
    } finally {
      btn.disabled = false; btn.innerHTML = orig;
    }
  });
})();
</script>

</div></div>

<!-- Agent Overlay + Panel (campaigns tab only) -->
<% if (tab === 'campaigns') { %>
<div id="agentOverlay"></div>
<div id="agentPanel">
  <div class="ap-header">
    <div class="ap-title"><span class="ap-dot"></span> Marketing Agent</div>
    <button class="ap-close" id="agentClose">&#10005;</button>
  </div>
  <div class="ap-sub">
    <span class="ap-sub-dot"></span>
    Qwen 2.5 &middot; Web search enabled &middot; Auto-fills campaign fields
  </div>
  <div class="ap-msgs" id="agentMsgs">
    <div class="ap-msg assistant">
      <div class="ap-bubble">
        Hi! I'm your email marketing assistant. I can research topics and write campaign emails &mdash; subject lines, preview text, and full HTML body.<br><br>
        Try: <em>"Write a spring promotion email for our marketing services"</em> or <em>"Create a newsletter about social media tips"</em>
      </div>
    </div>
  </div>
  <div class="ap-footer">
    <div class="ap-quick" id="apQuick"></div>
    <script>
    (function(){
      const brand = <%- JSON.stringify({ name: brand?.name||'', location: brand?.location||'', services: brand?.services||[], targetAudience: brand?.targetAudience||'' }) %>;
      const biz = brand.name || 'the business';
      const svc = brand.services.length ? brand.services[0] : 'our services';
      const audience = brand.targetAudience || 'subscribers';
      const loc = brand.location ? ` in ${brand.location}` : '';
      const pool = [
        { label: 'Write from Subject', prompt: 'Based on the current subject line, write a compelling email body' },
        { label: 'Promo Email', prompt: `Write a promotional email about ${svc} for ${audience}${loc}` },
        { label: 'Newsletter', prompt: `Write a newsletter email with helpful tips for ${audience}` },
        { label: 'Discount Offer', prompt: `Write an email announcing a limited-time discount on ${brand.services.length>1 ? brand.services.slice(0,2).join(' and ') : svc}` },
        { label: 'Re-engagement', prompt: "Write a re-engagement email for contacts who haven't opened recent campaigns" },
        { label: 'Welcome Email', prompt: `Write a welcome email for new ${biz} subscribers introducing the team and services` },
        { label: 'Monthly Update', prompt: `Write a monthly update email highlighting recent work and upcoming offers from ${biz}` },
        { label: 'Event Invite', prompt: `Write an email inviting ${audience} to a free consultation or event` },
      ];
      for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}
      const el=document.getElementById('apQuick');
      let idx=0;
      function render(){
        el.innerHTML='';
        const batch=[pool.find(p=>p.label==='Write from Subject')];
        for(let i=0;i<4;i++){idx=(idx+1)%pool.length; if(pool[idx].label!=='Write from Subject') batch.push(pool[idx]);}
        batch.slice(0,5).forEach(s=>{
          const b=document.createElement('button');b.className='ap-quick-btn';b.dataset.prompt=s.prompt;b.textContent=s.label;
          b.onclick=()=>{document.getElementById('agentInput').value=s.prompt;document.getElementById('agentSend').click();};
          el.appendChild(b);
        });
        const cyc=document.createElement('button');cyc.className='ap-cycle-btn';cyc.style.cssText='opacity:0.5;font-size:0.7rem;padding:5px 8px;border:1px solid var(--border);background:var(--surface);color:var(--slate);cursor:pointer;border-radius:2px;';cyc.textContent='\u267B';cyc.title='More suggestions';
        cyc.onclick=(e)=>{e.stopPropagation();idx=(idx+2)%pool.length;render();};
        el.appendChild(cyc);
      }
      render();
    })();
    </script>
    <div class="ap-input-row">
      <textarea class="ap-input" id="agentInput" placeholder="Ask the agent to write an email campaign..." rows="1"></textarea>
      <button class="ap-send" id="agentSend">&uarr;</button>
    </div>
    <span id="ai-status"></span>
  </div>
</div>

<script>
(function() {
  const panel = document.getElementById('agentPanel');
  const overlay = document.getElementById('agentOverlay');
  if (!panel || !overlay) return;

  document.getElementById('agentToggle').addEventListener('click', openPanel);
  document.getElementById('agentClose').addEventListener('click', closePanel);
  overlay.addEventListener('click', closePanel);

  function openPanel() {
    panel.classList.add('open');
    overlay.classList.add('active');
  }
  function closePanel() {
    panel.classList.remove('open');
    overlay.classList.remove('active');
  }

  // Mobile keyboard: keep footer pinned
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', () => {
      if (panel.classList.contains('open')) {
        panel.style.height = window.visualViewport.height + 'px';
        panel.style.top = window.visualViewport.offsetTop + 'px';
        document.getElementById('agentMsgs').scrollTop = document.getElementById('agentMsgs').scrollHeight;
      }
    });
  }

  // Quick prompt buttons
  document.getElementById('apQuick').querySelectorAll('.ap-quick-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('agentInput').value = this.dataset.prompt;
      sendAgent();
    });
  });

  const agentInput = document.getElementById('agentInput');
  agentInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendAgent(); }
  });
  agentInput.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });
  document.getElementById('agentSend').addEventListener('click', sendAgent);

  // Field helpers
  function getField(id) { return document.getElementById(id); }

  function fillField(fieldId, value) {
    const el = getField(fieldId);
    if (!el) return;
    el.value = value;
    el.classList.add('ai-filled');
  }

  function getCurrentCampaign() {
    return {
      subject: (getField('campSubject') || {}).value || '',
      preheader: (getField('campPreheader') || {}).value || '',
      body: (getField('campBody') || {}).value || '',
      targetFunnel: (getField('campTargetFunnel') || {}).value || 'all',
    };
  }

  // Messages
  const agentMessages = [];

  function appendMsg(role, text, extra) {
    const msgs = document.getElementById('agentMsgs');
    const el = document.createElement('div');
    el.className = 'ap-msg ' + role;
    el.innerHTML = '<div class="ap-bubble">' + text.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</div>';
    if (extra) el.innerHTML += extra;
    msgs.appendChild(el);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function showTyping() {
    const msgs = document.getElementById('agentMsgs');
    const el = document.createElement('div');
    el.id = 'apTyping';
    el.className = 'ap-msg assistant';
    el.innerHTML = '<div class="ap-typing"><div class="ap-typing-dot"></div><div class="ap-typing-dot"></div><div class="ap-typing-dot"></div></div>';
    msgs.appendChild(el);
    msgs.scrollTop = msgs.scrollHeight;
  }
  function hideTyping() { document.getElementById('apTyping')?.remove(); }

  async function sendAgent() {
    const text = agentInput.value.trim();
    if (!text) return;
    agentInput.value = '';
    agentInput.style.height = 'auto';
    document.getElementById('agentSend').disabled = true;

    agentMessages.push({ role: 'user', content: text });
    appendMsg('user', text);
    showTyping();

    try {
      const res = await fetch('/admin/email-marketing/campaigns/agent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: agentMessages, currentCampaign: getCurrentCampaign() }),
      });
      const data = await res.json();
      hideTyping();

      if (data.error) {
        appendMsg('assistant', 'Error: ' + data.error);
      } else {
        const fill = data.fill || {};
        const fillCount = Object.keys(fill).length;

        if (fill.subject) fillField('campSubject', fill.subject);
        if (fill.preheader) fillField('campPreheader', fill.preheader);
        if (fill.body) fillField('campBody', fill.body);

        agentMessages.push({ role: 'assistant', content: data.message });

        let extra = '';
        if (fillCount) extra = '<div class="ap-fill-notice" style="margin-top:4px;">&#10003; ' + fillCount + ' field' + (fillCount > 1 ? 's' : '') + ' filled</div>';
        appendMsg('assistant', data.message, extra);
      }
    } catch(e) {
      hideTyping();
      appendMsg('assistant', 'Connection error. Please try again.');
    } finally {
      document.getElementById('agentSend').disabled = false;
      agentInput.focus();
    }
  }
})();
</script>
<% } %>

