<%- include('partials/head', { title: 'QR Codes & Business Card' }) %>
<%- include('partials/sidebar', { page: 'qr-codes', user: user }) %>

<style>
.qr-page { max-width: 960px; margin: 0 auto; }
.qr-page h1 { font-family: var(--font-heading), serif; font-size: 1.6rem; font-weight: 600; margin-bottom: 6px; }
.qr-page .subtitle { color: var(--on-ivory-muted); font-size: 0.85rem; margin-bottom: 28px; }

/* Create form */
.qr-create-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 24px; margin-bottom: 28px;
}
.qr-create-card h2 { font-family: var(--font-heading), serif; font-size: 1.1rem; margin-bottom: 16px; }
.qr-form-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
.qr-form-group { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 160px; }
.qr-form-group label { font-size: 0.75rem; font-weight: 500; color: var(--on-ivory-muted); text-transform: uppercase; letter-spacing: 0.03em; }
.qr-form-group input, .qr-form-group select {
  padding: 9px 12px; border: 1px solid var(--border); border-radius: 6px;
  font-size: 0.85rem; font-family: var(--font-body), sans-serif; background: var(--surface);
}
.qr-form-group input:focus, .qr-form-group select:focus { outline: none; border-color: var(--accent); }

/* QR Link Cards */
.qr-links-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-top: 20px; }
.qr-link-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 20px; position: relative; transition: border-color 0.2s;
}
.qr-link-card:hover { border-color: var(--accent); }
.qr-link-card .qr-type-badge {
  display: inline-block; font-size: 0.65rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.05em; padding: 2px 8px; border-radius: 3px; margin-bottom: 8px;
}
.qr-type-badge.business-card { background: var(--accent); color: var(--on-surface); }
.qr-type-badge.custom { background: var(--primary-mid); color: var(--surface); }
.qr-type-badge.page { background: var(--border); color: var(--on-surface); }
.qr-type-badge.link { background: var(--primary); color: var(--surface); }

.qr-link-card h3 { font-family: var(--font-heading), serif; font-size: 1.05rem; margin-bottom: 4px; }
.qr-link-card .qr-url { font-size: 0.75rem; color: var(--on-ivory-muted); word-break: break-all; margin-bottom: 12px; }

.qr-preview-area { text-align: center; margin: 12px 0; }
.qr-preview-area img { width: 160px; height: 160px; border-radius: 4px; border: 1px solid var(--border); }

.qr-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
.qr-actions form { display: inline; }

/* Business card preview */
.bcard-preview {
  background: var(--primary); color: var(--surface); border-radius: 12px;
  padding: 28px 24px; text-align: center; max-width: 340px; margin: 0 auto 28px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
}
.bcard-preview .bcard-logo { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; border: 2px solid var(--accent); }
.bcard-preview .bcard-name { font-family: var(--font-heading), serif; font-size: 1.3rem; font-weight: 600; margin-bottom: 4px; }
.bcard-preview .bcard-tagline { font-size: 0.8rem; opacity: 0.8; margin-bottom: 16px; }
.bcard-preview .bcard-contact { font-size: 0.78rem; opacity: 0.7; line-height: 1.6; }

/* Footer toggle indicator */
.footer-badge { font-size: 0.65rem; padding: 2px 6px; border-radius: 3px; font-weight: 500; }
.footer-badge.on { background: #dcfce7; color: #166534; }
.footer-badge.off { background: var(--border); color: var(--on-ivory-muted); }

/* Toast */
.qr-toast {
  position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 10001;
  background: #14532d; color: #86efac; padding: 12px 24px; border-radius: 8px;
  font-size: 0.85rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  animation: toastIn 0.3s ease, toastOut 0.3s ease 3s forwards;
}
@keyframes toastIn { from { opacity: 0; transform: translateX(-50%) translateY(-10px); } }
@keyframes toastOut { to { opacity: 0; transform: translateX(-50%) translateY(-10px); } }

/* Empty state */
.qr-empty {
  text-align: center; padding: 48px 24px; color: var(--on-ivory-muted);
  border: 2px dashed var(--border); border-radius: 8px; margin-top: 20px;
}
.qr-empty svg { opacity: 0.3; margin-bottom: 12px; }

@media (max-width: 600px) {
  .qr-form-row { flex-direction: column; }
  .qr-links-grid { grid-template-columns: 1fr; }
}

/* Card design modal */
.qr-modal { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 10002; display: flex; align-items: center; justify-content: center; padding: 20px; }
.qr-modal-box { background: var(--surface); border-radius: 12px; width: min(820px,96vw); max-height: 88vh; overflow: auto; padding: 18px; box-shadow: 0 16px 48px rgba(0,0,0,.3); }
.qr-modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.qr-modal-head strong { font-family: var(--font-heading), serif; font-size: 1.05rem; }
.qr-modal-head button { border: 0; background: transparent; font-size: 1.2rem; cursor: pointer; color: var(--on-ivory-muted); }
.cd-grid { display: grid; grid-template-columns: 220px 1fr; gap: 18px; align-items: start; }
.cd-controls { display: flex; flex-direction: column; gap: 12px; }
.cd-preview { background: repeating-conic-gradient(#e9e9e9 0% 25%, #f6f6f6 0% 50%) 0/22px 22px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; display: flex; }
.cd-preview iframe { border: 0; width: 100%; height: 560px; background: transparent; }
.hidden { display: none !important; }
@media (max-width: 640px) { .cd-grid { grid-template-columns: 1fr; } .cd-preview iframe { height: 460px; } }
</style>

<main class="admin-main">
  <div class="qr-page">
    <% if (saved) { %><div class="qr-toast">Changes saved!</div><% } %>

    <h1>QR Codes & Business Card</h1>
    <p class="subtitle">Create QR links, digital business cards, and share branded content with a scan.</p>

    <!-- ═══ Business Card Preview ═══ -->
    <div class="qr-create-card">
      <h2>Your Digital Business Card</h2>
      <p style="font-size:0.82rem;color:var(--on-ivory-muted);margin-bottom:16px;">
        Create a "Business Card" QR link below. When scanned, visitors see a branded mobile card with your info, QR code, and an option to add it to their home screen.
      </p>
      <div class="bcard-preview" style="background:<%= brandDesign.color_primary || '#1C2B4A' %>;">
        <% if (logo) { %>
          <img src="<%= logo %>" alt="Logo" class="bcard-logo">
        <% } else { %>
          <div style="width:64px;height:64px;border-radius:50%;background:var(--accent);display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:700;color:var(--on-surface);margin-bottom:12px;"><%= (brand?.name || '?')[0] %></div>
        <% } %>
        <div class="bcard-name"><%= brand?.name || 'Your Business' %></div>
        <div class="bcard-tagline"><%= brand?.tagline || brand?.businessType || '' %></div>
        <div style="width:100px;height:100px;background:rgba(255,255,255,0.15);border-radius:6px;margin:12px auto;display:flex;align-items:center;justify-content:center;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"><rect x="2" y="2" width="8" height="8" rx="1"/><rect x="14" y="2" width="8" height="8" rx="1"/><rect x="2" y="14" width="8" height="8" rx="1"/><rect x="14" y="14" width="2" height="2"/><rect x="20" y="14" width="2" height="2"/><rect x="14" y="20" width="2" height="2"/><rect x="20" y="20" width="2" height="2"/><rect x="17" y="17" width="2" height="2"/></svg>
        </div>
        <div class="bcard-contact">
          <% if (brand?.phone) { %><div><%= brand.phone %></div><% } %>
          <% if (brand?.email) { %><div><%= brand.email %></div><% } %>
          <% if (brand?.location) { %><div><%= brand.location %></div><% } %>
        </div>
      </div>
    </div>

    <!-- ═══ Create New QR Link ═══ -->
    <div class="qr-create-card">
      <h2>Create QR Link</h2>
      <form method="POST" action="/admin/qr-codes">
        <div class="qr-form-row">
          <div class="qr-form-group" style="flex:1.4;">
            <label>Destination</label>
            <select name="destination" id="qrDest" onchange="onDestChange()">
              <% if (destinations && destinations.length) { %>
                <% destinations.forEach(function(g) { %>
                  <optgroup label="<%= g.group %>">
                    <% g.items.forEach(function(it) { %>
                      <option value="<%= it.url %>" data-label="<%= it.label %>"><%= it.label %></option>
                    <% }); %>
                  </optgroup>
                <% }); %>
              <% } %>
              <optgroup label="Other">
                <option value="custom">Custom URL…</option>
                <option value="business-card">Digital Business Card</option>
              </optgroup>
            </select>
          </div>
          <div class="qr-form-group">
            <label>Label</label>
            <input type="text" name="label" id="qrLabel" placeholder="e.g. Spring Promo" required>
          </div>
          <div class="qr-form-group" id="slugGroup" style="display:none;">
            <label>Card Slug</label>
            <input type="text" name="slug" placeholder="e.g. main" pattern="[a-z0-9\-]+" title="Lowercase letters, numbers, hyphens only">
          </div>
          <div class="qr-form-group" id="urlGroup" style="display:none;">
            <label>URL</label>
            <input type="url" name="url" placeholder="https://...">
          </div>
          <div class="qr-form-group" style="flex:0 0 auto;">
            <label>&nbsp;</label>
            <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Create QR</button>
          </div>
        </div>
        <p style="font-size:0.72rem;color:var(--on-ivory-muted);margin:10px 2px 0;">
          Pick any of your pages, blog posts, portfolio, or forms — the QR points straight there. Choose “Custom URL” to link anywhere else.
        </p>
      </form>
    </div>

    <!-- ═══ Existing QR Links ═══ -->
    <h2 style="font-family:var(--font-heading),serif;font-size:1.1rem;margin-top:32px;">Your QR Links</h2>

    <% if (!links || links.length === 0) { %>
      <div class="qr-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="8" height="8" rx="1"/><rect x="14" y="2" width="8" height="8" rx="1"/><rect x="2" y="14" width="8" height="8" rx="1"/><rect x="14" y="14" width="2" height="2"/><rect x="20" y="14" width="2" height="2"/><rect x="14" y="20" width="2" height="2"/><rect x="20" y="20" width="2" height="2"/><rect x="17" y="17" width="2" height="2"/></svg>
        <p style="font-size:0.9rem;margin-bottom:4px;">No QR links yet</p>
        <p style="font-size:0.78rem;">Create your first QR code above to get started.</p>
      </div>
    <% } else { %>
      <div class="qr-links-grid">
        <% links.forEach(function(link) { %>
          <div class="qr-link-card">
            <span class="qr-type-badge <%= link.type %>"><%= link.type === 'business-card' ? 'Business Card' : link.type === 'page' ? 'Page' : link.type === 'link' ? 'Link' : 'Custom' %></span>
            <% if (link.showInFooter) { %><span class="footer-badge on">In Footer</span><% } %>
            <h3><%- link.label %></h3>
            <div class="qr-url"><%= link.url %></div>

            <div class="qr-preview-area">
              <img src="/admin/qr-codes/<%= link._id %>/qr.png" alt="QR Code" loading="lazy">
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.72rem;color:var(--on-ivory-muted);margin-bottom:8px;">
              <span>Created <%= link.createdAt ? new Date(link.createdAt).toLocaleDateString() : '' %></span>
              <span><%= link.scanCount || 0 %> scans</span>
            </div>

            <div class="qr-actions">
              <a href="/admin/qr-codes/<%= link._id %>/qr.png" download="<%= link.slug %>-qr.png" class="btn btn-sm">Download PNG</a>
              <button class="btn btn-sm btn-outline" onclick="openStyle('<%= link._id %>')">Style</button>

              <% if (link.type === 'business-card') { %>
                <a href="/card/<%= link.slug %>" target="_blank" class="btn btn-sm btn-outline">Preview Card</a>
                <button class="btn btn-sm btn-outline" onclick="openDesign('<%= link._id %>','<%= link.slug %>','<%= (link.card && link.card.template) || '' %>','<%= (link.card && link.card.scheme) || '' %>')">Design</button>
              <% } %>

              <form method="POST" action="/admin/qr-codes/<%= link._id %>/footer">
                <button type="submit" class="btn btn-sm btn-outline" title="<%= link.showInFooter ? 'Remove from footer' : 'Show in website footer' %>">
                  <%= link.showInFooter ? 'Remove from Footer' : 'Add to Footer' %>
                </button>
              </form>

              <button class="btn btn-sm btn-outline" onclick="copyToClipboard('<%= link.url %>', this)">Copy URL</button>

              <form method="POST" action="/admin/qr-codes/<%= link._id %>/delete" onsubmit="return confirm('Delete this QR link?')">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

  <!-- ═══ Card Design modal ═══ -->
  <div id="cardDesignModal" class="qr-modal hidden">
    <div class="qr-modal-box">
      <div class="qr-modal-head"><strong>Card Design</strong><button type="button" onclick="closeDesign()" aria-label="Close">✕</button></div>
      <form id="cardDesignForm" method="POST">
        <div class="cd-grid">
          <div class="cd-controls">
            <div class="qr-form-group">
              <label>Template</label>
              <select name="template" id="cdTemplate" onchange="cdPreview()">
                <% Object.entries(cardTemplates).forEach(function([k,t]){ %><option value="<%= k %>"><%= t.label %></option><% }); %>
              </select>
            </div>
            <div class="qr-form-group">
              <label>Color scheme</label>
              <select name="scheme" id="cdScheme" onchange="cdPreview()">
                <% Object.entries(cardSchemes).forEach(function([k,s]){ %><option value="<%= k %>"><%= s.label %></option><% }); %>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Save design</button>
            <a id="cdOpen" href="#" target="_blank" class="btn btn-sm btn-outline">Open full card ↗</a>
            <p style="font-size:0.72rem;color:var(--on-ivory-muted);margin-top:4px;">Live preview updates as you pick. “Brand colors” uses your design palette.</p>
          </div>
          <div class="cd-preview"><iframe id="cdFrame" title="Card preview"></iframe></div>
        </div>
      </form>
    </div>
  </div>

  <!-- ═══ QR Style modal ═══ -->
  <div id="qrStyleModal" class="qr-modal hidden">
    <div class="qr-modal-box">
      <div class="qr-modal-head"><strong>QR Style</strong><button type="button" onclick="closeStyle()" aria-label="Close">✕</button></div>
      <form id="qrStyleForm" method="POST">
        <div class="cd-grid">
          <div class="cd-controls">
            <div class="qr-form-group"><label>Modules</label>
              <select name="module" id="qsModule" onchange="qsPreview()"><option value="square">Square</option><option value="dots">Dots</option><option value="rounded">Rounded</option></select>
            </div>
            <div class="qr-form-group"><label>Fill</label>
              <select name="fill" id="qsFill" onchange="qsPreview()"><option value="solid">Solid color</option><option value="gradient">Gradient</option></select>
            </div>
            <div class="qr-form-row" style="gap:8px">
              <div class="qr-form-group" style="min-width:0"><label>Color</label><input type="color" name="color1" id="qsColor1" oninput="qsPreview()"></div>
              <div class="qr-form-group" id="qsColor2Wrap" style="min-width:0"><label>End color</label><input type="color" name="color2" id="qsColor2" oninput="qsPreview()"></div>
              <div class="qr-form-group" id="qsGradWrap" style="min-width:0"><label>Gradient</label><select name="gradientType" id="qsGrad" onchange="qsPreview()"><option value="linear">Linear</option><option value="radial">Radial</option></select></div>
            </div>
            <label class="inline" style="font-size:0.84rem"><input type="checkbox" name="logo" id="qsLogo" value="1" onchange="qsPreview()" style="width:auto"> Center logo</label>
            <hr style="border:0;border-top:1px solid var(--border);margin:4px 0">
            <label class="inline" style="font-size:0.84rem"><input type="checkbox" name="phantom" id="qsPhantom" value="1" onchange="qsPreview()" style="width:auto"> Phantom — melt into an image</label>
            <div id="qsPhantomWrap" style="display:none;flex-direction:column;gap:8px">
              <div class="qr-form-group"><label>Background image</label>
                <select name="bgImageUrl" id="qsBg" onchange="qsPreview()"><option value="">— choose —</option><% (brandImages||[]).forEach(function(im){ %><option value="<%= im.url %>"><%= im.slot %><%= im.label?(' — '+im.label):'' %></option><% }); %></select>
              </div>
              <div class="qr-form-group"><label>Visibility</label><input type="range" name="contrast" id="qsContrast" min="0.35" max="0.85" step="0.05" value="0.6" oninput="qsPreview()"></div>
            </div>
            <input type="hidden" name="bg" value="transparent"><input type="hidden" name="bgColor" value="#ffffff">
            <button type="submit" class="btn btn-primary" style="margin-top:6px">Save style</button>
            <p style="font-size:0.72rem;color:var(--on-ivory-muted)">Phantom stays scannable but subtle. This style is also inherited by Print Studio (which may re-tint colors to match each material).</p>
          </div>
          <div class="cd-preview" style="align-items:center;justify-content:center;padding:18px"><img id="qsImg" alt="QR preview" style="width:100%;max-width:300px;border-radius:8px"></div>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
var cdSlug = '';
function openDesign(id, slug, tpl, scheme) {
  document.getElementById('cardDesignForm').action = '/admin/qr-codes/' + id + '/card';
  cdSlug = slug;
  document.getElementById('cdTemplate').value = tpl || '<%= defaultCardTemplate %>';
  document.getElementById('cdScheme').value = scheme || '<%= defaultCardScheme %>';
  document.getElementById('cardDesignModal').classList.remove('hidden');
  cdPreview();
}
function closeDesign() { document.getElementById('cardDesignModal').classList.add('hidden'); }
function cdPreview() {
  var t = document.getElementById('cdTemplate').value, s = document.getElementById('cdScheme').value;
  var u = '/card/' + cdSlug + '?tpl=' + t + '&scheme=' + s;
  document.getElementById('cdFrame').src = u;
  document.getElementById('cdOpen').href = u;
}
document.getElementById('cardDesignModal').addEventListener('click', function(e){ if (e.target === this) closeDesign(); });

// ── QR style editor ──
var QR_STYLES = <%- JSON.stringify(Object.fromEntries((links||[]).map(function(l){ return [String(l._id), l.style||{}]; }))) %>;
var qsId = '';
var QS_DEFAULT_C1 = '<%= designColors && designColors.color_primary || "#1C2B4A" %>';
var QS_DEFAULT_C2 = '<%= designColors && designColors.color_accent || "#C9A848" %>';
function qsEl(id){ return document.getElementById(id); }
function openStyle(id){
  qsId = id; var s = QR_STYLES[id] || {};
  qsEl('qrStyleForm').action = '/admin/qr-codes/' + id + '/style';
  qsEl('qsModule').value = s.module || 'square';
  qsEl('qsFill').value = s.fill || 'solid';
  qsEl('qsColor1').value = s.color1 || QS_DEFAULT_C1;
  qsEl('qsColor2').value = s.color2 || QS_DEFAULT_C2;
  qsEl('qsGrad').value = s.gradientType || 'linear';
  qsEl('qsLogo').checked = !!s.logo;
  qsEl('qsPhantom').checked = !!s.phantom;
  qsEl('qsBg').value = s.bgImageUrl || '';
  qsEl('qsContrast').value = s.contrast || 0.6;
  qsEl('qrStyleModal').classList.remove('hidden');
  qsPreview();
}
function closeStyle(){ qsEl('qrStyleModal').classList.add('hidden'); }
function qsPreview(){
  var grad = qsEl('qsFill').value === 'gradient';
  qsEl('qsColor2Wrap').style.display = grad ? '' : 'none';
  qsEl('qsGradWrap').style.display = grad ? '' : 'none';
  qsEl('qsPhantomWrap').style.display = qsEl('qsPhantom').checked ? 'flex' : 'none';
  var p = new URLSearchParams({
    module: qsEl('qsModule').value, fill: qsEl('qsFill').value,
    color1: qsEl('qsColor1').value, color2: qsEl('qsColor2').value, gradientType: qsEl('qsGrad').value,
    logo: qsEl('qsLogo').checked ? '1' : '0', phantom: qsEl('qsPhantom').checked ? '1' : '0',
    bgImageUrl: qsEl('qsBg').value, contrast: qsEl('qsContrast').value, bg: 'transparent', _: Date.now(),
  });
  qsEl('qsImg').src = '/admin/qr-codes/' + qsId + '/qr.png?' + p.toString();
}
qsEl('qrStyleModal').addEventListener('click', function(e){ if (e.target === this) closeStyle(); });

function onDestChange() {
  var sel = document.getElementById('qrDest');
  var val = sel.value;
  var opt = sel.options[sel.selectedIndex];
  document.getElementById('urlGroup').style.display = val === 'custom' ? '' : 'none';
  document.getElementById('slugGroup').style.display = val === 'business-card' ? '' : 'none';

  // Auto-fill the label from the chosen destination if the user hasn't typed one.
  var labelEl = document.getElementById('qrLabel');
  if (!labelEl.value.trim() || labelEl.dataset.auto === '1') {
    var dl = opt.getAttribute('data-label');
    if (dl) { labelEl.value = dl; labelEl.dataset.auto = '1'; }
  }
}
// Once the admin edits the label themselves, stop auto-filling it.
document.addEventListener('DOMContentLoaded', function() {
  var labelEl = document.getElementById('qrLabel');
  labelEl.addEventListener('input', function() { labelEl.dataset.auto = '0'; });
  onDestChange();
});

function copyToClipboard(text, btn) {
  navigator.clipboard.writeText(text).then(function() {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  });
}
</script>

</body>
</html>
