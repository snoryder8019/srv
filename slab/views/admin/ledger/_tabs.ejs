<%
  // Shared Finance tab bar. Include with: include('_tabs', { active: 'pnl' })
  const tabs = [
    { key: 'pnl',        label: 'P&L',        href: '/admin/ledger' },
    { key: 'entries',    label: 'Ledger',     href: '/admin/ledger/entries' },
    { key: 'adjustments',label: 'Adjustments',href: '/admin/ledger/adjustments' },
    { key: 'scan',       label: 'Scan',       href: '/admin/ledger/scan' },
    { key: 'statements', label: 'Statements', href: '/admin/ledger/statements' },
    { key: 'budget',     label: 'Budget',     href: '/admin/ledger/budget' },
    { key: 'categories', label: 'GL Accounts',href: '/admin/ledger/categories' },
    { key: 'mileage',    label: 'Mileage',    href: '/admin/ledger/mileage' },
    { key: 'utilities',  label: 'Utilities',  href: '/admin/ledger/utilities' },
  ];
  const activeTab = typeof active !== 'undefined' ? active : 'pnl';
%>
<div class="tabs finance-tabs" style="margin-bottom:20px;overflow-x:auto;">
  <% tabs.forEach(function(t){ %>
    <a href="<%= t.href %>" class="tab-link <%= activeTab === t.key ? 'active' : '' %>"><%= t.label %>
      <% if (t.key === 'scan' || t.key === 'statements') { %><span class="tab-ai" title="AI-assisted">AI</span><% } %>
    </a>
  <% }) %>
</div>
<style>
  .finance-tabs .tab-ai{display:inline-block;margin-left:5px;font-size:0.54rem;font-weight:700;letter-spacing:0.08em;background:var(--badge-accent,rgba(201,168,72,0.16));color:var(--gold,#C9A848);padding:1px 5px;border-radius:3px;vertical-align:middle;}
  @media print { .finance-tabs, .topbar-actions { display:none !important; } }
</style>
