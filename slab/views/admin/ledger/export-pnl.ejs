<%
  const qs = new URLSearchParams(query || {}).toString();
  const q = qs ? ('?' + qs) : '';
  const fmt = (v) => (typeof v === 'number')
    ? (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})
    : (v || '');
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= brandName %> — Profit &amp; Loss (<%= label %>)</title>
<style>
  :root{--navy:#1C2B4A;--gold:#C9A848;--ivory:#F5F3EF;--border:#E2DDD3;--slate:#6B7280;--danger:#B91C1C;--success:#15803D;}
  *{box-sizing:border-box;}
  body{margin:0;font-family:'Jost',system-ui,-apple-system,Segoe UI,sans-serif;color:#1a1a1a;background:#f0eee9;padding:32px 16px;}
  .sheet{max-width:820px;margin:0 auto;background:#fff;border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 24px rgba(0,0,0,.06);overflow:hidden;}
  .sheet-head{padding:26px 30px;border-bottom:2px solid var(--navy);}
  .sheet-head .brand{font-size:0.68rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);}
  .sheet-head h1{font-family:'Cormorant Garamond',serif;font-size:1.9rem;color:var(--navy);margin:4px 0 2px;font-weight:600;}
  .sheet-head .sub{font-size:0.8rem;color:var(--slate);}
  table{width:100%;border-collapse:collapse;font-size:0.86rem;}
  th,td{padding:8px 30px;text-align:right;}
  th:first-child,td:first-child{text-align:left;}
  thead th{background:var(--navy);color:#fff;font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;}
  tbody tr.section td{background:var(--ivory);font-weight:700;color:var(--navy);border-top:1px solid var(--border);}
  tbody tr.line td{color:#333;}
  tbody tr.line td:first-child{padding-left:44px;}
  tbody tr.total td{font-weight:700;color:var(--navy);border-top:1px solid #d1d5db;}
  tbody tr.grand td{background:var(--gold);color:#fff;font-weight:700;font-size:0.95rem;}
  tbody tr.blank td{padding:5px 30px;border:0;}
  tfoot td{padding:14px 30px;font-size:0.7rem;color:var(--slate);}
  .neg{color:var(--danger);}
  .toolbar{max-width:820px;margin:0 auto 16px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  .toolbar .sp{flex:1;}
  .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:6px;border:1px solid var(--border);background:#fff;color:var(--navy);text-decoration:none;font-size:0.8rem;font-weight:500;cursor:pointer;font-family:inherit;}
  .btn.primary{background:var(--navy);color:#fff;border-color:var(--navy);}
  .btn.gold{background:var(--gold);color:#fff;border-color:var(--gold);}
  .btn:hover{filter:brightness(1.05);}
  @media print{
    body{background:#fff;padding:0;}
    .toolbar{display:none !important;}
    .sheet{box-shadow:none;border:0;border-radius:0;max-width:none;}
    thead th{background:var(--navy) !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    tbody tr.grand td,tbody tr.section td{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  }
</style>
</head>
<body>
  <div class="toolbar">
    <a class="btn" href="/admin/ledger<%= q %>">&larr; Back</a>
    <span class="sp"></span>
    <a class="btn gold" href="/admin/ledger/export.xlsx<%= q %>">&#8681; Excel (.xlsx)</a>
    <a class="btn" href="/admin/ledger/export.csv<%= q %>">&#8681; CSV</a>
    <button class="btn primary" onclick="window.print()">&#128424; Print</button>
  </div>

  <div class="sheet">
    <div class="sheet-head">
      <div class="brand"><%= brandName %></div>
      <h1>Profit &amp; Loss</h1>
      <div class="sub"><%= label %> · generated <%= new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}) %></div>
    </div>
    <table>
      <thead>
        <tr><% matrix.columns.forEach(function(c){ %><th><%= c %></th><% }) %></tr>
      </thead>
      <tbody>
        <% matrix.rows.forEach(function(r){ %>
          <tr class="<%= r.kind %>">
            <% r.cells.forEach(function(cell, i){
                 const isNeg = (typeof cell === 'number' && cell < 0);
            %>
              <td class="<%= isNeg ? 'neg' : '' %>"><%= i === 0 ? cell : fmt(cell) %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><td colspan="<%= matrix.columns.length %>">Variance = Actual − Budget · % of Bud = Actual ÷ Budget · Δ% = change vs <%= compareLabel %>. Generated by sLab Finance.</td></tr>
      </tfoot>
    </table>
  </div>
</body>
</html>
