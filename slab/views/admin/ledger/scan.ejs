<%- include('../partials/head', { title: 'Receipt Scanner' }) %>
<%- include('../partials/sidebar', { page: 'ledger', user: user }) %>

<div class="topbar">
  <div class="topbar-title">Finance</div>
  <div class="topbar-actions">
    <a href="/admin/ledger/entries" class="btn btn-ghost btn-sm">Go to Ledger</a>
  </div>
</div>

<div class="content" data-agent-scope="bookkeeping" data-agent-kind="agent" data-agent-title="Receipt Scan" data-agent-suggest="Which transaction does this receipt document?|Extract the vendor, date and total|Should this post to the ledger or just cross-reference?|Check if this duplicates an entry">
  <%- include('_tabs', { active: 'scan' }) %>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <!-- Uploader -->
  <div class="scan-hero card">
    <div class="scan-hero-copy">
      <div class="scan-kicker">AI Receipt &amp; Invoice Scanner</div>
      <h2 class="scan-title">Snap it, we read it, you approve it.</h2>
      <p class="text-slate" style="font-size:0.82rem;margin:0;">Upload a photo of a receipt or invoice. The AI drafts the vendor, date and amount, then finds the bank transaction it belongs to. Receipts are filed as <strong>proof against a statement line</strong> — they only become their own ledger entry when the spend never hits a statement.</p>
    </div>
    <form data-guard class="scan-drop" method="POST" action="/admin/ledger/scan" enctype="multipart/form-data" id="scanForm">
      <label class="dropzone" id="dropzone">
        <input type="file" name="receipt" accept="image/*,application/pdf" required id="fileInput" hidden>
        <div class="dz-icon">&#128247;</div>
        <div class="dz-main" id="dzMain">Tap to choose or drop a file</div>
        <div class="dz-sub text-slate">JPG, PNG, WEBP or PDF · up to 12MB</div>
      </label>
      <button type="submit" class="btn btn-navy" id="scanBtn" disabled>Scan &amp; Extract</button>
    </form>
  </div>

  <!-- Pending review queue -->
  <div class="flex-between" style="margin:26px 0 12px;">
    <h3 class="section-h">Pending review <span class="pill"><%= pending.length %></span></h3>
  </div>

  <% if (!pending.length) { %>
    <div class="empty"><div class="empty-icon">&#9989;</div><p>Nothing waiting. Uploaded receipts land here for your approval.</p></div>
  <% } else { %>
    <div class="scan-grid">
      <% pending.forEach(function(s){
           const isImg = (s.receiptType || '').startsWith('image/');
           const dstr = s.date ? new Date(s.date).toISOString().slice(0,10) : todayInput;
      %>
      <div class="scan-card card">
        <div class="scan-card-media">
          <% if (isImg) { %>
            <a href="/admin/ledger/scan/<%= s._id %>/receipt" target="_blank" title="Open full receipt">
              <img src="/admin/ledger/scan/<%= s._id %>/receipt" alt="receipt" loading="lazy">
            </a>
          <% } else { %>
            <a href="/admin/ledger/scan/<%= s._id %>/receipt" target="_blank" class="file-chip">
              <span class="file-ic">&#128196;</span>
              <span><%= s.receiptName || 'Document' %></span>
            </a>
          <% } %>
          <div class="scan-flags">
            <span class="badge badge-draft" style="text-transform:capitalize;"><%= s.docType || 'receipt' %></span>
            <% if (s.needsManual) { %>
              <span class="badge badge-inactive" title="<%= s.aiNote || '' %>">Manual entry</span>
            <% } else { %>
              <span class="badge badge-featured">AI read</span>
            <% } %>
          </div>
        </div>

        <% const cands = (matches || {})[String(s._id)] || []; %>

        <div class="scan-card-form">
          <% if (s.needsManual && s.aiNote) { %>
            <div class="ai-note"><%= s.aiNote %></div>
          <% } else if (s.summary) { %>
            <div class="ai-note ai-note-quote">&ldquo;<%= s.summary %>&rdquo;</div>
          <% } %>

          <!-- Primary path: file this receipt against the transaction it documents -->
          <form data-guard method="POST" action="/admin/ledger/scan/<%= s._id %>/match" class="match-block">
            <div class="match-head">
              <span class="match-title">Cross-reference to a transaction</span>
              <span class="match-hint">Files the receipt as proof — nothing posts to the ledger</span>
            </div>
            <% if (!cands.length) { %>
              <div class="ai-note match-empty">
                No matching transaction on record yet. Leave it here — it stays out of your books until the
                statement it belongs to is uploaded, then it becomes matchable.
              </div>
            <% } else { %>
              <div class="match-list">
                <% cands.forEach(function(m, i){ %>
                <label class="match-opt <%= m.exact ? 'is-exact' : '' %>">
                  <input type="radio" name="ref" value="<%= m.ref %>" <%= i === 0 ? 'checked' : '' %> required>
                  <span class="match-body">
                    <span class="match-line">
                      <span class="match-desc"><%= (m.description || '—').slice(0, 68) %></span>
                      <span class="match-amt"><%= money(m.amount) %></span>
                    </span>
                    <span class="match-meta">
                      <%= m.date ? new Date(m.date).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : 'no date' %>
                      &middot; <%= m.context %>
                      &middot; <%= m.posted ? 'on the ledger' : 'in review' %>
                      <% if (m.exact) { %><span class="match-exact">exact amount</span><% } %>
                    </span>
                  </span>
                </label>
                <% }) %>
              </div>
              <button type="submit" class="btn btn-navy btn-sm">&#128279; Cross-reference &amp; file</button>
            <% } %>
          </form>

          <!-- Rare path: this spend never hits a bank statement (cash / out-of-pocket) -->
          <details class="post-block">
            <summary>Cash or out-of-pocket &mdash; post as its own ledger entry</summary>
            <p class="post-warn">Only when this charge will never appear on a bank or card statement. Otherwise the statement posts it again and it double-counts.</p>
            <form data-guard method="POST" action="/admin/ledger/scan/<%= s._id %>/approve">
          <div class="form-grid cols-2">
            <div class="form-field">
              <label>Date</label>
              <input type="date" name="date" value="<%= dstr %>">
            </div>
            <div class="form-field">
              <label>Amount</label>
              <input type="number" step="0.01" min="0" name="amount" value="<%= (s.total || 0) ? s.total : '' %>" placeholder="0.00" required>
            </div>
            <div class="form-field span-2">
              <label>Vendor</label>
              <input type="text" name="vendor" value="<%= s.vendor || '' %>" placeholder="Merchant / biller">
            </div>
            <div class="form-field span-2">
              <label>Description</label>
              <input type="text" name="description" value="<%= s.summary || s.vendor || '' %>" placeholder="What was this?">
            </div>
            <div class="form-field span-2">
              <label>GL Category
                <% if (s.categoryGuess) { %><span class="guess">AI guess: <%= s.categoryGuess %></span><% } %>
              </label>
              <select name="categoryId" required>
                <option value="">— choose account —</option>
                <% ['income','cogs','labor','fixed','expense','liability'].forEach(function(tp){
                     const opts = categories.filter(function(c){ return c.type === tp; });
                     if (!opts.length) return; %>
                  <optgroup label="<%= tp.toUpperCase() %>">
                    <% opts.forEach(function(c){
                         const guess = (s.categoryGuess||'').toLowerCase();
                         const match = guess && c.name.toLowerCase().includes(guess.split(' ')[0]);
                         const typeMatch = (tp === (s.suggestedType === 'income' ? 'income' : 'expense'));
                    %>
                      <option value="<%= c._id %>" <%= match ? 'selected' : '' %>><%= c.name %></option>
                    <% }) %>
                  </optgroup>
                <% }) %>
              </select>
            </div>
            <div class="form-field span-2">
              <label>Tags</label>
              <input type="text" name="tags" list="scanTagList" placeholder="comma,separated,tags">
            </div>
          </div>

          <div class="scan-card-actions">
                <button type="submit" class="btn btn-ghost btn-sm">Post to ledger</button>
                <% if (cands.length) { %>
                  <label class="force-lbl"><input type="checkbox" name="force" value="1"> post anyway (I know it matches)</label>
                <% } %>
              </div>
            </form>
          </details>

          <form data-guard="button" method="POST" action="/admin/ledger/scan/<%= s._id %>/reject" class="scan-mini-actions">
            <button type="submit" class="btn btn-ghost btn-sm">Reject</button>
            <button type="submit" formaction="/admin/ledger/scan/<%= s._id %>/delete" class="btn btn-ghost btn-sm" style="color:var(--danger);" onclick="return confirm('Delete this scan?')">Delete</button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Recently handled -->
  <% if (recent.length) { %>
  <h3 class="section-h" style="margin:28px 0 12px;">Recently handled</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Vendor</th><th style="text-align:right;">Amount</th><th>Result</th><th>Reviewed by</th><th></th></tr></thead>
      <tbody>
        <% recent.forEach(function(s){ %>
        <tr>
          <td><%= s.date ? new Date(s.date).toLocaleDateString('en-US') : '—' %></td>
          <td><%= s.vendor || '—' %></td>
          <td style="text-align:right;"><%= money(s.total || 0) %></td>
          <td>
            <% if (s.status === 'matched') { %>
              <span class="badge badge-active">cross-referenced</span>
              <% if (s.matchLabel) { %><div class="text-slate" style="font-size:0.72rem;margin-top:3px;"><%= s.matchLabel %></div><% } %>
            <% } else if (s.status === 'approved') { %>
              <span class="badge badge-featured" title="This receipt became its own ledger line">posted to ledger</span>
            <% } else { %>
              <span class="badge badge-inactive" style="text-transform:capitalize;"><%= s.status %></span>
            <% } %>
          </td>
          <td class="text-slate" style="font-size:0.8rem;"><%= s.reviewedBy || '' %></td>
          <td style="text-align:right;">
            <% if (s.status === 'matched') { %>
            <form data-guard="button" method="POST" action="/admin/ledger/scan/<%= s._id %>/unmatch" style="margin:0;">
              <button class="btn btn-ghost btn-sm" style="font-size:0.66rem;padding:4px 10px;">Undo</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <datalist id="scanTagList">
    <% allTags.forEach(function(t){ %><option value="<%= t %>"></option><% }) %>
  </datalist>
</div>

<style>
  .section-h{font-size:0.95rem;font-weight:600;color:var(--navy);margin:0;display:flex;align-items:center;gap:8px;}
  .pill{display:inline-block;font-size:0.66rem;font-weight:700;background:var(--navy);color:#fff;border-radius:20px;padding:1px 9px;}
  .scan-hero{display:flex;gap:24px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:linear-gradient(135deg,rgba(28,43,74,0.03),rgba(201,168,72,0.05));}
  .scan-hero-copy{flex:1;min-width:260px;}
  .scan-kicker{font-size:0.62rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;}
  .scan-title{font-family:var(--font-heading,serif);font-size:1.5rem;font-weight:500;color:var(--navy);margin:0 0 8px;line-height:1.15;}
  .scan-drop{display:flex;flex-direction:column;gap:10px;min-width:260px;flex:1;}
  .dropzone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border:2px dashed var(--border);border-radius:10px;padding:22px;cursor:pointer;text-align:center;transition:border-color .15s,background .15s;background:var(--surface);}
  .dropzone.drag{border-color:var(--gold);background:rgba(201,168,72,0.06);}
  .dropzone.has-file{border-color:var(--success);background:rgba(21,128,61,0.05);}
  .dz-icon{font-size:1.6rem;}
  .dz-main{font-weight:500;font-size:0.86rem;color:var(--navy);}
  .dz-sub{font-size:0.7rem;}
  .scan-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:18px;}
  .scan-card{padding:0;overflow:hidden;display:flex;flex-direction:column;}
  .scan-card-media{position:relative;background:var(--ivory);border-bottom:1px solid var(--border);min-height:120px;display:flex;align-items:center;justify-content:center;}
  .scan-card-media img{width:100%;max-height:200px;object-fit:contain;display:block;}
  .file-chip{display:flex;align-items:center;gap:8px;padding:24px;color:var(--navy);text-decoration:none;font-size:0.82rem;}
  .file-chip .file-ic{font-size:1.4rem;}
  .scan-flags{position:absolute;top:8px;right:8px;display:flex;gap:5px;}
  .scan-card-form{padding:16px;display:flex;flex-direction:column;gap:12px;}
  .ai-note{font-size:0.75rem;color:var(--slate);background:var(--ivory);border-radius:6px;padding:8px 10px;}
  .ai-note-quote{font-style:italic;color:var(--navy);}
  .guess{font-weight:400;text-transform:none;letter-spacing:0;color:var(--gold);font-size:0.66rem;margin-left:6px;}
  .scan-card-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:2px;flex-wrap:wrap;}
  .scan-mini-actions{display:flex;gap:4px;justify-content:flex-end;margin:0;border-top:1px solid var(--border);padding-top:10px;}
  /* Cross-reference (the default resolution) */
  .match-block{display:flex;flex-direction:column;gap:10px;margin:0;}
  .match-head{display:flex;flex-direction:column;gap:2px;}
  .match-title{font-size:0.78rem;font-weight:600;color:var(--navy);}
  .match-hint{font-size:0.7rem;color:var(--slate);}
  .match-empty{font-size:0.72rem;line-height:1.45;}
  .match-list{display:flex;flex-direction:column;gap:6px;}
  .match-opt{display:flex;gap:9px;align-items:flex-start;padding:8px 10px;border:1px solid var(--border);border-radius:8px;cursor:pointer;transition:border-color .12s,background .12s;}
  .match-opt:hover{border-color:var(--gold);}
  .match-opt:has(input:checked){border-color:var(--navy);background:rgba(28,43,74,0.04);}
  .match-opt.is-exact{border-left:3px solid var(--success);}
  .match-opt input{margin-top:3px;}
  .match-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;}
  .match-line{display:flex;justify-content:space-between;gap:10px;align-items:baseline;}
  .match-desc{font-size:0.78rem;color:var(--navy);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .match-amt{font-size:0.78rem;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .match-meta{font-size:0.68rem;color:var(--slate);}
  .match-exact{color:var(--success);font-weight:600;margin-left:5px;}
  /* Post-as-entry (the rare escape hatch) */
  .post-block{border-top:1px solid var(--border);padding-top:10px;}
  .post-block summary{font-size:0.74rem;color:var(--slate);cursor:pointer;list-style:none;}
  .post-block summary::-webkit-details-marker{display:none;}
  .post-block summary::before{content:'\25B8 ';}
  .post-block[open] summary::before{content:'\25BE ';}
  .post-block summary:hover{color:var(--navy);}
  .post-block form{display:flex;flex-direction:column;gap:12px;margin-top:10px;}
  .post-warn{font-size:0.7rem;line-height:1.45;color:var(--slate);background:rgba(201,168,72,0.09);border-radius:6px;padding:8px 10px;margin:8px 0 0;}
  .force-lbl{display:flex;align-items:center;gap:5px;font-size:0.68rem;color:var(--slate);}
  @media print { .scan-hero, .topbar-actions { display:none !important; } }
</style>

<script>
(function(){
  var input = document.getElementById('fileInput');
  var zone = document.getElementById('dropzone');
  var main = document.getElementById('dzMain');
  var btn = document.getElementById('scanBtn');
  function refresh(){
    if (input.files && input.files.length){
      main.textContent = input.files[0].name;
      zone.classList.add('has-file');
      btn.disabled = false;
    } else { btn.disabled = true; zone.classList.remove('has-file'); }
  }
  input.addEventListener('change', refresh);
  ['dragover','dragenter'].forEach(function(e){ zone.addEventListener(e, function(ev){ ev.preventDefault(); zone.classList.add('drag'); }); });
  ['dragleave','drop'].forEach(function(e){ zone.addEventListener(e, function(ev){ ev.preventDefault(); zone.classList.remove('drag'); }); });
  zone.addEventListener('drop', function(ev){ if (ev.dataTransfer.files.length){ input.files = ev.dataTransfer.files; refresh(); } });
  document.getElementById('scanForm').addEventListener('submit', function(){ btn.disabled = true; btn.textContent = 'Reading document…'; });
})();
</script>

</div></div></body></html>
