<%
  // ─────────────────────────────────────────────────────────────────────────
  // Social connections — the single canonical UI for connecting/managing a
  // tenant's social API credentials. Included by Settings (the one home).
  // Posts to the shared /admin/social/* routes; those stay the source of truth.
  // Expects locals: platforms (PLATFORM_LIST), accountMap (maskAccount per key),
  // deletionRequests, publicBaseUrl, publicWebhookUrl.
  // ─────────────────────────────────────────────────────────────────────────
%>
<style>
  .sm-conn-card { border:1px solid var(--border); border-radius:6px; padding:16px; background:var(--surface); }
  .sm-conn-head { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
  .sm-conn-head .sm-ic { font-size:1.5rem; }
  .sm-ic { text-align:center; flex-shrink:0; }
  .sm-conn-name { font-size:1rem; font-weight:600; color:var(--on-surface); }
  .sm-status-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .sm-status-dot.ok { background:#15803D; } .sm-status-dot.off { background:#cbd5e1; }
  .sm-setup { font-size:0.72rem; color:var(--slate); line-height:1.55; background:var(--ivory); border-radius:4px; padding:10px 12px; margin:10px 0; }
  .sm-soon { font-size:0.6rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--badge-accent,var(--gold)); background:rgba(201,168,72,0.15); padding:2px 7px; border-radius:3px; }
  @media (max-width:640px) { .sm-conn-head { flex-wrap:wrap; gap:6px; } .sm-conn-name { font-size:0.92rem; } }
  /* Token health — what the connection actually IS, not just "green dot saved" */
  .sm-tok { border:1px solid var(--border); border-radius:5px; padding:8px 10px; margin-bottom:10px; background:var(--ivory); font-size:0.63rem; line-height:1.6; color:var(--slate); }
  .sm-tok b { color:var(--on-surface); font-weight:600; margin-right:5px; }
  .sm-tok-row { display:block; }
  .sm-tok .ok { color:var(--success,#15803D); font-weight:600; }
  .sm-tok .warn { color:#b45309; font-weight:600; }
  .sm-tok .bad { color:var(--danger,#dc2626); font-weight:600; }
  .sm-tok-acts { display:flex; gap:6px; flex-wrap:wrap; margin-top:7px; }
  .sm-tok-acts .btn { font-size:0.6rem; }
  .sm-tok-out { margin-top:6px; line-height:1.6; }
  .sm-tok-out code { font-size:0.58rem; word-break:break-all; }
  /* Copyable command / URL rows (token toolkit) */
  .sm-cp { display:flex; align-items:flex-start; gap:6px; margin:5px 0 2px; }
  .sm-cp code { flex:1; min-width:0; font-size:0.58rem; background:var(--ivory); padding:6px 8px; border-radius:3px; word-break:break-all; line-height:1.5; }
  .sm-cp .btn { font-size:0.58rem; flex-shrink:0; }
  .sm-tk-step { margin-top:10px; }
  .sm-tk-step > b { display:block; color:var(--navy,#1e293b); font-size:0.65rem; margin-bottom:2px; }
</style>

<div class="sm-setup" style="margin-bottom:18px;">
  <strong>How it works:</strong> enter each platform's API credentials below. Secrets are encrypted (AES-256-GCM) before storage and never shown again — only a masked hint. See the per-platform setup notes for where to obtain each key.
</div>

<!-- ═══ Analytics readiness — live probe of what each connection can actually report ═══ -->
<style>
  .sm-ah { border:1px solid var(--border); border-radius:6px; padding:14px 16px; margin-bottom:18px; background:var(--surface); }
  .sm-ah h4 { margin:0 0 4px; font-size:0.9rem; font-family:var(--font-heading); color:var(--on-surface); }
  .sm-ah .sub { font-size:0.68rem; color:var(--slate); margin-bottom:10px; }
  .sm-ah-row { display:flex; align-items:flex-start; gap:9px; padding:7px 0; border-top:1px solid var(--border); font-size:0.74rem; }
  .sm-ah-row .ic { font-size:1rem; flex-shrink:0; }
  .sm-ah-row .nm { font-weight:600; color:var(--on-surface); min-width:88px; flex-shrink:0; }
  .sm-ah-row .st { flex:1; min-width:0; color:var(--slate); line-height:1.5; }
  .sm-ah-badge { font-size:0.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding:2px 7px; border-radius:3px; white-space:nowrap; }
  .sm-ah-badge.ok { background:rgba(21,128,61,0.14); color:#15803D; }
  .sm-ah-badge.warn { background:rgba(180,83,9,0.14); color:#b45309; }
  .sm-ah-badge.err { background:rgba(220,38,38,0.13); color:var(--danger,#dc2626); }
  .sm-ah-fix { display:block; margin-top:2px; color:var(--danger,#dc2626); }
</style>
<div class="sm-ah" id="smAnalyticsHealth">
  <h4>📊 Analytics readiness</h4>
  <div class="sub">What each connected account can actually report on the Social → Analytics tab — probed live from the platform APIs.</div>
  <div id="smAhBody" style="font-size:0.74rem;color:var(--slate);">Checking connected accounts…</div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;">
<%
  // Facebook, Instagram & Threads all come from ONE Meta app — group them into
  // a single "Meta" card so app credentials aren't re-entered per surface.
  const metaKeys = ['facebook', 'instagram', 'threads'];
  const metaDefs = metaKeys.map(k => platforms.find(p => p.key === k)).filter(Boolean);
  const metaConnected = metaDefs.filter(p => (accountMap[p.key] || {}).configured).length;
  const fbCallbackUrl = (typeof publicWebhookUrl !== 'undefined' ? publicWebhookUrl.replace('/webhooks/meta', '/admin/social/facebook/callback') : '/admin/social/facebook/callback');
%>
<% if (metaDefs.length) { %>
  <div class="sm-conn-card" style="grid-column:1/-1;">
    <div class="sm-conn-head">
      <span class="sm-ic">◈</span>
      <span class="sm-conn-name">Meta</span>
      <span style="margin-left:auto;display:flex;align-items:center;gap:6px;">
        <span class="sm-status-dot <%= metaConnected ? 'ok' : 'off' %>"></span>
        <span style="font-size:0.68rem;color:var(--slate);"><%= metaConnected %>/<%= metaDefs.length %> connected</span>
      </span>
    </div>
    <div class="sm-setup">One Meta app powers <strong>Facebook</strong>, <strong>Instagram</strong> &amp; <strong>Threads</strong>. Enter your App ID/Secret + Facebook Page once — Instagram <em>links itself</em> from your Page (no IG User ID hunting), and Threads shares the same app.</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin-top:12px;">
    <% metaDefs.forEach(p => { const acc = accountMap[p.key] || {}; const configured = acc.configured; %>
      <div style="border:1px solid var(--border);border-radius:6px;padding:12px;background:var(--paper,#faf9f6);">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span class="sm-ic"><%= p.icon %></span>
          <strong style="font-size:0.82rem;"><%= p.name %></strong>
          <span style="margin-left:auto;display:flex;align-items:center;gap:6px;">
            <span class="sm-status-dot <%= configured ? 'ok' : 'off' %>"></span>
            <span style="font-size:0.64rem;color:var(--slate);"><%= configured ? 'Connected' : 'Not set' %></span>
          </span>
        </div>
        <% if (p.key !== 'facebook') { %>
          <div style="font-size:0.62rem;color:var(--slate);margin-bottom:8px;">Shares your Meta app — App ID/Secret are entered under <strong>Facebook Page</strong>.</div>
        <% } %>
        <%
          // Token health — "Connected" only means credentials exist. This says what
          // the token IS (type), when it dies, and whether it last actually worked.
          if (configured) {
            const _exp   = acc.tokenExpiresAt ? new Date(acc.tokenExpiresAt) : null;
            const _days  = _exp ? Math.round((_exp - Date.now()) / 86400000) : null;
            const _perm  = acc.tokenType === 'PAGE' && !_exp;
        %>
        <div class="sm-tok">
          <span class="sm-tok-row"><b>Token</b><%= acc.tokenType || 'type unknown' %> ·
            <% if (_perm) { %><span class="ok">never expires</span>
            <% } else if (_days !== null && _days < 0) { %><span class="bad">EXPIRED <%= _exp.toLocaleDateString() %> — reconnect</span>
            <% } else if (_days !== null) { %><span class="<%= _days < 7 ? 'bad' : 'warn' %>">expires in <%= _days %> day<%= _days === 1 ? '' : 's' %> (<%= _exp.toLocaleDateString() %>)</span>
            <% } else { %><span class="warn">expiry unknown — run Inspect</span><% } %>
            <% if (acc.tokenManaged) { %> · <span class="ok">auto-renewing</span><% } %>
          </span>
          <span class="sm-tok-row"><b>Last test</b>
            <% if (acc.lastTestAt) { %><span class="<%= acc.lastTestOk ? 'ok' : 'bad' %>"><%= acc.lastTestOk ? '✓ passed' : '✕ failed' %></span> · <%= new Date(acc.lastTestAt).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %>
            <% } else { %>never run — click <b>Test</b> below<% } %>
          </span>
          <div class="sm-tok-acts">
            <button type="button" class="btn btn-ghost btn-sm" onclick="smDebugToken('<%= p.key %>', this)" title="Ask Meta what this token really is — type, expiry and granted scopes">🔍 Inspect token</button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="smUpgradeToken('<%= p.key %>', this)" title="Exchange for a long-lived / permanent token now">♻ Make permanent</button>
          </div>
          <div class="sm-tok-out" id="smtok-<%= p.key %>"></div>
        </div>
        <% } %>
        <% if (p.key === 'instagram') { %>
          <div style="margin-bottom:10px;">
            <button type="button" class="btn btn-gold btn-sm" style="font-size:0.64rem;" onclick="smLinkInstagram(this)">↺ Link from Facebook</button>
            <span class="sm-iglink-msg" style="font-size:0.62rem;color:var(--slate);margin-left:6px;"><%= configured ? '' : 'Save Facebook first, then link.' %></span>
            <div style="font-size:0.6rem;color:var(--slate);margin-top:5px;">Auto-fills your IG User ID from the linked Page. The fields below are optional overrides.</div>
          </div>
          <%
            // Instagram fails as a CHAIN (Page link → id → token → publish → insights)
            // and Meta reports every link in it identically. The diagnose run names
            // the one gate that's actually broken; the manual path is the fallback.
            const _igAppId = ((accountMap.facebook || {}).credentials || {}).appId || '';
            const _igExplorer = _igAppId
              ? `https://developers.facebook.com/tools/explorer/${_igAppId}/?method=GET&path=me%2Faccounts%3Ffields%3Dinstagram_business_account%7Bid%2Cusername%7D&version=v21.0`
              : 'https://developers.facebook.com/tools/explorer/?method=GET&path=me%2Faccounts%3Ffields%3Dinstagram_business_account%7Bid%2Cusername%7D&version=v21.0';
            const _igIdUrl = 'https://graph.facebook.com/v21.0/me/accounts?fields=name,instagram_business_account{id,username}&access_token=YOUR_PAGE_OR_LONG_LIVED_USER_TOKEN';
            const _igCheckUrl = 'https://graph.facebook.com/v21.0/IG_USER_ID?fields=username,followers_count,media_count&access_token=YOUR_TOKEN';
          %>
          <div style="margin-bottom:10px;">
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.62rem;" onclick="smDiagnoseIg(this)" title="Walk the whole Instagram chain and name the gate that's actually failing">🩺 Diagnose Instagram</button>
            <div class="sm-tok-out" id="smigdx" style="font-size:0.62rem;"></div>
          </div>
          <details style="font-size:0.62rem;color:var(--slate);line-height:1.6;margin-bottom:10px;">
            <summary style="cursor:pointer;font-weight:600;color:var(--navy,#1e293b);">⚑ Instagram won't connect — read this first</summary>
            <div style="margin-top:6px;">
              Instagram has <strong>no login of its own here</strong> — it rides entirely on your Facebook Page token. Every IG failure is one of these five gates, in order. <strong>🩺 Diagnose</strong> tells you which:
              <ol style="margin:6px 0 0;padding-left:18px;">
                <li><strong>The IG account is Business or Creator</strong> — not Personal. Instagram app → Settings → Account type. <span style="color:#b45309;">A Personal account is invisible to the API; nothing else can be fixed until this is.</span></li>
                <li><strong>It's linked to THIS Facebook Page</strong> — Meta Business Suite → Settings → Linked accounts. The Page in the card above must be the one the IG account is attached to.</li>
                <li><strong>IG User ID is filled</strong> — use <strong>↺ Link from Facebook</strong>; never type it by hand. A stale ID posts to the wrong account and still reports "Connected".</li>
                <li><strong>Token carries <code>instagram_content_publish</code></strong> — this is a <em>publishing</em> scope; without it saves succeed and posts fail. Scopes can't be added to an existing token: attach it to the app, then <strong>reconnect Facebook</strong> to re-mint.</li>
                <li><strong>Token carries <code>instagram_manage_insights</code></strong> — analytics only. Instagram is the <em>only</em> reach source, so missing this makes reach read 0 everywhere while posting still works. <span style="color:#b45309;">Do not use <code>instagram_business_manage_insights</code> — that's the separate IG-login API and will silently never work here.</span></li>
              </ol>
              <div style="margin-top:8px;">Also worth knowing: Instagram <strong>requires media</strong> on every post (no text-only), and allows <strong>25 publishes per 24h</strong> — each story frame spends one. Diagnose shows your live quota.</div>
            </div>
          </details>
          <details style="font-size:0.62rem;color:var(--slate);line-height:1.6;margin-bottom:10px;">
            <summary style="cursor:pointer;font-weight:600;color:var(--navy,#1e293b);">🔑 Manual path — find your IG User ID by hand</summary>
            <div style="margin-top:6px;">
              <div style="color:#b45309;"><strong>↺ Link from Facebook</strong> above does this in one click. Use this only when the link button can't resolve your account and you need to see what Meta actually returns.</div>
              <div class="sm-tk-step">
                <b>1 · Ask your Page for its linked IG account</b>
                In the Graph API Explorer<%= _igAppId ? ' (opens on app ' + _igAppId + ')' : '' %> with a Page or long-lived user token. An empty <code>instagram_business_account</code> in the reply <em>is</em> the answer: gate 1 or 2 above is failing.
                <div class="sm-cp"><code><%= _igExplorer %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button>
                  <a href="<%= _igExplorer %>" target="_blank" rel="noopener" class="btn btn-gold btn-sm" style="font-size:0.58rem;">Open ↗</a></div>
                Or straight against Graph — swap in your token:
                <div class="sm-cp"><code><%= _igIdUrl %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button></div>
              </div>
              <div class="sm-tk-step">
                <b>2 · Confirm the ID resolves</b>
                Replace <code>IG_USER_ID</code> and <code>YOUR_TOKEN</code>. A username coming back means the pair is good — paste both into the fields below and <strong>Save</strong>.
                <div class="sm-cp"><code><%= _igCheckUrl %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button></div>
                <span style="color:#b45309;">The token here is your <strong>Page</strong> token — Instagram has no token of its own. Use the Facebook card's manual token path to mint a permanent one.</span>
              </div>
            </div>
          </details>
        <% } %>
        <form data-guard method="POST" action="/admin/social/connections/<%= p.key %>">
          <% p.fields.forEach(f => { const isSet = acc.secretsSet && acc.secretsSet[f.key]; const val = (!f.secret && acc.credentials) ? (acc.credentials[f.key]||'') : ''; %>
          <div class="form-field" style="margin-bottom:10px;">
            <label><%= f.label %></label>
            <input type="<%= f.secret ? 'password' : 'text' %>" name="<%= f.key %>"
                   value="<%= val %>"
                   placeholder="<%= f.secret && isSet ? '•••••••• (saved — leave blank to keep)' : (f.placeholder||'') %>"
                   autocomplete="off">
          </div>
          <% }) %>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
            <button type="submit" class="btn btn-navy btn-sm">Save</button>
            <% if (configured) { %>
            <button type="button" class="btn btn-ghost btn-sm" onclick="smTest('<%= p.key %>', this)">Test</button>
            <% } %>
          </div>
        </form>
        <% if (p.key === 'facebook') { %>
          <a href="/admin/social/facebook/connect" class="btn btn-gold btn-sm" style="margin-top:8px;display:inline-block;">Connect with Facebook →</a>
          <div style="font-size:0.62rem;color:var(--slate);margin-top:5px;line-height:1.5;">
            Save your <strong>App ID &amp; App Secret</strong> above first. One click grants a permanent Page token <em>with Live video</em> (<code>publish_video</code>) and auto-links Instagram — no manual token pasting.
            In your Meta app → Facebook Login → Settings, add this Valid OAuth Redirect URI:<br><code><%= fbCallbackUrl %></code>
            <% if (acc.liveEnabled) { %><br><span style="color:var(--success,#15803D);">✓ Live-streaming permission granted</span>
            <% } else if (configured) { %><br><span style="color:#b45309;">⚠ Live permission (publish_video) not yet granted — reconnect to enable Facebook Live.</span><% } %>
          </div>
          <%
            // Manual token path — for when the Connect button can't run (app not
            // yet provisioned, redirect URI blocked, debugging a scope gap).
            const _appId = (acc.credentials && acc.credentials.appId) || '';
            const _gv = 'v21.0';
            const _explorerUrl = _appId
              ? `https://developers.facebook.com/tools/explorer/${_appId}/?method=GET&path=me%2Faccounts&version=${_gv}`
              : `https://developers.facebook.com/tools/explorer/?method=GET&path=me%2Faccounts&version=${_gv}`;
            const _scopes = (typeof metaScopes !== 'undefined' && metaScopes)
              ? metaScopes
              : 'pages_show_list,pages_manage_posts,pages_read_engagement,pages_manage_metadata,pages_manage_engagement,publish_video,business_management,read_insights,instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_insights';
            const _exchangeUrl = `https://graph.facebook.com/${_gv}/oauth/access_token?grant_type=fb_exchange_token&client_id=${_appId || 'YOUR_APP_ID'}&client_secret=YOUR_APP_SECRET&fb_exchange_token=SHORT_LIVED_TOKEN`;
            const _pageTokenUrl = `https://graph.facebook.com/${_gv}/me/accounts?fields=id,name,access_token&access_token=LONG_LIVED_USER_TOKEN`;
            const _debugUrl = `https://developers.facebook.com/tools/debug/accesstoken/`;
          %>
          <details style="margin-top:8px;font-size:0.62rem;color:var(--slate);line-height:1.6;">
            <summary style="cursor:pointer;font-weight:600;color:var(--navy,#1e293b);">🔑 Manual token path — short-lived (Graph Explorer) → long-lived → permanent</summary>
            <div style="margin-top:6px;">
              <div style="color:#b45309;">The <strong>Connect with Facebook</strong> button above already does all three steps and stores a permanent Page token. Use this path only when Connect can't run — app not provisioned yet, redirect URI blocked, or you're debugging a scope gap.</div>

              <div class="sm-tk-step">
                <b>1 · Mint a SHORT-LIVED user token (Graph API Explorer)</b>
                Open the Explorer<%= _appId ? ' (opens on your app ' + _appId + ')' : ' and pick your app at the top right' %>, set <em>User or Page → User Token</em>, click <em>Add a Permission</em> for each scope below, then <strong>Generate Access Token</strong>. It lasts ~1–2 hours — that's expected, step 2 fixes it.
                <div class="sm-cp"><code><%= _explorerUrl %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button>
                  <a href="<%= _explorerUrl %>" target="_blank" rel="noopener" class="btn btn-gold btn-sm" style="font-size:0.58rem;">Open ↗</a></div>
                Scopes to request — the exact set the Connect button asks for:
                <div class="sm-cp"><code><%= _scopes %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button></div>
                <span style="color:#b45309;">If a scope refuses to attach here, it isn't provisioned on the app — fix that in the setup checklist below first. Nothing downstream will work until it does.</span>
              </div>

              <div class="sm-tk-step">
                <b>2 · Exchange it for a LONG-LIVED user token (~60 days)</b>
                Replace <code>YOUR_APP_SECRET</code><%= _appId ? '' : ' and YOUR_APP_ID' %> and <code>SHORT_LIVED_TOKEN</code>, then open the URL in a browser tab. The reply's <code>access_token</code> is your long-lived user token.
                <div class="sm-cp"><code><%= _exchangeUrl %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button></div>
              </div>

              <div class="sm-tk-step">
                <b>3 · Turn it into a PERMANENT Page token</b>
                A Page token minted from a <em>long-lived</em> user token never expires — this is the one to save. Paste the step-2 token in below and open it; copy the <code>access_token</code> of your Page from the response.
                <div class="sm-cp"><code><%= _pageTokenUrl %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button></div>
                <span style="color:#b45309;">Order matters: a Page token minted from a <em>short-lived</em> user token expires with it. If step 2 is skipped you'll be back here in an hour.</span>
              </div>

              <div class="sm-tk-step">
                <b>4 · Save &amp; verify</b>
                Paste that Page token into <strong>Page Access Token</strong> above (plus your <strong>Page ID</strong>), click <strong>Save</strong>, then <strong>🔍 Inspect token</strong> — it must read <code>type PAGE</code>, <em>never expires</em>, with no missing scopes. <strong>Test</strong> confirms Meta actually accepts it.
                <div class="sm-cp"><code><%= _debugUrl %></code>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="smCopy(this)">Copy</button>
                  <a href="<%= _debugUrl %>" target="_blank" rel="noopener" class="btn btn-ghost btn-sm" style="font-size:0.58rem;">Meta's debugger ↗</a></div>
              </div>
            </div>
          </details>
          <details style="margin-top:8px;font-size:0.62rem;color:var(--slate);line-height:1.6;">
            <summary style="cursor:pointer;font-weight:600;color:var(--navy,#1e293b);">⚑ Facebook setup checklist — read this before "Invalid Scopes" or "publish_actions" errors</summary>
            <div style="margin-top:6px;padding-left:2px;">
              Work top to bottom — each line is a gate. If Connect stops here, the gate that fails is your problem:
              <ol style="margin:6px 0 0;padding-left:18px;">
                <li><strong>Pages permissions are attached to the app</strong> — app → <strong>Use cases</strong> → add/<em>Customize</em> a Page use case, then confirm <code>pages_show_list</code>, <code>pages_read_engagement</code>, <code>pages_manage_posts</code>, <code>pages_manage_metadata</code> (+ <code>publish_video</code> for Live) each show at least <strong>Standard Access</strong>. <span style="color:#b45309;">This is the most common blocker.</span> New Meta apps are use-case-driven — if a permission isn't attached here, Facebook <em>cannot</em> grant it and you'll see <em>"Invalid Scopes"</em> or <em>"(#100) requires the 'pages_read_engagement' permission"</em>.
                  <br><strong>Fastest test:</strong> in <a href="https://developers.facebook.com/tools/explorer/" target="_blank" rel="noopener">Graph API Explorer</a>, pick your app and try to add <code>pages_read_engagement</code>. If it won't grant <em>there</em>, it's not provisioned — fix this gate before touching anything else.</li>
                <li><strong>You admin the Meta app</strong> — developers.facebook.com → your app → <em>App Roles / Roles</em> → your Facebook account is an <strong>Administrator</strong>, and you've <em>accepted</em> the invite from that account. Standard Access only works for roled users.</li>
                <li><strong>You admin the Facebook Page</strong> — same account has a <strong>Full control / Admin</strong> role on the Page (Page → Settings → Page access).</li>
                <li><strong>App is in "In development" mode</strong> — top bar of the App Dashboard (<em>"unpublished" means the same thing</em>). Dev mode + Standard Access is all you need; no App Review.</li>
                <li><strong>Facebook Login product added</strong>, and this exact <strong>Valid OAuth Redirect URI</strong> is saved under Facebook Login → Settings:<br><code><%= fbCallbackUrl %></code></li>
                <li><strong>App ID &amp; App Secret saved above</strong>, then click <strong>Connect with Facebook →</strong>.</li>
                <li>On Facebook's consent screen, <strong>toggle your Page ON</strong> (granular consent — skipping it gives "No Facebook Pages found").</li>
              </ol>
              <div style="margin-top:8px;">
                <strong>Always use the Connect button — never paste a token by hand.</strong> A manually-pasted token often has read-only scope: it saves green but posting fails with
                <em>"(#200) publish_actions … deprecated"</em>. That message is Facebook's misleading way of saying <strong>this token can't publish</strong> — reconnect via the button to mint one with <code>pages_manage_posts</code>.
              </div>
              <div style="margin-top:6px;">Only if the app must stay <strong>Live</strong> for non-roled users: submit <strong>App Review</strong> for Advanced Access on the Page scopes + complete <strong>Business Verification</strong>. Not needed when you own both the app and the Page.</div>
            </div>
          </details>
        <% } %>
        <% if (p.key === 'threads') { const thCb = (typeof publicWebhookUrl !== 'undefined' ? publicWebhookUrl.replace('/webhooks/meta', '/admin/social/threads/callback') : '/admin/social/threads/callback'); %>
          <a href="/admin/social/threads/connect" class="btn btn-gold btn-sm" style="margin-top:8px;display:inline-block;">Connect with Threads →</a>
          <a href="/admin/social/threads/connect?insights=1" class="btn btn-ghost btn-sm" style="margin-top:8px;margin-left:6px;display:inline-block;" title="Use only after threads_manage_insights shows 'Ready for testing'">Connect + insights →</a>
          <div style="font-size:0.62rem;color:var(--slate);margin-top:5px;line-height:1.5;">
            <strong>Important:</strong> Threads uses its own <strong>Threads App ID &amp; Secret</strong> (different from your Facebook App ID) — enter them in the <strong>Facebook Page</strong> card above (Meta app → <strong>Use cases → Access the Threads API → Settings</strong>), where you also add this redirect URI:<br><code><%= thCb %></code>
            <br>Use plain <strong>Connect</strong> first (publishing). Switch to <strong>Connect + insights</strong> only once <code>threads_manage_insights</code> shows <em>“Ready for testing”</em> in your app, or the authorization will be rejected.
          </div>
        <% } %>
        <% if (configured) { %>
        <form data-guard="button" method="POST" action="/admin/social/connections/<%= p.key %>/disconnect" style="margin-top:8px;" onsubmit="return confirm('Disconnect <%= p.name %>?')">
          <button class="btn btn-danger btn-sm" style="font-size:0.62rem;">Disconnect</button>
          <span class="sm-test-result" id="smtest-<%= p.key %>" style="font-size:0.7rem;margin-left:8px;"></span>
        </form>
        <% } %>
      </div>
    <% }) %>
    </div>
  </div>
<% } %>
