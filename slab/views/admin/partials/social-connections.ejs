<!-- ═══════════ COMPLIANCE ═══════════ -->
<h3 style="margin:26px 0 12px;font-family:var(--font-heading);color:var(--on-surface);font-size:1.05rem;border-top:1px solid var(--border);padding-top:20px;">🛡️ Compliance</h3>
<div class="card" style="margin-bottom:18px;">
  <div class="card-title">App Compliance URLs</div>
  <p style="font-size:0.8rem;color:var(--slate);margin-bottom:14px;">Paste these into your Meta / social app settings. The Data Deletion Callback is what platforms call when a user removes your app.</p>
  <% const _urls = [
       { label: 'Privacy Policy', url: publicBaseUrl + '/privacy' },
       { label: 'Terms of Service', url: publicBaseUrl + '/terms' },
       { label: 'Data Deletion Callback', url: publicBaseUrl + '/data-deletion' },
     ]; %>
  <% _urls.forEach(u => { %>
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
    <span style="font-size:0.72rem;color:var(--slate);min-width:160px;"><%= u.label %></span>
    <code style="flex:1;min-width:220px;font-size:0.74rem;background:var(--ivory);padding:6px 10px;border-radius:3px;"><%= u.url %></code>
    <button type="button" class="btn btn-ghost btn-sm" style="font-size:0.66rem;" onclick="navigator.clipboard.writeText('<%= u.url %>');this.textContent='Copied';setTimeout(()=>this.textContent='Copy',1200);">Copy</button>
    <a href="<%= u.url %>" target="_blank" rel="noopener" class="btn btn-ghost btn-sm" style="font-size:0.66rem;">Open</a>
  </div>
  <% }) %>
</div>

<div class="card-title" style="margin-bottom:10px;">Data Deletion Requests</div>
<% if (!deletionRequests || !deletionRequests.length) { %>
<div class="card empty"><div class="empty-icon">🗑</div><p>No deletion requests yet. Requests arrive here when a user removes your app or submits the public form.</p></div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Status</th><th>Source</th><th>Identifier</th><th>Code</th><th>Received</th><th></th></tr></thead>
    <tbody>
    <% deletionRequests.forEach(d => {
        const badge = d.status === 'completed' ? 'badge-active' : 'badge-prospect';
    %>
      <tr>
        <td><span class="badge <%= badge %>"><%= d.status %></span></td>
        <td style="font-size:0.8rem;"><%= d.source %><% if (d.platform) { %> · <%= d.platform %><% } %><% if (d.source === 'meta') { %><br><span style="font-size:0.62rem;color:<%= d.verified ? 'var(--success)' : 'var(--danger)' %>;"><%= d.verified ? '✓ verified' : 'unverified' %></span><% } %></td>
        <td style="font-size:0.78rem;word-break:break-all;"><%= d.email || d.externalUserId || '—' %></td>
        <td><code style="font-size:0.72rem;"><%= d.code %></code></td>
        <td style="font-size:0.76rem;white-space:nowrap;"><%= new Date(d.createdAt).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %></td>
        <td style="white-space:nowrap;">
          <% if (d.status !== 'completed') { %>
          <form data-guard="button" method="POST" action="/admin/social/deletion/<%= d._id %>/complete" style="display:inline;" onsubmit="return confirm('Mark this deletion request as completed? Make sure the user\'s data has actually been removed.')"><button class="btn btn-gold btn-sm" style="font-size:0.66rem;">Mark done</button></form>
          <% } else { %>
          <span style="font-size:0.7rem;color:var(--success);">✓ <%= d.completedAt ? new Date(d.completedAt).toLocaleDateString() : '' %></span>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<script>
// ── Analytics readiness — reuse the enriched /admin/analytics/social probe so
// the tenant sees WHY a platform reports (or doesn't) before opening Analytics.
(function(){
  const body = document.getElementById('smAhBody'); if (!body) return;
  const esc = (s)=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const NAMES = { facebook:'Facebook', instagram:'Instagram', threads:'Threads', linkedin:'LinkedIn', bluesky:'Bluesky', youtube:'YouTube' };
  const ICONS = { facebook:'📘', instagram:'📷', threads:'@', linkedin:'💼', bluesky:'🦋', youtube:'▶' };
  fetch('/admin/analytics/social?range=month').then(r=>r.json()).then(data=>{
    if (data.error) { body.innerHTML = '<span style="color:var(--danger)">Could not probe analytics: '+esc(data.error)+'</span>'; return; }
    const platforms = data.platforms || {};
    const keys = Object.keys(platforms);
    if (!keys.length) { body.innerHTML = 'No analytics-capable account connected yet. Facebook, Instagram, Threads, LinkedIn, Bluesky and YouTube can report here once connected.'; return; }
    let html = '';
    const t = data.totals || {};
    if (t.reachBlocked) html += '<div class="sm-ah-fix" style="margin:0 0 8px;font-weight:600;">⚠️ Reach is blocked — Instagram (the only reach source) denied insights. Fix below.</div>';
    keys.forEach(k => {
      const p = platforms[k] || {};
      const metricCount = Object.keys(p.metrics || {}).length;
      const hasSeries = Object.keys(p.series || {}).length > 0;
      let badge, cls, msg;
      if (p.error) {
        cls='err'; badge='Blocked'; msg = esc(p.error);
      } else if (metricCount || hasSeries) {
        cls='ok'; badge='Active'; msg = metricCount+' metric'+(metricCount===1?'':'s')+' reporting'+(hasSeries?' · trend available':'')+'.';
      } else {
        cls='warn'; badge='Limited'; msg = esc(p.note || 'Connected — no analytics data returned.');
      }
      html += '<div class="sm-ah-row"><span class="ic">'+esc(ICONS[k]||'')+'</span>'
        + '<span class="nm">'+esc(NAMES[k]||k)+'</span>'
        + '<span class="st">'+msg+'</span>'
        + '<span class="sm-ah-badge '+cls+'">'+badge+'</span></div>';
    });
    body.innerHTML = html;
  }).catch(()=>{ body.innerHTML = '<span style="color:var(--danger)">Analytics probe failed to load.</span>'; });
})();

// ── Connection actions (shared with the /admin/social backend routes) ────────
async function smTest(key, btn) {
  const out = document.getElementById('smtest-' + key);
  btn.disabled = true; btn.textContent = 'Testing…';
  try {
    const r = await fetch('/admin/social/connections/' + key + '/test', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const d = await r.json();
    if (out) { out.textContent = d.ok ? '✓ ' + (d.note || 'OK') : '✕ ' + (d.error || 'Failed'); out.style.color = d.ok ? 'var(--success)' : 'var(--danger)'; }
  } catch (e) { if (out) { out.textContent = '✕ Request failed'; out.style.color = 'var(--danger)'; } }
  btn.disabled = false; btn.textContent = 'Test';
}

// ── Copy the <code> sitting next to the button ───────────────────────────────
function smCopy(btn) {
  const el = btn.parentElement && btn.parentElement.querySelector('code');
  if (!el) return;
  navigator.clipboard.writeText(el.textContent.trim()).then(() => {
    const label = btn.textContent; btn.textContent = 'Copied';
    setTimeout(() => { btn.textContent = label; }, 1200);
  }).catch(() => { btn.textContent = 'Copy failed'; });
}

// ── Meta: what IS this token? (debug_token — type, expiry, real scopes) ───────
// Meta's publish errors are misleading; this reads the token's actual grant so a
// scope gap doesn't masquerade as "publish_actions is deprecated".
async function smDebugToken(key, btn) {
  const out = document.getElementById('smtok-' + key);
  const esc = (s)=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  btn.disabled = true; const label = btn.textContent; btn.textContent = 'Inspecting…';
  if (out) { out.style.color = 'var(--slate)'; out.textContent = 'Asking Meta about this token…'; }
  try {
    const r = await fetch('/admin/social/connections/meta/debug-token', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ platform: key }),
    });
    const d = await r.json();
    if (!d.ok) { if (out) { out.innerHTML = '✕ ' + esc(d.error || 'Inspect failed'); out.style.color = 'var(--danger)'; } }
    else {
      const life = d.neverExpires ? '<span class="ok">never expires</span>'
        : d.expiresAt ? '<span class="warn">expires ' + esc(new Date(d.expiresAt).toLocaleString()) + '</span>'
        : '<span class="warn">no expiry reported</span>';
      let html = (d.valid ? '<span class="ok">✓ valid</span>' : '<span class="bad">✕ invalid</span>')
        + ' · type <b>' + esc(d.type || '?') + '</b> · ' + life;
      if (d.appName) html += ' · app ' + esc(d.appName);
      if (!d.appMatches) html += '<br><span class="bad">⚠ This token belongs to a DIFFERENT app than the App ID saved above — that mismatch alone breaks publishing.</span>';
      if (d.type === 'USER') html += '<br><span class="warn">⚠ This is a USER token, not a PAGE token. It can read but not publish as your Page — finish step 3 of the manual token path, or just hit Connect.</span>';
      if (d.tokenError) html += '<br><span class="bad">Meta says: ' + esc(d.tokenError) + '</span>';
      if (d.dataAccessExpiresAt) html += '<br>Data access expires ' + esc(new Date(d.dataAccessExpiresAt).toLocaleDateString()) + ' (re-consent needed after that, even on a permanent token).';
      if ((d.missing || []).length) {
        html += '<br><span class="bad">Missing scopes:</span> <code>' + esc(d.missing.join(', ')) + '</code>'
          + '<br><span style="color:#b45309;">Attach these to the app (Use cases), then reconnect — the token has to be re-minted to carry them.</span>';
      } else { html += '<br><span class="ok">✓ All publishing + insights scopes present.</span>'; }
      html += '<br>Granted: <code>' + esc((d.scopes || []).join(', ') || '(none)') + '</code>';
      if (out) { out.innerHTML = html; out.style.color = 'var(--slate)'; }
    }
  } catch (e) { if (out) { out.textContent = '✕ Request failed'; out.style.color = 'var(--danger)'; } }
  btn.disabled = false; btn.textContent = label;
}

// ── Meta: force the short-lived → long-lived/permanent exchange now ───────────
async function smUpgradeToken(key, btn) {
  const out = document.getElementById('smtok-' + key);
  const esc = (s)=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  btn.disabled = true; const label = btn.textContent; btn.textContent = 'Upgrading…';
  try {
    const r = await fetch('/admin/social/connections/' + key + '/upgrade', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const d = await r.json();
    if (out) {
      out.innerHTML = d.ok
        ? '<span class="ok">✓ ' + esc(d.note || 'Token upgraded.') + '</span>'
        : '<span class="bad">✕ ' + esc(d.error || 'Upgrade failed') + '</span>';
      out.style.color = 'var(--slate)';
    }
    if (d.ok) setTimeout(() => location.reload(), 1400);
  } catch (e) { if (out) { out.textContent = '✕ Request failed'; out.style.color = 'var(--danger)'; } }
  btn.disabled = false; btn.textContent = label;
}

// ── Meta: link Instagram from the connected Facebook Page ─────────────────────
async function smLinkInstagram(btn) {
  const msg = btn.parentElement.querySelector('.sm-iglink-msg');
  const setMsg = (t, ok) => { if (msg) { msg.textContent = t; msg.style.color = ok ? 'var(--success)' : 'var(--danger)'; } };
  btn.disabled = true; const label = btn.textContent; btn.textContent = 'Linking…';
  try {
    const r = await fetch('/admin/social/connections/meta/link-instagram', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const d = await r.json();
    if (d.ok) {
      setMsg('✓ Linked' + (d.username ? ' @' + d.username : '') + (d.seededToken ? ' (token from Page)' : ''), true);
      setTimeout(() => location.reload(), 900);
    } else { setMsg('✕ ' + (d.error || 'Failed'), false); }
  } catch (e) { setMsg('✕ Request failed', false); }
  btn.disabled = false; btn.textContent = label;
}

// ── Instagram: walk the whole chain and show which gate fails ─────────────────
async function smDiagnoseIg(btn) {
  const out = document.getElementById('smigdx');
  const esc = (s)=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const ICON = { ok:'✓', warn:'⚠', fail:'✕' }, CLS = { ok:'ok', warn:'warn', fail:'bad' };
  btn.disabled = true; const label = btn.textContent; btn.textContent = 'Diagnosing…';
  if (out) { out.style.color = 'var(--slate)'; out.textContent = 'Walking the Instagram chain…'; }
  try {
    const r = await fetch('/admin/social/connections/instagram/diagnose', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const d = await r.json();
    if (!d.ok) { if (out) { out.innerHTML = '✕ ' + esc(d.error || 'Diagnose failed'); out.style.color = 'var(--danger)'; } }
    else {
      const head = d.overall === 'ok' ? '<span class="ok">✓ Instagram is fully wired — publishing and analytics.</span>'
        : d.overall === 'warn' ? '<span class="warn">⚠ Instagram can post, but something below is degraded.</span>'
        : '<span class="bad">✕ Instagram is not working. Fix the first ✕ below — later checks depend on it.</span>';
      let html = '<div style="margin-bottom:5px;">' + head + '</div>';
      (d.checks || []).forEach(c => {
        html += '<div style="margin-bottom:4px;"><span class="' + CLS[c.status] + '">' + ICON[c.status] + ' ' + esc(c.label) + '</span>'
          + ' — ' + esc(c.detail || '')
          + (c.fix ? '<br><span style="color:#b45309;display:block;padding-left:12px;">→ ' + esc(c.fix) + '</span>' : '')
          + '</div>';
      });
      if (out) { out.innerHTML = html; out.style.color = 'var(--slate)'; }
    }
  } catch (e) { if (out) { out.textContent = '✕ Request failed'; out.style.color = 'var(--danger)'; } }
  btn.disabled = false; btn.textContent = label;
}

// ── LinkedIn Author URN builder ──────────────────────────────────────────────
function liCard(btn) { return btn.closest('.sm-conn-card') || btn.closest('.social-item'); }
function liField(card, key) { return card.querySelector('[name="' + key + '"], [data-field="' + key + '"]'); }
function liBuildUrn(btn) {
  const card = liCard(btn), msg = card.querySelector('.li-urn-msg');
  const type = card.querySelector('.li-type').value;
  const id = card.querySelector('.li-id').value.trim().replace(/^urn:li:[a-z]+:/i, '');
  if (!id) { msg.textContent = 'Enter the numeric id first.'; msg.style.color = 'var(--danger)'; return; }
  const urn = 'urn:li:' + type + ':' + id;
  const f = liField(card, 'authorUrn'); if (f) f.value = urn;
  msg.innerHTML = 'Built <code>' + urn + '</code> — filled the Author URN field. Save to persist.';
  msg.style.color = 'var(--success)';
}
async function liFetchUrn(btn) {
  const card = liCard(btn), msg = card.querySelector('.li-urn-msg');
  const tf = liField(card, 'accessToken');
  const token = (tf && tf.value && !tf.value.startsWith('••••')) ? tf.value.trim() : '';
  btn.disabled = true; msg.textContent = 'Fetching from token…'; msg.style.color = 'var(--slate)';
  try {
    const r = await fetch('/admin/social/linkedin/urn', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accessToken: token }) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = '✕ ' + (j.error || 'Failed'); msg.style.color = 'var(--danger)'; }
    else {
      const f = liField(card, 'authorUrn'); if (f) f.value = j.urn;
      card.querySelector('.li-type').value = 'person';
      card.querySelector('.li-id').value = j.sub || '';
      msg.innerHTML = '✓ ' + (j.name ? 'Signed in as <b>' + j.name + '</b> — ' : '') + 'filled <code>' + j.urn + '</code>. Save to persist.';
      msg.style.color = 'var(--success)';
    }
  } catch (e) { msg.textContent = '✕ Request failed'; msg.style.color = 'var(--danger)'; }
  btn.disabled = false;
}
async function liIntrospect(btn) {
  const card = liCard(btn), msg = card.querySelector('.li-urn-msg');
  const tok = liField(card, 'accessToken'), cid = liField(card, 'clientId'), csec = liField(card, 'clientSecret');
  const payload = {
    accessToken: (tok && tok.value && !tok.value.startsWith('••••')) ? tok.value.trim() : '',
    clientId: cid ? cid.value.trim() : '',
    clientSecret: (csec && csec.value && !csec.value.startsWith('••••')) ? csec.value.trim() : '',
  };
  btn.disabled = true; msg.textContent = 'Reading token scopes…'; msg.style.color = 'var(--slate)';
  try {
    const r = await fetch('/admin/social/linkedin/introspect', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = '✕ ' + (j.error || 'Failed'); msg.style.color = 'var(--danger)'; }
    else {
      const list = (j.scope || '').split(/[ ,]+/).filter(Boolean);
      const hasProfile = list.includes('openid') && list.includes('profile');
      msg.innerHTML = (j.active ? '✓' : '✕') + ' status <b>' + j.status + '</b> · scopes: <code>' + (j.scope || '(none)') + '</code><br>'
        + (hasProfile ? '<b>openid + profile present</b> — Fetch from token will work.' : '<b>Missing openid/profile</b> — this token can\'t read your id. Regenerate with those scopes ticked.');
      msg.style.color = j.active ? 'var(--success)' : 'var(--danger)';
    }
  } catch (e) { msg.textContent = '✕ Request failed'; msg.style.color = 'var(--danger)'; }
  btn.disabled = false;
}
</script>
