<%# Which links the client actually clicked, most recent last. %>
<% if (mt && mt.clickList.length) { %>
  <div class="trk-links">
    <strong style="color:var(--on-surface);">Clicked links</strong>
    <% for (const ck of mt.clickList.slice().reverse()) { %>
      <div>&rarr; <a href="<%= ck.url %>" target="_blank" rel="noopener"><%= ck.url %></a> &middot; <%= trkStamp(ck.at) %></div>
    <% } %>
  </div>
<% } %>
