<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/sidebar', { page: 'settings', user: user }) %>

<style>
  .settings-grid { max-width: 720px; }
  .settings-section { background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 24px; margin-bottom: 20px; }
  .settings-section h2 { font-size: 0.88rem; font-weight: 600; letter-spacing: 0.06em; color: var(--navy); margin-bottom: 4px; display: flex; align-items: center; gap: 10px; }
  .settings-section .desc { font-size: 0.75rem; color: var(--slate); margin-bottom: 16px; line-height: 1.5; }
  .field-row { margin-bottom: 14px; }
  .field-row label { display: block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate); margin-bottom: 4px; }
  .field-row input, .field-row select {
    width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 3px;
    font-family: 'Jost', sans-serif; font-size: 0.82rem; color: var(--on-surface); background: var(--ivory);
    outline: none; transition: border 0.15s;
  }
  .field-row input:focus { border-color: var(--gold); }
  .field-row input[type=password] { font-family: monospace; letter-spacing: 0.1em; }
  .field-hint { font-size: 0.68rem; color: var(--slate); margin-top: 3px; }
  .field-set { color: #16a34a; font-size: 0.68rem; font-weight: 500; }
  .field-row .inline { display: flex; gap: 8px; align-items: center; }
  .inline input { flex: 1; }
  .btn-test { padding: 8px 16px; background: var(--navy); color: var(--surface); border: none; border-radius: 3px; font-family: 'Jost', sans-serif; font-size: 0.72rem; font-weight: 500; cursor: pointer; white-space: nowrap; }
  .btn-test:hover { background: var(--navy-deep); }
  .test-result { font-size: 0.72rem; margin-top: 4px; min-height: 18px; }
  .test-ok { color: #16a34a; } .test-fail { color: #dc2626; }
  .status-bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; font-size: 0.78rem; flex-wrap: wrap; }
  .status-preview { background: rgba(251,191,36,0.08); border: 1px solid rgba(251,191,36,0.2); color: #92400e; }
  .status-active { background: rgba(22,163,74,0.08); border: 1px solid rgba(22,163,74,0.2); color: #166534; }
  .saved-toast { background: #14532d; color: #86efac; padding: 10px 16px; border-radius: 4px; margin-bottom: 16px; font-size: 0.78rem; }
  .error-toast { background: #7f1d1d; color: #fca5a5; padding: 10px 16px; border-radius: 4px; margin-bottom: 16px; font-size: 0.78rem; }

  /* Guide toggle */
  .guide-toggle {
    display: inline-flex; align-items: center; gap: 5px; cursor: pointer;
    font-size: 0.68rem; font-weight: 500; color: var(--gold); background: none;
    border: 1px solid rgba(201,168,72,0.3); padding: 4px 10px; border-radius: 3px;
    font-family: 'Jost', sans-serif; transition: all 0.15s; margin-left: auto;
  }
  .guide-toggle:hover { background: rgba(201,168,72,0.08); border-color: var(--gold); }
  .guide-panel {
    display: none; margin-top: 12px; padding: 16px; border-radius: 4px;
    background: linear-gradient(135deg, rgba(201,168,72,0.04), rgba(28,43,74,0.03));
    border: 1px solid rgba(201,168,72,0.15);
  }
  .guide-panel.open { display: block; }
  .guide-panel ol { margin: 0; padding-left: 20px; font-size: 0.75rem; color: var(--on-surface); line-height: 1.9; }
  .guide-panel li { margin-bottom: 4px; }
  .guide-panel code { background: var(--ivory); padding: 1px 6px; border-radius: 2px; font-size: 0.72rem; }
  .guide-panel a { color: var(--gold); font-weight: 500; }
  .guide-panel .guide-tip { font-size: 0.68rem; color: var(--slate); font-style: italic; margin-top: 8px; }

  /* Setup CTA */
  .setup-cta {
    background: linear-gradient(135deg, #0F1B30 0%, #1C2B4A 50%, #2E4270 100%);
    border: 1px solid rgba(201,168,72,0.2); border-radius: 4px;
    padding: 28px; margin-bottom: 24px; position: relative; overflow: hidden;
  }
  .setup-cta::before {
    content: ''; position: absolute; top: -40px; right: -40px;
    width: 160px; height: 160px; border-radius: 50%;
    background: radial-gradient(circle, rgba(201,168,72,0.12) 0%, transparent 70%);
  }

  /* Social media connections */
  .social-list { display: flex; flex-direction: column; gap: 8px; }
  .social-item { border: 1px solid var(--border); border-radius: 4px; overflow: hidden; }
  .social-head { display: flex; align-items: center; gap: 10px; padding: 10px 12px; flex-wrap: wrap; }
  .social-ic { font-size: 1.3rem; width: 26px; text-align: center; flex-shrink: 0; }
  .social-name { font-size: 0.85rem; font-weight: 600; color: var(--on-surface); }
  .social-name .soon { font-size: 0.6rem; color: var(--slate); font-weight: 500; }
  .social-checks { display: flex; gap: 12px; margin-left: auto; }
  .chk { display: inline-flex; align-items: center; gap: 4px; font-size: 0.66rem; color: #c9ced6; font-weight: 600; transition: color 0.2s; }
  .chk.on { color: #16a34a; }
  .btn-input { padding: 6px 13px; background: var(--navy); color: #fff; border: none; border-radius: 3px; font-family: 'Jost', sans-serif; font-size: 0.7rem; font-weight: 500; cursor: pointer; white-space: nowrap; }
  .btn-input:hover { background: var(--navy-deep); }
  .soon-label { font-size: 0.66rem; color: var(--slate); }
  .social-form { padding: 14px 12px; border-top: 1px solid var(--border); background: var(--ivory); }
  .social-setup { font-size: 0.7rem; color: var(--slate); line-height: 1.55; margin-bottom: 12px; }
  .social-setup a { color: var(--gold); font-weight: 500; }
  .social-actions { display: flex; gap: 8px; align-items: center; margin-top: 8px; flex-wrap: wrap; }

  /* Accordion groups — collapsible categories that hold the settings cards */
  .acc-group { border: 1px solid var(--border); border-radius: 6px; margin-bottom: 14px; overflow: hidden; background: var(--surface); }
  .acc-head {
    width: 100%; display: flex; align-items: center; gap: 10px; cursor: pointer;
    padding: 15px 20px; background: var(--surface); border: none; text-align: left;
    font-family: 'Jost', sans-serif; font-size: 0.92rem; font-weight: 600; color: var(--navy);
    letter-spacing: 0.04em; transition: background 0.15s;
  }
  .acc-head:hover { background: var(--ivory); }
  .acc-head .acc-ic { color: var(--gold); }
  .acc-head .acc-sub { font-size: 0.68rem; font-weight: 400; color: var(--slate); letter-spacing: 0; text-transform: none; }
  .acc-head .acc-chevron { margin-left: auto; transition: transform 0.2s; color: var(--slate); font-size: 0.7rem; }
  .acc-group.open .acc-head .acc-chevron { transform: rotate(90deg); }
  .acc-body { display: none; padding: 0 16px 8px; border-top: 1px solid var(--border); }
  .acc-group.open .acc-body { display: block; }
  /* sLab Network opt-in toggles */
  .net-toggle { display: flex; align-items: flex-start; gap: 11px; padding: 11px 0; cursor: pointer; font-size: 0.82rem; color: var(--on-surface); }
  .net-toggle input[type=checkbox] { margin-top: 2px; width: 16px; height: 16px; accent-color: var(--gold); cursor: pointer; flex: 0 0 auto; }
  .net-toggle .net-sub { font-size: 0.72rem; color: var(--slate); font-weight: 400; }
  /* Sections inside an accordion drop their outer chrome — the group supplies it */
  .acc-body .settings-section { border: none; border-radius: 0; padding: 18px 4px; margin-bottom: 0; }
  .acc-body .settings-section + .settings-section { border-top: 1px solid var(--border); }
</style>

<div class="settings-grid">
  <h1 style="font-size:1.2rem;font-weight:600;margin-bottom:16px;">Settings</h1>

  <% if (saved) { %><div class="saved-toast"><%= (typeof saved === 'string' && saved !== '1' && saved !== 'save') ? saved : 'Settings saved.' %></div><% } %>
  <% if (error) { %><div class="error-toast"><%= (typeof error === 'string' && error !== 'save') ? error : 'Failed to save settings.' %></div><% } %>

  <div class="status-bar status-<%= settings.status || 'preview' %>">
    <strong><%= settings.status === 'active' ? 'Live' : 'Preview Mode' %></strong>
    <span>|</span>
    <span>Plan: <%= settings.plan %></span>
    <span>|</span>
    <span>Domain: <%= settings.domain %></span>
    <% if (settings.status !== 'active') { %>
      <a href="/admin?golive=1" style="margin-left:auto;font-weight:600;color:#92400e;">Go Live &rarr;</a>
    <% } %>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- TUTORIALS SETTINGS                                                      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <div class="settings-section">
    <h2>Tutorials
      <span style="font-size:0.65rem;font-weight:400;color:var(--slate);margin-left:auto;" id="tutProgress"></span>
    </h2>
    <div class="desc">Control guided tours and onboarding walkthroughs across the admin panel.</div>

    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:14px;">
      <label style="display:flex;align-items:center;gap:8px;font-size:0.82rem;cursor:pointer;">
        <input type="checkbox" id="tutAutoPlay" style="accent-color:var(--navy);"> Auto-play on first visit
      </label>
      <label style="display:flex;align-items:center;gap:8px;font-size:0.82rem;cursor:pointer;">
        <input type="checkbox" id="tutCollapsed" style="accent-color:var(--navy);"> Collapse tutorials <span style="font-size:0.68rem;color:var(--slate);">(hide help button)</span>
      </label>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button type="button" class="btn-test" onclick="resetAllTutorials()">Reset All Tutorials</button>
      <button type="button" class="btn-test" style="background:var(--slate);" onclick="window.location='/admin/profile'">View Tutorial Progress</button>
    </div>
    <div id="tutResult" class="test-result"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- WHAT'S NEW / CHANGELOG  — DISABLED for this release (2026-06-27)         -->
  <!-- Re-enable by removing the `if (false)` guard below.                      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <% if (false) { %>
  <div class="settings-section">
    <h2>What's New
      <span style="font-size:0.62rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;background:var(--navy);color:var(--gold);padding:2px 8px;border-radius:2px;margin-left:8px;">v<%= typeof platformVersion !== 'undefined' ? platformVersion : '1.0.0' %></span>
      <span style="font-size:0.62rem;font-weight:500;padding:2px 8px;border-radius:2px;margin-left:4px;<%= typeof platformEnv !== 'undefined' && platformEnv === 'production' ? 'background:rgba(22,163,74,0.1);color:#16a34a;' : 'background:rgba(234,88,12,0.1);color:#ea580c;' %>"><%= typeof platformEnv !== 'undefined' ? platformEnv : 'development' %></span>
    </h2>
    <div class="desc">Platform version history and environment status. Helps coordinate prod/dev deployments.</div>

    <div style="display:flex;gap:16px;margin-bottom:16px;font-size:0.78rem;">
      <div style="flex:1;padding:12px;background:var(--ivory);border-radius:4px;">
        <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--slate);margin-bottom:4px;">Environment</div>
        <strong><%= typeof platformEnv !== 'undefined' ? platformEnv : 'development' %></strong>
      </div>
      <div style="flex:1;padding:12px;background:var(--ivory);border-radius:4px;">
        <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--slate);margin-bottom:4px;">Version</div>
        <strong><%= typeof platformVersion !== 'undefined' ? platformVersion : '1.0.0' %></strong>
      </div>
      <div style="flex:1;padding:12px;background:var(--ivory);border-radius:4px;">
        <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--slate);margin-bottom:4px;">Node</div>
        <strong><%= typeof nodeVersion !== 'undefined' ? nodeVersion : process.version %></strong>
      </div>
    </div>

    <div id="changelogList" style="border:1px solid var(--border);border-radius:4px;overflow:hidden;max-height:500px;overflow-y:auto;">
      <% const commits = typeof whatsNew !== 'undefined' ? whatsNew : []; %>
      <% const notes = typeof pinnedNotes !== 'undefined' ? pinnedNotes : {}; %>
      <% if (commits.length === 0) { %>
        <div style="padding:16px;text-align:center;font-size:0.82rem;color:var(--slate);">No git history available.</div>
      <% } %>
      <% for (const c of commits) { %>
        <div style="padding:10px 16px;border-bottom:1px solid var(--border);<%= c.version ? 'background:rgba(201,168,72,0.04);' : '' %>" data-hash="<%= c.hash %>">
          <div style="display:flex;align-items:center;gap:8px;">
            <code style="font-size:0.68rem;color:var(--gold);background:var(--ivory);padding:1px 6px;border-radius:2px;"><%= c.short %></code>
            <% if (c.version) { %>
              <span style="font-size:0.62rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;background:var(--navy);color:var(--gold);padding:1px 6px;border-radius:2px;"><%= c.version %></span>
            <% } %>
            <span style="font-size:0.82rem;font-weight:500;color:var(--on-surface);flex:1;"><%= c.message %></span>
            <span style="font-size:0.65rem;color:var(--slate);white-space:nowrap;"><%= c.date %></span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;margin-top:2px;">
            <span style="font-size:0.65rem;color:var(--slate);"><%= c.author %></span>
            <span style="font-size:0.65rem;color:var(--slate);"><%= c.time %></span>
          </div>
          <% if (notes[c.hash]) { %>
            <div style="margin-top:6px;padding:8px 10px;background:rgba(201,168,72,0.06);border-radius:3px;font-size:0.75rem;line-height:1.5;color:var(--on-surface);"><%- notes[c.hash] %></div>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
    <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border);">
      <div style="font-weight:600;font-size:0.78rem;margin-bottom:8px;">Pin a Note to a Commit (Superadmin)</div>
      <div style="display:flex;gap:8px;margin-bottom:8px;">
        <input type="text" id="clHash" placeholder="commit hash (click a row above)" style="flex:1;padding:8px;border:1px solid var(--border);border-radius:3px;font-size:0.78rem;font-family:monospace;">
      </div>
      <textarea id="clNotes" rows="2" placeholder="Pinned note for this commit (supports HTML)" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:3px;font-size:0.78rem;font-family:'Jost',sans-serif;resize:vertical;"></textarea>
      <button type="button" class="btn-test" style="margin-top:8px;" onclick="addChangelog()">Pin Note</button>
      <div id="clResult" class="test-result"></div>
    </div>
    <% } %>
  </div>
  <% } %>
  <!-- END WHAT'S NEW / CHANGELOG (disabled) -->

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- WELCOME / ACCOUNT WIRE-UP REQUEST  (replaced Done-For-You offer)         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <div class="setup-cta">
    <div style="position:relative;z-index:1;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
        <span style="font-size:1.4rem;">&#9889;</span>
        <span style="font-size:0.65rem;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:rgba(201,168,72,0.8);">Welcome to sLab!!!</span>
      </div>
      <div style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:300;color:#FDFCFA;line-height:1.3;margin-bottom:10px;">
        Need to wire up your accounts? Let me know &mdash; we'll get working right away!
      </div>
      <p style="font-size:0.82rem;font-weight:300;color:rgba(253,252,250,0.55);line-height:1.7;margin-bottom:18px;max-width:560px;">
        Tell us which integrations you'd like help connecting (payments, email, Google, domain &amp; SSL, anything else)
        and drop a note below. We'll reach out and get you wired up.
      </p>

      <div id="setupReqForm">
        <div style="display:flex;flex-wrap:wrap;gap:8px 16px;margin-bottom:14px;">
          <% const setupAccounts = ['Stripe', 'PayPal', 'Zoho Email + DNS', 'Google Reviews', 'Google OAuth', 'Custom Domain + SSL', 'Other']; %>
          <% for (const acct of setupAccounts) { %>
            <label style="font-size:0.72rem;color:rgba(253,252,250,0.7);display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="checkbox" name="setupAccount" value="<%= acct %>" style="accent-color:#c9a848;"> <%= acct %>
            </label>
          <% } %>
        </div>
        <textarea id="setupReqMessage" rows="3" placeholder="Anything we should know? (optional)"
          style="width:100%;max-width:560px;padding:10px 12px;background:rgba(255,255,255,0.06);border:1px solid rgba(201,168,72,0.25);border-radius:3px;color:#FDFCFA;font-family:'Jost',sans-serif;font-size:0.8rem;resize:vertical;margin-bottom:12px;"></textarea>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <button type="button" onclick="submitSetupRequest()"
            style="display:inline-block;padding:12px 28px;background:rgba(201,168,72,0.9);color:#0F1B30;font-family:'Jost',sans-serif;font-size:0.78rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border:none;border-radius:3px;cursor:pointer;transition:background 0.2s;">
            Request Wire-Up
          </button>
          <span style="font-size:0.7rem;color:rgba(253,252,250,0.35);">We'll email you back &bull; usually same day</span>
        </div>
      </div>
      <div id="setupReqDone" style="display:none;padding:16px 0;font-size:0.92rem;color:rgba(201,168,72,0.95);">
        &#10003; Got it &mdash; thanks! We'll reach out shortly to get your accounts wired up. Welcome aboard!
      </div>
    </div>
  </div>
  <script>
  async function submitSetupRequest() {
    const accounts = Array.from(document.querySelectorAll('input[name="setupAccount"]:checked')).map(c => c.value);
    const message  = document.getElementById('setupReqMessage').value.trim();
    try {
      const r = await fetch('/admin/setup-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accounts, message }),
      });
      const j = await r.json();
      if (j.ok) {
        document.getElementById('setupReqForm').style.display = 'none';
        document.getElementById('setupReqDone').style.display = 'block';
      } else {
        SlabFlash.error(j.error || 'Something went wrong — please try again.');
      }
    } catch (e) {
      SlabFlash.error('Network error — please try again.');
    }
  }
  </script>

  <form method="POST" action="/admin/settings" data-guard data-guard-label="Saving">

    <!-- ░░░ ACCORDION GROUP: BUSINESS ░░░ -->
    <div class="acc-group open">
      <button type="button" class="acc-head" onclick="toggleAcc(this)"><span class="acc-ic">&#9672;</span> Business <span class="acc-sub">profile &amp; domain</span><span class="acc-chevron">&#9656;</span></button>
      <div class="acc-body">

    <!-- ═══════════ CUSTOM API KEYS ═══════════ -->
    <div class="settings-section">
      <h2>&#128273; Custom API Keys</h2>
      <p class="desc">Store your own API keys &amp; secrets (encrypted, decrypt-on-use) for connectors and integrations — beyond the built-in providers below.</p>
      <a href="/admin/settings/keys" class="btn btn-navy btn-sm">Manage API keys &rarr;</a>
    </div>

    <!-- ═══════════ SLAB FUNCTIONS ═══════════ -->
    <div class="settings-section">
      <h2>&#9707; Slab Functions</h2>
      <p class="desc">sLab's toolkit runs deep. Switch individual tools on or off to keep your sidebar focused on what you actually use — this only changes what shows in the menu, not your data or anyone's permissions.</p>
      <input type="hidden" name="functionsForm" value="1">
      <div class="fn-grid">
        <% (typeof toggleableFunctions !== 'undefined' ? toggleableFunctions : []).forEach(function(f){
             var on = !((typeof disabledFunctions !== 'undefined' ? disabledFunctions : []).includes(f.key)); %>
          <label class="fn-toggle">
            <input type="checkbox" name="fn_<%= f.key %>" value="on" <%= on ? 'checked' : '' %>>
            <span class="fn-sw"></span>
            <span class="fn-txt"><%= f.label %><span class="fn-sec"><%= f.section %></span></span>
          </label>
        <% }) %>
      </div>
      <button type="submit" style="margin-top:14px;padding:10px 24px;background:var(--gold);color:var(--on-surface);border:none;border-radius:3px;font-family:'Jost',sans-serif;font-size:0.8rem;font-weight:600;cursor:pointer;letter-spacing:0.04em;">Save Functions</button>
    </div>
    <style>
      .fn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px 16px;margin-top:4px;}
      .fn-toggle{display:flex;align-items:center;gap:10px;cursor:pointer;padding:5px 0;}
      .fn-toggle input{position:absolute;opacity:0;width:0;height:0;}
      .fn-sw{position:relative;flex:0 0 auto;width:34px;height:19px;border-radius:19px;background:var(--border);transition:background .15s;}
      .fn-sw::after{content:"";position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;background:#fff;transition:transform .15s;box-shadow:0 1px 2px rgba(0,0,0,0.2);}
      .fn-toggle input:checked + .fn-sw{background:var(--gold);}
      .fn-toggle input:checked + .fn-sw::after{transform:translateX(15px);}
      .fn-txt{font-size:0.82rem;color:var(--on-surface);display:flex;flex-direction:column;line-height:1.2;}
      .fn-sec{font-size:0.6rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--slate);}
    </style>

    <!-- ═══════════ BUSINESS PROFILE ═══════════ -->
    <div class="settings-section">
      <h2>&#9672; Business Profile</h2>
      <p class="desc">This information powers all AI agent prompts across your site. The more you fill in, the better your agents will understand your business.</p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0 16px;">
        <div class="field-row">
          <label>Business Name</label>
          <input type="text" name="brand_name" value="<%= brandProfile.name %>" placeholder="Acme Marketing">
        </div>
        <div class="field-row">
          <label>Business Type</label>
          <input type="text" name="brand_businessType" value="<%= brandProfile.businessType %>" placeholder="Digital Marketing Agency">
          <div class="field-hint">e.g. Restaurant, Law Firm, SaaS, Retail, Consulting</div>
        </div>
        <div class="field-row">
          <label>Industry</label>
          <input type="text" name="brand_industry" value="<%= brandProfile.industry %>" placeholder="Marketing & Advertising">
        </div>
        <div class="field-row">
          <label>Owner / Contact Name</label>
          <input type="text" name="brand_ownerName" value="<%= brandProfile.ownerName %>" placeholder="Jane Smith">
        </div>
        <div class="field-row">
          <label>Location</label>
          <input type="text" name="brand_location" value="<%= brandProfile.location %>" placeholder="Denver, CO">
        </div>
        <div class="field-row">
          <label>Service Area</label>
          <input type="text" name="brand_serviceArea" value="<%= brandProfile.serviceArea %>" placeholder="Denver metro & surrounding areas">
        </div>
        <div class="field-row">
          <label>Phone</label>
          <input type="text" name="brand_phone" value="<%= brandProfile.phone %>" placeholder="(555) 123-4567">
        </div>
        <div class="field-row">
          <label>Contact Email</label>
          <input type="text" name="brand_email" value="<%= brandProfile.email %>" placeholder="hello@yourbusiness.com">
        </div>
      </div>

      <div class="field-row">
        <label>Tagline</label>
        <input type="text" name="brand_tagline" value="<%= brandProfile.tagline %>" placeholder="Growing brands that matter.">
      </div>
      <div class="field-row">
        <label>Business Description</label>
        <textarea name="brand_description" rows="3" style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:3px;font-family:'Jost',sans-serif;font-size:0.82rem;color:var(--on-surface);background:var(--ivory);outline:none;resize:vertical;" placeholder="Brief description of what your business does, who you serve, and what makes you unique."><%= brandProfile.description %></textarea>
      </div>
      <div class="field-row">
        <label>Services Offered</label>
        <input type="text" name="brand_services" value="<%= brandProfile.services %>" placeholder="Web Design, SEO, Social Media Management, Email Marketing">
        <div class="field-hint">Comma-separated list of your services</div>
      </div>
      <div class="field-row">
        <label>Pricing Guide</label>
        <input type="text" name="brand_pricingNotes" value="<%= brandProfile.pricingNotes %>" placeholder="Web design $1500-5000, SEO $500-1500/mo, Social media $400-1200/mo">
        <div class="field-hint">Approximate pricing ranges for agent-generated invoices and proposals</div>
      </div>
      <div class="field-row">
        <label>Target Audience</label>
        <input type="text" name="brand_targetAudience" value="<%= brandProfile.targetAudience %>" placeholder="Small to mid-size local businesses">
      </div>
      <div class="field-row">
        <label>Brand Voice / Tone</label>
        <input type="text" name="brand_brandVoice" value="<%= brandProfile.brandVoice %>" placeholder="Professional but warm, local, trustworthy">
        <div class="field-hint">How should your AI agents sound? e.g. Casual & friendly, Corporate & formal, Bold & edgy</div>
      </div>

      <div style="margin-top:16px;">
        <label style="display:block;font-size:0.7rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Social Media Links</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0 16px;">
          <div class="field-row"><label>Facebook</label><input type="text" name="brand_social_facebook" value="<%= brandProfile.social_facebook %>" placeholder="https://facebook.com/yourbusiness"></div>
          <div class="field-row"><label>Instagram</label><input type="text" name="brand_social_instagram" value="<%= brandProfile.social_instagram %>" placeholder="https://instagram.com/yourbusiness"></div>
          <div class="field-row"><label>Twitter / X</label><input type="text" name="brand_social_twitter" value="<%= brandProfile.social_twitter %>" placeholder="https://twitter.com/yourbusiness"></div>
          <div class="field-row"><label>LinkedIn</label><input type="text" name="brand_social_linkedin" value="<%= brandProfile.social_linkedin %>" placeholder="https://linkedin.com/company/yourbusiness"></div>
          <div class="field-row"><label>YouTube</label><input type="text" name="brand_social_youtube" value="<%= brandProfile.social_youtube %>" placeholder="https://youtube.com/@yourbusiness"></div>
          <div class="field-row"><label>TikTok</label><input type="text" name="brand_social_tiktok" value="<%= brandProfile.social_tiktok %>" placeholder="https://tiktok.com/@yourbusiness"></div>
        </div>
      </div>

      <button type="submit" style="margin-top:12px;padding:10px 24px;background:var(--gold);color:var(--on-surface);border:none;border-radius:3px;font-family:'Jost',sans-serif;font-size:0.8rem;font-weight:600;cursor:pointer;letter-spacing:0.04em;">Save Profile</button>
    </div>

    <!-- ═══════════ CUSTOM DOMAIN ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9672; Custom Domain
        <button type="button" class="guide-toggle" onclick="toggleGuide('domain')">&#9432; Setup Guide</button>
      </h2>
      <p class="desc">Connect your own domain name instead of using <code><%= settings.domain %></code>.</p>

      <div class="guide-panel" id="guide-domain">
        <ol>
          <li>Purchase a domain from any registrar (Namecheap, GoDaddy, Cloudflare, Google Domains, etc.).</li>
          <li>In your registrar's DNS settings, add an <strong>A Record</strong>:
            <table style="width:100%;font-size:0.72rem;border-collapse:collapse;margin:8px 0;">
              <tr style="background:var(--ivory);"><td style="padding:4px 8px;font-weight:600;">Type</td><td style="padding:4px 8px;font-weight:600;">Name</td><td style="padding:4px 8px;font-weight:600;">Value</td></tr>
              <tr><td style="padding:4px 8px;font-family:monospace;">A</td><td style="padding:4px 8px;font-family:monospace;">@</td><td style="padding:4px 8px;font-family:monospace;">104.237.138.28</td></tr>
              <tr><td style="padding:4px 8px;font-family:monospace;">A</td><td style="padding:4px 8px;font-family:monospace;">www</td><td style="padding:4px 8px;font-family:monospace;">104.237.138.28</td></tr>
            </table>
          </li>
          <li>Wait for DNS propagation (usually 5&ndash;30 minutes, can take up to 48 hours).</li>
          <li>Enter your domain below and save. SSL certificate will be provisioned automatically.</li>
          <li>After saving, your site will be live at both <code><%= settings.domain %></code> and your custom domain.</li>
        </ol>
        <div class="guide-tip">If you use Cloudflare: set the proxy status to "DNS only" (grey cloud) for the A records, otherwise SSL provisioning may fail.</div>
      </div>

      <div class="field-row">
        <label>Custom Domain</label>
        <input type="text" name="customDomain" value="<%= settings.customDomain %>" placeholder="yourbusiness.com" <%= (settings.customDomainPaidRequired && !settings.customDomain) ? 'disabled' : '' %>>
        <% if (settings.customDomainPaidRequired && !settings.customDomain) { %>
        <div class="field-hint" style="color:var(--gold);">🔒 Custom domains are a paid feature. <a href="/admin?golive=1" style="color:var(--gold);text-decoration:underline;">Subscribe to a plan</a> to point your own domain.</div>
        <% } else { %>
        <div class="field-hint">Point A records for <code>@</code> and <code>www</code> to <code style="user-select:all;">104.237.138.28</code> first. SSL is provisioned automatically.</div>
        <% } %>
      </div>

      <% if (!settings.customDomain && !settings.customDomainPaidRequired) { %>
      <button type="submit" style="margin-top:12px;padding:10px 24px;background:var(--gold);color:var(--on-surface);border:none;border-radius:3px;font-family:'Jost',sans-serif;font-size:0.8rem;font-weight:600;cursor:pointer;letter-spacing:0.04em;">Save Domain</button>
      <% } %>
    </div>

      </div><!-- /acc-body --></div><!-- /GROUP: BUSINESS -->

    <!-- ░░░ ACCORDION GROUP: PAYMENTS ░░░ -->
    <div class="acc-group">
      <button type="button" class="acc-head" onclick="toggleAcc(this)"><span class="acc-ic">&#9672;</span> Payments <span class="acc-sub">Stripe &amp; PayPal</span><span class="acc-chevron">&#9656;</span></button>
      <div class="acc-body">

    <!-- ═══════════ PAYMENT METHOD SELECTOR ═══════════ -->
    <div class="settings-section">
      <h2>&#9672; Payment Methods</h2>
      <p class="desc">Choose which payment option(s) customers see on your invoice payment page. Only configured providers will work.</p>
      <div class="field-row">
        <label>Offer on Invoices</label>
        <select name="paymentProvider">
          <option value="both"   <%= (settings.paymentProvider || 'both') === 'both'   ? 'selected' : '' %>>Both — let the customer choose</option>
          <option value="stripe" <%= settings.paymentProvider === 'stripe' ? 'selected' : '' %>>Stripe only (Pay with Card)</option>
          <option value="paypal" <%= settings.paymentProvider === 'paypal' ? 'selected' : '' %>>PayPal only</option>
        </select>
        <div class="field-hint">Controls the buttons shown at <code>/pay/&hellip;</code>. Set up your keys in the sections below.</div>
      </div>
    </div>

    <!-- ═══════════ STRIPE ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9672; Payments &mdash; Stripe
        <button type="button" class="guide-toggle" onclick="toggleGuide('stripe')">&#9432; Setup Guide</button>
      </h2>
      <p class="desc">Accept credit card payments for invoices and subscriptions.</p>

      <div class="guide-panel" id="guide-stripe">
        <ol>
          <li>Go to <a href="https://dashboard.stripe.com/register" target="_blank">stripe.com</a> and create an account (or log in).</li>
          <li>Complete Stripe's business verification (name, address, bank account for payouts).</li>
          <li>Navigate to <a href="https://dashboard.stripe.com/apikeys" target="_blank">Developers &rarr; API Keys</a>.</li>
          <li>Copy the <strong>Publishable key</strong> (<code>pk_live_...</code>) and paste it below.</li>
          <li>Click "Reveal" on the <strong>Secret key</strong> (<code>sk_live_...</code>) and paste it below.</li>
          <li>For webhooks: go to <a href="https://dashboard.stripe.com/webhooks" target="_blank">Developers &rarr; Webhooks</a>.</li>
          <li>Click <strong>Add endpoint</strong>. Set URL to <code>https://<%= settings.domain %>/webhooks/stripe</code>.</li>
          <li>Select events: <code>invoice.paid</code>, <code>checkout.session.completed</code>, <code>customer.subscription.deleted</code>.</li>
          <li>After creating, click the endpoint and copy the <strong>Signing secret</strong> (<code>whsec_...</code>).</li>
          <li>Paste it below and hit <strong>Save Settings</strong>. Use the <strong>Test</strong> button to verify.</li>
        </ol>
        <div class="guide-tip">Tip: Start in Test mode (<code>pk_test_</code> / <code>sk_test_</code>) to verify, then switch to Live keys when ready.</div>
      </div>

      <div class="field-row">
        <label>Publishable Key</label>
        <input type="text" name="stripePublishable" value="<%= settings.stripePublishable %>" placeholder="pk_live_... or pk_test_...">
        <div class="field-hint">Public key — safe to expose. Starts with <code>pk_live_</code> or <code>pk_test_</code></div>
      </div>
      <div class="field-row">
        <label>Secret Key <% if (settings.stripeSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label>
        <div class="inline">
          <input type="password" name="stripeSecret" value="<%= settings.stripeSecret %>" placeholder="sk_live_... or sk_test_...">
          <button type="button" class="btn-test" onclick="testStripe()">Test</button>
        </div>
        <div class="test-result" id="stripeResult"></div>
        <div class="field-hint">Secret key — never share this. Encrypted at rest.</div>
      </div>
      <div class="field-row">
        <label>Webhook Secret <% if (settings.stripeWebhookSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label>
        <input type="password" name="stripeWebhookSecret" value="<%= settings.stripeWebhookSecret %>" placeholder="whsec_...">
        <div class="field-hint">From Stripe Dashboard &rarr; Webhooks &rarr; your endpoint &rarr; Signing secret</div>
      </div>
    </div>

    <!-- ═══════════ PAYPAL ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9672; Payments &mdash; PayPal
        <button type="button" class="guide-toggle" onclick="toggleGuide('paypal')">&#9432; Setup Guide</button>
      </h2>
      <p class="desc">Accept PayPal payments alongside or instead of Stripe.</p>

      <div class="guide-panel" id="guide-paypal">
        <ol>
          <li>Go to <a href="https://developer.paypal.com/dashboard/applications" target="_blank">PayPal Developer Dashboard</a> and log in with your PayPal Business account.</li>
          <li>Under <strong>Apps &amp; Credentials</strong>, toggle to <strong>Live</strong> (not Sandbox).</li>
          <li>Click <strong>Create App</strong>. Name it anything (e.g., "<%= brand?.name || 'My Site' %> Payments").</li>
          <li>Copy the <strong>Client ID</strong> and paste it below.</li>
          <li>Click "Show" under <strong>Secret</strong>, copy it, and paste it below.</li>
          <li>Set Mode to <strong>Live</strong> when you're ready to accept real payments.</li>
        </ol>
        <div class="guide-tip">Tip: Use Sandbox mode first to test with fake money. Switch to Live only after verifying.</div>
      </div>

      <div class="field-row">
        <label>Client ID</label>
        <input type="text" name="paypalClientId" value="<%= settings.paypalClientId %>" placeholder="PayPal Client ID">
        <div class="field-hint">Found in PayPal Developer Dashboard &rarr; Apps &rarr; your app &rarr; Client ID</div>
      </div>
      <div class="field-row">
        <label>Secret <% if (settings.paypalSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label>
        <input type="password" name="paypalSecret" value="<%= settings.paypalSecret %>" placeholder="PayPal Secret">
        <div class="field-hint">Secret key — encrypted at rest. Never share this.</div>
      </div>
      <div class="field-row">
        <label>Mode</label>
        <select name="paypalMode">
          <option value="sandbox" <%= settings.paypalMode === 'sandbox' ? 'selected' : '' %>>Sandbox (Testing)</option>
          <option value="live" <%= settings.paypalMode === 'live' ? 'selected' : '' %>>Live</option>
        </select>
        <div class="field-hint">Sandbox = test transactions with fake money. Live = real charges.</div>
      </div>
    </div>

      </div><!-- /acc-body --></div><!-- /GROUP: PAYMENTS -->

    <!-- ░░░ ACCORDION GROUP: EMAIL ░░░ -->
    <div class="acc-group">
      <button type="button" class="acc-head" onclick="toggleAcc(this)"><span class="acc-ic">&#9672;</span> Email <span class="acc-sub">sending provider &amp; DNS</span><span class="acc-chevron">&#9656;</span></button>
      <div class="acc-body">

    <!-- ═══════════ EMAIL (ZOHO) ═══════════ -->
    <div class="settings-section">
      <% var ep = settings.emailProvider || 'zoho'; %>
      <h2>
        &#9672; Email Sending
      </h2>
      <p class="desc">Send invoices, campaigns, and client emails from your own mailbox. Pick a provider, then enter the login below. Most providers need an <strong>app-specific password</strong> &mdash; not your normal login password.</p>

      <div class="field-row">
        <label>Email Provider</label>
        <select name="emailProvider" id="emailProvider" onchange="onProviderChange()">
          <option value="zoho"    <%= ep==='zoho'    ? 'selected' : '' %>>Zoho Mail</option>
          <option value="gmail"   <%= ep==='gmail'   ? 'selected' : '' %>>Gmail / Google Workspace</option>
          <option value="outlook" <%= ep==='outlook' ? 'selected' : '' %>>Outlook / Microsoft 365</option>
          <option value="custom"  <%= ep==='custom'  ? 'selected' : '' %>>Custom SMTP</option>
        </select>
        <div class="field-hint" id="providerHint"></div>
      </div>

      <!-- Sign-in method — only Gmail/Outlook can use OAuth -->
      <% var am = settings.emailAuthMode || 'password'; %>
      <div class="field-row" id="authModeRow" style="display:none;">
        <label>Sign-in Method</label>
        <label style="display:flex;align-items:center;gap:8px;font-weight:400;text-transform:none;letter-spacing:0;margin-bottom:6px;cursor:pointer;">
          <input type="radio" name="emailAuthMode" value="password" <%= am !== 'oauth' ? 'checked' : '' %> onchange="onAuthModeChange()" style="width:auto;"> App password (SMTP) <span style="color:var(--slate);font-size:0.7rem;">— simplest</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-weight:400;text-transform:none;letter-spacing:0;cursor:pointer;">
          <input type="radio" name="emailAuthMode" value="oauth" <%= am === 'oauth' ? 'checked' : '' %> onchange="onAuthModeChange()" style="width:auto;"> OAuth sign-in <span style="color:var(--slate);font-size:0.7rem;">— required when SMTP passwords are disabled (M365 business / Workspace)</span>
        </label>
      </div>

      <!-- Per-provider setup guides — JS shows only the active provider's -->
      <div class="guide-panel prov-guide" id="provGuide-zoho">
        <ol>
          <li>Sign up for <a href="https://www.zoho.com/mail/zohomail-pricing.html" target="_blank">Zoho Mail</a> (Mail Lite works — the free plan does NOT include SMTP).</li>
          <li>Add your domain (e.g. <code><%= settings.domain %></code>) and verify ownership via a TXT record.</li>
          <li>Create your mailbox (e.g. <code>hello@<%= settings.domain %></code>).</li>
          <li>Go to <a href="https://accounts.zoho.com/home#security/security_pwd" target="_blank">Zoho Account &rarr; Security &rarr; App Passwords</a> and generate a password.</li>
          <li>Paste the email address + app password below and hit <strong>Test</strong>.</li>
        </ol>
        <div class="guide-tip">Regular Zoho passwords won't work for SMTP — you must use an App Password.</div>
      </div>
      <div class="guide-panel prov-guide" id="provGuide-gmail">
        <ol>
          <li>Turn on <a href="https://myaccount.google.com/signinoptions/two-step-verification" target="_blank">2-Step Verification</a> for the Google account (required before app passwords exist).</li>
          <li>Go to <a href="https://myaccount.google.com/apppasswords" target="_blank">Google Account &rarr; App passwords</a>, create one named "sLab", and copy the 16-character code.</li>
          <li>Enter the Gmail/Workspace address + that app password below and hit <strong>Test</strong>.</li>
        </ol>
        <div class="guide-tip">Your normal Google password will be rejected — only an App Password works over SMTP.</div>
      </div>
      <div class="guide-panel prov-guide" id="provGuide-outlook">
        <ol>
          <li><strong>Personal Outlook.com / Hotmail:</strong> create an app password at <a href="https://account.microsoft.com/security" target="_blank">account.microsoft.com &rarr; Security &rarr; Advanced security options</a>, then enter it below.</li>
          <li><strong>Microsoft 365 business:</strong> many tenants block SMTP basic-auth (AUTH). If the password is rejected, an admin must enable "Authenticated SMTP" for the mailbox, or use the <strong>Advanced &rarr; OAuth</strong> option below.</li>
          <li>Enter the address + app password and hit <strong>Test</strong>.</li>
        </ol>
        <div class="guide-tip">Outlook uses STARTTLS on port 587 — handled automatically.</div>
      </div>
      <div class="guide-panel prov-guide" id="provGuide-custom">
        <ol>
          <li>Enter your provider's SMTP host and port below (465 = implicit TLS, 587 = STARTTLS).</li>
          <li>Use the mailbox login or an app-specific password as the credentials.</li>
          <li>Hit <strong>Test</strong> to verify the connection.</li>
        </ol>
      </div>

      <!-- Custom SMTP host/port — shown only for Custom provider -->
      <div id="customSmtpFields" style="display:none;">
        <div style="display:grid;grid-template-columns:2fr 1fr;gap:0 14px;">
          <div class="field-row">
            <label>SMTP Host</label>
            <input type="text" name="smtpHost" value="<%= settings.smtpHost || '' %>" placeholder="smtp.yourprovider.com">
          </div>
          <div class="field-row">
            <label>Port</label>
            <input type="text" name="smtpPort" value="<%= settings.smtpPort || '' %>" placeholder="465 or 587">
          </div>
        </div>
        <div class="field-hint">Port 465 uses implicit TLS; 587 uses STARTTLS. We pick the right mode from the port.</div>
      </div>

      <!-- Password (SMTP) credentials — shown when sign-in method = App password -->
      <div id="passwordAuthFields">
        <div class="field-row">
          <label>Email Address <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--slate);">(the "from" address)</span></label>
          <input type="email" name="zohoUser" value="<%= settings.zohoUser %>" placeholder="you@yourdomain.com">
          <div class="field-hint">All outgoing emails (invoices, campaigns, notifications) are sent from this address.</div>
        </div>
        <div class="field-row">
          <label><span id="emailPassName">App Password</span> <% if (settings.zohoPass_set) { %><span class="field-set">&#9679; configured</span><% } %></label>
          <div class="inline">
            <input type="password" name="zohoPass" value="<%= settings.zohoPass %>" placeholder="App-specific password">
            <button type="button" class="btn-test" onclick="testEmail()">Test</button>
          </div>
          <div class="test-result" id="emailResult"></div>
          <div class="field-hint" id="emailPassHint">Use an app-specific password, not your normal login password.</div>
        </div>
      </div>

      <!-- OAuth sign-in (Gmail/Outlook) — shown when sign-in method = OAuth -->
      <div id="oauthConnectFields" style="display:none;">
        <div class="guide-panel open" style="margin-top:4px;">
          <p style="font-size:0.74rem;color:var(--on-surface);margin:0 0 10px;line-height:1.6;">
            Register an OAuth app with your provider, paste its Client ID &amp; Secret, click <strong>Save Settings</strong>, then <strong>Connect &amp; Authorize</strong> to sign in. No password is stored — sLab keeps an encrypted refresh token and auto-renews access.
          </p>

          <div class="oauth-prov" id="oauthProv-gmail">
            <div class="guide-tip" style="margin:0 0 8px;">Google: at <a href="https://console.cloud.google.com/apis/credentials" target="_blank">Cloud Console &rarr; Credentials</a> create an OAuth 2.0 Client ID (type <strong>Web application</strong>), enable the Gmail API, and add the redirect URI below.</div>
            <div class="field-row"><label>Google OAuth Client ID</label><input type="text" name="gmailOAuthClientId" value="<%= settings.gmailOAuthClientId || '' %>" placeholder="...apps.googleusercontent.com"></div>
            <div class="field-row"><label>Google OAuth Client Secret <% if (settings.gmailOAuthSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label><input type="password" name="gmailOAuthSecret" value="<%= settings.gmailOAuthSecret || '' %>" placeholder="GOCSPX-..."></div>
          </div>

          <div class="oauth-prov" id="oauthProv-outlook">
            <div class="guide-tip" style="margin:0 0 8px;">Microsoft: in <a href="https://entra.microsoft.com/" target="_blank">Entra ID &rarr; App registrations</a> register a <strong>Web</strong> app, add the delegated <code>SMTP.Send</code> + <code>offline_access</code> permissions, create a client secret, and add the redirect URI below.</div>
            <div class="field-row"><label>Microsoft OAuth Client ID</label><input type="text" name="outlookOAuthClientId" value="<%= settings.outlookOAuthClientId || '' %>" placeholder="Application (client) ID"></div>
            <div class="field-row"><label>Microsoft OAuth Client Secret <% if (settings.outlookOAuthSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label><input type="password" name="outlookOAuthSecret" value="<%= settings.outlookOAuthSecret || '' %>" placeholder="Client secret value"></div>
          </div>

          <div class="field-row">
            <label>Authorized Redirect URI <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--slate);">(add this exact URL to your OAuth app)</span></label>
            <input type="text" id="oauthRedirectUri" value="" readonly onclick="this.select()" style="font-family:monospace;font-size:0.72rem;background:var(--ivory);">
          </div>

          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px;">
            <a id="oauthConnectBtn" href="#" class="btn-test" style="text-decoration:none;display:inline-block;">Connect &amp; Authorize</a>
            <button type="button" class="btn-test" style="background:var(--navy);" onclick="testEmail()">Test</button>
            <span id="oauthStatus" style="font-size:0.74rem;"></span>
            <button type="button" id="oauthDisconnectBtn" onclick="disconnectOAuth()" style="display:none;background:none;border:1px solid var(--border);color:var(--slate);border-radius:3px;font-size:0.7rem;padding:5px 11px;cursor:pointer;">Disconnect</button>
          </div>
          <div class="test-result" id="emailResult2"></div>
        </div>
      </div>

      <div class="field-row" style="margin-top:18px;padding-top:18px;border-top:1px solid var(--border);">
        <label>Owner / Billing Email</label>
        <input type="email" name="ownerEmail" value="<%= settings.ownerEmail %>" placeholder="owner@yourbusiness.com">
        <div class="field-hint">
          Your account&rsquo;s billing &amp; notification address — where invoices, receipts and account emails are sent.
          Changing it here updates it everywhere. This is <strong>not</strong> your login email; your sign-in stays the same.
        </div>
      </div>

      <div class="field-row" style="margin-top:18px;">
        <label>Contact Form Recipient</label>
        <input type="email" name="contactEmail" value="<%= settings.contactEmail %>" placeholder="<%= settings.ownerEmail || 'leads@yourbusiness.com' %>">
        <div class="field-hint">
          Where landing-page contact form submissions are emailed. Inquiries are always stored under
          <a href="/admin/inquiries">Inquiries</a> as well.
          <% if (!settings.zohoPass_set) { %>
            <br><strong>Email not configured</strong> &mdash; emails will be sent via the MadLadsLab platform mailer (from a <code>madladslab.com</code> address). Connect an email provider above to send from your own domain.
          <% } %>
          <% if (!settings.contactEmail && settings.ownerEmail) { %>
            <br>Defaulting to owner email <code><%= settings.ownerEmail %></code> when blank.
          <% } %>
        </div>
      </div>
    </div>

    <!-- ═══════════ MICROSOFT SIGN-IN (WHITE GLOVE) ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9635; Microsoft Sign-In
        <% if (settings.microsoftOAuthConnected) { %><span class="field-set" style="font-size:0.68rem;">&#9679; configured</span><% } %>
        <button type="button" class="guide-toggle" onclick="toggleGuide('msauth')">&#9432; What is this?</button>
      </h2>
      <p class="desc">Let your team sign in to the admin with their <strong>Microsoft (Entra ID / Office 365)</strong> account. Leave blank to use the shared MadLadsLab Microsoft app; fill this in to run sign-in through <strong>your own</strong> Azure app (white glove).</p>

      <div class="guide-panel" id="guide-msauth">
        <ol>
          <li>Go to <a href="https://entra.microsoft.com/" target="_blank">Entra ID &rarr; App registrations</a> and <strong>New registration</strong>.</li>
          <li>Under <strong>Redirect URI</strong>, choose platform <strong>Web</strong> and paste the exact URL shown below.</li>
          <li>Copy the <strong>Application (client) ID</strong> into the field below.</li>
          <li>Under <strong>Certificates &amp; secrets</strong>, create a <strong>client secret</strong> and paste its <em>Value</em> below.</li>
          <li>Pick who may sign in: <code>common</code> (any Microsoft account), <code>organizations</code> (any work/school), or your <strong>Directory (tenant) ID</strong> to lock to your org only.</li>
          <li>Click <strong>Save Settings</strong>. A "Sign in with Microsoft" button appears on your admin login.</li>
        </ol>
        <div class="guide-tip">Delegated permission needed: <code>User.Read</code> (default). No mailbox access is requested — this is sign-in only.</div>
      </div>

      <div class="field-row">
        <label>Application (client) ID</label>
        <input type="text" name="microsoftOAuthClientId" value="<%= settings.microsoftOAuthClientId || '' %>" placeholder="00000000-0000-0000-0000-000000000000">
      </div>
      <div class="field-row">
        <label>Client Secret <% if (settings.microsoftOAuthSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label>
        <input type="password" name="microsoftOAuthSecret" value="<%= settings.microsoftOAuthSecret || '' %>" placeholder="Client secret value (not the Secret ID)">
      </div>
      <div class="field-row">
        <label>Directory (Azure Tenant) <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--slate);">— who can sign in</span></label>
        <input type="text" name="microsoftOAuthTenant" value="<%= settings.microsoftOAuthTenant || '' %>" placeholder="common (default) · organizations · or your Directory (tenant) ID">
      </div>
      <div class="field-row">
        <label>Authorized Redirect URI <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--slate);">(add this exact URL to your Azure app)</span></label>
        <input type="text" value="<%= settings.microsoftOAuthRedirect %>" readonly onclick="this.select()" style="font-family:monospace;font-size:0.72rem;background:var(--ivory);">
      </div>
    </div>

    <!-- ═══════════ EMAIL DNS ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9672; Email DNS Records
        <button type="button" class="guide-toggle" onclick="toggleGuide('dns')">&#9432; What are these?</button>
      </h2>
      <p class="desc">These DNS records are <strong>required</strong> for email deliverability. Without them, your emails will land in spam or be rejected.</p>

      <div class="guide-panel" id="guide-dns">
        <ol>
          <li><strong>SPF</strong> (Sender Policy Framework) &mdash; Tells receiving mail servers "these IP addresses are allowed to send email for my domain." Without it, servers assume your emails might be forged.</li>
          <li><strong>DKIM</strong> (DomainKeys Identified Mail) &mdash; Adds a cryptographic signature to every email you send. The receiving server checks it against a public key in your DNS to prove the email wasn't tampered with.</li>
          <li><strong>DMARC</strong> (Domain-based Message Authentication) &mdash; Ties SPF and DKIM together with a policy. It tells receivers what to do when emails fail authentication (monitor, quarantine, or reject).</li>
          <li><strong>MX Records</strong> &mdash; Only needed if you receive email on this domain via Zoho. Tells other mail servers where to deliver incoming mail.</li>
          <li><strong>Return-Path CNAME</strong> &mdash; Handles bounce messages. Zoho manages this, but the CNAME record lets them process bounces for your domain.</li>
        </ol>
        <div class="guide-tip">Where to add these: Log in to wherever you bought your domain (GoDaddy, Namecheap, Cloudflare, Google Domains, etc.) and find "DNS Settings" or "DNS Records". Add each record as shown below.</div>
      </div>

      <%
        const emailDomain = settings.zohoUser ? settings.zohoUser.split('@')[1] : settings.domain;
        const isSubdomain = settings.domain.endsWith('.madladslab.com');
      %>

      <div style="background:var(--ivory);padding:16px;border-radius:4px;margin-bottom:16px;">
        <div style="font-size:0.7rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--slate);margin-bottom:8px;">Sending Domain</div>
        <div style="font-size:0.95rem;font-weight:500;color:var(--navy);"><%= emailDomain || 'Set your Zoho email above' %></div>
      </div>

      <% if (emailDomain) { %>

      <!-- SPF -->
      <div style="margin-bottom:16px;padding:16px;border:1px solid var(--border);border-radius:4px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div style="font-size:0.78rem;font-weight:600;color:var(--on-surface);">SPF Record</div>
          <div class="dns-status" id="spf-status" style="font-size:0.68rem;font-weight:500;">&mdash;</div>
        </div>
        <div style="font-size:0.68rem;color:var(--slate);margin-bottom:8px;">Authorizes Zoho's servers to send email on behalf of your domain.</div>
        <table style="width:100%;font-size:0.75rem;border-collapse:collapse;">
          <tr style="background:var(--ivory);">
            <td style="padding:6px 10px;font-weight:600;width:60px;">Type</td>
            <td style="padding:6px 10px;font-weight:600;width:120px;">Name</td>
            <td style="padding:6px 10px;font-weight:600;">Value</td>
          </tr>
          <tr>
            <td style="padding:6px 10px;font-family:monospace;">TXT</td>
            <td style="padding:6px 10px;font-family:monospace;">@</td>
            <td style="padding:6px 10px;font-family:monospace;word-break:break-all;">v=spf1 include:zoho.com ~all</td>
          </tr>
        </table>
        <div style="font-size:0.65rem;color:var(--slate);margin-top:6px;">If you already have an SPF record, add <code>include:zoho.com</code> before the <code>~all</code></div>
      </div>

      <!-- DKIM -->
      <div style="margin-bottom:16px;padding:16px;border:1px solid var(--border);border-radius:4px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div style="font-size:0.78rem;font-weight:600;color:var(--on-surface);">DKIM Record</div>
          <div class="dns-status" id="dkim-status" style="font-size:0.68rem;font-weight:500;">&mdash;</div>
        </div>
        <div style="font-size:0.68rem;color:var(--slate);margin-bottom:8px;">Cryptographic signature proving your emails are authentic.</div>
        <table style="width:100%;font-size:0.75rem;border-collapse:collapse;">
          <tr style="background:var(--ivory);">
            <td style="padding:6px 10px;font-weight:600;width:60px;">Type</td>
            <td style="padding:6px 10px;font-weight:600;width:120px;">Name</td>
            <td style="padding:6px 10px;font-weight:600;">Value</td>
          </tr>
          <tr>
            <td style="padding:6px 10px;font-family:monospace;">TXT</td>
            <td style="padding:6px 10px;font-family:monospace;">zmail._domainkey</td>
            <td style="padding:6px 10px;font-size:0.68rem;color:var(--slate);font-style:italic;">Unique per domain &mdash; get from Zoho (see steps below)</td>
          </tr>
        </table>
        <div style="font-size:0.65rem;color:var(--slate);margin-top:6px;line-height:1.6;">
          <strong>How to get your DKIM key:</strong><br>
          1. Log in to <a href="https://mailadmin.zoho.com" target="_blank" style="color:var(--gold);">Zoho Mail Admin Console</a><br>
          2. Go to <strong>Domains</strong> &rarr; click <strong><%= emailDomain %></strong><br>
          3. Click <strong>Email Authentication</strong> &rarr; <strong>DKIM</strong><br>
          4. Click <strong>Add Selector</strong> (use "zmail" as the selector name)<br>
          5. Copy the generated TXT record value and add it to your DNS
        </div>
      </div>

      <!-- DMARC -->
      <div style="margin-bottom:16px;padding:16px;border:1px solid var(--border);border-radius:4px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div style="font-size:0.78rem;font-weight:600;color:var(--on-surface);">DMARC Record</div>
          <div class="dns-status" id="dmarc-status" style="font-size:0.68rem;font-weight:500;">&mdash;</div>
        </div>
        <div style="font-size:0.68rem;color:var(--slate);margin-bottom:8px;">Tells mail servers what to do when SPF/DKIM fail. Start with "none" then tighten over time.</div>
        <table style="width:100%;font-size:0.75rem;border-collapse:collapse;">
          <tr style="background:var(--ivory);">
            <td style="padding:6px 10px;font-weight:600;width:60px;">Type</td>
            <td style="padding:6px 10px;font-weight:600;width:120px;">Name</td>
            <td style="padding:6px 10px;font-weight:600;">Value</td>
          </tr>
          <tr>
            <td style="padding:6px 10px;font-family:monospace;">TXT</td>
            <td style="padding:6px 10px;font-family:monospace;">_dmarc</td>
            <td style="padding:6px 10px;font-family:monospace;word-break:break-all;">v=DMARC1; p=none; rua=mailto:dmarc@<%= emailDomain %></td>
          </tr>
        </table>
        <div style="font-size:0.65rem;color:var(--slate);margin-top:6px;">
          <strong>DMARC policy progression:</strong>
          <code>p=none</code> (monitor only, start here) &rarr;
          <code>p=quarantine</code> (send failures to spam) &rarr;
          <code>p=reject</code> (block failures entirely)
        </div>
      </div>

      <!-- MX -->
      <div style="margin-bottom:16px;padding:16px;border:1px solid var(--border);border-radius:4px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div style="font-size:0.78rem;font-weight:600;color:var(--on-surface);">MX Records <span style="font-size:0.65rem;font-weight:400;color:var(--slate);">(for receiving email via Zoho)</span></div>
          <div class="dns-status" id="mx-status" style="font-size:0.68rem;font-weight:500;">&mdash;</div>
        </div>
        <div style="font-size:0.68rem;color:var(--slate);margin-bottom:8px;">Required only if you receive email on this domain through Zoho. Skip if you use Gmail/Outlook for incoming.</div>
        <table style="width:100%;font-size:0.75rem;border-collapse:collapse;">
          <tr style="background:var(--ivory);">
            <td style="padding:6px 10px;font-weight:600;width:60px;">Type</td>
            <td style="padding:6px 10px;font-weight:600;width:60px;">Priority</td>
            <td style="padding:6px 10px;font-weight:600;width:80px;">Name</td>
            <td style="padding:6px 10px;font-weight:600;">Value</td>
          </tr>
          <tr><td style="padding:4px 10px;font-family:monospace;">MX</td><td style="padding:4px 10px;">10</td><td style="padding:4px 10px;font-family:monospace;">@</td><td style="padding:4px 10px;font-family:monospace;">mx.zoho.com</td></tr>
          <tr><td style="padding:4px 10px;font-family:monospace;">MX</td><td style="padding:4px 10px;">20</td><td style="padding:4px 10px;font-family:monospace;">@</td><td style="padding:4px 10px;font-family:monospace;">mx2.zoho.com</td></tr>
          <tr><td style="padding:4px 10px;font-family:monospace;">MX</td><td style="padding:4px 10px;">50</td><td style="padding:4px 10px;font-family:monospace;">@</td><td style="padding:4px 10px;font-family:monospace;">mx3.zoho.com</td></tr>
        </table>
      </div>

      <!-- Return-Path -->
      <div style="margin-bottom:16px;padding:16px;border:1px solid var(--border);border-radius:4px;">
        <div style="font-size:0.78rem;font-weight:600;color:var(--on-surface);margin-bottom:8px;">Return-Path (Bounce Handling)</div>
        <div style="font-size:0.68rem;color:var(--slate);margin-bottom:8px;">Lets Zoho process bounced emails for your domain.</div>
        <table style="width:100%;font-size:0.75rem;border-collapse:collapse;">
          <tr style="background:var(--ivory);">
            <td style="padding:6px 10px;font-weight:600;width:60px;">Type</td>
            <td style="padding:6px 10px;font-weight:600;width:120px;">Name</td>
            <td style="padding:6px 10px;font-weight:600;">Value</td>
          </tr>
          <tr>
            <td style="padding:6px 10px;font-family:monospace;">CNAME</td>
            <td style="padding:6px 10px;font-family:monospace;">zb._domainkey</td>
            <td style="padding:6px 10px;font-family:monospace;">zb._domainkey.zoho.com</td>
          </tr>
        </table>
      </div>

      <!-- Check DNS / Auto-create -->
      <button type="button" class="btn-test" onclick="checkDns()" style="padding:10px 24px;font-size:0.78rem;">
        Check DNS Records
      </button>
      <div id="dnsOverall" style="font-size:0.75rem;margin-top:8px;min-height:20px;"></div>

      <% if (isSubdomain) { %>
      <div style="margin-top:12px;padding:12px 16px;background:rgba(22,163,74,0.06);border:1px solid rgba(22,163,74,0.15);border-radius:4px;">
        <div style="font-size:0.72rem;color:#166534;">
          <strong>Subdomain tenant:</strong> SPF and DMARC records for <code><%= emailDomain %></code> can be auto-created.
          <button type="button" class="btn-test" onclick="autoCreateDns()" style="margin-left:8px;padding:6px 14px;font-size:0.68rem;background:#166534;">Auto-Create DNS</button>
          <span id="autoCreateResult" style="margin-left:8px;"></span>
        </div>
      </div>
      <% } %>

      <% } else { %>
        <div style="padding:16px;background:rgba(251,191,36,0.06);border:1px solid rgba(251,191,36,0.2);border-radius:4px;font-size:0.78rem;color:#92400e;">
          Set your Zoho email address above to see the required DNS records for your sending domain.
        </div>
      <% } %>
    </div>

      </div><!-- /acc-body --></div><!-- /GROUP: EMAIL -->

    <!-- ░░░ ACCORDION GROUP: INTEGRATIONS ░░░ -->
    <div class="acc-group">
      <button type="button" class="acc-head" onclick="toggleAcc(this)"><span class="acc-ic">&#9672;</span> Integrations <span class="acc-sub">Google reviews &amp; login</span><span class="acc-chevron">&#9656;</span></button>
      <div class="acc-body">

    <!-- ═══════════ GOOGLE REVIEWS ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9672; Google Reviews
        <button type="button" class="guide-toggle" onclick="toggleGuide('places')">&#9432; Setup Guide</button>
      </h2>
      <p class="desc">Display your Google Business reviews on your landing page. Requires a Google Cloud API key.</p>

      <div class="guide-panel" id="guide-places">
        <ol>
          <li>Go to <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a> and create a project (or select an existing one).</li>
          <li>Enable the <strong>Places API</strong>: search "Places API" in the API Library and click <strong>Enable</strong>.</li>
          <li>Go to <a href="https://console.cloud.google.com/apis/credentials" target="_blank">APIs &amp; Services &rarr; Credentials</a>.</li>
          <li>Click <strong>Create Credentials &rarr; API Key</strong>. Copy the key (<code>AIzaSy...</code>).</li>
          <li><strong>Restrict the key</strong> (recommended): click the key &rarr; under "API restrictions" select "Restrict key" &rarr; choose "Places API" only.</li>
          <li>Find your <strong>Place ID</strong>: go to <a href="https://developers.google.com/maps/documentation/places/web-service/place-id" target="_blank">Place ID Finder</a>, search your business, and copy the ID (<code>ChIJ...</code>).</li>
          <li>Paste both values below and save. Reviews will appear on your landing page within a few minutes.</li>
        </ol>
        <div class="guide-tip">Tip: Google gives $200/month in free API credits, which covers ~40,000 reviews lookups. More than enough for any site.</div>
      </div>

      <div class="field-row">
        <label>Google Places API Key</label>
        <input type="text" name="googlePlacesKey" value="<%= settings.googlePlacesKey %>" placeholder="AIzaSy...">
        <div class="field-hint">From Google Cloud Console &rarr; Credentials &rarr; API Keys</div>
      </div>
      <div class="field-row">
        <label>Google Place ID</label>
        <input type="text" name="googlePlaceId" value="<%= settings.googlePlaceId %>" placeholder="ChIJ...">
        <div class="field-hint">Your business Place ID. Find it at <a href="https://developers.google.com/maps/documentation/places/web-service/place-id" target="_blank" style="color:var(--gold);">Place ID Finder</a></div>
      </div>
    </div>

    <!-- ═══════════ GOOGLE OAUTH ═══════════ -->
    <div class="settings-section">
      <h2>
        &#9672; Google OAuth (Login)
        <button type="button" class="guide-toggle" onclick="toggleGuide('oauth')">&#9432; Setup Guide</button>
      </h2>
      <p class="desc">Let admins and clients log in with their Google account. Optional but recommended for easier access.</p>

      <div class="guide-panel" id="guide-oauth">
        <ol>
          <li>Go to <a href="https://console.cloud.google.com/apis/credentials" target="_blank">Google Cloud Console &rarr; Credentials</a> (same project as Places API).</li>
          <li>Click <strong>Create Credentials &rarr; OAuth client ID</strong>.</li>
          <li>If prompted, configure the <strong>OAuth consent screen</strong> first:
            <ul style="margin:4px 0 4px 16px;font-size:0.72rem;">
              <li>User Type: <strong>External</strong></li>
              <li>App name: <strong><%= brand?.name || 'Your Brand' %></strong></li>
              <li>Support email: your Zoho email</li>
              <li>Authorized domains: <code><%= settings.domain %></code></li>
            </ul>
          </li>
          <li>Back in Credentials, create the OAuth Client ID:
            <ul style="margin:4px 0 4px 16px;font-size:0.72rem;">
              <li>Application type: <strong>Web application</strong></li>
              <li>Authorized redirect URI: <code>https://<%= settings.domain %>/auth/google/callback</code></li>
            </ul>
          </li>
          <li>Copy the <strong>Client ID</strong> and <strong>Client Secret</strong> and paste them below.</li>
        </ol>
        <div class="guide-tip">Tip: Add both your subdomain and custom domain as authorized redirect URIs if you use both.</div>
      </div>

      <div class="field-row">
        <label>OAuth Client ID</label>
        <input type="text" name="googleOAuthClientId" value="<%= settings.googleOAuthClientId || '' %>" placeholder="123456789-abc.apps.googleusercontent.com">
        <div class="field-hint">From Google Cloud Console &rarr; Credentials &rarr; OAuth 2.0 Client IDs</div>
      </div>
      <div class="field-row">
        <label>OAuth Client Secret <% if (settings.googleOAuthSecret_set) { %><span class="field-set">&#9679; configured</span><% } %></label>
        <input type="password" name="googleOAuthSecret" value="<%= settings.googleOAuthSecret || '' %>" placeholder="GOCSPX-...">
        <div class="field-hint">Secret key — encrypted at rest. Found next to your Client ID in Google Cloud.</div>
      </div>
    </div>

    <!-- ═══════════ ASSET IMPORT — GOOGLE DRIVE & PHOTOS ═══════════ -->
    <div class="settings-section">
      <h2>&#9672; Asset Import &mdash; Google Drive &amp; Photos</h2>
      <p class="desc">Pull images straight from Google Drive or Google Photos into your Asset Library. Uses the platform's shared Google app — nothing to configure, just connect the account you want to import from. Manage and browse under <a href="/admin/assets" style="color:var(--gold);">Assets</a>.</p>

      <!-- Google Drive -->
      <div class="field-row">
        <label>Google Drive
          <% if (settings.googleDriveConnected) { %><span class="field-set">&#9679; connected<%= settings.googleDriveUser ? ' — ' + settings.googleDriveUser : '' %></span><% } %>
        </label>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <% if (settings.googleDriveConnected) { %>
            <a href="/auth/google/drive" class="btn-test" style="text-decoration:none;display:inline-block;background:var(--navy);">Reconnect</a>
            <button type="button" onclick="disconnectAssetSource('drive')" style="background:none;border:1px solid var(--border);color:var(--slate);border-radius:3px;font-size:0.7rem;padding:5px 11px;cursor:pointer;">Disconnect</button>
          <% } else { %>
            <a href="/auth/google/drive" class="btn-test" style="text-decoration:none;display:inline-block;">Connect Google Drive</a>
          <% } %>
        </div>
        <div class="field-hint">Browse and import any image from the connected Drive. Scope: <code>drive.readonly</code> (restricted — requires Google app verification for production).</div>
      </div>

      <!-- Google Photos -->
      <div class="field-row" style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
        <label>Google Photos
          <% if (settings.googlePhotosConnected) { %><span class="field-set">&#9679; connected<%= settings.googlePhotosUser ? ' — ' + settings.googlePhotosUser : '' %></span><% } %>
        </label>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <% if (settings.googlePhotosConnected) { %>
            <a href="/auth/google/photos" class="btn-test" style="text-decoration:none;display:inline-block;background:var(--navy);">Reconnect</a>
            <button type="button" onclick="disconnectAssetSource('photos')" style="background:none;border:1px solid var(--border);color:var(--slate);border-radius:3px;font-size:0.7rem;padding:5px 11px;cursor:pointer;">Disconnect</button>
          <% } else { %>
            <a href="/auth/google/photos" class="btn-test" style="text-decoration:none;display:inline-block;">Connect Google Photos</a>
          <% } %>
        </div>
        <div class="field-hint">Pick photos in Google's own picker, then import them. Scope: <code>photospicker.mediaitems.readonly</code> (sensitive — no CASA assessment needed).</div>
      </div>

      <script>
        function disconnectAssetSource(svc) {
          var label = svc === 'drive' ? 'Google Drive' : 'Google Photos';
          if (!confirm('Disconnect ' + label + ' from this site?')) return;
          fetch('/admin/assets/' + svc + '/disconnect', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d.success) location.reload(); else SlabFlash.error(d.error || 'Disconnect failed'); })
            .catch(function (e) { SlabFlash.error('Disconnect failed: ' + e.message); });
        }
      </script>
    </div>

      </div><!-- /acc-body --></div><!-- /GROUP: INTEGRATIONS -->

    <!-- ░░░ ACCORDION GROUP: sLAB NETWORK ░░░ -->
    <div class="acc-group">
      <button type="button" class="acc-head" onclick="toggleAcc(this)"><span class="acc-ic">&#9672;</span> sLab Network <span class="acc-sub">backlink exchange &amp; syndication</span><span class="acc-chevron">&#9656;</span></button>
      <div class="acc-body">

    <div class="settings-section">
      <h2>&#9672; Join the sLab Network</h2>
      <p class="desc">Opt in to the <a href="https://slab.madladslab.com/network" target="_blank" rel="noopener">sLab Network</a> &mdash; a shared directory of the brands built on sLab. Members get listed in the directory and can syndicate content (jobs, press, blogs, newsletters) to a high-traffic hub &mdash; and let visitors follow their newsletter right from the hub. In exchange, a small &ldquo;Part of the sLab Network&rdquo; backlink appears in your site footer.</p>

      <!-- Marker so the settings POST knows this section was submitted (checkboxes -->
      <!-- post nothing when off; without this we can't tell "off" from "untouched"). -->
      <input type="hidden" name="networkForm" value="1">

      <label class="net-toggle">
        <input type="checkbox" name="networkOptIn" id="networkOptIn" value="on" <%= settings.networkOptIn === 'true' ? 'checked' : '' %> onchange="netToggleModules(this.checked)">
        <span><strong>Join the sLab Network</strong><br><span class="net-sub">Lists your brand in the public directory and adds the footer backlink.</span></span>
      </label>

      <div id="net-modules" style="<%= settings.networkOptIn === 'true' ? '' : 'opacity:0.45;pointer-events:none;' %>margin-top:14px;padding-left:14px;border-left:2px solid var(--border);">
        <label class="net-toggle">
          <input type="checkbox" name="networkJobs" value="on" <%= settings.networkJobs === 'true' ? 'checked' : '' %>>
          <span><strong>Syndicate my job board</strong><br><span class="net-sub">Publishes your open roles to the Network job board.</span></span>
        </label>
        <label class="net-toggle">
          <input type="checkbox" name="networkPress" value="on" <%= settings.networkPress === 'true' ? 'checked' : '' %>>
          <span><strong>Syndicate my press releases</strong><br><span class="net-sub">Shares your published press posts to the Network newsroom.</span></span>
        </label>
        <label class="net-toggle">
          <input type="checkbox" name="networkVideo" value="on" <%= settings.networkVideo === 'true' ? 'checked' : '' %>>
          <span><strong>Syndicate my videos</strong><br><span class="net-sub">Features your latest YouTube uploads on the Network. Requires a YouTube channel set in Design.</span></span>
        </label>
        <label class="net-toggle">
          <input type="checkbox" name="networkMarket" value="on" <%= settings.networkMarket === 'true' ? 'checked' : '' %>>
          <span><strong>Syndicate my marketplace</strong><br><span class="net-sub">Lists your active marketplace items on the Network marketplace.</span></span>
        </label>
        <label class="net-toggle">
          <input type="checkbox" name="networkContent" value="on" <%= settings.networkContent === 'true' ? 'checked' : '' %>>
          <span><strong>Syndicate my writing</strong><br><span class="net-sub">Picks up everything you publish &mdash; blog posts, newsletter issues, help &amp; guides &mdash; and routes each to its matching section on the Network, just like it appears on your own site.</span></span>
        </label>
        <label class="net-toggle">
          <input type="checkbox" name="networkFollow" value="on" <%= settings.networkFollow === 'true' ? 'checked' : '' %>>
          <span><strong>Let the Network grow my list</strong><br><span class="net-sub">Adds a &ldquo;Follow&rdquo; toggle to your directory card so hub visitors can subscribe to your newsletter in one click.</span></span>
        </label>
      </div>

      <button type="submit" style="margin-top:16px;padding:10px 24px;background:var(--gold);color:var(--on-surface);border:none;border-radius:3px;font-family:'Jost',sans-serif;font-size:0.8rem;font-weight:600;cursor:pointer;letter-spacing:0.04em;">Save Network Settings</button>
    </div>

