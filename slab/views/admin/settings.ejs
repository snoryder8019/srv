<script>
function toggleGuide(id) {
  const panel = document.getElementById('guide-' + id);
  if (panel) panel.classList.toggle('open');
}

// ── Settings category accordions (independent toggles) ───────────────────────
function toggleAcc(head) {
  const g = head.closest('.acc-group');
  if (g) g.classList.toggle('open');
}

// ── sLab Network — dim the per-module toggles until the master switch is on ──
function netToggleModules(on) {
  const box = document.getElementById('net-modules');
  if (!box) return;
  box.style.opacity = on ? '' : '0.45';
  box.style.pointerEvents = on ? '' : 'none';
  if (!on) box.querySelectorAll('input[type=checkbox]').forEach(c => { c.checked = false; });
}

// ── Email provider switching ─────────────────────────────────────────────────
const EMAIL_PROVIDERS = {
  zoho:    { host: 'smtppro.zoho.com',      port: 465, passName: 'Zoho App Password',
             passHint: 'App password from Zoho Account → Security → App Passwords. Not your login password.' },
  gmail:   { host: 'smtp.gmail.com',        port: 465, passName: 'Gmail App Password',
             passHint: 'Requires 2-Step Verification ON, then an App Password from myaccount.google.com/apppasswords.' },
  outlook: { host: 'smtp-mail.outlook.com', port: 587, passName: 'Outlook App Password',
             passHint: 'Personal Outlook: app password from account.microsoft.com. M365 business may need Authenticated SMTP enabled or OAuth (Advanced).' },
  custom:  { host: '',                      port: '',  passName: 'SMTP Password',
             passHint: 'Password or app-specific password for your SMTP mailbox.' },
};
// OAuth state injected from the server
const OAUTH_REDIRECT_BASE = "<%= settings.emailOAuthRedirectBase || '' %>";
const OAUTH_STATUS = {
  gmail:   { connected: <%= settings.gmailOAuthConnected ? 'true' : 'false' %>,   user: "<%= settings.gmailOAuthUser || '' %>" },
  outlook: { connected: <%= settings.outlookOAuthConnected ? 'true' : 'false' %>, user: "<%= settings.outlookOAuthUser || '' %>" },
};
function emailProviderEl() { return document.getElementById('emailProvider'); }
function currentAuthMode() {
  const r = document.querySelector('input[name="emailAuthMode"]:checked');
  return r ? r.value : 'password';
}
function onProviderChange() {
  const sel = emailProviderEl();
  if (!sel) return;
  const p = sel.value;
  const cfg = EMAIL_PROVIDERS[p] || EMAIL_PROVIDERS.zoho;
  const oauthEligible = (p === 'gmail' || p === 'outlook');
  // Hint under the dropdown
  const hint = document.getElementById('providerHint');
  if (hint) hint.innerHTML = p === 'custom'
    ? 'Enter your SMTP host and port below.'
    : ('Sends through <code>' + cfg.host + ':' + cfg.port + '</code>');
  // Password field label + hint
  const passName = document.getElementById('emailPassName');
  if (passName) passName.textContent = cfg.passName;
  const passHint = document.getElementById('emailPassHint');
  if (passHint) passHint.textContent = cfg.passHint;
  // Custom host/port fields
  const custom = document.getElementById('customSmtpFields');
  if (custom) custom.style.display = (p === 'custom') ? 'block' : 'none';
  // Per-provider setup guide
  document.querySelectorAll('.prov-guide').forEach(function(el) { el.classList.remove('open'); });
  const guide = document.getElementById('provGuide-' + p);
  if (guide) guide.classList.add('open');
  // Auth-method selector only for OAuth-capable providers
  const authRow = document.getElementById('authModeRow');
  if (authRow) authRow.style.display = oauthEligible ? 'block' : 'none';
  applyEmailAuthVisibility();
}
function onAuthModeChange() { applyEmailAuthVisibility(); }
function applyEmailAuthVisibility() {
  const p = emailProviderEl() ? emailProviderEl().value : 'zoho';
  const oauthEligible = (p === 'gmail' || p === 'outlook');
  const mode = oauthEligible ? currentAuthMode() : 'password';
  const showOAuth = oauthEligible && mode === 'oauth';

  const pwBlock = document.getElementById('passwordAuthFields');
  if (pwBlock) pwBlock.style.display = showOAuth ? 'none' : 'block';
  const oaBlock = document.getElementById('oauthConnectFields');
  if (oaBlock) oaBlock.style.display = showOAuth ? 'block' : 'none';
  if (!showOAuth) return;

  // Show the active provider's OAuth fields
  document.querySelectorAll('.oauth-prov').forEach(function(el) { el.style.display = 'none'; });
  const prov = document.getElementById('oauthProv-' + p);
  if (prov) prov.style.display = 'block';
  // Redirect URI + connect link
  const redir = OAUTH_REDIRECT_BASE ? (OAUTH_REDIRECT_BASE + '/' + p + '/callback') : '';
  const redirEl = document.getElementById('oauthRedirectUri');
  if (redirEl) redirEl.value = redir;
  const connectBtn = document.getElementById('oauthConnectBtn');
  if (connectBtn) connectBtn.setAttribute('href', '/admin/settings/email/oauth/' + p + '/connect');
  // Connected status
  const st = OAUTH_STATUS[p] || { connected: false, user: '' };
  const statusEl = document.getElementById('oauthStatus');
  const disconnectBtn = document.getElementById('oauthDisconnectBtn');
  if (statusEl) {
    if (st.connected) { statusEl.innerHTML = '<span style="color:#16a34a;font-weight:600;">&#9679; Connected' + (st.user ? ' as ' + st.user : '') + '</span>'; }
    else { statusEl.innerHTML = '<span style="color:var(--slate);">Not connected yet</span>'; }
  }
  if (disconnectBtn) disconnectBtn.style.display = st.connected ? 'inline-block' : 'none';
  if (connectBtn) connectBtn.textContent = st.connected ? 'Reconnect' : 'Connect & Authorize';
}
async function disconnectOAuth() {
  const p = emailProviderEl() ? emailProviderEl().value : '';
  if (!p) return;
  if (!confirm('Disconnect this mailbox? Outgoing email will stop until you reconnect or switch to an app password.')) return;
  try {
    const r = await fetch('/admin/settings/email/oauth/' + p + '/disconnect', { method: 'POST' });
    const d = await r.json();
    if (d.ok) { OAUTH_STATUS[p] = { connected: false, user: '' }; applyEmailAuthVisibility(); }
    else { SlabFlash.error(d.error || 'Disconnect failed'); }
  } catch { SlabFlash.error('Network error'); }
}
function setEmailResult(text, cls) {
  ['emailResult', 'emailResult2'].forEach(function(id) {
    const el = document.getElementById(id);
    if (el) { el.textContent = text; el.className = 'test-result ' + (cls || ''); }
  });
}
document.addEventListener('DOMContentLoaded', onProviderChange);

async function testStripe() {
  const el = document.getElementById('stripeResult');
  el.textContent = 'Testing...'; el.className = 'test-result';
  try {
    const r = await fetch('/admin/settings/test-stripe', { method: 'POST' });
    const d = await r.json();
    if (d.ok) { el.textContent = 'Connected (' + d.currency + ')'; el.className = 'test-result test-ok'; }
    else { el.textContent = d.error; el.className = 'test-result test-fail'; }
  } catch { el.textContent = 'Network error'; el.className = 'test-result test-fail'; }
}

async function testEmail() {
  setEmailResult('Testing...', '');
  try {
    const r = await fetch('/admin/settings/test-email', { method: 'POST' });
    const d = await r.json();
    if (d.ok) setEmailResult('Connection verified' + (d.provider ? ' (' + d.provider + ')' : ''), 'test-ok');
    else setEmailResult(d.error, 'test-fail');
  } catch { setEmailResult('Network error', 'test-fail'); }
}

async function checkDns() {
  const overall = document.getElementById('dnsOverall');
  overall.textContent = 'Checking DNS records...';
  overall.style.color = 'var(--slate)';
  ['spf','dkim','dmarc','mx'].forEach(k => {
    const el = document.getElementById(k + '-status');
    if (el) { el.textContent = '...'; el.style.color = 'var(--slate)'; }
  });
  try {
    const r = await fetch('/admin/settings/check-dns', { method: 'POST' });
    const d = await r.json();
    if (!d.ok) { overall.textContent = d.error; overall.style.color = '#dc2626'; return; }
    const res = d.results;
    let allGood = true;
    ['spf','dkim','dmarc','mx'].forEach(k => {
      const el = document.getElementById(k + '-status');
      if (!el || !res[k]) return;
      if (res[k].valid) {
        el.textContent = '\u2713 ' + res[k].message;
        el.style.color = '#16a34a';
      } else if (res[k].found) {
        el.textContent = '\u26A0 ' + res[k].message;
        el.style.color = '#d97706';
        allGood = false;
      } else {
        el.textContent = '\u2717 ' + res[k].message;
        el.style.color = '#dc2626';
        allGood = false;
      }
    });
    if (allGood) {
      overall.textContent = 'All email DNS records look good!';
      overall.style.color = '#16a34a';
    } else {
      overall.textContent = 'Some records need attention \u2014 see above.';
      overall.style.color = '#d97706';
    }
  } catch { overall.textContent = 'Network error'; overall.style.color = '#dc2626'; }
}

async function autoCreateDns() {
  const el = document.getElementById('autoCreateResult');
  el.textContent = 'Creating records...';
  el.style.color = 'var(--slate)';
  try {
    const r = await fetch('/admin/settings/auto-create-dns', { method: 'POST' });
    const d = await r.json();
    if (!d.ok) { el.textContent = d.error; el.style.color = '#dc2626'; return; }
    let msg = '';
    if (d.created.length) msg += 'Created: ' + d.created.join(', ') + '. ';
    if (d.errors.length) msg += 'Failed: ' + d.errors.join(', ') + '. ';
    if (d.note) msg += d.note;
    el.textContent = msg;
    el.style.color = d.errors.length ? '#d97706' : '#16a34a';
  } catch { el.textContent = 'Network error'; el.style.color = '#dc2626'; }
}
</script>
<script>
// ── Tutorial settings ────────────────────────────────────────────────────────
(async function() {
  try {
    const r = await fetch('/admin/tutorials/status');
    if (!r.ok) return;
    const d = await r.json();
    const t = d.tutorials || {};
    document.getElementById('tutAutoPlay').checked = t.autoPlay !== false;
    document.getElementById('tutCollapsed').checked = !!t.collapsed;
  } catch {}

  // Fetch progress
  try {
    const r = await fetch('/admin/tutorials/progress');
    if (r.ok) {
      const d = await r.json();
      document.getElementById('tutProgress').textContent = d.completed + '/' + d.total + ' completed (' + d.percentage + '%)';
    }
  } catch {}

  // Toggle handlers
  document.getElementById('tutAutoPlay').addEventListener('change', async function() {
    await fetch('/admin/tutorials/preferences', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ autoPlay: this.checked })
    });
    if (this.checked && typeof AdminTour !== 'undefined') AdminTour.resumeAll();
  });

  document.getElementById('tutCollapsed').addEventListener('change', async function() {
    await fetch('/admin/tutorials/preferences', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ collapsed: this.checked })
    });
    if (typeof AdminTour !== 'undefined') {
      if (this.checked) AdminTour.collapseAll();
      else AdminTour.expandAll();
    }
  });
})();

async function resetAllTutorials() {
  const el = document.getElementById('tutResult');
  try {
    const r = await fetch('/admin/tutorials/reset', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}'
    });
    const d = await r.json();
    if (d.success) {
      el.textContent = 'All tutorials reset — they will auto-play again on each page.';
      el.className = 'test-result test-ok';
      document.getElementById('tutProgress').textContent = '0/' + (document.getElementById('tutProgress').textContent.split('/')[1] || '27');
    }
  } catch(e) { el.textContent = 'Error: ' + e.message; el.className = 'test-result test-fail'; }
}

// ── Changelog ────────────────────────────────────────────────────────────────
// Click commit row to select its hash
document.querySelectorAll('#changelogList [data-hash]').forEach(function(row) {
  row.style.cursor = 'pointer';
  row.addEventListener('click', function() {
    var hashInput = document.getElementById('clHash');
    if (hashInput) {
      hashInput.value = row.dataset.hash;
      hashInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
});

async function addChangelog() {
  var el = document.getElementById('clResult');
  var commitHash = document.getElementById('clHash').value.trim();
  var notes = document.getElementById('clNotes').value.trim();
  if (!notes) { el.textContent = 'Notes required'; el.className = 'test-result test-fail'; return; }

  try {
    var r = await fetch('/admin/settings/changelog', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ commitHash: commitHash, notes: notes })
    });
    var d = await r.json();
    if (d.ok) {
      el.textContent = 'Pinned!'; el.className = 'test-result test-ok';
      setTimeout(function() { location.reload(); }, 800);
    } else {
      el.textContent = d.error || 'Failed'; el.className = 'test-result test-fail';
    }
  } catch(e) { el.textContent = e.message; el.className = 'test-result test-fail'; }
}
</script>
<script src="/js/tours/settings.js"></script>
