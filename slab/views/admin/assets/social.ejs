// ═══════════════════════════════════════════
//  GRADIENT BACKGROUND  (native layer · brand-tied · editable)
// ═══════════════════════════════════════════
const grState = { kind:'linear', angle:135, stops:['#1C2B4A','#C9A848'], grain:0, vignette:false, userTouched:false };
const GR_PRESETS = ['Sheen','Glow','Spotlight','Mesh','Dusk','Conic'];

function hexToRgb(h){ h=String(h||'').replace('#',''); if(h.length===3) h=h.split('').map(x=>x+x).join(''); const n=parseInt(h||'0',16)||0; return [(n>>16)&255,(n>>8)&255,n&255]; }
function lighten(hex, amt){ const [r,g,b]=hexToRgb(hex); const f=c=>Math.round(c+(255-c)*(amt/100)); return '#'+[f(r),f(g),f(b)].map(x=>x.toString(16).padStart(2,'0')).join(''); }

function grBrandStops(n){
  const pal = (currentPalette && currentPalette.length) ? currentPalette : ['#1C2B4A','#C9A848','#F5F3EF'];
  return Array.from({length:n}, (_,i) => pal[i % pal.length]);
}
function grSeedFromBrand(){ if (grState.userTouched) return; grState.stops = grBrandStops(2); grRenderStops(); grBuildPreview(); }
function grStopColors(){ const s = grState.stops.filter(Boolean); return s.length >= 2 ? s : [...s, s[0] || '#1C2B4A']; }
function grMeshPts(n){ const pts=[[0.2,0.25],[0.82,0.2],[0.78,0.8],[0.22,0.78],[0.5,0.5],[0.9,0.6],[0.1,0.45]]; return Array.from({length:n}, (_,i)=>pts[i%pts.length]); }

function grRenderStops(){
  const wrap = document.getElementById('grStops'); if (!wrap) return;
  wrap.innerHTML = '';
  grState.stops.forEach((c, i) => {
    const row = document.createElement('div'); row.className = 'gr-stop';
    row.innerHTML = `<input type="color" value="${c}"><input type="text" class="sg-input gr-hex" value="${c}">`
      + (grState.stops.length > 2 ? `<button type="button" class="gr-del" title="Remove">&#10005;</button>` : `<span style="width:24px;flex-shrink:0;"></span>`);
    const inputs = row.querySelectorAll('input'); const col = inputs[0], hex = inputs[1];
    col.addEventListener('input', e => { grState.stops[i]=e.target.value; hex.value=e.target.value; grState.userTouched=true; grBuildPreview(); });
    hex.addEventListener('change', e => { let v=e.target.value.trim(); if(!/^#/.test(v)) v='#'+v; if(/^#[0-9a-fA-F]{6}$/.test(v)){ grState.stops[i]=v; col.value=v; grState.userTouched=true; grBuildPreview(); } });
    const del = row.querySelector('.gr-del');
    if (del) del.addEventListener('click', () => { grState.stops.splice(i,1); grState.userTouched=true; grRenderStops(); grBuildPreview(); });
    wrap.appendChild(row);
  });
}
function grRenderPresets(){
  const wrap = document.getElementById('grPresets'); if (!wrap) return; wrap.innerHTML = '';
  GR_PRESETS.forEach(n => { const b=document.createElement('button'); b.type='button'; b.className='gr-preset-btn'; b.textContent=n; b.addEventListener('click',()=>grApplyPreset(n)); wrap.appendChild(b); });
}
function grSyncControls(){
  document.querySelectorAll('#grTypes .gr-type-btn').forEach(b=>b.classList.toggle('active', b.dataset.kind===grState.kind));
  const ar=document.getElementById('grAngleRow'); if(ar) ar.style.display = (grState.kind==='linear'||grState.kind==='conic') ? 'flex' : 'none';
  const a=document.getElementById('grAngle'); if(a) a.value=grState.angle;
  const av=document.getElementById('grAngleVal'); if(av) av.textContent=grState.angle+'°';
  const g=document.getElementById('grGrain'); if(g) g.value=grState.grain;
  const gv=document.getElementById('grGrainVal'); if(gv) gv.textContent=grState.grain+'%';
  const v=document.getElementById('grVignette'); if(v) v.checked=grState.vignette;
}
function grApplyPreset(name){
  const pal = (currentPalette && currentPalette.length) ? currentPalette : ['#1C2B4A','#C9A848','#F5F3EF'];
  const P = pal[0], A = pal[1] || lighten(pal[0],45), C = pal[2] || A;
  grState.userTouched = true;
  if (name==='Sheen')      { grState.kind='linear'; grState.angle=135; grState.stops=[P,A];                 grState.grain=10; grState.vignette=false; }
  else if (name==='Glow')  { grState.kind='radial'; grState.stops=[A,P];                                    grState.grain=6;  grState.vignette=true;  }
  else if (name==='Spotlight'){ grState.kind='radial'; grState.stops=[lighten(A,35),P];                     grState.grain=0;  grState.vignette=true;  }
  else if (name==='Mesh')  { grState.kind='mesh';   grState.stops=[P,A,C];                                  grState.grain=14; grState.vignette=false; }
  else if (name==='Dusk')  { grState.kind='linear'; grState.angle=160; grState.stops=[P,A,lighten(C,18)];   grState.grain=18; grState.vignette=false; }
  else if (name==='Conic') { grState.kind='conic';  grState.angle=90;  grState.stops=[P,A,P];               grState.grain=6;  grState.vignette=false; }
  grSyncControls(); grRenderStops(); grBuildPreview();
}

function grBuildLinear(c2d, angle, colors, x, y, w, h){
  const cx=x+w/2, cy=y+h/2, rad=angle*Math.PI/180, dx=Math.cos(rad), dy=Math.sin(rad);
  const ext=Math.abs(dx*w/2)+Math.abs(dy*h/2);
  const g=c2d.createLinearGradient(cx-dx*ext, cy-dy*ext, cx+dx*ext, cy+dy*ext);
  colors.forEach((c,i)=>g.addColorStop(colors.length>1?i/(colors.length-1):0, c)); return g;
}
function grBuildRadial(c2d, colors, x, y, w, h){
  const cx=x+w/2, cy=y+h/2;
  const g=c2d.createRadialGradient(cx, cy, Math.min(w,h)*0.04, cx, cy, Math.max(w,h)*0.72);
  colors.forEach((c,i)=>g.addColorStop(colors.length>1?i/(colors.length-1):0, c)); return g;
}

let _grNoiseTile = null;
function grNoiseTile(){
  if (_grNoiseTile) return _grNoiseTile;
  const s=128, c=document.createElement('canvas'); c.width=c.height=s;
  const x=c.getContext('2d'), img=x.createImageData(s,s), d=img.data;
  for (let i=0;i<d.length;i+=4){ const v=Math.random()*255|0; d[i]=d[i+1]=d[i+2]=v; d[i+3]=255; }
  x.putImageData(img,0,0); _grNoiseTile=c; return c;
}

// Draws a gradient layer (also used for the live preview swatch with a temp layer).
function drawGradientLayer(c2d, l){
  const g = l.gradient || {}; const x=l.x||0, y=l.y||0, w=l.w, h=l.h;
  const colors = (g.stops && g.stops.length>=2) ? g.stops : ['#1C2B4A','#C9A848'];
  c2d.save();
  c2d.beginPath(); c2d.rect(x,y,w,h); c2d.clip();
  if (g.kind === 'mesh') {
    c2d.fillStyle = colors[0]; c2d.fillRect(x,y,w,h);
    const pts = g.meshPts || grMeshPts(colors.length);
    c2d.globalCompositeOperation = 'lighten';
    colors.forEach((col,i)=>{
      const p = pts[i % pts.length], gx = x+p[0]*w, gy = y+p[1]*h, r = Math.max(w,h)*0.62;
      const rg = c2d.createRadialGradient(gx,gy,0,gx,gy,r), [rr,gg,bb]=hexToRgb(col);
      rg.addColorStop(0, `rgba(${rr},${gg},${bb},0.92)`); rg.addColorStop(1, `rgba(${rr},${gg},${bb},0)`);
      c2d.fillStyle = rg; c2d.fillRect(x,y,w,h);
    });
    c2d.globalCompositeOperation = 'source-over';
  } else if (g.kind === 'conic' && c2d.createConicGradient) {
    const cg = c2d.createConicGradient(((g.angle??135)-90)*Math.PI/180, x+w/2, y+h/2);
    colors.forEach((c,i)=>cg.addColorStop(colors.length>1?i/(colors.length-1):0, c));
    c2d.fillStyle = cg; c2d.fillRect(x,y,w,h);
  } else if (g.kind === 'radial') {
    c2d.fillStyle = grBuildRadial(c2d, colors, x,y,w,h); c2d.fillRect(x,y,w,h);
  } else {
    c2d.fillStyle = grBuildLinear(c2d, g.angle??135, colors, x,y,w,h); c2d.fillRect(x,y,w,h);
  }
  if (g.grain) {
    c2d.globalAlpha = Math.min(0.55, (g.grain/100)*0.55);
    c2d.globalCompositeOperation = 'overlay';
    c2d.fillStyle = c2d.createPattern(grNoiseTile(), 'repeat'); c2d.fillRect(x,y,w,h);
    c2d.globalAlpha = 1; c2d.globalCompositeOperation = 'source-over';
  }
  if (g.vignette) {
    const cx=x+w/2, cy=y+h/2;
    const vg = c2d.createRadialGradient(cx,cy,Math.min(w,h)*0.34,cx,cy,Math.max(w,h)*0.74);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,0,0,0.4)');
    c2d.fillStyle = vg; c2d.fillRect(x,y,w,h);
  }
  c2d.restore();
}

function grSnapshot(){
  const colors = grStopColors();
  return { kind:grState.kind, angle:grState.angle, stops:colors, grain:grState.grain, vignette:grState.vignette,
           meshPts: grState.kind==='mesh' ? grMeshPts(colors.length) : null };
}
function grBuildPreview(){
  const cv = document.getElementById('grPreview'); if (!cv) return;
  const c2d = cv.getContext('2d'); c2d.clearRect(0,0,cv.width,cv.height);
  drawGradientLayer(c2d, { x:0, y:0, w:cv.width, h:cv.height, opacity:1, gradient: grSnapshot() });
}
function grApply(){
  layers = layers.filter(l => !l._gradBg);
  const layer = { type:'gradient', x:0, y:0, w:canvasW, h:canvasH, gradient: grSnapshot(), name:'Gradient BG', _gradBg:true, id:nextId++, visible:true, opacity:1 };
  layers.unshift(layer);
  setSelection(layer.id); renderLayerList(); render();
}

document.querySelectorAll('#grTypes .gr-type-btn').forEach(b=>{
  b.addEventListener('click', ()=>{ grState.kind=b.dataset.kind; grState.userTouched=true; grSyncControls(); grBuildPreview(); });
});
document.getElementById('grAngle')?.addEventListener('input', e=>{ grState.angle=+e.target.value; document.getElementById('grAngleVal').textContent=grState.angle+'°'; grBuildPreview(); });
