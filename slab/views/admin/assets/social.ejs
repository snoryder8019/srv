    if (l) { drawCropOverlay(l, cropMode.rect); return; }
  }

  // selection outlines — one per selected layer; primary is brighter
  if (multiSel.size) {
    selectionLayers().forEach(l => {
      if (!l.visible) return;
      ctx.save();
      applyLayerRotation(ctx, l);
      ctx.strokeStyle = (l.id === selId) ? '#C9A848' : 'rgba(201,168,72,0.6)';
      ctx.lineWidth = Math.max(2, canvasW * 0.002);
