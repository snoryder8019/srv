  const scaleX = l.w / l.crop.sw, scaleY = l.h / l.crop.sh;
  l.x = l.x - l.crop.sx * scaleX;
  l.y = l.y - l.crop.sy * scaleY;
  l.w = l.img.naturalWidth * scaleX;
  l.h = l.img.naturalHeight * scaleY;
