    <div class="sg-row"><span class="sg-lbl">Opacity</span><input type="range" data-prop="opacity" min="0" max="1" step="0.05" value="${l.opacity}" style="flex:1"></div>
    <div class="sg-row"><span class="sg-lbl">Rotate</span>
      <input type="range" data-prop="rotation" min="-180" max="180" step="1" value="${l.rotation||0}" style="flex:1">
      <input type="number" class="sg-input" data-prop="rotation" value="${Math.round(l.rotation||0)}" style="width:54px" title="Degrees">
      <button type="button" class="tool-btn" data-rot-reset style="padding:3px 6px;font-size:0.6rem;" title="Reset rotation">0&deg;</button></div>`;

  if (l.type === 'text') {
    html += `
      <div class="sg-col"><span class="sg-lbl">Text</span><textarea class="sg-textarea" data-prop="text" rows="3" style="min-height:54px;">${esc(l.text)}</textarea></div>
      <div class="sg-row"><span class="sg-lbl">Size</span><input type="number" class="sg-input" data-prop="fontSize" value="${l.fontSize}" style="width:55px">
      <span class="sg-lbl">Font</span><select class="sg-select" data-prop="fontFamily" style="flex:1">
        ${['Cormorant Garamond','Playfair Display','Lora','Merriweather','Libre Baskerville','Jost','Inter','Poppins','Raleway','Nunito','DM Sans','Arial','Georgia','Impact','Courier New']
          .map(f => '<option value="'+f+'" '+(l.fontFamily===f?'selected':'')+'>'+f+'</option>').join('')}
      </select></div>
      <div class="sg-row"><span class="sg-lbl">Color</span><input type="color" data-prop="color" value="${l.color}" style="width:32px;height:24px;border:1px solid var(--border);cursor:pointer;">
      <span class="sg-lbl">Align</span><select class="sg-select" data-prop="align" style="width:70px">
        <option ${l.align==='left'?'selected':''}>left</option><option ${l.align==='center'?'selected':''}>center</option><option ${l.align==='right'?'selected':''}>right</option>
      </select>
      <label style="font-size:0.65rem;display:flex;align-items:center;gap:3px;"><input type="checkbox" data-prop="bold" ${l.bold?'checked':''}> B</label>
      <label style="font-size:0.65rem;display:flex;align-items:center;gap:3px;"><input type="checkbox" data-prop="italic" ${l.italic?'checked':''}> I</label>
      </div>`;
  }
  if (l.type === 'rect') {
    html += `
      <div class="sg-row"><span class="sg-lbl">Fill</span><input type="color" data-prop="fill" value="${l.fill||'#000000'}" style="width:32px;height:24px;cursor:pointer;">
      <span class="sg-lbl">Stroke</span><input type="color" data-prop="stroke" value="${l.stroke||'#000000'}" style="width:32px;height:24px;cursor:pointer;">
      <input type="number" class="sg-input" data-prop="strokeWidth" value="${l.strokeWidth||0}" style="width:40px" title="Stroke width"></div>
      <div class="sg-row"><span class="sg-lbl">Radius</span><input type="number" class="sg-input" data-prop="radius" value="${l.radius||0}" style="width:50px"></div>`;
  }
  if (l.type === 'circle') {
    html += `
      <div class="sg-row"><span class="sg-lbl">Fill</span><input type="color" data-prop="fill" value="${l.fill||'#000000'}" style="width:32px;height:24px;cursor:pointer;">
      <span class="sg-lbl">Stroke</span><input type="color" data-prop="stroke" value="${l.stroke||'#000000'}" style="width:32px;height:24px;cursor:pointer;">
      <input type="number" class="sg-input" data-prop="strokeWidth" value="${l.strokeWidth||0}" style="width:40px"></div>`;
  }
  if (l.type === 'line') {
    html += `
      <div class="sg-row"><span class="sg-lbl">Stroke</span><input type="color" data-prop="stroke" value="${l.stroke||'#000000'}" style="width:32px;height:24px;cursor:pointer;">
      <input type="number" class="sg-input" data-prop="strokeWidth" value="${l.strokeWidth||2}" style="width:40px">
      <span class="sg-lbl">Dash</span><input type="number" class="sg-input" data-prop="dash" value="${l.dash||0}" style="width:40px"></div>`;
  }

  if (l.type === 'image') {
    if (cropMode && cropMode.id === l.id) {
      html += `
        <div class="sg-row" style="gap:6px;">
          <button type="button" class="tool-btn" id="cropApplyBtn" style="flex:1;background:var(--navy);color:#fff;border-color:var(--navy);">✓ Apply crop</button>
          <button type="button" class="tool-btn" id="cropCancelBtn" style="flex:1;">Cancel</button></div>
        <div class="sg-row" style="font-size:0.58rem;opacity:0.6;">Drag the handles · Enter applies · Esc cancels</div>`;
    } else {
      html += `
        <div class="sg-row" style="gap:6px;flex-wrap:wrap;">
          <button type="button" class="tool-btn" id="cropBtn" title="Trim the image edges">⛶ Crop</button>
          ${l.crop ? `<button type="button" class="tool-btn" id="cropResetBtn" title="Restore the full image">Reset crop</button>` : ''}
          <button type="button" class="tool-btn" id="bgColorBtn" title="Knock out a solid background colour (sampled from the image corners)">Remove BG color</button></div>`;
      const rc = l.recolor || {};
      const rcColor = rc.color || activeColor || '#1C2B4A';
      const rcStrength = rc.strength ?? 1;
      html += `
        <div class="sg-row" style="gap:6px;flex-wrap:wrap;align-items:center;margin-top:6px;">
          <span class="sg-lbl">Recolor</span>
          <input type="color" id="recolorClr" value="${rcColor}" style="width:32px;height:24px;border:1px solid var(--border);cursor:pointer;" title="Brand colour to meld into">
          <input type="range" id="recolorStrength" min="0" max="1" step="0.05" value="${rcStrength}" style="flex:1;min-width:80px;" title="Tint strength">
          <button type="button" class="tool-btn" id="recolorApplyBtn" title="Meld this graphic toward the chosen brand colour (keeps its shading)">Apply</button>
          ${l.recolor ? `<button type="button" class="tool-btn" id="recolorResetBtn" title="Restore original colours">&#8634;</button>` : ''}
        </div>`;
    }
  }

  wrap.innerHTML = html;

  // Bind prop inputs
  wrap.querySelectorAll('[data-prop]').forEach(el => {
    const liveTypes = ['range', 'color', 'textarea'];
    const ev = liveTypes.includes(el.type) || el.tagName === 'TEXTAREA' ? 'input' : 'change';
    el.addEventListener(ev, () => {
      const prop = el.dataset.prop;
      const numProps = ['x','y','w','h','fontSize','strokeWidth','radius','dash','opacity','rotation'];
      const boolProps = ['bold','italic','lockAspect'];
      if (boolProps.includes(prop)) l[prop] = el.checked;
      else if (numProps.includes(prop)) l[prop] = parseFloat(el.value) || 0;
      else l[prop] = el.value;
      // Keep sibling controls bound to the same prop in sync (e.g. the rotation
      // slider + number field) without a full re-render of the props panel.
      wrap.querySelectorAll(`[data-prop="${prop}"]`).forEach(other => {
        if (other !== el && other.value !== String(l[prop])) other.value = l[prop];
      });
      render();
    });
  });

  // Reset-rotation button
  const rotReset = wrap.querySelector('[data-rot-reset]');
  if (rotReset) rotReset.addEventListener('click', () => {
    l.rotation = 0;
    wrap.querySelectorAll('[data-prop="rotation"]').forEach(el => { el.value = 0; });
