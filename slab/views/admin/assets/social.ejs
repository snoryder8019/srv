<script src="/js/assetPicker.js?v=<%= Date.now() %>"></script>
<script>
(function(){
'use strict';

// ═══════════════════════════════════════════
//  MOBILE BOTTOM-SHEET PANELS
//  Slides the REAL left/right panels up over the canvas.
//  No cloning, no duplicate IDs, no listener re-binding —
//  the original elements stay in place and keep their handlers.
// ═══════════════════════════════════════════
const sgPanelLeft   = document.getElementById('sgPanelLeft');
const sgPanelRight  = document.getElementById('sgPanelRight');
const sgBackdrop    = document.getElementById('sgSheetBackdrop');

function sgExpandSection(secId) {
  const body = document.getElementById(secId);
  if (!body) return;
  body.classList.remove('collapsed');
  const head = document.querySelector(`.sg-sec-head[data-toggle="${secId}"]`);
  if (head) {
    const arrow = head.querySelector('span:last-child');
    if (arrow) arrow.textContent = '▾';
    // Scroll within the scrollable panel container, not the page.
    const scroller = head.closest('.sg-panel-scroll');
    if (scroller) {
      setTimeout(() => {
        const top = head.offsetTop - scroller.offsetTop - 8;
        scroller.scrollTo({ top, behavior: 'smooth' });
      }, 80);
    }
  }
}

function sgClosePanels() {
  sgPanelLeft?.classList.remove('mob-open');
  sgPanelRight?.classList.remove('mob-open');
  sgBackdrop?.classList.remove('open');
  document.querySelectorAll('.sg-bd-btn').forEach(b => b.classList.remove('active'));
}

function sgOpenPanel(side, sectionId) {
  const panel = side === 'right' ? sgPanelRight : sgPanelLeft;
  const other = side === 'right' ? sgPanelLeft  : sgPanelRight;
  if (!panel) return;
  other?.classList.remove('mob-open');
  panel.classList.add('mob-open');
  sgBackdrop?.classList.add('open');
  if (sectionId) sgExpandSection(sectionId);
  // Highlight the matching dock button(s).
  document.querySelectorAll('.sg-bd-btn').forEach(b => {
    const matchSide = b.dataset.side === side;
    const matchSec  = (b.dataset.section || '') === (sectionId || '');
    b.classList.toggle('active', matchSide && matchSec);
  });
}

document.querySelectorAll('.sg-bd-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const side = btn.dataset.side;
    const sec  = btn.dataset.section || '';
    const panel = side === 'right' ? sgPanelRight : sgPanelLeft;
    const isOpen = panel?.classList.contains('mob-open');
    const isActive = btn.classList.contains('active');
    if (isOpen && isActive) sgClosePanels();
    else sgOpenPanel(side, sec);
  });
});
document.querySelectorAll('.sg-panel-close').forEach(btn => {
  btn.addEventListener('click', sgClosePanels);
});
sgBackdrop?.addEventListener('click', sgClosePanels);

// Close sheets if the viewport grows past the mobile breakpoint
// (e.g. orientation change on tablets) so desktop layout is clean.
window.addEventListener('resize', () => {
  if (window.innerWidth > 820) sgClosePanels();
});

// ═══════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════
let layers = [];
let selId = null;       // primary selection (drives the props panel)
let multiSel = new Set(); // full selection set — group/multi ops act on this
let nextId = 1;
let nextGroup = 1;      // group-id counter for layer grouping
let canvasW = 1080, canvasH = 1080, sizeName = 'ig-post';
let bgColor = '#F5F3EF';
let bgTransparent = false;
let activeColor = '#1C2B4A';
let clientsList = [];
let currentPresetId = null; // id of loaded preset for "update"

// interaction
let drag = null;   // { id, startX, startY, origX, origY }
let resize = null; // { id, startX, startY, origW, origH, origX, origY }
// Crop mode for image layers. `rect` is the live crop box in canvas (display)
// coords within the layer's local/un-rotated space; `cropDrag` tracks the handle
// being dragged. Entering crop suspends normal drag/resize for that layer.
let cropMode = null;  // { id, rect:{x,y,w,h} }
let cropDrag = null;  // { handle, startX, startY, orig:{x,y,w,h} }

const canvas = document.getElementById('sgCanvas');
const ctx = canvas.getContext('2d');

// ═══════════════════════════════════════════
//  PALETTES
// ═══════════════════════════════════════════
const PALETTES = {
  brand:    [], // loaded from brand kit
  modern:   ['#0F0F0F','#1A1A2E','#16213E','#0F3460','#E94560','#ECECEC','#F5F5F5','#533483'],
  warm:     ['#FF6B35','#F7C59F','#EFEFD0','#004E89','#1A659E','#73454E','#D4A373','#FAEDCD'],
  cool:     ['#003459','#007EA7','#00A8E8','#E8F1F2','#0C7489','#119DA4','#3D5A80','#98C1D9'],
  earth:    ['#606C38','#283618','#FEFAE0','#DDA15E','#BC6C25','#8B7355','#CCD5AE','#FAEDCD'],
  pastel:   ['#FFB5A7','#FCD5CE','#F8EDEB','#F9DCC4','#FEC89A','#D8E2DC','#ECE4DB','#FFE5D9'],
  bold:     ['#FF0054','#FFBD00','#00F5D4','#9B5DE5','#F15BB5','#FEE440','#00BBF9','#00F5D4'],
  mono:     ['#000000','#1A1A1A','#333333','#555555','#777777','#999999','#CCCCCC','#FFFFFF'],
};
let currentPalette = [];
let currentBrandKit = null;  // { type, name, colors, fonts, presets }
let buildForType = 'tenant';
let buildForId = null;

// ═══════════════════════════════════════════
//  INIT — load clients into Build For dropdown, then load tenant brand kit
// ═══════════════════════════════════════════
async function initBuildFor() {
  try {
    const data = await fetch('/admin/assets/clients').then(r => r.json());
    clientsList = data.clients || [];
    const sel = document.getElementById('buildForSelect');
    if (clientsList.length) {
      const sep = document.createElement('option');
      sep.disabled = true;
      sep.textContent = '── Clients ──';
      sel.appendChild(sep);
    }
    clientsList.forEach(c => {
      const o = document.createElement('option');
      o.value = 'client:' + c._id;
      o.textContent = c.company ? `${c.name} (${c.company})` : c.name;
      sel.appendChild(o);
    });
  } catch(e) {}
  // Auto-load tenant brand kit on init
  await loadBrandKit('tenant', null);
}
initBuildFor();
loadPresetList();

// Deep link from the asset library "Edit" badge: /admin/assets/social?preset=<id>
(async () => {
  const pid = new URLSearchParams(location.search).get('preset');
  if (!pid) return;
  try {
    const r = await fetch(`/admin/assets/social/presets/${pid}`);
    const data = await r.json();
    if (data.preset) loadPreset(data.preset);
