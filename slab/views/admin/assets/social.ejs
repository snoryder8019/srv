    if (promptEl && data.prompt) promptEl.value = data.prompt;
    if (negEl && data.negative && !negEl.value.trim()) negEl.value = data.negative;
    if (statusEl) statusEl.textContent = 'Prompt drafted — review and Generate.';
    if (finalEl) finalEl.innerHTML = `<strong style="color:var(--gold);">${data.source === 'enriched' ? 'Suggested' : 'Fallback'}:</strong> ${data.prompt.replace(/[<&>]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]))}`;
