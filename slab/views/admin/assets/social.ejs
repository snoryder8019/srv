// ═══════════════════════════════════════════
//  AI BACKGROUND (Stable Diffusion)
// ═══════════════════════════════════════════
async function generateSdBackground(prompt, negPrompt, _ctx) {
  // _ctx allows caller to pass { btn, status } to target the right elements
  // when duplicate IDs exist (mobile overlay clone vs original panel)
  const status = (_ctx && _ctx.status) || document.getElementById('sdStatus');
  const btn    = (_ctx && _ctx.btn)    || document.getElementById('genBgBtn');
  const brandBoostOn = document.getElementById('sdBrandBoost')?.checked !== false;
  if ((!prompt || !prompt.trim()) && !brandBoostOn) {
    if (status) status.textContent = 'Enter a prompt first (or enable Brand boost).';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Generating...';
  status.textContent = 'Calling Stable Diffusion — this takes 10-45s…';
  const genOverlay = window.SlabLoader ? SlabLoader.overlay(canvasArea, 'Generating background…') : null;
  // Tick counter so user knows it's alive
  let elapsed = 0;
  const ticker = setInterval(() => {
    elapsed++;
    status.textContent = `Generating… ${elapsed}s (SD can take up to 45s)`;
  }, 1000);

  const enrich = document.getElementById('sdBrandBoost')?.checked !== false;
  const finalEl = document.getElementById('sdFinalPrompt');
  if (finalEl) finalEl.textContent = '';

  try {
    const r = await fetch('/admin/assets/generate-bg', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prompt: prompt.trim(),
        negative_prompt: negPrompt || 'text, words, letters, watermark, blurry, low quality',
        sizePreset: sizeName,
        enrich,
      }),
    });
    if (!r.ok) {
      const msg = r.status === 403 ? 'Request blocked — try again in a moment'
                : r.status === 500 ? 'Server error — check that the SD service is running'
                : `Request failed (${r.status})`;
      throw new Error(msg);
    }
    const data = await r.json();
    if (!data.success) throw new Error(data.error || 'Generation failed');

    // Show what was actually sent so users see the brand boost in action
    if (finalEl && data.finalPrompt) {
      const tag = data.promptSource === 'enriched' ? 'Brand-boosted' : data.promptSource === 'fallback' ? 'Brand suggestion' : 'Raw';
      finalEl.innerHTML = `<strong style="color:var(--gold);">${tag}:</strong> ${data.finalPrompt.replace(/[<&>]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]))}`;
    }

    // Add as a layer at the bottom of the stack
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      // Remove any existing AI background layer
      layers = layers.filter(l => !l._aiBg);
      const layer = { type:'image', x:0, y:0, w:canvasW, h:canvasH, src:data.url, img, name:'AI Background', _aiBg:true, id:nextId++, visible:true, opacity:1 };
      layers.unshift(layer);
      setSelection(layer.id);
      renderLayerList();
      render();
      status.textContent = 'Background added as layer!';
      setTimeout(() => { status.textContent = ''; }, 3000);
    };
    img.onerror = () => { status.textContent = 'Failed to load generated image.'; };
    img.src = corsSrc(data.url);
  } catch (err) {
    status.textContent = '⚠ ' + err.message;
  } finally {
    clearInterval(ticker);
    if (genOverlay) genOverlay.done();
  }
  if (btn) { btn.disabled = false; btn.textContent = 'Generate Background'; }
  // Also restore any other copies (mobile overlay clone)
  document.querySelectorAll('[id="genBgBtn"]').forEach(b => { b.disabled = false; b.textContent = 'Generate Background'; });
}

document.getElementById('genBgBtn').addEventListener('click', function() {
  // This is the ORIGINAL desktop button — read from the original inputs directly
  const promptEl = document.getElementById('sdPrompt');
