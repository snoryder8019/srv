<%- include('../partials/head', { title: 'Social Media Generator' }) %>
<%- include('../partials/sidebar', { page: 'assets', user: user }) %>

<!-- Resolve the bare "onnxruntime-web" specifier the @imgly/background-removal
     bundle dynamically imports (used by the layer "remove background" tool). -->
<script type="importmap">
{
  "imports": {
    "onnxruntime-web": "/vendor/onnxruntime-web/ort.bundle.min.mjs",
    "onnxruntime-web/webgpu": "/vendor/onnxruntime-web/ort.webgpu.bundle.min.mjs"
  }
}
</script>

<style>
  /* ── LAYOUT ── */
  .sg-layout { display: grid; grid-template-columns: 320px 1fr 340px; gap: 0; height: calc(100vh - 64px); overflow: hidden; }
  .sg-panel { background: var(--surface); display: flex; flex-direction: column; overflow: hidden; }
  .sg-panel-left { border-right: 1px solid var(--border); }
  .sg-panel-right { border-left: 1px solid var(--border); }
  /* min-height: 0 lets this flex child shrink below its content height so the
     pinned Properties box below it stays visible (without it, a long layer list
     pushes Properties past the panel's overflow:hidden edge — cut off & dead). */
  .sg-panel-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: 14px; }
  .sg-panel-head {
    padding: 10px 14px; border-bottom: 1px solid var(--border);
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--slate);
    display: flex; align-items: center; justify-content: space-between;
  }

  /* ── ACCORDION SECTIONS ── */
  .sg-sec { margin-bottom: 2px; }
  .sg-sec-head {
    padding: 8px 0; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--slate); cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--border); user-select: none;
  }
  .sg-sec-head:hover { color: var(--on-surface); }
  .sg-sec-body { padding: 10px 0; }
  .sg-sec-body.collapsed { display: none; }

  /* ── INPUTS ── */
  .sg-input {
    width: 100%; padding: 5px 8px; border: 1.5px solid var(--border);
    border-radius: 2px; font-size: 0.78rem; font-family: 'Jost', sans-serif;
    color: var(--on-surface); background: var(--ivory);
  }
  .sg-input:focus { outline: none; border-color: var(--navy-mid); background: var(--surface); }
  .sg-select {
    width: 100%; padding: 5px 8px; border: 1.5px solid var(--border);
    border-radius: 2px; font-size: 0.78rem; font-family: 'Jost', sans-serif;
    color: #0F1B30; background: #F5F3EF; cursor: pointer;
  }
  .sg-select option { color: #0F1B30; background: #FDFCFA; }
  .sg-select option:disabled { color: #6B7380; background: #E6E1D6; }
  .sg-textarea {
    width: 100%; padding: 6px 8px; border: 1.5px solid var(--border);
    border-radius: 2px; font-size: 0.78rem; font-family: 'Jost', sans-serif;
    color: var(--on-surface); background: var(--ivory);
    min-height: 64px; resize: vertical; line-height: 1.35;
  }
  .sg-textarea:focus { outline: none; border-color: var(--navy-mid); background: var(--surface); }
  .sg-row { display: flex; gap: 6px; align-items: center; margin-bottom: 6px; }
  .sg-col { display: flex; flex-direction: column; gap: 4px; margin-bottom: 6px; }
  .sg-lbl { font-size: 0.6rem; font-weight: 600; color: var(--slate); letter-spacing: 0.06em; min-width: 48px; flex-shrink: 0; }

  /* ── SIZE PRESETS ── */
  .sz-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px; margin-bottom: 8px; }
  .sz-btn {
    padding: 5px 4px; border: 1.5px solid var(--border); border-radius: 2px;
    text-align: center; cursor: pointer; font-size: 0.58rem; font-weight: 600;
    color: var(--slate); background: var(--surface); transition: all 0.1s;
    letter-spacing: 0.04em;
  }
  .sz-btn:hover { border-color: var(--navy-mid); color: var(--navy); }
  .sz-btn.active { background: var(--navy); color: var(--surface); border-color: var(--navy); }

  /* ── TOOL BUTTONS ── */
  .tool-bar { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px; }
  .tool-btn {
    padding: 5px 8px; border: 1.5px solid var(--border); border-radius: 2px;
    font-size: 0.68rem; font-weight: 600; cursor: pointer; background: var(--surface);
    color: var(--slate); transition: all 0.1s;
  }
  .tool-btn:hover { border-color: var(--navy-mid); color: var(--navy); }

  /* ── COLOR PALETTES ── */
  .pal-row { display: flex; gap: 3px; margin-bottom: 6px; flex-wrap: wrap; align-items: center; }
  .pal-label { font-size: 0.55rem; font-weight: 700; color: var(--slate); letter-spacing: 0.1em; text-transform: uppercase; width: 100%; margin-bottom: 2px; }
  .pal-swatch {
    width: 24px; height: 24px; border-radius: 2px; cursor: pointer;
    border: 2px solid transparent; transition: all 0.1s; flex-shrink: 0;
  }
  .pal-swatch:hover { border-color: var(--on-surface); transform: scale(1.15); }
  .pal-swatch.active { border-color: var(--gold); box-shadow: 0 0 0 2px rgba(201,168,72,0.3); }

  /* ── CANVAS AREA ── */
  .sg-canvas-area {
    background: #E8E5DF; display: flex; flex-direction: column;
    align-items: center; justify-content: center; overflow: auto; padding: 20px;
    position: relative;
  }
  .sg-canvas-wrap { position: relative; box-shadow: 0 4px 24px rgba(15,27,48,0.15); }
  /* Checkerboard shows behind canvas when bg is transparent — purely visual */
  .sg-canvas-wrap.is-transparent {
    background-image:
      linear-gradient(45deg, #ccc 25%, transparent 25%),
      linear-gradient(-45deg, #ccc 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #ccc 75%),
      linear-gradient(-45deg, transparent 75%, #ccc 75%);
    background-size: 20px 20px;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0;
  }
  #sgCanvas { display: block; cursor: default; }
  .sg-canvas-info {
    margin-top: 8px; font-size: 0.65rem; color: var(--slate); text-align: center;
  }
  .sg-canvas-actions { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }

  /* ── LAYERS PANEL ── */
  .layer-item {
    display: flex; align-items: center; gap: 6px; padding: 6px 8px;
    border: 1.5px solid transparent; border-radius: 2px; cursor: pointer;
    transition: all 0.1s; font-size: 0.72rem; margin-bottom: 2px;
  }
  .layer-item:hover { background: var(--ivory); }
  .layer-item.active { border-color: var(--gold); background: rgba(201,168,72,0.05); }
  .layer-icon { width: 18px; text-align: center; font-size: 0.7rem; flex-shrink: 0; color: var(--slate); }
  .layer-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--on-surface); font-weight: 500; }
  .layer-actions { display: flex; gap: 2px; flex-shrink: 0; }
  .layer-btn {
    width: 20px; height: 20px; border: none; background: none; cursor: pointer;
    font-size: 0.65rem; color: var(--slate); border-radius: 2px; display: flex;
    align-items: center; justify-content: center;
  }
  .layer-btn:hover { background: var(--border); color: var(--on-surface); }
  .layer-btn.vis-off { opacity: 0.35; }
  .layer-item.primary { border-color: var(--gold); }
  .layer-group-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 1px rgba(0,0,0,0.15); }

  /* ── LAYER PROPS (bottom of right panel) ── */
  .lp-section { padding: 10px 14px; border-top: 1px solid var(--border); }
  .lp-title { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--slate); margin-bottom: 8px; }

  /* Desktop: pin Properties to the bottom of the right panel and give its
     fields their own scroll so the tooling (rotation, font, color rows) never
     gets cut off the bottom. The layer list keeps filling the space above. */
  @media (min-width: 821px) {
    .sg-panel-right #layerProps { flex: 0 0 auto; }
    .sg-panel-right #propsContent { max-height: 46vh; overflow-y: auto; }
  }

  /* ── PRESETS LIST ── */
  .preset-item {
    display: flex; align-items: center; gap: 6px; padding: 6px 8px;
    border: 1.5px solid var(--border); border-radius: 2px; cursor: pointer;
    margin-bottom: 4px; font-size: 0.72rem; transition: all 0.1s;
  }
  .preset-item:hover { border-color: var(--navy-mid); }
  .preset-item .pi-name { flex: 1; font-weight: 500; color: var(--on-surface); }
  .preset-item .pi-size { font-size: 0.6rem; color: var(--slate); }
  .preset-item .pi-del { color: var(--slate); cursor: pointer; font-size: 0.7rem; }
  .preset-item .pi-del:hover { color: #c0392b; }

  /* Drop zone overlay */
  .sg-drop-overlay {
    display: none; position: absolute; inset: 0; z-index: 10;
    background: rgba(201,168,72,0.12); border: 3px dashed var(--gold);
    align-items: center; justify-content: center;
    font-size: 1rem; color: var(--gold); font-weight: 600;
  }
  .sg-drop-overlay.visible { display: flex; }

  /* ── BOTTOM DOCK (mobile) ── */
  .sg-bot-dock {
    display: none; position: fixed; bottom: 0; left: 0; right: 0;
    z-index: 55; background: var(--surface); border-top: 1px solid var(--border);
    padding: 6px 6px calc(6px + env(safe-area-inset-bottom, 0px));
    gap: 4px; align-items: stretch;
    box-shadow: 0 -2px 16px rgba(15,27,48,0.08);
    font-family: 'Jost', sans-serif;
  }
  .sg-bd-btn {
    flex: 1; padding: 8px 4px; border: none; background: transparent;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--slate); cursor: pointer; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 3px; border-radius: 4px;
    transition: all 0.12s; font-family: inherit;
  }
  .sg-bd-btn .ico { font-size: 1.15rem; line-height: 1; }
  .sg-bd-btn:hover, .sg-bd-btn.active { color: var(--navy); background: rgba(28,43,74,0.06); }
  .sg-bd-btn.primary {
    background: var(--gold); color: var(--on-surface);
    box-shadow: 0 1px 3px rgba(201,168,72,0.4);
  }
  .sg-bd-btn.primary:hover, .sg-bd-btn.primary.active { background: var(--gold); color: var(--on-surface); transform: translateY(-1px); }

  /* ── SHEET BACKDROP ── */
  .sg-sheet-backdrop {
    display: none; position: fixed; inset: 0; z-index: 56;
    background: rgba(15,27,48,0.35); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
  }
  .sg-sheet-backdrop.open { display: block; }

  /* ── MOBILE PANEL CLOSE BUTTON ── */
  .sg-panel-close {
    display: none; background: none; border: none; cursor: pointer;
    font-size: 1.5rem; line-height: 1; color: var(--slate); padding: 2px 8px;
    font-family: 'Jost', sans-serif;
  }
  .sg-panel-close:hover { color: var(--on-surface); }

  /* ── RESPONSIVE ── */
  @media (max-width: 1280px) { .sg-layout { grid-template-columns: 300px 1fr 300px; } }
  @media (max-width: 1100px) { .sg-layout { grid-template-columns: 270px 1fr 260px; } }
  @media (max-width: 820px) {
    .sg-bot-dock { display: flex; }
    .sg-layout {
      grid-template-columns: 1fr; grid-template-rows: 1fr;
      height: calc(100vh - 64px); height: calc(100dvh - 64px); overflow: hidden;
    }
    /* Left and right panels become bottom-sheets containing the REAL elements (no cloning). */
    .sg-panel-left, .sg-panel-right {
      position: fixed; left: 0; right: 0; bottom: 0;
      width: 100%; height: 78vh; height: 78dvh; max-height: 720px;
      z-index: 60; transform: translateY(100%);
      transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
      border: none !important;
      border-top-left-radius: 16px; border-top-right-radius: 16px;
      box-shadow: 0 -8px 32px rgba(15,27,48,0.2);
      background: var(--surface);
      will-change: transform;
    }
    .sg-panel-left.mob-open, .sg-panel-right.mob-open { transform: translateY(0); }
    .sg-panel-head {
      padding: 18px 16px 10px; font-size: 0.72rem;
      position: relative;
    }
    .sg-panel-head::before {
      content: ''; position: absolute; top: 7px; left: 50%; transform: translateX(-50%);
      width: 40px; height: 4px; background: var(--border); border-radius: 2px;
    }
    .sg-panel-close { display: inline-block; }
    .sg-panel-scroll { padding: 8px 16px 100px; }
    .sg-sec-head { padding: 12px 0; font-size: 0.7rem; }
    .sg-sec-body { padding: 12px 0; }
    .sg-input, .sg-select { font-size: 0.88rem; padding: 9px 10px; }
    .sg-textarea { font-size: 0.85rem; padding: 9px 10px; min-height: 76px; }
    .tool-btn { padding: 9px 12px; font-size: 0.74rem; }
    .sz-grid { grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
    .sz-btn { padding: 10px 6px; font-size: 0.65rem; }
    .pal-swatch { width: 32px; height: 32px; }
    .sg-lbl { font-size: 0.65rem; min-width: 52px; }
    .lp-section { padding: 14px 16px 100px; }
    .sg-canvas-area {
      display: flex; overflow: auto;
      padding: 10px 10px 70px;
      height: 100%; width: 100%; box-sizing: border-box;
    }
    .sg-canvas-wrap {
      max-width: calc(100vw - 20px);
      max-height: calc(100vh - 160px); max-height: calc(100dvh - 160px);
    }
    .sg-canvas-wrap canvas { max-width: 100%; max-height: 100%; height: auto; width: auto; object-fit: contain; }
    .sg-canvas-info { font-size: 0.65rem; margin-top: 6px; }
    .sg-canvas-actions { margin-top: 8px; }
    .topbar-actions .btn { font-size: 0.62rem; padding: 4px 6px; }
  }
  @media (max-width: 520px) {
    .sg-bd-btn { font-size: 0.55rem; padding: 6px 2px; }
    .sg-bd-btn .ico { font-size: 1rem; }
    .sg-panel-left, .sg-panel-right { height: 82vh; height: 82dvh; }
    .sg-canvas-wrap { max-width: calc(100vw - 16px); }
    .sz-grid { grid-template-columns: 1fr 1fr; }
  }

  /* ── ADDITIONAL MOBILE PATCHES ── */
  @media (max-width: 820px) {
    /* Canvas action buttons (Download PNG / Save to Library) below the canvas must wrap */
    .sg-canvas-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      width: 100%;
      max-width: calc(100vw - 20px);
      box-sizing: border-box;
    }
    .sg-canvas-actions .tool-btn { width: 100%; text-align: center; padding: 10px 8px; font-size: 0.74rem; }

    /* Right panel header: layer-action buttons must wrap on narrow sheets */
    .sg-panel-right .sg-panel-head { flex-wrap: wrap; gap: 6px; padding-top: 22px; }
    .sg-panel-right .sg-panel-head > span:last-child { flex-wrap: wrap; gap: 4px; }

    /* Palette row: let swatches wrap naturally, ensure no overflow */
    .pal-row { flex-wrap: wrap; }

    /* sg-row (label+input combos) in panels: don't let them bleed past panel width */
    .sg-panel-scroll .sg-row { flex-wrap: wrap; }
    .sg-panel-scroll .sg-row .sg-input[style*="width:70px"] { width: 60px !important; }
    .sg-panel-scroll .sg-row .sg-input[style*="width:80px"] { width: 70px !important; }

    /* Tool-bar inside panels: always wrap, 40px min tap targets */
    .sg-panel-scroll .tool-bar { flex-wrap: wrap; }
    .sg-panel-scroll .tool-btn { min-height: 40px; }

    /* AI Background section: Suggest button stays accessible beside textarea */
    #secAiBg > div:first-child { flex-wrap: wrap; }
    #secAiBg > div:first-child .sg-textarea { flex: none; width: 100%; }
    #secAiBg > div:first-child .tool-btn { width: 100%; text-align: center; }

    /* Export section: full-width action buttons */
    #secExport .tool-bar { flex-direction: column; }
    #secExport .tool-bar .tool-btn { width: 100%; text-align: center; padding: 10px 8px; }

    /* Canvas info label: never let it overflow horizontally */
    .sg-canvas-info { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Topbar actions: shrink further on mobile to avoid wrapping behind sidebar hamburger */
    .topbar-actions { gap: 4px; }
    .topbar-actions .btn { font-size: 0.6rem; padding: 4px 5px; }
  }

  @media (max-width: 520px) {
    /* On the smallest phones canvas actions are already column-stacked above;
       add a little extra breathing room at the bottom above the dock */
    .sg-canvas-area { padding: 8px 8px 76px; }

    /* Layer properties panel on phone: ensure all prop rows wrap */
    .lp-section .sg-row { flex-wrap: wrap; }

    /* Size preset grid: 2-col already set above, but ensure buttons are easily tappable */
    .sz-btn { min-height: 44px; font-size: 0.6rem; display: flex; flex-direction: column; align-items: center; justify-content: center; }

    /* Palette active color row: wrap so the Fill/Strk/Txt buttons don't disappear */
    #secPal .sg-row:last-child { flex-wrap: wrap; gap: 4px; }
    #secPal .sg-row:last-child .tool-btn { flex: 1; text-align: center; padding: 8px 4px; }

    /* Quick-prompts chip row in AI BG section: always wrap */
    #sdQuickWrap { flex-wrap: wrap; }
  }
</style>

<div class="topbar">
  <div class="topbar-title">Asset Generator</div>
  <div class="topbar-actions">
    <a href="/admin/assets" class="btn btn-ghost btn-sm">&larr; Assets</a>
    <%# Video Trimmer — disabled for this release %>
    <%# <a href="/admin/assets/trim" class="btn btn-ghost btn-sm">Video Trimmer</a> %>
    <button class="btn btn-gold btn-sm" id="agentToggleBtn">Asset Agent</button>
  </div>
</div>

<div style="padding:0 16px;">
  <%- include('../partials/advisory', { needs: 'ai,s3' }) %>
</div>
<!-- Mobile bottom dock -->
<div class="sg-bot-dock">
  <button class="sg-bd-btn" data-side="left" title="All tools">
    <span class="ico">☰</span><span>Tools</span>
  </button>
  <button class="sg-bd-btn primary" data-side="left" data-section="secAdd" title="Add a layer">
    <span class="ico">+</span><span>Layer</span>
  </button>
  <button class="sg-bd-btn" data-side="left" data-section="secGradBg" title="Gradient background">
    <span class="ico">&#9684;</span><span>Gradient</span>
  </button>
  <button class="sg-bd-btn" data-side="left" data-section="secAiBg" title="AI background">
    <span class="ico">&#10024;</span><span>AI&nbsp;BG</span>
  </button>
  <button class="sg-bd-btn" data-side="left" data-section="secPal" title="Colors">
    <span class="ico">&#9670;</span><span>Color</span>
  </button>
  <button class="sg-bd-btn" data-side="right" title="Layers list">
    <span class="ico">&#9711;</span><span>Layers</span>
  </button>
  <button class="sg-bd-btn" data-side="left" data-section="secExport" title="Export">
    <span class="ico">&#8595;</span><span>Save</span>
  </button>
</div>
<div class="sg-sheet-backdrop" id="sgSheetBackdrop"></div>

<div class="sg-layout">

  <!-- ═══ LEFT PANEL ═══ -->
  <div class="sg-panel sg-panel-left" id="sgPanelLeft">
    <div class="sg-panel-head">
      <span>Tools</span>
      <button class="sg-panel-close" data-close="left" title="Close">&times;</button>
    </div>
    <div class="sg-panel-scroll">

      <!-- SIZE -->
      <div class="sg-sec">
        <div class="sg-sec-head" data-toggle="secSize">Canvas Size <span>▾</span></div>
        <div class="sg-sec-body" id="secSize">
          <div class="sz-grid" id="sizeGrid">
            <div class="sz-btn active" data-w="1080" data-h="1080" data-name="ig-post">IG Post<br>1:1</div>
            <div class="sz-btn" data-w="1080" data-h="1920" data-name="ig-story">Story<br>9:16</div>
            <div class="sz-btn" data-w="1200" data-h="630" data-name="fb-post">FB Post<br>1.9:1</div>
            <div class="sz-btn" data-w="1640" data-h="624" data-name="fb-cover">FB Cover<br>2.6:1</div>
            <div class="sz-btn" data-w="1600" data-h="900" data-name="twitter">X/Twitter<br>16:9</div>
            <div class="sz-btn" data-w="1000" data-h="1500" data-name="pinterest">Pinterest<br>2:3</div>
            <div class="sz-btn" data-w="1280" data-h="720" data-name="yt-thumb">YouTube<br>16:9</div>
            <div class="sz-btn" data-w="1200" data-h="627" data-name="linkedin">LinkedIn<br>1.9:1</div>
            <div class="sz-btn" data-w="1080" data-h="1350" data-name="ig-portrait">IG Port.<br>4:5</div>
          </div>
          <div class="sg-row">
            <span class="sg-lbl">W</span><input type="number" class="sg-input" id="customW" value="1080" style="width:70px;">
            <span class="sg-lbl">H</span><input type="number" class="sg-input" id="customH" value="1080" style="width:70px;">
            <button class="tool-btn" id="applySizeBtn">Set</button>
          </div>
        </div>
      </div>

      <!-- ADD LAYERS -->
      <div class="sg-sec">
        <div class="sg-sec-head" data-toggle="secAdd">Add Layers <span>▾</span></div>
        <div class="sg-sec-body" id="secAdd">
          <div class="tool-bar">
            <button class="tool-btn" id="addImageBtn">+ Image</button>
            <button class="tool-btn" id="addLocalBtn">+ Upload</button>
            <button class="tool-btn" id="addTextBtn">+ Text</button>
            <button class="tool-btn" id="addRectBtn">+ Rect</button>
            <button class="tool-btn" id="addCircBtn">+ Circle</button>
            <button class="tool-btn" id="addLineBtn">+ Line</button>
          </div>
          <div style="font-size:0.65rem;color:var(--slate);">Drag & drop images/videos onto the canvas, or use the buttons above.</div>
          <label style="font-size:0.65rem;display:flex;align-items:center;gap:5px;cursor:pointer;margin-top:6px;color:var(--on-surface);">
            <input type="checkbox" id="autoAlphaImport" checked style="accent-color:var(--gold);">
            Auto-knockout solid background on import (alpha)
          </label>
          <input type="file" id="localFileInput" accept="image/*,video/*" multiple style="display:none;">
        </div>
      </div>

      <!-- BACKGROUND -->
      <div class="sg-sec">
        <div class="sg-sec-head" data-toggle="secBg">Background <span>▸</span></div>
        <div class="sg-sec-body collapsed" id="secBg">
          <div class="sg-row">
            <span class="sg-lbl">Color</span>
