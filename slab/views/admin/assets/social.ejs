const CROP_CURSORS = { nw:'nwse-resize', se:'nwse-resize', ne:'nesw-resize', sw:'nesw-resize', n:'ns-resize', s:'ns-resize', e:'ew-resize', w:'ew-resize', move:'move' };

function drawCropOverlay(l, r) {
  ctx.save();
  applyLayerRotation(ctx, l);
  // Dim everything in the layer box that falls outside the crop rect.
  ctx.beginPath();
  ctx.rect(l.x, l.y, l.w, l.h);
  ctx.rect(r.x, r.y, r.w, r.h);
  ctx.fillStyle = 'rgba(15,27,48,0.55)';
  ctx.fill('evenodd');
  // Crop border
  ctx.strokeStyle = '#C9A848';
  ctx.lineWidth = Math.max(2, canvasW * 0.002);
  ctx.setLineDash([6, 4]);
  ctx.strokeRect(r.x, r.y, r.w, r.h);
  ctx.setLineDash([]);
  // Rule-of-thirds guides
  ctx.strokeStyle = 'rgba(255,255,255,0.4)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let i = 1; i <= 2; i++) {
    ctx.moveTo(r.x + r.w*i/3, r.y); ctx.lineTo(r.x + r.w*i/3, r.y + r.h);
    ctx.moveTo(r.x, r.y + r.h*i/3); ctx.lineTo(r.x + r.w, r.y + r.h*i/3);
  }
  ctx.stroke();
  // Handles
  const hs = cropHandleSize();
  const pts = cropHandlePoints(r);
  ctx.fillStyle = '#C9A848';
  ctx.strokeStyle = '#fff';
  ctx.lineWidth = 1;
  Object.values(pts).forEach(p => {
    ctx.fillRect(p.x - hs/2, p.y - hs/2, hs, hs);
    ctx.strokeRect(p.x - hs/2, p.y - hs/2, hs, hs);
  });
  ctx.restore();
}

function cropHandleAt(l, r, mx, my) {
  const p = toLayerLocal(l, mx, my);          // crop math stays axis-aligned
  const hs = cropHandleSize();
  const pts = cropHandlePoints(r);
  for (const [k, pt] of Object.entries(pts)) {
    if (Math.abs(p.x - pt.x) <= hs && Math.abs(p.y - pt.y) <= hs) return k;
  }
  if (p.x > r.x && p.x < r.x + r.w && p.y > r.y && p.y < r.y + r.h) return 'move';
  return null;
}

function enterCropMode(id) {
  const l = layers.find(x => x.id === id);
  if (!l || l.type !== 'image' || !l.img) return;
  selId = id; multiSel = new Set([id]);
  cropMode = { id, rect: { x: l.x, y: l.y, w: l.w, h: l.h } };
  cropDrag = null;
  renderLayerList(); renderProps(); render();
}

function cancelCrop() {
  if (!cropMode) return;
  cropMode = null; cropDrag = null;
  canvas.style.cursor = 'default';
  renderProps(); render();
}

function applyCrop() {
  if (!cropMode) return;
  const l = layers.find(x => x.id === cropMode.id);
  const r = cropMode.rect;
  if (l && r.w > 4 && r.h > 4) {
    // Source rect currently mapped onto the layer box (full image if uncropped).
    const cur = l.crop || { sx: 0, sy: 0, sw: l.img.naturalWidth, sh: l.img.naturalHeight };
    const fx = (r.x - l.x) / l.w, fy = (r.y - l.y) / l.h;
    const fw = r.w / l.w,         fh = r.h / l.h;
    l.crop = {
      sx: cur.sx + fx * cur.sw, sy: cur.sy + fy * cur.sh,
      sw: fw * cur.sw,          sh: fh * cur.sh,
    };
    l.x = r.x; l.y = r.y; l.w = r.w; l.h = r.h;
  }
