// Append a stable cache-buster to remote URLs loaded onto the canvas. A
// crossOrigin (CORS) request must not reuse a cached *non*-CORS copy of the
// same URL (e.g. the asset-picker thumbnail) — Chromium serves the opaque
// cached response and the load fails ("Could not load image"). A distinct URL
// forces a fresh CORS fetch; same token per page → fetched/cached once.
const _CORS_TOKEN = String(Date.now());
function corsSrc(src) {
  if (!/^https?:/i.test(src || '')) return src;   // blob:/data: are same-origin
  return src + (src.includes('?') ? '&' : '?') + '_cors=' + _CORS_TOKEN;
}

function addImageLayer(src, name) {
  const img = new Image();
  // crossOrigin only for remote URLs; blob:/data: are same-origin and setting
  // it causes load failures in some Chromium builds
  if (/^https?:/i.test(src)) img.crossOrigin = 'anonymous';
  // Spinner over the canvas while a (possibly remote) image downloads. blob:/data:
  // resolve instantly, so only bother wheeling for http(s) sources.
  const loadOverlay = (window.SlabLoader && /^https?:/i.test(src))
    ? SlabLoader.overlay(canvasArea, 'Adding image…') : null;
  img.onload = () => {
    if (loadOverlay) loadOverlay.done();
    const scale = Math.min(canvasW / img.naturalWidth, canvasH / img.naturalHeight, 1);
    const w = img.naturalWidth * scale;
    const h = img.naturalHeight * scale;
    const layer = addLayer({ type:'image', x:(canvasW-w)/2, y:(canvasH-h)/2, w, h, src, img, name: name||'Image', lockAspect: true });
    // Add as alpha where applicable: auto-knockout a solid background on import.
    if (document.getElementById('autoAlphaImport')?.checked && hasSolidBackground(img)) {
      removeLayerBgColor(layer.id, undefined, { silent: true });
    }
  };
  img.onerror = () => { if (loadOverlay) loadOverlay.done(); alert('Could not load image — if it is a remote URL, the host may block cross-origin loading.'); };
  img.src = corsSrc(src);
}
function addVideoLayer(src, name) {
  const vid = document.createElement('video');
  if (/^https?:/i.test(src)) vid.crossOrigin = 'anonymous';
  vid.src = corsSrc(src); vid.muted = true; vid.loop = true; vid.playsInline = true;
  vid.addEventListener('loadedmetadata', () => {
    const scale = Math.min(canvasW/vid.videoWidth, canvasH/vid.videoHeight, 1);
    const w = vid.videoWidth*scale, h = vid.videoHeight*scale;
    const layer = addLayer({ type:'video', x:(canvasW-w)/2, y:(canvasH-h)/2, w, h, src, vid, name: name||'Video', lockAspect: true });
    vid.play().catch(()=>{});
    // continuous render for video
    (function tick(){ if(layers.find(l=>l.id===layer.id)) { render(); requestAnimationFrame(tick); } })();
  });
  vid.addEventListener('error', () => alert('Could not load video'));
}

// ═══════════════════════════════════════════
//  DRAG & DROP onto canvas
// ═══════════════════════════════════════════
const canvasArea = document.getElementById('canvasArea');
const dropOverlay = document.getElementById('dropOverlay');
canvasArea.addEventListener('dragover', e => { e.preventDefault(); dropOverlay.classList.add('visible'); });
canvasArea.addEventListener('dragleave', e => { if(!canvasArea.contains(e.relatedTarget)) dropOverlay.classList.remove('visible'); });
canvasArea.addEventListener('drop', e => {
  e.preventDefault();
  dropOverlay.classList.remove('visible');
  for (const f of e.dataTransfer.files) {
    const url = URL.createObjectURL(f);
    if (f.type.startsWith('video/')) addVideoLayer(url, f.name);
    else if (f.type.startsWith('image/')) addImageLayer(url, f.name);
  }
});

// ═══════════════════════════════════════════
//  ROTATION HELPERS
// ═══════════════════════════════════════════
function layerCenter(l) {
  return { cx: (l.x || 0) + (l.w || 0) / 2, cy: (l.y || 0) + (l.h || 0) / 2 };
}
// Rotate the drawing context around the layer's centre (no-op when rotation 0)
function applyLayerRotation(ctx, l) {
  const rot = l.rotation || 0;
  if (!rot) return;
  const { cx, cy } = layerCenter(l);
  ctx.translate(cx, cy);
  ctx.rotate(rot * Math.PI / 180);
  ctx.translate(-cx, -cy);
}
// Map a canvas-space point into the layer's un-rotated local space, so hit
// testing and resize math can stay axis-aligned even on rotated layers.
function toLayerLocal(l, px, py) {
  const rot = l.rotation || 0;
  if (!rot) return { x: px, y: py };
  const { cx, cy } = layerCenter(l);
  const a = -rot * Math.PI / 180;
  const dx = px - cx, dy = py - cy;
  return { x: cx + dx * Math.cos(a) - dy * Math.sin(a), y: cy + dx * Math.sin(a) + dy * Math.cos(a) };
}

// ═══════════════════════════════════════════
//  RENDER
// ═══════════════════════════════════════════
function render() {
  ctx.clearRect(0, 0, canvasW, canvasH);
  // bg — when transparent, leave the cleared canvas alone so toBlob/toDataURL emit alpha
  if (!bgTransparent) {
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, canvasW, canvasH);
  }

  layers.forEach(l => {
    if (!l.visible) return;
    ctx.save();
    ctx.globalAlpha = l.opacity;
    applyLayerRotation(ctx, l);

    if (l.type === 'image' && l.img) {
      if (l.crop) ctx.drawImage(l.img, l.crop.sx, l.crop.sy, l.crop.sw, l.crop.sh, l.x, l.y, l.w, l.h);
      else ctx.drawImage(l.img, l.x, l.y, l.w, l.h);
    } else if (l.type === 'video' && l.vid) {
      try { ctx.drawImage(l.vid, l.x, l.y, l.w, l.h); } catch(e){}
    } else if (l.type === 'gradient') {
      drawGradientLayer(ctx, l);
    } else if (l.type === 'rect') {
      if (l.fill) { ctx.fillStyle = l.fill; if (l.radius) { roundRect(ctx, l.x, l.y, l.w, l.h, l.radius); ctx.fill(); } else ctx.fillRect(l.x, l.y, l.w, l.h); }
      if (l.stroke && l.strokeWidth) { ctx.strokeStyle = l.stroke; ctx.lineWidth = l.strokeWidth; if (l.radius) { roundRect(ctx, l.x, l.y, l.w, l.h, l.radius); ctx.stroke(); } else ctx.strokeRect(l.x, l.y, l.w, l.h); }
    } else if (l.type === 'circle') {
      const rx = l.w/2, ry = l.h/2;
      ctx.beginPath();
      ctx.ellipse(l.x+rx, l.y+ry, Math.abs(rx), Math.abs(ry), 0, 0, Math.PI*2);
      if (l.fill) { ctx.fillStyle = l.fill; ctx.fill(); }
      if (l.stroke && l.strokeWidth) { ctx.strokeStyle = l.stroke; ctx.lineWidth = l.strokeWidth; ctx.stroke(); }
    } else if (l.type === 'line') {
      ctx.beginPath();
      ctx.moveTo(l.x, l.y);
      ctx.lineTo(l.x + l.w, l.y + (l.h||0));
      ctx.strokeStyle = l.stroke || '#000';
      ctx.lineWidth = l.strokeWidth || 2;
      if (l.dash) ctx.setLineDash([l.dash, l.dash]);
      ctx.stroke();
      ctx.setLineDash([]);
    } else if (l.type === 'text') {
      const fs = l.fontSize || 48;
      ctx.fillStyle = l.color || '#000';
      ctx.font = `${l.bold?'bold ':' '}${l.italic?'italic ':''}${fs}px ${l.fontFamily || 'Jost'}, sans-serif`;
