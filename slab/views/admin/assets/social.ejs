// ═══════════════════════════════════════════
//  LAYERS — DATA
// ═══════════════════════════════════════════
function addLayer(layer) {
  layer.id = nextId++;
  layer.visible = true;
  layer.opacity = layer.opacity ?? 1;
  layers.push(layer);
  setSelection(layer.id);
  renderLayerList();
  render();
  return layer;
}
function selLayer() { return layers.find(l => l.id === selId); }

// ── Selection helpers ──────────────────────────────────────
// multiSel is the source of truth for group/multi-layer ops; selId is the
// "primary" member that drives the properties panel.
function setSelection(id) {           // replace selection (group-aware)
  const l = layers.find(x => x.id === id);
  if (!l) { multiSel = new Set(); selId = null; return; }
  multiSel = new Set(l.group ? layers.filter(x => x.group === l.group).map(x => x.id) : [id]);
  selId = id;
}
function toggleSelection(id) {         // additive (ctrl/shift) toggle
  const l = layers.find(x => x.id === id);
  if (!l) return;
  // toggling a grouped layer toggles the whole group together
  const ids = l.group ? layers.filter(x => x.group === l.group).map(x => x.id) : [id];
  const adding = !multiSel.has(id);
  ids.forEach(i => adding ? multiSel.add(i) : multiSel.delete(i));
  selId = adding ? id : (multiSel.size ? [...multiSel][multiSel.size - 1] : null);
}
function clearSelection() { multiSel = new Set(); selId = null; }
function selectionLayers() { return [...multiSel].map(i => layers.find(l => l.id === i)).filter(Boolean); }

function groupSelected() {
  const ls = selectionLayers();
  if (ls.length < 2) return;
  const g = nextGroup++;
  ls.forEach(l => l.group = g);
  renderLayerList(); renderProps();
}
function ungroupSelected() {
  selectionLayers().forEach(l => delete l.group);
  renderLayerList(); renderProps();
}
function groupColor(g) { return `hsl(${(g * 67) % 360} 70% 55%)`; }

function removeLayer(id) {
  if (cropMode && cropMode.id === id) { cropMode = null; cropDrag = null; }
  layers = layers.filter(l => l.id !== id);
  multiSel.delete(id);
  if (selId === id) selId = multiSel.size ? [...multiSel][multiSel.size - 1] : null;
  renderLayerList();
  render();
}
function removeSelection() {           // delete every selected layer at once
  if (!multiSel.size) return;
  const ids = [...multiSel];
  if (cropMode && ids.includes(cropMode.id)) { cropMode = null; cropDrag = null; }
  layers = layers.filter(l => !multiSel.has(l.id));
  clearSelection();
  renderLayerList(); renderProps(); render();
}

// Clone the whole selection at once, preserving relative positions; if the
// selected layers share a group, the clones get their own new shared group
// (this is the "group clone").
function cloneSelection() {
  const src = selectionLayers();
  if (!src.length) return;
  if (src.length === 1 && !src[0].group) return cloneLayer(src[0].id);
  const groupMap = new Map();
  const copies = src.map(s => {
    const c = { ...s, id: nextId++, x: (s.x || 0) + 24, y: (s.y || 0) + 24, name: (s.name || s.type) + ' copy' };
    if (s.crop) c.crop = { ...s.crop };
    if (s.group != null) {
      if (!groupMap.has(s.group)) groupMap.set(s.group, nextGroup++);
      c.group = groupMap.get(s.group);
    }
    return c;
  });
  const maxIdx = Math.max(...src.map(s => layers.indexOf(s)));
  layers.splice(maxIdx + 1, 0, ...copies);
  multiSel = new Set(copies.map(c => c.id));
  selId = copies[copies.length - 1].id;
  renderLayerList(); renderProps(); render();
  return copies;
}

function cloneLayer(id) {
  const src = layers.find(l => l.id === id);
  if (!src) return;
  // A grouped layer clones its entire group rather than just itself.
  if (src.group != null) { setSelection(id); return cloneSelection(); }
  // Shallow copy; img/vid element refs are shared (a single <img>/<video> can be
  // drawn into the canvas many times, so the clone renders without reloading).
  const copy = {
    ...src,
    id: nextId++,
    x: (src.x || 0) + 24,
    y: (src.y || 0) + 24,
    name: (src.name || src.type) + ' copy',
  };
  if (src.crop) copy.crop = { ...src.crop };
  const idx = layers.findIndex(l => l.id === id);
  layers.splice(idx + 1, 0, copy); // sit directly above the original in the stack
  setSelection(copy.id);
  renderLayerList(); renderProps(); render();
  return copy;
}

// ── Background removal (in-browser, @imgly/background-removal) ──
// Lazy-loaded ESM bundle is self-hosted at /vendor/imgly; the model weights
// stream from imgly's CDN on first use and are then browser-cached.
let _bgRemover = null;
async function getBgRemover() {
  if (!_bgRemover) _bgRemover = import('/vendor/imgly/index.mjs');
  return _bgRemover;
}
async function removeLayerBg(id, btn) {
  const l = layers.find(x => x.id === id);
  if (!l || l.type !== 'image' || !l.img) return;
  if (btn && (btn.disabled || btn._slabBusy)) return;
  const orig = btn ? btn.textContent : '';
  if (btn && window.SlabLoader) { SlabLoader.button(btn, true, ''); btn.title = 'Removing background…'; }
  else if (btn) { btn.disabled = true; btn.textContent = '…'; btn.title = 'Removing background…'; }
  const bgOverlay = window.SlabLoader ? SlabLoader.overlay(canvasArea, 'Removing background…') : null;
  try {
    // Rasterize the already-loaded (CORS-clean) image at natural size so we
    // never re-fetch a remote URL that might block cross-origin.
    const off = document.createElement('canvas');
    off.width = l.img.naturalWidth || l.img.width;
    off.height = l.img.naturalHeight || l.img.height;
    off.getContext('2d').drawImage(l.img, 0, 0);
    const srcBlob = await new Promise(res => off.toBlob(res, 'image/png'));
    if (!srcBlob) throw new Error('Could not read image pixels (image may be cross-origin protected).');

    const { removeBackground } = await getBgRemover();
    const outBlob = await removeBackground(srcBlob, {
      model: 'medium',  // isnet_fp16 — markedly more accurate than 'small' (quint8)
      output: { format: 'image/png' },
      progress: (key, cur, total) => {
        if (btn && /fetch|download/i.test(key) && total) {
          btn.title = `Loading model… ${Math.round((cur/total)*100)}%`;
        }
      },
    });

    const url = URL.createObjectURL(outBlob);
    const cleaned = new Image();
    await new Promise((res, rej) => { cleaned.onload = res; cleaned.onerror = rej; cleaned.src = url; });
    // Revoke a previously-generated object URL so we don't leak blobs.
    if (l._bgUrl) URL.revokeObjectURL(l._bgUrl);
    l.img = cleaned;
    l.src = url;
    l._bgUrl = url;
    if (!/no bg$/i.test(l.name || '')) l.name = (l.name || 'Image') + ' (no bg)';
    renderLayerList(); render();
  } catch (err) {
    console.error('Background removal failed:', err);
    alert('Background removal failed: ' + (err && err.message ? err.message : err));
  } finally {
    if (bgOverlay) bgOverlay.done();
    if (btn && window.SlabLoader && btn._slabBusy) { SlabLoader.button(btn, false); btn.title = 'Remove background'; }
    else if (btn) { btn.disabled = false; btn.textContent = orig || '✂'; btn.title = 'Remove background'; }
  }
}

