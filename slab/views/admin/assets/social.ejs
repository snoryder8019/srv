<script>
(function() {
  'use strict';
  const panel = document.getElementById('agentPanel');
  const toggleBtn = document.getElementById('agentToggleBtn');
  const closeBtn = document.getElementById('agentCloseBtn');
  const messagesEl = document.getElementById('apMessages');
  const inputEl = document.getElementById('apInput');
  const sendBtn = document.getElementById('apSendBtn');
  const quickEl = document.getElementById('apQuick');

  let history = [];
  let sending = false;

  toggleBtn.addEventListener('click', () => panel.classList.toggle('open'));
  closeBtn.addEventListener('click', () => panel.classList.remove('open'));

  function addMessage(role, html) {
    const div = document.createElement('div');
    div.className = `ap-msg ap-msg-${role}`;
    div.innerHTML = html;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  let lastDesign = null;  // store last design for retry
  let lastPrompt = '';

  async function sendMessage(text) {
    if (!text.trim() || sending) return;
    sending = true;
    sendBtn.disabled = true;
    lastPrompt = text;

    addMessage('user', esc(text));
    history.push({ role: 'user', content: text });
    inputEl.value = '';

    const _wheel = window.SlabLoader ? SlabLoader.spinnerHTML() + ' ' : '';
    const loadingEl = addMessage('agent', '<span class="ap-msg-loading">' + _wheel + 'Designing... (SD backgrounds may take 15-45s)</span>');

    try {
      const folder = document.getElementById('exportFolder')?.value || 'clients';
      const clientId = document.getElementById('clientSelect')?.value || '';

      const r = await fetch('/admin/assets/agent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history, mode: 'generate', folder, clientId }),
      });
      // Guard against non-JSON responses. When the AI/SD backend is slow or
      // restarts mid-request, the proxy returns an HTML error page (502/503/504)
      // — blindly calling r.json() then throws the cryptic "Unexpected token '<'".
      const raw = await r.text();
      let data;
      try {
        data = JSON.parse(raw);
      } catch {
        loadingEl.remove();
        throw new Error(
          [502, 503, 504].includes(r.status)
            ? `The design service timed out or was unavailable (HTTP ${r.status}). SD backgrounds can take 15-45s each — please try again.`
            : `Unexpected server response (HTTP ${r.status}). Please try again in a moment.`
        );
      }
      loadingEl.remove();
      if (!r.ok) throw new Error(data.error || `Request failed (HTTP ${r.status})`);

      // Store design for retry/edit
      lastDesign = data.design || null;
      const variations = data.variations || [];

      let replyHtml = esc(data.message || 'Done.');

      if (variations.length > 1) {
        // Multiple variations — show cards
        replyHtml += '<div class="ap-variations">';
        variations.forEach((v, i) => {
          replyHtml += `<div class="ap-var-card" data-idx="${i}">`;
          replyHtml += `<img src="${v.publicUrl}" alt="${esc(v.title)}" loading="lazy">`;
          replyHtml += `<div class="ap-var-label">Option ${i + 1}</div>`;
          replyHtml += `<div class="ap-var-actions">`;
          replyHtml += `<button class="ap-var-btn edit-btn" data-action="edit" data-idx="${i}">Edit Layers</button>`;
          replyHtml += `<button class="ap-var-btn" data-action="copy" data-url="${v.publicUrl}">Copy URL</button>`;
          replyHtml += `</div></div>`;
        });
        replyHtml += '</div>';
      } else if (variations.length === 1) {
        // Single variation
        replyHtml += `<img class="ap-preview" src="${variations[0].publicUrl}" alt="${esc(variations[0].title)}" loading="lazy">`;
        replyHtml += `<div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;">`;
        replyHtml += `<button class="ap-var-btn edit-btn" data-action="edit" data-idx="0">Edit Layers</button>`;
        replyHtml += `<button class="ap-var-btn" data-action="copy" data-url="${variations[0].publicUrl}">Copy URL</button>`;
        replyHtml += `<button class="ap-var-btn" data-action="open" data-url="${variations[0].publicUrl}">Open</button>`;
        replyHtml += `</div>`;
      }

      // Retry button
      replyHtml += `<div style="margin-top:8px;"><button class="ap-var-btn" data-action="retry" style="width:auto;padding:4px 12px;">Retry</button></div>`;

      const msgEl = addMessage('agent', replyHtml);
      history.push({ role: 'assistant', content: data.message || 'Done.' });

      // Auto-load the generated design into the canvas for immediate review —
      // otherwise the agent just saves to the library and the canvas stays empty
      // until the user hunts for "Edit Layers". Loads the first variation; the
      // "Edit Layers" buttons still let them switch to another variation.
      if (lastDesign) {
        const reviewDesign = { ...lastDesign };
        if (variations[0]?.sdBgUrl) reviewDesign.sdBgUrl = variations[0].sdBgUrl;
        window.loadAgentDesign(reviewDesign, { keepPanel: true });
      }

      // Wire up buttons inside this message
      msgEl.querySelectorAll('[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          const idx = parseInt(btn.dataset.idx) || 0;
          if (action === 'edit') {
            // Load into social generator with the correct SD bg for this variation
            if (lastDesign) {
              const editDesign = { ...lastDesign };
              if (variations[idx]?.sdBgUrl) editDesign.sdBgUrl = variations[idx].sdBgUrl;
              window.loadAgentDesign(editDesign);
            }
          } else if (action === 'copy') {
            navigator.clipboard.writeText(btn.dataset.url);
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = 'Copy URL'; }, 1500);
          } else if (action === 'open') {
            window.open(btn.dataset.url, '_blank');
          } else if (action === 'retry') {
            sendMessage(lastPrompt);
          }
        });
      });

    } catch (err) {
      loadingEl.remove();
      addMessage('agent', 'Error: ' + esc(err.message));
    }

    sending = false;
    sendBtn.disabled = false;
  }

  sendBtn.addEventListener('click', () => sendMessage(inputEl.value));
  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(inputEl.value); }
  });

  // Quick prompts
  quickEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.ap-quick-btn');
    if (btn?.dataset.prompt) sendMessage(btn.dataset.prompt);
  });

  function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
})();
</script>
<script>
/* suggestion-loader: open a review-queue draft in the full generator, edit with
   the real design tools, then save the edited image straight back to the post. */
(function(){
  const sid = new URLSearchParams(location.search).get("suggestion");
  if (!sid) return;
  function go(tries){
    if (typeof window.loadAgentDesign !== "function") { if (tries>0) return setTimeout(()=>go(tries-1),150); return; }
    fetch("/admin/social/suggestions/"+sid+"/design").then(r=>r.json()).then(d=>{
      if (d && d.ok && d.design) {
        window.loadAgentDesign(d.design);
        const t = document.getElementById("exportTitle"); if (t && d.body) t.value = String(d.body).replace(/[#\n].*$/s,"").slice(0,40).trim();
      }
    }).catch(()=>{});
    // Reveal the "Save to post" button and wire it to write back to the draft.
    const bar = document.getElementById("saveToPostBar"); if (bar) bar.style.display = "";
    const btn = document.getElementById("saveToPostBtn");
    if (btn && !btn.dataset.wired) {
      btn.dataset.wired = "1";
      btn.addEventListener("click", async () => {
        const status = document.getElementById("exportStatus");
        status.textContent = "Saving to post…";
        let restore = null;
        try {
          // Flatten the canvas like the export buttons do, capture PNG as a blob,
          // and POST as multipart (bypasses the JSON body-size cap).
          if (typeof beginExportRender === "function") restore = beginExportRender();
          const cv = document.getElementById("sgCanvas");
          const blob = await new Promise(res => cv.toBlob(res, "image/png"));
          if (restore) { restore(); restore = null; }
          const fd = new FormData();
          fd.append("image", blob, "edit.png");
          const r = await fetch("/admin/social/suggestions/"+sid+"/image", { method: "POST", body: fd });
          const j = await r.json();
          if (!j.ok) throw new Error(j.error || "Save failed");
          status.textContent = "✓ Saved — returning…";
          setTimeout(() => { location.href = "/admin/social?tab=agents"; }, 700);
        } catch (e) { if (restore) restore(); status.textContent = "⚠ " + e.message; }
      });
    }
  }
  document.addEventListener("DOMContentLoaded", ()=>go(20));
})();
</script>
