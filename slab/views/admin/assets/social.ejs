// ═══════════════════════════════════════════
//  HIT TESTING & MOUSE
// ═══════════════════════════════════════════
function canvasCoords(e) {
  const r = canvas.getBoundingClientRect();
  return { x: (e.clientX - r.left) / r.width * canvasW, y: (e.clientY - r.top) / r.height * canvasH };
}
function hitTest(mx, my) {
  for (let i = layers.length - 1; i >= 0; i--) {
    const l = layers[i];
    if (!l.visible) continue;
    const p = toLayerLocal(l, mx, my); // un-rotate so the test stays axis-aligned
    if (l.type === 'line') {
      // thin rect around line
      const x1=l.x, y1=l.y, x2=l.x+l.w, y2=l.y+(l.h||0);
      const d = distToLine(p.x, p.y, x1, y1, x2, y2);
      if (d < 15) return l;
    } else {
      if (p.x >= l.x && p.x <= l.x+l.w && p.y >= l.y && p.y <= l.y+l.h) return l;
    }
  }
  return null;
}
function distToLine(px,py,x1,y1,x2,y2) {
  const A=px-x1, B=py-y1, C=x2-x1, D=y2-y1;
  const dot=A*C+B*D, len2=C*C+D*D;
  let t = len2 ? dot/len2 : -1;
  t = Math.max(0, Math.min(1, t));
  return Math.hypot(px-(x1+t*C), py-(y1+t*D));
}
function isOnResizeHandle(l, mx, my) {
  const hs = Math.max(14, canvasW*0.015);
  const hx = l.x + l.w, hy = l.y + (l.h||0);
  const p = toLayerLocal(l, mx, my); // handle is drawn in the layer's rotated space
  return Math.abs(p.x-hx) < hs && Math.abs(p.y-hy) < hs;
}

canvas.addEventListener('mousedown', e => {
  const {x,y} = canvasCoords(e);
  // Crop mode swallows all canvas interaction for the layer being cropped.
  if (cropMode) {
    const cl = layers.find(l => l.id === cropMode.id);
    const handle = cl ? cropHandleAt(cl, cropMode.rect, x, y) : null;
    if (handle) cropDrag = { handle, startX: x, startY: y, orig: { ...cropMode.rect } };
    return;
  }
  // check resize handle first
  const sl = selLayer();
  if (sl && isOnResizeHandle(sl, x, y)) {
    const oh = sl.h || 0;
    const start = toLayerLocal(sl, x, y); // work in the layer's local space
    resize = {
      id: sl.id, startX: start.x, startY: start.y,
      origW: sl.w, origH: oh, origX: sl.x, origY: sl.y,
      ratio: oh ? (sl.w / oh) : 1,
    };
    return;
  }
  const hit = hitTest(x, y);
  if (hit) {
    const additive = e.shiftKey || e.metaKey || e.ctrlKey;
    if (additive) toggleSelection(hit.id);
    else if (!multiSel.has(hit.id)) setSelection(hit.id); // clicking inside an existing selection keeps it (drag the group)
    else selId = hit.id;
    // Drag every selected layer together.
    drag = { startX: x, startY: y, items: selectionLayers().map(l => ({ id: l.id, ox: l.x, oy: l.y })) };
    renderLayerList(); renderProps(); render();
  } else {
    clearSelection();
    renderLayerList(); renderProps(); render();
  }
});
canvas.addEventListener('mousemove', e => {
  const {x,y} = canvasCoords(e);
  if (cropMode) {
    const l = layers.find(ly => ly.id === cropMode.id);
    if (!l) return;
    if (cropDrag) {
      const p = toLayerLocal(l, x, y);
      const o = cropDrag.orig, H = cropDrag.handle;
      const bx0 = l.x, by0 = l.y, bx1 = l.x + l.w, by1 = l.y + l.h;
      if (H === 'move') {
        const s = toLayerLocal(l, cropDrag.startX, cropDrag.startY);
        let nx = Math.max(bx0, Math.min(o.x + (p.x - s.x), bx1 - o.w));
        let ny = Math.max(by0, Math.min(o.y + (p.y - s.y), by1 - o.h));
        cropMode.rect = { x: nx, y: ny, w: o.w, h: o.h };
      } else {
        let left = o.x, top = o.y, right = o.x + o.w, bottom = o.y + o.h;
        if (H.includes('w')) left   = Math.max(bx0, Math.min(p.x, right - 20));
        if (H.includes('e')) right  = Math.min(bx1, Math.max(p.x, left + 20));
        if (H.includes('n')) top    = Math.max(by0, Math.min(p.y, bottom - 20));
        if (H.includes('s')) bottom = Math.min(by1, Math.max(p.y, top + 20));
        cropMode.rect = { x: left, y: top, w: right - left, h: bottom - top };
      }
      render();
    } else {
      const handle = cropHandleAt(l, cropMode.rect, x, y);
      canvas.style.cursor = handle ? CROP_CURSORS[handle] : 'default';
    }
    return;
  }
  if (resize) {
    const l = layers.find(l=>l.id===resize.id);
    if (!l) return;
    const p = toLayerLocal(l, x, y); // un-rotate the pointer for correct deltas
    const lockRatio = e.shiftKey || l.lockAspect;
    const newW = Math.max(20, resize.origW + (p.x - resize.startX));
    const newH = Math.max(10, resize.origH + (p.y - resize.startY));
    if (lockRatio && resize.ratio) {
      // pick the dominant axis (whichever moved more, proportionally)
      const dw = Math.abs(newW - resize.origW) / Math.max(1, resize.origW);
      const dh = Math.abs(newH - resize.origH) / Math.max(1, resize.origH);
      if (dw >= dh) { l.w = newW; l.h = newW / resize.ratio; }
      else          { l.h = newH; l.w = newH * resize.ratio; }
    } else {
      l.w = newW; l.h = newH;
    }
    render();
    return;
  }
  if (drag) {
    const dx = x - drag.startX, dy = y - drag.startY;
    drag.items.forEach(it => {
      const l = layers.find(ly => ly.id === it.id);
      if (l) { l.x = it.ox + dx; l.y = it.oy + dy; }
    });
    render();
    return;
  }
  // cursor hint
  const sl = selLayer();
  if (sl && isOnResizeHandle(sl, x, y)) { canvas.style.cursor = 'nwse-resize'; }
  else if (hitTest(x, y)) { canvas.style.cursor = 'move'; }
  else { canvas.style.cursor = 'default'; }
});
canvas.addEventListener('mouseup', () => { drag = null; resize = null; cropDrag = null; if (!cropMode) renderProps(); });
canvas.addEventListener('mouseleave', () => { drag = null; resize = null; cropDrag = null; });

// Keyboard
document.addEventListener('keydown', e => {
  if (cropMode) {
    if (e.key === 'Enter') { e.preventDefault(); applyCrop(); }
    if (e.key === 'Escape') { e.preventDefault(); cancelCrop(); }
    return;
  }
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
  if ((e.key === 'Delete' || e.key === 'Backspace') && multiSel.size) { removeSelection(); }
  if ((e.metaKey || e.ctrlKey) && (e.key === 'd' || e.key === 'D') && multiSel.size) { e.preventDefault(); cloneSelection(); }
  if ((e.metaKey || e.ctrlKey) && (e.key === 'g' || e.key === 'G')) {
    e.preventDefault();
    if (e.shiftKey) ungroupSelected(); else groupSelected();
  }
});

// ═══════════════════════════════════════════
//  LAYER LIST
// ═══════════════════════════════════════════
function renderLayerList() {
  const wrap = document.getElementById('layerList');
  wrap.innerHTML = '';
  // render top-to-bottom = last layer first
  for (let i = layers.length-1; i >= 0; i--) {
    const l = layers[i];
    const icons = {image:'🖼',video:'▷',text:'T',rect:'▬',circle:'●',line:'╱'};
    const div = document.createElement('div');
    div.className = 'layer-item' + (multiSel.has(l.id)?' active':'') + (l.id===selId?' primary':'');
    const groupDot = l.group != null
      ? `<span class="layer-group-dot" title="Group ${l.group}" style="background:${groupColor(l.group)};"></span>` : '';
    div.innerHTML = `
      ${groupDot}
      <span class="layer-icon">${icons[l.type]||'?'}</span>
      <span class="layer-name">${esc(l.name||l.type+(l.text?' "'+l.text.slice(0,12)+'"':''))}</span>
      <span class="layer-actions">
        <button class="layer-btn ${l.visible?'':'vis-off'}" data-vis="${l.id}" title="Toggle visibility">${l.visible?'◉':'◎'}</button>
        <button class="layer-btn" data-clone="${l.id}" title="${l.group!=null?'Clone group':'Clone layer'}">⧉</button>
        ${l.type==='image' ? `<button class="layer-btn" data-bg="${l.id}" title="Remove background">✂</button>` : ''}
        <button class="layer-btn" data-del="${l.id}" title="Delete">✕</button>
      </span>`;
    div.addEventListener('click', e => {
      if (e.target.dataset.vis || e.target.dataset.clone || e.target.dataset.bg || e.target.dataset.del) return;
      if (cropMode && cropMode.id !== l.id) { cropMode = null; cropDrag = null; }
      if (e.shiftKey || e.metaKey || e.ctrlKey) toggleSelection(l.id);
      else setSelection(l.id);
      renderLayerList(); renderProps(); render();
    });
    div.querySelector('[data-vis]').addEventListener('click', () => { l.visible = !l.visible; renderLayerList(); render(); });
    div.querySelector('[data-clone]').addEventListener('click', () => cloneLayer(l.id));
    div.querySelector('[data-bg]')?.addEventListener('click', e => removeLayerBg(l.id, e.currentTarget));
    div.querySelector('[data-del]').addEventListener('click', () => { removeLayer(l.id); renderProps(); });
    wrap.appendChild(div);
  }
}

// Group / ungroup
document.getElementById('groupBtn').addEventListener('click', groupSelected);
document.getElementById('ungroupBtn').addEventListener('click', ungroupSelected);
document.getElementById('patternBtn').addEventListener('click', patternFromSelection);

// Build a seamless repeating pattern from the currently-selected layers and drop
// it in as a single image layer behind the rest of the artwork. The selection's
// bounding box becomes the tile, which is then repeated across the whole canvas.
function patternFromSelection() {
  const sel = selectionLayers();
  if (!sel.length) { alert('Select one or more layers first to build a pattern.'); return; }
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  sel.forEach(l => {
    const lw = l.w || 0, lh = l.h || 0;
    minX = Math.min(minX, l.x); minY = Math.min(minY, l.y);
    maxX = Math.max(maxX, l.x + lw); maxY = Math.max(maxY, l.y + lh);
  });
  const tw = Math.max(1, Math.round(maxX - minX)), th = Math.max(1, Math.round(maxY - minY));

  // Render ONLY the selected layers onto a transparent surface, sans selection
  // chrome, then crop the bounding box out as the tile.
  const prevVis = layers.map(l => l.visible);
  const prevSel = selId, prevMulti = multiSel, prevTrans = bgTransparent;
  const selSet = new Set(sel.map(l => l.id));
  layers.forEach(l => { l.visible = selSet.has(l.id); });
  selId = null; multiSel = new Set(); bgTransparent = true;
  render();
  const tile = document.createElement('canvas');
  tile.width = tw; tile.height = th;
  tile.getContext('2d').drawImage(canvas, minX, minY, tw, th, 0, 0, tw, th);
  // Restore the editor exactly as it was.
  layers.forEach((l, i) => { l.visible = prevVis[i]; });
  selId = prevSel; multiSel = prevMulti; bgTransparent = prevTrans;
  render();

  // Tile across the full canvas → one raster image layer placed at the back.
  const pc = document.createElement('canvas');
  pc.width = canvasW; pc.height = canvasH;
  const pctx = pc.getContext('2d');
  pctx.fillStyle = pctx.createPattern(tile, 'repeat');
  pctx.fillRect(0, 0, canvasW, canvasH);
  pc.toBlob(blob => {
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = () => {
      const layer = { type:'image', x:0, y:0, w:canvasW, h:canvasH, src:url, img,
        name:'Pattern', _patternUrl:url, id:nextId++, visible:true, opacity:1 };
      layers.unshift(layer);          // behind the existing artwork
      setSelection(layer.id);
      renderLayerList(); render();
    };
    img.src = url;
  }, 'image/png');
}

// Layer up/down
document.getElementById('layerUpBtn').addEventListener('click', () => {
  const idx = layers.findIndex(l=>l.id===selId);
  if (idx < 0 || idx >= layers.length-1) return;
  [layers[idx], layers[idx+1]] = [layers[idx+1], layers[idx]];
  renderLayerList(); render();
});
document.getElementById('layerDownBtn').addEventListener('click', () => {
  const idx = layers.findIndex(l=>l.id===selId);
  if (idx < 1) return;
  [layers[idx], layers[idx-1]] = [layers[idx-1], layers[idx]];
  renderLayerList(); render();
});

