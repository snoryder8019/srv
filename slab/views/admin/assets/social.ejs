}
function resetRecolor(id) {
  const l = layers.find(x => x.id === id);
  if (!l || !l._origImg) return;
  if (l._recolorUrl) { URL.revokeObjectURL(l._recolorUrl); l._recolorUrl = null; }
  l.img = l._origImg; l.src = l._origSrc;
  delete l._origImg; delete l._origSrc; delete l.recolor;
