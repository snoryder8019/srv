// Decide whether an image is a subject on a single flat background — i.e. a
// colour-key knockout is "applicable". True only when the border ring is one
// near-uniform colour, the image isn't already transparent, and the centre
// differs from the border (so a subject actually exists).
function hasSolidBackground(img) {
  try {
    const W = 80, H = Math.max(1, Math.round(W * img.naturalHeight / img.naturalWidth));
    const c = document.createElement('canvas'); c.width = W; c.height = H;
    const cx = c.getContext('2d', { willReadFrequently: true });
    cx.drawImage(img, 0, 0, W, H);
    const d = cx.getImageData(0, 0, W, H).data;
    const n = W * H;
    let transparent = 0;
    for (let i = 3; i < d.length; i += 4) if (d[i] < 250) transparent++;
    if (transparent > n * 0.02) return false;   // already has alpha → leave it
    const at = (x, y) => { const i = (y*W + x)*4; return [d[i], d[i+1], d[i+2]]; };
    const ring = [];
    for (let x = 0; x < W; x++) { ring.push(at(x, 0)); ring.push(at(x, H-1)); }
    for (let y = 0; y < H; y++) { ring.push(at(0, y)); ring.push(at(W-1, y)); }
    let mr=0, mg=0, mb=0;
    ring.forEach(p => { mr += p[0]; mg += p[1]; mb += p[2]; });
    mr/=ring.length; mg/=ring.length; mb/=ring.length;
    let maxd = 0;
    ring.forEach(p => { maxd = Math.max(maxd, Math.hypot(p[0]-mr, p[1]-mg, p[2]-mb)); });
    if (maxd > 28) return false;                 // border isn't one flat colour
    const ctr = at(W >> 1, H >> 1);
    return Math.hypot(ctr[0]-mr, ctr[1]-mg, ctr[2]-mb) > 30;  // subject present
  } catch (e) { return false; }
}

// ── Color-key background removal (for solid-colour backdrops) ──
// The @imgly AI model segments a salient subject; it can't target a flat colour.
// This samples the image corners and knocks out pixels near that colour, which
// is what you want for logos/graphics on a single background colour.
function removeLayerBgColor(id, tolerance, opts = {}) {
  const l = layers.find(x => x.id === id);
  if (!l || l.type !== 'image' || !l.img) return;
  const tol = tolerance ?? 48;
  const w = l.img.naturalWidth, h = l.img.naturalHeight;
  const off = document.createElement('canvas');
  off.width = w; off.height = h;
  const octx = off.getContext('2d', { willReadFrequently: true });
  octx.drawImage(l.img, 0, 0);
  let data;
  try { data = octx.getImageData(0, 0, w, h); }
  catch (e) { if (!opts.silent) alert('Cannot read pixels — image is cross-origin protected.'); return; }
  const px = data.data;
  // Key colour = average of the four corner pixels.
  const corners = [0, (w-1)*4, (h-1)*w*4, ((h-1)*w + (w-1))*4];
  let kr=0, kg=0, kb=0;
  corners.forEach(c => { kr+=px[c]; kg+=px[c+1]; kb+=px[c+2]; });
  kr/=4; kg/=4; kb/=4;
  const hard = tol, soft = tol * 2;   // inside hard → transparent, hard..soft → feathered
  for (let i = 0; i < px.length; i += 4) {
    const d = Math.sqrt((px[i]-kr)**2 + (px[i+1]-kg)**2 + (px[i+2]-kb)**2);
    if (d <= hard) px[i+3] = 0;
    else if (d < soft) px[i+3] = Math.round(px[i+3] * (d - hard) / (soft - hard));
  }
  octx.putImageData(data, 0, 0);
  off.toBlob(blob => {
    const url = URL.createObjectURL(blob);
    const cleaned = new Image();
    cleaned.onload = () => {
      if (l._bgUrl) URL.revokeObjectURL(l._bgUrl);
      l.img = cleaned; l.src = url; l._bgUrl = url;
      if (!/no bg$/i.test(l.name || '')) l.name = (l.name || 'Image') + ' (no bg)';
      renderLayerList(); render();
    };
    cleaned.src = url;
  }, 'image/png');
}

// ── Recolor / brand-tint (meld a graphic toward a brand colour) ──
// Luminance-preserving HSL colorize: keeps the graphic's shading/tonal range
// but swaps hue+saturation to the brand colour, blended by `strength` (0..1).
// Non-destructive — the untouched image is parked on `l._origImg` so the tint
// can be re-adjusted or reset. Alpha is preserved (works on knockouts too).
function _hexToRgb(hex) {
