<%
  /* Shared superadmin topbar + nav strip.
     Usage:  include('../partials/nav', { active: 'delegates', user })  [wrap in EJS raw-output tags]
     Params: active   — key of the current section (highlights the link)
             user     — { email } (optional)
             subtitle — small label beside the logo (optional)
     Self-contained styles (scoped .sanav-*) so it drops into any page. */
  var navActive = (typeof active !== 'undefined') ? active : '';
  var navUser = (typeof user !== 'undefined') ? user : null;
  var navSub = (typeof subtitle !== 'undefined') ? subtitle : '';
  var SA_LINKS = [
    { k:'dashboard',   label:'⌂ Dashboard',        href:'/superadmin' },
    { k:'users',       label:'👥 Users',            href:'/superadmin/users' },
    { k:'tickets',     label:'🎫 Tickets',          href:'/superadmin/all-tickets' },
    { k:'setup',       label:'⚡ Setup Requests',    href:'/superadmin/setup-requests' },
    { k:'activity',    label:'✎ Activity',          href:'/superadmin/activity' },
    { k:'signups',     label:'📈 Signups',          href:'/superadmin/signups' },
    { k:'delegates',   label:'🤝 Delegates',        href:'/delegates/admin' },
    { k:'scan',        label:'🔍 Scan Reports',      href:'/superadmin/scan-reports' },
    { k:'security',    label:'🛡 Security',          href:'/superadmin/security' },
    { k:'permissions', label:'🔒 Permissions',      href:'/superadmin/permissions' },
    { k:'features',    label:'🧪 Feature Visibility', href:'/superadmin/features' },
    { k:'subscribers', label:'📬 Subscribers',      href:'/superadmin/subscribers' },
    { k:'promos',      label:'🎁 Promos',           href:'/superadmin/promos' },
    { k:'announce',    label:'📣 Announcements',     href:'/superadmin/announcements' },
    { k:'seo',         label:'🔎 SEO',              href:'/superadmin/seo' },
    { k:'tokens',      label:'✦ Token Analytics',   href:'/superadmin/token-analytics' },
    { k:'control',     label:'🖥 Control Center',    href:'/superadmin/control-center', blank:true },
  ];
%>
<style>
  .sanav-topbar { background:#141414; border-bottom:1px solid #262626; padding:12px 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; gap:16px; flex-wrap:wrap; }
  .sanav-left { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
  .sanav-logo { font-size:18px; font-weight:600; color:#fff; font-family:'Space Grotesk','Inter',sans-serif; letter-spacing:.04em; }
  .sanav-logo span { color:#c9a848; }
  .sanav-sub { font-size:11px; color:#525252; letter-spacing:1.5px; text-transform:uppercase; }
  .sanav-right { display:flex; align-items:center; gap:14px; font-size:12px; color:#737373; }
  .sanav-right a { color:#a3a3a3; text-decoration:none; }
  .sanav-right a:hover { color:#c9a848; }
  .sanav-strip { background:#111; border-bottom:1px solid #262626; padding:8px 24px; display:flex; gap:6px; flex-wrap:wrap; position:sticky; top:49px; z-index:99; }
  .sanav-strip a { padding:5px 12px; font-size:12px; border-radius:6px; border:1px solid #262626; background:#141414; color:#a3a3a3; text-decoration:none; transition:all .15s; white-space:nowrap; }
  .sanav-strip a:hover { border-color:#c9a848; color:#c9a848; }
  .sanav-strip a.on { border-color:#c9a848; color:#0a0a0a; background:#c9a848; font-weight:600; }
</style>

<div class="sanav-topbar">
  <div class="sanav-left">
    <div class="sanav-logo">mad<span>Labs</span>lab</div>
    <span class="sanav-sub">Superadmin<%= navSub ? ' · ' + navSub : '' %></span>
  </div>
  <div class="sanav-right">
    <% if (navUser && navUser.email) { %><span><%= navUser.email %></span><% } %>
    <a href="/superadmin/logout">Logout</a>
  </div>
</div>

<div class="sanav-strip">
  <% SA_LINKS.forEach(function(l){ %>
    <a href="<%= l.href %>"<%= l.blank ? ' target="_blank"' : '' %> class="<%= navActive === l.k ? 'on' : '' %>"><%= l.label %></a>
  <% }); %>
</div>
