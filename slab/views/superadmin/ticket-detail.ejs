<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket Detail — Superadmin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',sans-serif; background:#0a0a0a; color:#e5e5e5; min-height:100vh; }
    .topbar { background:#141414; border-bottom:1px solid #262626; padding:14px 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
    .topbar-left { display:flex; align-items:center; gap:16px; }
    .logo { font-size:18px; font-weight:500; color:#fff; font-family:'Space Grotesk',sans-serif; letter-spacing:0.05em; } .logo span { color:#c9a848; }
    .topbar-right { display:flex; align-items:center; gap:16px; font-size:13px; }
    .topbar-right a { color:#a3a3a3; text-decoration:none; font-size:12px; } .topbar-right a:hover { color:#c9a848; }
    .container { max-width:820px; margin:0 auto; padding:24px; }
    .ticket-header { background:#141414; border:1px solid #262626; border-radius:8px; padding:20px; margin-bottom:20px; }
    .ticket-subject { font-size:18px; font-weight:600; color:#fff; margin-bottom:4px; }
    .ticket-number { font-size:12px; color:#525252; font-family:'Space Grotesk',monospace; margin-bottom:10px; }
    .ticket-meta { display:flex; gap:16px; flex-wrap:wrap; font-size:12px; color:#737373; align-items:center; }
    .ticket-meta span { display:flex; align-items:center; gap:4px; }
    .status, .pill { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:500; }
    .status-escalated { background:#451a1a; color:#fca5a5; }
    .status-resolved { background:#14532d; color:#86efac; }
    .status-open { background:#422006; color:#fdba74; }
    .status-in-progress { background:#1e3a5f; color:#7dd3fc; }
    .status-closed { background:#262626; color:#a3a3a3; }
    .pill-critical { background:#450a0a; color:#fca5a5; }
    .pill-high { background:#422006; color:#fdba74; }
    .pill-medium { background:#1e293b; color:#94a3b8; }
    .pill-low { background:#262626; color:#a3a3a3; }
    .pill-cat { background:#1a1a1a; color:#a3a3a3; border:1px solid #333; }
    .section-label { font-size:11px; text-transform:uppercase; letter-spacing:0.8px; color:#737373; margin-bottom:8px; }
    .ticket-body { background:#141414; border:1px solid #262626; border-radius:8px; padding:20px; margin-bottom:20px; font-size:14px; line-height:1.6; white-space:pre-wrap; }
    .attachments { display:flex; flex-wrap:wrap; gap:12px; }
    .attachments a { display:block; text-decoration:none; }
    .attachments img { max-width:200px; max-height:150px; border:1px solid #262626; border-radius:6px; }
    .att-file { padding:10px 14px; background:#0a0a0a; border:1px solid #333; border-radius:6px; font-size:12px; color:#a3a3a3; }
    .card { background:#141414; border:1px solid #262626; border-radius:8px; padding:20px; margin-bottom:20px; }
    /* System snapshot */
    .snap { background:#0f0f0f; border:1px solid #262626; border-radius:8px; margin-bottom:20px; overflow:hidden; }
    .snap-head { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; cursor:pointer; background:#141414; }
    .snap-head h3 { font-size:13px; font-weight:500; color:#fbbf24; letter-spacing:0.04em; text-transform:uppercase; }
    .snap-head .chev { color:#525252; font-size:12px; }
    .snap-body { padding:0 18px 16px; }
    .snap-grid { display:grid; grid-template-columns:110px 1fr; gap:6px 12px; font-size:12px; margin:12px 0; }
    .snap-grid dt { color:#737373; } .snap-grid dd { color:#d1d5db; word-break:break-all; }
    .snap-log { margin-top:12px; }
    .snap-log summary { cursor:pointer; font-size:12px; color:#a3a3a3; padding:6px 0; }
    .snap-log summary:hover { color:#c9a848; }
    .snap-log pre { background:#000; border:1px solid #1f1f1f; border-radius:6px; padding:12px; font-size:11px; line-height:1.45; color:#9ca3af; overflow-x:auto; max-height:320px; overflow-y:auto; white-space:pre; font-family:ui-monospace,'SF Mono',Menlo,monospace; }
    .snap-log pre.err { color:#fca5a5; }
    .snap-empty { color:#525252; font-size:12px; font-style:italic; padding:8px 0; }
    .replies { margin-bottom:20px; }
    .reply { background:#141414; border:1px solid #262626; border-radius:8px; padding:16px; margin-bottom:10px; }
    .reply-header { display:flex; justify-content:space-between; margin-bottom:8px; font-size:12px; }
    .reply-author { color:#c9a848; font-weight:500; }
    .reply-time { color:#525252; }
    .reply-body { font-size:13px; line-height:1.5; white-space:pre-wrap; }
    .reply-form h3 { font-size:14px; font-weight:500; color:#a3a3a3; margin-bottom:10px; }
    textarea, input[type=text] { width:100%; background:#0a0a0a; border:1px solid #333; border-radius:6px; padding:10px; color:#e5e5e5; font-family:'Inter',sans-serif; font-size:13px; }
    textarea { min-height:100px; resize:vertical; }
    textarea:focus, input[type=text]:focus { border-color:#c9a848; outline:none; }
    .btn { padding:8px 16px; font-size:13px; border-radius:6px; border:1px solid #333; background:transparent; color:#a3a3a3; cursor:pointer; font-family:'Inter',sans-serif; text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
    .btn:hover { border-color:#c9a848; color:#c9a848; }
    .btn-gold { background:#c9a848; color:#0a0a0a; border-color:#c9a848; font-weight:600; } .btn-gold:hover { background:#b8960b; }
    .btn-green { background:#14532d; color:#86efac; border-color:#14532d; } .btn-green:hover { background:#166534; }
    .btn-red { background:#451a1a; color:#fca5a5; border-color:#451a1a; } .btn-red:hover { background:#7f1d1d; }
    .actions { display:flex; gap:8px; flex-wrap:wrap; }
    /* AI agent */
    .agent-panel { background:#0f1a2c; border:1px solid #1e3a5f; border-radius:8px; padding:18px; margin-bottom:18px; }
    .agent-panel h3 { font-size:13px; font-weight:500; color:#7dd3fc; margin-bottom:4px; letter-spacing:0.04em; text-transform:uppercase; }
    .agent-panel .hint { font-size:11px; color:#64748b; margin-bottom:10px; }
    .agent-actions { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px; }
    .agent-btn { padding:7px 14px; font-size:12px; border-radius:6px; border:1px solid #1e3a5f; background:#0a0a0a; color:#7dd3fc; cursor:pointer; font-family:'Inter',sans-serif; }
    .agent-btn:hover { border-color:#38bdf8; color:#38bdf8; }
    .agent-btn.diag { border-color:#7c3aed; color:#c4b5fd; }
    .agent-btn.diag:hover { border-color:#a78bfa; color:#ddd6fe; }
    .agent-btn:disabled { opacity:0.6; cursor:wait; }
    .agent-out { background:#0a0a0a; border:1px solid #262626; border-radius:6px; padding:12px; font-size:13px; line-height:1.5; min-height:40px; color:#d1d5db; white-space:pre-wrap; }
    .agent-out.empty { color:#525252; font-style:italic; }
    .agent-use { margin-top:8px; }
    /* Diagnosis structured render */
    .diag-card { background:#0a0a0a; border:1px solid #3b2a63; border-radius:6px; padding:14px; margin-top:10px; }
    .diag-row { margin-bottom:10px; } .diag-row:last-child { margin-bottom:0; }
    .diag-row .k { font-size:10px; text-transform:uppercase; letter-spacing:0.8px; color:#8b5cf6; margin-bottom:3px; }
    .diag-row .v { font-size:13px; color:#e5e5e5; line-height:1.5; }
    .diag-files { display:flex; flex-wrap:wrap; gap:6px; }
    .diag-files code { background:#1a1030; border:1px solid #3b2a63; border-radius:4px; padding:2px 7px; font-size:11px; color:#c4b5fd; }
    .conf { font-size:11px; padding:2px 8px; border-radius:10px; }
    .conf-high { background:#14532d; color:#86efac; } .conf-medium { background:#422006; color:#fdba74; } .conf-low { background:#450a0a; color:#fca5a5; }
    /* Handoff banner */
    .handoff-banner { background:#161029; border:1px solid #3b2a63; border-radius:8px; padding:16px 18px; margin-bottom:20px; }
    .handoff-banner .hb-top { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
    .handoff-banner h3 { font-size:13px; color:#c4b5fd; text-transform:uppercase; letter-spacing:0.04em; }
    @media (max-width:768px) {
      .topbar { padding:10px 14px; flex-wrap:wrap; gap:8px; }
      .container { padding:14px; }
      .snap-grid { grid-template-columns:1fr; gap:2px 0; }
      .snap-grid dt { margin-top:6px; }
      .actions { flex-direction:column; } .actions form { width:100%; } .actions .btn { width:100%; justify-content:center; }
    }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-left">
      <div class="logo">mad<span>Labs</span>lab</div>
      <span style="color:#737373; font-size:13px;">/ <a href="/superadmin/tickets" style="color:#737373; text-decoration:none;">Tickets</a> / Detail</span>
    </div>
    <div class="topbar-right">
      <a href="/superadmin/fix-handoffs">Fix Queue</a>
      <a href="/superadmin/tickets">&larr; All Tickets</a>
    </div>
  </div>

  <%
    const desc = ticket.description || ticket.body || '';
    const from = ticket.submittedBy?.displayName || ticket.submittedBy?.email || ticket.author?.displayName || ticket.author?.email || '—';
    const st = ticket.status || 'open';
    const prio = ticket.priority || 'medium';
    const cat = ticket.category || 'other';
    const isBug = ['bug', 'error'].includes(String(cat).toLowerCase());
    const d = ticket.debugData || null;
    const consoleErrs = Array.isArray(d?.consoleErrors) ? d.consoleErrors : [];
    const hasServerLogs = d && ((d.tmuxLog && d.tmuxLog !== '[not available]') || (d.apacheErrorLog && d.apacheErrorLog !== '[not available]') || (d.apacheAccessLog && d.apacheAccessLog !== '[not available]'));
  %>

  <div class="container">
    <div class="ticket-header">
      <div class="ticket-subject"><%= ticket.subject || '(no subject)' %></div>
      <% if (ticket.ticketNumber) { %><div class="ticket-number"><%= ticket.ticketNumber %></div><% } %>
      <div class="ticket-meta">
        <span>Tenant: <strong style="color:#c9a848;"><%= tenantDbName %></strong></span>
        <span>From: <%= from %></span>
        <span class="status status-<%= st %>"><%= st %></span>
        <span class="pill pill-<%= prio %>"><%= prio %></span>
        <span class="pill pill-cat"><%= cat %></span>
        <span>Created: <%= ticket.createdAt ? new Date(ticket.createdAt).toLocaleString() : '—' %></span>
      </div>
    </div>

    <% if (handoff) { %>
      <div class="handoff-banner">
        <div class="hb-top">
          <h3>⚑ Fix Handoff — <span id="hbStatusLabel" class="status status-<%= handoff.status === 'in-progress' ? 'in-progress' : handoff.status === 'done' ? 'resolved' : 'open' %>"><%= handoff.status %></span></h3>
          <div style="display:flex; gap:6px;">
            <button class="btn" data-hb-status="queued" type="button">Queued</button>
            <button class="btn" data-hb-status="in-progress" type="button">In progress</button>
            <button class="btn btn-green" data-hb-status="done" type="button">Done</button>
          </div>
        </div>
        <% if (handoff.diagnosis) { %>
          <div class="diag-card" style="margin-top:12px;">
            <% if (handoff.diagnosis.rootCause) { %><div class="diag-row"><div class="k">Root cause</div><div class="v"><%= handoff.diagnosis.rootCause %></div></div><% } %>
            <% if (handoff.diagnosis.area) { %><div class="diag-row"><div class="k">Area</div><div class="v"><%= handoff.diagnosis.area %></div></div><% } %>
            <% if (Array.isArray(handoff.diagnosis.filesToCheck) && handoff.diagnosis.filesToCheck.length) { %>
              <div class="diag-row"><div class="k">Files to check</div><div class="v diag-files"><% handoff.diagnosis.filesToCheck.forEach(f => { %><code><%= f %></code><% }) %></div></div>
            <% } %>
            <% if (handoff.diagnosis.reproSteps) { %><div class="diag-row"><div class="k">Repro</div><div class="v"><%= handoff.diagnosis.reproSteps %></div></div><% } %>
            <% if (handoff.diagnosis.suggestedFix) { %><div class="diag-row"><div class="k">Suggested fix</div><div class="v"><%= handoff.diagnosis.suggestedFix %></div></div><% } %>
            <% if (handoff.diagnosis.confidence) { %><div class="diag-row"><div class="k">Confidence</div><div class="v"><span class="conf conf-<%= handoff.diagnosis.confidence %>"><%= handoff.diagnosis.confidence %></span></div></div><% } %>
          </div>
        <% } %>
        <% if (handoff.notes) { %><div class="diag-row" style="margin-top:10px;"><div class="k">Notes</div><div class="v" style="white-space:pre-wrap;"><%= handoff.notes %></div></div><% } %>
      </div>
    <% } %>

    <% if (desc) { %>
      <div class="section-label">Description</div>
      <div class="ticket-body"><%= desc %></div>
    <% } %>

    <% if (ticket.attachments && ticket.attachments.length) { %>
      <div class="card">
        <div class="section-label">Attachments</div>
        <div class="attachments">
          <% ticket.attachments.forEach(a => { %>
            <a href="<%= a.url %>" target="_blank" rel="noopener">
              <% if (a.type && a.type.startsWith('image/')) { %>
                <img src="<%= a.url %>" alt="<%= a.name %>">
              <% } else { %>
                <div class="att-file"><%= a.name || 'attachment' %></div>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- System Snapshot -->
    <div class="snap">
      <div class="snap-head" id="snapHead">
        <h3>🩺 System Snapshot <% if (consoleErrs.length) { %><span class="pill pill-critical" style="margin-left:6px;"><%= consoleErrs.length %> console err</span><% } %></h3>
        <span class="chev" id="snapChev">▸ show</span>
      </div>
      <div class="snap-body" id="snapBody" style="display:none;">
        <% if (!d) { %>
          <div class="snap-empty">No system snapshot was captured with this ticket.</div>
        <% } else { %>
          <dl class="snap-grid">
            <dt>Captured</dt><dd><%= d.capturedAt || '—' %></dd>
            <dt>URL</dt><dd><% if (d.currentUrl) { %><a href="<%= d.currentUrl %>" target="_blank" rel="noopener" style="color:#7dd3fc;"><%= d.currentUrl %></a><% } else { %>—<% } %></dd>
            <dt>User-Agent</dt><dd><%= d.userAgent || '—' %></dd>
            <dt>Screen</dt><dd><%= d.screenSize || '—' %></dd>
          </dl>
          <% if (consoleErrs.length) { %>
            <div class="snap-log">
              <div class="section-label" style="color:#fca5a5;">Console errors (<%= consoleErrs.length %>)</div>
              <pre class="err"><% consoleErrs.forEach(e => { %><%= (typeof e === 'string' ? e : JSON.stringify(e, null, 2)) %>
<% }) %></pre>
            </div>
          <% } %>
          <% if (d.apacheErrorLog && d.apacheErrorLog !== '[not available]') { %>
            <details class="snap-log"><summary>Apache error log</summary><pre class="err"><%= d.apacheErrorLog %></pre></details>
          <% } %>
          <% if (d.tmuxLog && d.tmuxLog !== '[not available]') { %>
            <details class="snap-log"><summary>Server log / tmux scrollback</summary><pre><%= d.tmuxLog %></pre></details>
          <% } %>
          <% if (d.apacheAccessLog && d.apacheAccessLog !== '[not available]') { %>
            <details class="snap-log"><summary>Apache access log</summary><pre><%= d.apacheAccessLog %></pre></details>
          <% } %>
          <% if (!consoleErrs.length && !hasServerLogs) { %>
            <div class="snap-empty">Client context only — no console errors or server logs captured.</div>
          <% } %>
        <% } %>
      </div>
    </div>

    <% if (ticket.replies && ticket.replies.length) { %>
      <div class="replies">
        <h3 style="font-size:14px; font-weight:500; color:#a3a3a3; margin-bottom:12px;">Replies (<%= ticket.replies.length %>)</h3>
        <% ticket.replies.forEach(r => { %>
          <div class="reply">
            <div class="reply-header">
              <span class="reply-author"><%= r.author?.displayName || r.author?.email || 'Unknown' %></span>
              <span class="reply-time"><%= r.createdAt ? new Date(r.createdAt).toLocaleString() : '' %></span>
            </div>
            <div class="reply-body"><%= r.body %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- AI Agent -->
    <div class="agent-panel">
      <h3>AI Agent</h3>
      <div class="hint">
        <% if (isBug) { %>Diagnosis reads the full system snapshot and runs on the platform (madladslab) Claude key.
        <% } else { %>This is a <strong><%= cat %></strong> ticket — use Summarize / Draft reply. Reclassify to <em>bug</em> to enable code diagnosis + fix handoff.<% } %>
      </div>
      <div class="agent-actions">
        <% if (isBug) { %><button class="agent-btn diag" data-action="diagnose" type="button">🩺 Diagnose</button><% } %>
        <button class="agent-btn" data-action="summarize" type="button">Summarize thread</button>
        <button class="agent-btn" data-action="reply" type="button">Draft reply</button>
        <button class="agent-btn" data-action="classify" type="button">Classify</button>
      </div>
      <div id="agentOut" class="agent-out empty">Click an action above. Output appears here.</div>
      <div id="diagWrap" style="display:none;">
        <div id="diagCard" class="diag-card"></div>
        <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
          <button id="saveHandoff" type="button" class="btn btn-gold">⚑ Save as fix handoff</button>
          <span id="handoffMsg" style="font-size:12px; color:#86efac; align-self:center;"></span>
        </div>
      </div>
      <div class="agent-use" id="agentUse" style="display:none;">
        <button id="useDraft" type="button" class="btn btn-gold">Use as reply →</button>
        <div style="margin-top:8px; display:flex; gap:6px;">
          <input id="reviseInput" type="text" placeholder="Revise: warmer, shorter, add a timeframe…" style="font-size:12px;">
          <button id="reviseBtn" type="button" class="btn">Revise</button>
        </div>
      </div>
    </div>

    <div class="card reply-form">
      <h3>Reply</h3>
      <form method="POST" action="/superadmin/tickets/<%= tenantDbName %>/<%= ticket._id %>/reply">
        <textarea name="body" id="replyBody" placeholder="Type your reply..." required></textarea>
        <div style="margin-top:10px; display:flex; align-items:center; gap:14px;">
          <label style="font-size:12px; color:#a3a3a3; display:inline-flex; align-items:center; gap:6px;">
            <input type="checkbox" name="notify" value="on" checked> Email the tenant
          </label>
          <button type="submit" class="btn btn-gold">Send Reply</button>
        </div>
      </form>
    </div>

    <div class="actions">
      <% if (ticket.status !== 'resolved') { %>
        <form method="POST" action="/superadmin/tickets/<%= tenantDbName %>/<%= ticket._id %>/resolve" style="display:inline;">
          <button type="submit" class="btn btn-green">Resolve</button>
        </form>
      <% } %>
      <form method="POST" action="/superadmin/tickets/<%= tenantDbName %>/<%= ticket._id %>/de-escalate" style="display:inline;">
        <button type="submit" class="btn btn-red">De-escalate</button>
      </form>
    </div>
  </div>

  <script>
    (function() {
      var base = '/superadmin/tickets/<%= tenantDbName %>/<%= ticket._id %>';
      var out = document.getElementById('agentOut');
      var useWrap = document.getElementById('agentUse');
      var diagWrap = document.getElementById('diagWrap');
      var diagCard = document.getElementById('diagCard');
      var replyBody = document.getElementById('replyBody');
      var lastDraft = '', lastDiagnosis = null;

      // Snapshot toggle
      var snapHead = document.getElementById('snapHead'), snapBody = document.getElementById('snapBody'), snapChev = document.getElementById('snapChev');
      snapHead.addEventListener('click', function() {
        var open = snapBody.style.display !== 'none';
        snapBody.style.display = open ? 'none' : 'block';
        snapChev.textContent = open ? '▸ show' : '▾ hide';
      });

      function esc(s) { var p = document.createElement('span'); p.textContent = s == null ? '' : String(s); return p.innerHTML; }

      function renderDiagnosis(dg) {
        var rows = '';
        if (dg.rootCause) rows += '<div class="diag-row"><div class="k">Root cause</div><div class="v">' + esc(dg.rootCause) + '</div></div>';
        if (dg.area) rows += '<div class="diag-row"><div class="k">Area</div><div class="v">' + esc(dg.area) + '</div></div>';
        if (Array.isArray(dg.filesToCheck) && dg.filesToCheck.length) {
          rows += '<div class="diag-row"><div class="k">Files to check</div><div class="v diag-files">' + dg.filesToCheck.map(function(f){ return '<code>' + esc(f) + '</code>'; }).join('') + '</div></div>';
        }
        if (dg.reproSteps) rows += '<div class="diag-row"><div class="k">Repro</div><div class="v">' + esc(dg.reproSteps) + '</div></div>';
        if (dg.suggestedFix) rows += '<div class="diag-row"><div class="k">Suggested fix</div><div class="v">' + esc(dg.suggestedFix) + '</div></div>';
        if (dg.confidence) rows += '<div class="diag-row"><div class="k">Confidence</div><div class="v"><span class="conf conf-' + esc(dg.confidence) + '">' + esc(dg.confidence) + '</span></div></div>';
        diagCard.innerHTML = rows || '<div class="v">' + esc(JSON.stringify(dg)) + '</div>';
      }

      document.querySelectorAll('.agent-btn').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var action = btn.dataset.action;
          btn.disabled = true;
          out.classList.remove('empty');
          out.textContent = action === 'diagnose' ? 'Diagnosing (reading snapshot)…' : 'Thinking…';
          useWrap.style.display = 'none';
          diagWrap.style.display = 'none';
          try {
            var r = await fetch(base + '/agent', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: action }),
            });
            var data = await r.json();
            if (!data.ok) throw new Error(data.error || 'Agent failed');

            if (action === 'diagnose') {
              var dg = null;
              try { dg = JSON.parse(data.output.replace(/^```(json)?/i, '').replace(/```$/, '').trim()); } catch (e) {}
              if (dg && typeof dg === 'object') {
                lastDiagnosis = dg;
                out.style.display = 'none';
                renderDiagnosis(dg);
                diagWrap.style.display = 'block';
              } else {
                lastDiagnosis = { rawText: data.output };
                out.style.display = 'block';
                out.textContent = data.output;
                diagCard.innerHTML = '';
                diagWrap.style.display = 'block';
              }
            } else {
              out.style.display = 'block';
              out.textContent = data.output;
              if (action === 'reply') { lastDraft = data.output; useWrap.style.display = ''; }
            }
          } catch (err) {
            out.style.display = 'block';
            out.textContent = 'Agent error: ' + err.message;
          } finally { btn.disabled = false; }
        });
      });

      // Save diagnosis as a fix handoff in the DB queue
      var saveBtn = document.getElementById('saveHandoff'), handoffMsg = document.getElementById('handoffMsg');
      saveBtn.addEventListener('click', async function() {
        if (!lastDiagnosis) return;
        if (lastDiagnosis.confidence === 'low' && !confirm('This diagnosis is LOW confidence — the model wasn’t sure. Queue it as a fix handoff anyway?')) return;
        saveBtn.disabled = true; handoffMsg.textContent = 'Saving…';
        try {
          var payload = lastDiagnosis.rawText
            ? { notes: lastDiagnosis.rawText }
            : { diagnosis: JSON.stringify(lastDiagnosis) };
          var r = await fetch(base + '/handoff', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = await r.json();
          if (!data.ok) throw new Error(data.error || 'Save failed');
          handoffMsg.textContent = 'Saved to fix queue ✓ — reloading…';
          setTimeout(function(){ location.reload(); }, 700);
        } catch (err) {
          handoffMsg.style.color = '#fca5a5';
          handoffMsg.textContent = 'Error: ' + err.message;
          saveBtn.disabled = false;
        }
      });

      // Handoff status buttons (only present when a handoff exists)
      var hbLabel = document.getElementById('hbStatusLabel');
      document.querySelectorAll('[data-hb-status]').forEach(function(b) {
        b.addEventListener('click', async function() {
          try {
            var r = await fetch(base + '/handoff', {
              method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ status: b.dataset.hbStatus, keepExisting: true }),
            });
            var data = await r.json();
            if (data.ok) location.reload();
          } catch (e) {}
        });
      });

      // Use draft as reply
      document.getElementById('useDraft').addEventListener('click', function() {
        if (lastDraft) { replyBody.value = lastDraft; replyBody.focus(); replyBody.scrollIntoView({ behavior:'smooth', block:'center' }); }
      });

      // Revise loop
      var reviseBtn = document.getElementById('reviseBtn'), reviseInput = document.getElementById('reviseInput');
      reviseBtn.addEventListener('click', async function() {
        if (!lastDraft) return;
        reviseBtn.disabled = true; out.style.display = 'block'; out.classList.remove('empty'); out.textContent = 'Revising…';
        try {
          var r = await fetch(base + '/agent', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'revise', draft: lastDraft, instruction: reviseInput.value.trim() }),
          });
          var data = await r.json();
          if (!data.ok) throw new Error(data.error || 'Agent failed');
          out.textContent = data.output; lastDraft = data.output; reviseInput.value = '';
        } catch (err) { out.textContent = 'Agent error: ' + err.message; }
        finally { reviseBtn.disabled = false; }
      });
    })();
  </script>
</body>
</html>
