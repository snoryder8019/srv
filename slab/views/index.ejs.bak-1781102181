<!-- ═══════ ABOUT · Server Harmony — non-interactive Three.js constellation ═══════ -->
<script type="module">
(function () {
  'use strict';
  const wrap = document.getElementById('aboutHarmonyWrap');
  const dataEl = document.getElementById('aboutHarmonyJson');
  if (!wrap || !dataEl) return;
  let services = [];
  try { services = JSON.parse(dataEl.textContent || '[]') || []; } catch { services = []; }
  if (!services.length) return;

  Promise.all([
    import('three'),
    import('three/addons/controls/OrbitControls.js'),
  ]).then(([THREE, { OrbitControls }]) => {
    const CATEGORY_COLOR = {
      platform: 0x34d399, client: 0x60a5fa, game: 0xc084fc,
      media: 0xf59e0b, tool: 0xc9a848, infra: 0x22d3ee,
    };

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0a0f1c, 0.020);

    let w = wrap.clientWidth || 480, h = wrap.clientHeight || 320;
    const camera = new THREE.PerspectiveCamera(60, w / h, 0.1, 200);
    camera.position.set(0, 5, 16); // start zoomed in close

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(w, h);
    renderer.setClearColor(0x000000, 0); // transparent — lets the dark panel + giant initial show through
    wrap.appendChild(renderer.domElement);

    // Interactive camera — drag to rotate, scroll/pinch to zoom. Pan disabled so it
    // can't be dragged off-center. Gentle auto-rotate that pauses while the user
    // interacts and resumes after a few seconds idle.
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.enablePan = false;
    controls.minDistance = 7;
    controls.maxDistance = 40;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.7;
    controls.target.set(0, 0, 0);
    controls.update();

    let resumeTimer = null;
    controls.addEventListener('start', () => { controls.autoRotate = false; if (resumeTimer) { clearTimeout(resumeTimer); resumeTimer = null; } });
    controls.addEventListener('end', () => { if (resumeTimer) clearTimeout(resumeTimer); resumeTimer = setTimeout(() => { controls.autoRotate = true; }, 3500); });

    // Subtle starfield
    {
      const geom = new THREE.BufferGeometry();
      const N = 280;
      const pos = new Float32Array(N * 3);
      for (let i = 0; i < N; i++) { pos[i*3] = (Math.random()-0.5)*80; pos[i*3+1] = (Math.random()-0.5)*40; pos[i*3+2] = (Math.random()-0.5)*80; }
      geom.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      scene.add(new THREE.Points(geom, new THREE.PointsMaterial({ size: 0.08, color: 0x4a5568, transparent: true, opacity: 0.55 })));
    }

    scene.add(new THREE.AmbientLight(0x808080, 0.6));
    const centerLight = new THREE.PointLight(0xc9a848, 1.2, 60);
    centerLight.position.set(0, 2, 0);
    scene.add(centerLight);

    // Cluster categories on a ring; nodes orbit their cluster center.
    const FIXED_CATEGORY_ORDER = ['platform', 'client', 'game', 'media', 'tool', 'infra'];
    const presentCats = [...new Set(services.map(s => s.category))]
      .sort((a, b) => FIXED_CATEGORY_ORDER.indexOf(a) - FIXED_CATEGORY_ORDER.indexOf(b));
    const clusterCenters = {};
    presentCats.forEach((cat, i) => {
      const ang = (i / presentCats.length) * Math.PI * 2;
      clusterCenters[cat] = { x: Math.cos(ang) * 11, y: 0, z: Math.sin(ang) * 11 };
    });

    const sphereGeom = new THREE.SphereGeometry(0.45, 20, 20);
    const ringGeom = new THREE.RingGeometry(0.5, 0.55, 40);
    ringGeom.rotateX(-Math.PI / 2);

    const nodes = [];
    const categoryCounts = {};
    services.forEach((svc) => {
      const cat = svc.category || 'tool';
      const c = clusterCenters[cat] || { x: 0, y: 0, z: 0 };
      categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
      const idx = categoryCounts[cat];
      const r = 1.6 + ((idx % 7) * 0.35);
      const phi = idx * 2.4;
      const px = c.x + Math.cos(phi) * r;
      const pz = c.z + Math.sin(phi) * r;
      const py = ((idx % 5) - 2) * 0.5;
      const color = CATEGORY_COLOR[cat] || 0xa3a3a3;

      const group = new THREE.Group();
      group.position.set(px, py, pz);

      const sphere = new THREE.Mesh(sphereGeom, new THREE.MeshStandardMaterial({ color, emissive: color, emissiveIntensity: 0.6, metalness: 0.4, roughness: 0.4 }));
      group.add(sphere);

      const halo = new THREE.Mesh(ringGeom, new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.25, side: THREE.DoubleSide, depthWrite: false }));
      group.add(halo);

      const lineGeom = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(c.x - px, -py, c.z - pz)]);
      const line = new THREE.Line(lineGeom, new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.10 }));
      group.add(line);

      scene.add(group);
      nodes.push({ group, sphere, halo, baseColor: color });
    });

    // Faint outer orbit ring for depth
    {
      const seg = 160, pts = [];
      for (let i = 0; i <= seg; i++) { const a = (i / seg) * Math.PI * 2; pts.push(new THREE.Vector3(Math.cos(a) * 18, 0, Math.sin(a) * 18)); }
      const g = new THREE.BufferGeometry().setFromPoints(pts);
      scene.add(new THREE.LineLoop(g, new THREE.LineBasicMaterial({ color: 0x60a5fa, transparent: true, opacity: 0.10 })));
    }

    // Gentle ambient pulses — pooled, fired at random so the scene feels alive (no interaction).
    const pulseRings = [];
    function spawnPulse() {
      if (!nodes.length) return;
      const node = nodes[Math.floor(Math.random() * nodes.length)];
      const ring = new THREE.Mesh(new THREE.RingGeometry(0.5, 0.6, 40), new THREE.MeshBasicMaterial({ color: node.baseColor, transparent: true, opacity: 0.85, side: THREE.DoubleSide, depthWrite: false }));
      ring.rotation.x = -Math.PI / 2;
      ring.position.copy(node.group.position);
      scene.add(ring);
      pulseRings.push({ mesh: ring, born: performance.now(), life: 1100, scaleMax: 5 });
      node.sphere.material.emissiveIntensity = 1.6;
    }

    // Resize + pause-when-offscreen (perf on shared tenant pages)
    new ResizeObserver(() => {
      const nw = wrap.clientWidth, nh = wrap.clientHeight;
      if (!nw || !nh) return;
      camera.aspect = nw / nh; camera.updateProjectionMatrix();
      renderer.setSize(nw, nh, true);
    }).observe(wrap);

    const clock = new THREE.Clock();
    let paused = false, nextPulse = 0;
    new IntersectionObserver((entries) => {
      paused = !entries[0].isIntersecting;
      if (!paused) clock.getDelta();
    }, { threshold: 0 }).observe(wrap);
    document.addEventListener('visibilitychange', () => { paused = document.hidden; if (!paused) clock.getDelta(); });

    function loop() {
      requestAnimationFrame(loop);
      if (paused) return;
      const dt = clock.getDelta();
      controls.update(); // damping + auto-rotate

      nodes.forEach((n) => {
        n.group.rotation.y += dt * 0.3;
        n.halo.rotation.z += dt * 0.4;
        const m = n.sphere.material;
        m.emissiveIntensity += (0.6 - m.emissiveIntensity) * Math.min(1, dt * 3);
      });

      if ((nextPulse -= dt) <= 0) { spawnPulse(); nextPulse = 0.8 + Math.random() * 1.4; }

      const now = performance.now();
      for (let i = pulseRings.length - 1; i >= 0; i--) {
        const p = pulseRings[i];
        const age = (now - p.born) / p.life;
        if (age >= 1) { scene.remove(p.mesh); p.mesh.geometry.dispose(); p.mesh.material.dispose(); pulseRings.splice(i, 1); continue; }
        const s = 1 + age * p.scaleMax;
        p.mesh.scale.set(s, s, s);
        p.mesh.material.opacity = (1 - age) * 0.85;
      }

      renderer.render(scene, camera);
    }
    requestAnimationFrame(loop);
  }).catch((e) => { console.warn('[about-harmony] three.js failed to load:', e); });
})();
</script>
<% } %>
