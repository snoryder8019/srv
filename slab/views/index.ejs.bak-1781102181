<!DOCTYPE html>
<html lang="en" data-snap="<%= design.snap_enabled === 'true' ? 'true' : 'false' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <%
    const _BI_auto = (brand?.name || '').split(/\s+/).map(w => w[0]).join('').toUpperCase();
    const _BI = (design.hero_name_large && design.hero_name_large.trim()) || _BI_auto;
    const _sp = (brand?.name || '').indexOf(' ') > 0 ? (brand.name.indexOf(' ')) : 0;
  %>
  <%- include('partials/font-vars') %>
  <%- include('partials/landing-styles') %>
  <% if (visibility.about && (harmonyServices || []).length) { %>
  <script type="importmap">{ "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js", "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/" } }</script>
  <% } %>
</head>
<%
  const heroBgMediaUrl  = (design.hero_bg_media_url  || '').trim();
  const heroBgMediaType = (design.hero_bg_media_type || '').trim();
  const heroBgMediaPoster = (design.hero_bg_media_poster || '').trim();
  const heroFullBg = !!heroBgMediaUrl && (heroBgMediaType === 'image' || heroBgMediaType === 'video');
  const heroStyle = (design.hero_style || 'split');

  /* Slideshow slides: copy keys slide{N}_image|heading|sub|eyebrow|link|cta */
  const _slideIdx = new Set();
  Object.keys(copy || {}).forEach(k => { const m = k.match(/^slide(\d+)_/); if (m) _slideIdx.add(parseInt(m[1], 10)); });
  const heroSlides = [..._slideIdx].sort((a, b) => a - b).map(i => ({
    image:   copy['slide' + i + '_image']   || '',
    heading: copy['slide' + i + '_heading'] || '',
    sub:     copy['slide' + i + '_sub']     || '',
    eyebrow: copy['slide' + i + '_eyebrow'] || '',
    link:    copy['slide' + i + '_link']    || '',
    cta:     copy['slide' + i + '_cta']     || '',
    tag:     copy['slide' + i + '_tag']     || '',
    vpos:    copy['slide' + i + '_vpos']    || '',
  })).filter(s => s.image || s.heading);
  // Maps a vertical-position keyword → flex align-items value. Empty/'inherit'
  // leaves the slide on the global --hero-vpos default.
  const _heroVposMap = { top: 'flex-start', middle: 'center', bottom: 'flex-end' };
%>
<body data-layout="<%= design.landing_layout || 'classic' %>" data-gradient="<%= design.gradient_enabled || 'false' %>" data-card-hover-accent="<%= design.card_hover_accent || 'true' %>" data-hero-pattern="<%= design.hero_bg_pattern || 'none' %>" data-hero-full-bg="<%= heroFullBg ? heroBgMediaType : '' %>" data-hero-style="<%= heroStyle %>" data-portfolio-layout="<%= design.portfolio_layout || 'grid' %>" data-blog-layout="<%= design.blog_layout || 'grid' %>">

<% if (visibility.header !== false) { %>
<%- include('partials/header', { activePage: 'home' }) %>
<% } %>

<!-- HERO -->
<% if (visibility.hero) { %>
<% if (heroStyle === 'parallax') { %>
  <%- include('partials/_marquee-parallax', { d: design, b: brand, copy: copy, pos: 'hero' }) %>
<% } else if (heroStyle === 'slideshow' && heroSlides.length) { %>
  <%
    const _interval = parseInt(design.hero_slideshow_interval || '6', 10);
    const _showDots = design.hero_slideshow_dots !== 'false';
    const _showArrows = design.hero_slideshow_arrows !== 'false';
    // Static overlay: one fixed headline (main hero copy) sits over every slide
    // instead of per-slide titles — for image-only slideshows.
    const _staticHero = design.hero_slideshow_static === 'true';
  %>
  <section class="hero hero--slideshow<%= _staticHero ? ' hero--slideshow-static' : '' %>" data-interval="<%= _interval %>" data-count="<%= heroSlides.length %>">
    <div class="hero-slides">
      <% heroSlides.forEach((s, i) => { %>
        <% const _slideVpos = (!_staticHero && _heroVposMap[s.vpos]) ? ' style="align-items:' + _heroVposMap[s.vpos] + '"' : ''; %>
        <% if (s.link && !_staticHero) { %>
        <a class="hero-slide<%= i === 0 ? ' is-active' : '' %>" data-idx="<%= i %>" href="<%= s.link %>"<%- _slideVpos %>>
        <% } else { %>
        <div class="hero-slide<%= i === 0 ? ' is-active' : '' %>" data-idx="<%= i %>"<%- _slideVpos %>>
        <% } %>
          <% if (s.image) { %><div class="hero-slide-bg" style="background-image:url('<%= s.image %>');"></div><% } %>
          <div class="hero-slide-overlay"></div>
          <% if (!_staticHero) { %>
          <div class="hero-slide-text">
            <% if (s.tag) { %><span class="hero-slide-tag"><%= s.tag %></span><% } %>
            <% if (s.eyebrow) { %><p class="hero-eyebrow"><%= s.eyebrow %></p><% } %>
            <% if (s.heading) { %><h2 class="hero-heading"><%= s.heading %></h2><% } %>
            <% if (s.sub) { %><p class="hero-sub"><%= s.sub %></p><% } %>
            <% if (s.cta && s.link) { %><span class="btn-primary hero-slide-cta"><%= s.cta %></span><% } %>
          </div>
          <% } %>
        <% if (s.link && !_staticHero) { %></a><% } else { %></div><% } %>
      <% }) %>
    </div>
    <% if (_staticHero) { %>
    <div class="hero-static-overlay">
      <div class="hero-slide-text">
        <% if (copy.hero_eyebrow) { %><p class="hero-eyebrow"><%= copy.hero_eyebrow %></p><% } %>
        <% if (copy.hero_heading || copy.hero_heading_em) { %>
          <h2 class="hero-heading"><%= copy.hero_heading || '' %><% if (copy.hero_heading_em) { %> <em><%= copy.hero_heading_em %></em><% } %></h2>
        <% } %>
        <% if (copy.hero_sub) { %><p class="hero-sub"><%= copy.hero_sub %></p><% } %>
        <% if ((copy.hero_cta_primary && copy.hero_cta_primary_link) || (copy.hero_cta_secondary && copy.hero_cta_secondary_link)) { %>
        <div class="hero-btns">
          <% if (copy.hero_cta_primary && copy.hero_cta_primary_link) { %><a href="<%= copy.hero_cta_primary_link %>" class="btn-primary"><%= copy.hero_cta_primary %></a><% } %>
          <% if (copy.hero_cta_secondary && copy.hero_cta_secondary_link) { %><a href="<%= copy.hero_cta_secondary_link %>" class="btn-ghost btn-ghost--on-dark"><%= copy.hero_cta_secondary %></a><% } %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>
    <% if (_showArrows && heroSlides.length > 1) { %>
      <button type="button" class="hero-arrow hero-arrow--prev" aria-label="Previous slide">&#8249;</button>
      <button type="button" class="hero-arrow hero-arrow--next" aria-label="Next slide">&#8250;</button>
    <% } %>
    <% if (_showDots && heroSlides.length > 1) { %>
      <div class="hero-dots" role="tablist">
        <% heroSlides.forEach((s, i) => { %>
          <button type="button" class="hero-dot<%= i === 0 ? ' is-active' : '' %>" data-idx="<%= i %>" aria-label="Go to slide <%= i + 1 %>"></button>
        <% }) %>
      </div>
    <% } %>
  </section>
  <script>
  (function(){
    var root = document.querySelector('.hero--slideshow'); if (!root) return;
    var slides = [].slice.call(root.querySelectorAll('.hero-slide'));
    var dots = [].slice.call(root.querySelectorAll('.hero-dot'));
    var count = slides.length; if (count < 2) return;
    var idx = 0, timer = null;
    var interval = parseInt(root.getAttribute('data-interval'), 10) || 0;
    function show(n) {
      idx = (n + count) % count;
      slides.forEach(function(s, i){ s.classList.toggle('is-active', i === idx); });
      dots.forEach(function(d, i){ d.classList.toggle('is-active', i === idx); });
    }
    function next(){ show(idx + 1); }
    function prev(){ show(idx - 1); }
    function start(){ if (interval > 0) timer = setInterval(next, interval * 1000); }
    function stop(){ if (timer) { clearInterval(timer); timer = null; } }
    dots.forEach(function(d){ d.addEventListener('click', function(){ stop(); show(parseInt(d.getAttribute('data-idx'),10)); start(); }); });
    var pBtn = root.querySelector('.hero-arrow--prev'), nBtn = root.querySelector('.hero-arrow--next');
    if (pBtn) pBtn.addEventListener('click', function(){ stop(); prev(); start(); });
    if (nBtn) nBtn.addEventListener('click', function(){ stop(); next(); start(); });
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    start();
  })();
  </script>
<% } else if (heroStyle === 'image_card') { %>
  <%
    const _cardBg   = (media.hero_image || heroBgMediaUrl || '');
    const _cardType = heroBgMediaType === 'video' ? 'video' : 'image';
  %>
  <section class="hero hero--image-card" data-card-pos="<%= design.hero_card_position || 'left' %>">
    <div class="hero-bg-media" aria-hidden="true">
      <% if (_cardType === 'video' && heroBgMediaUrl) { %>
        <video class="hero-bg-video" autoplay muted loop playsinline preload="metadata"<% if (heroBgMediaPoster) { %> poster="<%= heroBgMediaPoster %>"<% } %>>
          <source src="<%= heroBgMediaUrl %>">
        </video>
      <% } else if (_cardBg) { %>
        <div class="hero-bg-image" style="background-image:url('<%= _cardBg %>');"></div>
      <% } %>
      <div class="hero-bg-overlay"></div>
    </div>
    <div class="hero-card-wrap">
      <div class="hero-card<%= design.hero_card_shadow === 'false' ? '' : ' hero-card--shadow' %>">
        <div class="hero-text">
          <% if (copy.hero_eyebrow) { %><p class="hero-eyebrow"><%= copy.hero_eyebrow %></p><% } %>
          <h1 class="hero-heading"><%= copy.hero_heading %><% if (copy.hero_heading_em) { %> <em><%= copy.hero_heading_em %></em><% } %></h1>
          <% if (copy.hero_sub) { %><p class="hero-sub"><%= copy.hero_sub %></p><% } %>
          <div class="hero-btns">
            <% if (copy.hero_cta_primary) { %><a href="<%= copy.hero_cta_primary_link || '#contact' %>" class="btn-primary"><%= copy.hero_cta_primary %></a><% } %>
            <% if (copy.hero_cta_secondary) { %><a href="<%= copy.hero_cta_secondary_link || '#services' %>" class="btn-ghost"><%= copy.hero_cta_secondary %></a><% } %>
          </div>
        </div>
      </div>
      <% if (copy.hero_badge) { %>
        <div class="hero-badge hero-badge--floating">
          <div class="hero-badge-dot"></div>
          <span class="hero-badge-text"><%= copy.hero_badge %></span>
        </div>
      <% } %>
    </div>
  </section>
<% } else { %>
<section class="hero<%= heroFullBg ? ' hero--full-bg' : '' %>">
  <% if (heroFullBg) { %>
    <div class="hero-bg-media" aria-hidden="true">
      <% if (heroBgMediaType === 'video') { %>
        <video class="hero-bg-video" autoplay muted loop playsinline preload="metadata"<% if (heroBgMediaPoster) { %> poster="<%= heroBgMediaPoster %>"<% } %>>
          <source src="<%= heroBgMediaUrl %>">
        </video>
      <% } else { %>
        <div class="hero-bg-image" style="background-image:url('<%= heroBgMediaUrl %>');"></div>
      <% } %>
      <div class="hero-bg-overlay"></div>
    </div>
  <% } %>
  <div class="hero-left">
    <div class="hero-text">
      <% if (logos.logo_primary && (design.landing_layout === 'showcase' || design.landing_layout === 'industrial')) { %>
        <img src="<%= logos.logo_primary %>" alt="<%= brand?.name || '' %>" style="max-width:min(280px,60vw);margin:0 auto 2rem;display:block;filter:brightness(1.1);">
      <% } %>
      <% if (copy.hero_eyebrow) { %><p class="hero-eyebrow"><%= copy.hero_eyebrow %></p><% } %>
      <h1 class="hero-heading"><%= copy.hero_heading %><% if (copy.hero_heading_em) { %> <em><%= copy.hero_heading_em %></em><% } %></h1>
      <% if (copy.hero_sub) { %><p class="hero-sub"><%= copy.hero_sub %></p><% } %>
      <div class="hero-btns">
        <% if (copy.hero_cta_primary) { %><a href="<%= copy.hero_cta_primary_link || '#contact' %>" class="btn-primary"><%= copy.hero_cta_primary %></a><% } %>
        <% if (copy.hero_cta_secondary) { %><a href="<%= copy.hero_cta_secondary_link || '#services' %>" class="btn-ghost"><%= copy.hero_cta_secondary %></a><% } %>
      </div>
    </div>
  </div>
  <% if (!heroFullBg) { %>
  <div class="hero-right"<% if (media.hero_image) { %> style="background-image:url('<%= media.hero_image %>');background-size:cover;background-position:center;"<% } %>>
    <% if (!media.hero_image) { %><div class="hero-circle"></div><% } %>
    <div class="hero-right-content" style="position:relative;z-index:1;">
      <% if (!media.hero_image) { %><div class="hero-name-large"><%= _BI %></div><% } %>
      <% if (copy.hero_badge) { %>
      <div class="hero-badge">
        <div class="hero-badge-dot"></div>
        <span class="hero-badge-text"><%= copy.hero_badge %></span>
      </div>
      <% } %>
    </div>
  </div>
  <% } else if (copy.hero_badge) { %>
    <div class="hero-badge hero-badge--floating">
      <div class="hero-badge-dot"></div>
      <span class="hero-badge-text"><%= copy.hero_badge %></span>
    </div>
  <% } %>
</section>
<% } %>
<% } %>

<!-- MARQUEE / TICKER -->
<% /* When the parallax band IS the hero, don't render it again below. */ %>
<% if (visibility.hero && visibility.marquee !== false && heroStyle !== 'parallax') { %>
  <% if ((design.ticker_treatment || 'bar') === 'parallax') { %>
    <%- include('partials/_marquee-parallax', { d: design, b: brand, copy: copy, pos: 'below_hero' }) %>
  <% } else { %>
    <%- include('partials/_marquee-bar', { d: design, b: brand, pos: 'below_hero' }) %>
  <% } %>
<% } %>

<!-- SERVICES -->
<% if (visibility.services) { %>
<section class="services" id="services">
  <div class="section-header">
    <div>
      <p class="section-eyebrow"><%= copy.services_label %></p>
      <h2 class="section-heading"><%= copy.services_heading %> <em><%= copy.services_heading_em %></em></h2>
    </div>
    <p class="section-sub"><%= copy.services_sub %></p>
  </div>
  <div class="services-grid">
    <%
      // Collect every service card defined in copy (service{N}_*), in numeric
      // order — not just 1-3 — so cards added via the design repeater publish.
      // service{N}_hidden === 'true' hides that card from the live page.
      const _svcIdx = new Set();
      Object.keys(copy).forEach(k => { const m = k.match(/^service(\d+)_/); if (m) _svcIdx.add(parseInt(m[1], 10)); });
      let _services = [..._svcIdx].sort((a, b) => a - b)
        .filter(n => copy['service' + n + '_hidden'] !== 'true')
        .map(n => ({
          title: copy['service' + n + '_title'],
          desc:  copy['service' + n + '_desc'],
          link:  copy['service' + n + '_link'],
          image: copy['service' + n + '_image'],
        }))
        .filter(s => s.title || s.desc || s.image);
      // Fallback to the first three default keys if nothing is defined yet.
      if (_services.length === 0) {
        _services = [1, 2, 3].map(n => ({
          title: copy['service' + n + '_title'],
          desc:  copy['service' + n + '_desc'],
          link:  copy['service' + n + '_link'],
          image: copy['service' + n + '_image'],
        }));
      }
    %>
    <% _services.forEach(({ title, desc, link, image }, i) => { %>
      <% if (link) { %><a href="<%= link %>" class="service-card" style="text-decoration:none;color:inherit;"><% } else { %><div class="service-card"><% } %>
        <% if (image) { %><img src="<%= image %>" alt="<%= title %>" style="max-width:min(320px,70vw);max-height:120px;object-fit:contain;margin-bottom:24px;"><% } %>
        <div class="service-num"><%= String(i + 1).padStart(2, '0') %></div>
        <h3 class="service-title"><%= title %></h3>
        <p class="service-desc"><%= desc %></p>
        <% if (link) { %><span class="service-link">Visit →</span></a><% } else { %></div><% } %>
    <% }) %>
  </div>
</section>
<% } %>

<!-- PORTFOLIO -->
<% if (visibility.portfolio && portfolio && portfolio.length) { %>
<section id="portfolio" style="padding:100px 52px;background:var(--navy-deep);">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="section-header">
      <div>
        <p class="section-eyebrow" style="color:var(--gold);">Our Work</p>
        <h2 class="section-heading" style="color:var(--white);">Recent <em style="color:var(--gold-light);">Projects</em></h2>
      </div>
    </div>
    <div class="pf-grid">
      <% for (const item of portfolio) { %>
      <% const _galleryCount = (item.gallery && item.gallery.length) || (item.imageUrl ? 1 : 0); %>
      <div class="pf-card-clickable" tabindex="0" role="button" data-portfolio-id="<%= item._id %>"
           aria-label="View <%= item.title %>"
           style="background:var(--navy);position:relative;overflow:hidden;">
        <% if (item.imageUrl) { %>
          <div style="aspect-ratio:16/10;overflow:hidden;position:relative;">
            <img src="<%= item.imageUrl %>" alt="<%= item.title %>" style="width:100%;height:100%;object-fit:cover;display:block;">
            <% if (_galleryCount > 1) { %>
              <span style="position:absolute;top:10px;right:10px;background:rgba(15,27,48,0.85);color:var(--gold-light);font-size:0.62rem;font-weight:600;letter-spacing:0.12em;padding:4px 9px;border-radius:2px;">◧ <%= _galleryCount %></span>
            <% } %>
          </div>
        <% } %>
        <div style="padding:28px 28px 32px;">
          <% if (item.category) { %><p style="font-size:0.62rem;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;"><%= item.category %></p><% } %>
          <h3 style="font-family:var(--font-heading),serif;font-size:1.5rem;font-weight:400;color:var(--white);margin-bottom:10px;"><%= item.title %></h3>
          <% if (item.description) { %><p style="font-size:0.85rem;color:rgba(253,252,250,0.55);line-height:1.7;"><%= item.description.length > 120 ? item.description.slice(0,120).trim() + '…' : item.description %></p><% } %>
          <% if (item.clientName) { %><p style="font-size:0.68rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:rgba(201,168,72,0.5);margin-top:16px;"><%= item.clientName %></p><% } %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/portfolio-modal', { portfolio: portfolio }) %>
<% } %>

<!-- ABOUT -->
<% if (visibility.about) { %>
<section class="advisor-section" id="about">
  <div class="advisor-left">
    <div class="advisor-text">
      <p class="section-eyebrow"><%= copy.about_eyebrow %></p>
      <blockquote class="advisor-quote"><%= copy.about_quote %></blockquote>
      <p class="advisor-desc"><%= copy.about_desc %></p>
      <div class="advisor-sig"><%= copy.about_sig %></div>
    </div>
  </div>
  <div class="advisor-right">
    <% if (copy.about_initial) { %><div class="advisor-initial"><%= copy.about_initial %></div><% } %>
    <div class="advisor-right-inner">
      <% if ((harmonyServices || []).length) {
        const _hCatMeta = {
          platform: { label: 'Platform', color: '#34d399' },
          client:   { label: 'Client',   color: '#60a5fa' },
          game:     { label: 'Game',     color: '#c084fc' },
          media:    { label: 'Media',    color: '#f59e0b' },
          tool:     { label: 'Tool',     color: '#c9a848' },
          infra:    { label: 'Infra',    color: '#22d3ee' },
        };
        const _hCats = [...new Set((harmonyServices || []).map(s => s.category))].filter(c => _hCatMeta[c]);
      %>
      <div class="about-harmony">
        <div class="ah-eyebrow">Server Harmony · our live stack</div>
        <div id="aboutHarmonyWrap" class="ah-canvas"></div>
        <div class="ah-legend">
          <% _hCats.forEach(function(cat) { %>
            <span class="ah-lg"><span class="ah-dot" style="background:<%= _hCatMeta[cat].color %>;box-shadow:0 0 6px <%= _hCatMeta[cat].color %>;"></span><%= _hCatMeta[cat].label %></span>
          <% }); %>
        </div>
        <div class="ah-count"><%= (harmonyServices || []).length %> services &amp; microservices in orbit</div>
        <div class="ah-hint">drag to rotate · scroll to zoom</div>
        <script type="application/json" id="aboutHarmonyJson"><%- JSON.stringify(harmonyServices || []) %></script>
      </div>
      <% } %>
      <div class="advisor-stats">
        <%
          const _statIdx = new Set();
          Object.keys(copy).forEach(k => { const m = k.match(/^about_stat(\d+)_/); if (m) _statIdx.add(parseInt(m[1], 10)); });
          const _stats = [..._statIdx].sort((a, b) => a - b).length ? [..._statIdx].sort((a, b) => a - b) : [1, 2, 3, 4];
        %>
        <% _stats.forEach(function(n) { %>
          <% if (copy['about_stat'+n+'_num'] && copy['about_stat'+n+'_hidden'] !== 'true') { %>
          <div class="stat-box">
            <div class="stat-num"><%= copy['about_stat'+n+'_num'] %></div>
            <div class="stat-label"><%= copy['about_stat'+n+'_label'] %></div>
          </div>
          <% } %>
        <% }); %>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- PROCESS -->
<% if (visibility.process) { %>
<section class="process" id="process">
  <div class="process-inner">
    <div>
      <p class="section-eyebrow"><%= copy.process_label %></p>
      <h2 class="section-heading"><%= copy.process_heading %> <em><%= copy.process_heading_em %></em></h2>
    </div>
    <div class="process-list">
      <%
        const _procIdx = new Set();
        Object.keys(copy).forEach(k => { const m = k.match(/^process(\d+)_/); if (m) _procIdx.add(parseInt(m[1], 10)); });
        const _procArr = [..._procIdx].sort((a, b) => a - b).length ? [..._procIdx].sort((a, b) => a - b) : [1, 2, 3, 4];
        const _steps = _procArr
          .filter(n => copy['process'+n+'_hidden'] !== 'true' && copy['process'+n+'_title'])
          .map(n => [copy['process'+n+'_title'], copy['process'+n+'_desc']]);
      %>
      <% _steps.forEach(function(step, i) { %>
        <div class="process-item">
          <div class="process-num"><%= String(i + 1).padStart(2, '0') %></div>
          <div>
            <div class="process-title"><%- step[0] %></div>
            <div class="process-desc"><%- step[1] || '' %></div>
          </div>
          <div class="process-arrow">→</div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- REVIEWS -->
<% if (visibility.reviews && reviews && reviews.reviews && reviews.reviews.length) { %>
<section style="padding:100px 52px;background:var(--ivory);">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Google Reviews</p>
        <h2 class="section-heading">What our <em>clients say</em></h2>
      </div>
      <div style="text-align:right;">
