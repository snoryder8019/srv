<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/seo-head') %>
  <%
    const _t = (typeof t === 'function') ? t : (k => k);
    const _sp = parseInt(design.nav_logo_split) || 0;
    const _brandPre = _sp > 0 ? (brand?.name||'').slice(0,_sp) : '';
    const _brandPost = _sp > 0 ? (brand?.name||'').slice(_sp) : (brand?.name||'');
    const _ct = (typeof ct !== 'undefined' && ct) ? ct : { type:'blog', base:'/blog', label:'Blog' };
  %>
  <link rel="alternate" type="application/rss+xml" title="<%= (brand?.name||'') + ' ' + _ct.label %> — RSS" href="<%= _ct.base %>/feed.rss">
  <link rel="alternate" type="application/atom+xml" title="<%= (brand?.name||'') + ' ' + _ct.label %> — Atom" href="<%= _ct.base %>/feed.atom">
  <%- include('../partials/font-vars') %>
  <style>
    :root {
      --primary:      <%= design.color_primary %>;
      --primary-deep: <%= design.color_primary_deep %>;
      --primary-mid:  <%= design.color_primary_mid %>;
      --accent:       <%= design.color_accent %>;
      --accent-light: <%= design.color_accent_light %>;
      --bg:           <%= design.color_bg %>;
      --navy: var(--primary); --navy-deep: var(--primary-deep); --navy-mid: var(--primary-mid);
      --gold: var(--accent); --gold-light: var(--accent-light);
      --ivory: var(--bg); --ivory-mid: <%= design._border || '#E6E1D6' %>; --dark: <%= design._on_bg || '#0F1B30' %>; --white: #FDFCFA;
      --on-primary: <%= design._on_primary || '#FDFCFA' %>; --on-primary-deep: <%= design._on_primary_deep || '#FDFCFA' %>;
      --on-primary-mid: <%= design._on_primary_mid || '#FDFCFA' %>;
      --on-bg: <%= design._on_bg || '#0F1B30' %>; --on-bg-muted: <%= design._on_bg_muted || '#6B7380' %>;
      --on-accent: <%= design._on_accent || '#0F1B30' %>; --on-accent-light: <%= design._on_accent_light || '#0F1B30' %>;
      --surface: <%= design._surface || '#FFFFFF' %>; --on-surface: <%= design._on_surface || '#0F1B30' %>;
      --on-surface-muted: <%= design._on_surface_muted || '#6B7380' %>;
      --border: <%= design._border || '#CBD5E1' %>; --placeholder: <%= design._placeholder || '#9CA3AF' %>;
      --slate: var(--on-bg-muted);
      --font-heading: '<%= design.font_heading %>', serif;
      --font-body: '<%= design.font_body %>', sans-serif;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family:var(--font-body); background:var(--surface); color:var(--on-surface); }
    .reveal { opacity:0; transform:translateY(20px); transition:opacity 0.5s ease, transform 0.5s ease; }
    .reveal.visible { opacity:1; transform:translateY(0); }
    /* nav styles provided by partials/header.ejs */
    .post-hero { padding:max(140px, var(--nav-clear)) 52px 64px; background:var(--bg); }
    .post-hero-inner { max-width:800px; margin:0 auto; }
    .back-link { font-size:0.75rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--slate); text-decoration:none; display:inline-flex; align-items:center; gap:6px; margin-bottom:32px; }
    .back-link:hover { color:var(--primary); }
    .post-meta { display:flex; gap:16px; align-items:center; margin-bottom:20px; flex-wrap:wrap; }
    .post-category { font-size:0.65rem; font-weight:600; letter-spacing:0.18em; text-transform:uppercase; color:var(--accent); background:color-mix(in srgb, var(--accent) 12%, transparent); border:1px solid color-mix(in srgb, var(--accent) 30%, transparent); padding:4px 12px; border-radius:2px; }
    .post-date { font-size:0.75rem; color:var(--slate); font-weight:300; }
    .post-share-btn { font-size:0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--primary); background:color-mix(in srgb, var(--primary) 8%, transparent); border:1px solid color-mix(in srgb, var(--primary) 28%, transparent); padding:5px 14px; border-radius:2px; cursor:pointer; transition:all 0.18s; }
    .post-share-btn:hover { background:var(--primary); color:var(--white); }
    .post-title { font-family:var(--font-heading); font-size:clamp(2rem,4.5vw,3.6rem); font-weight:300; line-height:1.1; color:var(--on-surface); margin-bottom:20px; }
    .post-excerpt-lead { font-size:1.1rem; font-weight:300; color:var(--slate); line-height:1.8; margin-bottom:32px; border-left:3px solid var(--accent); padding-left:20px; }
    .post-tags { display:flex; gap:8px; flex-wrap:wrap; }
    .tag { font-size:0.65rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:var(--slate); background:var(--border); padding:4px 10px; border-radius:2px; }
    .featured-img { width:100%; max-height:480px; object-fit:cover; display:block; }
    .post-content-wrap { max-width:800px; margin:0 auto; padding:60px 52px 100px; }
    .post-content { font-size:1rem; font-weight:300; line-height:1.9; color:var(--on-surface); }
    .post-content h2 { font-family:var(--font-heading); font-size:1.8rem; font-weight:400; color:var(--on-surface); margin:48px 0 16px; }
    .post-content h3 { font-family:var(--font-heading); font-size:1.4rem; font-weight:400; color:var(--on-surface); margin:36px 0 12px; }
    .post-content p { margin-bottom:20px; }
    .post-content ul, .post-content ol { margin:0 0 20px 24px; }
    .post-content li { margin-bottom:8px; line-height:1.7; }
    .post-content strong { font-weight:600; }
    .post-content em { font-style:italic; }
    .post-content a { color:var(--primary); }
    .post-content a:hover { color:var(--accent); }
    .post-content img { max-width:100%; border-radius:2px; margin:24px 0; }
    .post-content blockquote { border-left:3px solid var(--accent); padding:16px 24px; margin:32px 0; background:var(--bg); font-style:italic; color:var(--slate); }
    /* ── SLIDES ── */
    .post-slides { max-width:800px; margin:48px auto 0; padding:0 52px; }
    .slides-label { font-size:0.65rem; font-weight:600; letter-spacing:0.18em; text-transform:uppercase; color:var(--slate); margin-bottom:14px; }
    .slides-carousel { position:relative; border-radius:3px; overflow:hidden; background:var(--bg); border:1px solid var(--border); }
    .slides-track { display:flex; transition:transform 0.45s cubic-bezier(0.4,0,0.2,1); }
    .slides-slide { min-width:100%; position:relative; }
    .slides-slide img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
    .slides-cap { padding:12px 18px; font-size:0.85rem; font-weight:300; color:var(--slate); line-height:1.6; }
    .slides-nav { position:absolute; top:50%; transform:translateY(-50%); width:42px; height:42px; border-radius:50%; border:none; background:color-mix(in srgb, var(--primary) 80%, transparent); color:var(--white); font-size:1.2rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.18s; z-index:2; }
    .slides-nav:hover { background:var(--primary); }
    .slides-prev { left:14px; } .slides-next { right:14px; }
    .slides-dots { display:flex; gap:8px; justify-content:center; margin-top:14px; }
    .slides-dot { width:8px; height:8px; border-radius:50%; border:none; background:var(--border); cursor:pointer; padding:0; transition:background 0.18s; }
    .slides-dot.active { background:var(--accent); }
    .slides-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:12px; }
    .slides-grid figure { margin:0; border-radius:3px; overflow:hidden; border:1px solid var(--border); background:var(--bg); }
    .slides-grid img { width:100%; aspect-ratio:1; object-fit:cover; display:block; }
    .slides-grid figcaption { padding:8px 10px; font-size:0.72rem; color:var(--slate); }
    @media (max-width:640px){ .post-slides { padding:0 24px; } }
    .post-footer { margin-top:60px; padding-top:32px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
    footer { background:var(--primary-deep); padding:48px 52px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:24px; }
    .footer-brand { font-family:var(--font-heading); font-size:1.3rem; font-weight:300; color:color-mix(in srgb, var(--on-primary-deep) 60%, transparent); }
    .footer-links { list-style:none; display:flex; gap:24px; }
    .footer-links a { font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:color-mix(in srgb, var(--on-primary-deep) 35%, transparent); text-decoration:none; transition:color 0.2s; }
    .footer-links a:hover { color:var(--accent-light); }
  </style>
</head>
<body>
<%- include("../partials/header", { activePage: _ct.type }) %>

<div class="post-hero reveal">
  <div class="post-hero-inner">
    <a href="<%= _ct.base %>" class="back-link">← <%= _t('blog.back_to') %> <%= _ct.label %></a>
    <div class="post-meta">
      <% if (post.category) { %><span class="post-category"><%= post.category %></span><% } %>
      <span class="post-date"><%= new Date(post.publishedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span>
      <% var _shareUrl = (typeof shareUrl !== 'undefined' && shareUrl) ? shareUrl : ''; %>
      <% if (_shareUrl) { %>
        <button type="button" class="post-share-btn"
          onclick="openShareModal({ url: <%= JSON.stringify(_shareUrl) %>, title: <%= JSON.stringify(post.title) %>, text: <%= JSON.stringify(post.excerpt || '') %>, image: <%= JSON.stringify(post.featuredImageUrl || '') %> })">⤴ <%= _t('blog.share') %></button>
      <% } %>
    </div>
    <h1 class="post-title"><%= post.title %></h1>
    <% if (post.excerpt) { %><p class="post-excerpt-lead"><%= post.excerpt %></p><% } %>
    <% if (post.tags && post.tags.length) { %>
      <div class="post-tags">
        <% post.tags.forEach(tag => { %><span class="tag"><%= tag %></span><% }) %>
      </div>
    <% } %>
  </div>
</div>

<% if (post.featuredImageUrl) { %>
  <img src="<%= post.featuredImageUrl %>" alt="<%= post.title %>" class="featured-img">
<% } %>

<div class="post-content-wrap reveal">
  <div class="post-content"><%- post.content %></div>

  <% var _slides = (typeof slides !== 'undefined' && slides) ? slides : []; %>
  <% if (_slides.length) { %>
    <% if ((post.slidesStyle || 'carousel') === 'grid') { %>
      <div class="post-slides reveal" style="padding-left:0;padding-right:0;">
        <div class="slides-label"><%= _t('blog.gallery') %></div>
        <div class="slides-grid">
          <% _slides.forEach(function(s){ %>
            <figure>
              <img src="<%= s.thumb || s.url %>" alt="<%= s.alt %>" loading="lazy" decoding="async">
              <% if (s.caption) { %><figcaption><%= s.caption %></figcaption><% } %>
            </figure>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <div class="post-slides reveal" id="postSlides" style="padding-left:0;padding-right:0;">
        <div class="slides-label"><%= _t('blog.gallery') %></div>
        <div class="slides-carousel">
          <div class="slides-track" id="slidesTrack">
            <% _slides.forEach(function(s){ %>
              <div class="slides-slide">
                <img src="<%= s.url %>" alt="<%= s.alt %>" loading="lazy" decoding="async">
                <% if (s.caption) { %><div class="slides-cap"><%= s.caption %></div><% } %>
              </div>
            <% }); %>
          </div>
          <% if (_slides.length > 1) { %>
            <button type="button" class="slides-nav slides-prev" aria-label="<%= _t('blog.prev') %>">‹</button>
            <button type="button" class="slides-nav slides-next" aria-label="<%= _t('blog.next') %>">›</button>
          <% } %>
        </div>
        <% if (_slides.length > 1) { %>
          <div class="slides-dots" id="slidesDots">
            <% _slides.forEach(function(s, i){ %>
              <button type="button" class="slides-dot <%= i === 0 ? 'active' : '' %>" data-idx="<%= i %>" aria-label="<%= _t('blog.slide') %> <%= i+1 %>"></button>
            <% }); %>
          </div>
        <% } %>
      </div>
      <script>
      (function(){
        var track = document.getElementById('slidesTrack');
        if (!track) return;
        var slides = track.children, total = slides.length, idx = 0;
        var dots = document.querySelectorAll('#slidesDots .slides-dot');
        function go(n){
          idx = (n + total) % total;
          track.style.transform = 'translateX(-' + (idx * 100) + '%)';
          dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });
        }
        var prev = document.querySelector('#postSlides .slides-prev');
        var next = document.querySelector('#postSlides .slides-next');
        if (prev) prev.addEventListener('click', function(){ go(idx - 1); });
        if (next) next.addEventListener('click', function(){ go(idx + 1); });
        dots.forEach(function(d){ d.addEventListener('click', function(){ go(parseInt(this.dataset.idx, 10)); }); });
      })();
      </script>
    <% } %>
  <% } %>

  <div class="post-footer">
    <a href="<%= _ct.base %>" class="back-link">← <%= _t('blog.all') %> <%= _ct.label %></a>
    <a href="/#contact" style="font-size:0.82rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--white);background:var(--primary);padding:12px 28px;border-radius:2px;text-decoration:none;"><%= _t('blog.work_with_us') %></a>
  </div>
</div>

<footer>
  <div class="footer-brand"><% if (_brandPre) { %><span style="color:var(--accent-light)"><%= _brandPre %></span><% } %><%- _brandPost %></div>
  <ul class="footer-links">
    <li><a href="/"><%= _t('blog.nav_home') %></a></li>
    <li><a href="/#services"><%= _t('blog.nav_services') %></a></li>
    <li><a href="/blog"><%= _t('blog.nav_blog') %></a></li>
    <li><a href="/#contact"><%= _t('blog.nav_contact') %></a></li>
  </ul>
  <% if (typeof visibility === 'undefined' || !visibility || visibility.admin_link !== false) { %>
  <div style="margin-top:16px;text-align:center;"><a href="<%= typeof centralAuthUrl !== 'undefined' && centralAuthUrl ? centralAuthUrl : '/admin/login' %>" style="color:rgba(253,252,250,0.12);text-decoration:none;font-size:0.6rem;letter-spacing:0.04em;transition:color 0.2s;" onmouseover="this.style.color='rgba(253,252,250,0.3)'" onmouseout="this.style.color='rgba(253,252,250,0.12)'"><%= _t('blog.admin') %></a></div>
  <% } %>
</footer>
<%- include('../partials/_share-modal') %>
<script>
(function() {
  var els = document.querySelectorAll('.reveal');
  if (els.length && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.1 });
    els.forEach(function(el) { obs.observe(el); });
  } else { els.forEach(function(el) { el.classList.add('visible'); }); }
})();
</script>
</body>
</html>
