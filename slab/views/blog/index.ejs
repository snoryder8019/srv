<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/seo-head') %>
  <%
    const _t = (typeof t === 'function') ? t : (k => k);
    const _sp = parseInt(design.nav_logo_split) || 0;
    const _brandPre = _sp > 0 ? (brand?.name||'').slice(0,_sp) : '';
    const _brandPost = _sp > 0 ? (brand?.name||'').slice(_sp) : (brand?.name||'');
    const _ct = (typeof ct !== 'undefined' && ct) ? ct : { type:'blog', base:'/blog', label:'Blog', title:'Insights & Resources', subtitle:'Articles, guides, and updates.' };
  %>
  <link rel="alternate" type="application/rss+xml" title="<%= (brand?.name||'') + ' ' + _ct.label %> — RSS" href="<%= _ct.base %>/feed.rss">
  <link rel="alternate" type="application/atom+xml" title="<%= (brand?.name||'') + ' ' + _ct.label %> — Atom" href="<%= _ct.base %>/feed.atom">
  <%- include('../partials/font-vars') %>
  <style>
    :root {
      --primary:      <%= design.color_primary %>;
      --primary-deep: <%= design.color_primary_deep %>;
      --primary-mid:  <%= design.color_primary_mid %>;
      --accent:       <%= design.color_accent %>;
      --accent-light: <%= design.color_accent_light %>;
      --bg:           <%= design.color_bg %>;
      --navy: var(--primary); --navy-deep: var(--primary-deep); --navy-mid: var(--primary-mid);
      --gold: var(--accent); --gold-light: var(--accent-light); --ivory: var(--bg);
      --ivory-mid: <%= design._border || '#E6E1D6' %>; --dark: <%= design._on_bg || '#0F1B30' %>; --white: #FDFCFA;
      --on-primary: <%= design._on_primary || '#FDFCFA' %>; --on-primary-deep: <%= design._on_primary_deep || '#FDFCFA' %>;
      --on-primary-mid: <%= design._on_primary_mid || '#FDFCFA' %>;
      --on-bg: <%= design._on_bg || '#0F1B30' %>; --on-bg-muted: <%= design._on_bg_muted || '#6B7380' %>;
      --on-accent: <%= design._on_accent || '#0F1B30' %>; --on-accent-light: <%= design._on_accent_light || '#0F1B30' %>;
      --surface: <%= design._surface || '#FFFFFF' %>; --on-surface: <%= design._on_surface || '#0F1B30' %>;
      --on-surface-muted: <%= design._on_surface_muted || '#6B7380' %>;
      --border: <%= design._border || '#CBD5E1' %>; --placeholder: <%= design._placeholder || '#9CA3AF' %>;
      --slate: var(--on-bg-muted);
      --font-heading: '<%= design.font_heading %>', serif;
      --font-body: '<%= design.font_body %>', sans-serif;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family: var(--font-body); background:var(--surface); color:var(--on-surface); }
    .reveal { opacity:0; transform:translateY(20px); transition:opacity 0.5s ease, transform 0.5s ease; }
    .reveal.visible { opacity:1; transform:translateY(0); }
    /* nav styles provided by partials/header.ejs */
    .blog-hero { padding:max(140px, var(--nav-clear)) 52px 80px; background:var(--bg); }
    .blog-hero-inner { max-width:800px; margin:0 auto; }
    .eyebrow { font-size:0.72rem; font-weight:600; letter-spacing:0.22em; text-transform:uppercase; color:var(--primary); margin-bottom:16px; }
    .blog-hero h1 { font-family:var(--font-heading); font-size:clamp(2.4rem,5vw,4rem); font-weight:300; line-height:1.1; color:var(--on-surface); margin-bottom:16px; }
    .blog-hero p { font-size:1rem; font-weight:300; color:var(--slate); line-height:1.8; }
    .posts-grid { max-width:1100px; margin:0 auto; padding:60px 52px 100px; display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:32px; }
    .post-card { background:var(--surface); border:1px solid var(--border); border-radius:2px; overflow:hidden; transition:box-shadow 0.2s, transform 0.2s; display:flex; flex-direction:column; }
    .post-card:hover { box-shadow:0 8px 32px color-mix(in srgb, var(--primary) 12%, transparent); transform:translateY(-3px); }
    .post-img { width:100%; height:200px; object-fit:cover; background:var(--bg); }
    .post-img-placeholder { width:100%; height:200px; background:linear-gradient(135deg,var(--primary-deep),var(--primary-mid)); display:flex; align-items:center; justify-content:center; }
    .post-img-placeholder span { font-family:var(--font-heading); font-size:3rem; font-weight:300; font-style:italic; color:color-mix(in srgb, var(--accent) 30%, transparent); }
    .post-body { padding:24px; flex:1; display:flex; flex-direction:column; }
    .post-meta { display:flex; gap:12px; align-items:center; margin-bottom:12px; flex-wrap:wrap; }
    .post-category { font-size:0.65rem; font-weight:600; letter-spacing:0.18em; text-transform:uppercase; color:var(--accent); }
    .post-date { font-size:0.72rem; color:var(--slate); font-weight:300; }
    .post-title { font-family:var(--font-heading); font-size:1.3rem; font-weight:400; color:var(--on-surface); line-height:1.3; margin-bottom:12px; text-decoration:none; display:block; }
    .post-title:hover { color:var(--primary); }
    .post-excerpt { font-size:0.88rem; font-weight:300; color:var(--slate); line-height:1.7; flex:1; margin-bottom:20px; }
    .read-more { font-size:0.75rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:var(--primary); text-decoration:none; display:inline-flex; align-items:center; gap:6px; margin-top:auto; }
    .read-more:hover { color:var(--accent); }
    .no-posts { text-align:center; padding:80px 24px; color:var(--slate); }
    .no-posts p { font-size:1rem; font-weight:300; }
    footer { background:var(--primary-deep); padding:48px 52px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:24px; }
    .footer-brand { font-family:var(--font-heading); font-size:1.3rem; font-weight:300; color:color-mix(in srgb, var(--on-primary-deep) 60%, transparent); }
    .footer-links { list-style:none; display:flex; gap:24px; }
    .footer-links a { font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:color-mix(in srgb, var(--on-primary-deep) 35%, transparent); text-decoration:none; transition:color 0.2s; }
    .footer-links a:hover { color:var(--accent-light); }
    .hero-feeds { margin-top:20px; font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--slate); display:flex; gap:10px; align-items:center; }
    .hero-feeds a { color:var(--primary); text-decoration:none; font-weight:600; }
    .hero-feeds a:hover { color:var(--accent); }
    .sub-flash { max-width:800px; margin:24px auto 0; padding:14px 20px; border-radius:2px; font-size:0.88rem; font-weight:300; }
    .sub-ok { background:color-mix(in srgb, var(--accent) 14%, transparent); color:var(--on-surface); border:1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
    .sub-err { background:rgba(185,28,28,0.08); color:#8B1C1C; border:1px solid rgba(185,28,28,0.3); }
    .sub-box { padding:40px 52px 0; }
    .sub-box-inner { max-width:800px; margin:0 auto; background:var(--bg); border:1px solid var(--border); border-radius:3px; padding:36px 40px; text-align:center; }
    .sub-box-inner h2 { font-family:var(--font-heading); font-size:1.6rem; font-weight:300; color:var(--on-surface); margin-bottom:8px; }
    .sub-box-inner > p { font-size:0.9rem; font-weight:300; color:var(--slate); margin-bottom:20px; }
    .sub-form { display:flex; gap:10px; max-width:480px; margin:0 auto; flex-wrap:wrap; }
    .sub-form input[type=email] { flex:1; min-width:200px; padding:12px 16px; border:1px solid var(--border); border-radius:2px; font-family:var(--font-body); font-size:0.95rem; color:var(--on-surface); background:var(--surface); outline:none; }
    .sub-form input[type=email]:focus { border-color:var(--primary); }
    .sub-form button { padding:12px 28px; background:var(--primary); color:var(--on-primary); border:none; border-radius:2px; cursor:pointer; font-size:0.78rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; transition:background 0.2s; }
    .sub-form button:hover { background:var(--primary-deep); }
    .sub-feed-note { font-size:0.72rem; color:var(--slate); margin-top:16px; }
    .sub-feed-note a { color:var(--primary); text-decoration:none; font-weight:600; }
  </style>
</head>
<body>
<%- include("../partials/header", { activePage: _ct.type }) %>

<div class="blog-hero">
  <div class="blog-hero-inner">
    <p class="eyebrow"><%= (brand?.name ? brand.name + ' ' : '') + _ct.label %></p>
    <h1><%- _ct.title %></h1>
    <p><%= _ct.subtitle %></p>
    <div class="hero-feeds">
      <a href="<%= _ct.base %>/feed.rss" title="<%= _t('blog.rss_feed') %>">RSS</a>
      <span aria-hidden="true">·</span>
      <a href="<%= _ct.base %>/feed.atom" title="<%= _t('blog.atom_feed') %>">Atom</a>
    </div>
  </div>
</div>

<% if (typeof subscribed !== 'undefined' && subscribed) { %>
  <div class="sub-flash sub-ok">✓ <%= _t('blog.almost_there') %></div>
<% } else if (typeof suberror !== 'undefined' && suberror) { %>
  <div class="sub-flash sub-err"><%= _t('blog.sub_error') %></div>
<% } %>

<section class="sub-box">
  <div class="sub-box-inner">
    <h2><%= _t('blog.subscribe_to', { label: _ct.label }) %></h2>
    <p><%= _t('blog.sub_pitch', { label: _ct.label.toLowerCase() }) %></p>
    <form class="sub-form" method="POST" action="<%= _ct.base %>/subscribe">
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
      <input type="email" name="email" required placeholder="you@example.com" aria-label="<%= _t('blog.email_address') %>">
      <button type="submit"><%= _t('blog.subscribe') %></button>
    </form>
    <p class="sub-feed-note"><%= _t('blog.prefer_reader') %> <a href="<%= _ct.base %>/feed.rss">RSS</a> <%= _t('blog.or') %> <a href="<%= _ct.base %>/feed.atom">Atom</a>.</p>
  </div>
</section>

<% if (!posts || posts.length === 0) { %>
  <div class="no-posts">
    <p><%= _t('blog.no_posts') %></p>
    <div style="margin-top:24px;"><a href="/" style="font-size:0.82rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--primary);text-decoration:none;">← <%= _t('blog.back_home') %></a></div>
  </div>
<% } else { %>
  <div class="posts-grid">
    <% posts.forEach(post => { %>
      <div class="post-card reveal">
        <% if (post.featuredImageUrl) { %>
          <img src="<%= post.featuredImageUrl %>" alt="<%= post.title %>" class="post-img">
        <% } else { %>
          <div class="post-img-placeholder"><span><%= (brand?.name || '?').charAt(0) %></span></div>
        <% } %>
        <div class="post-body">
          <div class="post-meta">
            <% if (post.category) { %><span class="post-category"><%= post.category %></span><% } %>
            <span class="post-date"><%= new Date(post.publishedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span>
          </div>
          <a href="<%= _ct.base %>/<%= post.slug %>" class="post-title"><%= post.title %></a>
          <% if (post.excerpt) { %>
            <p class="post-excerpt"><%= post.excerpt %></p>
          <% } %>
          <a href="<%= _ct.base %>/<%= post.slug %>" class="read-more"><%= _t('blog.read_more') %> →</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<footer>
  <div class="footer-brand"><% if (_brandPre) { %><span style="color:var(--accent-light)"><%= _brandPre %></span><% } %><%- _brandPost %></div>
  <ul class="footer-links">
    <li><a href="/"><%= _t('blog.nav_home') %></a></li>
    <li><a href="/#services"><%= _t('blog.nav_services') %></a></li>
    <li><a href="/blog"><%= _t('blog.nav_blog') %></a></li>
    <li><a href="/#contact"><%= _t('blog.nav_contact') %></a></li>
  </ul>
  <% if (typeof visibility === 'undefined' || !visibility || visibility.admin_link !== false) { %>
  <div style="margin-top:16px;text-align:center;"><a href="<%= typeof centralAuthUrl !== 'undefined' && centralAuthUrl ? centralAuthUrl : '/admin/login' %>" style="color:rgba(253,252,250,0.12);text-decoration:none;font-size:0.6rem;letter-spacing:0.04em;transition:color 0.2s;" onmouseover="this.style.color='rgba(253,252,250,0.3)'" onmouseout="this.style.color='rgba(253,252,250,0.12)'"><%= _t('blog.admin') %></a></div>
  <% } %>
</footer>
<script>
(function() {
  var els = document.querySelectorAll('.reveal');
  if (els.length && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.1 });
    els.forEach(function(el) { obs.observe(el); });
  } else { els.forEach(function(el) { el.classList.add('visible'); }); }
})();
</script>
</body>
</html>
