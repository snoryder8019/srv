<%
  // ============================================================
  // Slab skin: TERMINAL / CRT ("cronjot") — block-driven skin.
  // Full-page document. Visual design preserved; content sourced
  // from EJS locals. Guard everything; never crash on missing data.
  // ============================================================
  const blocks        = Array.isArray(locals.blocks) ? locals.blocks : [];
  const design        = locals.design  || {};
  const brand         = locals.brand   || {};
  const logos         = locals.logos   || {};
  const navLinks      = Array.isArray(locals.navLinks) ? locals.navLinks : [];
  const visibility    = locals.visibility || {};
  const centralAuthUrl= locals.centralAuthUrl || '/admin/login';

  const accent    = (design.color_accent && String(design.color_accent).trim()) ? String(design.color_accent).trim() : '#4ade80';
  const brandName = (brand.name && String(brand.name).trim()) ? String(brand.name).trim() : 'terminal';
  const tagline   = brand.tagline ? String(brand.tagline).trim() : '';
  const services  = Array.isArray(brand.services) ? brand.services.filter(Boolean) : [];

  const showHeader = visibility.header !== false;
  const showFooter = visibility.footer !== false;

  const navLogo    = logos.logo_primary || logos.logo_white || '';
  const useLogoImg = navLogo && design.nav_logo_display !== 'text';

  const headerLinks = navLinks.filter(function (l) { return l && l.label && (l.location === 'header' || l.location === 'both' || !l.location); });
  const footerLinks = navLinks.filter(function (l) { return l && l.label && (l.location === 'footer' || l.location === 'both'); });

  // small helpers for the man-page card decoration (visual only)
  const cardGlyphs = [
    "┌─◉─┐\n│ ! │\n└─▼─┘",
    "≡ ≡ ≡ ≡\n≡ ≡ ≡ ≡\n▔▔▔▔▔▔",
    "↻ ─→ ✓\n│\n└──✕──┘",
    "◇──◇──◇\n│  │  │\n└─ 1 file"
  ];
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= brandName %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     TERMINAL skin — single theme (CRT / phosphor). No light mode.
     ============================================================ */
  :root {
    --ground:      #080b08;
    --panel:       #0c1410;
    --panel-2:     #0a110d;
    --line:        #163021;
    --line-bright: #1f5233;
    --green:       <%= accent %>;   /* phosphor primary — wired to brand accent */
    --green-dim:   #2f6f43;
    --amber:       #ffb454;
    --text:        #8aa894;
    --text-bright: #cfe6d5;
    --text-faint:  #4d6656;
    --red:         #f87171;

    --mono: "JetBrains Mono", ui-monospace,"SF Mono","Cascadia Code","Roboto Mono",Menlo,Consolas,monospace;

    --maxw: 1120px;
    --radius: 4px;
    --ease: cubic-bezier(.22,.61,.36,1);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  html, body { max-width: 100%; overflow-x: hidden; }

  body {
    margin: 0; background: var(--ground); color: var(--text);
    font-family: var(--mono); font-size: 15px; line-height: 1.6;
    -webkit-font-smoothing: antialiased; letter-spacing: .1px;
  }

  /* ---- CRT overlays ---- */
  .crt-scan, .crt-vignette, .crt-flicker { position: fixed; inset: 0; pointer-events: none; z-index: 90; }
  .crt-scan {
    background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 2px, rgba(0,0,0,.28) 3px, rgba(0,0,0,0) 4px);
    mix-blend-mode: multiply; opacity: .5; animation: scandrift 8s linear infinite;
  }
  @keyframes scandrift { from { background-position: 0 0; } to { background-position: 0 96px; } }
  .crt-vignette {
    background:
      radial-gradient(120% 90% at 50% 30%, rgba(74,222,128,.04), transparent 55%),
      radial-gradient(140% 120% at 50% 50%, transparent 60%, rgba(0,0,0,.55) 100%);
  }
  .crt-flicker { background: rgba(74,222,128,.012); animation: flick 5s steps(2) infinite; }
  @keyframes flick { 0%,97%,100% { opacity: .5; } 98% { opacity: .9; } 99% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .crt-scan, .crt-flicker { animation: none; } }

  /* ---- layout ---- */
  .wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
  section { position: relative; z-index: 1; }

  .eyebrow {
    font-size: 11.5px; letter-spacing: .28em; text-transform: uppercase;
    color: var(--green-dim); font-weight: 600; margin: 0 0 18px;
    display: inline-flex; align-items: center; gap: 10px;
  }
  .eyebrow::before { content: "//"; color: var(--line-bright); }

  h1,h2,h3 { color: var(--text-bright); font-weight: 700; text-wrap: balance; letter-spacing: -.2px; }
  a { color: var(--green); text-decoration: none; }
  a:focus-visible, button:focus-visible, .copy:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 2px; }

  .tag {
    font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--green); border: 1px solid var(--green-dim);
    padding: 1px 6px; border-radius: 3px; white-space: nowrap;
  }
  .tag.amber { color: var(--amber); border-color: #6b4a1c; }

  /* ---- NAV ---- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(8,11,8,.72); backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent; transition: border-color .3s var(--ease), background .3s var(--ease);
  }
  nav.scrolled { border-bottom-color: var(--line); background: rgba(8,11,8,.9); }
  .nav-inner { max-width: var(--maxw); margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .wordmark { display: flex; align-items: baseline; gap: 9px; color: var(--text-bright); font-weight: 700; font-size: 16px; letter-spacing: .5px; }
  .wordmark img { height: 26px; width: auto; display: block; align-self: center; }
  .wordmark .glyph { color: var(--green); font-weight: 700; }
  .wordmark .caret { color: var(--amber); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .wordmark .caret { animation: none; } }

  .nav-links { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .nav-links a.navlink { color: var(--text); font-size: 13px; padding: 6px 11px; border-radius: 3px; transition: color .2s, background .2s; }
  .nav-links a.navlink:hover { color: var(--text-bright); background: var(--panel); }
  .nav-links a.star { color: var(--text-bright); border: 1px solid var(--line-bright); display: inline-flex; align-items: center; gap: 7px; }
  .nav-links a.star:hover { border-color: var(--green-dim); box-shadow: 0 0 18px -6px var(--green); }
  .nav-links a.star .st { color: var(--amber); }

  /* ---- HERO ---- */
  .hero { padding: 132px 0 68px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1.15fr; gap: 52px; align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .hero h1 { font-size: clamp(30px, 5vw, 50px); line-height: 1.06; margin: 14px 0 0; }
  .hero h1 .hl { color: var(--green); }
  .hero .sub { margin: 22px 0 0; max-width: 46ch; font-size: 16px; color: var(--text); }
  .hero .sub b { color: var(--text-bright); font-weight: 600; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; align-items: center; }
  .copy {
    display: inline-flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 14px; cursor: pointer;
    background: var(--panel); color: var(--text-bright); border: 1px solid var(--green-dim);
    border-radius: var(--radius); padding: 12px 15px; transition: border-color .2s, box-shadow .2s, transform .06s;
  }
  .copy:hover { border-color: var(--green); box-shadow: 0 0 28px -8px var(--green); }
  .copy:active { transform: translateY(1px); }
  .copy .p { color: var(--green); user-select: none; }
  .copy code { color: var(--text-bright); background: none; }
  .copy .ico { margin-left: 4px; color: var(--text-faint); font-size: 12px; border-left: 1px solid var(--line); padding-left: 12px; transition: color .2s; min-width: 58px; text-align: left; }
  .copy:hover .ico { color: var(--green); }
  .copy.copied .ico { color: var(--amber); }

  .btn-ghost {
    display: inline-flex; align-items: center; gap: 9px; font-family: var(--mono); font-size: 14px; cursor: pointer;
    background: transparent; color: var(--text-bright); border: 1px solid var(--line-bright);
    border-radius: var(--radius); padding: 12px 18px; transition: border-color .2s, background .2s;
  }
  .btn-ghost:hover { border-color: var(--green-dim); background: var(--panel); }
  .btn-ghost .st { color: var(--amber); }

  .hero-meta { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 12px; color: var(--text-faint); }
  .hero-meta span { display: inline-flex; align-items: center; gap: 7px; }
  .hero-meta .ok { color: var(--green); }

  /* ---- terminal window ---- */
  .term {
    background: linear-gradient(180deg, #0c140f 0%, #0a110c 100%); border: 1px solid var(--line-bright); border-radius: 7px;
    box-shadow: 0 0 0 1px rgba(0,0,0,.5), 0 40px 80px -40px rgba(0,0,0,.9), 0 0 60px -20px rgba(74,222,128,.15);
    overflow: hidden; position: relative;
  }
  .term::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 90px -30px rgba(74,222,128,.12); }
  .term-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.015); }
  .dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .dot.r { background: #43201f; box-shadow: inset 0 0 0 1px #61302c; }
  .dot.y { background: #4a3a1a; box-shadow: inset 0 0 0 1px #6b5222; }
  .dot.g { background: #1c3a26; box-shadow: inset 0 0 0 1px #2c5a3a; }
  .term-title { margin-left: 8px; font-size: 12px; color: var(--text-faint); letter-spacing: .06em; display: flex; align-items: center; gap: 8px; }
  .term-title .path { color: var(--text); }
  .term-body { padding: 18px 18px 22px; font-size: 13.5px; line-height: 1.75; min-height: 336px; overflow-x: auto; }
  .term-body::-webkit-scrollbar { height: 8px; }
  .term-body::-webkit-scrollbar-thumb { background: var(--line-bright); border-radius: 4px; }
  .ln { white-space: pre; opacity: 0; }
  .ln.show { opacity: 1; }
  .prompt { color: var(--green); }
  .prompt .usr { color: var(--green-dim); }
  .cmd { color: var(--text-bright); }
  .out { color: var(--text); }
  .dim { color: var(--text-faint); }
  .ok  { color: var(--green); }
  .warn{ color: var(--amber); }
  .err { color: var(--red); }
  .accent { color: var(--amber); }
  .cursor { display: inline-block; width: .62ch; height: 1.15em; margin-left: 1px; background: var(--green); vertical-align: -2px; animation: blink 1s steps(1) infinite; box-shadow: 0 0 8px var(--green); }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  /* ---- STAT BAND ---- */
  .band { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: linear-gradient(180deg, rgba(74,222,128,.02), transparent), var(--panel-2); padding: 8px 0; }
  .band .sec-head { padding-top: 40px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  @media (max-width: 720px) { .stats { grid-template-columns: repeat(2,1fr); } }
  .stat { padding: 34px 24px; text-align: center; position: relative; }
  .stat + .stat::before { content: ""; position: absolute; left: 0; top: 22%; bottom: 22%; border-left: 1px solid var(--line); }
  .stat .num { font-size: clamp(28px, 4vw, 40px); font-weight: 700; color: var(--green); font-variant-numeric: tabular-nums; letter-spacing: -1px; line-height: 1; text-shadow: 0 0 22px rgba(74,222,128,.25); }
  .stat .lbl { margin-top: 12px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--text-faint); }

  /* ---- GENERIC SECTION ---- */
  .sec { padding: 92px 0; }
  .sec-head { max-width: 62ch; margin-bottom: 46px; }
  .sec-head h2 { font-size: clamp(24px, 3.4vw, 34px); margin: 0; line-height: 1.15; }
  .sec-head p { margin: 16px 0 0; max-width: 62ch; }
  .rule { color: var(--line-bright); font-size: 12px; letter-spacing: 0; overflow: hidden; white-space: nowrap; user-select: none; margin: 0; opacity: .8; }

  /* ---- FEATURES (man-page cards) ---- */
  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 860px) { .feat-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 560px) { .feat-grid { grid-template-columns: 1fr; } }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 20px 24px; position: relative; transition: border-color .25s var(--ease), box-shadow .25s var(--ease), transform .25s var(--ease); }
  .card:hover { border-color: var(--green-dim); box-shadow: 0 0 40px -18px var(--green), inset 0 0 40px -30px rgba(74,222,128,.3); transform: translateY(-2px); }
  .card .man { font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 16px; display: flex; justify-content: space-between; }
  .card .glyph { font-size: 13px; color: var(--green); line-height: 1.25; white-space: pre; display: block; margin-bottom: 16px; opacity: .9; }
  .card h3 { font-size: 16px; margin: 0 0 8px; color: var(--text-bright); }
  .card h3 .fn { color: var(--green); }
  .card p { margin: 0; font-size: 13.5px; color: var(--text); }

  /* ---- SPLIT ---- */
  .split-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 44px; align-items: center; }
  @media (max-width: 820px) { .split-grid { grid-template-columns: 1fr; gap: 30px; } }
  .split-media { border: 1px solid var(--line-bright); border-radius: 7px; overflow: hidden; background: var(--panel); box-shadow: 0 0 60px -30px rgba(74,222,128,.2); }
  .split-media img { display: block; width: 100%; height: auto; }
  .split-body h2 { font-size: clamp(24px, 3.4vw, 34px); margin: 0 0 16px; }

  /* ---- PRICING ---- */
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: start; }
  @media (max-width: 820px) { .tiers { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; } }
  .tier { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 26px 24px; position: relative; transition: border-color .25s, box-shadow .25s; }
  .tier:hover { border-color: var(--line-bright); }
  .tier.feat { border-color: var(--green-dim); box-shadow: 0 0 60px -30px var(--green); background: linear-gradient(180deg, rgba(74,222,128,.04), transparent 40%), var(--panel); }
  .tier .badge { position: absolute; top: -1px; right: 18px; transform: translateY(-50%); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; background: var(--amber); color: #0a0a0a; font-weight: 700; padding: 3px 9px; border-radius: 3px; }
  .tier .t-name { font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--text-bright); }
  .tier .t-name .c { color: var(--green); }
  .tier .price { margin: 16px 0 18px; font-size: 34px; font-weight: 700; color: var(--text-bright); font-variant-numeric: tabular-nums; }
  .tier ul { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 10px; }
  .tier li { font-size: 13px; color: var(--text); display: grid; grid-template-columns: 18px 1fr; gap: 8px; }
  .tier li .c { color: var(--green); }
  .tier .t-btn { display: block; text-align: center; width: 100%; font-family: var(--mono); font-size: 13px; cursor: pointer; padding: 11px; border-radius: var(--radius); border: 1px solid var(--line-bright); background: transparent; color: var(--text-bright); transition: border-color .2s, background .2s, box-shadow .2s; }
  .tier .t-btn:hover { border-color: var(--green-dim); background: var(--panel-2); }
  .tier.feat .t-btn { border-color: var(--green-dim); background: rgba(74,222,128,.06); color: var(--green); }
  .tier.feat .t-btn:hover { box-shadow: 0 0 26px -8px var(--green); background: rgba(74,222,128,.1); }

  /* ---- TESTIMONIALS ---- */
  .quote-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  @media (max-width: 820px) { .quote-grid { grid-template-columns: 1fr; } }
  .quote { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 20px; }
  .quote .q { color: var(--text-bright); font-size: 14px; margin: 0 0 16px; }
  .quote .q::before { content: "\201C"; color: var(--green); }
  .quote .who { font-size: 12px; color: var(--text-faint); }
  .quote .who b { color: var(--green); font-weight: 600; }

  /* ---- FAQ ---- */
  .faq { display: grid; gap: 12px; max-width: 820px; }
  .faq details { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 18px; }
  .faq summary { cursor: pointer; list-style: none; padding: 14px 0; color: var(--text-bright); font-size: 14px; display: flex; gap: 12px; align-items: baseline; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before { content: "$"; color: var(--green); }
  .faq details[open] summary::before { content: ">"; color: var(--amber); }
  .faq .a { padding: 0 0 16px 20px; margin: 0; color: var(--text); font-size: 13.5px; }

  /* ---- TICKER ---- */
  .ticker { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--panel-2); overflow: hidden; padding: 12px 0; }
  .ticker-track { display: inline-flex; gap: 40px; white-space: nowrap; animation: tick 26s linear infinite; }
  .ticker-track span { color: var(--text); font-size: 12.5px; letter-spacing: .1em; }
  .ticker-track span::before { content: "\25b8 "; color: var(--green); }
  @keyframes tick { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }

  /* ---- CLOSING CTA ---- */
  .closing { padding: 96px 0; text-align: center; position: relative; }
  .closing::before { content: ""; position: absolute; inset: 0; background: radial-gradient(60% 100% at 50% 0%, rgba(74,222,128,.06), transparent 70%); pointer-events: none; }
  .closing h2 { font-size: clamp(26px, 4vw, 40px); margin: 0 auto; max-width: 20ch; }
  .closing p { margin: 18px auto 0; max-width: 52ch; }
  .closing .cta-row { justify-content: center; }

  /* ---- generic fallback block ---- */
  .fallback h2 { font-size: clamp(22px,3vw,30px); margin: 0 0 14px; }
  .fallback p { max-width: 64ch; }

  /* ---- FOOTER ---- */
  footer { border-top: 1px solid var(--line); padding: 40px 0 56px; font-size: 12.5px; color: var(--text-faint); }
  .foot-inner { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: center; }
  .foot-cols { display: flex; flex-wrap: wrap; gap: 28px; }
  footer a { color: var(--text); }
  footer a:hover { color: var(--green); }
  .foot-note { display: flex; align-items: center; gap: 10px; }
  .foot-note .blk { color: var(--green); }

  /* ---- reveal ---- */
  .reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s var(--ease), transform .6s var(--ease); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1 !important; transform: none !important; transition: none; } }

  .skip { position: absolute; left: -999px; top: 8px; z-index: 200; background: var(--panel); border: 1px solid var(--green-dim); color: var(--green); padding: 8px 14px; border-radius: 4px; }
  .skip:focus { left: 12px; }
</style>
</head>
<body>

<div class="crt-vignette" aria-hidden="true"></div>
<div class="crt-scan" aria-hidden="true"></div>
<div class="crt-flicker" aria-hidden="true"></div>

<a class="skip" href="#main">Skip to content</a>

<% if (showHeader) { %>
<!-- ============================ NAV ============================ -->
<nav id="nav" aria-label="Primary">
  <div class="nav-inner">
    <a class="wordmark" href="#top" aria-label="<%= brandName %> home">
      <% if (useLogoImg) { %>
        <img src="<%= navLogo %>" alt="<%= brandName %>">
      <% } else { %>
        <span class="glyph" aria-hidden="true">▮</span><%= brandName %><span class="caret" aria-hidden="true">_</span>
      <% } %>
    </a>
    <% if (headerLinks.length) { %>
    <div class="nav-links">
      <% headerLinks.forEach(function (nl, i) { %>
        <a class="navlink<%= i === headerLinks.length - 1 ? ' star' : '' %>"
           href="<%= nl.url || '#' %>"<% if (nl.target === '_blank') { %> target="_blank" rel="noopener"<% } %>>
          <% if (i === headerLinks.length - 1) { %><span class="st" aria-hidden="true">★</span> <% } %><%= nl.label %>
        </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</nav>
<% } %>

<main id="main">
<span id="top"></span>

<% blocks.forEach(function (block) {
     if (!block || !block.type) return;
     const f  = block.fields || {};
     const im = block.images || {};
     const type = block.type;
%>

<% if (type === 'hero') { %>
<!-- ==================== HERO ==================== -->
<section class="hero" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <% if (tagline) { %><p class="eyebrow reveal"><%= tagline %></p><% } %>
      <% if (f.heading) { %>
        <h1 class="reveal"><span class="hl" data-slab-field="heading"><%- f.heading %></span></h1>
      <% } %>
      <% if (f.subheading) { %>
        <p class="sub reveal" data-slab-field="subheading"><%- f.subheading %></p>
      <% } %>

      <% if (f.cta_text || f.cta_link) { %>
      <div class="cta-row reveal">
        <% if (f.cta_text) { %>
        <button type="button" class="copy" data-copy="<%= f.cta_text %>" aria-label="Copy command to clipboard">
          <span class="p" aria-hidden="true">$</span>
          <code data-slab-field="cta_text"><%- f.cta_text %></code>
          <span class="ico" aria-hidden="true">[ copy ]</span>
        </button>
        <% } %>
        <% if (f.cta_link) { %>
        <a class="btn-ghost" href="<%= f.cta_link %>"><span class="st" aria-hidden="true">▸</span> open</a>
        <% } %>
      </div>
      <% } %>

      <% if (services.length) { %>
      <div class="hero-meta reveal">
        <% services.slice(0,4).forEach(function (s) { %><span><span class="ok">[✓]</span> <%= s %></span><% }); %>
      </div>
      <% } %>
    </div>

    <!-- living terminal (reads the editable heading/subheading nodes above) -->
    <div class="term reveal" data-term data-brand="<%= brandName %>" role="img"
         aria-label="Terminal panel for <%= brandName %>.">
      <div class="term-bar" aria-hidden="true">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        <span class="term-title">▮ <%= brandName %> — <span class="path">~/ops</span> — zsh</span>
      </div>
      <div class="term-body" aria-hidden="true"></div>
    </div>
  </div>
</section>

<% } else if (type === 'stats') { %>
<!-- ==================== STATS ==================== -->
<section class="band" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>" aria-label="Stats">
  <div class="wrap">
    <% if (f.heading) { %>
    <div class="sec-head reveal"><h2 data-slab-field="heading"><%- f.heading %></h2></div>
    <% } %>
    <div class="stats">
      <% [1,2,3,4].forEach(function (i) {
           var num = f['stat' + i + '_num']; var lbl = f['stat' + i + '_label'];
           if (!num && !lbl) return; %>
      <div class="stat reveal">
        <% if (num) { %><div class="num"><span class="cu" data-cu="<%= num %>" data-slab-field="stat<%= i %>_num"><%- num %></span></div><% } %>
        <% if (lbl) { %><div class="lbl" data-slab-field="stat<%= i %>_label"><%- lbl %></div><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<% } else if (type === 'cards') { %>
<!-- ==================== CARDS (man-page) ==================== -->
<section class="sec" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap">
    <% if (f.heading || f.subtext) { %>
    <div class="sec-head reveal">
      <p class="eyebrow">man <%= brandName %></p>
      <% if (f.heading) { %><h2 data-slab-field="heading"><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><p data-slab-field="subtext"><%- f.subtext %></p><% } %>
    </div>
    <% } %>
    <div class="feat-grid">
      <% [1,2,3,4].forEach(function (i) {
           var title = f['card' + i + '_title']; var body = f['card' + i + '_body'];
           if (!title && !body) return; %>
      <div class="card reveal">
        <div class="man"><span><%= brandName %>(1)</span><span class="tag"><%= '0' + i %></span></div>
        <span class="glyph" aria-hidden="true"><%= cardGlyphs[(i - 1) % cardGlyphs.length] %></span>
        <% if (title) { %><h3><span class="fn">▸</span> <span data-slab-field="card<%= i %>_title"><%- title %></span></h3><% } %>
        <% if (body) { %><p data-slab-field="card<%= i %>_body"><%- body %></p><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<% } else if (type === 'text') { %>
<!-- ==================== TEXT ==================== -->
<section class="sec" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap sec-head reveal">
    <% if (f.subheading) { %><p class="eyebrow" data-slab-field="subheading"><%- f.subheading %></p><% } %>
    <% if (f.heading) { %><h2 data-slab-field="heading"><%- f.heading %></h2><% } %>
    <% if (f.body) { %><p data-slab-field="body"><%- f.body %></p><% } %>
  </div>
</section>

<% } else if (type === 'split') { %>
<!-- ==================== SPLIT ==================== -->
<section class="sec" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap split-grid">
    <div class="split-body reveal">
      <% if (f.heading) { %><h2 data-slab-field="heading"><%- f.heading %></h2><% } %>
      <% if (f.body) { %><p data-slab-field="body"><%- f.body %></p><% } %>
      <% if (f.cta_text) { %>
      <div class="cta-row">
        <a class="btn-ghost" href="<%= f.cta_link || '#' %>"><span class="st" aria-hidden="true">▸</span> <span data-slab-field="cta_text"><%- f.cta_text %></span></a>
      </div>
      <% } %>
    </div>
    <% if (im.main_image) { %>
    <div class="split-media reveal"><img src="<%= im.main_image %>" alt="<%= f.heading || brandName %>"></div>
    <% } %>
  </div>
</section>

<% } else if (type === 'cta') { %>
<!-- ==================== CTA ==================== -->
<section class="closing" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap">
    <% if (f.heading) { %><h2 class="reveal" data-slab-field="heading"><%- f.heading %></h2><% } %>
    <% if (f.subtext) { %><p class="reveal" data-slab-field="subtext"><%- f.subtext %></p><% } %>
    <% if (f.btn_text) { %>
    <div class="cta-row reveal">
      <a class="copy" href="<%= f.btn_link || '#' %>">
        <span class="p" aria-hidden="true">$</span>
        <code data-slab-field="btn_text"><%- f.btn_text %></code>
        <span class="ico" aria-hidden="true">→</span>
      </a>
    </div>
    <% } %>
  </div>
</section>

<% } else if (type === 'pricing') { %>
<!-- ==================== PRICING ==================== -->
<section class="sec" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap">
    <% if (f.heading || f.subtext) { %>
    <div class="sec-head reveal">
      <p class="eyebrow">pricing</p>
      <% if (f.heading) { %><h2 data-slab-field="heading"><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><p data-slab-field="subtext"><%- f.subtext %></p><% } %>
    </div>
    <% } %>
    <div class="tiers">
      <% [1,2,3].forEach(function (i) {
           var name = f['tier' + i + '_name']; var price = f['tier' + i + '_price'];
           var feats = f['tier' + i + '_features']; var cta = f['tier' + i + '_cta'];
           if (!name && !price && !feats) return;
           var featList = feats ? String(feats).split('\n').filter(function (x) { return x.trim(); }) : []; %>
      <div class="tier reveal<%= i === 2 ? ' feat' : '' %>">
        <% if (i === 2) { %><span class="badge">popular</span><% } %>
        <% if (name) { %><div class="t-name"><span class="c">$</span> <span data-slab-field="tier<%= i %>_name"><%- name %></span></div><% } %>
        <% if (price) { %><div class="price" data-slab-field="tier<%= i %>_price"><%- price %></div><% } %>
        <% if (featList.length) { %>
        <ul data-slab-field="tier<%= i %>_features">
          <% featList.forEach(function (ft) { %><li><span class="c">✓</span> <span><%- ft %></span></li><% }); %>
        </ul>
        <% } %>
        <% if (cta) { %><a class="t-btn" href="#top" data-slab-field="tier<%= i %>_cta"><%- cta %></a><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<% } else if (type === 'testimonials') { %>
<!-- ==================== TESTIMONIALS ==================== -->
<section class="sec" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap">
    <% if (f.heading || f.subtext) { %>
    <div class="sec-head reveal">
      <% if (f.heading) { %><h2 data-slab-field="heading"><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><p data-slab-field="subtext"><%- f.subtext %></p><% } %>
    </div>
    <% } %>
    <div class="quote-grid">
      <% [1,2,3].forEach(function (i) {
           var q = f['t' + i + '_quote']; var nm = f['t' + i + '_name']; var role = f['t' + i + '_role'];
           if (!q && !nm) return; %>
      <div class="quote reveal">
        <% if (q) { %><p class="q" data-slab-field="t<%= i %>_quote"><%- q %></p><% } %>
        <div class="who">
          <% if (nm) { %><b data-slab-field="t<%= i %>_name"><%- nm %></b><% } %><% if (role) { %> <span data-slab-field="t<%= i %>_role">· <%- role %></span><% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<% } else if (type === 'faq') { %>
<!-- ==================== FAQ ==================== -->
<section class="sec" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap">
    <% if (f.heading) { %>
    <div class="sec-head reveal"><p class="eyebrow">faq</p><h2 data-slab-field="heading"><%- f.heading %></h2></div>
    <% } %>
    <div class="faq">
      <% [1,2,3,4,5].forEach(function (i) {
           var q = f['q' + i]; var a = f['a' + i]; if (!q && !a) return; %>
      <details class="reveal"<%= i === 1 ? ' open' : '' %>>
        <summary data-slab-field="q<%= i %>"><%- q || '' %></summary>
        <% if (a) { %><p class="a" data-slab-field="a<%= i %>"><%- a %></p><% } %>
      </details>
      <% }); %>
    </div>
  </div>
</section>

<% } else if (type === 'ticker') { %>
<!-- ==================== TICKER ==================== -->
<% var items = f.items ? String(f.items).split('|').map(function (x) { return x.trim(); }).filter(Boolean) : []; %>
<% if (items.length) { %>
<section class="ticker" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>" aria-label="Ticker">
  <div class="ticker-track" data-slab-field="items">
    <% items.forEach(function (it) { %><span><%- it %></span><% }); %>
    <% items.forEach(function (it) { %><span aria-hidden="true"><%- it %></span><% }); %>
  </div>
</section>
<% } %>

<% } else { %>
<!-- ==================== FALLBACK ==================== -->
<% if (f.heading || f.body || f.subheading || f.subtext) { %>
<section class="sec fallback" data-slab-block="<%= block.id %>" data-slab-type="<%= block.type %>">
  <div class="wrap sec-head reveal">
    <% if (f.subheading || f.subtext) { %><p class="eyebrow" data-slab-field="<%= f.subheading ? 'subheading' : 'subtext' %>"><%- f.subheading || f.subtext %></p><% } %>
    <% if (f.heading) { %><h2 data-slab-field="heading"><%- f.heading %></h2><% } %>
    <% if (f.body) { %><p data-slab-field="body"><%- f.body %></p><% } %>
  </div>
</section>
<% } %>
<% } %>

<% }); // end blocks.forEach %>

</main>

<% if (showFooter) { %>
<!-- ============================ FOOTER ============================ -->
<footer>
  <div class="wrap foot-inner">
    <div class="foot-note">
      <span class="wordmark" style="font-size:14px"><span class="glyph" aria-hidden="true">▮</span><%= brandName %></span>
      <% if (brand.location) { %><span class="dim"><%= brand.location %></span><% } %>
    </div>
    <% var footCols = footerLinks.length ? footerLinks : headerLinks; %>
    <% if (footCols.length) { %>
    <div class="foot-cols">
      <% footCols.forEach(function (nl) { %>
        <a href="<%= nl.url || '#' %>"<% if (nl.target === '_blank') { %> target="_blank" rel="noopener"<% } %>><%= nl.label %></a>
      <% }); %>
    </div>
    <% } %>
  </div>
  <div class="wrap" style="margin-top:22px">
    <span class="foot-note dim" style="font-size:11.5px">
      <span class="blk" aria-hidden="true">▮</span> © <%= new Date().getFullYear() %> <%= brandName %>
      · <a href="<%= centralAuthUrl %>">admin</a>
    </span>
  </div>
</footer>
<% } %>

<script>
(function () {
  "use strict";
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- NAV border on scroll ---------- */
  var nav = document.getElementById("nav");
  if (nav) {
    var onScroll = function () {
      if (window.scrollY > 8) nav.classList.add("scrolled"); else nav.classList.remove("scrolled");
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  /* ---------- Copy to clipboard (any .copy[data-copy]) ---------- */
  Array.prototype.forEach.call(document.querySelectorAll(".copy[data-copy]"), function (btn) {
    var ico = btn.querySelector(".ico");
    var text = btn.getAttribute("data-copy") || "";
    btn.addEventListener("click", function (ev) {
      if (btn.tagName === "A") ev.preventDefault();
      var done = function () {
        btn.classList.add("copied");
        if (ico) ico.textContent = "[ copied ✓ ]";
        setTimeout(function () { btn.classList.remove("copied"); if (ico) ico.textContent = "[ copy ]"; }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
      } else { fallbackCopy(text); done(); }
    });
  });
  function fallbackCopy(text) {
    var t = document.createElement("textarea");
    t.value = text; t.setAttribute("readonly", "");
    t.style.position = "absolute"; t.style.left = "-9999px";
    document.body.appendChild(t); t.select();
    try { document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(t);
  }

  /* ---------- Scroll reveal (staggered) ---------- */
  var reveals = Array.prototype.slice.call(document.querySelectorAll(".reveal"));
  if (reduce || !("IntersectionObserver" in window)) {
    reveals.forEach(function (el) { el.classList.add("in"); });
  } else {
    var groups = new Map();
    var ro = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target, parent = el.parentElement, sibs = groups.get(parent);
        if (!sibs) { sibs = Array.prototype.slice.call(parent.querySelectorAll(":scope > .reveal")); groups.set(parent, sibs); }
        var i = sibs.indexOf(el);
        el.style.transitionDelay = (Math.max(0, i) * 70) + "ms";
        el.classList.add("in");
        ro.unobserve(el);
      });
    }, { threshold: 0.14, rootMargin: "0px 0px -8% 0px" });
    reveals.forEach(function (el) { ro.observe(el); });
  }

  /* ---------- Count-up stats (robust to non-numeric text) ---------- */
  function countUp(el) {
    var orig = el.getAttribute("data-cu");
    if (orig == null) orig = el.textContent;
    orig = String(orig);
    var m = orig.match(/^(\s*[^\d-]*)(-?[\d][\d,]*(?:\.\d+)?)(.*)$/);
    if (!m || reduce) { el.textContent = orig; return; }
    var prefix = m[1], numStr = m[2], suffix = m[3];
    var grouped = numStr.indexOf(",") !== -1;
    var to = parseFloat(numStr.replace(/,/g, ""));
    var decimals = (numStr.split(".")[1] || "").length;
    if (!isFinite(to)) { el.textContent = orig; return; }
    var dur = 1500, start = performance.now();
    function render(v) {
      var s = decimals ? v.toFixed(decimals) : String(Math.round(v));
      if (grouped) s = Number(s).toLocaleString("en-US", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
      el.textContent = prefix + s + suffix;
    }
    function tick(now) {
      var p = Math.min(1, (now - start) / dur);
      var eased = 1 - Math.pow(1 - p, 3);
      render(to * eased);
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = orig; // restore exact field text
    }
    requestAnimationFrame(tick);
  }
  var cus = document.querySelectorAll(".cu");
  if (!("IntersectionObserver" in window)) {
    Array.prototype.forEach.call(cus, countUp);
  } else {
    var so = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { countUp(e.target); so.unobserve(e.target); } });
    }, { threshold: 0.4 });
    Array.prototype.forEach.call(cus, function (el) { so.observe(el); });
  }

  /* ---------- Living terminal typewriter (per .term[data-term]) ---------- */
  function esc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }
  function textOf(section, sel) {
    if (!section) return "";
    var n = section.querySelector(sel);
    return n ? (n.textContent || "").trim() : "";
  }
  function buildScript(term) {
    var section = term.closest("[data-slab-block]");
    var brandAttr = term.getAttribute("data-brand") || "app";
    var heading = textOf(section, '[data-slab-field="heading"]');
    var sub = textOf(section, '[data-slab-field="subheading"]');
    var cta = textOf(section, '[data-slab-field="cta_text"]');
    var promptStr = '<span class="prompt"><span class="usr">you@' + esc(brandAttr) + '</span> $</span>';
    var install = cta || ("curl -fsSL " + brandAttr + " | sh");
    var s = [];
    s.push({ t: "cmd", h: promptStr + ' <span class="cmd">' + esc(install) + "</span>" });
    if (heading) s.push({ t: "out", h: '<span class="ok">[✓]</span> <span class="out">' + esc(heading) + "</span>" });
    if (sub)     s.push({ t: "out", h: '<span class="dim">→ ' + esc(sub) + "</span>" });
    s.push({ t: "out", h: '<span class="ok">[✓]</span> <span class="out">ready.</span>' });
    s.push({ t: "gap" });
    s.push({ t: "rest", h: promptStr + " " });
    return s;
  }

  function runTerminal(term) {
    var body = term.querySelector(".term-body");
    if (!body) return;
    var script = buildScript(term);
    function makeLine() { var d = document.createElement("div"); d.className = "ln show"; body.appendChild(d); return d; }

    if (reduce) {
      body.innerHTML = "";
      script.forEach(function (s) {
        if (s.t === "gap") { makeLine().innerHTML = "&nbsp;"; return; }
        makeLine().innerHTML = s.h;
      });
      var c = document.createElement("span"); c.className = "cursor";
      if (body.lastChild) body.lastChild.appendChild(c);
      return;
    }

    var cursorEl = document.createElement("span"); cursorEl.className = "cursor";
    var idx = 0;
    function next() {
      if (idx >= script.length) { body.scrollTop = body.scrollHeight; return; }
      var s = script[idx];
      if (s.t === "gap") { makeLine().innerHTML = "&nbsp;"; idx++; setTimeout(next, 130); return; }
      if (s.t === "rest") {
        var rest = makeLine(); rest.innerHTML = s.h; rest.appendChild(cursorEl);
        body.scrollTop = body.scrollHeight; idx++; return;
      }
      var line = makeLine();
      if (s.t === "cmd") {
        typeLine(line, s.h, function () { idx++; setTimeout(next, 260); });
      } else {
        line.innerHTML = s.h; body.scrollTop = body.scrollHeight; idx++; setTimeout(next, 340);
      }
    }
    function typeLine(line, html, done) {
      var container = document.createElement("div"); container.innerHTML = html;
      line.innerHTML = "";
      var nodes = Array.prototype.slice.call(container.childNodes);
      line.appendChild(cursorEl);
      var ni = 0;
      function nextNode() {
        if (ni >= nodes.length) { if (done) done(); return; }
        var node = nodes[ni], clone;
        if (node.nodeType === 1 && node.classList && node.classList.contains("cmd")) {
          clone = document.createElement("span"); clone.className = node.className;
          line.insertBefore(clone, cursorEl);
          var txt = node.textContent, ci = 0;
          (function typeChar() {
            if (ci <= txt.length) {
              clone.textContent = txt.slice(0, ci); body.scrollTop = body.scrollHeight; ci++;
              setTimeout(typeChar, 15 + Math.random() * 22);
            } else { ni++; nextNode(); }
          })();
        } else {
          clone = node.cloneNode(true); line.insertBefore(clone, cursorEl); ni++; nextNode();
        }
      }
      nextNode();
    }
    setTimeout(next, 500);
  }
  Array.prototype.forEach.call(document.querySelectorAll(".term[data-term]"), runTerminal);
})();
</script>
</body>
</html>
