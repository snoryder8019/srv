<%
  /**
   * Font loader — LOCAL-FIRST.
   * ──────────────────────────
   * config/local-fonts.json (generated by scripts/build-local-fonts.mjs, loaded
   * into app.locals.localFonts by app.js) maps family → self-hosted CSS with the
   * ORIGINAL family name ('Jost', not 'Jost Variable'), so templates and saved
   * tenant designs keep working untouched. Self-hosted = no third-party
   * render-blocking request, no FOUT, variable weight axes included.
   *
   * Fallback order per font:
   *   1. design.font_*_spec set (custom CSS2 spec from the picker) → Google
   *   2. family in localFonts → /fonts/<pkg>.css (self-hosted)
   *   3. curated _FONT_MAP spec → Google
   *   4. bare family name → Google (so ANY font still loads)
   *
   * The Google <link> is only emitted when at least one font isn't local.
   * Expects `design` in scope with font_heading / font_body.
   */
  const _LOCAL = (typeof localFonts !== 'undefined' && localFonts) ? localFonts : {};

  const _FONT_MAP = {
    // Heading / serif / display
    'Cormorant Garamond': 'Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400',
    'Playfair Display': 'Playfair+Display:ital,wght@0,400;0,600;1,400',
    'Lora': 'Lora:ital,wght@0,400;0,600;1,400',
    'Merriweather': 'Merriweather:ital,wght@0,300;0,400;0,700;1,300',
    'Libre Baskerville': 'Libre+Baskerville:ital,wght@0,400;0,700;1,400',
    'DM Serif Display': 'DM+Serif+Display:ital@0;1',
    'Fraunces': 'Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,400',
    'Sora': 'Sora:wght@300;400;500;600;700',
    'Space Grotesk': 'Space+Grotesk:wght@300;400;500;600;700',
    'Outfit': 'Outfit:wght@300;400;500;600;700',
    'Bebas Neue': 'Bebas+Neue',
    'Oswald': 'Oswald:wght@300;400;500;600;700',
    // Body / sans-serif
    'Jost': 'Jost:wght@300;400;500;600',
    'Inter': 'Inter:wght@300;400;500;600',
    'Poppins': 'Poppins:wght@300;400;500;600',
    'Raleway': 'Raleway:wght@300;400;500;600',
    'Nunito': 'Nunito:wght@300;400;500;600',
    'DM Sans': 'DM+Sans:wght@300;400;500;600',
    'Work Sans': 'Work+Sans:wght@300;400;500;600',
    'Source Sans 3': 'Source+Sans+3:wght@300;400;500;600',
    'IBM Plex Sans': 'IBM+Plex+Sans:wght@300;400;500;600',
    'Manrope': 'Manrope:wght@300;400;500;600;700',
    'Figtree': 'Figtree:wght@300;400;500;600;700',
    'Karla': 'Karla:wght@300;400;500;600;700',
    'Rubik': 'Rubik:wght@300;400;500;600',
    'Cabin': 'Cabin:wght@400;500;600;700',
    'Barlow': 'Barlow:wght@300;400;500;600',
    'Lexend': 'Lexend:wght@300;400;500;600;700',
    'Geist': 'Geist:wght@300;400;500;600;700',
  };

  const _hFont = design.font_heading || 'Cormorant Garamond';
  const _bFont = design.font_body || 'Jost';
  const _hSpec = (design.font_heading_spec && design.font_heading_spec.trim()) || '';
  const _bSpec = (design.font_body_spec && design.font_body_spec.trim()) || '';
  const _bareFamily = (n) => String(n || '').trim().replace(/\s+/g, '+');

  const _localHrefs = [];   // self-hosted stylesheets to emit
  const _googleSpecs = [];  // CSS2 specs still needing fonts.googleapis.com

  function _resolve(name, spec) {
    // Local first, even over a saved spec: the self-hosted variable font carries
    // every weight/italic a CSS2 spec could request, so local is a superset.
    if (_LOCAL[name]) { _localHrefs.push(_LOCAL[name]); return; }
    // A saved picker spec only counts when it still matches the selected family —
    // specs go stale when the family changes or a template designSnapshot merges
    // over the base design (seen live: spec said Oswald/Open+Sans while the
    // family said Cormorant Garamond → wrong CSS loaded, typography fell back).
    if (spec && spec.split(':')[0] === _bareFamily(name)) { _googleSpecs.push(spec); return; }
    _googleSpecs.push(_FONT_MAP[name] || _bareFamily(name));      // Google fallback
  }
  _resolve(_hFont, _hSpec);
  if (_bFont !== _hFont || _bSpec !== _hSpec) _resolve(_bFont, _bSpec);

  const _uniqLocal = [...new Set(_localHrefs)];
  const _uniqGoogle = [...new Set(_googleSpecs)];
  const _fontsParam = _uniqGoogle.join('&family=');
%>
<% _uniqLocal.forEach(function (href) { %>
<link rel="stylesheet" href="<%= href %>">
<% }); %>
<% if (_uniqGoogle.length) { %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=<%= _fontsParam %>&display=swap" rel="stylesheet">
<% } %>
