<%
  /**
   * Public "on-the-fly" design switcher.
   *
   * A fixed, high-z-index floating dropdown that lets ANY public visitor repaint
   * AND re-compose the live site from the five Upland-TS / Meridian pitch designs
   * — a real layout change per design (hero framing, type, spacing, cards), not a
   * recolor. Applied entirely client-side (CSS custom properties + a
   * `data-mll-design` attribute on <html> that the scoped CSS below keys off) and
   * persisted in localStorage — it NEVER writes to the tenant DB.
   *
   * Gated by design.el_design_switcher === 'true' (see partials/footer.ejs).
   *
   * The five looks mirror mllPitches proposal.css (.mll-pr--<id>):
   *   summit      cinematic letterbox · centered serif restraint
   *   trailhead   editorial indigo · heavy sans heads, dotted eyebrows, staggered cards
   *   ridgeline   magazine · copper rules, drop-cap, oversized numerals, top-rule cards
   *   evergreen   boardroom brochure · centered serif, muted hero
   *   highcountry sand + sunset · tall warm hero
   */
%>
<div id="mll-ds" class="mll-ds" aria-live="polite">
  <button type="button" id="mll-ds-toggle" class="mll-ds__btn" aria-haspopup="true" aria-expanded="false" title="Change the site design">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.55-.2-1-.5-1.4-.3-.4-.5-.85-.5-1.35 0-1.1.9-2 2-2h2.5A4 4 0 0 0 22 11c0-4.97-4.48-9-10-9Z"/>
      <circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="7.5" r="1.2" fill="currentColor" stroke="none"/>
      <circle cx="16.5" cy="10.5" r="1.2" fill="currentColor" stroke="none"/>
    </svg>
    <span class="mll-ds__btn-label">Design</span>
  </button>

  <div id="mll-ds-menu" class="mll-ds__menu" role="menu" hidden>
    <div class="mll-ds__menu-head">Choose a design</div>
    <button type="button" class="mll-ds__opt" role="menuitem" data-ds="__default">
      <span class="mll-ds__swatch"><i style="background:var(--gold)"></i><i style="background:var(--navy)"></i><i style="background:var(--ivory)"></i></span>
      <span class="mll-ds__opt-text"><strong>Site Default</strong><em>As published</em></span>
    </button>
    <div id="mll-ds-opts"></div>
    <div class="mll-ds__foot">Preview only &middot; saved to this device</div>
  </div>
</div>

<style>
  /* ── the control ─────────────────────────────────────────── */
  .mll-ds{position:fixed;left:18px;bottom:18px;z-index:2147483000;font-family:system-ui,sans-serif;}
  .mll-ds *{box-sizing:border-box;}
  .mll-ds__btn{display:inline-flex;align-items:center;gap:7px;cursor:pointer;
    padding:9px 14px;border-radius:999px;border:1px solid rgba(0,0,0,.12);
    background:#fff;color:#14181f;font-size:.78rem;font-weight:600;letter-spacing:.02em;
    box-shadow:0 6px 22px rgba(0,0,0,.18);transition:transform .15s ease,box-shadow .15s ease;}
  .mll-ds__btn:hover{transform:translateY(-1px);box-shadow:0 10px 28px rgba(0,0,0,.24);}
  .mll-ds__btn svg{color:var(--gold,#0F766E);}
  .mll-ds__menu{position:absolute;left:0;bottom:calc(100% + 10px);width:272px;max-height:min(72vh,480px);overflow:auto;
    background:#fff;color:#14181f;border:1px solid rgba(0,0,0,.1);border-radius:12px;
    box-shadow:0 18px 50px rgba(0,0,0,.28);padding:8px;animation:mll-ds-in .16s ease;}
  @keyframes mll-ds-in{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
  .mll-ds__menu-head{font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;font-weight:700;opacity:.55;padding:6px 8px 8px;}
  .mll-ds__opt{display:flex;align-items:center;gap:10px;width:100%;text-align:left;cursor:pointer;padding:8px;border:0;border-radius:8px;background:transparent;color:inherit;}
  .mll-ds__opt:hover{background:rgba(0,0,0,.06);}
  .mll-ds__opt.is-active{background:color-mix(in srgb,var(--gold,#0F766E) 16%,transparent);}
  .mll-ds__swatch{display:inline-flex;flex:0 0 auto;border-radius:6px;overflow:hidden;box-shadow:0 0 0 1px rgba(0,0,0,.1);}
  .mll-ds__swatch i{display:block;width:14px;height:28px;}
  .mll-ds__opt-text{display:flex;flex-direction:column;line-height:1.25;min-width:0;}
  .mll-ds__opt-text strong{font-size:.82rem;font-weight:600;}
  .mll-ds__opt-text em{font-size:.68rem;font-style:normal;opacity:.6;}
  .mll-ds__foot{font-size:.62rem;text-align:center;opacity:.5;padding:8px 4px 2px;}
  @media (max-width:520px){.mll-ds__btn-label{display:none;}.mll-ds{left:14px;bottom:14px;}}
  @media (prefers-reduced-motion:reduce){.mll-ds__menu{animation:none;}.mll-ds__btn{transition:none;}}

  /* ══════════════════════════════════════════════════════════════════════
     PER-DESIGN LOOKS — re-compose slab's landing to echo each pitch design.
     Scoped to html[data-mll-design="<id>"]; cleared on "Site Default".
     ══════════════════════════════════════════════════════════════════════ */

  /* Cinematic hero background per design (the Meridian imagery). Overrides the
     inline server image on slab's full-bleed hero + slideshow slides. */
  html[data-mll-design] .hero-bg-image,
  html[data-mll-design] .hero-slide-bg{background-image:var(--mll-hero-img) !important;background-size:cover;background-position:center;}

  /* SUMMIT · cinematic letterbox, centered serif restraint */
  html[data-mll-design="summit"] .hero{position:relative;}
  html[data-mll-design="summit"] .hero::before,
  html[data-mll-design="summit"] .hero::after{content:"";position:absolute;left:0;right:0;height:clamp(26px,5vh,52px);background:#0b0b0d;z-index:2;pointer-events:none;}
  html[data-mll-design="summit"] .hero::before{top:0;}
  html[data-mll-design="summit"] .hero::after{bottom:0;}
  html[data-mll-design="summit"] .hero-heading{max-width:20ch;margin-left:auto;margin-right:auto;letter-spacing:.005em;}
  html[data-mll-design="summit"] .section-header,
  html[data-mll-design="summit"] .section-heading,
  html[data-mll-design="summit"] .section-eyebrow,
  html[data-mll-design="summit"] .section-sub{text-align:center;margin-left:auto;margin-right:auto;}

  /* TRAILHEAD · editorial indigo — heavy sans heads, dotted eyebrows, staggered cards */
  html[data-mll-design="trailhead"] .hero-heading,
  html[data-mll-design="trailhead"] .section-heading{font-family:'Inter',system-ui,sans-serif !important;font-weight:800 !important;letter-spacing:-.025em !important;}
  html[data-mll-design="trailhead"] .hero-eyebrow,
  html[data-mll-design="trailhead"] .section-eyebrow{border-bottom:1px dotted currentColor;padding-bottom:4px;display:inline-block;}
  html[data-mll-design="trailhead"] .services-grid{background:transparent;gap:18px;}
  html[data-mll-design="trailhead"] .service-card{background:var(--surface);}
  html[data-mll-design="trailhead"] .service-card:nth-child(odd){transform:translateY(16px);}
  html[data-mll-design="trailhead"] .service-card:nth-child(even){transform:translateY(-8px);}
  @media (max-width:820px){
    html[data-mll-design="trailhead"] .service-card:nth-child(odd),
    html[data-mll-design="trailhead"] .service-card:nth-child(even){transform:none;}
  }

  /* RIDGELINE · magazine — copper rules, drop-cap, oversized numerals, top-rule cards */
  html[data-mll-design="ridgeline"] .hero-sub::first-letter{font-family:'Source Serif Pro',Georgia,serif;font-size:3.4em;line-height:.78;font-weight:700;float:left;margin:.04em .12em 0 0;color:var(--accent-2,var(--gold));}
  html[data-mll-design="ridgeline"] .hero-eyebrow,
  html[data-mll-design="ridgeline"] .section-eyebrow{font-style:italic;letter-spacing:.16em;}
  html[data-mll-design="ridgeline"] .section-eyebrow::before{content:"";display:inline-block;width:26px;height:2px;background:var(--accent-2,var(--gold));vertical-align:middle;margin-right:10px;}
  html[data-mll-design="ridgeline"] .service-card{border-top:3px solid var(--accent-2,var(--gold)) !important;border-radius:6px;}
  html[data-mll-design="ridgeline"] .stat strong,
  html[data-mll-design="ridgeline"] .stat-num,
  html[data-mll-design="ridgeline"] .stat-number,
  html[data-mll-design="ridgeline"] .about-stat strong{font-size:clamp(48px,7vw,84px) !important;color:var(--accent-2,var(--gold)) !important;line-height:.9;}

  /* EVERGREEN · boardroom brochure — centered serif, muted hero */
  html[data-mll-design="evergreen"] .section-header,
  html[data-mll-design="evergreen"] .section-heading,
  html[data-mll-design="evergreen"] .section-eyebrow,
  html[data-mll-design="evergreen"] .section-sub,
  html[data-mll-design="evergreen"] .hero-heading{text-align:center;margin-left:auto;margin-right:auto;}
  html[data-mll-design="evergreen"] .hero-bg-image,
  html[data-mll-design="evergreen"] .hero-slide-bg{filter:saturate(.7) brightness(.78);}

  /* HIGHCOUNTRY · sand + sunset — tall warm hero */
  html[data-mll-design="highcountry"] .hero-heading{letter-spacing:.01em;}

  /* ── URBAN SET ─────────────────────────────────────────────── */

  /* METRO · skyline — oversized tight geometric heads, squared bordered cards */
  html[data-mll-design="metro"] .hero-heading,
  html[data-mll-design="metro"] .section-heading{font-weight:700 !important;letter-spacing:-.02em !important;}
  html[data-mll-design="metro"] .hero-eyebrow,
  html[data-mll-design="metro"] .section-eyebrow{text-transform:uppercase;letter-spacing:.24em;font-size:.72em;font-weight:600;}
  html[data-mll-design="metro"] .service-card{border:1px solid color-mix(in srgb,var(--navy) 16%,transparent);}

  /* CORNER OFFICE · executive — refined serif, brass rule under eyebrows */
  html[data-mll-design="boardroom"] .hero-heading,
  html[data-mll-design="boardroom"] .section-heading{font-weight:600;letter-spacing:.005em;}
  html[data-mll-design="boardroom"] .section-eyebrow::after{content:"";display:block;width:44px;height:2px;background:var(--gold);margin-top:8px;}

  /* WORKING RIVER · airy waterfront — soft rounded cards, open spacing */
  html[data-mll-design="river"] .service-card{border-radius:14px;}
  html[data-mll-design="river"] .hero-heading{letter-spacing:.004em;}

  /* THE NEWSROOM · editorial press — condensed uppercase heads, red eyebrows, rules */
  html[data-mll-design="newsroom"] .hero-heading,
  html[data-mll-design="newsroom"] .section-heading{text-transform:uppercase;letter-spacing:.01em;font-weight:600;}
  html[data-mll-design="newsroom"] .hero-eyebrow,
  html[data-mll-design="newsroom"] .section-eyebrow{color:var(--gold) !important;text-transform:uppercase;letter-spacing:.2em;font-weight:700;}
  html[data-mll-design="newsroom"] .service-card{border-radius:0;border-top:2px solid var(--dark) !important;}
  html[data-mll-design="newsroom"] .section-header{border-top:1px solid color-mix(in srgb,var(--dark) 20%,transparent);padding-top:18px;}

  /* NIGHT LINE · after-hours neon — centered, amber glow on accent word */
  html[data-mll-design="nightline"] .section-header,
  html[data-mll-design="nightline"] .section-heading,
  html[data-mll-design="nightline"] .section-eyebrow,
  html[data-mll-design="nightline"] .section-sub,
  html[data-mll-design="nightline"] .hero-heading{text-align:center;margin-left:auto;margin-right:auto;}
  html[data-mll-design="nightline"] .hero-heading em{color:var(--gold);text-shadow:0 0 26px color-mix(in srgb,var(--gold) 55%,transparent);}
  html[data-mll-design="nightline"] .service-card{border-radius:6px;}

  /* ── FINANCE SET — real block/grid restructures (mixes prior looks) ────── */

  /* TRADING FLOOR · wide 4-up hairline grid, centered tight geometric heads */
  html[data-mll-design="tradingfloor"] .section-header{flex-direction:column;align-items:center;text-align:center;max-width:900px;}
  html[data-mll-design="tradingfloor"] .section-sub{text-align:center;max-width:620px;}
  html[data-mll-design="tradingfloor"] .services-grid{grid-template-columns:repeat(4,1fr);max-width:1320px;}
  html[data-mll-design="tradingfloor"] .hero-heading,
  html[data-mll-design="tradingfloor"] .section-heading{font-weight:700 !important;letter-spacing:-.018em !important;}
  html[data-mll-design="tradingfloor"] .service-card{border-top:2px solid var(--gold) !important;}
  @media(max-width:960px){html[data-mll-design="tradingfloor"] .services-grid{grid-template-columns:1fr 1fr;}}

  /* GOLD STANDARD · 2-up spacious floating cards, brass rule, left-stacked header */
  html[data-mll-design="goldreserve"] .services-grid{grid-template-columns:1fr 1fr;gap:24px;background:transparent;max-width:1000px;}
  html[data-mll-design="goldreserve"] .service-card{background:var(--surface);border:1px solid color-mix(in srgb,var(--gold) 32%,transparent);border-radius:4px;}
  html[data-mll-design="goldreserve"] .section-header{flex-direction:column;align-items:flex-start;}
  html[data-mll-design="goldreserve"] .section-sub{text-align:left;max-width:560px;margin-top:6px;}
  html[data-mll-design="goldreserve"] .section-eyebrow::after{content:"";display:block;width:44px;height:2px;background:var(--gold);margin-top:8px;}
  html[data-mll-design="goldreserve"] .hero-heading,
  html[data-mll-design="goldreserve"] .section-heading{font-weight:600;}
  @media(max-width:760px){html[data-mll-design="goldreserve"] .services-grid{grid-template-columns:1fr;}}

  /* THE EXCHANGE · 3-up column-ruled, centered serif, drop-cap lead */
  html[data-mll-design="exchange"] .section-header,
  html[data-mll-design="exchange"] .section-heading,
  html[data-mll-design="exchange"] .section-eyebrow,
  html[data-mll-design="exchange"] .section-sub{text-align:center;margin-left:auto;margin-right:auto;}
  html[data-mll-design="exchange"] .section-header{flex-direction:column;align-items:center;}
  html[data-mll-design="exchange"] .services-grid{gap:0;background:transparent;}
  html[data-mll-design="exchange"] .service-card{background:var(--surface);border-left:1px solid color-mix(in srgb,var(--dark) 15%,transparent);}
  html[data-mll-design="exchange"] .service-card:first-child{border-left:0;}
  html[data-mll-design="exchange"] .hero-sub::first-letter{font-family:'Fraunces',Georgia,serif;font-size:3.2em;line-height:.78;font-weight:700;float:left;margin:.04em .1em 0 0;color:var(--accent-2,var(--gold));}
  @media(max-width:820px){html[data-mll-design="exchange"] .service-card{border-left:0;}}

  /* TICKER · single-column stacked data list, centered glowing heads */
  html[data-mll-design="ticker"] .services-grid{grid-template-columns:1fr;gap:0;background:transparent;max-width:880px;}
  html[data-mll-design="ticker"] .service-card{background:var(--surface);border-bottom:1px solid color-mix(in srgb,var(--dark) 14%,transparent);border-radius:0;}
  html[data-mll-design="ticker"] .section-header,
  html[data-mll-design="ticker"] .section-heading,
  html[data-mll-design="ticker"] .section-eyebrow,
  html[data-mll-design="ticker"] .section-sub,
  html[data-mll-design="ticker"] .hero-heading{text-align:center;margin-left:auto;margin-right:auto;}
  html[data-mll-design="ticker"] .section-header{flex-direction:column;align-items:center;}
  html[data-mll-design="ticker"] .hero-heading em{color:var(--gold);text-shadow:0 0 24px color-mix(in srgb,var(--gold) 60%,transparent);}
  html[data-mll-design="ticker"] .hero-eyebrow,
  html[data-mll-design="ticker"] .section-eyebrow{text-transform:uppercase;letter-spacing:.26em;}

  /* CAPITAL · staggered rounded cards on open grid, heavy sans heads */
  html[data-mll-design="capital"] .services-grid{gap:22px;background:transparent;max-width:1240px;}
  html[data-mll-design="capital"] .service-card{background:var(--surface);border-radius:12px;box-shadow:0 10px 30px rgba(10,18,32,.08);}
  html[data-mll-design="capital"] .service-card:nth-child(even){transform:translateY(20px);}
  html[data-mll-design="capital"] .service-card:nth-child(even):hover{transform:translateY(14px);}
  html[data-mll-design="capital"] .hero-heading,
  html[data-mll-design="capital"] .section-heading{font-weight:700 !important;letter-spacing:-.015em !important;}
  @media(max-width:900px){html[data-mll-design="capital"] .service-card:nth-child(even){transform:none;}}
</style>

<script>
(function () {
  // Five pitch designs → palette + fonts + structural "look" (mirrors proposal.css).
  var P = [
    { id:'summit',      label:'Summit Granite',      tag:'Cinematic · centered serif',
      img:'/images/proposal/summit.png',
      accent:'#0F766E', accent2:'#115E59', ink:'#14181F', paper:'#F5F1E6', cream:'#E9E5DA',
      hFont:'Source Serif Pro', bFont:'Inter', align:'center', radius:'2', pad:'110px 52px', heroH:'100vh', overlay:'.5' },
    { id:'trailhead',   label:'Trailhead Indigo',    tag:'Editorial · heavy sans',
      img:'/images/proposal/trailhead.png',
      accent:'#3730A3', accent2:'#1E40AF', ink:'#1A1F33', paper:'#F4F5FB', cream:'#EAECF4',
      hFont:'Inter', bFont:'Inter', align:'left', radius:'4', pad:'100px 52px', heroH:'100vh', overlay:'.5' },
    { id:'ridgeline',   label:'Ridgeline Slate',     tag:'Magazine · copper rules',
      img:'/images/proposal/ridgeline.png',
      accent:'#B45309', accent2:'#7C2D12', ink:'#1B2128', paper:'#F3F4F6', cream:'#E6E8EA',
      hFont:'Source Serif Pro', bFont:'Inter', align:'left', radius:'6', pad:'96px 52px', heroH:'100vh', overlay:'.5' },
    { id:'evergreen',   label:'Evergreen Boardroom', tag:'Boardroom · centered',
      img:'/images/proposal/evergreen.png',
      accent:'#14532D', accent2:'#166534', ink:'#1A1F1A', paper:'#F7F3E5', cream:'#EFEBDD',
      hFont:'Source Serif Pro', bFont:'Inter', align:'center', radius:'2', pad:'104px 52px', heroH:'100vh', overlay:'.65' },
    { id:'highcountry', label:'High Country Sand',   tag:'Warm · tall hero',
      img:'/images/proposal/highcountry.png',
      accent:'#C2410C', accent2:'#7C2D12', ink:'#20180E', paper:'#FAF3E1', cream:'#EFE7CC',
      hFont:'Fraunces', bFont:'Inter', align:'left', radius:'8', pad:'112px 52px', heroH:'108vh', overlay:'.5' },

    // ── Urban set ──────────────────────────────────────────────
    { id:'metro',       label:'Metropolitan',        tag:'Skyline · bold geometric', group:'Urban',
      img:'/images/proposal/metro.png',
      accent:'#3B82F6', accent2:'#0F172A', ink:'#0B1220', paper:'#EEF2F7', cream:'#DCE3EC',
      hFont:'Space Grotesk', bFont:'Inter', align:'left', radius:'2', pad:'100px 52px', heroH:'100vh', overlay:'.5' },
    { id:'boardroom',   label:'Corner Office',        tag:'Executive · brass serif', group:'Urban',
      img:'/images/proposal/boardroom.png',
      accent:'#A16207', accent2:'#78350F', ink:'#1C1917', paper:'#F5F1EA', cream:'#E7E0D3',
      hFont:'Fraunces', bFont:'Inter', align:'left', radius:'4', pad:'104px 52px', heroH:'100vh', overlay:'.5' },
    { id:'river',       label:'Working River',        tag:'Waterfront · airy teal', group:'Urban',
      img:'/images/proposal/river.png',
      accent:'#0E7490', accent2:'#155E75', ink:'#0C1A1F', paper:'#EEF3F4', cream:'#D9E4E6',
      hFont:'Sora', bFont:'Inter', align:'left', radius:'12', pad:'112px 52px', heroH:'100vh', overlay:'.4' },
    { id:'newsroom',    label:'The Newsroom',         tag:'Editorial · press rules', group:'Urban',
      img:'/images/proposal/newsroom.png',
      accent:'#B42318', accent2:'#1F2937', ink:'#111318', paper:'#F4F1EC', cream:'#E7E2D6',
      hFont:'Oswald', bFont:'Source Serif Pro', align:'left', radius:'0', pad:'96px 52px', heroH:'100vh', overlay:'.55' },
    { id:'nightline',   label:'Night Line',           tag:'After hours · neon amber', group:'Urban',
      img:'/images/proposal/nightline.png',
      accent:'#F59E0B', accent2:'#B45309', ink:'#0A0A12', paper:'#F2F0EC', cream:'#E6E2D8',
      hFont:'Space Grotesk', bFont:'Inter', align:'center', radius:'6', pad:'104px 52px', heroH:'100vh', overlay:'.7' },

    // ── Finance set — mixes the prior layouts, each with a distinct BLOCK grid ──
    { id:'tradingfloor', label:'Trading Floor',       tag:'Live markets · 4-up wide', group:'Finance',
      img:'/images/proposal/tradingfloor.png',
      accent:'#10B981', accent2:'#0F172A', ink:'#0A0F14', paper:'#EEF1F4', cream:'#DBE2E8',
      hFont:'Space Grotesk', bFont:'Inter', align:'center', radius:'2', pad:'92px 52px', heroH:'100vh', overlay:'.55' },
    { id:'goldreserve',  label:'Gold Standard',        tag:'Bullion · 2-up spacious', group:'Finance',
      img:'/images/proposal/goldreserve.png',
      accent:'#B8860B', accent2:'#78350F', ink:'#17130B', paper:'#F6F1E6', cream:'#EAE0C8',
      hFont:'Fraunces', bFont:'Inter', align:'left', radius:'4', pad:'116px 52px', heroH:'100vh', overlay:'.5' },
    { id:'exchange',     label:'The Exchange',         tag:'Neoclassical · columned', group:'Finance',
      img:'/images/proposal/exchange.png',
      accent:'#A16207', accent2:'#1E293B', ink:'#0F1620', paper:'#F1F0EB', cream:'#E4E1D6',
      hFont:'Fraunces', bFont:'Source Serif Pro', align:'center', radius:'0', pad:'108px 52px', heroH:'100vh', overlay:'.55' },
    { id:'ticker',       label:'Ticker',               tag:'Data wall · stacked list', group:'Finance',
      img:'/images/proposal/ticker.png',
      accent:'#22D3EE', accent2:'#0F766E', ink:'#05070A', paper:'#EAF0F2', cream:'#D5E0E4',
      hFont:'Space Grotesk', bFont:'Inter', align:'center', radius:'6', pad:'100px 52px', heroH:'100vh', overlay:'.7' },
    { id:'capital',      label:'Capital',              tag:'Glass canyon · staggered', group:'Finance',
      img:'/images/proposal/capital.png',
      accent:'#2563EB', accent2:'#0F172A', ink:'#0A1220', paper:'#EEF2F8', cream:'#DBE3EE',
      hFont:'Sora', bFont:'Inter', align:'left', radius:'12', pad:'104px 52px', heroH:'100vh', overlay:'.5' }
  ];
  var STORE_KEY = 'mll-design-choice';
  var root = document.documentElement;

  // vars we set (so "Site Default" can clear them and fall back to server values)
  var VARS = ['--navy','--navy-deep','--navy-mid','--gold','--gold-light','--ivory','--ivory-mid',
    '--dark','--white','--surface','--on-surface','--on-surface-muted','--on-ivory','--on-ivory-muted',
    '--on-navy','--on-navy-deep','--on-navy-mid','--on-gold','--on-gold-light','--muted',
    '--accent-2','--accent-3','--hero-overlay','--contact-bg','--mll-hero-img',
    '--font-heading','--font-body','--hero-text-align','--hero-btns-justify',
    '--section-pad','--card-radius','--hero-min-height','--hero-overlay-alpha'];

  // Load the designs' fonts once (Source Serif Pro / Inter / Fraunces).
  (function loadFonts(){
    if (document.getElementById('mll-ds-fonts')) return;
    var l = document.createElement('link'); l.id = 'mll-ds-fonts'; l.rel = 'stylesheet';
    l.href = 'https://fonts.googleapis.com/css2?family=Source+Serif+Pro:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,700;1,9..144,400&family=Space+Grotesk:wght@400;500;600;700&family=Sora:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap';
    document.head.appendChild(l);
  })();

  function mix(c, pct, other){ return 'color-mix(in srgb, ' + c + ' ' + pct + '%, ' + (other||'#ffffff') + ')'; }
  var JUSTIFY = { left:'flex-start', center:'center', right:'flex-end' };

  function apply(p) {
    var muted = mix(p.ink, 55);
    var set = {
      '--navy': p.accent2, '--navy-deep': p.ink, '--navy-mid': p.accent,
      '--gold': p.accent, '--gold-light': mix(p.accent, 62),
      '--ivory': p.paper, '--ivory-mid': p.cream,
      '--dark': p.ink, '--white': '#ffffff',
      '--surface': '#ffffff', '--on-surface': p.ink, '--on-surface-muted': muted,
      '--on-ivory': p.ink, '--on-ivory-muted': muted, '--muted': muted,
      '--on-navy': p.paper, '--on-navy-deep': p.paper, '--on-navy-mid': '#ffffff',
      '--on-gold': '#ffffff', '--on-gold-light': p.ink,
      '--accent-2': p.accent, '--accent-3': p.accent2,
      '--hero-overlay': p.ink, '--contact-bg': p.ink,
      '--mll-hero-img': 'url("' + p.img + '")',
      // structural "look"
      '--font-heading': "'" + p.hFont + "', Georgia, serif",
      '--font-body': "'" + p.bFont + "', system-ui, sans-serif",
      '--hero-text-align': p.align,
      '--hero-btns-justify': JUSTIFY[p.align] || 'flex-start',
      '--section-pad': p.pad,
      '--card-radius': p.radius + 'px',
      '--hero-min-height': p.heroH,
      '--hero-overlay-alpha': p.overlay
    };
    for (var k in set) root.style.setProperty(k, set[k]);
    root.setAttribute('data-mll-design', p.id);
  }

  function clear() { VARS.forEach(function (v) { root.style.removeProperty(v); }); root.removeAttribute('data-mll-design'); }

  function markActive(id) {
    var opts = document.querySelectorAll('.mll-ds__opt');
    for (var i = 0; i < opts.length; i++) opts[i].classList.toggle('is-active', opts[i].getAttribute('data-ds') === id);
  }

  function choose(id, persist) {
    if (id === '__default') clear();
    else {
      var p = P.filter(function (x) { return x.id === id; })[0];
      if (!p) { clear(); id = '__default'; } else apply(p);
    }
    markActive(id);
    if (persist) { try { localStorage.setItem(STORE_KEY, id); } catch (e) {} }
  }

  // Build palette rows, grouped (Scenic / Urban)
  var host = document.getElementById('mll-ds-opts');
  var lastGroup = '';
  P.forEach(function (p) {
    var g = p.group || 'Scenic';
    if (g !== lastGroup) {
      var hdr = document.createElement('div');
      hdr.className = 'mll-ds__menu-head'; hdr.style.marginTop = '6px'; hdr.textContent = g;
      host.appendChild(hdr);
      lastGroup = g;
    }
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'mll-ds__opt'; b.setAttribute('role', 'menuitem'); b.setAttribute('data-ds', p.id);
    b.innerHTML =
      '<span class="mll-ds__swatch">' +
        '<i style="background:' + p.accent + '"></i>' +
        '<i style="background:' + p.accent2 + '"></i>' +
        '<i style="background:' + p.paper + '"></i>' +
      '</span>' +
      '<span class="mll-ds__opt-text"><strong>' + p.label + '</strong><em>' + p.tag + '</em></span>';
    host.appendChild(b);
  });

  // Wire clicks
  document.getElementById('mll-ds-menu').addEventListener('click', function (e) {
    var opt = e.target.closest ? e.target.closest('.mll-ds__opt') : null;
    if (!opt) return;
    choose(opt.getAttribute('data-ds'), true);
    close();
  });

  // Open/close
  var wrap = document.getElementById('mll-ds');
  var toggle = document.getElementById('mll-ds-toggle');
  var menu = document.getElementById('mll-ds-menu');
  function open() { menu.hidden = false; toggle.setAttribute('aria-expanded', 'true'); }
  function close() { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); }
  toggle.addEventListener('click', function (e) { e.stopPropagation(); if (menu.hidden) open(); else close(); });
  document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

  // Restore saved choice
  var saved = null;
  try { saved = localStorage.getItem(STORE_KEY); } catch (e) {}
  if (saved) choose(saved, false); else markActive('__default');
})();
</script>
