<% const _gtmB = (typeof design !== 'undefined' && design && design.gtm_id) || ''; const _bodyHtml = (typeof design !== 'undefined' && design && design.body_end_html) || ''; %>
<% if (_gtmB) { %><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= _gtmB %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><% } %>
<%- _bodyHtml %>
<%
  /* ── Shared tenant footer — single source of truth for all public pages ── */
  /* i18n shim — see header.ejs for rationale. */
  const _t = (typeof t === 'function') ? t : (k => k);
  const _fD = typeof design     !== 'undefined' && design     ? design     : {};
  const _fC = typeof copy       !== 'undefined' && copy       ? copy       : {};
  const _fB = typeof brand      !== 'undefined' && brand      ? brand      : {};
  const _fL = typeof logos      !== 'undefined' && logos      ? logos      : {};
  const _fV = typeof visibility !== 'undefined' && visibility ? visibility : {};
  if (_fV.footer !== false) {
    const _fSiteName    = _fB.name    || '';
    const _fSiteTagline = _fB.tagline || '';
    const _fSplitAt = parseInt(_fD.nav_logo_split) || 0;
    const _fLogoPre  = _fSplitAt > 0 ? _fSiteName.slice(0, _fSplitAt) : '';
    const _fLogoPost = _fSplitAt > 0 ? _fSiteName.slice(_fSplitAt)    : _fSiteName;

    /* Structural tokens */
    const _ftLayout    = _fD.footer_layout    || 'simple';
    const _ftAlign     = _fD.footer_align     || 'center';
    const _ftCols      = parseInt(_fD.footer_columns) || 3;
    const _ftPadY      = _fD.footer_padding_y || '32';
    const _ftPadX      = _fD.footer_padding_x || '24';
    const _ftShowBrand    = _fD.footer_show_brand      !== 'false';
    const _ftShowTagline  = _fD.footer_show_tagline    !== 'false';
    const _ftShowLogo     = _fD.footer_show_logo       === 'true';
    const _ftShowSocial   = _fD.footer_show_social     !== 'false';
    const _ftShowNews     = _fD.footer_show_newsletter !== 'false';
    const _ftShowQR       = _fD.footer_show_qr         !== 'false';

    /* Colors / typography — defaults intentionally produce a dark-footer/light-text
       contrast that works on both light-bodied tenant pages (landing-styles.ejs) and
       dark-bodied slab landing.ejs. Admin design panel can override per-tenant. */
    const _accent       = _fD.color_accent || '#c9a848';
    const _ftBg         = _fD.footer_bg            || 'var(--on-surface, ' + (_fD.color_primary_deep || '#0F1B30') + ')';
    const _ftText       = _fD.footer_text_color    || 'rgba(253,252,250,0.85)';
    const _ftHeading    = _fD.footer_heading_color || 'var(--accent, ' + _accent + ')';
    const _ftLink       = _fD.footer_link_color    || 'rgba(253,252,250,0.65)';
    const _ftLinkHover  = _fD.footer_link_hover_color || 'var(--accent, ' + _accent + ')';
    const _ftBorder     = _fD.footer_border_color  || 'rgba(253,252,250,0.1)';
    const _ftAccent     = _fD.footer_accent_color  || 'var(--accent, ' + _accent + ')';
    const _ftBrandSize  = _fD.footer_brand_size    || '1.2';
    const _ftBrandWeight= _fD.footer_brand_weight  || '500';
    const _ftTextSize   = _fD.footer_text_size     || '0.78';
    const _ftTextWeight = _fD.footer_text_weight   || '400';
    const _ftHSize      = _fD.footer_heading_size  || '0.72';
    const _ftHWeight    = _fD.footer_heading_weight|| '600';
    const _ftHTransform = _fD.footer_heading_transform || 'uppercase';
    const _ftHSpacing   = _fD.footer_heading_spacing   || '0.12';

    /* Copy */
    const _ftTagline    = _fC.footer_tagline   || '';
    const _ftAbout      = _fC.footer_about     || '';
    const _ftCopyright  = _fC.footer_copyright || '';
    const _ftSocialHead = _fC.footer_social_heading       || '';
    const _ftNewsHead   = _fC.footer_newsletter_heading   || '';
    const _ftNewsSub    = _fC.footer_newsletter_sub       || '';
    const _ftNewsPh     = _fC.footer_newsletter_placeholder || 'you@example.com';
    const _ftNewsBtn    = _fC.footer_newsletter_button    || 'Subscribe';
    const _ftLegal      = _fC.footer_legal || '';
    const _ftCareersHead = _fC.footer_careers_heading || "We're hiring";
    const _ftCareersSub  = _fC.footer_careers_sub     || 'Join our team — explore open roles.';
    const _ftCareersBtn  = _fC.footer_careers_button  || 'View openings';

    /* Alignment helpers — shared by every layout branch below. */
    const _ftIsCenter = _ftAlign !== 'left' && _ftAlign !== 'right';
    const _ftJustify  = _ftAlign === 'left' ? 'flex-start' : _ftAlign === 'right' ? 'flex-end' : 'center';
    const _ftAutoX    = _ftIsCenter ? 'margin-left:auto;margin-right:auto;' : '';

    function _ftParseLinks(raw) {
      if (!raw) return [];
      return String(raw).split(/\r?\n/).map(line => {
        const parts = line.split('|').map(s => s.trim());
        if (!parts[0]) return null;
        return { label: parts[0], url: parts[1] || '#' };
      }).filter(Boolean);
    }
    const _ftColumns = [1,2,3,4].map(n => ({
      heading: _fC['footer_col'+n+'_heading'] || '',
      links: _ftParseLinks(_fC['footer_col'+n+'_links']),
    })).filter(col => col.heading || col.links.length);

    const _ftSocials = [
      { key:'facebook',  label:'Facebook',  url:_fD.footer_social_facebook  },
      { key:'instagram', label:'Instagram', url:_fD.footer_social_instagram },
      { key:'twitter',   label:'X',         url:_fD.footer_social_twitter   },
      { key:'linkedin',  label:'LinkedIn',  url:_fD.footer_social_linkedin  },
      { key:'youtube',   label:'YouTube',   url:_fD.footer_social_youtube   },
      { key:'tiktok',    label:'TikTok',    url:_fD.footer_social_tiktok    },
      { key:'github',    label:'GitHub',    url:_fD.footer_social_github    },
    ].filter(s => s.url);

    const _autoCr = '© ' + new Date().getFullYear() + ' ' + _fSiteName;
    const _crText = _ftCopyright || _autoCr;
    const _adminHref = typeof centralAuthUrl !== 'undefined' && centralAuthUrl ? centralAuthUrl : '/admin/login';
%>
<style>
  .tnt-footer { padding:<%= _ftPadY %>px <%= _ftPadX %>px; border-top:1px solid <%= _ftBorder %>; background:<%= _ftBg %>; color:<%= _ftText %>; text-align:<%= _ftAlign %>; font-size:<%= _ftTextSize %>rem; font-weight:<%= _ftTextWeight %>; }
  .tnt-footer a { color:<%= _ftLink %>; text-decoration:none; transition:color 0.18s; }
  .tnt-footer a:hover { color:<%= _ftLinkHover %>; }
  .tnt-footer .footer-brand { font-family:var(--font-heading); font-size:<%= _ftBrandSize %>rem; font-weight:<%= _ftBrandWeight %>; color:<%= _ftText %>; display:block; }
  .tnt-footer .footer-tagline { font-size:0.85em; color:<%= _ftText %>; opacity:0.7; margin-top:6px; }
  .tnt-footer .footer-about { font-size:0.85em; color:<%= _ftText %>; opacity:0.75; margin-top:10px; max-width:42em; line-height:1.55; }
  .tnt-footer .footer-col-heading { font-size:<%= _ftHSize %>rem; font-weight:<%= _ftHWeight %>; text-transform:<%= _ftHTransform %>; letter-spacing:<%= _ftHSpacing %>em; color:<%= _ftHeading %>; margin:0 0 12px; }
  .tnt-footer .footer-cols { display:grid; grid-template-columns:repeat(<%= _ftCols %>, minmax(0, 1fr)); gap:32px; }
  .tnt-footer .footer-col ul { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; }
  .tnt-footer .footer-col li { line-height:1.5; }
  .tnt-footer .footer-social { display:flex; gap:14px; justify-content:<%= _ftAlign === 'left' ? 'flex-start' : _ftAlign === 'right' ? 'flex-end' : 'center' %>; flex-wrap:wrap; margin-top:14px; }
  .tnt-footer .footer-social a { display:inline-flex; align-items:center; gap:6px; font-size:0.82em; padding:4px 10px; border:1px solid <%= _ftBorder %>; border-radius:999px; color:<%= _ftLink %>; }
  .tnt-footer .footer-social a:hover { border-color:<%= _ftAccent %>; color:<%= _ftLinkHover %>; }
  /* Icon mode (JS-enhanced): brand icons rendered as circular buttons */
  .tnt-footer .footer-social.is-enhanced a { width:40px; height:40px; padding:0; justify-content:center; border-radius:50%; transition:border-color 0.18s, color 0.18s, background 0.18s; }
  .tnt-footer .footer-social.is-enhanced a:hover { background:color-mix(in srgb, <%= _ftAccent %> 14%, transparent); }
  .tnt-footer .footer-social.is-enhanced svg { width:19px; height:19px; fill:currentColor; display:block; }
  .tnt-footer .footer-social.is-enhanced .fs-emoji { font-size:1.05em; line-height:1; }
  .tnt-footer .footer-newsletter { display:flex; flex-direction:column; gap:8px; max-width:340px; <%= _ftAlign === 'center' ? 'margin:0 auto;' : '' %> }
  .tnt-footer .footer-newsletter input[type=email] { padding:10px 12px; border:1px solid <%= _ftBorder %>; border-radius:6px; background:transparent; color:<%= _ftText %>; font-size:0.85em; }
  .tnt-footer .footer-newsletter button { padding:10px 16px; border:0; border-radius:6px; background:<%= _ftAccent %>; color:var(--on-accent, #0F1B30); font-weight:600; cursor:pointer; font-size:0.85em; }
  .tnt-footer .footer-newsletter button:hover { filter:brightness(1.08); }
  .tnt-footer .footer-row { display:flex; flex-wrap:wrap; gap:40px; align-items:flex-start; justify-content:<%= _ftAlign === 'left' ? 'flex-start' : _ftAlign === 'right' ? 'flex-end' : 'space-between' %>; }
  .tnt-footer .footer-brand-block { flex:0 1 auto; text-align:<%= _ftAlign %>; }
  .tnt-footer .footer-divider { height:1px; background:<%= _ftBorder %>; opacity:0.4; margin:18px 0; }
  /* ── Careers CTA — dedicated "we're hiring" card ── */
  .tnt-footer .footer-careers { display:flex; align-items:center; gap:18px; flex-wrap:wrap; justify-content:space-between; padding:14px 18px; margin-top:18px; border:1px solid <%= _ftBorder %>; border-radius:14px; background:color-mix(in srgb, <%= _ftAccent %> 8%, transparent); max-width:440px; text-align:left; <%= _ftAutoX %> }
  .tnt-footer .footer-careers-text { min-width:0; }
  .tnt-footer .footer-careers-head { font-weight:600; color:<%= _ftHeading %>; font-size:0.95em; display:inline-flex; align-items:center; gap:7px; }
  .tnt-footer .footer-careers-head::before { content:''; width:7px; height:7px; border-radius:50%; background:<%= _ftAccent %>; box-shadow:0 0 0 3px color-mix(in srgb, <%= _ftAccent %> 30%, transparent); flex:0 0 auto; }
  .tnt-footer .footer-careers-sub { opacity:0.72; font-size:0.82em; margin-top:4px; }
  .tnt-footer .footer-careers-btn { display:inline-flex; align-items:center; gap:6px; padding:9px 16px; border-radius:999px; background:<%= _ftAccent %>; color:var(--on-accent, #0F1B30); font-weight:600; font-size:0.82em; white-space:nowrap; transition:filter 0.18s, transform 0.18s; }
  .tnt-footer .footer-careers-btn:hover { color:var(--on-accent, #0F1B30); filter:brightness(1.08); transform:translateX(2px); }
  /* ── Shared bottom bar — copyright · legal nav · admin (every layout) ── */
  .tnt-footer .footer-bottom { display:flex; flex-wrap:wrap; gap:10px 24px; align-items:center; justify-content:<%= _ftIsCenter ? 'center' : 'space-between' %>; margin-top:24px; padding-top:20px; border-top:1px solid <%= _ftBorder %>; text-align:<%= _ftAlign %>; }
  .tnt-footer .footer-bottom-left { display:flex; flex-direction:column; gap:4px; min-width:0; <%= _ftIsCenter ? 'align-items:center;' : '' %> }
  .tnt-footer .footer-copyright { font-size:0.78em; opacity:0.85; }
  .tnt-footer .footer-slab-network { font-size:0.72em; opacity:0.6; margin-top:4px; }
  .tnt-footer .footer-slab-network a { color:<%= _ftAccent %>; }
  .tnt-footer .footer-legal { font-size:0.72em; opacity:0.65; line-height:1.6; max-width:560px; }
  .tnt-footer .footer-bottom-nav { display:flex; flex-wrap:wrap; align-items:center; row-gap:4px; font-size:0.74em; justify-content:<%= _ftJustify %>; }
  .tnt-footer .footer-bottom-nav a { opacity:0.72; padding:2px 0; white-space:nowrap; }
  .tnt-footer .footer-bottom-nav a:hover { opacity:1; }
  /* Separator glued to each link (except the last) so a dot never orphans on wrap. */
  .tnt-footer .footer-bottom-nav a:not(:last-child)::after { content:"\00B7"; margin:0 10px; opacity:0.4; display:inline-block; }
  .tnt-footer .footer-admin-link { opacity:0.4 !important; font-size:0.92em; letter-spacing:0.04em; }
  .tnt-footer .footer-admin-link:hover { opacity:0.9 !important; }
  @media (max-width:760px) {
    .tnt-footer .footer-cols { grid-template-columns:repeat(<%= Math.min(2, _ftCols) %>, minmax(0, 1fr)); gap:24px; }
    .tnt-footer .footer-row { flex-direction:column; align-items:<%= _ftAlign === 'left' ? 'flex-start' : _ftAlign === 'right' ? 'flex-end' : 'center' %>; }
    .tnt-footer .footer-bottom { flex-direction:column; align-items:center; text-align:center; }
    .tnt-footer .footer-bottom-left { align-items:center; }
  }
  @media (max-width:480px) { .tnt-footer .footer-cols { grid-template-columns:1fr; } }
</style>
<footer class="tnt-footer footer" data-footer-layout="<%= _ftLayout %>">

  <%
    function renderBrandBlock() { %>
      <div class="footer-brand-block">
        <% if (_ftShowLogo && (_fL.logo_white || _fL.logo_primary)) { %>
          <img src="<%= _fL.logo_white || _fL.logo_primary %>" alt="<%= _fSiteName %>" style="height:40px;width:auto;object-fit:contain;margin-bottom:10px;">
        <% } %>
        <% if (_ftShowBrand) { %>
          <span class="footer-brand"><% if (_fLogoPre) { %><span style="color:<%= _ftAccent %>"><%= _fLogoPre %></span><% } %><%= _fLogoPost %></span>
        <% } %>
        <% if (_ftShowTagline && (_ftTagline || _fSiteTagline)) { %>
          <div class="footer-tagline"><%= _ftTagline || _fSiteTagline %></div>
        <% } %>
        <% if (_ftAbout && (_ftLayout === 'expanded' || _ftLayout === 'brand')) { %>
          <p class="footer-about"><%= _ftAbout %></p>
        <% } %>
      </div>
    <% }

    function renderColumns() {
      if (!_ftColumns.length) return; %>
      <div class="footer-cols">
        <% _ftColumns.forEach(function(col) { %>
          <div class="footer-col">
            <% if (col.heading) { %><div class="footer-col-heading"><%= col.heading %></div><% } %>
            <% if (col.links.length) { %>
              <ul>
                <% col.links.forEach(function(lnk) { %>
                  <li><a href="<%= lnk.url %>"><%= lnk.label %></a></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% }

    function renderSocial() {
      /* Note: no early-return on empty manual list — connected social accounts
         are merged in client-side (see the enhancement script), so the container
         must exist even when the admin hasn't hand-entered any URLs. */
      if (!_ftShowSocial) return; %>
      <% if (_ftSocialHead) { %><div class="footer-col-heading tnt-social-head" style="margin-top:14px;<%= _ftSocials.length ? '' : 'display:none;' %>"><%= _ftSocialHead %></div><% } %>
      <div class="footer-social tnt-footer-social" data-social-src="/api/footer-social"<%= _ftSocials.length ? '' : ' style="display:none;"' %>>
        <% _ftSocials.forEach(function(s) { %>
          <a href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= s.label %>" data-social-key="<%= s.key %>" data-social-name="<%= s.label %>"><%= s.label %></a>
        <% }) %>
      </div>
    <% }

    function renderNewsletter() {
      if (!_ftShowNews) return;
      const _nHead = _ftNewsHead || 'Stay in the loop';
      const _nSub  = _ftNewsSub  || 'Subscribe for updates and offers — no spam, unsubscribe anytime.'; %>
      <div class="footer-newsletter">
        <div class="footer-col-heading"><%= _nHead %></div>
        <div style="opacity:0.75;font-size:0.85em;"><%= _nSub %></div>
        <form class="tnt-news-form" method="POST" action="/api/newsletter" style="display:flex;gap:6px;flex-wrap:wrap;" onsubmit="return tntNewsSubmit(event)">
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;">
          <input type="email" name="email" placeholder="<%= _ftNewsPh %>" required style="flex:1;min-width:160px;">
          <button type="submit"><%= _ftNewsBtn %></button>
        </form>
        <div class="tnt-news-msg" style="font-size:0.8em;margin-top:6px;min-height:1.1em;"></div>
      </div>
    <% }

    function renderCareersCTA() {
      if (!_fV.careers) return; %>
      <div class="footer-careers">
        <div class="footer-careers-text">
          <div class="footer-careers-head"><%= _ftCareersHead %></div>
          <div class="footer-careers-sub"><%= _ftCareersSub %></div>
        </div>
        <a href="/careers" class="footer-careers-btn"><%= _ftCareersBtn %> &rarr;</a>
      </div>
    <% }

    function renderBottomBar() { %>
      <% if (_ftShowQR) { %>
        <div id="footer-qr-codes" style="display:none;padding:0 0 20px;text-align:<%= _ftAlign %>;">
          <div id="footer-qr-list" style="display:flex;justify-content:<%= _ftJustify %>;gap:20px;flex-wrap:wrap;"></div>
        </div>
      <% } %>
      <div class="footer-bottom">
        <div class="footer-bottom-left">
          <div class="footer-copyright"><%- _crText %></div>
          <% if (_ftLegal) { %><div class="footer-legal"><%= _ftLegal %></div><% } %>
          <%# sLab Network backlink — REQUIRED for opted-in tenants (the quid pro quo
              for their directory listing). Rendered whenever networkMember is set. %>
          <% if (typeof networkMember !== 'undefined' && networkMember) { %>
            <div class="footer-slab-network"><a href="https://slab.madladslab.com/network" target="_blank" rel="noopener"><%= _t('footer.network') %></a></div>
          <% } %>
        </div>
        <nav class="footer-bottom-nav">
          <% if (_fV.careers) { %><a href="/careers"><%= _t('footer.careers') %></a><% } %>
          <a href="/terms"><%= _t('footer.terms') %></a>
          <a href="/privacy"><%= _t('footer.privacy') %></a>
          <a href="/data-deletion"><%= _t('footer.data_deletion') %></a>
          <% if (_fV.admin_link !== false) { %><a href="<%= _adminHref %>" class="footer-admin-link"><%= _t('footer.admin') %></a><% } %>
          <% if (typeof multilangOn !== 'undefined' && multilangOn) { %><%- include('lang-switcher', { size: 'sm' }) %><% } %>
        </nav>
      </div>
    <% }
  %>

  <% if (_ftLayout === 'minimal') { %>
    <%- _crText %>
    <% if (_fV.admin_link !== false) { %>
      &middot; <a href="<%= _adminHref %>" style="opacity:0.5;"><%= _t('footer.admin') %></a>
    <% } %>

  <% } else if (_ftLayout === 'columns') { %>
    <div class="footer-row">
      <% renderBrandBlock() %>
      <% renderColumns() %>
      <% if (_ftShowNews) { renderNewsletter() } %>
    </div>
    <div class="footer-divider"></div>
    <% renderSocial() %>
    <% renderCareersCTA() %>
    <% renderBottomBar() %>

  <% } else if (_ftLayout === 'centered') { %>
    <% renderBrandBlock() %>
    <% renderColumns() %>
    <% renderSocial() %>
    <% if (_ftShowNews) { %><div style="margin-top:18px;"><% renderNewsletter() %></div><% } %>
    <% renderCareersCTA() %>
    <% renderBottomBar() %>

  <% } else if (_ftLayout === 'expanded') { %>
    <div class="footer-row">
      <div style="flex:1 1 280px;"><% renderBrandBlock() %><% renderSocial() %></div>
      <div style="flex:2 1 360px;"><% renderColumns() %></div>
      <% if (_ftShowNews) { %><div style="flex:1 1 280px;"><% renderNewsletter() %></div><% } %>
    </div>
    <% renderCareersCTA() %>
    <% renderBottomBar() %>

  <% } else if (_ftLayout === 'brand') { %>
    <% renderBrandBlock() %>
    <% renderSocial() %>
    <% renderColumns() %>
    <% if (_ftShowNews) { %><div style="margin-top:18px;"><% renderNewsletter() %></div><% } %>
    <% renderCareersCTA() %>
    <% renderBottomBar() %>

  <% } else { /* simple */ %>
    <% if (_ftShowBrand || _ftShowTagline) { renderBrandBlock() } %>
    <% renderSocial() %>
    <% if (_ftShowNews) { %><div style="margin:18px auto 0;"><% renderNewsletter() %></div><% } %>
    <% renderCareersCTA() %>
    <% renderBottomBar() %>
  <% } %>

</footer>
<script>
// Newsletter signup — AJAX submit with inline confirmation (double opt-in).
function tntNewsSubmit(e) {
  e.preventDefault();
  var form = e.target;
  var msg = form.parentNode.querySelector('.tnt-news-msg');
  var btn = form.querySelector('button');
  btn.disabled = true;
  fetch('/api/newsletter', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
    body: new URLSearchParams(new FormData(form)),
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (msg) { msg.style.color = d.ok ? '#7bdca0' : '#f0a0a0'; msg.textContent = d.message || ''; }
    if (d.ok && d.status !== 'exists' && d.status !== 'invalid') form.style.display = 'none';
    btn.disabled = false;
  }).catch(function() {
    if (msg) { msg.style.color = '#f0a0a0'; msg.textContent = 'Something went wrong. Please try again.'; }
    btn.disabled = false;
  });
  return false;
}
// ── Social "connect with us" icons ────────────────────────────────────────────
// Upgrades the footer social row to brand icons and merges in the platforms the
// tenant has linked in /admin/social (fetched from /api/footer-social). Manual
// footer_social_* links win on conflict. Degrades to plain text links w/o JS.
(function() {
