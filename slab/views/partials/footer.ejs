  var ALIAS = { twitter: 'x' };
  function norm(k) { return ALIAS[k] || k; }
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function iconHTML(key, name, emoji) {
    var d = ICON[norm(key)];
    if (d) return '<svg viewBox="0 0 24 24" role="img" aria-hidden="true"><path d="' + d + '"/></svg>';
    if (emoji) return '<span class="fs-emoji">' + esc(emoji) + '</span>';
    return '<span class="fs-emoji">' + esc((name || key || '?').charAt(0)) + '</span>';
  }
  function isHttp(u) { return typeof u === 'string' && /^https?:\/\//i.test(u); }

  Array.prototype.forEach.call(document.querySelectorAll('.tnt-footer-social'), function(container) {
    var head = container.parentNode.querySelector('.tnt-social-head');
    var order = [];   // preserve manual order, then connected
    var byKey = {};   // normalized key -> { key, url, name, emoji }

    // Seed from server-rendered (manual) links — these win on conflict.
    Array.prototype.forEach.call(container.querySelectorAll('a[data-social-key]'), function(a) {
      var k = norm(a.getAttribute('data-social-key'));
      if (byKey[k]) return;
      byKey[k] = { key: a.getAttribute('data-social-key'), url: a.href, name: a.getAttribute('data-social-name') || a.textContent.trim() };
      order.push(k);
    });

    function render() {
      var frag = document.createDocumentFragment();
      order.forEach(function(k) {
        var it = byKey[k];
        if (!isHttp(it.url)) return;
        var a = document.createElement('a');
        a.href = it.url; a.target = '_blank'; a.rel = 'noopener';
        a.setAttribute('aria-label', it.name || it.key);
        a.setAttribute('data-social-key', it.key);
        a.innerHTML = iconHTML(it.key, it.name, it.emoji);
        frag.appendChild(a);
      });
      container.innerHTML = '';
      container.appendChild(frag);
      var any = order.length > 0;
      container.classList.add('is-enhanced');
      container.style.display = any ? '' : 'none';
      if (head) head.style.display = any ? '' : 'none';
    }

    // Show manual links as icons immediately, then merge connected accounts.
    render();
    fetch(container.getAttribute('data-social-src'), { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        (data && data.links || []).forEach(function(l) {
          var k = norm(l.key);
          if (byKey[k]) return;               // manual link already covers it
          byKey[k] = { key: l.key, url: l.url, name: l.name, emoji: l.icon };
          order.push(k);
        });
        render();
      })
      .catch(function() {});
  });
})();
(function() {
  var container = document.getElementById('footer-qr-codes');
  var list = document.getElementById('footer-qr-list');
  if (!container || !list) return;
  fetch('/api/footer-qr').then(function(r) { return r.json(); }).then(function(data) {
    if (!data.links || !data.links.length) return;
    data.links.forEach(function(link) {
      var item = document.createElement('a');
      item.href = link.url;
      item.target = link.type === 'business-card' ? '_blank' : '_self';
      item.style.cssText = 'text-decoration:none;text-align:center;display:inline-block;';
      item.innerHTML = '<img src="' + link.dataUrl + '" alt="' + link.label + '" style="width:64px;height:64px;border-radius:4px;">'
        + '<div style="font-size:0.6rem;color:rgba(82,82,82,0.5);margin-top:4px;">' + link.label + '</div>';
      list.appendChild(item);
    });
    container.style.display = '';
  }).catch(function() {});
})();
</script>
