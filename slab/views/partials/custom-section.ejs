<%# Renders ONE custom section (sec). Self-contained: defines _csImg + f/imgs.
    Included from views/index.ejs — once per anchor group + the end region. %>
<%
  function _csImg(sec, key) {
    const imgs = sec.images || {}, f = sec.fields || {};
    const v = imgs[key];
    if (v) return typeof v === 'string' ? v : (v.url || '');
    const fv = f[key];
    return typeof fv === 'string' ? fv : '';
  }
%>
  <% const f = sec.fields || {}; const imgs = sec.images || {}; %>
  <% if (sec.type === 'text') { %>
  <section class="cs-text"><div class="cs-wrap">
    <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
    <% if (f.subheading) { %><p class="cs-eyebrow"><%- f.subheading %></p><% } %>
    <% if (f.body) { %><div class="cs-body"><%- f.body %></div><% } %>
  </div></section>
  <% } else if (sec.type === 'split') { %>
  <section class="cs-split"><div class="cs-wrap">
    <div>
      <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
      <% if (f.body) { %><div class="cs-body"><%- f.body %></div><% } %>
      <% if (f.cta_text && f.cta_link) { %><a href="<%- f.cta_link %>" class="cs-btn"><%- f.cta_text %></a><% } %>
    </div>
    <div>
      <% const _splitImg = _csImg(sec, 'main_image'); %>
      <% if (_splitImg) { %><img src="<%- _splitImg %>" alt="" loading="lazy" decoding="async" class="cs-split-img"><% } else { %><div class="cs-split-img-placeholder"></div><% } %>
    </div>
  </div></section>
  <% } else if (sec.type === 'cta') { %>
  <% const _ctaBg = _csImg(sec, 'bg_image'); %>
  <section class="cs-cta<% if (_ctaBg) { %> cs-cta-bg<% } %>"<% if (_ctaBg) { %> style="background-image:url('<%- _ctaBg %>');background-size:cover;background-position:center"<% } %>>
    <div class="cs-wrap">
      <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><div class="cs-body"><%- f.subtext %></div><% } %>
      <% if (f.btn_text && f.btn_link) { %><a href="<%- f.btn_link %>" class="cs-btn"><%- f.btn_text %></a><% } %>
    </div>
  </section>
  <% } else if (sec.type === 'cards') { %>
  <section class="cs-cards"><div class="cs-wrap">
    <div class="cs-cards-intro">
      <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><p class="cs-body"><%- f.subtext %></p><% } %>
    </div>
    <div class="cs-cards-grid">
      <% [1,2,3,4].forEach(function(n) { %>
        <% const _cardImg = _csImg(sec, 'card'+n+'_image'); %>
        <% const _cardLinkRaw = f['card'+n+'_link']; const _cardLink = typeof _cardLinkRaw === 'string' ? _cardLinkRaw.trim() : ''; %>
        <% if (f['card'+n+'_title'] || f['card'+n+'_body'] || _cardImg) { %>
        <% const _tag = _cardLink ? 'a' : 'div'; %>
        <% const _ext = _cardLink && /^https?:/.test(_cardLink); %>
        <<%= _tag %> class="cs-card<%= _cardImg ? ' cs-card--has-image' : '' %><%= _cardLink ? ' cs-card--link' : '' %>"<% if (_cardLink) { %> href="<%= _cardLink %>"<% if (_ext) { %> target="_blank" rel="noopener"<% } %><% } %>>
          <% if (_cardImg) { %>
            <div class="cs-card-media" style="background-image:url('<%- _cardImg %>');"></div>
          <% } %>
          <div class="cs-card-content">
            <div class="cs-card-num">0<%= n %></div>
            <% if (f['card'+n+'_title']) { %><div class="cs-card-title"><%- f['card'+n+'_title'] %></div><% } %>
            <% if (f['card'+n+'_body']) { %><div class="cs-card-body"><%- f['card'+n+'_body'] %></div><% } %>
            <% if (_cardLink) { %><span class="cs-card-cta">View<% if (_ext) { %> ↗<% } else { %> →<% } %></span><% } %>
          </div>
        </<%= _tag %>>
        <% } %>
      <% }); %>
    </div>
  </div></section>
  <% } else if (sec.type === 'faq') { %>
  <section class="cs-faq"><div class="cs-wrap">
    <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
    <div class="cs-faq-list">
      <% [1,2,3,4,5].forEach(function(n) { %>
        <% if (f['q'+n] && f['a'+n]) { %>
        <div class="cs-faq-item">
          <div class="cs-faq-q"><%- f['q'+n] %></div>
          <div class="cs-faq-a"><%- f['a'+n] %></div>
        </div>
        <% } %>
      <% }); %>
    </div>
  </div></section>
  <% } else if (sec.type === 'writer_feed') { %>
  <% var _items = sec.items || []; var _layout = f.layout || 'cards'; %>
  <section class="cs-writer-feed cs-cards"><div class="cs-wrap">
    <% if (f.heading || f.subtext) { %>
    <div class="cs-cards-intro">
      <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><p class="cs-body"><%- f.subtext %></p><% } %>
    </div>
    <% } %>
    <% if (_items.length && _layout === 'full') { %>
      <div class="cs-writer-full" style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:40px;">
        <% _items.forEach(function(it) { %>
        <article>
          <% if (it.title) { %><h3 class="cs-heading" style="text-align:left;"><%= it.title %></h3><% } %>
          <% if (it.content) { %><div class="cs-body"><%- it.content %></div><% } %>
        </article>
        <% }); %>
      </div>
    <% } else if (_items.length && _layout === 'list') { %>
      <div class="cs-writer-list" style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:18px;">
        <% _items.forEach(function(it) { var _pub = (!it.contentType || it.contentType === 'blog'); %>
        <div class="cs-writer-li" style="border-bottom:1px solid var(--border, #e5e5e5);padding-bottom:14px;">
          <% if (_pub) { %>
            <a href="/blog/<%= it.slug %>" class="cs-card-title" style="display:block;"><%= it.title %></a>
          <% } else { %>
            <div class="cs-card-title"><%= it.title %></div>
          <% } %>
          <% if (it.excerpt) { %><p class="cs-card-body" style="margin-top:4px;"><%= it.excerpt %></p><% } %>
        </div>
        <% }); %>
      </div>
    <% } else if (_items.length) { %>
      <div class="cs-cards-grid">
        <% _items.forEach(function(it) { var _pub = (!it.contentType || it.contentType === 'blog'); var _tag = _pub ? 'a' : 'div'; %>
        <<%= _tag %> class="cs-card<%= it.featuredImageUrl ? ' cs-card--has-image' : '' %><%= _pub ? ' cs-card--link' : '' %>"<% if (_pub) { %> href="/blog/<%= it.slug %>"<% } %>>
          <% if (it.featuredImageUrl) { %><div class="cs-card-media" style="background-image:url('<%- it.featuredImageUrl %>');"></div><% } %>
          <div class="cs-card-content">
            <% if (it.category) { %><div class="cs-card-num"><%= it.category %></div><% } %>
            <% if (it.title) { %><div class="cs-card-title"><%= it.title %></div><% } %>
            <% if (it.excerpt) { %><div class="cs-card-body"><%= it.excerpt %></div><% } %>
            <% if (_pub) { %><span class="cs-card-cta">Read →</span><% } %>
          </div>
        </<%= _tag %>>
        <% }); %>
      </div>
    <% } %>
  </div></section>
  <% } else if (sec.type === 'stats') { %>
  <section class="cs-stats"><div class="cs-wrap">
    <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
    <div class="cs-stats-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:32px;text-align:center;margin-top:36px;">
      <% [1,2,3,4].forEach(function(n) { %>
        <% if (f['stat'+n+'_num']) { %>
        <div>
          <div style="font-family:var(--font-heading);font-size:3rem;font-weight:300;color:var(--navy);line-height:1;"><%- f['stat'+n+'_num'] %></div>
          <% if (f['stat'+n+'_label']) { %><div style="font-size:0.78rem;letter-spacing:0.06em;text-transform:uppercase;color:var(--on-surface-muted);margin-top:8px;"><%- f['stat'+n+'_label'] %></div><% } %>
        </div>
        <% } %>
      <% }); %>
    </div>
  </div></section>
  <% } else if (sec.type === 'testimonials') { %>
  <section class="cs-testimonials"><div class="cs-wrap">
    <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:36px;">
      <% [1,2,3].forEach(function(n) { %>
        <% if (f['t'+n+'_quote']) { %>
        <div style="background:var(--surface);padding:32px;border:1px solid var(--border);">
          <p style="font-family:var(--font-heading);font-style:italic;line-height:1.7;color:var(--on-surface);margin-bottom:18px;">&ldquo;<%- f['t'+n+'_quote'] %>&rdquo;</p>
          <% if (f['t'+n+'_name']) { %><div style="font-weight:600;font-size:0.85rem;color:var(--on-surface);"><%- f['t'+n+'_name'] %></div><% } %>
          <% if (f['t'+n+'_role']) { %><div style="font-size:0.72rem;color:var(--on-surface-muted);"><%- f['t'+n+'_role'] %></div><% } %>
        </div>
        <% } %>
      <% }); %>
    </div>
  </div></section>
  <% } else if (sec.type === 'gallery') { %>
  <section class="cs-gallery"><div class="cs-wrap">
    <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
    <% if (f.subtext) { %><p class="cs-body"><%- f.subtext %></p><% } %>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;margin-top:32px;">
      <% [1,2,3,4,5,6].forEach(function(n) { var _gi = _csImg(sec,'img'+n); %>
        <% if (_gi) { %><div style="aspect-ratio:1;background-image:url('<%- _gi %>');background-size:cover;background-position:center;"></div><% } %>
      <% }); %>
    </div>
  </div></section>
  <% } else if (sec.type === 'video') { %>
  <%
    var _vurl = (f.embed_url || '').trim(); var _embed = '';
    var _yt = _vurl.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{11})/);
    var _vm = _vurl.match(/vimeo\.com\/(\d+)/);
    if (_yt) _embed = 'https://www.youtube.com/embed/' + _yt[1];
    else if (_vm) _embed = 'https://player.vimeo.com/video/' + _vm[1];
  %>
  <section class="cs-video"><div class="cs-wrap">
    <% if (f.heading) { %><h2 class="cs-heading"><%- f.heading %></h2><% } %>
    <% if (f.subtext) { %><p class="cs-body"><%- f.subtext %></p><% } %>
    <% if (_embed) { %><div style="max-width:900px;margin:32px auto 0;"><iframe src="<%= _embed %>" loading="lazy" allowfullscreen frameborder="0" style="width:100%;aspect-ratio:16/9;border:none;display:block;"></iframe></div><% } %>
  </div></section>
  <% } else if (sec.type === 'quote') { %>
  <section class="cs-quote"><div class="cs-wrap" style="text-align:center;max-width:820px;">
    <% if (f.quote) { %><blockquote style="font-family:var(--font-heading);font-size:2rem;font-weight:300;line-height:1.5;color:var(--navy);margin:0;">&ldquo;<%- f.quote %>&rdquo;</blockquote><% } %>
    <% if (f.attribution) { %><div style="margin-top:20px;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--on-surface-muted);">&mdash; <%- f.attribution %></div><% } %>
  </div></section>
  <% } else if (sec.type === 'banner') { %>
  <% var _bbg = _csImg(sec, 'bg_image'); %>
  <section class="cs-banner<% if (_bbg) { %> cs-banner-bg<% } %>"<% if (_bbg) { %> style="background-image:url('<%- _bbg %>');background-size:cover;background-position:center;"<% } %>>
    <div class="cs-wrap" style="text-align:center;">
      <% if (f.heading) { %><h2 class="cs-heading"<% if (_bbg) { %> style="color:#fff;"<% } %>><%- f.heading %></h2><% } %>
      <% if (f.subtext) { %><div class="cs-body"<% if (_bbg) { %> style="color:rgba(255,255,255,0.85);"<% } %>><%- f.subtext %></div><% } %>
      <% if (f.btn_text && f.btn_link) { %><a href="<%- f.btn_link %>" class="cs-btn"><%- f.btn_text %></a><% } %>
    </div>
  </section>
  <% } %>
