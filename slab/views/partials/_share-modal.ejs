<!--
  Universal Share modal — one component, every tenant, every content type.
  Include once on any page (admin or public), then call:

    // when you already have the short link (e.g. server-minted on a public page)
    openShareModal({ url, title, text, image });

    // from an admin list/editor — mints the /s/:token link first, then opens
    shareAdminContent('blog', '<post id>', { title, crossPost: true });

  Social targets, QR, native share-sheet and clipboard are all built from the
  one canonical URL, so previews and analytics stay consistent everywhere.
-->
<div id="shareModal" class="sm-overlay" style="display:none;" aria-hidden="true">
  <div class="sm-dialog" role="dialog" aria-modal="true" aria-label="Share">
    <div class="sm-head">
      <div class="sm-title" id="smHeadTitle">Share</div>
      <button type="button" class="sm-close" onclick="closeShareModal()" aria-label="Close">&times;</button>
    </div>
    <div class="sm-body">
      <div class="sm-preview">
        <img id="smPreviewImg" class="sm-preview-img" alt="" style="display:none;">
        <div class="sm-preview-text">
          <div id="smPreviewTitle" class="sm-preview-title"></div>
          <div id="smPreviewUrl" class="sm-preview-url"></div>
        </div>
      </div>

      <div class="sm-copyrow">
        <input id="smUrlInput" class="sm-url-input" type="text" readonly onclick="this.select()">
        <button type="button" class="sm-copy-btn" id="smCopyBtn" onclick="smCopy()">Copy</button>
      </div>

      <div class="sm-targets" id="smTargets"><!-- built by JS --></div>

      <div class="sm-extras">
        <button type="button" class="sm-extra" id="smNativeBtn" onclick="smNative()" style="display:none;">
          <span class="sm-extra-ic">⇪</span> Share via device…
        </button>
        <button type="button" class="sm-extra" id="smQrBtn" onclick="smToggleQr()">
          <span class="sm-extra-ic">▦</span> QR code
        </button>
        <a href="#" target="_blank" rel="noopener" class="sm-extra" id="smCrossPost" style="display:none;">
          <span class="sm-extra-ic">✦</span> Cross-post to your channels
        </a>
      </div>

      <div class="sm-qr" id="smQr" style="display:none;">
        <img id="smQrImg" alt="QR code" width="180" height="180">
        <div class="sm-qr-hint">Scan to open on a phone</div>
      </div>
    </div>
  </div>
</div>

<style>
  .sm-overlay { position:fixed; inset:0; background:rgba(15,27,48,0.6); z-index:1200; align-items:center; justify-content:center; padding:20px; }
  .sm-overlay.open { display:flex; }
  .sm-dialog {
    background:var(--surface,#fff); color:var(--on-surface,#0F1B30);
    border-radius:10px; width:100%; max-width:440px; overflow:hidden;
    box-shadow:0 20px 64px rgba(0,0,0,0.34); animation:smIn .16s ease;
  }
  @keyframes smIn { from { opacity:0; transform:translateY(8px) scale(.99); } to { opacity:1; transform:none; } }
  .sm-head {
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 18px; border-bottom:1px solid var(--border,#E6E1D6);
  }
  .sm-title { font-family:var(--font-heading,'Cormorant Garamond',serif); font-size:1.25rem; font-weight:500; }
  .sm-close { background:none; border:none; font-size:1.6rem; line-height:1; cursor:pointer; color:var(--on-surface-muted,#6B7380); padding:0 2px; }
  .sm-close:hover { color:var(--on-surface,#0F1B30); }
  .sm-body { padding:18px; }
  .sm-preview { display:flex; gap:12px; align-items:center; margin-bottom:14px; }
  .sm-preview-img { width:56px; height:56px; border-radius:6px; object-fit:cover; flex-shrink:0; border:1px solid var(--border,#E6E1D6); }
  .sm-preview-text { min-width:0; }
  .sm-preview-title { font-weight:600; font-size:0.95rem; line-height:1.25; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
  .sm-preview-url { font-size:0.72rem; color:var(--on-surface-muted,#6B7380); margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .sm-copyrow { display:flex; gap:8px; margin-bottom:16px; }
  .sm-url-input { flex:1; min-width:0; border:1px solid var(--border,#CBD5E1); border-radius:6px; padding:9px 11px; font-size:0.82rem; background:var(--bg,#F8F7F4); color:var(--on-surface,#0F1B30); }
  .sm-copy-btn { border:none; border-radius:6px; padding:0 16px; font-size:0.78rem; font-weight:600; letter-spacing:0.04em; cursor:pointer; background:var(--primary,#1C2B4A); color:var(--on-primary,#fff); transition:background .15s; }
  .sm-copy-btn.ok { background:var(--accent,#C9A848); color:var(--on-accent,#0F1B30); }
  .sm-targets { display:grid; grid-template-columns:repeat(auto-fill,minmax(72px,1fr)); gap:8px; margin-bottom:14px; }
  .sm-target { display:flex; flex-direction:column; align-items:center; gap:5px; text-decoration:none; padding:10px 4px; border-radius:8px; border:1px solid var(--border,#E6E1D6); color:var(--on-surface,#0F1B30); transition:background .14s, border-color .14s; }
  .sm-target:hover { background:var(--bg,#F4F2EC); border-color:var(--primary,#1C2B4A); }
  .sm-target-ic { width:26px; height:26px; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; font-size:0.85rem; font-weight:700; }
  .sm-target-label { font-size:0.66rem; letter-spacing:0.02em; color:var(--on-surface-muted,#6B7380); }
  .sm-extras { display:flex; flex-direction:column; gap:7px; }
  .sm-extra { display:flex; align-items:center; gap:9px; width:100%; text-align:left; background:none; border:1px solid var(--border,#E6E1D6); border-radius:7px; padding:10px 12px; font-size:0.82rem; cursor:pointer; color:var(--on-surface,#0F1B30); text-decoration:none; transition:background .14s; }
  .sm-extra:hover { background:var(--bg,#F4F2EC); }
  .sm-extra-ic { font-size:0.95rem; opacity:0.7; width:18px; text-align:center; }
  .sm-qr { text-align:center; margin-top:14px; padding-top:14px; border-top:1px solid var(--border,#E6E1D6); }
  .sm-qr-hint { font-size:0.7rem; color:var(--on-surface-muted,#6B7380); margin-top:6px; }
</style>

<script>
(function(){
  var modal   = document.getElementById('shareModal');
  if (!modal) return;
  var urlInput  = document.getElementById('smUrlInput');
  var copyBtn   = document.getElementById('smCopyBtn');
  var targetsEl = document.getElementById('smTargets');
  var qrWrap    = document.getElementById('smQr');
  var qrImg     = document.getElementById('smQrImg');
  var nativeBtn = document.getElementById('smNativeBtn');
  var crossEl   = document.getElementById('smCrossPost');
  var state = { url:'', title:'', text:'' };

  // Browser-side share intents. Each builds a destination URL from the canonical
  // share link + title; the network renders the rich preview from our OG tags.
  var TARGETS = [
    { key:'facebook', label:'Facebook', bg:'#1877F2', glyph:'f',
      href:function(u,t){ return 'https://www.facebook.com/sharer/sharer.php?u='+u; } },
    { key:'x', label:'X', bg:'#000000', glyph:'𝕏',
      href:function(u,t){ return 'https://twitter.com/intent/tweet?url='+u+'&text='+t; } },
    { key:'linkedin', label:'LinkedIn', bg:'#0A66C2', glyph:'in',
      href:function(u,t){ return 'https://www.linkedin.com/sharing/share-offsite/?url='+u; } },
    { key:'whatsapp', label:'WhatsApp', bg:'#25D366', glyph:'✆',
      href:function(u,t){ return 'https://api.whatsapp.com/send?text='+t+'%20'+u; } },
    { key:'reddit', label:'Reddit', bg:'#FF4500', glyph:'r',
      href:function(u,t){ return 'https://www.reddit.com/submit?url='+u+'&title='+t; } },
    { key:'email', label:'Email', bg:'#6B7380', glyph:'@',
      href:function(u,t){ return 'mailto:?subject='+t+'&body='+u; } }
  ];

  function renderTargets(){
    var u = encodeURIComponent(state.url);
    var t = encodeURIComponent(state.title || '');
    targetsEl.innerHTML = '';
    TARGETS.forEach(function(tg){
      var a = document.createElement('a');
      a.className = 'sm-target';
      a.href = tg.href(u, t);
      a.target = '_blank'; a.rel = 'noopener';
      a.innerHTML = '<span class="sm-target-ic" style="background:'+tg.bg+'">'+tg.glyph+'</span>'
                  + '<span class="sm-target-label">'+tg.label+'</span>';
      targetsEl.appendChild(a);
    });
  }

  window.openShareModal = function(opts){
    opts = opts || {};
    if (!opts.url) return;
    state.url = opts.url;
    state.title = opts.title || document.title || '';
    state.text = opts.text || '';

    document.getElementById('smHeadTitle').textContent = 'Share';
    document.getElementById('smPreviewTitle').textContent = state.title;
    document.getElementById('smPreviewUrl').textContent = state.url.replace(/^https?:\/\//,'');
    var img = document.getElementById('smPreviewImg');
    if (opts.image) { img.src = opts.image; img.style.display = 'block'; }
    else { img.style.display = 'none'; img.removeAttribute('src'); }

    urlInput.value = state.url;
    copyBtn.textContent = 'Copy'; copyBtn.classList.remove('ok');
    renderTargets();

    // QR is served by the share link itself: /s/:token/qr
    qrImg.src = state.url.replace(/\/+$/,'') + '/qr';
    qrWrap.style.display = 'none';

    nativeBtn.style.display = (navigator.share ? 'flex' : 'none');

    if (opts.crossPostUrl) { crossEl.href = opts.crossPostUrl; crossEl.style.display = 'flex'; }
    else { crossEl.style.display = 'none'; }

    modal.style.display = 'flex';
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
  };

  window.closeShareModal = function(){
    modal.classList.remove('open');
    modal.style.display = 'none';
    modal.setAttribute('aria-hidden', 'true');
  };

  window.smCopy = function(){
    var done = function(){ copyBtn.textContent = 'Copied'; copyBtn.classList.add('ok');
      setTimeout(function(){ copyBtn.textContent='Copy'; copyBtn.classList.remove('ok'); }, 1600); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(state.url).then(done, function(){ urlInput.select(); document.execCommand('copy'); done(); });
    } else { urlInput.select(); document.execCommand('copy'); done(); }
  };

  window.smToggleQr = function(){ qrWrap.style.display = (qrWrap.style.display === 'none' ? 'block' : 'none'); };

  window.smNative = function(){
    if (navigator.share) navigator.share({ title: state.title, text: state.text, url: state.url }).catch(function(){});
  };

  // Admin helper: mint the short link for a piece of content, then open the modal.
  window.shareAdminContent = function(collection, id, opts){
    opts = opts || {};
    fetch('/admin/share/link', {
      method:'POST', headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({ collection: collection, id: id })
    })
    .then(function(r){ return r.json().then(function(d){ return { ok:r.ok, d:d }; }); })
    .then(function(res){
      if (!res.ok || !res.d.url) { alert(res.d && res.d.error ? res.d.error : 'Could not create share link.'); return; }
      var crossPostUrl = null;
      if (opts.crossPost) {
        crossPostUrl = '/admin/social?tab=compose&prefillLink=' + encodeURIComponent(res.d.url)
                     + '&prefillBody=' + encodeURIComponent(opts.title || res.d.title || '');
        if (res.d.image) crossPostUrl += '&prefillMedia=' + encodeURIComponent(res.d.image);
      }
      openShareModal({ url:res.d.url, title: opts.title || res.d.title, image: res.d.image, crossPostUrl: crossPostUrl });
    })
    .catch(function(){ alert('Could not create share link.'); });
  };

  modal.addEventListener('click', function(e){ if (e.target === modal) closeShareModal(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && modal.classList.contains('open')) closeShareModal(); });
})();
</script>
