<%
  /* ── Drop-in SEO / AEO / GEO head partial ─────────────────────────────────
     Renders: <title>, <meta description/robots>, canonical, OG, Twitter card,
     and JSON-LD blocks. Falls back gracefully if `seo` is not set. */
  const _seo = (typeof seo !== 'undefined' && seo) ? seo : (locals && locals.seo) || {};
  const _title    = _seo.title || (typeof brand !== 'undefined' && brand && brand.name) || 'Home';
  const _desc     = _seo.description || '';
  const _canon    = _seo.canonical || '';
  const _robots   = _seo.robots || 'index,follow';
  const _ogType   = _seo.ogType || 'website';
  const _ogImg    = _seo.ogImage || (typeof logos !== 'undefined' && logos && (logos.logo_primary || logos.logo_white)) || '';
  const _siteName = _seo.siteName || (typeof brand !== 'undefined' && brand && brand.name) || '';
  const _tw       = _seo.twitterCard || 'summary_large_image';
  const _twSite   = _seo.twitterSite || '';
  const _locale   = _seo.locale || 'en_US';
  const _theme    = _seo.themeColor || (typeof design !== 'undefined' && design && (design.color_primary || design.color_accent)) || '';
  const _jsonLd   = Array.isArray(_seo.jsonLd) ? _seo.jsonLd : [];
  const _favEmoji = (typeof design !== 'undefined' && design && design.favicon_emoji) || '';
  const _favImg   = (typeof logos !== 'undefined' && logos && logos.logo_icon) || '';
  const _shareImg = _seo.ogImage || ((typeof logos !== 'undefined' && logos && logos.share_image) || '') || _ogImg;
  const _shareSq  = (typeof logos !== 'undefined' && logos && logos.share_square) || '';
  const _gtm      = (typeof design !== 'undefined' && design && design.gtm_id) || '';
  const _headHtml = (typeof design !== 'undefined' && design && design.head_html) || '';
  const _dz = (typeof design !== 'undefined' && design) ? design : {};
  const _vGoogle = _dz.verify_google || ''; const _vBing = _dz.verify_bing || '';
  const _vPin = _dz.verify_pinterest || ''; const _vFb = _dz.verify_facebook || '';
%>
<% if (_gtm) { %><script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= _gtm %>');</script><% } %>
<% if (_favImg) { %><link rel="icon" href="<%= _favImg %>"><link rel="apple-touch-icon" href="<%= _favImg %>"><% } else if (_favEmoji) { %><link rel="icon" href="data:image/svg+xml,<%= encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="88">' + _favEmoji + '</text></svg>') %>"><% } %>
<% if (_vGoogle) { %><meta name="google-site-verification" content="<%= _vGoogle %>"><% } %>
<% if (_vBing) { %><meta name="msvalidate.01" content="<%= _vBing %>"><% } %>
<% if (_vPin) { %><meta name="p:domain_verify" content="<%= _vPin %>"><% } %>
<% if (_vFb) { %><meta name="facebook-domain-verification" content="<%= _vFb %>"><% } %>
<%- _headHtml %>
<title><%= _title %></title>
<% if (_desc) { %><meta name="description" content="<%= _desc %>"><% } %>
<meta name="robots" content="<%= _robots %>">
<% if (_canon) { %><link rel="canonical" href="<%= _canon %>"><% } %>
<% if (_theme) { %><meta name="theme-color" content="<%= _theme %>"><% } %>
<%# sLab Network — machine-readable membership backlink in the head, mirroring the
    visible footer UI link. Present only for tenants opted into the network. %>
<% if (typeof networkMember !== 'undefined' && networkMember) { %>
<link rel="related" href="https://slab.madladslab.com/network" title="sLab Network">
<meta name="slab:network" content="member">
<% } %>

<meta property="og:type" content="<%= _ogType %>">
<meta property="og:title" content="<%= _title %>">
<% if (_desc) { %><meta property="og:description" content="<%= _desc %>"><% } %>
<% if (_canon) { %><meta property="og:url" content="<%= _canon %>"><% } %>
<% if (_siteName) { %><meta property="og:site_name" content="<%= _siteName %>"><% } %>
<% if (_shareImg) { %><meta property="og:image" content="<%= _shareImg %>"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><% } %>
<% if (_shareSq) { %><meta property="og:image" content="<%= _shareSq %>"><meta property="og:image:width" content="1080"><meta property="og:image:height" content="1080"><% } %>
<meta property="og:locale" content="<%= _locale %>">

<meta name="twitter:card" content="<%= _tw %>">
<% if (_twSite) { %><meta name="twitter:site" content="<%= _twSite %>"><% } %>
<meta name="twitter:title" content="<%= _title %>">
<% if (_desc) { %><meta name="twitter:description" content="<%= _desc %>"><% } %>
<% if (_shareImg) { %><meta name="twitter:image" content="<%= _shareImg %>"><% } %>

<% _jsonLd.forEach(function(_obj) { %>
<script type="application/ld+json"><%- JSON.stringify(_obj).replace(/</g, '\\u003c') %></script>
<% }); %>

<%# Public support bubble — loads only when the tenant's chatbot toggle is on %>
<% if (typeof chatbotEnabled !== 'undefined' && chatbotEnabled) { %>
<script src="/js/supportBubble.js?v=<%= Date.now() %>" defer></script>
<% } %>
<%# Front-end error reporter — ships uncaught JS errors to /superadmin/errors %>
<script src="/js/errorReporter.js"></script>
