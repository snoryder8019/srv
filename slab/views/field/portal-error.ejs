<% const _t = (typeof t === 'function') ? t : (k => k); %>
<!DOCTYPE html>
<html lang="<%= (typeof htmlLang !== 'undefined' && htmlLang) || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= _t('field.portal_error_title') %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    :root { --navy:<%= (typeof design !== 'undefined' && design.color_primary) || '#1a2436' %>; --gold:<%= (typeof design !== 'undefined' && design.color_accent) || '#c9a848' %>; --ivory:<%= (typeof design !== 'undefined' && design.color_bg) || '#f5f2ec' %>; --slate:#6B7380; }
    body { font-family:'Jost',sans-serif; background:var(--ivory); color:var(--navy); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }
    .box { background:#fff; max-width:420px; width:100%; border-radius:6px; padding:36px 32px; text-align:center; box-shadow:0 2px 20px rgba(0,0,0,.07); }
    .icon { font-size:34px; margin-bottom:12px; }
    h1 { font-family:'Cormorant Garamond',serif; font-weight:400; font-size:26px; margin-bottom:10px; }
    p { color:var(--slate); font-size:14px; line-height:1.5; }
    .bar { height:3px; background:var(--gold); border-radius:3px; width:48px; margin:16px auto 0; }
  </style>
</head>
<body>
  <div class="box">
    <div class="icon">&#128274;</div>
    <h1><%= _t('field.portal_error_title') %></h1>
    <p><%= message %></p>
    <div class="bar"></div>
  </div>
</body>
</html>
