<% const _t = (typeof t === 'function') ? t : (k => k); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Careers — <%= brand?.name || 'Careers' %></title>
  <meta name="description" content="Open positions at <%= brand?.name || 'our team' %>.">
  <link rel="alternate" type="application/rss+xml" title="Careers RSS" href="/careers/feed.rss">
  <link rel="alternate" type="application/atom+xml" title="Careers Atom" href="/careers/feed.atom">
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --primary: <%= design.color_primary || '#1C2B4A' %>;
      --accent: <%= design.color_accent || '#C9A848' %>;
      --bg: <%= design.color_bg || '#F5F3EF' %>;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'Jost',system-ui,sans-serif;background:var(--bg);color:#1a1a1a;line-height:1.6;}
    .wrap{max-width:840px;margin:0 auto;padding:64px 24px;}
    h1{font-family:'Cormorant Garamond',serif;font-size:2.6rem;color:var(--primary);margin-bottom:8px;}
    .sub{opacity:.7;margin-bottom:40px;}
    .job{display:block;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:22px 24px;margin-bottom:14px;text-decoration:none;color:inherit;transition:box-shadow .15s,transform .15s;}
    .job:hover{box-shadow:0 6px 24px rgba(0,0,0,.08);transform:translateY(-1px);}
    .job h2{font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:var(--primary);margin-bottom:6px;}
    .meta{display:flex;gap:14px;flex-wrap:wrap;font-size:.9rem;opacity:.75;}
    .meta span::before{content:'•';margin-right:14px;opacity:.5;}
    .meta span:first-child::before{content:'';margin:0;}
    .empty{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:48px;text-align:center;opacity:.75;}
    .home{display:inline-block;margin-top:40px;color:var(--primary);text-decoration:none;opacity:.7;}
  </style>
</head>
<body>
  <div class="wrap">
    <h1><%= _t('careers.careers') %></h1>
    <p class="sub"><%= _t('careers.open_positions_at') %> <%= brand?.name || 'our team' %>.</p>

    <% if (!jobs || jobs.length === 0) { %>
      <div class="empty"><%= _t('careers.empty') %></div>
    <% } else { %>
      <% jobs.forEach(function(j){ %>
        <a class="job" href="/careers/<%= j.slug %>">
          <h2><%= j.title %></h2>
          <div class="meta">
            <% if (j.department) { %><span><%= j.department %></span><% } %>
            <% if (j.location || j.remote) { %><span><%= j.location || _t('careers.remote') %><%= (j.remote && j.location) ? ' · ' + _t('careers.remote') : '' %></span><% } %>
            <% if (j.employmentType) { %><span><%= j.employmentType %></span><% } %>
          </div>
        </a>
      <% }); %>
    <% } %>

    <a class="home" href="/">← <%= _t('careers.back_to') %> <%= brand?.name || 'home' %></a>
  </div>
</body>
</html>
