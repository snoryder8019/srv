<% const _t = (typeof t === 'function') ? t : (k => k); %><!doctype html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'en' %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= _t('network.page_title') %></title>
<meta name="description" content="The sLab Network: a directory of the brands built on sLab, plus their open roles, press, templates, and the inference-mesh waitlist.">
<style>
  :root{
    --bg:#0b1020; --panel:#121a30; --panel2:#0f1626; --ink:#f4f2ec; --muted:#9aa6bf;
    --line:rgba(255,255,255,.09); --gold:#c9a848; --gold-soft:rgba(201,168,72,.14);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 'Jost',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  .wrap{max-width:1120px;margin:0 auto;padding:0 22px}
  .eyebrow{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:600}
  h1,h2{font-weight:600;letter-spacing:-.01em;margin:0}
  .muted{color:var(--muted)}
  section{padding:56px 0;border-top:1px solid var(--line)}
  .sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:26px}
  .sec-head h2{font-size:1.5rem}
  .sec-head .count{font-size:.78rem;color:var(--muted)}
  /* Hero */
  .hero{padding:82px 0 60px;text-align:center;border-top:none;background:radial-gradient(120% 80% at 50% -10%,rgba(201,168,72,.10),transparent 60%)}
  .hero h1{font-size:clamp(2.1rem,5vw,3.4rem);line-height:1.05;margin:14px 0 12px}
  .hero h1 .g{color:var(--gold)}
  .hero p{max-width:620px;margin:0 auto;color:var(--muted);font-size:1.05rem}
  .stats{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:34px}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 22px;min-width:104px}
  .stat b{display:block;font-size:1.7rem;font-weight:600;color:var(--gold);line-height:1}
  .stat span{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  /* Cards */
  .grid{display:grid;gap:14px}
  .g-dir{grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}
  .g-job{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
  .g-tri{grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
  .g-vid{grid-template-columns:repeat(auto-fill,minmax(258px,1fr))}
  .vid-thumb{position:relative;aspect-ratio:16/9;border-radius:12px 12px 0 0;overflow:hidden;background:#000;margin:-18px -18px 12px}
  .vid-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .vid-thumb .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .vid-thumb .play svg{width:46px;height:46px;fill:#fff;opacity:.92;filter:drop-shadow(0 2px 7px rgba(0,0,0,.55))}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;transition:border-color .16s,transform .16s;text-decoration:none;display:block}
  a.card:hover{border-color:var(--gold);transform:translateY(-2px)}
  .brand-top{display:flex;align-items:center;gap:12px;margin-bottom:10px}
  .brand-logo{width:40px;height:40px;border-radius:9px;object-fit:contain;background:#fff;padding:4px;flex:0 0 auto}
  .brand-logo.ph{display:flex;align-items:center;justify-content:center;background:var(--gold-soft);color:var(--gold);font-weight:700;font-size:1.1rem;padding:0}
  .brand-name{font-weight:600;line-height:1.2}
  .brand-ind{font-size:.72rem;color:var(--muted)}
  .brand-tag{font-size:.85rem;color:var(--muted);margin:0}
  .chip{display:inline-block;font-size:.68rem;letter-spacing:.04em;padding:3px 9px;border-radius:999px;background:var(--gold-soft);color:var(--gold);margin-top:12px}
  .job-title{font-weight:600;font-size:1.02rem;margin:0 0 4px}
  .job-meta{font-size:.8rem;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 12px;margin-top:8px}
  .job-brand{font-size:.75rem;color:var(--gold);margin-top:10px;letter-spacing:.03em}
  .empty{color:var(--muted);font-size:.9rem;background:var(--panel2);border:1px dashed var(--line);border-radius:14px;padding:22px;text-align:center}
  /* CTA panels */
  .panel-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .cta{background:linear-gradient(160deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:16px;padding:26px}
  .cta h3{margin:0 0 8px;font-size:1.15rem;font-weight:600}
  .cta p{color:var(--muted);margin:0 0 16px;font-size:.92rem}
  .btn{display:inline-block;background:var(--gold);color:#0b1020;font-weight:700;padding:11px 20px;border-radius:10px;text-decoration:none;border:0;cursor:pointer;font-size:.9rem}
  .btn.ghost{background:transparent;color:var(--gold);border:1px solid var(--gold)}
  .wl-form{display:flex;gap:8px;flex-wrap:wrap}
  .wl-form input{flex:1;min-width:180px;background:#0b1020;border:1px solid var(--line);border-radius:10px;color:var(--ink);padding:11px 13px;font:inherit}
  .wl-msg{font-size:.82rem;margin-top:10px;min-height:1.1em}
  footer.net{padding:40px 0;text-align:center;color:var(--muted);font-size:.82rem;border-top:1px solid var(--line)}
  footer.net a{color:var(--gold);text-decoration:none}
  /* Share — hero button */
  .hero-share{margin-top:30px}
  .btn-share{display:inline-flex;align-items:center;gap:9px;background:var(--gold);color:#0b1020;border:0;border-radius:12px;padding:13px 24px;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;transition:transform .15s,filter .15s}
  .btn-share:hover{transform:translateY(-2px);filter:brightness(1.06)}
  .btn-share svg{width:18px;height:18px;fill:currentColor}
  /* Share — per-brand rounded self-shout icon */
  .brand-card{position:relative}
  .brand-card .card-link{position:absolute;inset:0;z-index:1;border-radius:14px}
  .share-mini{position:absolute;top:11px;right:11px;z-index:2;width:34px;height:34px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--panel2);border:1px solid var(--line);color:var(--muted);cursor:pointer;transition:background .15s,color .15s,border-color .15s}
  .share-mini svg{width:15px;height:15px;fill:currentColor}
  .share-mini:hover{background:var(--gold);color:#0b1020;border-color:var(--gold)}
  /* Share — modal */
  .sh-overlay{position:fixed;inset:0;background:rgba(4,8,18,.74);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;z-index:100;padding:20px}
  .sh-overlay.open{display:flex}
  .sh-modal{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:18px;max-width:460px;width:100%;padding:26px}
  .sh-modal h3{margin:0 0 4px;font-size:1.25rem;font-weight:600}
  .sh-sub{color:var(--muted);font-size:.88rem;margin:0 0 18px}
  .sh-close{position:absolute;top:12px;right:16px;background:none;border:0;color:var(--muted);font-size:1.5rem;cursor:pointer;line-height:1}
  .sh-copy{display:flex;gap:8px;margin-bottom:16px}
  .sh-copy input{flex:1;min-width:0;background:#0b1020;border:1px solid var(--line);border-radius:10px;color:var(--ink);padding:10px 12px;font:inherit;font-size:.8rem}
  .sh-copy button{background:var(--gold);color:#0b1020;border:0;border-radius:10px;padding:0 16px;font-weight:700;cursor:pointer;font:inherit}
  .sh-socials{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}
  .sh-socials a{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 4px;border:1px solid var(--line);border-radius:12px;text-decoration:none;color:var(--ink);font-size:.7rem;transition:border-color .15s,transform .15s}
  .sh-socials a:hover{border-color:var(--gold);transform:translateY(-2px)}
  .sh-socials svg{width:22px;height:22px;fill:currentColor}
  .sh-hint{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--gold-soft);font-size:.86rem;line-height:1.5}
  .sh-hint.small{background:transparent;border:0;padding:6px 0 0;text-align:center;font-size:.82rem}
  .sh-hint b{color:var(--gold)}
  .sh-hint a{color:var(--gold);font-weight:700;text-decoration:none}
  /* Follow ("one email, follow many") — per-brand toggle on directory cards */
  .follow-check{position:relative;z-index:2;display:inline-flex;align-items:center;gap:7px;margin-top:12px;padding:5px 11px 5px 9px;border:1px solid var(--line);border-radius:999px;background:var(--panel2);cursor:pointer;font-size:.74rem;color:var(--muted);user-select:none;transition:border-color .15s,color .15s,background .15s}
  .follow-check:hover{border-color:var(--gold);color:var(--ink)}
  .follow-check input{accent-color:var(--gold);width:14px;height:14px;margin:0;cursor:pointer}
  .follow-check:has(input:checked){border-color:var(--gold);color:var(--gold);background:var(--gold-soft)}
  /* Join-the-Network follow panel — sits between delegates & waitlist */
  .panel-row.net-join-row{grid-template-columns:1fr 1fr 1fr}
  .cta.net-join{border-color:rgba(201,168,72,.4)}
  .nf-count{color:var(--gold);font-weight:600}
  /* ── Presence map ─────────────────────────────────────────────────────── */
  .map-shell{display:flex;flex-direction:column;gap:14px}
  .map-legend{display:flex;flex-wrap:wrap;gap:8px}
  .lg{display:inline-flex;align-items:center;gap:8px;padding:7px 13px;border-radius:999px;border:1px solid var(--line);background:var(--panel2);color:var(--muted);font:inherit;font-size:.76rem;cursor:pointer;transition:border-color .15s,color .15s,opacity .15s}
  .lg .dot{width:9px;height:9px;border-radius:50%;background:currentColor;flex:0 0 auto}
  .lg b{color:var(--ink);font-weight:600}
  .lg:not(.on){opacity:.42}
  .lg.on.k-brand{color:var(--gold);border-color:rgba(201,168,72,.5)}
  .lg.on.k-deleg{color:#7fb3ff;border-color:rgba(127,179,255,.45)}
  .lg.on.k-wait{color:#8fd7a6;border-color:rgba(143,215,166,.45)}
  .map-frame{position:relative;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:10px}
  .usmap{display:block;width:100%;height:auto}
  .usmap .st{fill:rgba(255,255,255,.045);stroke:var(--bg);stroke-width:.9;transition:fill .15s}
  .usmap .st.has{cursor:pointer}
  .usmap .st.has:hover{stroke:var(--gold);stroke-width:1.2}
  .usmap .pins .layer{transition:opacity .18s}
  .usmap .pins .layer.off{opacity:0;pointer-events:none}
  .usmap .pin{cursor:pointer;stroke:var(--bg);stroke-width:1.1;transition:r .12s}
  .usmap .pin:hover,.usmap .pin:focus{r:7;outline:none}
  .usmap .k-brand .pin{fill:var(--gold)}
  .usmap .k-deleg .pin{fill:#7fb3ff}
  .usmap .k-wait .pin{fill:#8fd7a6}
  .map-tip{position:absolute;z-index:5;pointer-events:none;background:#060a16;border:1px solid var(--gold);border-radius:9px;padding:8px 11px;font-size:.78rem;line-height:1.45;max-width:210px;box-shadow:0 8px 22px rgba(0,0,0,.5)}
  .map-tip b{display:block;color:var(--ink);font-weight:600}
  .map-tip i{display:block;color:var(--gold);font-style:normal;font-size:.72rem}
  .map-tip span{display:block;color:var(--muted);font-size:.72rem}
  .map-note{margin:0;color:var(--muted);font-size:.78rem;text-align:center}
  .map-note b{color:var(--gold)}
  @media(prefers-reduced-motion:reduce){.usmap .st,.usmap .pin,.usmap .pins .layer{transition:none}}
  @media(max-width:640px){.panel-row{grid-template-columns:1fr}}
  @media(max-width:860px){.panel-row.net-join-row{grid-template-columns:1fr}}
</style>
</head>
<body>
<%
  const d = data || {};
  const S = d.stats || {};
  const fmtDate = (v) => { if(!v) return ''; try { return new Date(v).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); } catch { return ''; } };
%>

<!-- HERO -->
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">The sLab Network</div>
    <h1><%= _t('network.hero_run_on') %> <span class="g">sLab</span>.</h1>
    <p><%= _t('network.hero_p') %></p>
    <div class="stats">
      <div class="stat"><b><%= S.brands || 0 %></b><span><%= _t('network.stat_brands') %></span></div>
      <div class="stat"><b><%= S.jobs || 0 %></b><span><%= _t('network.stat_jobs') %></span></div>
      <div class="stat"><b><%= S.videos || 0 %></b><span><%= _t('network.stat_videos') %></span></div>
      <div class="stat"><b><%= S.blogs || 0 %></b><span><%= _t('network.stat_blogs') %></span></div>
      <div class="stat"><b><%= S.news || 0 %></b><span><%= _t('network.stat_issues') %></span></div>
      <div class="stat"><b><%= S.help || 0 %></b><span><%= _t('network.stat_guides') %></span></div>
      <div class="stat"><b><%= S.market || 0 %></b><span><%= _t('network.stat_listings') %></span></div>
      <div class="stat"><b><%= S.templates || 0 %></b><span><%= _t('network.stat_templates') %></span></div>
      <div class="stat"><b><%= S.delegates || 0 %></b><span><%= _t('network.stat_delegates') %></span></div>
      <div class="stat"><b><%= S.waitlist || 0 %></b><span><%= _t('network.stat_waitlist') %></span></div>
    </div>
    <div class="hero-share">
      <button class="btn-share" onclick="openShare('network')" aria-label="<%= _t('network.share_aria') %>">
        <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
        <%= _t('network.share_btn') %>
      </button>
    </div>
  </div>
</header>

<!-- PRESENCE MAP -->
<% if (d.map) { %><%- include('../partials/_us-map', { map: d.map }) %><% } %>

<!-- DIRECTORY -->
<section id="directory">
  <div class="wrap">
    <div class="sec-head"><h2><%= _t('network.dir_h2') %></h2><span class="count"><%= (d.directory||[]).length %> <%= _t('network.members') %></span></div>
    <% if ((d.directory||[]).length) { %>
      <div class="grid g-dir">
        <% d.directory.forEach(function(b){ %>
          <div class="card brand-card">
            <%# Stretched link makes the whole card clickable without nesting a button in an <a> %>
            <a class="card-link" href="<%= b.url %>" target="_blank" rel="noopener" aria-label="<%= _t('network.visit') %> <%= b.name %>"></a>
            <button class="share-mini" onclick="shareBrand(this)" data-name="<%= b.name %>" data-url="<%= b.url %>" title="<%= _t('network.share') %> <%= b.name %>" aria-label="<%= _t('network.share') %> <%= b.name %>">
              <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
            </button>
            <div class="brand-top">
              <% if (b.logo) { %>
                <img class="brand-logo" src="<%= b.logo %>" alt="<%= b.name %>" loading="lazy">
              <% } else { %>
                <div class="brand-logo ph"><%= (b.name||'?').trim().charAt(0).toUpperCase() %></div>
              <% } %>
              <div>
                <div class="brand-name"><%= b.name %></div>
                <% if (b.industry) { %><div class="brand-ind"><%= b.industry %></div><% } %>
              </div>
            </div>
            <% if (b.tagline) { %><p class="brand-tag"><%= b.tagline %></p><% } %>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
              <% if (b.openJobs > 0) { %><span class="chip"><%= b.openJobs %> <%= _t(b.openJobs===1 ? 'network.open_role' : 'network.open_roles') %></span><% } %>
              <% if (b.followable) { %>
                <label class="follow-check" title="<%= _t('network.follow_title', { name: b.name }) %>">
                  <input type="checkbox" class="net-follow-cb" value="<%= b.key %>" data-name="<%= b.name %>" onchange="netFollowSync()">
                  <span><%= _t('network.follow') %></span>
                </label>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%= _t('network.empty_brands') %> <strong>Admin → Settings → sLab Network</strong>.</div>
    <% } %>
  </div>
</section>

<!-- JOB BOARD -->
<section id="jobs">
  <div class="wrap">
    <div class="sec-head"><h2><%= _t('network.jobs_h2') %></h2><span class="count"><%= _t('network.across_brands') %></span></div>
    <% if ((d.jobs||[]).length) { %>
      <div class="grid g-job">
        <% d.jobs.forEach(function(j){ %>
          <a class="card" href="<%= j.url %>" target="_blank" rel="noopener">
            <p class="job-title"><%= j.title %></p>
            <div class="job-meta">
              <% if (j.department) { %><span><%= j.department %></span><% } %>
              <% if (j.location) { %><span>&#128205; <%= j.location %></span><% } %>
              <% if (j.employmentType) { %><span><%= j.employmentType %></span><% } %>
              <% if (j.remote) { %><span><%= _t('network.remote') %></span><% } %>
            </div>
            <div class="job-brand"><%= j.brandName %></div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%= _t('network.empty_jobs') %> <strong>Settings → sLab Network → Syndicate my job board</strong>.</div>
    <% } %>
  </div>
</section>

<!-- NEWSROOM / PRESS -->
<section id="press">
  <div class="wrap">
    <div class="sec-head"><h2><%= _t('network.press_h2') %></h2><span class="count"><%= _t('network.press_sub') %></span></div>
    <% if ((d.press||[]).length) { %>
      <div class="grid g-tri">
        <% d.press.forEach(function(p){ %>
          <a class="card" href="<%= p.url %>" target="_blank" rel="noopener">
            <div class="job-brand" style="margin-top:0"><%= p.brandName %><% if (fmtDate(p.date)) { %> &middot; <span class="muted"><%= fmtDate(p.date) %></span><% } %></div>
            <p class="job-title" style="margin-top:8px"><%= p.title %></p>
            <% if (p.excerpt) { %><p class="brand-tag"><%= p.excerpt %></p><% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%= _t('network.empty_press') %></div>
    <% } %>
  </div>
</section>

<!-- WRITER CONTENT — one section per content type (blog / newsletter / help / …),
     driven by d.contentSections so a new content type flows on automatically. -->
<% (d.contentSections||[]).forEach(function(sec){ var items = (d.content&&d.content[sec.key])||[]; %>
<section id="content-<%= sec.key %>">
  <div class="wrap">
    <div class="sec-head"><h2><%= sec.label %></h2><span class="count"><%= sec.subtitle %></span></div>
    <% if (items.length) { %>
      <div class="grid g-tri">
        <% items.forEach(function(p){ %>
          <a class="card" href="<%= p.url %>" target="_blank" rel="noopener">
            <% if (sec.image && p.image) { %><div class="vid-thumb"><img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy"></div><% } %>
            <div class="job-brand" style="margin-top:0"><%= p.brandName %><% if (fmtDate(p.date)) { %> &middot; <span class="muted"><%= fmtDate(p.date) %></span><% } %></div>
            <p class="job-title" style="margin-top:8px"><%= p.title %></p>
            <% if (p.excerpt) { %><p class="brand-tag"><%= p.excerpt %></p><% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%= _t('network.empty_content', { noun: sec.noun }) %> <strong>Settings &rarr; sLab Network &rarr; Syndicate my writing</strong>.</div>
    <% } %>
  </div>
</section>
<% }) %>

<!-- VIDEOS -->
<section id="videos">
  <div class="wrap">
    <div class="sec-head"><h2><%= _t('network.videos_h2') %></h2><span class="count"><%= _t('network.latest_uploads') %></span></div>
    <% if ((d.videos||[]).length) { %>
      <div class="grid g-vid">
        <% d.videos.forEach(function(v){ %>
          <a class="card" href="<%= v.url %>" target="_blank" rel="noopener">
            <div class="vid-thumb">
              <% if (v.thumb) { %><img src="<%= v.thumb %>" alt="<%= v.title %>" loading="lazy"><% } %>
              <span class="play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            </div>
            <p class="job-title" style="margin:0 0 4px;font-size:.95rem"><%= v.title %></p>
            <div class="job-brand" style="margin-top:0"><%= v.brandName %></div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%= _t('network.empty_videos') %> <strong>Settings &rarr; sLab Network &rarr; Syndicate my videos</strong> <%= _t('network.empty_videos_note') %></div>
    <% } %>
  </div>
</section>

<!-- MARKETPLACE -->
<section id="marketplace">
  <div class="wrap">
    <div class="sec-head"><h2><%= _t('network.market_h2') %></h2><span class="count"><%- _t('network.market_sub') %></span></div>
    <% if ((d.market||[]).length) { %>
      <div class="grid g-vid">
        <% d.market.forEach(function(m){ %>
          <a class="card" href="<%= m.url %>" target="_blank" rel="noopener">
            <% if (m.image) { %><div class="vid-thumb"><img src="<%= m.image %>" alt="<%= m.title %>" loading="lazy"></div><% } %>
            <% if (m.category) { %><div class="job-brand" style="margin-top:0"><%= m.category %></div><% } %>
            <p class="job-title" style="margin:6px 0 4px"><%= m.title %></p>
            <div style="color:var(--gold);font-weight:600;font-size:.92rem"><%= m.price %></div>
            <div class="job-brand"><%= m.brandName %></div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%= _t('network.empty_market') %> <strong>Settings &rarr; sLab Network &rarr; Syndicate my marketplace</strong>.</div>
    <% } %>
  </div>
</section>

<!-- TEMPLATE & PAGE STORE -->
<section id="store">
  <div class="wrap">
    <div class="sec-head"><h2><%- _t('network.store_h2') %></h2><span class="count"><%= (d.templates||[]).length %> <%= _t('network.live') %></span></div>
    <% if ((d.templates||[]).length) { %>
      <div class="grid g-tri">
        <% d.templates.forEach(function(t){ %>
          <div class="card">
            <p class="job-title"><%= t.name %></p>
            <div class="job-meta"><span><%= t.category %></span><span><%= t.downloads %> <%= _t('network.downloads') %></span></div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><%- _t('network.empty_store') %></div>
    <% } %>
  </div>
</section>

<!-- DELEGATES + WAITLIST -->
<section id="join">
  <div class="wrap">
    <div class="panel-row net-join-row">
      <div class="cta">
        <div class="eyebrow"><%= _t('network.deleg_eyebrow') %></div>
        <h3><%= _t('network.deleg_h3') %></h3>
        <p><%= _t('network.deleg_p', { count: S.delegates || 0 }) %></p>
        <a class="btn" href="<%= (d.delegates&&d.delegates.signupUrl)||'/delegates/signup' %>"><%= _t('network.become_delegate') %></a>
      </div>
      <div class="cta net-join" id="net-join">
        <div class="eyebrow"><%= _t('network.join_eyebrow') %></div>
        <h3><%= _t('network.join_h3') %></h3>
        <p><%- _t('network.join_p') %> <span id="nf-count" class="nf-count"><%- _t('network.nf_tick') %></span></p>
        <form class="wl-form" onsubmit="return netFollowSubmit(event)">
          <input type="email" name="email" placeholder="you@example.com" required>
          <button class="btn" type="submit" id="nf-btn" disabled><%= _t('network.follow_selected') %></button>
        </form>
        <div class="wl-msg" id="nf-msg"></div>
        <button type="button" class="btn ghost" onclick="netFollowAll()" style="margin-top:10px;font-size:.82rem;padding:8px 16px"><%= _t('network.select_every') %></button>
      </div>
      <div class="cta" id="waitlist">
        <div class="eyebrow"><%= _t('network.mesh_eyebrow') %></div>
        <h3><%= _t('network.join_waitlist') %></h3>
        <p><%= _t('network.mesh_p', { count: S.waitlist || 0 }) %></p>
        <form class="wl-form" method="POST" action="/network/waitlist" onsubmit="return wlSubmit(event)">
          <input type="email" name="email" placeholder="you@company.com" required>
          <input type="text" name="location" placeholder="<%= _t('network.city_state_ph') %>" maxlength="120" autocomplete="address-level2">
          <button class="btn" type="submit"><%= _t('network.request_access') %></button>
        </form>
        <div class="wl-msg" id="wl-msg"></div>
      </div>
    </div>
  </div>
</section>

<footer class="net">
  <div class="wrap">
    <%= _t('network.powered_by') %> <a href="https://slab.madladslab.com">sLab</a> &middot; The sLab Network &middot;
    <a href="https://slab.madladslab.com/start"><%= _t('network.build_site') %></a>
  </div>
</footer>

<!-- SHARE MODAL — populated by openShare() for either the network or a single brand -->
<div class="sh-overlay" id="sh-overlay" role="dialog" aria-modal="true" aria-labelledby="sh-title">
  <div class="sh-modal">
    <button class="sh-close" type="button" onclick="closeShare()" aria-label="<%= _t('network.close') %>">&times;</button>
    <h3 id="sh-title"><%= _t('network.share_modal_title') %></h3>
    <p class="sh-sub" id="sh-sub"><%= _t('network.share_sub') %></p>
    <div class="sh-copy">
      <input id="sh-url" type="text" readonly value="https://slab.madladslab.com/network">
      <button id="sh-copy-btn" type="button" onclick="shCopy()"><%= _t('network.copy') %></button>
    </div>
    <div class="sh-socials">
      <a id="sh-x" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>X</a>
      <a id="sh-linkedin" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>LinkedIn</a>
      <a id="sh-facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073"/></svg>Facebook</a>
      <a id="sh-email"><svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg><%= _t('network.email') %></a>
    </div>
    <div class="sh-hint" id="sh-hint">
      <b>&#128176; <%= _t('network.hint_bold') %></b><br><%= _t('network.hint_body') %> <a href="/delegates/signup"><%= _t('network.become_delegate') %> &rarr;</a>
    </div>
  </div>
</div>

<script>
  // ── Share modal — drives the hero "Share the Network" button and per-brand icons ──
  var NET_URL = 'https://slab.madladslab.com/network';
  function shSvcLinks(url, text){
    var u = encodeURIComponent(url), t = encodeURIComponent(text);
    return {
      x:        'https://twitter.com/intent/tweet?text=' + t + '&url=' + u,
      linkedin: 'https://www.linkedin.com/sharing/share-offsite/?url=' + u,
      facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + u,
      email:    'mailto:?subject=' + t + '&body=' + t + '%20' + u
    };
  }
  function openShare(mode, name, url){
    var isBrand = mode === 'brand';
    url = url || NET_URL;
    document.getElementById('sh-title').textContent = isBrand ? ('Share ' + name) : 'Share the sLab Network';
    document.getElementById('sh-sub').textContent   = isBrand ? ('Give ' + name + ' a shoutout from the network.') : 'Spread the word — help the network grow.';
    document.getElementById('sh-url').value = url;
    var text = isBrand ? ('Check out ' + name + ' on the sLab Network') : 'These brands run on sLab. Explore the sLab Network:';
    var L = shSvcLinks(url, text);
    document.getElementById('sh-x').href        = L.x;
    document.getElementById('sh-linkedin').href = L.linkedin;
    document.getElementById('sh-facebook').href = L.facebook;
    document.getElementById('sh-email').href    = L.email;
    // Delegate hint: prominent card on the network share, light line on a brand share.
    var hint = document.getElementById('sh-hint');
    hint.className = 'sh-hint' + (isBrand ? ' small' : '');
    hint.innerHTML = isBrand
      ? 'Powered by <a href="https://slab.madladslab.com/start">sLab</a> &middot; <a href="/delegates/signup">refer &amp; earn &rarr;</a>'
      : '<b>&#128176; Earn from every brand you bring.</b><br>Sharing sLab can pay &mdash; join the delegate program for recurring commission. <a href="/delegates/signup">Become a delegate &rarr;</a>';
    document.getElementById('sh-overlay').classList.add('open');
  }
  function closeShare(){ document.getElementById('sh-overlay').classList.remove('open'); }
  // Per-brand: native share sheet first (best on mobile), modal fallback on desktop.
  function shareBrand(btn){
    var name = btn.getAttribute('data-name'), url = btn.getAttribute('data-url');
    if (navigator.share){ navigator.share({ title: name, text: 'Check out ' + name + ' on the sLab Network', url: url }).catch(function(){}); return; }
    openShare('brand', name, url);
  }
  function shCopy(){
    var i = document.getElementById('sh-url'); i.select();
    try { navigator.clipboard.writeText(i.value); } catch(e){ try { document.execCommand('copy'); } catch(_){} }
    var b = document.getElementById('sh-copy-btn'), o = b.textContent;
    b.textContent = 'Copied'; setTimeout(function(){ b.textContent = o; }, 1400);
  }
  (function(){
    var ov = document.getElementById('sh-overlay');
    if (ov) ov.addEventListener('click', function(e){ if (e.target === ov) closeShare(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeShare(); });
  })();

  // ── Follow many — track ticked brands across the directory, subscribe in one POST ──
  var NF_SEL = {};
  function netFollowSync(){
    NF_SEL = {};
    document.querySelectorAll('.net-follow-cb:checked').forEach(function(cb){ NF_SEL[cb.value] = cb.getAttribute('data-name'); });
    var n = Object.keys(NF_SEL).length;
    var cnt = document.getElementById('nf-count'), btn = document.getElementById('nf-btn');
    if (cnt) cnt.textContent = n ? ('Following ' + n + ' brand' + (n===1?'':'s') + '.') : 'Tick “Follow” on the brands above.';
    if (btn) btn.disabled = n === 0;
  }
  function netFollowAll(){
    document.querySelectorAll('.net-follow-cb').forEach(function(cb){ cb.checked = true; });
    netFollowSync();
    var j = document.getElementById('net-join'); if (j) j.scrollIntoView({ behavior:'smooth', block:'center' });
  }
  function netFollowSubmit(e){
    e.preventDefault();
    var keys = Object.keys(NF_SEL), f = e.target;
    var msg = document.getElementById('nf-msg'), btn = document.getElementById('nf-btn');
    if (!keys.length){ msg.style.color = '#e6a3a3'; msg.textContent = 'Pick at least one brand to follow.'; return false; }
    btn.disabled = true;
    fetch('/network/follow', { method:'POST', headers:{ 'Content-Type':'application/x-www-form-urlencoded', 'Accept':'application/json' }, body:new URLSearchParams({ email: f.email.value, keys: keys.join(',') }) })
      .then(function(r){ return r.json(); }).then(function(x){
        msg.style.color = x.ok ? '#8fd7a6' : '#e6a3a3';
        msg.textContent = x.message || '';
        if (x.ok){
          document.querySelectorAll('.net-follow-cb:checked').forEach(function(cb){ cb.checked = false; });
          f.reset(); netFollowSync();
        } else { btn.disabled = false; }
      }).catch(function(){ msg.style.color = '#e6a3a3'; msg.textContent = 'Something went wrong — try again.'; btn.disabled = false; });
    return false;
  }

  // Waitlist — AJAX submit with inline confirmation; degrades to a normal POST.
  function wlSubmit(e){
    e.preventDefault();
    var f=e.target, msg=document.getElementById('wl-msg'), btn=f.querySelector('button');
    btn.disabled=true;
    fetch('/network/waitlist',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'},body:new URLSearchParams(new FormData(f))})
      .then(function(r){return r.json()}).then(function(x){
        msg.style.color = x.ok ? '#8fd7a6' : '#e6a3a3';
        msg.textContent = x.message||'';
        if(x.ok && x.status==='added') f.reset();
        btn.disabled=false;
      }).catch(function(){ msg.style.color='#e6a3a3'; msg.textContent='Something went wrong — try again.'; btn.disabled=false; });
    return false;
  }
  // Reflect the non-JS redirect state on load.
  (function(){
    var p=new URLSearchParams(location.search), j=p.get('joined'), msg=document.getElementById('wl-msg');
    if(!j||!msg) return;
    msg.style.color = j==='invalid' ? '#e6a3a3' : '#8fd7a6';
    msg.textContent = j==='invalid' ? 'Please enter a valid email.'
      : j==='exists' ? "You're already on the list — we'll be in touch."
      : "You're on the list. We'll reach out as the mesh opens up.";
  })();
</script>
</body>
</html>
