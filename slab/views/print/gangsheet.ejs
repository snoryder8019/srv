<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="<%= fontsHref %>" rel="stylesheet">
<%- include('_material-style') %>
<style>
  html,body{background:#fff}
  .sheet{position:relative;width:<%= page.wIn %>in;height:<%= page.hIn %>in;background:#fff}
  .cell{position:absolute;width:<%= cellW %>in;height:<%= cellH %>in}
  .cell .material{box-shadow:none}
  /* crop marks */
  .cm{position:absolute;background:#222;z-index:50}
  .cm.h{height:0.005in;width:0.13in}
  .cm.v{width:0.005in;height:0.13in}
</style>
</head>
<body>
<div class="sheet">
  <% for (let r = 0; r < rows; r++) { for (let c = 0; c < cols; c++) {
       const left = (page.marginIn + c * (cellW + gutterIn)).toFixed(3);
       const top  = (page.marginIn + r * (cellH + gutterIn)).toFixed(3);
       const b = bleedIn, tw = cellW, th = cellH; %>
    <div class="cell" style="left:<%= left %>in;top:<%= top %>in">
      <%- include('_material-body') %>
      <!-- crop marks at the four trim corners -->
      <span class="cm v" style="left:<%= b %>in;top:<%= (b-0.13).toFixed(3) %>in"></span>
      <span class="cm h" style="left:<%= (b-0.13).toFixed(3) %>in;top:<%= b %>in"></span>
      <span class="cm v" style="left:<%= (tw-b).toFixed(3) %>in;top:<%= (b-0.13).toFixed(3) %>in"></span>
      <span class="cm h" style="left:<%= (tw-b).toFixed(3) %>in;top:<%= b %>in"></span>
      <span class="cm v" style="left:<%= b %>in;top:<%= (th-b).toFixed(3) %>in"></span>
      <span class="cm h" style="left:<%= (b-0.13).toFixed(3) %>in;top:<%= (th-b).toFixed(3) %>in"></span>
      <span class="cm v" style="left:<%= (tw-b).toFixed(3) %>in;top:<%= (th-b).toFixed(3) %>in"></span>
      <span class="cm h" style="left:<%= (tw-b).toFixed(3) %>in;top:<%= (th-b).toFixed(3) %>in"></span>
    </div>
  <% } } %>
</div>
</body>
</html>
