# domain-provisioner config — copy to .env on the VPS and fill in.

# Slab reachable from the VPS. Over the tunnel Slab is on localhost:3602.
SLAB_URL=http://127.0.0.1:3602
SLAB_HOST_HEADER=slab.madladslab.com

# MUST match SLAB_PROVISION_KEY in slab/.env
SLAB_PROVISION_KEY=

# Where Apache proxies tenant traffic (Slab, via the tunnel).
TUNNEL=127.0.0.1:3602

# Let's Encrypt account email (renewal + expiry notices).
CERTBOT_EMAIL=admin@madladslab.com

# Shared webroot for HTTP-01 challenges (referenced by the catch-all + templates).
ACME_WEBROOT=/var/www/acme

# Apache sites-available dir.
APACHE_SITES_AVAILABLE=/etc/apache2/sites-available

# This VPS's public IP. If set, the provisioner will skip a domain until its A
# record actually points here (prevents doomed certbot attempts). Recommended.
EXPECTED_IP=104.237.138.28

# Reconcile interval.
POLL_INTERVAL_MS=120000

# Set to 1 to a2dissite tenant vhosts that are no longer verified. Default off.
PRUNE=

# Comma-separated allowlist of apex domains to act on. When set, ONLY these are
# provisioned — safety valve for first rollout. Empty = all verified domains.
ONLY_DOMAINS=

# Set to 1 to log actions without touching certbot/apache (great for first run).
DRY_RUN=

# Set to 1 to run a single cycle and exit (for cron-style use instead of a daemon).
RUN_ONCE=
