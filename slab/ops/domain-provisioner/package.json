{
  "name": "domain-provisioner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reconciles Slab tenant custom domains into Apache vhosts + Let's Encrypt certs on the VPS.",
  "bin": { "domain-provisioner": "provisioner.mjs" },
  "scripts": {
    "start": "node provisioner.mjs",
    "once": "RUN_ONCE=1 node provisioner.mjs",
    "dry": "RUN_ONCE=1 DRY_RUN=1 node provisioner.mjs"
  },
  "engines": { "node": ">=18" }
}
