<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Euchre · cards.madladslab</title>
<style>
  :root { --felt:#0f5132; --feltlo:#0a3a24; --ink:#e9ecef; --muted:#9fb0a6; --gold:#e3c567; --red:#d6453d; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, -apple-system, sans-serif; background:#0a0d0b; color:var(--ink); }
  #wrap { max-width:760px; margin:0 auto; padding:14px; }
  h1 { font-size:14px; letter-spacing:.22em; color:var(--muted); font-weight:700; margin:0 0 10px; }
  #status { font-size:12.5px; color:var(--muted); min-height:18px; }
  #status b { color:var(--gold); }
  canvas { width:100%; background:radial-gradient(circle at 50% 38%, var(--felt), var(--feltlo)); border-radius:16px; display:block; margin:10px 0; box-shadow: inset 0 0 60px rgba(0,0,0,.45); }
  .row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  #controls { margin:8px 0; min-height:42px; }
  #hand { margin-top:6px; gap:6px; }
  .chip { background:#f6f6f4; color:#15171a; border:2px solid transparent; border-radius:9px; padding:10px 12px;
          font-size:17px; font-weight:800; cursor:default; min-width:44px; text-align:center; transition:transform .08s; }
  .chip.red { color:var(--red); }
  .chip.play { cursor:pointer; border-color:#2fbf71; }
  .chip.play:hover { transform:translateY(-4px); }
  .chip.dim { opacity:.4; }
  button.act { background:#2fbf71; color:#05230f; border:none; border-radius:9px; padding:10px 15px; font-weight:800; cursor:pointer; font-size:14px; }
  button.act.ghost { background:#1d3b2b; color:var(--ink); }
  button.act.alone { background:var(--gold); color:#241d05; }
  button.act:disabled { opacity:.4; cursor:default; }
  .seatcard { background:#11231a; border-radius:10px; padding:8px 10px; font-size:12px; min-width:120px; }
  .seatcard .nm { font-weight:700; }
  .seatcard .tag { color:var(--muted); font-size:11px; }
  .seatcard.you { outline:1px solid var(--gold); }
  .seatcard.turn { outline:2px solid #2fbf71; }
  #log { font:11.5px ui-monospace, monospace; color:#7e9388; white-space:pre-wrap; max-height:120px; overflow:auto; background:#070a08; border-radius:9px; padding:8px; margin-top:10px; }

  #over { position:fixed; inset:0; background:rgba(4,7,5,.82); display:none; align-items:center; justify-content:center; padding:18px; z-index:50; }
  #over.show { display:flex; }
  .overcard { width:100%; max-width:440px; background:#10231a; border:1px solid rgba(255,255,255,.08); border-radius:18px; padding:24px; text-align:center; box-shadow:0 24px 70px rgba(0,0,0,.5); }
  .overcard .result { font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); }
  .overcard h2 { margin:6px 0 2px; font-size:34px; }
  .overcard .score { font-size:20px; color:var(--gold); margin-bottom:14px; font-weight:800; }
  .stand { text-align:left; background:#0a1812; border-radius:10px; padding:8px 12px; margin:10px 0 16px; }
  .stand .r { display:flex; justify-content:space-between; font-size:13px; padding:3px 0; color:#cfe; }
  .stand .r .w { color:#2fbf71; font-weight:700; } .stand .r .l { color:#9fb0a6; }
  .overcard button { width:100%; border:none; border-radius:11px; padding:13px; font-size:15px; font-weight:800; cursor:pointer; margin-top:9px; }
  .overcard .primary { background:#2fbf71; color:#05230f; } .overcard .ghost { background:#1d3b2b; color:#e9ecef; } .overcard .danger { background:#3a1d1d; color:#f0c9c9; }
  #reseatPanel { display:none; margin-top:8px; }
  #reseatPanel.show { display:block; }
  #reseatPanel .opt { background:#15302296; border:1px solid rgba(255,255,255,.07); }
  /* landscape fill view */
  #fsbtn { position:fixed; top:10px; right:10px; z-index:70; width:40px; height:40px; border-radius:10px; background:rgba(17,35,26,.85); color:#cfe7d8; border:1px solid rgba(255,255,255,.14); font-size:18px; line-height:1; cursor:pointer; }
  #fsbtn:active { transform:scale(.95); }
  #rotateHint { display:none; }
  body.fill { overflow:hidden; }
  body.fill #wrap { position:fixed; inset:0; max-width:none; width:100vw; height:100dvh; margin:0; padding:6px 8px; background:#070a08; display:flex; flex-direction:column; z-index:60; }
  body.fill h1, body.fill #log { display:none; }
  body.fill #status { flex:0 0 auto; font-size:11px; margin:0 0 2px; }
  body.fill #felt { flex:1 1 auto; min-height:0; width:100%; height:100%; object-fit:contain; margin:2px 0; border-radius:12px; }
  body.fill #controls { flex:0 0 auto; min-height:0; margin:2px 0; justify-content:center; }
  body.fill #hand { flex:0 0 auto; margin:2px 0; justify-content:center; }
  body.fill.portrait #rotateHint { display:block; position:fixed; left:0; right:0; bottom:8px; text-align:center; color:#cfe7d8; font-size:12.5px; z-index:71; pointer-events:none; }
</style>
</head>
<body>
<button id="fsbtn" title="Fill screen" aria-label="Fill screen">⛶</button>
<div id="rotateHint">↻ Rotate your phone for the full table</div>
<div id="wrap">
  <h1>EUCHRE · LIVE TABLE</h1>
  <div id="status">connecting…</div>
  <canvas id="felt" width="760" height="360"></canvas>
  <div class="row" id="controls"></div>
  <div class="row" id="hand"></div>
  <div id="log"></div>
  <div id="over"><div class="overcard">
    <div class="result" id="overResult">Game over</div>
    <h2 id="overTitle">Game Over</h2>
    <div class="score" id="overScore"></div>
    <div class="stand" id="overStand"></div>
    <button class="primary" id="btnRematch">Rematch</button>
    <button class="ghost" id="btnReseat">Change partners</button>
    <div id="reseatPanel"></div>
    <button class="danger" id="btnExit">Exit to arcade</button>
  </div></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/static/js/cards-render.js"></script>
<script>
  const qs = new URLSearchParams(location.search);
  const ticket = qs.get('ticket');
  const $ = (id) => document.getElementById(id);
  const SYM = { hearts:'♥', diamonds:'♦', clubs:'♣', spades:'♠', H:'♥', D:'♦', C:'♣', S:'♠' };
  const SUITNAME = { hearts:'Hearts', diamonds:'Diamonds', clubs:'Clubs', spades:'Spades' };
  const isRed = (code) => code.endsWith('H') || code.endsWith('D');
  const pretty = (code) => code.replace(/(10|[9JQKA])([HDCS])/, (_,r,s)=> r + SYM[s]);
  function log(m){ $('log').textContent = (m + '\n' + $('log').textContent).slice(0, 3000); }

  let mySeat = null, state = null, priv = null, acted = null;

  const socket = io({ transports:['websocket','polling'], withCredentials:true });

  socket.on('connect', () => { setStatus('connected'); if (ticket) socket.emit('table:join', { ticket }); else log('no ?ticket= in URL'); });
  socket.on('disconnect', () => setStatus('disconnected'));
  socket.on('table:error', (e) => log('⚠ ' + e.message));
  socket.on('seat:hand', (h) => { mySeat = h.seat; priv = h; render(); maybeAct(); });
  socket.on('table:state', (s) => { state = s; if (mySeat==null && s.youSeat!=null) mySeat=s.youSeat; try { onState(s); } catch(e){} render(); maybeAct(); });
  socket.on('table:event', (ev) => logEvent(ev));

  // ---- acting: only when it's my turn; idempotent per decision point ----
  function decisionId(){
    if (!state || !state.view) return null;
    const v = state.view;
    return [state.handNo, v.phase, v.tricksPlayed, (v.trick||[]).length, v.turn].join(':');
  }
  function myTurn(){ return state && state.view && state.view.turn === mySeat; }

  function maybeAct(){
    // human acts via clicks; this only manages the idempotency lock so the
    // controls re-enable on each new decision point.
    const id = decisionId();
    if (id !== acted) render();
  }

  function emitAction(action){
    const id = decisionId();
    if (id === acted) return;     // already acted at this decision point
    acted = id;
    socket.emit('game:action', { action });
    render(); // lock controls until next state
  }

  // ---------------- rendering ----------------
  function setStatus(extra){
    if (!state){ $('status').textContent = extra || ''; return; }
    const v = state.view;
    if (state.phase === 'lobby'){ $('status').textContent = 'Lobby — ready up to start'; return; }
    if (state.phase === 'gameOver'){
      const win = state.scores[0] >= state.scores[1] ? 'Team A (you+partner)' : 'Team B';
      $('status').innerHTML = `Game over — <b>${state.scores[0]}–${state.scores[1]}</b>`;
      return;
    }
    const trump = v.trump ? `<b>${SYM[v.trump]} ${SUITNAME[v.trump]}</b> trump` : (v.upCard ? `up-card <b>${pretty(v.upCard)}</b>` : 'bidding');
    const turnTxt = v.turn===mySeat ? '<b>YOUR TURN</b>' : `seat ${v.turn}`;
    const phase = ({bidding1:'Bidding (order up)',bidding2:'Bidding (call)',discard:'Dealer discards',playing:'Trick play'})[v.phase] || v.phase;
    $('status').innerHTML = `${phase} · ${trump} · ${turnTxt} · scores <b>${state.scores[0]}–${state.scores[1]}</b>`;
  }

  function render(){
    if (!state){ return; }
    setStatus();
    renderControls();
    renderHand();
  }

  function renderControls(){
    const box = $('controls'); box.innerHTML = '';
    if (!state) return;

    if (state.phase === 'lobby'){
      const meReady = (state.seats[mySeat]||{}).ready;
      const rb = document.createElement('button');
      rb.className = 'act'; rb.textContent = meReady ? 'Ready ✓ (waiting…)' : 'Ready';
      rb.disabled = !!meReady;
      rb.onclick = () => socket.emit('seat:ready', { ready:true });
      box.appendChild(rb);
      // offer to fill any empty seats with bots
      state.seats.forEach((s) => {
        if (!s.occupied){
          const b = document.createElement('button');
          b.className='act ghost'; b.textContent = `+ Bot in seat ${s.seat}`;
          b.onclick = () => socket.emit('seat:addBot', { seat:s.seat });
          box.appendChild(b);
        }
      });
      return;
    }

    if (state.phase !== 'playing' && state.phase !== 'gameOver') return;
    if (!priv || !myTurn()) return;
    const locked = decisionId() === acted;
    const v = state.view;

    // bidding / non-card actions become buttons; card actions are handled on the hand
    (priv.legal||[]).forEach((a) => {
      if (a.card) return; // play/discard handled in hand
      const b = document.createElement('button');
      b.disabled = locked;
      if (a.type === 'pass'){ b.className='act ghost'; b.textContent='Pass'; }
      else if (a.type === 'orderUp'){
        const sym = v.upCard ? SYM[v.upCard.slice(-1)] : '';
        b.className = a.alone ? 'act alone' : 'act';
        b.textContent = a.alone ? `Order up ${sym} — ALONE` : `Order up ${sym}`;
      } else if (a.type === 'call'){
        b.className = a.alone ? 'act alone' : 'act';
        b.textContent = a.alone ? `Call ${SYM[a.suit]} — ALONE` : `Call ${SYM[a.suit]}`;
      } else { b.className='act'; b.textContent = a.type; }
      b.onclick = () => emitAction(a);
      box.appendChild(b);
    });
    if (v.phase === 'discard'){
      const hint = document.createElement('span');
      hint.style.cssText='color:var(--muted);font-size:12px'; hint.textContent='Tap a card to discard';
      box.appendChild(hint);
    }
  }

  function renderHand(){
    const box = $('hand'); box.innerHTML='';
    const hand = (priv && priv.hand) || [];
    const locked = decisionId() === acted;
    // map of card -> legal action (play or discard) for THIS turn
    const legalByCard = {};
    if (priv && myTurn() && !locked) (priv.legal||[]).forEach((a)=>{ if (a.card) legalByCard[a.card]=a; });
    hand.forEach((code) => {
      const c = document.createElement('div');
      c.className = 'chip' + (isRed(code)?' red':'') + (legalByCard[code]?' play':'') + (Object.keys(legalByCard).length && !legalByCard[code] ? ' dim':'');
      c.textContent = pretty(code);
      if (legalByCard[code]) c.onclick = () => emitAction(legalByCard[code]);
      box.appendChild(c);
    });
  }

  // ---------------- table render (cards-render.js) ----------------
  const CW = 760, CH = 360;
  const relOf = (seat) => (seat - (mySeat||0) + 4) % 4;
  const SEATXY  = { 0:[CW/2,CH-52], 1:[70,CH/2], 2:[CW/2,52], 3:[CW-70,CH/2] };
  const TRICKXY = { 0:[CW/2,CH-128], 1:[210,CH/2], 2:[CW/2,128], 3:[CW-210,CH/2] };
  const HANDXY  = { 1:[120,CH/2], 2:[CW/2,98], 3:[CW-120,CH/2] };
  const inFlight = {};
  const FCW=CardsRender.cardW, FCH=CardsRender.cardH, BW=CardsRender.backW, BH=CardsRender.backH;

  function oppHandCount(s, v){
    if (state.phase !== 'playing') return 5;
    const tp = v.tricksPlayed || 0;
    const played = (v.trick||[]).some(p => p.seat === s.seat);
    return Math.max(0, Math.min(6, 5 - tp - (played ? 1 : 0)));
  }

  function drawBoard(ctx, W, H, now){
    CardsRender.drawTable(ctx, W, H);
    if (!state) return;
    const v = state.view || {};

    if (v.trump){
      ctx.fillStyle='rgba(0,0,0,.35)'; CardsRender.roundRect(ctx,W/2-92,8,184,28,8); ctx.fill();
      ctx.fillStyle=(v.trump==='hearts'||v.trump==='diamonds')?'#ff8d86':'#e8efe9';
      ctx.font='bold 16px system-ui'; ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText('TRUMP  '+(SYM[v.trump]||'')+' '+SUITNAME[v.trump], W/2, 22);
    }

    // opponent hands as fanned card backs
    (state.seats||[]).forEach((s) => {
      if (!s.occupied || s.seat===mySeat) return;
      const rel = relOf(s.seat); const c = HANDXY[rel]; if (!c) return;
      const n = oppHandCount(s, v); if (!n) return;
      const vertical = (rel===1 || rel===3);
      CardsRender.fanPositions(c[0], c[1], n, { vertical, step: vertical?14:13 })
        .forEach(([x,y]) => CardsRender.cardBack(ctx, x-BW/2, y-BH/2, BW, BH));
    });

    // seat plates (turn pulse)
    (state.seats||[]).forEach((s) => {
      const [x,y] = SEATXY[relOf(s.seat)];
      const isTurn = v.turn===s.seat && state.phase==='playing'; const isDealer = v.dealer===s.seat;
      const pulse = isTurn ? 0.12*(0.5+0.5*Math.sin(now/240)) : 0;
      ctx.fillStyle = isTurn ? ('rgba(47,191,113,'+(0.20+pulse).toFixed(3)+')') : 'rgba(0,0,0,.30)';
      CardsRender.roundRect(ctx, x-64,y-20,128,40,10); ctx.fill();
      if (isTurn){ ctx.strokeStyle='#2fbf71'; ctx.lineWidth=2; ctx.stroke(); }
      ctx.fillStyle = s.seat===mySeat ? '#e3c567' : '#eef2ee';
      ctx.font='bold 12.5px system-ui'; ctx.textAlign='center'; ctx.textBaseline='middle';
      const tag=s.bot?' \u{1F916}':''; const me=s.seat===mySeat?' (you)':'';
      ctx.fillText((s.displayName||('Seat '+s.seat))+tag+me, x, y-4);
      ctx.fillStyle='#9fb0a6'; ctx.font='10.5px system-ui';
      const tricks = v.trickWins ? v.trickWins[s.seat] : 0;
      ctx.fillText((isDealer?'\u00b7 dealer \u00b7  ':'')+(state.phase==='playing'?('tricks '+tricks):(s.ready?'ready':'\u2026')), x, y+10);
    });

    // current trick (skip cards mid-flight)
    (v.trick||[]).forEach((p) => {
      if (inFlight[p.seat+':'+p.card]) return;
      const [x,y] = TRICKXY[relOf(p.seat)];
      CardsRender.cardFace(ctx, x-FCW/2, y-FCH/2, FCW, FCH, p.card);
    });

    if (v.phase==='bidding1' && v.upCard){
      const x=W/2, y=H/2;
      CardsRender.cardFace(ctx, x-FCW/2, y-FCH/2, FCW, FCH, v.upCard, { highlight:true });
      ctx.fillStyle='#cdd8cf'; ctx.font='11px system-ui'; ctx.textAlign='center';
      ctx.fillText('up-card', x, y+FCH/2+12);
    }
  }

  // ---- animations from state diffs ----
  let prevHandNo = null, prevTrick = [];
  function onState(s){
    if (!s || !window.CardsRender) return;
    if (s.handNo && s.handNo !== prevHandNo && s.phase !== 'lobby') animateDeal(s);
    const nt = (s.view && s.view.trick) || [];
    if (nt.length > prevTrick.length) nt.slice(prevTrick.length).forEach((p) => animatePlay(s, p));
    prevTrick = nt.slice(); prevHandNo = s.handNo;
  }
  function animatePlay(s, p){
    const from = SEATXY[relOf(p.seat)], to = TRICKXY[relOf(p.seat)];
    const key = p.seat+':'+p.card; inFlight[key] = true;
    CardsRender.fly({ from:[from[0],from[1]], to:[to[0],to[1]], dur:260,
      draw:(ctx,x,y)=> CardsRender.cardFace(ctx, x-FCW/2, y-FCH/2, FCW, FCH, p.card),
      onDone:()=>{ delete inFlight[key]; } });
  }
  function animateDeal(s){
    const v = s.view || {}; const from = SEATXY[relOf(v.dealer!=null?v.dealer:0)];
    [0,1,2,3].forEach((rel, i) => {
      const to = SEATXY[rel];
      setTimeout(() => CardsRender.fly({ from:[from[0],from[1]], to:[to[0],to[1]], dur:300,
        draw:(ctx,x,y)=> CardsRender.cardBack(ctx, x-BW/2, y-BH/2, BW, BH) }), i*70);
    });
  }

  // boot the table renderer (assets stream in; falls back to gradient until loaded)
  if (window.CardsRender){ CardsRender.loadAssets(); CardsRender.loop(drawBoard); }

  function logEvent(ev){
    if (ev.type==='bid') log(`seat ${ev.seat} ${ev.bid==='pass'?'passes':(ev.bid+' '+(ev.trump?SYM[ev.trump]:''))}${ev.alone?' ALONE':''}`);
    else if (ev.type==='turnedDown') log(`up-card turned down (${SYM[ev.suit]})`);
    else if (ev.type==='play:begin') log(`play begins — trump ${SYM[ev.trump]}, maker seat ${ev.maker}${ev.alone?' (alone)':''}`);
    else if (ev.type==='trickWon') log(`seat ${ev.seat} takes the trick`);
    else if (ev.type==='handWon') log(`hand: team ${ev.team} +${ev.points} (${ev.euchred?'EUCHRED!':ev.makerTricks+' tricks'})`);
    else if (ev.type==='gameOver') log(`GAME OVER — ${ev.scores[0]}–${ev.scores[1]}`);
  }

  // ---------------- end-game ----------------
  let overData = null;
  socket.on('table:over', (o) => { overData = o; showOver(o); });

  function teamLabel(team){
    if (mySeat==null) return team===0 ? 'Team A' : 'Team B';
    return team === (mySeat % 2) ? 'Your team' : 'Opponents';
  }
  function showOver(o){
    const myTeam = mySeat==null ? null : (mySeat % 2);
    const iWon = myTeam!=null && o.winnerTeam===myTeam;
    $('overResult').textContent = `Game ${o.gamesPlayed} · final`;
    $('overTitle').textContent = myTeam==null ? `${o.winnerTeam===0?'Team A':'Team B'} wins`
      : (iWon ? 'You win! 🎉' : 'You lost');
    $('overScore').textContent = `${o.scores[0]} – ${o.scores[1]}`;
    $('overStand').innerHTML = (o.standings||[]).map(st =>
      `<div class="r"><span>${st.displayName||('Seat '+st.seat)}${st.bot?' 🤖':''}${st.seat===mySeat?' (you)':''}</span>`+
      `<span class="${st.won?'w':'l'}">${st.won?'WON':'lost'} · team ${st.team===0?'A':'B'}</span></div>`).join('');
    $('reseatPanel').classList.remove('show'); $('reseatPanel').innerHTML='';
    $('over').classList.add('show');
  }
  function hideOver(){ $('over').classList.remove('show'); }

  $('btnRematch').onclick = () => { socket.emit('table:rematch'); hideOver(); };
  $('btnExit').onclick = () => { window.location.href = 'https://games.madladslab.com/'; };
  $('btnReseat').onclick = () => {
    const panel = $('reseatPanel');
    if (panel.classList.contains('show')) { panel.classList.remove('show'); return; }
    // three distinct partnerships from current seat occupants (by name)
    const nm = {}; (overData?.standings||[]).forEach(st => nm[st.seat] = st.displayName || ('Seat '+st.seat));
    const opts = [
      { perm:[0,1,2,3], pairs:[[0,2],[1,3]] },
      { perm:[0,2,1,3], pairs:[[0,1],[2,3]] },
      { perm:[0,1,3,2], pairs:[[0,3],[1,2]] },
    ];
    panel.innerHTML = '';
    opts.forEach(o => {
      const b = document.createElement('button');
      b.className = 'ghost opt';
      const lbl = o.pairs.map(p => `${nm[p[0]]} + ${nm[p[1]]}`).join('  vs  ');
      b.textContent = lbl;
      b.onclick = () => { socket.emit('table:reseat', { perm:o.perm }); socket.emit('table:rematch'); hideOver(); };
      panel.appendChild(b);
    });
    panel.classList.add('show');
  };

  // returning to a fresh lobby (after rematch) closes the end screen
  const _origState = socket.listeners('table:state');
  socket.on('table:state', (s2) => { if (s2 && s2.phase === 'lobby') hideOver(); });

  // ---------------- landscape fill view ----------------
  (function(){
    const fsbtn = document.getElementById('fsbtn');
    const wrapEl = document.getElementById('wrap');
    const felt = document.getElementById('felt');
    if (!fsbtn) return;
    const isPortrait = () => window.matchMedia('(orientation: portrait)').matches;
    function syncPortrait(){ document.body.classList.toggle('portrait', document.body.classList.contains('fill') && isPortrait()); }
    async function enterFill(){
      document.body.classList.add('fill'); fsbtn.textContent='✕'; fsbtn.title='Exit full view';
      try { if (wrapEl.requestFullscreen) await wrapEl.requestFullscreen(); } catch(e){}
      try { if (screen.orientation && screen.orientation.lock) await screen.orientation.lock('landscape'); } catch(e){}
      syncPortrait();
    }
    function exitFill(){
      document.body.classList.remove('fill','portrait'); fsbtn.textContent='⛶'; fsbtn.title='Fill screen';
      try { if (screen.orientation && screen.orientation.unlock) screen.orientation.unlock(); } catch(e){}
      try { if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen(); } catch(e){}
    }
    function toggle(){ document.body.classList.contains('fill') ? exitFill() : enterFill(); }
    fsbtn.onclick = toggle;
    if (felt) felt.addEventListener('dblclick', toggle);
    document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement && document.body.classList.contains('fill')) exitFill(); });
    window.addEventListener('orientationchange', syncPortrait);
    window.addEventListener('resize', syncPortrait);
  })();

  if (!CanvasRenderingContext2D.prototype.roundRect){
    CanvasRenderingContext2D.prototype.roundRect = function(x,y,w,h,r){ this.beginPath(); this.moveTo(x+r,y); this.arcTo(x+w,y,x+w,y+h,r); this.arcTo(x+w,y+h,x,y+h,r); this.arcTo(x,y+h,x,y,r); this.arcTo(x,y,x+w,y,r); this.closePath(); return this; };
  }
</script>
</body>
</html>
