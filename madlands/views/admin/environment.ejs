<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/madlands.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin">
  <header class="topbar">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MADLANDS</span>
      <span class="brand-sub">builder · environment</span>
    </div>
    <div class="hud">
      <a class="chip btn" href="/admin">‹ builders</a>
      <a class="chip btn" href="/">▸ map</a>
    </div>
  </header>

  <main class="admin-wrap two-col">
    <section class="form-col">
      <h2>Environment</h2>
      <p class="muted">Type what you want; the environment agent fills the rest in-world and emits a structured artifact.</p>

      <label>Name <input id="f-name" placeholder="Ashfjord Drift" /></label>
      <label>Scale tier
        <select id="f-tier">
          <option value="space">space</option>
          <option value="body">body</option>
          <option value="zone" selected>zone</option>
          <option value="interior">interior</option>
        </select>
      </label>
      <label>Hex key (optional) <input id="f-hex" placeholder="e.g. 2,-1" /></label>
      <label>Mood <input id="f-mood" placeholder="frozen, reverent, low funk-dirge" /></label>
      <label>Biome <input id="f-biome" placeholder="ash-fjord under a ringed gas giant" /></label>
      <label>Notes <textarea id="f-notes" rows="3" placeholder="runed longship wrecks, neon aurora, basalt hexes"></textarea></label>

      <button id="run" class="run-btn">Run environment agent ▸</button>
      <div id="status" class="status"></div>
    </section>

    <section class="out-col">
      <h2>Agent output</h2>
      <pre id="out" class="out">—</pre>
      <div id="swatch" class="swatch"></div>
    </section>
  </main>

  <script src="/js/admin/environment.js"></script>
</body>
</html>
