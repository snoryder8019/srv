<%- include('../partials/header') %>

<main class="td-builder td-story-builder">
  <aside class="td-form" id="td-story-panel">
    <h2>Story Arc Builder</h2>
    <p class="muted">Author a narrative arc for a map: cast NPC characters with SD-generated headset portraits, then place dialogue beats on the run timeline.</p>

    <section class="story-sec">
      <h3>Arc</h3>
      <label>Title <input id="st-title" placeholder="The Last Stand at the Core"></label>
      <label>Slug <input id="st-slug" pattern="[a-z0-9-]+" placeholder="last-stand-core"></label>
      <label>Map
        <select id="st-map"><option value="">— pick a map —</option></select>
      </label>
      <label>Synopsis <textarea id="st-synopsis" rows="2" placeholder="What's the story?"></textarea></label>
    </section>

    <section class="story-sec">
      <div class="sec-head"><h3>Characters</h3><button type="button" id="st-add-char" class="btn small">+ Character</button></div>
      <div id="st-chars"></div>
    </section>

    <section class="story-sec">
      <div class="sec-head"><h3>Beats</h3><button type="button" id="st-add-beat" class="btn small">+ Beat</button></div>
      <div id="st-beats"></div>
    </section>

    <div class="story-actions">
      <select id="st-existing"><option value="">— new arc —</option></select>
      <button type="button" id="st-load" class="btn">Load</button>
      <button type="button" id="st-save" class="btn primary">Save Draft</button>
      <button type="button" id="st-submit" class="btn">Submit</button>
    </div>
    <div id="st-status" class="muted"></div>
  </aside>

  <section class="story-preview" id="st-preview">
    <h3>Preview</h3>
    <p class="muted">Beat timeline preview. The narrative modal looks like this in-game.</p>
    <div id="st-timeline" class="timeline"></div>
  </section>
</main>

<script type="module" src="/js/builder/story-builder.js"></script>
<%- include('../partials/footer') %>
