# Backup files
*.bak
*.bak.*

# Pre-update backup snapshots (full Proton/UE5 trees, ~2600 files each)
/games/backups/

# WindrosePlus runtime data — flaps every poll cycle
/games/dedicatedServers/windrose/windrose_plus_data/

# WindrosePlus plugin/server bundle — large download, not tracked
/games/dedicatedServers/windrose/windrose_plus/

# SteamCMD/Steam client runtime — logs, configs, registry, dumps
/games/*/Steam/
/games/*/.config/unity3d/

# Top-level monitor log (rotates constantly)
/monitor-services.log

# Deprecated projects — archived code, not for tracking
/depricated/

# coDevs is its own repo with shared root+mcserver ownership; do not track from /srv
/coDevs/

# Blender — bundled install (large binary tool) + autosave/backup files
/games/_tools/blender-*/
*.blend1
*.blend2
*.blend[0-9]
*.blend@
*.blend.orig
