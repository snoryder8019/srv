# node_modules at ANY depth — services now nest under /games/... (e.g.
# games/arcade/reels, games/matchmaking), so the old shallow-anchored rules
# below no longer catch their node_modules. A bare path matches at every depth.
# (.env at any depth is already covered by the bare `.env` rule below.)
node_modules/

*/node_modules
/*/env
/*/node_modules
/*/.env
/node_modules
.env
madThree/.env
/madladslab/.env
/w2MongoClient/.env

# AI-generated and development markdown files (scattered across repos)
claude.md
CLAUDE.md
claudeTodolist.md
zMDREADME.md
UPDATES.md
STRATEGY-*.md
ideas.md

# Log files
*.log

# Games — steamcmd itself is never tracked
/games/steamcmd/
/games/logs/

# Games — generated data
/games/patch-notes.json

# Games — static assets (images, vendor JS)
/games/public/img/
/games/public/js/socket.io.min.js
/games/public/js/mediasoup-client.min.js

