<% const pkgs = (pitch && pitch.packages) || []; const intro = (pitch && pitch.packagesIntro) || {}; const ala = (pitch && pitch.alaCarte) || {}; %>

<section class="mll-chart-block">
  <% if (intro.headline) { %><h2><%= intro.headline %></h2><% } %>
  <% if (intro.lead) { %><p class="mll-chart-block__lead"><%= intro.lead %></p><% } %>

  <div class="mll-pkg-grid">
    <% pkgs.forEach((p) => { %>
      <div class="mll-pkg mll-pkg--<%= p.color || 'accent' %> <%= p.recommended ? 'is-recommended' : '' %>">
        <% if (p.recommended) { %><div class="mll-pkg__ribbon">Most picked</div><% } %>
        <div class="mll-pkg__head">
          <h3 class="mll-pkg__name"><%= p.name %></h3>
          <p class="mll-pkg__tag"><%= p.tagline %></p>
        </div>
        <div class="mll-pkg__price">
          <div class="mll-pkg__mll">$<%= p.monthly.toLocaleString() %><span>/mo</span></div>
          <% if (p.firmMonthly) { %>
            <div class="mll-pkg__firm">Agency ~$<%= p.firmMonthly.toLocaleString() %>/mo</div>
          <% } %>
          <div class="mll-pkg__hours"><%= p.hoursPerMonth %> hrs/mo</div>
        </div>
        <% if (p.bestFor) { %><p class="mll-pkg__best"><strong>Best for:</strong> <%= p.bestFor %></p><% } %>
        <ul class="mll-pkg__features">
          <% (p.features || []).forEach((f) => { %>
            <li class="mll-pkg__feat is-in"><span class="mll-pkg__bullet">✓</span><%= f.label %></li>
          <% }) %>
          <% (p.notIncluded || []).forEach((n) => { %>
            <li class="mll-pkg__feat is-out"><span class="mll-pkg__bullet">—</span><%= n %></li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  </div>

  <script id="packagesData" type="application/json"><%- JSON.stringify({ packages: pkgs }) %></script>
</section>

<section class="mll-chart-block">
  <h2>What you actually get per month · Chart.js</h2>
  <p class="mll-chart-block__lead">Bars are deliverables-per-month per tier — channels posted, blog posts, shoot days, review responses, ad-spend management. Easy compare at a glance.</p>
  <div class="mll-chart"><canvas id="packagesChart" height="320"></canvas></div>
</section>

<% if (ala.headline) { %>
<section class="mll-chart-block">
  <h2><%= ala.headline %></h2>
  <% if (ala.lead) { %><p class="mll-chart-block__lead"><%= ala.lead %></p><% } %>
  <p class="mll-chart-block__lead"><em>Scope items are below — each one a checkbox. Cart on the left tracks the total.</em></p>
</section>
<% } %>
