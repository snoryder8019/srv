<section class="mll-chart-block">
  <h2>How we'd execute</h2>
  <p class="mll-chart-block__lead">
    Step 1 is me sitting in on your day, not a Gantt chart. We don't write code until we've watched the work.
  </p>
  <div class="mll-exec">
    <% (view.data.execution || []).forEach((p) => { %>
      <div class="mll-exec__step">
        <div class="mll-exec__phase"><%= p.phase %></div>
        <div class="mll-exec__owner"><%= p.owner %></div>
        <p class="mll-exec__what"><%= p.what %></p>
        <div class="mll-exec__deliverable"><strong>Deliverable:</strong> <%= p.deliverable %></div>
      </div>
    <% }) %>
  </div>
</section>

<section class="mll-chart-block">
  <h2>Third-party stack · the bill stays small</h2>
  <p class="mll-chart-block__lead"><%= view.data.thirdParties.philosophy %></p>
  <div class="mll-tp-grid">
    <% (view.data.thirdParties.items || []).forEach((it) => { %>
      <div class="mll-tp-card <%= it.essential ? 'is-essential' : '' %>">
        <div class="mll-tp-card__head">
          <span class="mll-tp-card__name"><%= it.name %></span>
          <span class="mll-pill mll-pill--<%= it.essential ? 'ok' : 'accent' %>"><%= it.essential ? 'Essential' : 'Optional' %></span>
        </div>
        <div class="mll-tp-card__purpose"><%= it.purpose %></div>
        <div class="mll-tp-card__cost"><%= it.cost %></div>
      </div>
    <% }) %>
  </div>
  <div class="mll-tp-out">
    <div class="mll-tp-out__label">Things we explicitly will not bolt on</div>
    <ul>
      <% (view.data.thirdParties.explicitlyOut || []).forEach((x) => { %><li><%= x %></li><% }) %>
    </ul>
  </div>
</section>

<section class="mll-chart-block">
  <h2>Auth tiers · three levels, one user store</h2>
  <p class="mll-chart-block__lead">
    Each user is at a tier. Buyers and partners on Staunch. Most operators on Medium. Outside reviewers and assistants on Magic-link, scoped tight.
  </p>
  <div class="mll-auth-grid">
    <% (view.data.authTiers || []).forEach((t) => { %>
      <div class="mll-auth-tier mll-auth-tier--<%= t.color %>">
        <div class="mll-auth-tier__head">
          <div class="mll-auth-tier__tier"><%= t.tier %></div>
          <div class="mll-auth-tier__for"><%= t.for %></div>
        </div>
        <dl class="mll-auth-tier__facts">
          <dt>Method</dt><dd><%= t.method %></dd>
          <dt>Session</dt><dd><%= t.session %></dd>
          <dt>Audit</dt><dd><%= t.audit %></dd>
        </dl>
        <div class="mll-auth-tier__examples">
          <% (t.examples || []).forEach((e) => { %><span class="mll-tag"><%= e %></span><% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<section class="mll-chart-block">
  <h2>Client consolidation + org hierarchy</h2>
  <p class="mll-chart-block__lead"><%= view.data.hierarchy.pitch %></p>

  <div class="mll-hier">
    <% (view.data.hierarchy.tree || []).forEach((org) => { %>
      <div class="mll-hier__org mll-hier__org--<%= org.type %>">
        <div class="mll-hier__org-name"><%= org.name %></div>
        <ul class="mll-hier__children">
          <% (org.children || []).forEach((c) => { %>
            <li class="mll-hier__role mll-hier__role--<%= c.type %>"><%= c.name %></li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  </div>

  <div class="mll-payoff">
    <div class="mll-payoff__label">Why it pays off</div>
    <ul>
      <% (view.data.hierarchy.payoff || []).forEach((p) => { %><li><%= p %></li><% }) %>
    </ul>
  </div>
</section>
