<section class="mll-chart-block" data-mtg-host>
  <h2>Meetings · Slab consolidation</h2>
  <p class="mll-chart-block__lead">
    Every meeting on a deal — transcribed on MLL infrastructure (no Otter, no Zoom AI Companion), auto-tagged, action-items extracted, shareable per-party. Switch the variant above to see the client's view.
  </p>

  <!-- WORKSPACE -->
  <div class="mll-mtg" data-mtg-view="workspace">
    <div class="mll-mtg__layout">
      <aside class="mll-mtg__list">
        <div class="mll-mtg__list-head">
          <span>All meetings (<span data-mtg-count>0</span>)</span>
          <select data-mtg-deal-filter>
            <option value="">All deals</option>
            <% (view.data.deals || []).forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
          </select>
        </div>
        <ul class="mll-mtg__list-items" data-mtg-items></ul>
      </aside>

      <main class="mll-mtg__detail" data-mtg-detail>
        <div class="mll-mtg__empty">Pick a meeting on the left.</div>
      </main>
    </div>
  </div>

  <!-- CLIENT PORTAL -->
  <div class="mll-mtg" data-mtg-view="portal" hidden>
    <div class="mll-mtg__portal">
      <header class="mll-mtg__portal-head">
        <div>
          <div class="mll-mtg__portal-lbl">Client view of</div>
          <select data-mtg-portal-deal>
            <% (view.data.deals || []).forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
          </select>
        </div>
        <button type="button" class="mll-cta mll-cta--ghost" data-mtg-request>+ Request a meeting</button>
      </header>

      <div class="mll-mtg__portal-cols">
        <section class="mll-mtg__portal-meetings" data-mtg-portal-meetings></section>
        <aside class="mll-mtg__portal-actions" data-mtg-portal-actions></aside>
      </div>
    </div>
  </div>

  <script id="meetingsData" type="application/json"><%- JSON.stringify(view.data || {}) %></script>
</section>
