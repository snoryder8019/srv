<% const m = (pitch && pitch.marketing) || {}; const k = m.kpis || {}; %>

<section class="mll-chart-block">
  <h2><%= k.windowLabel || 'Trailing 90 days' %></h2>
  <p class="mll-chart-block__lead">
    Real-feel seeded data showing what a Forge / Foundry month looks like. KPIs roll up from the channel data below.
  </p>
  <div class="mll-mk-kpis">
    <div class="mll-mk-kpi"><div class="mll-mk-kpi-val"><%= (k.sessions || 0).toLocaleString() %></div><div class="mll-mk-kpi-lbl">Site sessions</div></div>
    <div class="mll-mk-kpi mll-mk-kpi--accent"><div class="mll-mk-kpi-val"><%= (k.gmbCalls || 0).toLocaleString() %></div><div class="mll-mk-kpi-lbl">GMB calls</div></div>
    <div class="mll-mk-kpi mll-mk-kpi--accent"><div class="mll-mk-kpi-val"><%= (k.formFills || 0).toLocaleString() %></div><div class="mll-mk-kpi-lbl">Form fills</div></div>
    <div class="mll-mk-kpi mll-mk-kpi--ok"><div class="mll-mk-kpi-val"><%= (k.quoteCalls || 0).toLocaleString() %></div><div class="mll-mk-kpi-lbl">Quote calls</div></div>
    <div class="mll-mk-kpi mll-mk-kpi--ok"><div class="mll-mk-kpi-val"><%= (k.jobsBooked || 0).toLocaleString() %></div><div class="mll-mk-kpi-lbl">Jobs booked</div></div>
    <div class="mll-mk-kpi mll-mk-kpi--warn"><div class="mll-mk-kpi-val">$<%= (k.revenue || 0).toLocaleString() %></div><div class="mll-mk-kpi-lbl">Revenue attributed</div></div>
  </div>
</section>

<section class="mll-chart-block">
  <h2>Lead funnel · ECharts</h2>
  <p class="mll-chart-block__lead">Visitor → engaged → contact → quote call → quote sent → job booked. The drop-offs are where a month's work earns its keep.</p>
  <div class="mll-chart" id="mkFunnel" style="height:380px"></div>
</section>

<section class="mll-chart-block">
  <h2>Where leads come from · ECharts</h2>
  <p class="mll-chart-block__lead">Sources by sessions and GMB calls. The mix tells you which channels to push next month.</p>
  <div class="mll-chart" id="mkSources" style="height:340px"></div>
</section>

<section class="mll-chart-block">
  <h2>13-week campaign view · ECharts</h2>
  <p class="mll-chart-block__lead">Ad spend, leads in, jobs out. The monthly report opens with exactly this chart.</p>
  <div class="mll-chart" id="mkCampaign" style="height:340px"></div>
</section>

<section class="mll-chart-block">
  <h2>By channel · this period</h2>
  <table class="mll-mk-table">
    <thead><tr><th>Channel</th><th>Posts</th><th>Engagements</th><th>Rating</th></tr></thead>
    <tbody>
      <% (m.byChannel || []).forEach((row) => { %>
        <tr>
          <td><%= row.channel %></td>
          <td><%= row.posts %></td>
          <td><%= row.engagements.toLocaleString() %></td>
          <td><%= row.rating != null ? (row.rating.toFixed(1) + ' ★') : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<script id="marketingData" type="application/json"><%- JSON.stringify(m) %></script>
