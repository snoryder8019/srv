<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/share.css" />
</head>
<body class="mll-page">
  <%- include('../partials/header') %>
  <main class="mll-share-gate">
    <div class="mll-share-gate__card">
      <div class="mll-share-gate__icon" aria-hidden="true">🔒</div>
      <h1>This pitch link has expired or is private</h1>
      <p>
        Share links for Left Field pitches are public for <strong>48 hours</strong>.
        The link you followed has either expired, been revoked, or this pitch is
        still private.
      </p>
      <p>
        Ask whoever sent it for a <strong>fresh share link</strong>, or get in
        touch with us directly and we'll sort it out.
      </p>
      <div class="mll-share-gate__actions">
        <button type="button" class="mll-cta" data-contact-open>Contact MadLadsLab</button>
        <a class="mll-share-gate__home" href="/">← Back to <%= brand.name %></a>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
