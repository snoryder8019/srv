<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/proposal.css" />
  <link rel="preload" as="image" href="/api/sd/proposal/<%= currentDesign.id %>" />
</head>
<body class="mll-pr-page mll-pr--<%= currentDesign.id %>" data-design="<%= currentDesign.id %>">
  <%- include('../partials/header') %>

  <nav class="mll-pr-rail" aria-label="Proposal sections">
    <a class="mll-pr-rail__crumb" href="/c/<%= pitch.slug %>/overview">←</a>
    <ol class="mll-pr-rail__dots">
      <li><a href="#slide-hero" data-pr-dot="hero"><span>01</span><em>Open</em></a></li>
      <li><a href="#slide-why" data-pr-dot="why"><span>02</span><em>Why</em></a></li>
      <li><a href="#slide-approach" data-pr-dot="approach"><span>03</span><em>Approach</em></a></li>
      <li><a href="#slide-tiers" data-pr-dot="tiers"><span>04</span><em>Tiers</em></a></li>
      <li><a href="#slide-timeline" data-pr-dot="timeline"><span>05</span><em>Rollout</em></a></li>
      <li><a href="#slide-faq" data-pr-dot="faq"><span>06</span><em>FAQ</em></a></li>
      <li><a href="#slide-close" data-pr-dot="close"><span>07</span><em>Close</em></a></li>
    </ol>
    <form class="mll-pr-design" method="get" action="">
      <span class="mll-pr-template-pill" title="Each look is a complete layout you'd own under the engagement">
        <span class="mll-pr-template-pill__dot" aria-hidden="true"></span>
        Template · 5 layouts
      </span>
      <label class="mll-pr-design__lbl">Look</label>
      <select name="design" data-design-switch>
        <% pitch.proposal.designs.forEach((d) => { %>
          <option value="<%= d.id %>" <%= d.id === currentDesign.id ? 'selected' : '' %>><%= d.label %></option>
        <% }) %>
      </select>
      <small class="mll-pr-design__note">Yours to keep if we engage.</small>
      <noscript><button type="submit">Apply</button></noscript>
    </form>
  </nav>

  <main class="mll-pr-deck" id="mll-pr-deck">

    <!-- 01 · Hero -->
    <section class="mll-pr-slide mll-pr-slide--hero" id="slide-hero">
      <div class="mll-pr-hero-bg" style="background-image:url('/api/sd/proposal/<%= currentDesign.id %>')"></div>
      <div class="mll-pr-hero-bg__veil"></div>
      <div class="mll-pr-hero-grid">
        <div class="mll-pr-hero-grid__col mll-pr-hero-grid__col--main">
          <span class="mll-pr-eyebrow" data-reveal><%= currentDesign.label %> · <%= currentDesign.tag %></span>
          <h1 class="mll-pr-hero-title" data-reveal data-reveal-stagger="1">
            A diligence platform that <em>fits the way <%= pitch.client %> already works.</em>
          </h1>
          <p class="mll-pr-hero-lead" data-reveal data-reveal-stagger="2"><%= pitch.proposal.tagline %></p>
          <div class="mll-pr-hero-cta" data-reveal data-reveal-stagger="3">
            <a class="mll-pr-cta" href="/c/<%= pitch.slug %>/proposal/app">Open the live demo<span>→</span></a>
            <a class="mll-pr-cta mll-pr-cta--ghost" href="#slide-tiers">Skip to pricing<span>↓</span></a>
          </div>
        </div>
        <aside class="mll-pr-hero-grid__col mll-pr-hero-grid__col--meta" data-reveal data-reveal-stagger="4">
          <dl>
            <dt>Prepared for</dt><dd><%= pitch.client %></dd>
            <dt>Date</dt><dd><%= pitch.date %></dd>
            <dt>From</dt><dd>Scott · MadLadsLab</dd>
            <dt>Engagement</dt><dd>45 days · 3 tiers</dd>
            <dt>Doc kind</dt><dd>Design template · v1</dd>
          </dl>
          <p class="mll-pr-template-note">
            This page is itself a layout template. Switch the look in the side rail to compare —
            the one Upland picks becomes the marketing site we ship.
          </p>
        </aside>
      </div>
      <div class="mll-pr-scroll-hint" aria-hidden="true"><span></span></div>
    </section>

    <!-- 02 · Why -->
    <section class="mll-pr-slide mll-pr-slide--why" id="slide-why">
      <div class="mll-pr-slide__inner">
        <span class="mll-pr-eyebrow" data-reveal>02 · The problem</span>
        <h2 data-reveal data-reveal-stagger="1">Excel is fast. It's also why the audit story dies.</h2>
        <p class="mll-pr-lede" data-reveal data-reveal-stagger="2"><%= pitch.problemStatement %></p>
        <div class="mll-pr-stat-grid">
          <div class="mll-pr-stat" data-reveal data-reveal-stagger="1"><strong>5</strong><span>workbooks per deal, average</span></div>
          <div class="mll-pr-stat" data-reveal data-reveal-stagger="2"><strong>11 days</strong><span>average verification cycle today</span></div>
          <div class="mll-pr-stat" data-reveal data-reveal-stagger="3"><strong>0</strong><span>cell-level audit trail in Excel</span></div>
          <div class="mll-pr-stat" data-reveal data-reveal-stagger="4"><strong>∞</strong><span>versions in flight across counsel + buyer</span></div>
        </div>
      </div>
    </section>

    <!-- 03 · Approach -->
    <section class="mll-pr-slide mll-pr-slide--approach" id="slide-approach">
      <div class="mll-pr-slide__inner">
        <span class="mll-pr-eyebrow" data-reveal>03 · How we'd build it</span>
        <h2 data-reveal data-reveal-stagger="1">Four pillars. Each one ships an artifact you can audit.</h2>
        <div class="mll-pr-pillars">
          <% pitch.approach.forEach((a, i) => { %>
            <article class="mll-pr-pillar" data-reveal data-reveal-stagger="<%= i + 1 %>">
              <span class="mll-pr-pillar__num"><%= String(i + 1).padStart(2, '0') %></span>
              <h3><%= a.title %></h3>
              <p><%= a.detail %></p>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- 04 · Tiers -->
    <section class="mll-pr-slide mll-pr-slide--tiers" id="slide-tiers">
      <div class="mll-pr-slide__inner">
        <span class="mll-pr-eyebrow" data-reveal>04 · Engagement options</span>
        <h2 data-reveal data-reveal-stagger="1">Three retainer tiers. Two alacarte options. Mix freely.</h2>
        <p class="mll-pr-lede" data-reveal data-reveal-stagger="2"><%= pitch.proposal.tagline %></p>
        <div class="mll-pr-tier-grid">
          <% pitch.proposal.tiers.forEach((t, i) => { %>
            <article class="mll-pr-tier mll-pr-tier--<%= t.id %>" data-reveal data-reveal-stagger="<%= i + 1 %>">
              <% if (t.id === 'delivery') { %><span class="mll-pr-tier__flag">Crunch-time</span><% } %>
              <% if (t.id === 'diligence') { %><span class="mll-pr-tier__flag mll-pr-tier__flag--soft">Most popular</span><% } %>
              <header>
                <h3><%= t.name %></h3>
                <div class="mll-pr-tier__price">
                  <span class="mll-pr-tier__dollar">$</span><span class="mll-pr-tier__num"><%= t.price.toLocaleString() %></span><span class="mll-pr-tier__cadence"><%= t.cadence %></span>
                </div>
                <p class="mll-pr-tier__lead"><%= t.lead %></p>
              </header>
              <ul>
                <% t.includes.forEach((i) => { %><li><%= i %></li><% }) %>
              </ul>
              <footer><strong>Best for:</strong> <%= t.best %></footer>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- 05 · Timeline -->
    <section class="mll-pr-slide mll-pr-slide--timeline" id="slide-timeline">
      <div class="mll-pr-slide__inner">
        <span class="mll-pr-eyebrow" data-reveal>05 · 45-day rollout</span>
        <h2 data-reveal data-reveal-stagger="1">From signature to production in six weeks.</h2>
        <ol class="mll-pr-timeline">
          <% pitch.proposal.timeline.forEach((p, i) => { %>
            <li data-reveal data-reveal-stagger="<%= i + 1 %>">
              <span class="mll-pr-timeline__dot"></span>
              <span class="mll-pr-timeline__phase"><%= p.phase %></span>
              <span class="mll-pr-timeline__what"><%= p.what %></span>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <!-- 06 · FAQ -->
    <section class="mll-pr-slide mll-pr-slide--faq" id="slide-faq">
      <div class="mll-pr-slide__inner">
        <span class="mll-pr-eyebrow" data-reveal>06 · FAQ</span>
        <h2 data-reveal data-reveal-stagger="1">The questions buyers ask before signing.</h2>
        <dl class="mll-pr-faq">
          <% pitch.proposal.faq.forEach((f, i) => { %>
            <div class="mll-pr-faq__item" data-reveal data-reveal-stagger="<%= i + 1 %>">
              <dt><%= f.q %></dt>
              <dd><%= f.a %></dd>
            </div>
          <% }) %>
        </dl>
      </div>
    </section>

    <!-- 07 · Close -->
    <section class="mll-pr-slide mll-pr-slide--close" id="slide-close">
      <div class="mll-pr-hero-bg mll-pr-hero-bg--close" style="background-image:url('/api/sd/proposal/<%= currentDesign.id %>')"></div>
      <div class="mll-pr-hero-bg__veil mll-pr-hero-bg__veil--strong"></div>
      <div class="mll-pr-slide__inner mll-pr-slide__inner--center">
        <span class="mll-pr-eyebrow" data-reveal>07 · Next step</span>
        <h2 data-reveal data-reveal-stagger="1">Roadmap consult, then 45 days to production.</h2>
        <p class="mll-pr-lede" data-reveal data-reveal-stagger="2">Take the live demo for a spin. We'll align on scope by end of week.</p>
        <div class="mll-pr-hero-cta" data-reveal data-reveal-stagger="3">
          <a class="mll-pr-cta" href="/c/<%= pitch.slug %>/proposal/app">Open the live demo<span>→</span></a>
          <a class="mll-pr-cta mll-pr-cta--ghost" href="mailto:scott@madladslab.com?subject=Upland%20engagement">Email Scott<span>✉</span></a>
        </div>
      </div>
    </section>
  </main>

  <div class="mll-pr-veil" data-pr-veil aria-hidden="true"></div>

  <script defer src="/js/proposal-draft.js"></script>
</body>
</html>
