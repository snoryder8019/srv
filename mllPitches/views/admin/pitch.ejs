<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="mll-page">
  <%- include('../partials/header') %>
  <main class="mll-admin">
    <header class="mll-admin__head">
      <div>
        <a href="/admin">← Admin</a>
        <h1><%= pitch.client %></h1>
        <p><%= pitch.industry %> · <%= pitch.date %> · <a href="/c/<%= pitch.slug %>">View public pitch ↗</a></p>
      </div>
      <a class="mll-cta mll-cta--ghost" href="/auth/logout">Sign out</a>
    </header>

    <section class="mll-chart-block">
      <h2>File</h2>
      <p>
        <code>data/clients/<%= pitch.slug %>.json</code> · <%= (fileSize / 1024).toFixed(1) %> KB ·
        last modified <%= fileModified.toLocaleString() %>
      </p>
      <p>Edit on disk and changes pick up immediately (dev cache). For production, restart tmux <code>mllpitches</code>.</p>
    </section>

    <section class="mll-chart-block">
      <h2>Views (<%= (pitch.views || []).length %>)</h2>
      <ul>
        <% (pitch.views || []).forEach((v) => { %>
          <li>
            <strong><%= v.title %></strong> — <code>/c/<%= pitch.slug %>/<%= v.slug %></code>
            · <%= (v.scope || []).length %> scope items
            · <%= (v.scope || []).reduce((a, s) => a + (s.hours || 0), 0) %> hrs
            · $<%= (v.scope || []).reduce((a, s) => a + (s.cost || 0), 0).toLocaleString() %>
          </li>
        <% }) %>
      </ul>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
