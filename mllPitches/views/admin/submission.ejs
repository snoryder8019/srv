<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="mll-page">
  <%- include('../partials/header') %>
  <main class="mll-admin">
    <header class="mll-admin__head">
      <div>
        <a href="/admin">← Admin</a>
        <h1>Submission <%= submission.id %></h1>
        <p><%= submission.client %> · <%= new Date(submission.submittedAt).toLocaleString() %></p>
      </div>
      <a class="mll-cta mll-cta--ghost" href="/auth/logout">Sign out</a>
    </header>

    <section class="mll-chart-block">
      <h2>Contact</h2>
      <p>
        <strong><%= submission.contact?.name || 'anon' %></strong>
        <% if (submission.contact?.email) { %> · <a href="mailto:<%= submission.contact.email %>"><%= submission.contact.email %></a><% } %>
      </p>
      <% if (submission.notes) { %><blockquote><%= submission.notes %></blockquote><% } %>
    </section>

    <section class="mll-chart-block">
      <h2>Totals</h2>
      <ul>
        <li><strong><%= submission.totals?.hours %></strong> hours</li>
        <% if (submission.totals?.firmCost) { %><li>Firm: <s>$<%= submission.totals.firmCost.toLocaleString() %></s></li><% } %>
        <li>MLL: <strong>$<%= (submission.totals?.cost || 0).toLocaleString() %></strong></li>
        <% if (submission.totals?.savings) { %><li>Savings: <strong>$<%= submission.totals.savings.toLocaleString() %></strong></li><% } %>
      </ul>
    </section>

    <section class="mll-chart-block">
      <h2>Items (<%= submission.items?.length || 0 %>)</h2>
      <ul>
        <% (submission.items || []).forEach((it) => { %>
          <li>
            <strong><%= it.title %></strong> · <%= it.viewTitle %> ·
            <%= it.hours %> hrs · $<%= it.cost.toLocaleString() %>
          </li>
        <% }) %>
      </ul>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
