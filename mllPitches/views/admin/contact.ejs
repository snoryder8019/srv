<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="mll-page">
  <%- include('../partials/header') %>
  <main class="mll-admin">
    <header class="mll-admin__head">
      <div>
        <a href="/admin">← Admin</a>
        <h1>Contact · <%= contact.name %></h1>
        <p><%= new Date(contact.submittedAt).toLocaleString() %></p>
      </div>
      <div>
        <a class="mll-cta" href="mailto:<%= contact.email %>?subject=Re:%20Left%20Field">Reply by email</a>
      </div>
    </header>

    <section class="mll-chart-block">
      <h2>From</h2>
      <ul>
        <li><strong>Name:</strong> <%= contact.name %></li>
        <li><strong>Email:</strong> <a href="mailto:<%= contact.email %>"><%= contact.email %></a></li>
        <% if (contact.company) { %><li><strong>Company:</strong> <%= contact.company %></li><% } %>
        <% if (contact.topic) { %><li><strong>Topic:</strong> <%= contact.topic %></li><% } %>
      </ul>
    </section>

    <section class="mll-chart-block">
      <h2>Message</h2>
      <blockquote class="mll-contact__quote"><%= contact.message %></blockquote>
    </section>

    <section class="mll-chart-block">
      <h2>Trace</h2>
      <ul>
        <li><strong>ID:</strong> <code><%= contact.id %></code></li>
        <% if (contact.pageHint) { %><li><strong>Page:</strong> <code><%= contact.pageHint %></code></li><% } %>
        <% if (contact.ip) { %><li><strong>IP:</strong> <code><%= contact.ip %></code></li><% } %>
        <% if (contact.userAgent) { %><li><strong>User-agent:</strong> <code><%= contact.userAgent %></code></li><% } %>
      </ul>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
