<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="mll-page mll-page--home">
  <%- include('partials/header') %>

  <main class="mll-home">
    <section class="mll-hero">
      <h1>Left Field.</h1>
      <p class="mll-hero__sub">Pitches that don't sound like pitches.</p>
      <p class="mll-hero__lead">
        Each pitch below is a working web app — real data, real charts, real scope you can check off.
        Pick what you want and we'll quote you on the same screen.
        Built and delivered by <a href="<%= brand.site %>"><%= brand.parent %></a>.
      </p>
    </section>

    <section class="mll-grid">
      <% pitches.forEach((p) => { %>
        <a class="mll-card" href="/c/<%= p.slug %>">
          <div class="mll-card__meta"><%= p.industry %> · <%= p.date %></div>
          <h2 class="mll-card__title"><%= p.client %></h2>
          <p class="mll-card__summary"><%= p.summary %></p>
          <span class="mll-card__cta">Open pitch →</span>
        </a>
      <% }) %>
      <% if (!pitches.length) { %>
        <div class="mll-empty">No pitches loaded yet. Drop a JSON into <code>data/clients/</code>.</div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
