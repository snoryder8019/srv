<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/landing.css" />
</head>
<body class="mll-page mll-page--home lf-landing">
  <%- include('partials/header') %>

  <main>
    <!-- HERO -->
    <section class="lf-hero" id="top">
      <div class="lf-wrap lf-hero__inner">
        <span class="lf-eyebrow">★ <b><%= brand.name %></b> · by <%= brand.parent %></span>
        <h1><%= brand.name %></h1>
        <p class="lf-hero__tag">Pitches that don&rsquo;t sound like pitches.</p>
        <p class="lf-hero__lead">
          Build a <b>working, interactive pitch</b> &mdash; real charts, real scope your client
          can check off &mdash; and share it with a link or QR.
          <b>Free for MadLadsLab members</b>, up to 3 pitches.
        </p>
        <div class="lf-cta-row">
          <a class="lf-btn lf-btn--primary" href="/auth/login">Sign in with MadLadsLab &rarr;</a>
          <a class="lf-btn lf-btn--ghost" href="#showcase">See an example</a>
        </div>
        <p class="lf-hero__fineprint">No credit card. Sign in with your MadLadsLab account and start building.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="lf-section lf-how" id="how">
      <div class="lf-wrap">
        <h2 class="lf-h2">How it works</h2>
        <p class="lf-sub">From sign-in to a client-ready, interactive pitch in three steps.</p>
        <div class="lf-steps">
          <div class="lf-step">
            <span class="lf-step__n">1</span>
            <h3>Sign in with MadLadsLab</h3>
            <p>Use your existing MadLadsLab account &mdash; one click, no new password, no setup.</p>
          </div>
          <div class="lf-step">
            <span class="lf-step__n">2</span>
            <h3>Build from reusable modules</h3>
            <p>Assemble charts, data rooms, and workflows from drop-in modules. Every pitch is a real, interactive web app.</p>
          </div>
          <div class="lf-step">
            <span class="lf-step__n">3</span>
            <h3>Share a link or QR</h3>
            <p>Send a 48-hour link or QR code straight to your client. They explore the pitch and check off scope live.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SHOWCASE -->
    <section class="lf-section lf-showcase" id="showcase">
      <div class="lf-wrap">
        <div class="lf-showcase__head">
          <div>
            <h2 class="lf-h2">See it in action</h2>
            <p class="lf-sub">Real pitches built on Left Field &mdash; open one and click around.</p>
          </div>
          <a class="lf-btn lf-btn--primary" href="/auth/login">Build your own &rarr;</a>
        </div>

        <div class="lf-grid">
          <% pitches.forEach((p) => { %>
            <a class="lf-pcard" href="/c/<%= p.slug %>">
              <div class="lf-pcard__meta">
                <span><%= p.industry %></span>
                <span class="lf-pcard__tag">Live example</span>
              </div>
              <h3 class="lf-pcard__title"><%= p.client %></h3>
              <p class="lf-pcard__summary"><%= p.summary %></p>
              <span class="lf-pcard__cta">Open pitch &rarr;</span>
            </a>
          <% }) %>
          <% if (!pitches.length) { %>
            <div class="lf-empty">Showcase pitches are loading. Check back shortly.</div>
          <% } %>
        </div>

        <!-- PRIVATE / CONTACT -->
        <div class="lf-private">
          <div>
            <h3>Need an NDA, custom build, or a live meeting?</h3>
            <p>Some work calls for a private engagement &mdash; bespoke modules, confidential data rooms, or a hands-on build with the MadLadsLab team. Let&rsquo;s talk.</p>
          </div>
          <a class="lf-private__btn" href="mailto:<%= brand.contactEmail %>">Contact MadLadsLab &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
