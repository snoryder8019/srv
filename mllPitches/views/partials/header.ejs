<header class="mll-header">
  <a class="mll-logo" href="/">
    <span class="mll-logo__mark" aria-hidden="true">◣◤</span>
    <span class="mll-logo__text">
      <span class="mll-logo__name"><%= brand.name %></span>
      <% if (brand.parent) { %><span class="mll-logo__parent">by <%= brand.parent %></span><% } %>
    </span>
  </a>
  <nav class="mll-pillars" aria-label="Brand pillars">
    <% brand.pillars.forEach((p, i) => { %>
      <span class="mll-pillar" data-i="<%= i %>"><%= p %></span>
    <% }) %>
  </nav>
  <div class="mll-header__right">
    <% if (locals.user && user.email) { %>
      <a class="mll-admin-chip" href="/admin" title="Open admin">
        <span class="mll-admin-chip__dot" aria-hidden="true">●</span>
        <span class="mll-admin-chip__name"><%= user.name || user.email.split('@')[0] %></span>
        <span class="mll-admin-chip__lbl">Admin</span>
      </a>
      <a class="mll-admin-chip mll-admin-chip--out" href="/auth/logout" title="Sign out">Sign out</a>
    <% } else { %>
      <a class="mll-admin-chip mll-admin-chip--ghost" href="/admin" title="Admin (Google sign-in)">Admin</a>
    <% } %>
    <button type="button" class="mll-cta" data-contact-open>Talk to us</button>
  </div>
</header>
