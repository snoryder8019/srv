<header class="mll-header">
  <a class="mll-logo" href="/">
    <span class="mll-logo__mark" aria-hidden="true">◣◤</span>
    <span class="mll-logo__text">
      <span class="mll-logo__name"><%= brand.name %></span>
      <% if (brand.parent) { %><span class="mll-logo__parent">by <%= brand.parent %></span><% } %>
    </span>
  </a>
  <nav class="mll-pillars" aria-label="Brand pillars">
    <% brand.pillars.forEach((p, i) => { %>
      <span class="mll-pillar" data-i="<%= i %>"><%= p %></span>
    <% }) %>
  </nav>
  <div class="mll-header__right">
    <% if (locals.user && user.email) { %>
      <a class="mll-admin-chip" href="/admin" title="Open admin">
        <span class="mll-admin-chip__dot" aria-hidden="true">●</span>
        <span class="mll-admin-chip__name"><%= user.name || user.email.split('@')[0] %></span>
        <span class="mll-admin-chip__lbl">Admin</span>
      </a>
    <% } %>
    <% if (locals.mllUser) { %>
      <a class="mll-navlink" href="/dashboard" title="Your dashboard">Dashboard</a>
      <a class="mll-navlink mll-navlink--accent" href="/editor/new" title="Start a new pitch">+ New pitch</a>
      <% var mllName = mllUser.name || (mllUser.email ? mllUser.email.split('@')[0] : 'Member'); %>
      <a class="mll-user-chip" href="/dashboard" title="<%= mllUser.email || mllName %>">
        <span class="mll-user-chip__dot" aria-hidden="true">●</span>
        <span class="mll-user-chip__name"><%= mllName %></span>
      </a>
      <a class="mll-navlink mll-navlink--muted" href="/auth/signout" title="Sign out">Sign out</a>
    <% } else { %>
      <a class="mll-signin" href="/auth/login">Sign in with MadLadsLab</a>
    <% } %>
    <button type="button" class="mll-cta" data-contact-open>Talk to us</button>
  </div>
  <style>
    .mll-header__right{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}
    .mll-navlink{font:600 .82rem/1 system-ui,sans-serif;color:#c7d0e6;text-decoration:none;
      padding:.5rem .7rem;border-radius:.55rem;border:1px solid transparent;white-space:nowrap;transition:.15s}
    .mll-navlink:hover{color:#fff;background:rgba(255,255,255,.06)}
    .mll-navlink--accent{color:#0b1020;background:linear-gradient(180deg,#6ee7b7,#34d399);border-color:#34d399}
    .mll-navlink--accent:hover{filter:brightness(1.07);background:linear-gradient(180deg,#7af0c2,#3fdca3)}
    .mll-navlink--muted{color:#8d97b0}
    .mll-navlink--muted:hover{color:#fff;background:rgba(255,255,255,.05)}
    .mll-user-chip{display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;
      padding:.42rem .65rem;border-radius:999px;border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.04);font:600 .8rem/1 system-ui,sans-serif;color:#e7ecf7;white-space:nowrap}
    .mll-user-chip:hover{border-color:rgba(110,231,183,.5)}
    .mll-user-chip__dot{color:#34d399;font-size:.6rem}
    .mll-signin{display:inline-flex;align-items:center;text-decoration:none;white-space:nowrap;
      font:700 .82rem/1 system-ui,sans-serif;color:#0b1020;padding:.6rem .95rem;border-radius:.6rem;
      background:linear-gradient(180deg,#8ab4ff,#5b8bff);border:1px solid #5b8bff;box-shadow:0 6px 18px rgba(91,139,255,.28)}
    .mll-signin:hover{filter:brightness(1.06)}
    @media (max-width:640px){.mll-navlink,.mll-signin,.mll-user-chip{padding-top:.4rem;padding-bottom:.4rem}}
  </style>
</header>
