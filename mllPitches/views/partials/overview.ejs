<section class="mll-overview">
  <header class="mll-view__head">
    <h1><%= pitch.client %> — Pitch Overview</h1>
    <p class="mll-view__sub"><%= pitch.summary %></p>
  </header>

  <div class="mll-overview__pillars">
    <% brand.pillars.forEach((p) => { %>
      <div class="mll-pillar-card"><%= p %></div>
    <% }) %>
  </div>

  <% if (pitch.app || pitch.proposal) { %>
    <div class="mll-overview__hero-links">
      <% if (pitch.app) { %>
        <a class="mll-overview__hero-link mll-overview__hero-link--app" href="/c/<%= pitch.slug %>/proposal/app">
          <span class="mll-overview__hero-tag">Live demo</span>
          <strong>Try the deal cockpit →</strong>
          <span class="mll-overview__hero-sub">Four quadrants, Socket.IO live — role switcher, permission matrix, workflow, email collector.</span>
        </a>
      <% } %>
      <% if (pitch.proposal) { %>
        <a class="mll-overview__hero-link mll-overview__hero-link--proposal" href="/c/<%= pitch.slug %>/proposal/draft">
          <span class="mll-overview__hero-tag">Proposal draft</span>
          <strong>Read the proposal →</strong>
          <span class="mll-overview__hero-sub">5 Rocky-Mountain looks via dropdown. Engagement / Diligence / Delivery tiers + alacarte.</span>
        </a>
      <% } %>
    </div>
  <% } %>

  <h2>What's inside this pitch</h2>
  <div class="mll-overview__grid">
    <% pitch.views.forEach((v) => { %>
      <a class="mll-overview__view" href="/c/<%= pitch.slug %>/<%= v.slug %>">
        <div class="mll-overview__view-title"><%= v.title %></div>
        <p><%= v.subtitle || '' %></p>
        <span class="mll-overview__view-cta">Open →</span>
      </a>
    <% }) %>
  </div>

  <% if (pitch.problemStatement) { %>
    <h2>Problem we're solving</h2>
    <p class="mll-overview__body"><%= pitch.problemStatement %></p>
  <% } %>

  <% if (pitch.approach && pitch.approach.length) { %>
    <h2>Our approach</h2>
    <ol class="mll-overview__approach">
      <% pitch.approach.forEach((a) => { %><li><strong><%= a.title %>:</strong> <%= a.detail %></li><% }) %>
    </ol>
  <% } %>

  <% if (pitch.additionalServices) { %>
    <section class="mll-services">
      <h2><%= pitch.additionalServices.title %></h2>
      <p class="mll-services__intro"><%= pitch.additionalServices.intro %></p>

      <div class="mll-services__grid">
        <% pitch.additionalServices.items.forEach((s) => {
          const firmMid = Math.round((s.firmPrice.low + s.firmPrice.high) / 2);
          const ratio = (firmMid / s.mllPrice).toFixed(1);
        %>
          <div class="mll-service">
            <div class="mll-service__head">
              <h3 class="mll-service__name"><%= s.name %></h3>
              <span class="mll-pill mll-pill--accent"><%= ratio %>× cheaper</span>
            </div>
            <p class="mll-service__tag"><%= s.tagline %></p>
            <ul class="mll-service__what">
              <% s.what.forEach((w) => { %><li><%= w %></li><% }) %>
            </ul>
            <div class="mll-service__pricing">
              <div class="mll-service__row mll-service__row--firm">
                <span class="mll-service__label">Typical firm</span>
                <span class="mll-service__price">$<%= s.firmPrice.low.toLocaleString() %>–$<%= s.firmPrice.high.toLocaleString() %></span>
                <span class="mll-service__note"><%= s.firmPrice.note %></span>
              </div>
              <div class="mll-service__row mll-service__row--mll">
                <span class="mll-service__label">MadLadsLab</span>
                <span class="mll-service__price">$<%= s.mllPrice.toLocaleString() %></span>
                <span class="mll-service__note">flat, no monthly</span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <% if (pitch.savings) { %>
        <p class="mll-services__footnote"><strong><%= pitch.savings.label %>:</strong> <%= pitch.savings.note %></p>
      <% } %>
    </section>
  <% } %>
</section>
