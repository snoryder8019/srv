<% if (view.scope && view.scope.length) { %>
<section class="mll-scope" aria-label="Scope items">
  <h2>Add to scope</h2>
  <p class="mll-scope__hint">Check items to build your estimate. Totals update live in the cart.</p>
  <ul class="mll-scope__list">
    <% view.scope.forEach((item) => { %>
      <li class="mll-scope__item">
        <label>
          <input type="checkbox" class="mll-scope__check"
            data-scope-id="<%= item.id %>"
            data-view-slug="<%= view.slug %>"
            data-view-title="<%= view.title %>"
            data-title="<%= item.title %>"
            data-hours="<%= item.hours %>"
            data-cost="<%= item.cost %>"
            data-firm-cost="<%= item.firmCost || 0 %>" />
          <span class="mll-scope__title"><%= item.title %></span>
        </label>
        <p class="mll-scope__desc"><%= item.description %></p>
        <div class="mll-scope__meta">
          <span class="mll-scope__hours"><%= item.hours %> hrs</span>
          <% if (item.firmCost) { %>
            <span class="mll-scope__firm">Firm <s>$<%= item.firmCost.toLocaleString() %></s></span>
          <% } %>
          <span class="mll-scope__mll">MLL $<%= item.cost.toLocaleString() %></span>
          <% if (item.firmCost) { %>
            <span class="mll-scope__save">save $<%= (item.firmCost - item.cost).toLocaleString() %></span>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>
