<div class="mll-drawer" id="cartDrawer" hidden>
  <div class="mll-drawer__panel" role="dialog" aria-label="Scope &amp; estimate">
    <header class="mll-drawer__head">
      <h2>Your scope &amp; estimate</h2>
      <button type="button" class="mll-drawer__close" data-cart-close aria-label="Close">×</button>
    </header>
    <ul class="mll-drawer__items" data-cart-items></ul>
    <div class="mll-drawer__empty" data-cart-empty>Nothing selected yet — check items on any view.</div>
    <div class="mll-drawer__totals">
      <div>Hours: <strong data-cart-hours>0</strong></div>
      <div class="mll-drawer__totals-row"><span>If you hired a firm</span><strong><s>$<span data-cart-firm>0</span></s></strong></div>
      <div class="mll-drawer__totals-row mll-drawer__totals-row--mll"><span>MadLadsLab</span><strong>$<span data-cart-cost>0</span></strong></div>
      <div class="mll-drawer__totals-row mll-drawer__totals-row--save"><span>You save</span><strong>$<span data-cart-save>0</span></strong></div>
    </div>
    <form class="mll-drawer__form" id="cartForm">
      <label><span>Your name</span><input type="text" name="name" required /></label>
      <label><span>Email</span><input type="email" name="email" required /></label>
      <label><span>Notes</span><textarea name="notes" rows="3" placeholder="Anything we should know?"></textarea></label>
      <button type="submit" class="mll-cta mll-cta--full">Send to MadLadsLab</button>
      <div class="mll-drawer__status" data-cart-status></div>
    </form>
  </div>
  <div class="mll-drawer__backdrop" data-cart-close></div>
</div>
