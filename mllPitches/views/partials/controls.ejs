<% if (view.controls && (view.controls.variants || view.controls.dateRanges || view.controls.numberVariables || view.controls.views)) { %>
<div class="mll-controls" data-view="<%= view.slug %>">
  <% if (view.controls.variants) { %>
    <label class="mll-control mll-control--variant">
      <span>Chart style</span>
      <select data-control="variant">
        <% view.controls.variants.forEach((v) => { %>
          <option value="<%= v.id %>"><%= v.label %></option>
        <% }) %>
      </select>
    </label>
  <% } %>
  <% if (view.controls.views) { %>
    <label class="mll-control">
      <span>View set</span>
      <select data-control="viewSet">
        <% view.controls.views.forEach((v) => { %>
          <option value="<%= v.id %>"><%= v.label %></option>
        <% }) %>
      </select>
    </label>
  <% } %>
  <% if (view.controls.dateRanges) { %>
    <label class="mll-control">
      <span>Date range</span>
      <select data-control="dateRange">
        <% view.controls.dateRanges.forEach((d) => { %>
          <option value="<%= d.id %>"><%= d.label %></option>
        <% }) %>
      </select>
    </label>
  <% } %>
  <% if (view.controls.numberVariables) { %>
    <% view.controls.numberVariables.forEach((nv) => { %>
      <label class="mll-control">
        <span><%= nv.label %></span>
        <input type="number" data-control="num" data-key="<%= nv.id %>"
          value="<%= nv.default %>" min="<%= nv.min %>" max="<%= nv.max %>" step="<%= nv.step || 1 %>" />
      </label>
    <% }) %>
  <% } %>
</div>
<% } %>
