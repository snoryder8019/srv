<div class="mll-contact" id="contactModal" hidden>
  <div class="mll-contact__backdrop" data-contact-close></div>
  <div class="mll-contact__panel" role="dialog" aria-label="Contact <%= brand.name %>" aria-modal="true">
    <header class="mll-contact__head">
      <div>
        <h2>Talk to us</h2>
        <p>Direct line to <a href="mailto:<%= brand.contactEmail %>"><%= brand.contactEmail %></a>. Or drop a note here — we'll reply within a day.</p>
      </div>
      <button type="button" class="mll-contact__close" data-contact-close aria-label="Close">×</button>
    </header>

    <form class="mll-contact__form" id="contactForm">
      <div class="mll-contact__row">
        <label><span>Your name *</span><input type="text" name="name" required autocomplete="name" /></label>
        <label><span>Email *</span><input type="email" name="email" required autocomplete="email" /></label>
      </div>
      <label><span>Company</span><input type="text" name="company" autocomplete="organization" /></label>
      <label><span>What can we help with?</span>
        <select name="topic">
          <option value="">Pick one (optional)</option>
          <option>Diligence software</option>
          <option>Website &amp; marketing</option>
          <option>Chatbot</option>
          <option>DNS / email infrastructure</option>
          <option>AI on our infra (no harvesting)</option>
          <option>Something else</option>
        </select>
      </label>
      <label><span>Message *</span><textarea name="message" rows="5" required placeholder="A line or two on what you're trying to do."></textarea></label>
      <label class="mll-contact__hp" aria-hidden="true">
        <span>Leave this blank</span>
        <input type="text" name="hp" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit" class="mll-cta mll-cta--full">Send to <%= brand.contactEmail %></button>
      <div class="mll-contact__status" data-contact-status></div>
    </form>
  </div>
</div>
<script defer src="/js/contact-modal.js"></script>
