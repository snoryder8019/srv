<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/madlands.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin">
  <header class="topbar">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MADLANDS</span>
      <span class="brand-sub">builds</span>
    </div>
    <div class="hud">
      <a class="chip btn" href="/admin">‹ builders</a>
      <a class="chip btn" href="/">▸ map</a>
    </div>
  </header>

  <main class="admin-wrap">
    <h2>Builds <span class="muted">· <%= builds.length %></span></h2>
    <% if (!dbReady) { %><p class="muted">DB offline.</p><% } %>
    <table class="builds-table">
      <thead><tr><th>kind</th><th>name</th><th>hex</th><th>tier</th><th>status</th><th></th></tr></thead>
      <tbody>
        <% builds.forEach(function(b){ %>
          <tr data-id="<%= b._id %>">
            <td><span class="tag"><%= b.kind %></span></td>
            <td><b><%= b.name %></b></td>
            <td><%= b.hexKey || '—' %></td>
            <td class="muted"><%= b.tier %></td>
            <td>
              <select class="st">
                <% ['draft','ready','published'].forEach(function(s){ %><option value="<%= s %>" <%= b.status===s?'selected':'' %>><%= s %></option><% }) %>
              </select>
            </td>
            <td><button class="del">delete</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div id="bstatus" class="status"></div>
  </main>

  <script src="/js/admin/builds.js"></script>
</body>
</html>
