<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/madlands.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin">
  <header class="topbar">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">MADLANDS</span>
      <span class="brand-sub">builder</span>
    </div>
    <div class="hud">
      <span class="chip">db: <b><%= dbReady ? 'online' : 'offline' %></b></span>
      <span class="chip who">@<b><%= currentUser ? currentUser.displayName : '—' %></b></span>
      <a class="chip btn" href="/admin/builds">builds</a>
      <a class="chip btn" href="/">▸ to map</a>
    </div>
  </header>

  <main class="admin-wrap">
    <section class="director">
      <div class="dir-head">
        <h2>What's next</h2>
        <button id="dir-refresh" class="chip btn">↻ ask the director</button>
      </div>
      <div id="dir-list" class="dir-list"><p class="muted">Asking the director…</p></div>
    </section>

    <section class="board">
      <h2>Completion <span id="board-totals" class="muted"></span></h2>
      <div id="board-hexes" class="board-hexes"><p class="muted">Loading the task board…</p></div>
      <h3 class="tasks-h">Open tasks</h3>
      <div id="task-list" class="dir-list"></div>
    </section>

    <section class="builders">
      <h2>Builders</h2>
      <div class="card-grid">
        <% builders.forEach(function(b){ %>
          <a class="bcard live" href="/admin/<%= b.kind %>"><span class="bk"><%= b.kind %></span><span class="bd"><%= b.blurb %></span></a>
        <% }) %>
      </div>
    </section>
  </main>

  <script src="/js/admin/shell.js"></script>
</body>
</html>
