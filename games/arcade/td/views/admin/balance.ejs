<%- include('../partials/header') %>

<main class="admin-wrap">
  <h1 class="admin-title">⬡ Balance Console</h1>
  <p class="admin-sub">Build &amp; balance <strong>characters</strong> (enemies, towers), <strong>boards</strong> (maps), and <strong>levels</strong> (a map + waves). Changes save to the database and apply to new runs.</p>

  <div class="admin-tabs">
    <button class="admin-tab active" data-tab="enemies">Enemies</button>
    <button class="admin-tab" data-tab="towers">Towers</button>
    <button class="admin-tab" data-tab="maps">Maps</button>
    <button class="admin-tab" data-tab="levels">Levels</button>
  </div>

  <section class="admin-panel" id="panel-enemies">
    <div class="panel-head"><h2>Enemy Characters</h2><button class="btn small" id="enemy-add">+ New enemy</button></div>
    <div id="enemy-list" class="card-grid"><em>Loading…</em></div>
  </section>

  <section class="admin-panel" id="panel-towers" hidden>
    <div class="panel-head"><h2>Tower Characters</h2><button class="btn small" id="tower-add">+ New tower</button></div>
    <div id="tower-list" class="card-grid"><em>Loading…</em></div>
  </section>

  <section class="admin-panel" id="panel-maps" hidden>
    <div class="panel-head">
      <h2>Maps <span class="hint">— boards that levels are built on</span></h2>
      <button class="btn small" id="map-add">+ New map</button>
    </div>
    <p class="panel-note">A map is the hex board (radius + spawn / base / path / blocked tiles). Paint the board in the <a href="/build/map" target="_blank">map builder ↗</a>, then build levels on it.</p>
    <div id="map-list" class="card-grid"><em>Loading…</em></div>
  </section>

  <section class="admin-panel" id="panel-levels" hidden>
    <div class="panel-head"><h2>Levels <span class="hint">— a map + waves + difficulty</span></h2><button class="btn small" id="level-add">+ New level</button></div>
    <div id="level-list" class="card-grid"><em>Loading…</em></div>
  </section>

  <div id="admin-toast" class="admin-toast"></div>
</main>

<style>
  .admin-wrap { max-width: 1040px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .admin-title { font-size: 1.6rem; margin: .2rem 0; }
  .admin-sub { color: #9aa7c0; margin: 0 0 1.2rem; font-size: .92rem; }
  .admin-tabs { display: flex; gap: .4rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .admin-tab { background: #161a2b; color: #c7d0e8; border: 1px solid #2a3150; border-radius: 8px; padding: .5rem 1rem; cursor: pointer; font: inherit; }
  .admin-tab.active { background: #2d3766; color: #fff; border-color: #4055a8; }
  .panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; gap: 1rem; flex-wrap: wrap; }
  .panel-head h2 { font-size: 1.1rem; margin: 0; }
  .panel-head .hint, .hint { color: #6b7699; font-weight: normal; font-size: .82rem; }
  .panel-note { color: #9aa7c0; font-size: .82rem; margin: 0 0 .9rem; }
  .panel-note a { color: #7da7ff; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: .8rem; }
  .edit-card { background: #121624; border: 1px solid #262d48; border-radius: 12px; padding: .9rem; }
  .edit-card h3 { margin: 0 0 .1rem; font-size: 1rem; display: flex; align-items: center; gap: .4rem; }
  .edit-card .slug { color: #7a88a8; font-size: .78rem; margin-bottom: .5rem; }
  .field { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin: .35rem 0; }
  .field label { color: #9aa7c0; font-size: .82rem; }
  .field input, .field select, .field textarea { width: 130px; background: #0c0f1a; border: 1px solid #2a3150; color: #e6ebf7; border-radius: 6px; padding: .3rem .5rem; font: inherit; }
  .field input[type="text"] { width: 150px; }
  .edit-card .row-btns { display: flex; gap: .4rem; margin-top: .7rem; }
  .btn { background: #2d3766; color: #fff; border: 1px solid #4055a8; border-radius: 8px; padding: .45rem .9rem; cursor: pointer; font: inherit; }
  .btn.small { padding: .35rem .7rem; font-size: .85rem; }
  .btn.ghost { background: transparent; color: #c7d0e8; border-color: #2a3150; }
  .btn.danger { background: #3a1c24; border-color: #6e3a46; color: #ffb3c0; }
  .swatch { width: 14px; height: 14px; border-radius: 3px; display: inline-block; vertical-align: middle; border: 1px solid #0006; }
  .wave-json { width: 100%; min-height: 150px; background: #0c0f1a; border: 1px solid #2a3150; color: #cfe; border-radius: 6px; font-family: ui-monospace, monospace; font-size: .76rem; padding: .5rem; margin-top: .4rem; }
  .full { width: 100% !important; }
  .admin-toast { position: fixed; bottom: 1.2rem; left: 50%; transform: translateX(-50%); background: #1c2440; color: #fff; padding: .6rem 1rem; border-radius: 8px; opacity: 0; transition: opacity .2s; pointer-events: none; border: 1px solid #3a466e; z-index: 50; }
  .admin-toast.show { opacity: 1; }
  .admin-toast.bad { background: #3a1c24; border-color: #6e3a46; }
</style>

<script type="module" src="/js/admin/balance.js"></script>

<%- include('../partials/footer') %>
